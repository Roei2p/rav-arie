{
 "disc": "34ש- בין המצרים ב",
 "track": "Track01",
 "duration": 911.16,
 "segments": [
  {
   "start": 7.66,
   "end": 19.31,
   "text": "אספסיאנוס הולך לרומא,"
  },
  {
   "start": 20.13,
   "end": 21.03,
   "text": "נהיה קיסר,"
  },
  {
   "start": 21.71,
   "end": 23.83,
   "text": "ושולח את הבן החורג שלו,"
  },
  {
   "start": 25.69,
   "end": 26.39,
   "text": "את טיטוס."
  },
  {
   "start": 48.36,
   "end": 49.42,
   "text": "מגיע טיטוס."
  },
  {
   "start": 50.1,
   "end": 51.72,
   "text": "טיטוס היה שונה מאספסיאנוס,"
  },
  {
   "start": 51.9,
   "end": 54.08,
   "text": "טיטוס היה יותר גרוע מאספסיאנוס."
  },
  {
   "start": 55.4,
   "end": 57.0,
   "text": "ואותי טיטוס, בנו החורג של אספסיאנוס,"
  },
  {
   "start": 58.5,
   "end": 62.6,
   "text": "מגיע ומצליח לכבוש את ירושלים,"
  },
  {
   "start": 63.28,
   "end": 64.26,
   "text": "את בית המקדש."
  },
  {
   "start": 64.96,
   "end": 66.8,
   "text": "וכשהוא מגיע לבית המקדש,"
  },
  {
   "start": 67.38,
   "end": 71.42,
   "text": "אותו טמא הולך לוקח אישה לא צנועה,"
  },
  {
   "start": 72.32,
   "end": 77.16,
   "text": "אישה טמאה, ועם הטומאה הזאת הוא נכנס איתה לבית קודשי הקודשים,"
  },
  {
   "start": 79.8,
   "end": 86.16,
   "text": "אל המקום שבו הכהן גדול נכנס לשם ביום הכיפורים לפני ולפנים,"
  },
  {
   "start": 86.84,
   "end": 89.28,
   "text": "ואותו טיטוס מחלל את הקודש."
  },
  {
   "start": 90.46,
   "end": 92.12,
   "text": "הוא נכנס פנימה שמה,"
  },
  {
   "start": 94.65,
   "end": 98.39,
   "text": "מבזה ספר תורה על רצפת הקודש,"
  },
  {
   "start": 98.85,
   "end": 100.47,
   "text": "עובר שם עבירה,"
  },
  {
   "start": 101.23,
   "end": 102.03,
   "text": "ולא די לו בכך,"
  },
  {
   "start": 103.03,
   "end": 107.23,
   "text": "הוא הוציא חרב ושרט את הפרוכת,"
  },
  {
   "start": 107.85,
   "end": 110.93,
   "text": "זו המבדילה בין הקודש לבין קודש הקודשים."
  },
  {
   "start": 112.83,
   "end": 115.07,
   "text": "אומרת הגמרא, נעשה נס,"
  },
  {
   "start": 115.83,
   "end": 117.43,
   "text": "והדם של הקורבנות,"
  },
  {
   "start": 118.15,
   "end": 121.13,
   "text": "כשהכהן הגדול היה מזה את הקורבנות שם,"
  },
  {
   "start": 121.81,
   "end": 124.25,
   "text": "התחיל לבצבץ והיוצא מהפרוכת."
  },
  {
   "start": 125.23,
   "end": 126.19,
   "text": "לפתע אתה רואה דם,"
  },
  {
   "start": 126.81,
   "end": 129.29,
   "text": "נחיל של דם, יוצא מהפרוכת,"
  },
  {
   "start": 130.01,
   "end": 131.31,
   "text": "זורם בצורה מופלאה."
  },
  {
   "start": 133.01,
   "end": 134.55,
   "text": "כל אדם היה עומד נפעם,"
  },
  {
   "start": 135.27,
   "end": 140.09,
   "text": "אבל טיטוס היה לו לב שונה, לב טמא, לב ערל."
  },
  {
   "start": 141.49,
   "end": 143.55,
   "text": "טיטוס, תדהי מה הוא חשב, אמר הנה,"
  },
  {
   "start": 144.19,
   "end": 147.35,
   "text": "הרגתי את כבודו של בורא עולם."
  },
  {
   "start": 147.87,
   "end": 149.09,
   "text": "הנה, זה הדם שלו."
  },
  {
   "start": 150.57,
   "end": 151.49,
   "text": "עד דככה הוא היה גאוותן,"
  },
  {
   "start": 151.95,
   "end": 153.05,
   "text": "היה בטוח שהוא משהו,"
  },
  {
   "start": 153.67,
   "end": 155.01,
   "text": "הוא מצליח לנצח את כל העולם."
  },
  {
   "start": 170.14,
   "end": 171.48,
   "text": "טיטוס שנכנס לבית המקדש,"
  },
  {
   "start": 171.94,
   "end": 172.86,
   "text": "אומרים בחזל הקדושים,"
  },
  {
   "start": 173.16,
   "end": 173.84,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 174.2,
   "end": 175.0,
   "text": "כהן גדול,"
  },
  {
   "start": 175.52,
   "end": 178.18,
   "text": "קודש קודשים, אם היה נכנס לקודש הקודשים,"
  },
  {
   "start": 178.78,
   "end": 184.36,
   "text": "עם מחשבה לא טמאה בראש, עם איזו עבירה קטנה היה מת,"
  },
  {
   "start": 185.18,
   "end": 187.1,
   "text": "איך טיטוס לא מת עושה שם מה שהוא רוצה?"
  },
  {
   "start": 187.64,
   "end": 188.0,
   "text": "צריך לדעת שטיטוס,"
  },
  {
   "start": 190.1,
   "end": 190.64,
   "text": "טומאה"
  },
  {
   "start": 191.24,
   "end": 191.94,
   "text": "של גוי,"
  },
  {
   "start": 192.66,
   "end": 193.84,
   "text": "שכולו ארציות,"
  },
  {
   "start": 194.82,
   "end": 195.9,
   "text": "לא פוגעת"
  },
  {
   "start": 197.36,
   "end": 198.8,
   "text": "בעולמות העליונים."
  },
  {
   "start": 199.46,
   "end": 200.78,
   "text": "פוגעת רק פה בארץ."
  },
  {
   "start": 201.2,
   "end": 204.2,
   "text": "אתה בניין את קודש הקדושים כמבנה, אפשר לעשות הכל."
  },
  {
   "start": 204.9,
   "end": 209.92,
   "text": "כהן גדול שנכנס ומקושר לעולם העליון, לעולם טהור."
  },
  {
   "start": 210.88,
   "end": 212.08,
   "text": "משהו קטן, טמא,"
  },
  {
   "start": 212.86,
   "end": 214.36,
   "text": "הוא נאבד מן העולם."
  },
  {
   "start": 214.98,
   "end": 216.38,
   "text": "טיטוס יכול לעשות מה שהוא רוצה."
  },
  {
   "start": 216.9,
   "end": 218.36,
   "text": "טומאה קשורה רק לעולם הזה,"
  },
  {
   "start": 218.74,
   "end": 221.04,
   "text": "לא מחוברת לעולמות העליונים,"
  },
  {
   "start": 221.44,
   "end": 225.32,
   "text": "ועולמות העליונים מחוברים כנגד קודש הקדושים."
  },
  {
   "start": 233.04,
   "end": 234.32,
   "text": "תנא דבר רבי ישמעאל,"
  },
  {
   "start": 235.12,
   "end": 237.3,
   "text": "מי כמוך באלים השם?"
  },
  {
   "start": 237.96,
   "end": 240.06,
   "text": "מי כמוך באילמים השם?"
  },
  {
   "start": 240.82,
   "end": 244.66,
   "text": "איך אתה הקדוש ברוך הוא? איזה סבלנות יש לך? מחללים את קודש הקודשים,"
  },
  {
   "start": 245.24,
   "end": 247.48,
   "text": "ואתה שותק נותן לאותו רשע. איזו סבלנות."
  },
  {
   "start": 249.24,
   "end": 249.9,
   "text": "וטיטוס,"
  },
  {
   "start": 250.56,
   "end": 252.54,
   "text": "טיטוס שהוא סיים את מה שהוא עשה בבית המקדש."
  },
  {
   "start": 253.38,
   "end": 255.52,
   "text": "הוא לקח את אותה פרוכת עם טיפות הדם,"
  },
  {
   "start": 256.68,
   "end": 258.24,
   "text": "קשר אותה כמו איזה שק ענק,"
  },
  {
   "start": 258.98,
   "end": 261.38,
   "text": "ושם שם את כל הכלים שבבית המקדש."
  },
  {
   "start": 262.3,
   "end": 270.34,
   "text": "והוא שם אותם בספינה גדולה והולך איתם לרומי להראות לכולם את הניצחון שלו, את הכוח שלו."
  },
  {
   "start": 279.38,
   "end": 284.1,
   "text": "כשטיטוס היה בספינה עם האוצרות שלו,"
  },
  {
   "start": 285.54,
   "end": 287.06,
   "text": "לפתע קורה דבר מוזר."
  },
  {
   "start": 287.62,
   "end": 288.12,
   "text": "בלב ים"
  },
  {
   "start": 288.94,
   "end": 292.1,
   "text": "הוא רואה שערה, שערה בלב ים משתוללת,"
  },
  {
   "start": 292.9,
   "end": 294.98,
   "text": "והיא משתוללת רק סביב הספינה שלו."
  },
  {
   "start": 295.9,
   "end": 297.96,
   "text": "שאר הספינות המשמר שהיו מסביבו"
  },
  {
   "start": 297.96,
   "end": 301.0,
   "text": "שתות להם בים שקט ושלו,"
  },
  {
   "start": 302.1,
   "end": 303.58,
   "text": "ורק הספינה שלו"
  },
  {
   "start": 304.48,
   "end": 305.66,
   "text": "יש סערה סביבה."
  },
  {
   "start": 306.42,
   "end": 307.16,
   "text": "טיטוס הבין."
  },
  {
   "start": 307.82,
   "end": 310.64,
   "text": "טיטוס הבין שזו תופעה שונה, זה מעל לטבע."
  },
  {
   "start": 311.02,
   "end": 313.14,
   "text": "הוא הבין שבורא עולם מחפש אותו."
  },
  {
   "start": 315.08,
   "end": 316.4,
   "text": "אמר טיטוס, אני מבין."
  },
  {
   "start": 317.02,
   "end": 319.04,
   "text": "בורא עולם, אלוקים של היהודים,"
  },
  {
   "start": 320.1,
   "end": 322.84,
   "text": "הוא נלחם רק במים, כמו אם פרעה הטביע אותו במים."
  },
  {
   "start": 324.48,
   "end": 327.48,
   "text": "אז כנראה גם אותי הוא רוצה עכשיו להטביע אותי במים."
  },
  {
   "start": 328.42,
   "end": 329.88,
   "text": "אבל ביבשה לא היה לו כוח."
  },
  {
   "start": 330.52,
   "end": 332.64,
   "text": "עובדה, עשיתי מה שאני רוצה בבית המקדש."
  },
  {
   "start": 334.8,
   "end": 336.52,
   "text": "יצתה בת קול ואמרה,"
  },
  {
   "start": 337.32,
   "end": 340.72,
   "text": "יצתה בת קול ואמרה לו רשע בן רשע,"
  },
  {
   "start": 341.42,
   "end": 343.26,
   "text": "בן בנו של עשו הרשע,"
  },
  {
   "start": 343.92,
   "end": 347.52,
   "text": "בריאה קלה יש לי בעולמי, ויתוש מה,"
  },
  {
   "start": 349.87,
   "end": 350.73,
   "text": "עלה ליבשה,"
  },
  {
   "start": 351.41,
   "end": 352.33,
   "text": "ותעשה איתה מלחמה."
  },
  {
   "start": 353.49,
   "end": 357.79,
   "text": "אמר, יצתה בת קול מהשמיים, אומרת, טיטוס טיטוס, אתה רשע בן רשע."
  },
  {
   "start": 358.53,
   "end": 360.19,
   "text": "בן בנו של עשיו הרשע."
  },
  {
   "start": 360.97,
   "end": 366.67,
   "text": "אתה מתגאה, אתה עדיין לא מבין שלמעשה בית חרוב החרבת,"
  },
  {
   "start": 367.85,
   "end": 369.65,
   "text": "קמח טחון טחנת,"
  },
  {
   "start": 370.43,
   "end": 373.07,
   "text": "עם מנוצח ניצחת, שהכל אני,"
  },
  {
   "start": 374.33,
   "end": 377.81,
   "text": "זה הכל ממני, אתה לא מבין שאתה שליח לי בסך הכל."
  },
  {
   "start": 378.63,
   "end": 382.73,
   "text": "עוד אתה מדבר גבוהה גבוהה, בוא תעלה ליבשה, לא בים, ביבשה."
  },
  {
   "start": 383.45,
   "end": 384.27,
   "text": "אני אשלח לך"
  },
  {
   "start": 384.89,
   "end": 386.55,
   "text": "בריאה קלה כמו יתוש,"
  },
  {
   "start": 387.85,
   "end": 392.01,
   "text": "והיתוש הזה יהרוג אותך בעינויים נוראיים."
  },
  {
   "start": 394.46,
   "end": 397.9,
   "text": "בוא נראה אותך נלחם עם הבריאה הקלה שלי."
  },
  {
   "start": 400.31,
   "end": 401.99,
   "text": "וכשעלה טיטוס ליבשה,"
  },
  {
   "start": 402.55,
   "end": 404.91,
   "text": "נכנס יתוש דרך אפו,"
  },
  {
   "start": 405.39,
   "end": 406.31,
   "text": "דרך החותם שלו,"
  },
  {
   "start": 406.63,
   "end": 412.53,
   "text": "דרך מקום הנשימה, דרך הקשר שבין הגוף החומרי והנשמה הרוחנית שהמשכנת שלה במוח."
  },
  {
   "start": 413.13,
   "end": 415.63,
   "text": "והיתוש שנכנס, נכנס לו לתוך המוח,"
  },
  {
   "start": 418.48,
   "end": 419.72,
   "text": "ומטרף את דעתו,"
  },
  {
   "start": 419.72,
   "end": 422.94,
   "text": "ומתחיל לנקר לו במוחו."
  },
  {
   "start": 426.63,
   "end": 430.37,
   "text": "שבע שנים מציק ומנקר אותו יתוש."
  },
  {
   "start": 432.35,
   "end": 434.49,
   "text": "לטיטוס, הרופאים התייאשו,"
  },
  {
   "start": 435.21,
   "end": 435.91,
   "text": "לא יודעים מה לעשות."
  },
  {
   "start": 437.93,
   "end": 439.97,
   "text": "וטיטוס סובל יום ולילה."
  },
  {
   "start": 440.51,
   "end": 443.13,
   "text": "אין לו יום ואין לו לילה. איזה ייסורים איומים."
  },
  {
   "start": 443.83,
   "end": 445.21,
   "text": "כאבי ראש עצומים."
  },
  {
   "start": 445.71,
   "end": 447.17,
   "text": "הראש דופק בלי להפסיק."
  },
  {
   "start": 448.09,
   "end": 450.55,
   "text": "יום אחד הוא עבר ליד נפחייה,"
  },
  {
   "start": 450.55,
   "end": 454.43,
   "text": "ושם הוא שמע את הפטיש עם הפח."
  },
  {
   "start": 456.41,
   "end": 461.81,
   "text": "היה רעש כזה עצום, לפתע נסתתק לו הכאב ראש, כאילו אותו יתוש הפסיק לנקר לו בראש."
  },
  {
   "start": 462.19,
   "end": 464.87,
   "text": "אמר טיטוס, הנה, יש לי פתרון, זה הפתרון."
  },
  {
   "start": 465.31,
   "end": 468.23,
   "text": "הלך ולקח נפח אליו לארמון."
  },
  {
   "start": 468.91,
   "end": 469.89,
   "text": "הוא יושב בכיסא,"
  },
  {
   "start": 470.35,
   "end": 473.27,
   "text": "והנפח דופק ברעש אדירים בפח."
  },
  {
   "start": 474.03,
   "end": 477.33,
   "text": "צליל איום ונורא, צליל חזק, בעל עוצמה נוראה."
  },
  {
   "start": 478.21,
   "end": 480.39,
   "text": "ואז ככה הוא נרגע קצת, טיטוס."
  },
  {
   "start": 480.99,
   "end": 484.45,
   "text": "כל יום היו מחליפים נפחי, זה היה צריך הרבה כוח."
  },
  {
   "start": 485.37,
   "end": 487.37,
   "text": "כשהיה מגיע נפח גוי, הוא היה משלם לו."
  },
  {
   "start": 487.91,
   "end": 490.81,
   "text": "כשהיה מגיע נפח יהודי, הוא לא היה משלם."
  },
  {
   "start": 491.41,
   "end": 492.21,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 492.77,
   "end": 493.71,
   "text": "אמר טיטוס,"
  },
  {
   "start": 494.23,
   "end": 497.57,
   "text": "די לך שאתה רואה את הצער שלי, של השונא שלך."
  },
  {
   "start": 498.43,
   "end": 502.91,
   "text": "די לך שאתה רואה איך מי שהחריב את בית המקדש משלם ביוקר על זה."
  },
  {
   "start": 503.29,
   "end": 504.33,
   "text": "די לך, זה השכר שלך."
  },
  {
   "start": 506.65,
   "end": 508.33,
   "text": "וככה, יום אחרי יום."
  },
  {
   "start": 508.55,
   "end": 510.97,
   "text": "אבל זה לא נגמר הסיוט."
  },
  {
   "start": 511.91,
   "end": 512.81,
   "text": "אחרי שלושים יום,"
  },
  {
   "start": 513.41,
   "end": 515.69,
   "text": "כנראה אותו יתוש התרגל לזה."
  },
  {
   "start": 517.43,
   "end": 518.97,
   "text": "אותו כאב בראש חזר,"
  },
  {
   "start": 520.79,
   "end": 522.25,
   "text": "התרגל גם לרעש הזה,"
  },
  {
   "start": 523.17,
   "end": 527.13,
   "text": "ושוב המוח דופק ללא הפסק,"
  },
  {
   "start": 527.81,
   "end": 528.41,
   "text": "ללא הפסק."
  },
  {
   "start": 529.19,
   "end": 533.63,
   "text": "יום ועוד יום, שעה ועוד שעה, דקה ועוד דקה."
  },
  {
   "start": 534.01,
   "end": 535.05,
   "text": "שבע שנים!"
  },
  {
   "start": 535.95,
   "end": 540.27,
   "text": "שבע שנים טיטוס סובל בייסורים כנגד שבע שנים"
  },
  {
   "start": 546.58,
   "end": 548.32,
   "text": "שבע שנים סובל"
  },
  {
   "start": 549.58,
   "end": 552.96,
   "text": "סובל בייסורים נוראים כנגד שבע שנים"
  },
  {
   "start": 554.58,
   "end": 565.34,
   "text": "שהוא החריב את בית המקדש שנבנה במשך שבע שנים בית המקדש נבנה במשך שבע שנים אתה החרבת אתה תשלם על זה במשך שבע שנים"
  },
  {
   "start": 566.28,
   "end": 567.62,
   "text": "ובתום השבע שנים"
  },
  {
   "start": 568.22,
   "end": 569.72,
   "text": "הוא מת בייסורים"
  },
  {
   "start": 570.34,
   "end": 571.02,
   "text": "כשהוא מת,"
  },
  {
   "start": 571.94,
   "end": 575.12,
   "text": "באו לו הרופאים של רומי וערכו לו ניתוח פתולוגי."
  },
  {
   "start": 575.74,
   "end": 577.62,
   "text": "הם רצו לברר מה קרה לו בראש."
  },
  {
   "start": 578.1,
   "end": 579.06,
   "text": "פתחו לו את הראש."
  },
  {
   "start": 579.5,
   "end": 581.38,
   "text": "אמר רבי פנחס בן ערובה,"
  },
  {
   "start": 581.96,
   "end": 583.48,
   "text": "אמר רבי פנחס בן ערובה,"
  },
  {
   "start": 583.78,
   "end": 587.52,
   "text": "אני הייתי באותה תקופה בין הרופאים של רומי, בין גדולי רומי."
  },
  {
   "start": 588.56,
   "end": 590.5,
   "text": "והרופאים פתחו וניתחו את המוח שלו,"
  },
  {
   "start": 591.24,
   "end": 594.12,
   "text": "ומצאו במוח שלו גידול,"
  },
  {
   "start": 596.63,
   "end": 600.51,
   "text": "יצור, מעין גידול שהגודל שלו כמו ציפור דרור."
  },
  {
   "start": 602.25,
   "end": 608.07,
   "text": "בברייתא שנין ובמתניתא תנא שהגודל היה כמו גוזל של יונה בן שנה"
  },
  {
   "start": 608.67,
   "end": 610.73,
   "text": "והמשקל שלו של שני ליטרין."
  },
  {
   "start": 615.36,
   "end": 621.12,
   "text": "אומר המהרל מפראג זה היה גידול פעיל והרסני שניכר לו בראשו."
  },
  {
   "start": 623.49,
   "end": 624.33,
   "text": "איזה כאבי תופת."
  },
  {
   "start": 626.51,
   "end": 627.61,
   "text": "ואתם יודעים למה?"
  },
  {
   "start": 628.87,
   "end": 634.07,
   "text": "אתם יודעים למה היה לו אותו סיוט במוחו של טיטוס,"
  },
  {
   "start": 634.27,
   "end": 640.69,
   "text": "אותה נקמה איומה במוחו של טיטוס היה צורה של ציפור דרור וגוזל של יונה,"
  },
  {
   "start": 641.25,
   "end": 642.67,
   "text": "שהן ציפורים טהורות."
  },
  {
   "start": 643.85,
   "end": 651.25,
   "text": "בא לרמוז שהוא נענש על שפגע בכנסת ישראל שמשולה ליונה."
  },
  {
   "start": 653.17,
   "end": 655.95,
   "text": "אתה פגעת בכנסת ישראל שמשולה ליונה,"
  },
  {
   "start": 656.39,
   "end": 657.95,
   "text": "תהיה לך צורה של יונה,"
  },
  {
   "start": 659.09,
   "end": 660.77,
   "text": "כדי שכולם ידעו על מה אתה משלם."
  },
  {
   "start": 664.48,
   "end": 665.58,
   "text": "ואתם יודעים מה עשה טיטוס?"
  },
  {
   "start": 666.02,
   "end": 667.94,
   "text": "כבר שהוא ידע שהוא הולך למות מן העולם?"
  },
  {
   "start": 670.48,
   "end": 672.98,
   "text": "אמר טיסוס כשהוא הרגיש שהוא המוות שלו קרוב,"
  },
  {
   "start": 673.56,
   "end": 676.12,
   "text": "ביקש מהסובבים שלהם, התחנן, תעשו לי טובה."
  },
  {
   "start": 677.44,
   "end": 686.06,
   "text": "תשרפו אותי ותפזרו את האפר שלי על מימי שבעת ימים שבכל קצוות תבל. אתם יודעים למה?"
  },
  {
   "start": 686.88,
   "end": 696.22,
   "text": "שלא ימצא אותי אלוקי היהודים ויעמיד אותי בדין על המעשים שעשיתי לארץ שלו, לבית המקדש. אני יודע שהכל בגלל אלוקי היהודים."
  },
  {
   "start": 696.68,
   "end": 698.2,
   "text": "תעשו לי טובה, אני כל כך מפחד ממנו."
  },
  {
   "start": 698.8,
   "end": 699.26,
   "text": "שרפו אותי,"
  },
  {
   "start": 699.88,
   "end": 702.3,
   "text": "ואת העפר תפזרו בכל שבעת ימים,"
  },
  {
   "start": 702.64,
   "end": 703.92,
   "text": "בכל קצוות תבל,"
  },
  {
   "start": 704.34,
   "end": 705.54,
   "text": "כדי שהוא לא יוכל לתפוס אותי."
  },
  {
   "start": 706.78,
   "end": 708.6,
   "text": "כדי שהוא לא יוכל להעמיד אותי על דין,"
  },
  {
   "start": 709.28,
   "end": 711.4,
   "text": "בדין על כל מה שעשיתי, כל מה שהוללתי."
  },
  {
   "start": 712.7,
   "end": 714.76,
   "text": "אוי, טיטוס, טיטוס, טיפש שכמוך."
  },
  {
   "start": 715.36,
   "end": 718.04,
   "text": "לא הבנת עד הרגע האחרון מי זה בורא העולם."
  },
  {
   "start": 737.48,
   "end": 738.16,
   "text": "אומרת הגמרא,"
  },
  {
   "start": 738.88,
   "end": 739.64,
   "text": "אונקלוס,"
  },
  {
   "start": 740.5,
   "end": 744.12,
   "text": "אונקלוס בר קלוניקוס, היה בן אחותו של טיטוס. בן אחותו."
  },
  {
   "start": 744.92,
   "end": 745.68,
   "text": "הוא רצה להתגייר,"
  },
  {
   "start": 746.6,
   "end": 749.8,
   "text": "הלך ועלה את רוחו של טיטוס הרשע."
  },
  {
   "start": 751.34,
   "end": 752.1,
   "text": "העלה אותו את הרוח שלו."
  },
  {
   "start": 754.16,
   "end": 754.58,
   "text": "באוב"
  },
  {
   "start": 755.84,
   "end": 759.2,
   "text": "שאל אומקלוס את הרוח של טיטוס, תגיד לי."
  },
  {
   "start": 760.96,
   "end": 767.96,
   "text": "כשעלה לו רוחו של טיטוס לפניו, אומקלוס,"
  },
  {
   "start": 768.62,
   "end": 769.54,
   "text": "לטיטוס תגיד לי,"
  },
  {
   "start": 770.94,
   "end": 774.8,
   "text": "מי חשוב בעולם הבא שם, בעולם העליון? מי זה חשוב? מי הכי חשוב?"
  },
  {
   "start": 775.56,
   "end": 778.32,
   "text": "אמר לו טיטוס, הרוח של טיטוס אמרה, ישראל!"
  },
  {
   "start": 779.38,
   "end": 784.08,
   "text": "אמר, מהו להידבק במה להצטרף אליהם? האם כדאי להצטרף אליהם?"
  },
  {
   "start": 784.72,
   "end": 786.52,
   "text": "אמר לו, טיטוס, לא כדאי."
  },
  {
   "start": 787.32,
   "end": 790.22,
   "text": "יש להם כל כך הרבה מצוות, אתה לא תצליח לעמוד."
  },
  {
   "start": 791.26,
   "end": 793.06,
   "text": "לא תצליח לעמוד בדרישות"
  },
  {
   "start": 793.88,
   "end": 794.58,
   "text": "של דרושים מיהודי."
  },
  {
   "start": 795.82,
   "end": 798.02,
   "text": "אתה יודע מה אתה עושה? במקום זה יש לך פתרון יותר קל."
  },
  {
   "start": 798.64,
   "end": 799.62,
   "text": "לך ותציק להם."
  },
  {
   "start": 800.36,
   "end": 804.46,
   "text": "כי תדע לך, מי שמציק לישראל נעשה מנהיג, נעשה ראש."
  },
  {
   "start": 804.88,
   "end": 808.06,
   "text": "כל המצר לישראל נעשה ראש."
  },
  {
   "start": 808.56,
   "end": 809.78,
   "text": "לך תצר להם."
  },
  {
   "start": 812.36,
   "end": 815.9,
   "text": "מי שעושה צרות לעם ישראל זוכר מצליח בעולם הזה, נראה שהכל הולך לו."
  },
  {
   "start": 816.84,
   "end": 818.72,
   "text": "מי שיוצא כנגד התורה הקדושה ילך לו."
  },
  {
   "start": 819.24,
   "end": 820.12,
   "text": "יצאו לו בבחירות,"
  },
  {
   "start": 820.48,
   "end": 823.92,
   "text": "יצליח הצלחה, יהיה מה שאתם רוצים, ראש ממשלה, הכל."
  },
  {
   "start": 824.36,
   "end": 824.94,
   "text": "הכל ילך לו."
  },
  {
   "start": 825.62,
   "end": 828.1,
   "text": "כי כל המצר לישראל נעשה ראש בעולם הזה."
  },
  {
   "start": 829.02,
   "end": 833.8,
   "text": "למה? כי הכבוד של עם ישראל לא נותן שמי שיעשה להם צרות זה יהיה אדם פשוט."
  },
  {
   "start": 834.3,
   "end": 836.98,
   "text": "חייב להיות איזה מישהו רם מעלה, אז מעלים אותו במעלה."
  },
  {
   "start": 837.14,
   "end": 840.82,
   "text": "אונקלוס שאל את טיטוס,"
  },
  {
   "start": 841.62,
   "end": 844.48,
   "text": "טוב תגיד לי אבל אתה היית הרי כשר גדול,"
  },
  {
   "start": 845.54,
   "end": 847.72,
   "text": "שר צבא גדול סליחה, היית שר צבא גדול,"
  },
  {
   "start": 848.12,
   "end": 849.92,
   "text": "כבשת את ירושלים, את בית המקדש,"
  },
  {
   "start": 850.64,
   "end": 852.66,
   "text": "תגיד לי מה קורה איתך בעולם הבא, מה עושים איתך,"
  },
  {
   "start": 853.3,
   "end": 854.08,
   "text": "מה דנים אותך?"
  },
  {
   "start": 854.74,
   "end": 856.14,
   "text": "אמר לו תדעי במה דנים אותי,"
  },
  {
   "start": 856.84,
   "end": 858.94,
   "text": "במה שאני פסקתי וחרצתי על נפשי,"
  },
  {
   "start": 859.82,
   "end": 865.0,
   "text": "אני הלכתי לפני מותי וביקשתי שישרפו אותי ואת האפר יפזרו בכל שבעת הימים,"
  },
  {
   "start": 865.28,
   "end": 867.04,
   "text": "כדי שלא יתפסו אותי, שפה עולם לא יתפוס אותי."
  },
  {
   "start": 867.56,
   "end": 868.44,
   "text": "אתם יודעים מה עושים לי?"
  },
  {
   "start": 869.02,
   "end": 869.84,
   "text": "כל יום"
  },
  {
   "start": 870.58,
   "end": 874.48,
   "text": "אוספים את כל האפר של הגופה שלי מכל קצווי עולם."
  },
  {
   "start": 875.92,
   "end": 876.8,
   "text": "וזה כואב."
  },
  {
   "start": 877.34,
   "end": 879.9,
   "text": "ומעמידים אותי לפני בית דין של מעלה."
  },
  {
   "start": 881.22,
   "end": 883.88,
   "text": "ושורפים אותי עוד פעם מחדש."
  },
  {
   "start": 884.62,
   "end": 889.84,
   "text": "ומפזרים את האפר על שבעת הימים בקצוות העולם, כמו שאני דנתי את עצמי."
  },
  {
   "start": 892.06,
   "end": 893.16,
   "text": "ואני מרגיש את הכאב הזה."
  },
  {
   "start": 893.86,
   "end": 901.82,
   "text": "ואני מרגיש שאני חי ושורפים אותי ושוב פעם אוספים את האפר כל יום ועוד פעם לדיני ועוד פעם דנים אותי"
  },
  {
   "start": 902.4,
   "end": 906.62,
   "text": "ועוד פעם שורפים אותי ועוד פעם מפזרים ככה יום אחרי יום."
  }
 ]
}