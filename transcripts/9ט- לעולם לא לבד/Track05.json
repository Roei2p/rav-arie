{
 "disc": "9ט- לעולם לא לבד",
 "track": "Track05",
 "duration": 414.12,
 "segments": [
  {
   "start": 2.02,
   "end": 5.94,
   "text": "אלף תשע מאות שבעים ושלוש שבעים וארבע,"
  },
  {
   "start": 8.58,
   "end": 9.46,
   "text": "יום הכיפורים,"
  },
  {
   "start": 10.48,
   "end": 11.58,
   "text": "תשל״ד."
  },
  {
   "start": 15.23,
   "end": 16.99,
   "text": "מלחמת יום הכיפורים פורצת,"
  },
  {
   "start": 17.73,
   "end": 18.87,
   "text": "מלחמת יום הדין,"
  },
  {
   "start": 21.27,
   "end": 24.09,
   "text": "תופסת את עם ישראל במצב לא כל כך נעים."
  },
  {
   "start": 25.05,
   "end": 25.93,
   "text": "מלחמה קשה,"
  },
  {
   "start": 26.97,
   "end": 27.85,
   "text": "מלחמה איומה."
  },
  {
   "start": 29.49,
   "end": 31.71,
   "text": "מלחמה על הישרדות."
  },
  {
   "start": 38.89,
   "end": 39.43,
   "text": "בחזית,"
  },
  {
   "start": 40.41,
   "end": 40.97,
   "text": "נוסע לו,"
  },
  {
   "start": 41.93,
   "end": 42.19,
   "text": "נהג,"
  },
  {
   "start": 45.3,
   "end": 49.12,
   "text": "נהג עם משאית תחמושת לספק תחמושת לחזית."
  },
  {
   "start": 50.42,
   "end": 51.4,
   "text": "הוא נוסע כל הדרך,"
  },
  {
   "start": 56.82,
   "end": 57.54,
   "text": "עסוק בוחן"
  },
  {
   "start": 58.52,
   "end": 59.5,
   "text": "את הדרך סביבו,"
  },
  {
   "start": 60.7,
   "end": 63.72,
   "text": "ושלא יפתיע אותו מאיזה כיוון, יש לו ליווי צמוד,"
  },
  {
   "start": 64.58,
   "end": 66.4,
   "text": "והוא נוסע מאובטח שם,"
  },
  {
   "start": 71.23,
   "end": 72.09,
   "text": "באמצע המדבר,"
  },
  {
   "start": 73.79,
   "end": 74.85,
   "text": "בשטח מבצעי,"
  },
  {
   "start": 78.12,
   "end": 79.02,
   "text": "במוצב קטן"
  },
  {
   "start": 81.25,
   "end": 81.97,
   "text": "של צהל,"
  },
  {
   "start": 85.1,
   "end": 85.32,
   "text": "שמה"
  },
  {
   "start": 86.82,
   "end": 87.5,
   "text": "הוא נעצר."
  },
  {
   "start": 89.1,
   "end": 90.72,
   "text": "כבר מרחוק הוא ראה התקהלות."
  },
  {
   "start": 92.2,
   "end": 93.14,
   "text": "רצה לראות מה זה."
  },
  {
   "start": 94.6,
   "end": 95.2,
   "text": "מברר,"
  },
  {
   "start": 96.48,
   "end": 97.16,
   "text": "מה קורה פה?"
  },
  {
   "start": 98.08,
   "end": 99.44,
   "text": "אז עדכנו אותו מהמוצב."
  },
  {
   "start": 100.9,
   "end": 101.6,
   "text": "אמרו לו, תראה,"
  },
  {
   "start": 102.46,
   "end": 105.74,
   "text": "יש כאן ג'יפ של הבחורים האלה, אתה יודע,"
  },
  {
   "start": 106.12,
   "end": 108.58,
   "text": "שבאים לזהות חללים, לזהות נפגעים."
  },
  {
   "start": 109.36,
   "end": 111.96,
   "text": "הם הביאו איתם פה ארבעת המינים."
  },
  {
   "start": 112.36,
   "end": 113.0,
   "text": "מה זה ארבעת המינים?"
  },
  {
   "start": 113.76,
   "end": 118.32,
   "text": "אמרו לו, ארבעת המינים זה מצווה שעושים בחג הסוכות."
  },
  {
   "start": 119.24,
   "end": 122.88,
   "text": "לוקחים לולב, ערבה, והדס, ואתרוג, ולוקחים מנענעים."
  },
  {
   "start": 124.14,
   "end": 126.0,
   "text": "אמרו לו, טוב, בסדר, נו, אז מה כולם מתאספים?"
  },
  {
   "start": 128.42,
   "end": 129.6,
   "text": "נהג המשאית,"
  },
  {
   "start": 131.5,
   "end": 136.66,
   "text": "מסעת נועדין מבטלת, הוא לא היה קשור לתורה ומצוות, לא עניין אותו הדברים האלה, הוא בא לעלות חזרה,"
  },
  {
   "start": 137.4,
   "end": 138.6,
   "text": "נותן למשאית להמשיך."
  },
  {
   "start": 139.44,
   "end": 143.54,
   "text": "בהתחלה הוא חשב, זה משאית שלו, יש לה שקי משם, שכולם מתאספים, אבל..."
  },
  {
   "start": 144.66,
   "end": 145.58,
   "text": "מצוות זה לא בשבילו."
  },
  {
   "start": 146.06,
   "end": 147.26,
   "text": "איך שהוא בא לעלות למשאית,"
  },
  {
   "start": 148.7,
   "end": 150.66,
   "text": "פתאום הוא הרגיש משהו בתוכו, אומר לו, למה?"
  },
  {
   "start": 151.9,
   "end": 154.12,
   "text": "הרי אתה יודע, אתה במלחמה, מי יודע מה יהיה."
  },
  {
   "start": 155.28,
   "end": 159.0,
   "text": "מצווה עשית פעם בחיים שלך, מה אם מצווה אחת לפחות תעשה?"
  },
  {
   "start": 161.72,
   "end": 162.92,
   "text": "והוא לא מבין, הוא לא הבין"
  },
  {
   "start": 163.48,
   "end": 165.62,
   "text": "מה גרם לו לרדת מהמשאית,"
  },
  {
   "start": 166.68,
   "end": 168.16,
   "text": "ובצעד לא הגיוני,"
  },
  {
   "start": 168.8,
   "end": 171.48,
   "text": "אבל צעד שהוא היה שלם איתו,"
  },
  {
   "start": 172.16,
   "end": 173.06,
   "text": "הוא יצטרף לתור."
  },
  {
   "start": 173.52,
   "end": 175.02,
   "text": "הוא לא יודע מה זה ארבעת המינים,"
  },
  {
   "start": 175.6,
   "end": 177.3,
   "text": "אבל הוא רוצה לקיים מצווה,"
  },
  {
   "start": 178.0,
   "end": 180.56,
   "text": "הוא רוצה לעשות את ציוויו של השם יתברך,"
  },
  {
   "start": 181.2,
   "end": 183.1,
   "text": "וככה הוא עומד לו בתור,"
  },
  {
   "start": 186.44,
   "end": 188.52,
   "text": "ועומד ועומד עד שמגיע התור שלו."
  },
  {
   "start": 189.16,
   "end": 190.96,
   "text": "מקץ שעה ארוכה מגיע התור שלו."
  },
  {
   "start": 192.46,
   "end": 192.8,
   "text": "והוא בא"
  },
  {
   "start": 194.84,
   "end": 199.98,
   "text": "ולוקח את ארבעת המינים כמו שמורה לו הבחור שעמד שם,"
  },
  {
   "start": 201.96,
   "end": 214.44,
   "text": "ומברך לפתע,"
  },
  {
   "start": 217.6,
   "end": 218.66,
   "text": "נשמע מלמעלה,"
  },
  {
   "start": 219.52,
   "end": 220.6,
   "text": "הוא מרים את העיניים."
  },
  {
   "start": 221.86,
   "end": 225.12,
   "text": "מספיק לראות מטוס אויב, מטוס קרב של אויב,"
  },
  {
   "start": 225.64,
   "end": 229.26,
   "text": "שהתבייט על משאית התחמושת שלו."
  },
  {
   "start": 230.92,
   "end": 236.25,
   "text": "ומספר פגזים נחתו להם על המשאית."
  },
  {
   "start": 245.05,
   "end": 245.69,
   "text": "הפגז,"
  },
  {
   "start": 247.11,
   "end": 250.09,
   "text": "עם כל התחמושת שהייתה בתוך המשאית, התפוצצו,"
  },
  {
   "start": 252.86,
   "end": 259.06,
   "text": "והכול נהפך שם לאבק של מתכת."
  },
  {
   "start": 259.66,
   "end": 262.3,
   "text": "לא נשאר שריד ופליט מהמשאית."
  },
  {
   "start": 290.76,
   "end": 294.08,
   "text": "הוא קם, ניקה את האבק מהבגדים שלו,"
  },
  {
   "start": 294.9,
   "end": 295.86,
   "text": "נשא את העיניים"
  },
  {
   "start": 296.56,
   "end": 298.26,
   "text": "למעלה לאבא שבשמיים,"
  },
  {
   "start": 299.04,
   "end": 299.78,
   "text": "ואמר פשוט,"
  },
  {
   "start": 300.34,
   "end": 300.68,
   "text": "תודה,"
  },
  {
   "start": 301.48,
   "end": 303.32,
   "text": "החיים שלו ניתנו לו במתנה."
  },
  {
   "start": 304.36,
   "end": 306.1,
   "text": "הוא ידע שאם הוא היה ממשיך עם המשאית,"
  },
  {
   "start": 306.62,
   "end": 308.02,
   "text": "הוא היה נהפך לקורבן,"
  },
  {
   "start": 308.42,
   "end": 310.5,
   "text": "קורבן קל למטוסי הקרב"
  },
  {
   "start": 311.16,
   "end": 311.82,
   "text": "של האויב."
  },
  {
   "start": 314.14,
   "end": 315.58,
   "text": "חייו ניתנו לו במתנה."
  },
  {
   "start": 320.22,
   "end": 322.44,
   "text": "כשהוא חזר, חזר הביתה."
  },
  {
   "start": 322.44,
   "end": 325.54,
   "text": "הוא סיפר את הסיפור שלו,"
  },
  {
   "start": 329.1,
   "end": 331.68,
   "text": "אם אני לא טועה, התפרסם בעיתון במחנה הסיפור שלו."
  },
  {
   "start": 337.01,
   "end": 340.59,
   "text": "ושלושה חודשים אחר כך נולדה לו בת."
  },
  {
   "start": 341.45,
   "end": 342.47,
   "text": "נולדה לו בת."
  },
  {
   "start": 344.74,
   "end": 348.14,
   "text": "לבת הוא קרא לולבה,"
  },
  {
   "start": 350.67,
   "end": 352.47,
   "text": "על אותה מצוות לולב,"
  },
  {
   "start": 353.45,
   "end": 357.01,
   "text": "כשהוא הצהיר בחיוך ואמר, אני קורא לבת שלי בשם הזה,"
  },
  {
   "start": 357.55,
   "end": 359.31,
   "text": "כי אני יודע שמה שהציל אותי,"
  },
  {
   "start": 359.69,
   "end": 363.63,
   "text": "מה שנשארתי וזכיתי לראות את הבת שלי והיא זכתה לאבא."
  },
  {
   "start": 364.85,
   "end": 370.93,
   "text": "זה בגלל שאני החלטתי לעשות פעם בחיים שלי צעד לשם יתברך מצווה אחת."
  },
  {
   "start": 372.09,
   "end": 373.63,
   "text": "יהודי שעושה צעד לשם,"
  },
  {
   "start": 374.21,
   "end": 375.41,
   "text": "יהודי אף פעם לא לבד."
  },
  {
   "start": 376.09,
   "end": 377.57,
   "text": "השם צילך על יד ימיניך,"
  },
  {
   "start": 378.01,
   "end": 378.85,
   "text": "אתה עושה צעד,"
  },
  {
   "start": 379.33,
   "end": 380.41,
   "text": "הקדוש ברוך הוא עושה צעד."
  },
  {
   "start": 381.07,
   "end": 382.97,
   "text": "אותו יהודי, אותו נהג."
  },
  {
   "start": 384.31,
   "end": 386.75,
   "text": "בעת הקרב, אם לא היה עושה צעד,"
  },
  {
   "start": 387.33,
   "end": 388.27,
   "text": "לא יודע מה היה איתו,"
  },
  {
   "start": 388.73,
   "end": 393.43,
   "text": "אבל הוא בחר, הוא בחר בדרך הנכונה, הוא בחר בדרך המנצחת."
  },
  {
   "start": 393.87,
   "end": 397.03,
   "text": "עשה צעד לכבוד השם יתברך, ותראו את התוצאות."
  },
  {
   "start": 397.91,
   "end": 399.05,
   "text": "ותראו את התוצאות."
  }
 ]
}