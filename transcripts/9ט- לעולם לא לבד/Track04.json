{
 "disc": "9ט- לעולם לא לבד",
 "track": "Track04",
 "duration": 765.12,
 "segments": [
  {
   "start": 7.32,
   "end": 8.14,
   "text": "היא הייתה כישרונית."
  },
  {
   "start": 10.46,
   "end": 11.26,
   "text": "היא הייתה מצליחה."
  },
  {
   "start": 14.11,
   "end": 15.19,
   "text": "כישרונית ומצליחה."
  },
  {
   "start": 16.59,
   "end": 17.53,
   "text": "בנוסף לכך,"
  },
  {
   "start": 18.37,
   "end": 20.29,
   "text": "היא הייתה גם צנועה וירת שמיים."
  },
  {
   "start": 22.56,
   "end": 26.58,
   "text": "אבא שלה היה אחד מסוחרי הטקסטיל הגדולים ביותר באזור."
  },
  {
   "start": 27.68,
   "end": 28.12,
   "text": "כל פעם"
  },
  {
   "start": 29.7,
   "end": 31.34,
   "text": "שהוא יצא לו למסע עסקים,"
  },
  {
   "start": 31.86,
   "end": 33.36,
   "text": "למסע של רכש, של סחורה,"
  },
  {
   "start": 34.92,
   "end": 35.08,
   "text": "היא,"
  },
  {
   "start": 35.68,
   "end": 36.18,
   "text": "הבת שלו,"
  },
  {
   "start": 36.74,
   "end": 39.16,
   "text": "זאת הנבונה, זאת ברוכת הכישרונות,"
  },
  {
   "start": 39.62,
   "end": 41.3,
   "text": "הייתה ממלאת את מקומו בהצלחה."
  },
  {
   "start": 45.47,
   "end": 46.99,
   "text": "זה היה ממלא קנאה את כל המתחרים,"
  },
  {
   "start": 48.19,
   "end": 48.59,
   "text": "להם,"
  },
  {
   "start": 49.41,
   "end": 54.43,
   "text": "אותם לא זיכה הקדוש ברוך הוא באוצר שכזה."
  },
  {
   "start": 57.98,
   "end": 63.72,
   "text": "המקרה התרחש באחד הפעמים בהם אבא נסע לרגל עסקיו,"
  },
  {
   "start": 64.52,
   "end": 64.86,
   "text": "והיא,"
  },
  {
   "start": 65.34,
   "end": 68.46,
   "text": "היא נשארה לבד לנהל את החנות."
  },
  {
   "start": 79.31,
   "end": 83.25,
   "text": "הפחור הגבוה שהחל לפקוד מדי יום ביומו את החנות,"
  },
  {
   "start": 83.25,
   "end": 85.97,
   "text": "עורר בה איזה חשד מסוים,"
  },
  {
   "start": 86.81,
   "end": 87.31,
   "text": "אבל היא שתקה."
  },
  {
   "start": 89.19,
   "end": 91.61,
   "text": "לא היה נעים לה לבייש, להעליב יהודי,"
  },
  {
   "start": 92.19,
   "end": 93.43,
   "text": "אין עוד דבר של מה בכך."
  },
  {
   "start": 94.65,
   "end": 95.65,
   "text": "אז היא המתינה, אולי היא,"
  },
  {
   "start": 96.09,
   "end": 98.23,
   "text": "אולי סוף סוף הוא יקנה, הוא יעשה משהו."
  },
  {
   "start": 98.95,
   "end": 101.31,
   "text": "לא מבינה מה הוא נשאר שם ואחרי כמה זמן הולך."
  },
  {
   "start": 102.61,
   "end": 102.99,
   "text": "היא לא ידעה,"
  },
  {
   "start": 104.19,
   "end": 105.23,
   "text": "היא לא ידעה שזה מלכודת."
  },
  {
   "start": 109.35,
   "end": 110.35,
   "text": "מלכודת עבורה."
  },
  {
   "start": 120.94,
   "end": 121.86,
   "text": "השמועה התפשטה,"
  },
  {
   "start": 122.54,
   "end": 123.04,
   "text": "בעיר."
  },
  {
   "start": 126.22,
   "end": 127.1,
   "text": "מאשימים אותה,"
  },
  {
   "start": 127.86,
   "end": 129.8,
   "text": "הבת, הבת המוכשרת של הסוחר,"
  },
  {
   "start": 131.28,
   "end": 134.36,
   "text": "בקשרים עם הבחור הגבוה שהיה נכנס לחנות."
  },
  {
   "start": 136.0,
   "end": 141.3,
   "text": "המתחרים של אבא שתכננו את המזימה הזאת חיככו ידיהם בהנאה."
  },
  {
   "start": 142.28,
   "end": 144.72,
   "text": "סוף סוף היא תפסיק לסייע לאבא שלה בעסקים."
  },
  {
   "start": 148.08,
   "end": 153.14,
   "text": "היחידי שחנותו תמיד הייתה נותרת פתוחה זה היה הוא."
  },
  {
   "start": 155.87,
   "end": 159.95,
   "text": "זה העלה את קנאתם והתוצאה הייתה אותה תוכנית שטנית,"
  },
  {
   "start": 169.85,
   "end": 173.07,
   "text": "ואת השמועה הזאת, שפשטה לה כמו אש בשדה קוצים,"
  },
  {
   "start": 173.43,
   "end": 174.69,
   "text": "אי אפשר היה לעצור."
  },
  {
   "start": 175.01,
   "end": 202.38,
   "text": "היא הסתגרה בבית שלה,"
  },
  {
   "start": 203.96,
   "end": 204.62,
   "text": "שותקת,"
  },
  {
   "start": 205.5,
   "end": 206.24,
   "text": "סופגת."
  },
  {
   "start": 210.68,
   "end": 214.26,
   "text": "אחד מהדברים שקרעו את ליבה"
  },
  {
   "start": 215.16,
   "end": 215.78,
   "text": "זה היה אבא."
  },
  {
   "start": 216.88,
   "end": 217.78,
   "text": "לראות את הכאב,"
  },
  {
   "start": 218.9,
   "end": 226.01,
   "text": "את השתיקה רוויית הכאב של אבא, היה קשה."
  },
  {
   "start": 227.43,
   "end": 228.35,
   "text": "קשה לשאת את זה."
  },
  {
   "start": 229.45,
   "end": 229.91,
   "text": "אבל היא בוחרת,"
  },
  {
   "start": 230.51,
   "end": 233.09,
   "text": "היא בוחרת בבחירה הקשה מכל, לא להגיב."
  },
  {
   "start": 236.23,
   "end": 236.83,
   "text": "מה שהיא תגיד."
  },
  {
   "start": 237.67,
   "end": 240.57,
   "text": "קשה מאוד היה להזים עלילה כל כך שפלה ומתוכננת,"
  },
  {
   "start": 241.13,
   "end": 242.47,
   "text": "וזה רק ייצור מחלוקות,"
  },
  {
   "start": 242.99,
   "end": 246.35,
   "text": "אז היא בוחרת באפשרות הקשה מכל."
  },
  {
   "start": 247.03,
   "end": 247.45,
   "text": "בושה,"
  },
  {
   "start": 248.27,
   "end": 248.77,
   "text": "שתיקה,"
  },
  {
   "start": 249.39,
   "end": 249.97,
   "text": "ספיגה."
  },
  {
   "start": 252.1,
   "end": 253.3,
   "text": "איזה כוחות נפש."
  },
  {
   "start": 254.46,
   "end": 255.56,
   "text": "איזה עוצמה אדירה,"
  },
  {
   "start": 256.1,
   "end": 256.6,
   "text": "גלומה,"
  },
  {
   "start": 257.12,
   "end": 260.08,
   "text": "בבת ישראל כל כך עדינה."
  },
  {
   "start": 264.83,
   "end": 265.79,
   "text": "עברו להם שנים."
  },
  {
   "start": 266.97,
   "end": 267.93,
   "text": "היא יושבת בביתה,"
  },
  {
   "start": 268.89,
   "end": 269.61,
   "text": "בודדה,"
  },
  {
   "start": 270.17,
   "end": 271.91,
   "text": "איש לא מעוניין להתנשא לה."
  },
  {
   "start": 273.95,
   "end": 274.35,
   "text": "והאבא,"
  },
  {
   "start": 275.17,
   "end": 276.15,
   "text": "שרואה את הבת שלו,"
  },
  {
   "start": 276.93,
   "end": 279.55,
   "text": "מתבגרת מיום ליום, משנה לשנה,"
  },
  {
   "start": 280.17,
   "end": 281.05,
   "text": "כואבת כאבה,"
  },
  {
   "start": 281.77,
   "end": 285.9,
   "text": "אומר לה בתי היקרה, אין ברירה,"
  },
  {
   "start": 286.9,
   "end": 287.6,
   "text": "אין ברירה,"
  },
  {
   "start": 288.2,
   "end": 290.7,
   "text": "הרי את חייבת להתחתן, לא תישארי ככה כל הזמן."
  },
  {
   "start": 291.66,
   "end": 294.26,
   "text": "ואני ראיתי יהודי, יהודי פשוט,"
  },
  {
   "start": 295.42,
   "end": 296.36,
   "text": "אבל אדם טוב,"
  },
  {
   "start": 297.58,
   "end": 298.8,
   "text": "אהרון שמייסטר,"
  },
  {
   "start": 299.72,
   "end": 301.22,
   "text": "העוזר של העגלון,"
  },
  {
   "start": 302.38,
   "end": 303.42,
   "text": "אותו אף אחת לא רוצה,"
  },
  {
   "start": 304.06,
   "end": 306.34,
   "text": "אולי הוא יסכים להינשא לח..."
  },
  {
   "start": 306.82,
   "end": 307.5,
   "text": "תקימי בית."
  },
  {
   "start": 308.56,
   "end": 313.38,
   "text": "ואותה בת שיכלה לקבל את השידוך הטוב ביותר,"
  },
  {
   "start": 314.16,
   "end": 320.42,
   "text": "שיש לה את כל המעלות לזכות בבחירה הטובה ביותר,"
  },
  {
   "start": 322.51,
   "end": 324.73,
   "text": "רואה את הכאב בעיניים של אבא,"
  },
  {
   "start": 325.29,
   "end": 327.67,
   "text": "היא יודעת לקרוא את הלב."
  },
  {
   "start": 331.07,
   "end": 332.25,
   "text": "היא קוראת את הלב של אימא,"
  },
  {
   "start": 332.81,
   "end": 336.61,
   "text": "של אימא שלה שממתינה מתי הבת שלה סוף סוף תקים בית,"
  },
  {
   "start": 337.75,
   "end": 340.89,
   "text": "והיא עוזרת רוח גבורה,"
  },
  {
   "start": 342.83,
   "end": 346.23,
   "text": "והיא מסכימה להינשא לעוזר העגלון,"
  },
  {
   "start": 346.63,
   "end": 347.65,
   "text": "ואפילו לא העגלון,"
  },
  {
   "start": 348.11,
   "end": 349.05,
   "text": "עוזר העגלון."
  },
  {
   "start": 353.7,
   "end": 356.76,
   "text": "וכך מתקרב לו מועד החופה."
  },
  {
   "start": 366.77,
   "end": 367.51,
   "text": "תושבי העיירה"
  },
  {
   "start": 369.57,
   "end": 370.31,
   "text": "הגיעו לחופה,"
  },
  {
   "start": 372.05,
   "end": 373.47,
   "text": "נכנסים בהמוניהם,"
  },
  {
   "start": 377.15,
   "end": 377.63,
   "text": "ושם,"
  },
  {
   "start": 378.35,
   "end": 379.45,
   "text": "מתחת לחופה,"
  },
  {
   "start": 380.49,
   "end": 381.65,
   "text": "עומדת לה הקלה,"
  },
  {
   "start": 381.99,
   "end": 383.81,
   "text": "שותקת,"
  },
  {
   "start": 384.95,
   "end": 389.03,
   "text": "כמו שהיא שתקה זה שנים לא מעטות."
  },
  {
   "start": 392.26,
   "end": 397.84,
   "text": "הרב המקדש רוצה להתחיל בקידושים שם מתחת לחופה,"
  },
  {
   "start": 401.08,
   "end": 403.9,
   "text": "ואז לפתע הכלה עושה תנועה,"
  },
  {
   "start": 404.84,
   "end": 405.76,
   "text": "הכלה רומזת,"
  },
  {
   "start": 406.5,
   "end": 407.74,
   "text": "אני רוצה לומר משהו,"
  },
  {
   "start": 412.66,
   "end": 414.52,
   "text": "דממה משתעררת לה באולם."
  },
  {
   "start": 421.51,
   "end": 425.03,
   "text": "ואז עמדה הכלה וקראה בקול,"
  },
  {
   "start": 425.71,
   "end": 426.77,
   "text": "בקול מיוחד,"
  },
  {
   "start": 427.37,
   "end": 430.53,
   "text": "כל שמאחוריו היו שנים של כאב,"
  },
  {
   "start": 431.55,
   "end": 433.37,
   "text": "שנים ללא שום מילה,"
  },
  {
   "start": 434.67,
   "end": 437.79,
   "text": "אבל עם הרבה הרבה הרבה אמונה."
  },
  {
   "start": 440.89,
   "end": 441.75,
   "text": "וכך היא אמרה,"
  },
  {
   "start": 442.47,
   "end": 444.27,
   "text": "האשימו אותי בורא עולם,"
  },
  {
   "start": 445.11,
   "end": 447.35,
   "text": "בורא עולם אני אומרת פה עכשיו קבל עם ועדה,"
  },
  {
   "start": 448.69,
   "end": 451.35,
   "text": "ביום החופה שלי מול קהל הנאספים."
  },
  {
   "start": 451.95,
   "end": 455.27,
   "text": "אתה יודע, בורא עולם, שהאשימו אותי על לא עוול בכפי."
  },
  {
   "start": 456.01,
   "end": 457.57,
   "text": "אתה יודע, בורא עולם, את האמת."
  },
  {
   "start": 457.91,
   "end": 459.45,
   "text": "לא היו דברים מעולם,"
  },
  {
   "start": 459.89,
   "end": 463.27,
   "text": "תמיד תמיד שמרתי והקפדתי על שיא הצניעות."
  },
  {
   "start": 464.71,
   "end": 469.33,
   "text": "מה נתן לי את הכוח להחזיק מעמד בשנים הקשות האלה?"
  },
  {
   "start": 470.51,
   "end": 472.69,
   "text": "כל מה שנתן לי את הכוח היה רק דבר אחד,"
  },
  {
   "start": 473.41,
   "end": 475.33,
   "text": "ידעתי שאני לא לבד."
  },
  {
   "start": 476.89,
   "end": 478.35,
   "text": "כולם התרחקו ממני,"
  },
  {
   "start": 479.11,
   "end": 480.47,
   "text": "כולם סלדו ממני,"
  },
  {
   "start": 480.85,
   "end": 483.87,
   "text": "אבל אני לא נשברתי כי ידעתי שאני לא לבד."
  },
  {
   "start": 484.23,
   "end": 487.17,
   "text": "בעולם אתה יודע כמי שהצריכה מילה טובה,"
  },
  {
   "start": 487.51,
   "end": 489.45,
   "text": "כמי שאת צריכה תשומת לב."
  },
  {
   "start": 490.71,
   "end": 492.39,
   "text": "אבל אני ידעתי שאני לא לבד,"
  },
  {
   "start": 492.87,
   "end": 494.83,
   "text": "ידעתי שאתה בורא עולם איתי."
  },
  {
   "start": 495.91,
   "end": 499.11,
   "text": "אז הרגשתי ככה כל רגע ורגע בכל אותם שנים,"
  },
  {
   "start": 499.61,
   "end": 500.59,
   "text": "שאתה איתי,"
  },
  {
   "start": 501.01,
   "end": 503.85,
   "text": "אתה נותן לי את תשומת לב, איתך אני יכולה לדבר,"
  },
  {
   "start": 504.21,
   "end": 505.41,
   "text": "אתה שומע את קרינותיי,"
  },
  {
   "start": 506.53,
   "end": 507.43,
   "text": "שאני לא לבד."
  },
  {
   "start": 508.09,
   "end": 511.33,
   "text": "ולכן שתקתי לכל הסביבה, ורק איתך דיברתי."
  },
  {
   "start": 511.63,
   "end": 514.53,
   "text": "לא דיברתי עם אף אחד, רק איתך אבא שבשמיים."
  },
  {
   "start": 515.97,
   "end": 516.63,
   "text": "ועכשיו,"
  },
  {
   "start": 517.33,
   "end": 521.83,
   "text": "עכשיו אני פונה אליך ביום כלולותיי ומבקשת ממך, אבא שבשמיים,"
  },
  {
   "start": 522.33,
   "end": 524.67,
   "text": "שתראה לכולם שאני טהורה,"
  },
  {
   "start": 526.19,
   "end": 528.99,
   "text": "שתראה לכולם שמעולם לא קלקלתי."
  },
  {
   "start": 530.17,
   "end": 532.01,
   "text": "אני מבקשת ממך, אבא שבשמיים,"
  },
  {
   "start": 532.43,
   "end": 533.23,
   "text": "אני פונה אליך,"
  },
  {
   "start": 533.65,
   "end": 534.39,
   "text": "תן לי בן,"
  },
  {
   "start": 534.81,
   "end": 538.39,
   "text": "תן לי בן שיאיר את עם ישראל באור של תורה,"
  },
  {
   "start": 538.83,
   "end": 539.83,
   "text": "שיעמוד אור,"
  },
  {
   "start": 540.19,
   "end": 542.41,
   "text": "שיאיר את עיני ישראל."
  },
  {
   "start": 560.43,
   "end": 563.75,
   "text": "כל בני העיירה השפילו את עיניהם."
  },
  {
   "start": 567.26,
   "end": 570.38,
   "text": "הטוהר שבדברי הכלה שברו את הלב,"
  },
  {
   "start": 575.39,
   "end": 576.75,
   "text": "זה היה יותר מאלף מילים."
  },
  {
   "start": 578.03,
   "end": 580.99,
   "text": "לפתע כולם ידעו שהאמת איתה,"
  },
  {
   "start": 582.21,
   "end": 583.15,
   "text": "שהיא צדקה,"
  },
  {
   "start": 585.53,
   "end": 589.09,
   "text": "אותה אישה גדולת רוח, אותה אישה חזקה שמעולם,"
  },
  {
   "start": 589.61,
   "end": 591.97,
   "text": "אבל מעולם לא הייתה לבד."
  },
  {
   "start": 599.46,
   "end": 602.62,
   "text": "לאישה הצדקת הזו נולד בן,"
  },
  {
   "start": 603.2,
   "end": 605.4,
   "text": "כשהוא נולד היא קראה לו יחיאל מיכל."
  },
  {
   "start": 608.04,
   "end": 608.98,
   "text": "בעיירה הקטנה,"
  },
  {
   "start": 609.82,
   "end": 613.18,
   "text": "בעיירה הקטנה הזו, כמו בהרבה מקומות בעולם,"
  },
  {
   "start": 614.48,
   "end": 620.2,
   "text": "אמהות יהודיות חלמו, התפללו, שאפו לילד בן תורה,"
  },
  {
   "start": 620.56,
   "end": 622.9,
   "text": "ילד שיקנה להם חלק בעולם הבא,"
  },
  {
   "start": 623.42,
   "end": 625.4,
   "text": "שיגרום להם אושר גם בעולם הזה."
  },
  {
   "start": 626.12,
   "end": 626.92,
   "text": "כולן רצו,"
  },
  {
   "start": 627.8,
   "end": 629.42,
   "text": "אבל היא זכתה."
  },
  {
   "start": 630.6,
   "end": 631.7,
   "text": "היא זכתה בבן,"
  },
  {
   "start": 632.3,
   "end": 634.08,
   "text": "בבן שנייה לבן תורה."
  },
  {
   "start": 634.96,
   "end": 638.08,
   "text": "ולא רק בן תורה, אלא לגדול בתורה."
  },
  {
   "start": 638.78,
   "end": 642.48,
   "text": "עמוד של אור, מה שהיא ביקשה, עמוד של אור, היא קיבלה עמוד של אור."
  },
  {
   "start": 643.44,
   "end": 650.76,
   "text": "הבן שלה גדל ונהיה רבי יחיאל מיכל הלר, זכר צדיק לברכה, בעל עמודי אור,"
  },
  {
   "start": 651.24,
   "end": 652.9,
   "text": "אחד ממפרשי התלמוד."
  },
  {
   "start": 653.88,
   "end": 658.3,
   "text": "וכשהוא היה צריך לחתום על מכתבי הסכמות,"
  },
  {
   "start": 658.92,
   "end": 659.58,
   "text": "מכתבי,"
  },
  {
   "start": 662.98,
   "end": 664.3,
   "text": "מכתבים שהוא היה כותב,"
  },
  {
   "start": 664.9,
   "end": 665.4,
   "text": "הוא היה חותם,"
  },
  {
   "start": 666.32,
   "end": 667.94,
   "text": "העלוב יחיאל מיכל."
  },
  {
   "start": 667.94,
   "end": 674.24,
   "text": "למה עלוב מה שעשה אותי בעל עמודאו,"
  },
  {
   "start": 674.8,
   "end": 675.56,
   "text": "זו אמא שלי,"
  },
  {
   "start": 681.16,
   "end": 684.78,
   "text": "ואותה אמא גדולה היא צדקה, היא לא הייתה לבד,"
  },
  {
   "start": 685.46,
   "end": 688.36,
   "text": "כי בת ישראל לעולם לא לבד."
  },
  {
   "start": 690.3,
   "end": 696.34,
   "text": "הקדוש ברוך הוא נותן תשומת לב, אהבה לכל בן ישראל לכל בת ישראל,"
  },
  {
   "start": 696.96,
   "end": 698.36,
   "text": "רק שנרצה לקבל."
  },
  {
   "start": 699.12,
   "end": 702.62,
   "text": "אותה, אותה יהודיה קדושה זכתה לנצח."
  },
  {
   "start": 703.62,
   "end": 705.2,
   "text": "כל מה שהבן למד,"
  },
  {
   "start": 705.96,
   "end": 707.38,
   "text": "כל מה שבעל עמודי אור למד,"
  },
  {
   "start": 708.14,
   "end": 710.28,
   "text": "לימד, זיכה את הרבים,"
  },
  {
   "start": 710.74,
   "end": 712.22,
   "text": "את הספרים שלו עד היום,"
  },
  {
   "start": 712.84,
   "end": 717.4,
   "text": "שם למעלה בשמיים זה עומד לזכותה."
  },
  {
   "start": 718.06,
   "end": 720.72,
   "text": "שם למעלה בשמיים שוכנות אחר כבוד נשמות"
  },
  {
   "start": 721.66,
   "end": 725.06,
   "text": "של בני ובנות העיירה נמצאים גם שם למעלה בשמיים."
  },
  {
   "start": 726.58,
   "end": 727.74,
   "text": "אבל ממה לכולן?"
  },
  {
   "start": 729.5,
   "end": 732.4,
   "text": "הרבה הרבה מעליהן, מאירה ומזהירה לה."
  },
  {
   "start": 733.02,
   "end": 735.52,
   "text": "הנשמה של אותה אימא, של אותה אישה,"
  },
  {
   "start": 736.12,
   "end": 737.32,
   "text": "של אותה בת צדקת,"
  },
  {
   "start": 738.14,
   "end": 739.52,
   "text": "אימו של בעל עמודי אור,"
  },
  {
   "start": 739.84,
   "end": 743.48,
   "text": "שקנתה לה מקום נצחי בהיכלות גן עדן,"
  },
  {
   "start": 743.8,
   "end": 747.12,
   "text": "שהיא שמה מתענגת לה יום-יום באושר אינסופי."
  },
  {
   "start": 748.48,
   "end": 753.92,
   "text": "מה נתן לה את הכוח להגיע לאותן מחלות, לאותו אושר נצחי?"
  },
  {
   "start": 754.38,
   "end": 758.62,
   "text": "ההבנה, ההרגשה, התחושה שהיא לא לבד."
  },
  {
   "start": 761.67,
   "end": 762.31,
   "text": "שהיא לא לבד."
  }
 ]
}