{
 "disc": "9ט- לעולם לא לבד",
 "track": "Track02",
 "duration": 1330.2,
 "segments": [
  {
   "start": 3.22,
   "end": 4.28,
   "text": "לפני כשש מאות שנה,"
  },
  {
   "start": 5.72,
   "end": 6.48,
   "text": "בעיר מגנצה,"
  },
  {
   "start": 8.79,
   "end": 13.15,
   "text": "חי איש קדוש בשם רבי שמעון הגדול."
  },
  {
   "start": 15.36,
   "end": 26.39,
   "text": "רבי שמעון היה לומד תורה ומדי פעם בפעם היה יושב, היה כותב לו פיוטים,"
  },
  {
   "start": 29.53,
   "end": 32.25,
   "text": "שיר תפילה לכבוד השם יתברך."
  },
  {
   "start": 33.71,
   "end": 34.21,
   "text": "פעם אחת"
  },
  {
   "start": 34.99,
   "end": 40.81,
   "text": "הוא היה שוב עסוק בכתיבת שיר תפילה מרגש כשהדלת נפתחה לפתע"
  },
  {
   "start": 41.45,
   "end": 43.31,
   "text": "ונכנס ילד,"
  },
  {
   "start": 43.93,
   "end": 44.61,
   "text": "ילד חמוד,"
  },
  {
   "start": 45.35,
   "end": 46.15,
   "text": "עם עיניים בורקות,"
  },
  {
   "start": 46.81,
   "end": 48.15,
   "text": "ילד כבן ארבע שנים."
  },
  {
   "start": 49.45,
   "end": 50.09,
   "text": "הבן שלו,"
  },
  {
   "start": 50.89,
   "end": 51.81,
   "text": "בנו אלחנן,"
  },
  {
   "start": 53.27,
   "end": 54.23,
   "text": "ואלחנן הקטן הציץ."
  },
  {
   "start": 57.19,
   "end": 58.97,
   "text": "אלחנן הקטן היה ברוך כישרונות,"
  },
  {
   "start": 59.33,
   "end": 60.77,
   "text": "הוא ידע כבר לקרוא בגיל ארבע."
  },
  {
   "start": 61.59,
   "end": 65.2,
   "text": "הוא הציץ בכותב."
  },
  {
   "start": 66.6,
   "end": 68.38,
   "text": "וכשהוא ראה, הוא אמר, אבא,"
  },
  {
   "start": 68.98,
   "end": 71.42,
   "text": "אבא, אתה כתבת את השם שלי בראש השיר."
  },
  {
   "start": 72.56,
   "end": 73.16,
   "text": "אבא, אתה יודע?"
  },
  {
   "start": 73.92,
   "end": 75.46,
   "text": "זה השם שלי בראש השיר."
  },
  {
   "start": 76.92,
   "end": 77.52,
   "text": "ואביו,"
  },
  {
   "start": 78.38,
   "end": 79.74,
   "text": "אביו היהודי הצדיק,"
  },
  {
   "start": 80.46,
   "end": 83.56,
   "text": "רבי שמעון הגדול, הרב של קהילת מגנצה,"
  },
  {
   "start": 84.2,
   "end": 85.26,
   "text": "אמר לו, כן, בני,"
  },
  {
   "start": 86.42,
   "end": 88.2,
   "text": "אלחנן נחלתו."
  },
  {
   "start": 89.78,
   "end": 91.46,
   "text": "ככה רשמתי בשיר."
  },
  {
   "start": 92.34,
   "end": 92.94,
   "text": "אבא, למה?"
  },
  {
   "start": 93.72,
   "end": 95.6,
   "text": "למה רשמת אלחנן נחלתו?"
  },
  {
   "start": 96.72,
   "end": 105.76,
   "text": "רשמתי ככה כי הקדוש ברוך הוא חנון ורחום אפילו למי שנאלץ להתרחק ממנו רחוק מאבא שבשמיים."
  },
  {
   "start": 106.72,
   "end": 107.92,
   "text": "אבא שבשמיים תמיד,"
  },
  {
   "start": 108.42,
   "end": 111.54,
   "text": "תמיד מוכן לסייע לו לחזור בתשובה אליו."
  },
  {
   "start": 113.28,
   "end": 114.84,
   "text": "ואז לפתע הילד הקדוש הזה,"
  },
  {
   "start": 115.62,
   "end": 116.48,
   "text": "הילד אמר, אבא,"
  },
  {
   "start": 117.06,
   "end": 118.28,
   "text": "אבא, אני אף פעם,"
  },
  {
   "start": 118.7,
   "end": 121.12,
   "text": "אף פעם לא אתרחק מהקדוש ברוך הוא,"
  },
  {
   "start": 121.46,
   "end": 123.12,
   "text": "מהשם הטוב והיקר."
  },
  {
   "start": 123.78,
   "end": 127.34,
   "text": "אבא, אני לא אתרחק מהשם הטוב היקר שלי."
  },
  {
   "start": 128.4,
   "end": 131.96,
   "text": "והדמרות חנקו את גרונו של הילד בעל הנשמה הרגישה,"
  },
  {
   "start": 133.18,
   "end": 133.86,
   "text": "והוא ברח,"
  },
  {
   "start": 134.58,
   "end": 136.22,
   "text": "הוא ברח למחות את דמעותיו הלוהטות."
  },
  {
   "start": 146.53,
   "end": 147.57,
   "text": "ענן של קדרות,"
  },
  {
   "start": 149.65,
   "end": 151.65,
   "text": "ענן של עצבות,"
  },
  {
   "start": 152.47,
   "end": 153.91,
   "text": "העיב על בית רבי שמעון,"
  },
  {
   "start": 155.55,
   "end": 156.39,
   "text": "הגדול ממגנזה."
  },
  {
   "start": 157.49,
   "end": 159.11,
   "text": "בנו הקטן, אלחנן,"
  },
  {
   "start": 159.11,
   "end": 162.85,
   "text": "חולה מזה מספר שבועות,"
  },
  {
   "start": 163.61,
   "end": 167.01,
   "text": "חום גבוה עד כדי אובדן הכרה."
  },
  {
   "start": 169.23,
   "end": 171.77,
   "text": "מדי פעם שומעים אותו ממלמל מלמולים לא ברורים,"
  },
  {
   "start": 172.93,
   "end": 175.73,
   "text": "כשהדבר היחיד שניכר בדבריו"
  },
  {
   "start": 176.85,
   "end": 177.63,
   "text": "היו המילים"
  },
  {
   "start": 178.31,
   "end": 179.75,
   "text": "אל חנן נחלתו."
  },
  {
   "start": 181.39,
   "end": 182.47,
   "text": "אל חנן נחלתו."
  },
  {
   "start": 183.83,
   "end": 184.95,
   "text": "אל חנן נחלתו."
  },
  {
   "start": 186.59,
   "end": 187.83,
   "text": "אל חנן נחלתו."
  },
  {
   "start": 191.8,
   "end": 192.76,
   "text": "רבי שמעון הגדול"
  },
  {
   "start": 193.7,
   "end": 197.98,
   "text": "ורעייתו הרבו בתפילות דמעות על הבן שלהם,"
  },
  {
   "start": 198.68,
   "end": 199.0,
   "text": "על הבן,"
  },
  {
   "start": 199.78,
   "end": 200.68,
   "text": "הבן הכת שלהם."
  },
  {
   "start": 202.8,
   "end": 205.08,
   "text": "אף אחד לא יכל להישאר בדמיון הכי פרוע,"
  },
  {
   "start": 206.02,
   "end": 207.34,
   "text": "בדמיון הכי מזוויע,"
  },
  {
   "start": 208.1,
   "end": 209.08,
   "text": "שבחדר השני,"
  },
  {
   "start": 211.26,
   "end": 214.76,
   "text": "שם הייתה לה משרתת נוצרייה בשם מרגרט,"
  },
  {
   "start": 216.58,
   "end": 218.54,
   "text": "שהיא ישבה ורקמה לה מזימות."
  },
  {
   "start": 219.7,
   "end": 220.84,
   "text": "הילד הזה הוא שלי."
  },
  {
   "start": 221.84,
   "end": 224.34,
   "text": "כך החלפה בה שוב ושוב מחשבה שטנית."
  },
  {
   "start": 225.32,
   "end": 226.38,
   "text": "היא רצתה את הילד."
  },
  {
   "start": 227.78,
   "end": 233.1,
   "text": "היא לא הייתה מוכנה לתת לילד הזה לגדול כילד יהודי."
  },
  {
   "start": 234.74,
   "end": 238.25,
   "text": "היא רצתה לקחת אותו לנצרות."
  },
  {
   "start": 239.73,
   "end": 241.57,
   "text": "אף אחד לא יכל לדמיין לחשוב"
  },
  {
   "start": 246.0,
   "end": 249.2,
   "text": "על המוח המעוות של המשרתת."
  },
  {
   "start": 254.41,
   "end": 255.09,
   "text": "וכך הילד"
  },
  {
   "start": 256.47,
   "end": 257.59,
   "text": "שוכב במיטתו,"
  },
  {
   "start": 258.97,
   "end": 259.81,
   "text": "ואבא ואימא מתפללים."
  },
  {
   "start": 263.11,
   "end": 263.63,
   "text": "בורא העולם,"
  },
  {
   "start": 264.43,
   "end": 265.43,
   "text": "תציל לנו את הילד."
  },
  {
   "start": 266.31,
   "end": 275.67,
   "text": "כל העולם תציל לנו את הילד ובחדר השני רוקמים מזימות,"
  },
  {
   "start": 277.87,
   "end": 279.99,
   "text": "מזימות מרושעות."
  },
  {
   "start": 284.61,
   "end": 285.11,
   "text": "יום שבת,"
  },
  {
   "start": 286.27,
   "end": 287.03,
   "text": "כל המשפחה"
  },
  {
   "start": 287.65,
   "end": 288.67,
   "text": "הלכו לבית הכנסת."
  },
  {
   "start": 290.57,
   "end": 291.03,
   "text": "בבית"
  },
  {
   "start": 292.15,
   "end": 292.75,
   "text": "אלחנן"
  },
  {
   "start": 293.35,
   "end": 296.67,
   "text": "שכבר התחיל להתאושש מהמחלה שלו."
  },
  {
   "start": 297.91,
   "end": 301.85,
   "text": "בחדר השני יושבת לה מרגרט המשרתת הנוצרייה"
  },
  {
   "start": 306.06,
   "end": 307.2,
   "text": "וכל המשפחה הלכה"
  },
  {
   "start": 307.2,
   "end": 315.54,
   "text": "הלכה לבית הכנסת להתפלל יום שבת בתום התפילה הם חזרו הביתה"
  },
  {
   "start": 317.06,
   "end": 318.02,
   "text": "לחיצה לידית"
  },
  {
   "start": 318.62,
   "end": 319.64,
   "text": "והדלת נפתחה"
  },
  {
   "start": 321.02,
   "end": 323.14,
   "text": "הם הרגישו מיד משהו משונה"
  },
  {
   "start": 324.72,
   "end": 327.32,
   "text": "איזה רקנות מוזרה שאתה מרגיש באווירה"
  },
  {
   "start": 329.82,
   "end": 330.26,
   "text": "האימה"
  },
  {
   "start": 332.45,
   "end": 335.33,
   "text": "הרגשות האימהים שלה גאו בה אלחנן"
  },
  {
   "start": 336.35,
   "end": 339.79,
   "text": "אלחנן אלחנן"
  },
  {
   "start": 341.27,
   "end": 342.33,
   "text": "אין קול ואין עונה"
  },
  {
   "start": 343.61,
   "end": 346.37,
   "text": "היא לא הבינה למה מבלי, היא חשה צורך לרוץ במהירות,"
  },
  {
   "start": 346.71,
   "end": 347.55,
   "text": "רצה במהירות,"
  },
  {
   "start": 347.91,
   "end": 348.99,
   "text": "אולי אפילו בבהלה."
  },
  {
   "start": 350.03,
   "end": 350.81,
   "text": "פותחת החדר,"
  },
  {
   "start": 352.94,
   "end": 353.32,
   "text": "החדר ריק,"
  },
  {
   "start": 354.16,
   "end": 354.68,
   "text": "המיטה."
  },
  {
   "start": 355.62,
   "end": 356.64,
   "text": "אלחנן כבר לא שם,"
  },
  {
   "start": 358.85,
   "end": 360.15,
   "text": "אלחנן הקטן נעלם,"
  },
  {
   "start": 362.75,
   "end": 363.87,
   "text": "בלעה אותו האדמה."
  },
  {
   "start": 364.81,
   "end": 366.17,
   "text": "הם חיפשו בכל מקום,"
  },
  {
   "start": 369.42,
   "end": 370.26,
   "text": "ואלחנן נעלם."
  },
  {
   "start": 371.36,
   "end": 373.22,
   "text": "יחד איתו נעלמה גם מרגרט,"
  },
  {
   "start": 375.16,
   "end": 377.94,
   "text": "המשרתת, הנוצרייה,"
  },
  {
   "start": 378.56,
   "end": 387.17,
   "text": "אף היא נעלמו עקבותיה, בכי של האמא,"
  },
  {
   "start": 387.79,
   "end": 392.55,
   "text": "אי אפשר היה לתאר, בכי של אמא."
  },
  {
   "start": 394.25,
   "end": 395.17,
   "text": "בכי שלא פסק מעולם,"
  },
  {
   "start": 398.39,
   "end": 398.99,
   "text": "והאב,"
  },
  {
   "start": 399.67,
   "end": 402.29,
   "text": "רבי שמעון, שהיה כל כך קשור לבן שלו,"
  },
  {
   "start": 403.37,
   "end": 404.49,
   "text": "פשוט סירב,"
  },
  {
   "start": 405.01,
   "end": 407.91,
   "text": "סירב להתנחם מהכאב הגדול הזה."
  },
  {
   "start": 408.93,
   "end": 410.23,
   "text": "והוא יושב ולומד תורה,"
  },
  {
   "start": 411.09,
   "end": 412.69,
   "text": "יושב וכותב שירים בדמעות,"
  },
  {
   "start": 413.31,
   "end": 414.69,
   "text": "מדי פעם הוא היה מרים את השיר"
  },
  {
   "start": 415.33,
   "end": 416.49,
   "text": "אל חנה נחלתו,"
  },
  {
   "start": 418.37,
   "end": 419.71,
   "text": "ונחל של דמעות,"
  },
  {
   "start": 422.13,
   "end": 424.41,
   "text": "שנראה שלעולם לא ייגמר,"
  },
  {
   "start": 426.07,
   "end": 426.85,
   "text": "כיסה את עיניו,"
  },
  {
   "start": 428.77,
   "end": 432.65,
   "text": "והתחיל להתגלגלו במורד לחיו."
  },
  {
   "start": 433.89,
   "end": 434.65,
   "text": "איזה כאב."
  },
  {
   "start": 443.59,
   "end": 444.95,
   "text": "שמונה עשרה שנים אחר כך,"
  },
  {
   "start": 447.94,
   "end": 449.16,
   "text": "זמן ארוך מאוד."
  },
  {
   "start": 450.86,
   "end": 451.46,
   "text": "פליקס,"
  },
  {
   "start": 452.16,
   "end": 455.7,
   "text": "פליקס היה אחד מפרחי הכמורה המצטיינים ביותר בעולם הנוצרי."
  },
  {
   "start": 457.1,
   "end": 459.3,
   "text": "האפיפיור גרגורי השביעי,"
  },
  {
   "start": 460.04,
   "end": 461.44,
   "text": "שפליקס היה מבאי ביתו,"
  },
  {
   "start": 462.42,
   "end": 464.72,
   "text": "מינה את פליקס המצטיין לבישוף."
  },
  {
   "start": 466.48,
   "end": 467.72,
   "text": "ומשהוא התמנה לבישוף,"
  },
  {
   "start": 468.92,
   "end": 471.2,
   "text": "הבישוף פליקס הצליח בכל מה שעשה,"
  },
  {
   "start": 471.78,
   "end": 473.52,
   "text": "כישוריו היו יוצאים מגדר הרגיל,"
  },
  {
   "start": 474.2,
   "end": 476.68,
   "text": "ודרכו לצמרת הנוצרית הייתה סלולה."
  },
  {
   "start": 477.9,
   "end": 480.1,
   "text": "עד מהרה הוא התמנה לחשמן,"
  },
  {
   "start": 480.78,
   "end": 483.46,
   "text": "והיה נציגו האישי של האפיפיור ברחבי אירופה."
  },
  {
   "start": 484.44,
   "end": 485.56,
   "text": "ושנים אחר כך,"
  },
  {
   "start": 486.1,
   "end": 487.58,
   "text": "האפיפיור גריגורי השביעי"
  },
  {
   "start": 488.34,
   "end": 491.08,
   "text": "שכב לו על ערש דוואי ימיו ספורים."
  },
  {
   "start": 492.72,
   "end": 493.08,
   "text": "והוא פונה"
  },
  {
   "start": 494.82,
   "end": 497.54,
   "text": "אל מועצת החשמנים ומבקש שהיורש שלו"
  },
  {
   "start": 498.18,
   "end": 499.8,
   "text": "יהיה החשמן פליקס."
  },
  {
   "start": 502.63,
   "end": 505.79,
   "text": "אחרי מותו מתכנסת למועצת החשמנים העליונה,"
  },
  {
   "start": 507.17,
   "end": 507.63,
   "text": "ואכן,"
  },
  {
   "start": 508.29,
   "end": 510.59,
   "text": "פליקס נבחר פה אחד לאפיפיור,"
  },
  {
   "start": 512.13,
   "end": 513.33,
   "text": "ושמו כאפיפיור"
  },
  {
   "start": 514.07,
   "end": 516.05,
   "text": "ייקרא ויקטור השלישי."
  },
  {
   "start": 519.77,
   "end": 521.67,
   "text": "ויקטור השלישי היה צריך להיות רגוע ושלו."
  },
  {
   "start": 522.91,
   "end": 524.39,
   "text": "באמת ככה זה היה נראה כלפי חוץ."
  },
  {
   "start": 525.11,
   "end": 525.71,
   "text": "אבל בתוכו,"
  },
  {
   "start": 526.33,
   "end": 529.19,
   "text": "בתוכו היה הרגש ששאף להתפוצץ,"
  },
  {
   "start": 529.63,
   "end": 530.95,
   "text": "והוא לא ידע על מה ולמה."
  },
  {
   "start": 532.05,
   "end": 534.89,
   "text": "הייתה לו איזה שאלה אחת שנקרע לה במוחו ללא הרף."
  },
  {
   "start": 536.01,
   "end": 536.51,
   "text": "כל ימיו,"
  },
  {
   "start": 537.13,
   "end": 537.81,
   "text": "מגיל צעיר."
  },
  {
   "start": 538.93,
   "end": 541.11,
   "text": "איש לא יכל לספר לו מאין הוא בא,"
  },
  {
   "start": 541.85,
   "end": 542.57,
   "text": "היכן נולד,"
  },
  {
   "start": 543.29,
   "end": 544.49,
   "text": "מה הן מקורותיו,"
  },
  {
   "start": 545.09,
   "end": 546.03,
   "text": "לאן הוא שייך."
  },
  {
   "start": 549.1,
   "end": 550.0,
   "text": "משהו בתוכו של"
  },
  {
   "start": 551.52,
   "end": 554.38,
   "text": "האפיפיור ויקטור השלישי לא נתן לו מנוח."
  },
  {
   "start": 556.34,
   "end": 557.44,
   "text": "מרגרטה משרתת"
  },
  {
   "start": 558.04,
   "end": 558.8,
   "text": "כבר מזמן מתה,"
  },
  {
   "start": 560.02,
   "end": 565.36,
   "text": "ולא היה בעולם מי שיאמר, שיספר, שיגלה לאפיפיור"
  },
  {
   "start": 566.02,
   "end": 566.6,
   "text": "מי הוא באמת."
  },
  {
   "start": 577.39,
   "end": 579.11,
   "text": "האפיפיור ויקטור השלישי"
  },
  {
   "start": 579.69,
   "end": 581.17,
   "text": "קרא שוב ושוב את המכתב"
  },
  {
   "start": 581.79,
   "end": 583.47,
   "text": "שנשלח לו מיהודי קהילת מגנסה."
  },
  {
   "start": 584.91,
   "end": 585.79,
   "text": "הם ביקשו להיפגש איתו,"
  },
  {
   "start": 586.67,
   "end": 589.69,
   "text": "בקשר לאיזה גזירה שגזר הבישוף המקומי."
  },
  {
   "start": 591.03,
   "end": 593.59,
   "text": "לא היתה לה סיבה לסרב להם, הוא נעתר לבקשתם"
  },
  {
   "start": 594.55,
   "end": 598.79,
   "text": "לשלוח לו משלחת על מנת להסביר לו את עמדתם."
  },
  {
   "start": 601.3,
   "end": 601.74,
   "text": "וככה,"
  },
  {
   "start": 603.02,
   "end": 603.94,
   "text": "שבוע אחר כך,"
  },
  {
   "start": 605.9,
   "end": 606.94,
   "text": "לפתע השומר,"
  },
  {
   "start": 608.18,
   "end": 612.98,
   "text": "בפתח קרא משלחת ממגן סייגייה, המשלחת ממגן סייגייה,"
  },
  {
   "start": 615.24,
   "end": 615.56,
   "text": "והביט,"
  },
  {
   "start": 616.2,
   "end": 617.84,
   "text": "והאפיפיור סימן לו להכניס אותם."
  },
  {
   "start": 619.8,
   "end": 620.54,
   "text": "והם נכנסו."
  },
  {
   "start": 622.12,
   "end": 622.74,
   "text": "בראשם"
  },
  {
   "start": 624.3,
   "end": 625.72,
   "text": "בראש המשלחת היה רב,"
  },
  {
   "start": 628.38,
   "end": 629.3,
   "text": "רב קשיש,"
  },
  {
   "start": 631.44,
   "end": 632.48,
   "text": "רב הדור פנים."
  },
  {
   "start": 634.3,
   "end": 637.42,
   "text": "האפיפיור האזין בקשב רב לבקשות שלהם,"
  },
  {
   "start": 639.5,
   "end": 640.6,
   "text": "וכשהרב דיבר,"
  },
  {
   "start": 641.98,
   "end": 643.5,
   "text": "הוא לא יודע להסביר את זה, הוא נהנה,"
  },
  {
   "start": 644.28,
   "end": 645.26,
   "text": "נהנה להקשיב,"
  },
  {
   "start": 646.04,
   "end": 649.42,
   "text": "וכאילו משהו מבפנים אמר לו שהרב ימשיך לדבר,"
  },
  {
   "start": 649.96,
   "end": 650.56,
   "text": "וידבר,"
  },
  {
   "start": 651.02,
   "end": 651.58,
   "text": "וידבר,"
  },
  {
   "start": 652.06,
   "end": 652.7,
   "text": "ולא יפסיק,"
  },
  {
   "start": 653.26,
   "end": 653.88,
   "text": "ולא יפסיק."
  },
  {
   "start": 660.58,
   "end": 662.12,
   "text": "בתום שעה ארוכה"
  },
  {
   "start": 662.96,
   "end": 664.16,
   "text": "הסתיים המפגש."
  },
  {
   "start": 666.7,
   "end": 669.28,
   "text": "בבחינה בשביל היהודים זה היה מפגש שהסתיים בהצלחה."
  },
  {
   "start": 670.04,
   "end": 675.8,
   "text": "נשלחו הוראות מהאפיפיור לבישוף לבטל מיידית את כל הגזרות שלו כנגד היהודים."
  },
  {
   "start": 676.94,
   "end": 678.66,
   "text": "וחברי המשלחת יצאו מרוצים,"
  },
  {
   "start": 682.56,
   "end": 683.04,
   "text": "אבל לא כולם."
  },
  {
   "start": 684.3,
   "end": 684.88,
   "text": "רק הרב,"
  },
  {
   "start": 686.14,
   "end": 688.34,
   "text": "הרב רבי שמעון הגדול ממגנצה,"
  },
  {
   "start": 689.3,
   "end": 690.4,
   "text": "התנהל לו מאחורה,"
  },
  {
   "start": 691.44,
   "end": 693.16,
   "text": "שקוע בשרעפים כבדים."
  },
  {
   "start": 694.16,
   "end": 695.92,
   "text": "כל השיחה עם האפיפיור,"
  },
  {
   "start": 696.44,
   "end": 700.36,
   "text": "עיניו נמשכו בו אורך מגנטי אל תוך עיני האפיפיור."
  },
  {
   "start": 701.34,
   "end": 702.88,
   "text": "הוא התרשם מהאפיפיור העמוקות,"
  },
  {
   "start": 703.52,
   "end": 704.22,
   "text": "והוא לא מבין למה."
  },
  {
   "start": 708.28,
   "end": 710.22,
   "text": "ובינתיים בפנים, בחדר,"
  },
  {
   "start": 711.4,
   "end": 712.7,
   "text": "נותר האפיפיור מעורהר."
  },
  {
   "start": 715.88,
   "end": 716.2,
   "text": "הרב,"
  },
  {
   "start": 717.1,
   "end": 718.24,
   "text": "משהו ברב היהודי,"
  },
  {
   "start": 718.94,
   "end": 720.56,
   "text": "משהו ברב היהודי המבוגר,"
  },
  {
   "start": 721.32,
   "end": 723.08,
   "text": "בעל הפנים המהירות משך אותו."
  },
  {
   "start": 724.12,
   "end": 726.18,
   "text": "משהו גרם לנפשו הסוערת בפנים,"
  },
  {
   "start": 726.94,
   "end": 727.7,
   "text": "רגיעה."
  },
  {
   "start": 730.02,
   "end": 731.5,
   "text": "כל זמן שהרב דיבר,"
  },
  {
   "start": 732.62,
   "end": 733.62,
   "text": "הוא חש רגיעה."
  },
  {
   "start": 734.14,
   "end": 734.74,
   "text": "את אותו איש שקט,"
  },
  {
   "start": 735.42,
   "end": 736.94,
   "text": "את אותו משהו שמציק לו,"
  },
  {
   "start": 737.86,
   "end": 738.84,
   "text": "כשהרב דיבר,"
  },
  {
   "start": 740.02,
   "end": 740.78,
   "text": "זה נרגע."
  },
  {
   "start": 741.64,
   "end": 745.36,
   "text": "הוא חש שלווה שמעולם לא הרגיש כמותה."
  },
  {
   "start": 752.17,
   "end": 754.85,
   "text": "הוא היה חייב לעשות משהו מזה."
  },
  {
   "start": 756.39,
   "end": 757.95,
   "text": "אותו כוח פנימי הניע אותו,"
  },
  {
   "start": 760.54,
   "end": 763.24,
   "text": "והיד לקחה העט והתחילה לרשום,"
  },
  {
   "start": 764.08,
   "end": 765.72,
   "text": "ורשמה ורשמה."
  },
  {
   "start": 768.17,
   "end": 768.83,
   "text": "במגנצה,"
  },
  {
   "start": 769.73,
   "end": 775.91,
   "text": "רבי שמעון הגדול לא ידע איך להגיב כשקיבל הזמנה אישית מהאפיפיור לבוא אליו לשיחה."
  },
  {
   "start": 778.02,
   "end": 778.84,
   "text": "הוא לא יכל לסרב."
  },
  {
   "start": 782.51,
   "end": 787.79,
   "text": "והוא מתחיל במסע לכיוון הוותיקן אל האפיפיור."
  },
  {
   "start": 797.7,
   "end": 798.62,
   "text": "והם נפגשו."
  },
  {
   "start": 800.46,
   "end": 803.72,
   "text": "הם נפגשו והשיחה גלשה אל נושאי אמונה."
  },
  {
   "start": 805.26,
   "end": 806.74,
   "text": "והאפיפיור היה נלהב,"
  },
  {
   "start": 807.74,
   "end": 808.58,
   "text": "נרגש,"
  },
  {
   "start": 809.4,
   "end": 810.44,
   "text": "עולם חדש,"
  },
  {
   "start": 811.04,
   "end": 811.66,
   "text": "לא מוכר,"
  },
  {
   "start": 812.24,
   "end": 813.1,
   "text": "נפתח בפניו."
  },
  {
   "start": 815.24,
   "end": 817.7,
   "text": "הרב הדהים אותו בחנות המחשבה שלו,"
  },
  {
   "start": 818.54,
   "end": 819.7,
   "text": "בעמקות ההבנה."
  },
  {
   "start": 821.24,
   "end": 821.84,
   "text": "וככה,"
  },
  {
   "start": 823.02,
   "end": 827.04,
   "text": "הרב הקשיש והאפיפיור הצעיר"
  },
  {
   "start": 829.1,
   "end": 831.02,
   "text": "לומדים להכיר אחד את השני."
  },
  {
   "start": 838.52,
   "end": 840.64,
   "text": "במה כבוד הרב עוסק בשעות הפנאי?"
  },
  {
   "start": 843.3,
   "end": 844.04,
   "text": "ענה הרב,"
  },
  {
   "start": 844.92,
   "end": 846.06,
   "text": "אין לי שעות פניי,"
  },
  {
   "start": 847.1,
   "end": 854.32,
   "text": "אבל בזמן בו אני רוצה לפרוס את ליבי בפני הקדוש ברוך הוא,"
  },
  {
   "start": 855.42,
   "end": 856.06,
   "text": "אני עושה את זה"
  },
  {
   "start": 856.68,
   "end": 859.28,
   "text": "דרך שירים שאני כותב,"
  },
  {
   "start": 860.04,
   "end": 860.88,
   "text": "שאני מחבר,"
  },
  {
   "start": 862.12,
   "end": 862.98,
   "text": "שירי תפילה,"
  },
  {
   "start": 863.6,
   "end": 865.5,
   "text": "שירי ערגה לאבא שבשמיים."
  },
  {
   "start": 867.24,
   "end": 870.96,
   "text": "ולפתע, דוק של דמעות כיסה את עיני הרב."
  },
  {
   "start": 878.93,
   "end": 880.05,
   "text": "האפיפיור ראה את הדמעות."
  },
  {
   "start": 880.91,
   "end": 882.01,
   "text": "בעיני הרב הוא שאל,"
  },
  {
   "start": 883.01,
   "end": 883.97,
   "text": "כבוד הרב, מדוע?"
  },
  {
   "start": 884.75,
   "end": 886.67,
   "text": "מדוע ינחקו מתרגש הדמעות?"
  },
  {
   "start": 888.01,
   "end": 891.05,
   "text": "אמר לו הרב כל פעם שאני מדבר על השירים שלי."
  },
  {
   "start": 891.97,
   "end": 893.53,
   "text": "אני נזכר בשיר אחד,"
  },
  {
   "start": 896.8,
   "end": 899.46,
   "text": "בשיר אחד רווי בנחל של דמעות,"
  },
  {
   "start": 900.0,
   "end": 902.04,
   "text": "שיר שחיברתי על הבן שלי,"
  },
  {
   "start": 902.96,
   "end": 905.16,
   "text": "על הבן היקר והאהוב שלי,"
  },
  {
   "start": 905.64,
   "end": 908.58,
   "text": "שבגיל ארבע לקחו אותו ממני,"
  },
  {
   "start": 908.96,
   "end": 910.78,
   "text": "בגיל ארבע הוא נגנב ממני,"
  },
  {
   "start": 911.6,
   "end": 912.0,
   "text": "ואיננו."
  },
  {
   "start": 913.56,
   "end": 917.78,
   "text": "תדע לך, יש פצעים שבלב, שמעולם לא הגלידו."
  },
  {
   "start": 918.82,
   "end": 920.6,
   "text": "אמר הרב הקשיש בקול רועד,"
  },
  {
   "start": 926.95,
   "end": 928.55,
   "text": "שתיקה השתררה בחדר."
  },
  {
   "start": 930.01,
   "end": 932.01,
   "text": "ואז האפיפיור שאל לך ראשית,"
  },
  {
   "start": 932.91,
   "end": 940.38,
   "text": "רפי, טובחן, שכתבת על הבן שלך,"
  },
  {
   "start": 941.26,
   "end": 945.08,
   "text": "זה הבן היקר שנעלם, ואיננו."
  },
  {
   "start": 951.44,
   "end": 952.02,
   "text": "רבי שמעון פתח."
  },
  {
   "start": 954.09,
   "end": 955.35,
   "text": "ואז רבי שמעון פתח"
  },
  {
   "start": 955.35,
   "end": 961.79,
   "text": "את פיסת הניער והחל לקרוא אל חנן נחלתו,"
  },
  {
   "start": 966.99,
   "end": 968.13,
   "text": "אל חנן נחלתו,"
  },
  {
   "start": 971.92,
   "end": 972.88,
   "text": "ומשהו קרה בחדר."
  },
  {
   "start": 974.6,
   "end": 975.36,
   "text": "האפיפיור,"
  },
  {
   "start": 976.06,
   "end": 977.04,
   "text": "ויקטור השלישי,"
  },
  {
   "start": 978.02,
   "end": 981.16,
   "text": "נותר נעוץ, מסומר למקומו,"
  },
  {
   "start": 982.86,
   "end": 984.14,
   "text": "רועד בכל גופו,"
  },
  {
   "start": 985.98,
   "end": 988.38,
   "text": "כשכמעין הבזק"
  },
  {
   "start": 989.46,
   "end": 990.0,
   "text": "במוחו"
  },
  {
   "start": 991.06,
   "end": 992.12,
   "text": "מחזיר אותו אחורה,"
  },
  {
   "start": 992.74,
   "end": 993.6,
   "text": "שנים אחורה"
  },
  {
   "start": 994.54,
   "end": 995.56,
   "text": "אל ילד קטן,"
  },
  {
   "start": 996.62,
   "end": 997.34,
   "text": "בן ארבע,"
  },
  {
   "start": 998.4,
   "end": 999.34,
   "text": "אל חנן,"
  },
  {
   "start": 1002.16,
   "end": 1004.52,
   "text": "אל בית עם אימא יהודייה,"
  },
  {
   "start": 1005.24,
   "end": 1006.5,
   "text": "עם אבא צדיק,"
  },
  {
   "start": 1007.2,
   "end": 1008.52,
   "text": "בית חם ואוהב,"
  },
  {
   "start": 1010.1,
   "end": 1011.56,
   "text": "אל חנן נחלתו,"
  },
  {
   "start": 1012.26,
   "end": 1013.52,
   "text": "אל הבטחה של ילד"
  },
  {
   "start": 1014.6,
   "end": 1016.88,
   "text": "שהוא לא ישכח ולא יעזוב את פורע העולם."
  },
  {
   "start": 1018.76,
   "end": 1020.5,
   "text": "האפיפיור ויקטור השלישי"
  },
  {
   "start": 1025.84,
   "end": 1028.62,
   "text": "חוזר אחורה אל ילדותו,"
  },
  {
   "start": 1029.28,
   "end": 1030.64,
   "text": "אל מחוזות ילדותו."
  },
  {
   "start": 1034.57,
   "end": 1034.87,
   "text": "אבא,"
  },
  {
   "start": 1037.14,
   "end": 1038.64,
   "text": "אבא זה עניאל חנן,"
  },
  {
   "start": 1039.28,
   "end": 1042.6,
   "text": "נפלט את הקריאה מפיו של האפיפיור,"
  },
  {
   "start": 1048.06,
   "end": 1049.8,
   "text": "והלא יאומן קרה."
  },
  {
   "start": 1051.68,
   "end": 1052.78,
   "text": "אבא ובן,"
  },
  {
   "start": 1053.32,
   "end": 1054.44,
   "text": "אבא ישיש,"
  },
  {
   "start": 1055.02,
   "end": 1058.46,
   "text": "עם דמעות דמעות ותיקות וישנות."
  },
  {
   "start": 1059.68,
   "end": 1060.38,
   "text": "ובן,"
  },
  {
   "start": 1061.24,
   "end": 1062.94,
   "text": "בן שגילה את אבא,"
  },
  {
   "start": 1063.56,
   "end": 1068.6,
   "text": "בן שגילת הזעקה אילמת בנשמה שלו במשך שנים, הוא לא יודע למה."
  },
  {
   "start": 1069.32,
   "end": 1074.28,
   "text": "קופץ על אבא, מחבק אותו, אבא זה עניאל חנן."
  },
  {
   "start": 1075.24,
   "end": 1077.32,
   "text": "אבא זה עניאל חנן, הבן שלך."
  },
  {
   "start": 1079.42,
   "end": 1084.88,
   "text": "ושמעון, רבי שמעון הגדול, רבי שמעון הגדול בוכה ללא קול."
  },
  {
   "start": 1087.49,
   "end": 1089.49,
   "text": "נחנק מדמעות."
  },
  {
   "start": 1093.59,
   "end": 1096.45,
   "text": "אבא ובן שמצאו אחד את השני."
  },
  {
   "start": 1102.4,
   "end": 1107.14,
   "text": "האפיפיור הוא לא האפיפיור, הוא אלחנן."
  },
  {
   "start": 1107.8,
   "end": 1115.54,
   "text": "אלחנן היהודי, אלחנן הילד, אלחנן עם הנשמה הלוהטת, אל השם מטבח."
  },
  {
   "start": 1117.42,
   "end": 1123.78,
   "text": "תופס את אבא כאוחז בחיים, כאוחז בגלגל ההצלה, גלגל מפלט,"
  },
  {
   "start": 1124.6,
   "end": 1125.52,
   "text": "אל הנשמה שלו,"
  },
  {
   "start": 1126.74,
   "end": 1127.38,
   "text": "והם בוכים"
  },
  {
   "start": 1128.12,
   "end": 1129.62,
   "text": "אחד על כתפי השני."
  },
  {
   "start": 1152.8,
   "end": 1153.96,
   "text": "מספר ימים אחר כך"
  },
  {
   "start": 1154.94,
   "end": 1156.7,
   "text": "התקיימה לה ווידת חשמנים גדולה,"
  },
  {
   "start": 1158.72,
   "end": 1166.12,
   "text": "שהייתה צריכה להתקיים בהשתתפותו של האפיפיור ויקטור השלישי."
  },
  {
   "start": 1168.36,
   "end": 1171.88,
   "text": "אבל התברר שהאפיפיור לא מגיע,"
  },
  {
   "start": 1172.6,
   "end": 1174.3,
   "text": "האפיפיור ויקטור השלישי נעלם."
  },
  {
   "start": 1176.14,
   "end": 1176.56,
   "text": "עד היום"
  },
  {
   "start": 1177.4,
   "end": 1181.25,
   "text": "איש לא יודע איך הוא נעלם."
  },
  {
   "start": 1182.01,
   "end": 1187.65,
   "text": "בוותיקן מסבירים את זה שהוא יצא למסע במרחבי הזמן הבלתי נגמרים."
  },
  {
   "start": 1189.35,
   "end": 1192.47,
   "text": "במרחבי העולמות יצא לשוט,"
  },
  {
   "start": 1195.94,
   "end": 1196.36,
   "text": "הם לא יודעים"
  },
  {
   "start": 1197.84,
   "end": 1198.7,
   "text": "לאן הוא נעלם."
  },
  {
   "start": 1201.48,
   "end": 1205.2,
   "text": "האפיפיור ויקטור השלישי חזר הביתה."
  },
  {
   "start": 1209.5,
   "end": 1212.96,
   "text": "כילד קטן הוא זעק, אני לא אעזוב את השם יתברך."
  },
  {
   "start": 1214.04,
   "end": 1217.68,
   "text": "הקדוש ברוך הוא לא שכח את הקריאה הזו והמתין כל"
  },
  {
   "start": 1217.68,
   "end": 1246.52,
   "text": "לדרך גם כשאותו אלחנן לקחו אותו והשכיחו ממנו את כל תורת ישראל וגידלו אותו בחיק העבודה הזרה בחיק הנצרות שנים עד שהוא הגיע לדרגה הגבוהה ביותר לאפיפיור עם עוצמה אדירה עם כסף יש לו כל מה שגוי רוצה שיהיה לו אבל הוא"
  },
  {
   "start": 1247.36,
   "end": 1248.94,
   "text": "הוא כשגילה את האמת,"
  },
  {
   "start": 1249.34,
   "end": 1252.84,
   "text": "הוא כשגילה את הקדוש ברוך הוא, כשגילה את אבא שלו,"
  },
  {
   "start": 1253.52,
   "end": 1255.56,
   "text": "את רבי שמעון, את אבא שבשמיים,"
  },
  {
   "start": 1256.34,
   "end": 1258.8,
   "text": "הוא ויתר על הכל, עזב את הכל,"
  },
  {
   "start": 1259.3,
   "end": 1263.04,
   "text": "כי יהודי, יהודי, יודע, יודע, יודע שהוא רוצה להיות עם השם מתברך."
  },
  {
   "start": 1265.1,
   "end": 1266.42,
   "text": "זה היה לפני 600 שנה,"
  },
  {
   "start": 1269.41,
   "end": 1270.11,
   "text": "וזה גם היום."
  },
  {
   "start": 1270.77,
   "end": 1276.03,
   "text": "יהודים שבקצוות האחרות בכלל של העולם, רחוקים מהשם מתברך."
  },
  {
   "start": 1276.61,
   "end": 1277.45,
   "text": "רוח הזמן,"
  },
  {
   "start": 1278.57,
   "end": 1284.97,
   "text": "סופת המאורעות לקחה אותם, תלשה אותם מגיל קטן עוד, מ' יתברך"
  },
  {
   "start": 1285.85,
   "end": 1287.97,
   "text": "ולפתע אתה רואה אותם חוזרים הביתה"
  },
  {
   "start": 1288.55,
   "end": 1290.07,
   "text": "כשהם שומעים את הקריאה,"
  },
  {
   "start": 1290.63,
   "end": 1295.77,
   "text": "את הקריאה של ה' יתברך הם באים כשהלב שומע,"
  },
  {
   "start": 1296.75,
   "end": 1300.55,
   "text": "כשהנשמה שומעת את הקדוש ברוך הוא, הם באים, עוזבים את הכל,"
  },
  {
   "start": 1300.85,
   "end": 1304.25,
   "text": "עוזבים כסף, עוזבים הצלחה, עוזבים כל מיני דברים"
  },
  {
   "start": 1305.33,
   "end": 1306.45,
   "text": "הם עוזבים ועוזבות"
  },
  {
   "start": 1307.33,
   "end": 1316.05,
   "text": "גברים ונשים גדולים מהחיים נפלאים ומופלאים הולכים בדרכו של אלחנן בדרכם של גדולי ישראל."
  },
  {
   "start": 1317.83,
   "end": 1320.55,
   "text": "כשאבא קורא כולם באים."
  },
  {
   "start": 1321.11,
   "end": 1324.51,
   "text": "כשאבא קורא כולם באים."
  }
 ]
}