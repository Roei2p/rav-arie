{
 "disc": "9ט- לעולם לא לבד",
 "track": "Track01",
 "duration": 401.184,
 "segments": [
  {
   "start": 6.06,
   "end": 12.8,
   "text": "לב רדור,"
  },
  {
   "start": 13.72,
   "end": 14.46,
   "text": "צפון קנדה,"
  },
  {
   "start": 16.2,
   "end": 16.96,
   "text": "נהר האודסון,"
  },
  {
   "start": 22.36,
   "end": 23.12,
   "text": "אל אוויר העולם,"
  },
  {
   "start": 23.96,
   "end": 25.24,
   "text": "עולה ובוקר מביצתו"
  },
  {
   "start": 26.26,
   "end": 29.44,
   "text": "דג נפלא בשם הסלומון האטלנטי."
  },
  {
   "start": 32.57,
   "end": 33.99,
   "text": "אותו דג, תוך זמן קצר,"
  },
  {
   "start": 35.09,
   "end": 37.49,
   "text": "הסלומון האטלנטי שגדל בנהר האודסון,"
  },
  {
   "start": 38.57,
   "end": 39.73,
   "text": "יוצא למסע,"
  },
  {
   "start": 40.85,
   "end": 41.87,
   "text": "מסע אל הים הגדול,"
  },
  {
   "start": 42.71,
   "end": 43.67,
   "text": "אל האוקיינוס,"
  },
  {
   "start": 44.49,
   "end": 45.87,
   "text": "האוקיינוס האטלנטי."
  },
  {
   "start": 47.67,
   "end": 48.81,
   "text": "שם הוא חי שנים."
  },
  {
   "start": 50.23,
   "end": 51.51,
   "text": "אוטו סלומון אטלנטי"
  },
  {
   "start": 52.69,
   "end": 59.01,
   "text": "גומם מרחק ממוצע של 2,400 קילומטר מהמקום בו הוא נולד."
  },
  {
   "start": 61.05,
   "end": 64.29,
   "text": "הוא נוסע במהירות של 96 קילומטר ליום,"
  },
  {
   "start": 66.07,
   "end": 69.51,
   "text": "וכך הוא חי לו במרחבי האוקיינוס הבלתי נגמרים,"
  },
  {
   "start": 70.35,
   "end": 77.47,
   "text": "רחוק אלפי קילומטר ממקום הולדתו, מהבית שלו, מהשורשים שלו, ממקורותיו."
  },
  {
   "start": 81.73,
   "end": 90.33,
   "text": "ואז יום אחד דג הסלומון האטלנטי עושה תפנית של 180 מעלות במסלול החיים שלו."
  },
  {
   "start": 91.11,
   "end": 96.09,
   "text": "איזה כוח פנימי קורא לו בתוכו בפנים לשוב הביתה."
  },
  {
   "start": 96.67,
   "end": 97.17,
   "text": "הביתה."
  },
  {
   "start": 97.85,
   "end": 99.85,
   "text": "הביתה. אל מקום הולדתו."
  },
  {
   "start": 100.23,
   "end": 102.35,
   "text": "אל המקום אליו הוא שייך יותר מכל."
  },
  {
   "start": 103.05,
   "end": 107.41,
   "text": "והסלומון פותח במסע מפרך הביתה."
  },
  {
   "start": 108.09,
   "end": 109.79,
   "text": "מסע מפרך, אתם יודעים למה?"
  },
  {
   "start": 109.79,
   "end": 122.51,
   "text": "כי רוב המסע אסלומון נע כנגד הזרם ומתאמץ בכוחות עילאיים כנגד הזרם אל הבית."
  },
  {
   "start": 124.75,
   "end": 129.93,
   "text": "איך הוא יודע את הדרך הביתה? הוא התרחק כשהיה קטן אלפי קילומטר משם."
  },
  {
   "start": 130.51,
   "end": 131.77,
   "text": "איך הוא יודע את הדרך הביתה?"
  },
  {
   "start": 132.45,
   "end": 133.61,
   "text": "איש לא יכול להסביר."
  },
  {
   "start": 134.65,
   "end": 138.31,
   "text": "איך אחרי כל כך הרבה שנים הוא חוזר במדויק,"
  },
  {
   "start": 139.07,
   "end": 141.09,
   "text": "אבל במדויק אל מקום הולדתו,"
  },
  {
   "start": 141.73,
   "end": 142.63,
   "text": "איש לא מבין."
  },
  {
   "start": 144.25,
   "end": 145.33,
   "text": "וככה סלומון,"
  },
  {
   "start": 146.71,
   "end": 147.23,
   "text": "שוחה."
  },
  {
   "start": 148.85,
   "end": 152.55,
   "text": "חזרה אל נהר ההודסון במסירות נפש,"
  },
  {
   "start": 152.93,
   "end": 154.49,
   "text": "במאמץ אדירים,"
  },
  {
   "start": 154.81,
   "end": 158.57,
   "text": "הדג הזה שוחה מאות קילומטרים כנגד הזרם."
  },
  {
   "start": 159.35,
   "end": 161.49,
   "text": "וכאשר בדרכו הוא נתקל בסלעים,"
  },
  {
   "start": 162.07,
   "end": 164.59,
   "text": "הוא קופץ מעליהם וממשיך הלאה."
  },
  {
   "start": 165.19,
   "end": 169.77,
   "text": "כשהוא נתקל במפלי מים הוא מדלג וממשיך הלאה. הם לא יעצרו אותו."
  },
  {
   "start": 170.23,
   "end": 173.53,
   "text": "הם לא יעצרו אותו בדרך הביתה אל השורשים שלו."
  },
  {
   "start": 183.4,
   "end": 191.48,
   "text": "תגידו לי, מה מניע את הסלומון למסור את כל-כולו עבור אותו מסע מפרך חזרה הביתה?"
  },
  {
   "start": 193.2,
   "end": 197.56,
   "text": "תגידו לי, מנין שואב הסלומון את הכוחות לעשות הכל,"
  },
  {
   "start": 197.96,
   "end": 198.8,
   "text": "אבל הכל,"
  },
  {
   "start": 199.14,
   "end": 204.76,
   "text": "על מנת לאפשר לדור הבא שלו להתחיל ולהמשיך באותה נקודה בה הוא התחיל?"
  },
  {
   "start": 207.1,
   "end": 209.02,
   "text": "במלך מלכי המלכים."
  },
  {
   "start": 209.66,
   "end": 214.4,
   "text": "במלך מלכי המלכים הקדוש ברוך הוא, אבא שלנו שבשמיים,"
  },
  {
   "start": 214.86,
   "end": 217.96,
   "text": "וזועק לכל נשמה ונשמה,"
  },
  {
   "start": 218.48,
   "end": 223.06,
   "text": "בני אהוביי, בנותיי היקרות והאהובות,"
  },
  {
   "start": 223.44,
   "end": 227.72,
   "text": "תראו תדג את הסלומון שבראתי בעולמי,"
  },
  {
   "start": 228.22,
   "end": 230.42,
   "text": "הוא יודע את הדרך הביתה."
  },
  {
   "start": 231.04,
   "end": 232.26,
   "text": "אפילו שהתרחק,"
  },
  {
   "start": 232.78,
   "end": 233.74,
   "text": "יש איזה חוט,"
  },
  {
   "start": 234.32,
   "end": 235.38,
   "text": "חוט בלתי נראה,"
  },
  {
   "start": 235.92,
   "end": 238.96,
   "text": "שקושר אותו, שמחזיר אותו הביתה."
  },
  {
   "start": 239.88,
   "end": 242.94,
   "text": "תדעו, בניי, בנותי האהובים והאהובות,"
  },
  {
   "start": 243.6,
   "end": 245.84,
   "text": "שאף לכם, אומר בורא עולם,"
  },
  {
   "start": 246.34,
   "end": 249.0,
   "text": "שאף לכם, לכל יהודי ויהודייה,"
  },
  {
   "start": 249.34,
   "end": 251.18,
   "text": "יש את החוט הקדוש הזה,"
  },
  {
   "start": 251.54,
   "end": 252.58,
   "text": "את הקשר הזה,"
  },
  {
   "start": 253.04,
   "end": 255.02,
   "text": "בלתי נראה, אבל קיים,"
  },
  {
   "start": 255.46,
   "end": 256.34,
   "text": "אל המקור,"
  },
  {
   "start": 256.78,
   "end": 259.1,
   "text": "ממנו נחצבה נשמתנו,"
  },
  {
   "start": 259.42,
   "end": 260.88,
   "text": "אל אותם מעיינות טוהר,"
  },
  {
   "start": 261.2,
   "end": 263.32,
   "text": "אל אותם מעיינות יופי ותמימות,"
  },
  {
   "start": 263.66,
   "end": 271.64,
   "text": "ממנו שאבנו כולנו את התכונות הנאצלות שקיימות בכל אחד ואחת מאיתנו."
  },
  {
   "start": 273.1,
   "end": 275.26,
   "text": "בפנים כל אחד יודע כמה הוא רגיש."
  },
  {
   "start": 276.06,
   "end": 279.94,
   "text": "אם נסתכל אל תוכנו, אל עצמנו, כל אחד ממי שומע ושומעת אותנו,"
  },
  {
   "start": 280.32,
   "end": 282.56,
   "text": "יודעים בפנים כמה אנחנו רגישים,"
  },
  {
   "start": 282.88,
   "end": 284.98,
   "text": "כמה באמת אנחנו רוצים אהבה,"
  },
  {
   "start": 285.4,
   "end": 286.36,
   "text": "רוצים חום,"
  },
  {
   "start": 286.88,
   "end": 288.78,
   "text": "רוצים שלום ושקט."
  },
  {
   "start": 292.25,
   "end": 293.95,
   "text": "אז אסור לנו לתת לחיי היום-יום,"
  },
  {
   "start": 294.35,
   "end": 295.63,
   "text": "להשפעות החיצוניות,"
  },
  {
   "start": 295.63,
   "end": 297.41,
   "text": "ולקרירות לכסות את זה,"
  },
  {
   "start": 301.68,
   "end": 304.74,
   "text": "לקלף את הקליפות שנעיבות על הנשמה שלנו."
  },
  {
   "start": 306.06,
   "end": 307.72,
   "text": "צריכים לדעת שלכל יהודי,"
  },
  {
   "start": 308.28,
   "end": 309.74,
   "text": "לכל יהודייה מגיע הזמן"
  },
  {
   "start": 310.7,
   "end": 314.28,
   "text": "בו אנו נקראים לחזור הביתה,"
  },
  {
   "start": 315.46,
   "end": 316.74,
   "text": "אל המקורות שלנו,"
  },
  {
   "start": 317.58,
   "end": 318.72,
   "text": "אל אבא שבשמיים."
  },
  {
   "start": 320.18,
   "end": 323.02,
   "text": "ואז אנחנו צריכים להסתובב"
  },
  {
   "start": 323.9,
   "end": 328.78,
   "text": "וכנגד הזרם, אוי אוי אוי, כנגד הזרם,"
  },
  {
   "start": 328.78,
   "end": 330.68,
   "text": "כנגד הלחץ החברתי,"
  },
  {
   "start": 331.16,
   "end": 333.22,
   "text": "כנגד מה כל העולם יגיד,"
  },
  {
   "start": 333.54,
   "end": 335.24,
   "text": "מה יגידו עליי בעבודה,"
  },
  {
   "start": 335.58,
   "end": 337.16,
   "text": "מה יגידו עליי בבית,"
  },
  {
   "start": 337.56,
   "end": 338.76,
   "text": "אני צריך להסתובב,"
  },
  {
   "start": 339.08,
   "end": 349.08,
   "text": "אנחנו צריכים להסתובב ולהתחיל לשחות כנגד הזרם ולמרות המרחק, כמה שיהודי יהודי יהודייה תהיה רחוקים מהשם יתברך,"
  },
  {
   "start": 349.86,
   "end": 351.22,
   "text": "פה העולם אוהב אותנו,"
  },
  {
   "start": 351.96,
   "end": 356.46,
   "text": "תוך קפיצה מעל כל סלעים וקשיים ומפלי מים בדרך,"
  },
  {
   "start": 356.86,
   "end": 358.48,
   "text": "תוך מסירות נפש,"
  },
  {
   "start": 358.96,
   "end": 368.92,
   "text": "תוך מסירות נפש יש לחזור את כל הדרך אל אבא שאוהב,"
  },
  {
   "start": 369.5,
   "end": 370.32,
   "text": "שמחכה לנו,"
  },
  {
   "start": 370.76,
   "end": 372.12,
   "text": "לילדים שלו, לילדות שלו,"
  },
  {
   "start": 372.92,
   "end": 375.16,
   "text": "אל עולם בהיר וברור יותר,"
  },
  {
   "start": 375.84,
   "end": 379.04,
   "text": "אל עולם היהדות שמאיר את פניו,"
  },
  {
   "start": 380.56,
   "end": 383.66,
   "text": "אל הילדים שבאים ללגום ממעיין הנעורים,"
  },
  {
   "start": 383.96,
   "end": 388.4,
   "text": "ממעיין החוכמה שמימיו לא פסקו מעולם לנבוע,"
  },
  {
   "start": 390.53,
   "end": 393.25,
   "text": "כי אנחנו כולנו הילדים של השם יתברך,"
  },
  {
   "start": 393.71,
   "end": 396.11,
   "text": "כולנו ילדים של השם יתברך."
  }
 ]
}