{
 "disc": "35ת- חנוכה מעטים כנגד רבים",
 "track": "Track05",
 "duration": 563.136,
 "segments": [
  {
   "start": 15.46,
   "end": 16.94,
   "text": "אחד המעוזים האחרונים,"
  },
  {
   "start": 18.26,
   "end": 21.12,
   "text": "אחד משדה המערכות האחרונות שנשארו באותה תקופה,"
  },
  {
   "start": 22.68,
   "end": 23.62,
   "text": "לפני כ-200 שנה,"
  },
  {
   "start": 24.2,
   "end": 24.9,
   "text": "אולי קצת יותר."
  },
  {
   "start": 26.76,
   "end": 27.52,
   "text": "בארצות הברית,"
  },
  {
   "start": 28.84,
   "end": 31.02,
   "text": "עוד לפני שהייתה ארצות הברית התחולל קרב"
  },
  {
   "start": 32.18,
   "end": 34.06,
   "text": "בין האנגלים ששלטו בארצות הברית"
  },
  {
   "start": 36.08,
   "end": 39.14,
   "text": "לבין גנרל בשם ג'ורג' וושינגטון,"
  },
  {
   "start": 39.14,
   "end": 47.54,
   "text": "עם צבא קטן של אזרחים שרצו להפוך את ארצות הברית לדמוקרטיה ולארץ של"
  },
  {
   "start": 48.92,
   "end": 49.92,
   "text": "אמריקנית חדשה."
  },
  {
   "start": 52.3,
   "end": 52.84,
   "text": "והצבא,"
  },
  {
   "start": 53.48,
   "end": 55.48,
   "text": "הצבא האמריקני היה שבור,"
  },
  {
   "start": 57.86,
   "end": 59.78,
   "text": "היה כבר על סף ייאוש, הרבה ערקו."
  },
  {
   "start": 62.29,
   "end": 65.15,
   "text": "גנרל וושינגטון היה לפני כבר מפלה,"
  },
  {
   "start": 68.29,
   "end": 69.53,
   "text": "וכשכולם חנו שם,"
  },
  {
   "start": 72.74,
   "end": 76.84,
   "text": "גנרל וושינגטון ידע שמצבו בכי רע הוא התחיל להסתובב בין כולם."
  },
  {
   "start": 77.4,
   "end": 78.86,
   "text": "לעודד את כולם, להמריץ את כולם."
  },
  {
   "start": 82.28,
   "end": 83.36,
   "text": "דבר שהיה קשה מאוד."
  },
  {
   "start": 89.43,
   "end": 90.11,
   "text": "בין החיילים"
  },
  {
   "start": 91.01,
   "end": 91.63,
   "text": "היה יהודי אחד."
  },
  {
   "start": 94.15,
   "end": 94.73,
   "text": "אותו יהודי"
  },
  {
   "start": 96.59,
   "end": 97.55,
   "text": "היגר לארצות הברית,"
  },
  {
   "start": 98.05,
   "end": 102.39,
   "text": "אולי שם הוא יוכל למצוא מקום בלי להתקל בפריצים הפולנים."
  },
  {
   "start": 106.12,
   "end": 106.66,
   "text": "אותו לילה"
  },
  {
   "start": 107.52,
   "end": 108.46,
   "text": "היה ערב חנוכה,"
  },
  {
   "start": 109.88,
   "end": 111.44,
   "text": "והיהודי יוצא מהמתחתו חנוכיה."
  },
  {
   "start": 116.61,
   "end": 117.95,
   "text": "וכשמסביב הסכנה,"
  },
  {
   "start": 118.81,
   "end": 119.81,
   "text": "מסביב המלחמה,"
  },
  {
   "start": 124.14,
   "end": 126.0,
   "text": "הוא יצא לעצמו איזה איש של שקט,"
  },
  {
   "start": 127.68,
   "end": 133.46,
   "text": "הוציא חנוכיה והתכונן להדליק נר של חנוכה."
  },
  {
   "start": 134.76,
   "end": 140.98,
   "text": "מקץ שעה קלה בערה לה פתילה נפלאה"
  },
  {
   "start": 141.8,
   "end": 143.1,
   "text": "עם אור של חנוכה."
  },
  {
   "start": 143.96,
   "end": 146.48,
   "text": "כשהיהודי מביט, מביט בפתילה,"
  },
  {
   "start": 147.3,
   "end": 148.2,
   "text": "מביט באש,"
  },
  {
   "start": 148.88,
   "end": 151.92,
   "text": "וזיכרונות מציפים את מוחו."
  },
  {
   "start": 153.16,
   "end": 154.0,
   "text": "נזכר באבא,"
  },
  {
   "start": 154.58,
   "end": 165.08,
   "text": "אבא שבפולין היה מוכה על ידי הפריצים שכיסו אותו בכל מיני פרוות וביקשו שירקוד לפניהם."
  },
  {
   "start": 165.78,
   "end": 167.54,
   "text": "באבא שמביט במבט מושפל"
  },
  {
   "start": 169.18,
   "end": 170.3,
   "text": "בבן שלו שמביט"
  },
  {
   "start": 171.38,
   "end": 172.42,
   "text": "איך מתעלים באבא."
  },
  {
   "start": 176.24,
   "end": 176.86,
   "text": "ברור העולם,"
  },
  {
   "start": 177.5,
   "end": 183.52,
   "text": "ריבונו של עולם, עשיתי את כל הדרך כדי שאני לא אצטרך לרקוד עם פרווה של דוב,"
  },
  {
   "start": 184.46,
   "end": 186.12,
   "text": "והבן שלי יוכלע, יצטרך להביט בי"
  },
  {
   "start": 186.84,
   "end": 187.8,
   "text": "בצער כה עמוק,"
  },
  {
   "start": 188.3,
   "end": 189.92,
   "text": "כמו שקרה לי עם אבא שלי,"
  },
  {
   "start": 190.78,
   "end": 193.78,
   "text": "אני מבקש ממך, בוראי בונו של עולם, תעזור לי, בונו של עולם."
  },
  {
   "start": 194.8,
   "end": 197.04,
   "text": "אולי הצבא פה האמריקני,"
  },
  {
   "start": 197.96,
   "end": 200.34,
   "text": "אולי בוראי עולם יהיה זכות שינצח,"
  },
  {
   "start": 201.06,
   "end": 204.92,
   "text": "ולו בשביל לתת אולי ליהודים אפשרות לכמה שנים, אני לא יודע לכמה,"
  },
  {
   "start": 205.6,
   "end": 210.7,
   "text": "אבל לכמה זמן לפחות אולי יוכלו להיות פה במדינה הזאת בשקט,"
  },
  {
   "start": 211.78,
   "end": 213.3,
   "text": "בשקט קצת כמה שנים."
  },
  {
   "start": 214.22,
   "end": 216.04,
   "text": "בוראי עולם אולי תעזור לנו שננצח."
  },
  {
   "start": 216.62,
   "end": 220.76,
   "text": "ותוך כדי שהוא ככה נושא תפילה,"
  },
  {
   "start": 221.46,
   "end": 223.26,
   "text": "לשם יתברך מעמקי דה-ליבה,"
  },
  {
   "start": 223.98,
   "end": 225.28,
   "text": "מעמקי הלב שלו,"
  },
  {
   "start": 226.02,
   "end": 226.88,
   "text": "מרגיש איזו יד"
  },
  {
   "start": 228.0,
   "end": 229.02,
   "text": "אוחזת בכתפו."
  },
  {
   "start": 229.76,
   "end": 230.34,
   "text": "הוא הסתובב,"
  },
  {
   "start": 231.68,
   "end": 234.22,
   "text": "מולו עמד ג'ורג' וושינגטון,"
  },
  {
   "start": 235.28,
   "end": 235.94,
   "text": "הגנרל,"
  },
  {
   "start": 237.0,
   "end": 237.56,
   "text": "מביט בו"
  },
  {
   "start": 239.5,
   "end": 241.66,
   "text": "ושואל מה אתה עושה, החייל?"
  },
  {
   "start": 244.48,
   "end": 245.96,
   "text": "אמר לו החייל היהודי, תראה,"
  },
  {
   "start": 246.68,
   "end": 247.72,
   "text": "תראה גנרל וושינגטון,"
  },
  {
   "start": 248.46,
   "end": 251.68,
   "text": "כולם מיואשים, כולם חושבים שאתה הולך להפסיד,"
  },
  {
   "start": 252.28,
   "end": 254.5,
   "text": "כולם רוצים איך אולי לברוח מפה לערוק."
  },
  {
   "start": 255.38,
   "end": 256.66,
   "text": "אבל אני, אני יהודי."
  },
  {
   "start": 258.36,
   "end": 264.28,
   "text": "ואני מתפלל להשם יתברך, כי רק השם יתברך הוא מי שקובע בעולם שאתה תנצח, שאנחנו ננצח."
  },
  {
   "start": 265.26,
   "end": 266.1,
   "text": "כי אני לא רוצה,"
  },
  {
   "start": 267.26,
   "end": 269.88,
   "text": "כי אני לא רוצה עוד להסתובב בעולם לחפש לי מקום."
  },
  {
   "start": 270.42,
   "end": 272.44,
   "text": "אני מאמין אולי, אולי בורא עולם,"
  },
  {
   "start": 273.16,
   "end": 276.22,
   "text": "אולי בורא עולם בשביל האפשרות הזאת שיהיה כמה זמן"
  },
  {
   "start": 276.22,
   "end": 281.24,
   "text": "מדינה לכמה זמן מדינה שתיתן קצת מנוחה ליהודים."
  },
  {
   "start": 283.3,
   "end": 288.94,
   "text": "אולי בזכות זה העולם יעזור לנו לנצח את המלחמה."
  },
  {
   "start": 291.28,
   "end": 292.2,
   "text": "מה זה? מה הנר הזה?"
  },
  {
   "start": 292.8,
   "end": 294.06,
   "text": "שואל ג'ורג' וושינגטון."
  },
  {
   "start": 294.86,
   "end": 297.14,
   "text": "והיהודי הסביר לו, זה נר חנוכה,"
  },
  {
   "start": 297.84,
   "end": 300.02,
   "text": "בו נלחמו מעטים כנגד רבים,"
  },
  {
   "start": 300.7,
   "end": 302.88,
   "text": "וניצחו המעטים כנגד הרבים,"
  },
  {
   "start": 303.28,
   "end": 305.46,
   "text": "כי בורא העולם הוא זה שקובע את העניינים."
  },
  {
   "start": 305.94,
   "end": 306.74,
   "text": "וג'ורג' וושינגטון,"
  },
  {
   "start": 306.86,
   "end": 308.36,
   "text": "אני אומר לך עכשיו, אתה צריך להתחזק."
  },
  {
   "start": 309.24,
   "end": 311.34,
   "text": "אתה צריך לדעת שגם כשאנחנו מעטים,"
  },
  {
   "start": 311.68,
   "end": 315.22,
   "text": "גם כשקשה לנו, בורא עולם יכול לעזור לנו לנצח,"
  },
  {
   "start": 315.7,
   "end": 316.74,
   "text": "ואנחנו ננצח."
  },
  {
   "start": 317.08,
   "end": 320.44,
   "text": "אני מאמין באמונה שלמה, ואני מתפלל לאבא שבשמיים, בורא עולם."
  },
  {
   "start": 321.32,
   "end": 322.2,
   "text": "תן לנו לנצח."
  },
  {
   "start": 323.1,
   "end": 324.7,
   "text": "אני מתפלל לך, ג'ורג' וושינגטון,"
  },
  {
   "start": 325.8,
   "end": 326.74,
   "text": "וג'ורג' וושינגטון"
  },
  {
   "start": 328.78,
   "end": 329.42,
   "text": "התרגש,"
  },
  {
   "start": 330.26,
   "end": 330.82,
   "text": "הסתובב,"
  },
  {
   "start": 332.28,
   "end": 333.26,
   "text": "ולפני שחזר"
  },
  {
   "start": 333.92,
   "end": 335.72,
   "text": "לאוהל שלו, אמר תודה רבה."
  },
  {
   "start": 336.62,
   "end": 337.26,
   "text": "חיזקת אותי."
  },
  {
   "start": 338.2,
   "end": 339.3,
   "text": "תודה רבה לך, חייל."
  },
  {
   "start": 347.62,
   "end": 350.12,
   "text": "ג'ורג' וושינגטון והצבא שלו"
  },
  {
   "start": 350.7,
   "end": 353.44,
   "text": "נלחמו וגם ניצחו."
  },
  {
   "start": 357.11,
   "end": 358.55,
   "text": "האנגלים עזבו את ארצות הברית,"
  },
  {
   "start": 360.13,
   "end": 363.53,
   "text": "והאמריקנים הקימו שם את ארצות הברית שאנחנו מכירים אותה עד היום."
  },
  {
   "start": 366.01,
   "end": 371.11,
   "text": "וג'ורג' וושינגטון היה הנשיא הראשון של ארצות הברית של אמריקה."
  },
  {
   "start": 379.33,
   "end": 381.01,
   "text": "החייל היהודי כבר לא חייל אזרח,"
  },
  {
   "start": 381.75,
   "end": 383.65,
   "text": "יושב לו בניו יורק, בבית שלו."
  },
  {
   "start": 385.43,
   "end": 389.75,
   "text": "חג החנוכה הוא מדליק נר באותה חנוכייה שלו,"
  },
  {
   "start": 391.69,
   "end": 394.55,
   "text": "ולפתע נשמעות דפיקות בדלת."
  },
  {
   "start": 396.11,
   "end": 397.89,
   "text": "הוא ניגש ופותח את הדלת."
  },
  {
   "start": 399.15,
   "end": 403.43,
   "text": "בפתח הדלת עמד לו נשיא ארצות הברית ג'ורג' וושינגטון,"
  },
  {
   "start": 406.44,
   "end": 407.62,
   "text": "שעשה את כל הדרך"
  },
  {
   "start": 409.4,
   "end": 409.9,
   "text": "על מנת"
  },
  {
   "start": 410.88,
   "end": 418.86,
   "text": "לאתר ולמצוא את אותו חייל יהודי שריזק אותו כל כך עז בווליף רייג'"
  },
  {
   "start": 422.86,
   "end": 423.16,
   "text": "אז"
  },
  {
   "start": 424.64,
   "end": 428.2,
   "text": "בקרב הקשה והמר כשנראה לכאורה שאין סיכוי,"
  },
  {
   "start": 428.66,
   "end": 433.74,
   "text": "שהפיח בו תקווה ואמונה שעזרה לו כל כך לנצח."
  },
  {
   "start": 435.34,
   "end": 439.14,
   "text": "אז הוא אמר לו תדע לך עזרת לי מאוד באותם רגעים"
  },
  {
   "start": 439.14,
   "end": 443.68,
   "text": "ובאתי לתת לך מדליית הוקרה קטנה"
  },
  {
   "start": 444.6,
   "end": 446.0,
   "text": "והוא הוציא מדליית זהב"
  },
  {
   "start": 447.22,
   "end": 448.28,
   "text": "ושם על השולחן"
  },
  {
   "start": 449.88,
   "end": 451.24,
   "text": "ויצא כלעומת שבה."
  },
  {
   "start": 452.86,
   "end": 453.3,
   "text": "והיהודי"
  },
  {
   "start": 454.02,
   "end": 456.8,
   "text": "ניגש למדליית הזהב,"
  },
  {
   "start": 457.96,
   "end": 458.62,
   "text": "מרים אותה"
  },
  {
   "start": 459.66,
   "end": 461.98,
   "text": "ואז הוא רואה שבמדליית הזהב"
  },
  {
   "start": 462.5,
   "end": 464.44,
   "text": "הייתה חרוטה לחנוכיה,"
  },
  {
   "start": 465.62,
   "end": 468.1,
   "text": "חנוכיה יהודית,"
  },
  {
   "start": 470.14,
   "end": 471.44,
   "text": "סמל האור,"
  },
  {
   "start": 472.1,
   "end": 473.22,
   "text": "סמל האמונה,"
  },
  {
   "start": 474.18,
   "end": 475.04,
   "text": "סמל הנצח,"
  },
  {
   "start": 475.82,
   "end": 482.86,
   "text": "סמל הניצחון, מעטים כנגד רבים גם בשדה המלחמה וגם בתוכנו."
  },
  {
   "start": 483.58,
   "end": 488.92,
   "text": "בתוכנו המעשים הטובים, הנקודות הטובות ואפילו הן מעטות יניסו,"
  },
  {
   "start": 489.22,
   "end": 491.36,
   "text": "יסלקו את כל הרע,"
  },
  {
   "start": 491.82,
   "end": 492.68,
   "text": "את כל הלא טוב,"
  },
  {
   "start": 493.32,
   "end": 494.7,
   "text": "ואנחנו המנצחים."
  },
  {
   "start": 518.93,
   "end": 519.73,
   "text": "כי צריך לדעת"
  },
  {
   "start": 520.33,
   "end": 521.47,
   "text": "שמים רבים"
  },
  {
   "start": 523.25,
   "end": 526.97,
   "text": "לא יכסו את ים האהבה של השם יתברך."
  },
  {
   "start": 529.01,
   "end": 532.87,
   "text": "שום עבר שבעולם, שום דבר שבעולם לא ישטוף"
  },
  {
   "start": 533.91,
   "end": 537.73,
   "text": "ולא יכסה את ים האהבה של הקדוש ברוך הוא אל בניו ובנותיו."
  },
  {
   "start": 539.31,
   "end": 544.81,
   "text": "פה העולם כל כך אוהב אותנו, עד בכך שאומר כל מעשה קטן שלכם יקר בעיניי."
  },
  {
   "start": 548.58,
   "end": 549.88,
   "text": "אז בואו בעזרת השם,"
  },
  {
   "start": 550.82,
   "end": 554.88,
   "text": "בואו בעזרת השם, ניתן לנשמה שלנו להתנגן,"
  },
  {
   "start": 554.88,
   "end": 556.86,
   "text": "להתנגן בניגון האמונה."
  }
 ]
}