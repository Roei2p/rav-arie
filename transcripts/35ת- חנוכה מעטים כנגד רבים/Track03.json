{
 "disc": "35ת- חנוכה מעטים כנגד רבים",
 "track": "Track03",
 "duration": 595.152,
 "segments": [
  {
   "start": 0.65,
   "end": 1.13,
   "text": "בכל דור"
  },
  {
   "start": 2.35,
   "end": 3.27,
   "text": "יש מלחמת"
  },
  {
   "start": 3.95,
   "end": 5.07,
   "text": "בני אור בבני חושך."
  },
  {
   "start": 6.99,
   "end": 7.51,
   "text": "בכל דור"
  },
  {
   "start": 8.83,
   "end": 12.19,
   "text": "יש למעשה מלחמה סמויה אולי לפעמים,"
  },
  {
   "start": 12.77,
   "end": 13.81,
   "text": "מתחת לפני השטח,"
  },
  {
   "start": 15.73,
   "end": 16.79,
   "text": "בין אנשי הנשמה"
  },
  {
   "start": 18.67,
   "end": 19.53,
   "text": "לאנשי הגוף."
  },
  {
   "start": 21.87,
   "end": 25.91,
   "text": "בכל דור יש מלחמה בין הנצח לבין הזמני לבין החולף."
  },
  {
   "start": 27.09,
   "end": 29.95,
   "text": "כך זה היה אפילו בתקופת השואה."
  },
  {
   "start": 31.09,
   "end": 34.13,
   "text": "מלחמת העולם השנייה, כל העולם נלחם,"
  },
  {
   "start": 34.73,
   "end": 36.49,
   "text": "אבל מבעד לפגזים,"
  },
  {
   "start": 37.13,
   "end": 38.13,
   "text": "מבעד ליריות,"
  },
  {
   "start": 38.73,
   "end": 39.87,
   "text": "מבעד להריסות,"
  },
  {
   "start": 40.43,
   "end": 42.21,
   "text": "מבעד למוות המשתולל,"
  },
  {
   "start": 42.83,
   "end": 44.43,
   "text": "התנהלה לה המערכה העיקרית,"
  },
  {
   "start": 49.63,
   "end": 50.91,
   "text": "המערכה על הרוחניות,"
  },
  {
   "start": 51.69,
   "end": 52.53,
   "text": "על הנפש,"
  },
  {
   "start": 53.03,
   "end": 53.57,
   "text": "על הנצח."
  },
  {
   "start": 54.47,
   "end": 58.21,
   "text": "מצד אחד נציג הגוף, היצרים והחושך, הגרמנים,"
  },
  {
   "start": 59.29,
   "end": 60.61,
   "text": "הנאצים ימח שמם,"
  },
  {
   "start": 61.33,
   "end": 61.75,
   "text": "עמלק,"
  },
  {
   "start": 62.73,
   "end": 70.62,
   "text": "ומצד שני נציגי הנצח, המצפון והאור היהודים אושוויץ."
  },
  {
   "start": 72.04,
   "end": 78.56,
   "text": "1942. כל משלוח"
  },
  {
   "start": 79.7,
   "end": 83.12,
   "text": "שהיה מגיע לאושוויץ היה מוצא את עצמו במאבק אכזרי על הסיכוי"
  },
  {
   "start": 84.0,
   "end": 84.7,
   "text": "בכלל לשרוד,"
  },
  {
   "start": 85.72,
   "end": 86.66,
   "text": "להחזיק מעמד"
  },
  {
   "start": 87.46,
   "end": 88.02,
   "text": "במוות הזה."
  },
  {
   "start": 90.55,
   "end": 95.27,
   "text": "אותו לילה שהגיע המשלוח היה חנוכה."
  },
  {
   "start": 98.21,
   "end": 99.09,
   "text": "ובחנוכה,"
  },
  {
   "start": 99.89,
   "end": 102.21,
   "text": "כשהגרמנים הבינו שזה חג של יהודים,"
  },
  {
   "start": 105.43,
   "end": 107.89,
   "text": "וכשהם הבינו את המשמעות של החג הזה,"
  },
  {
   "start": 109.91,
   "end": 111.85,
   "text": "הם החליטו לארגן משחק,"
  },
  {
   "start": 113.23,
   "end": 113.59,
   "text": "משחק אכזרי."
  },
  {
   "start": 115.99,
   "end": 118.59,
   "text": "הם החליטו שבחג החנוכה הם ישחקו ביהודים."
  },
  {
   "start": 119.45,
   "end": 120.25,
   "text": "מה הם החליטו לעשות?"
  },
  {
   "start": 121.29,
   "end": 123.71,
   "text": "הרי כולם היו שם רעבים, רעבים ללחם."
  },
  {
   "start": 125.65,
   "end": 128.97,
   "text": "הם החליטו, הם יספקו אוכל דווקא לחלשים."
  },
  {
   "start": 131.03,
   "end": 134.69,
   "text": "ואז למעשה כל החזקים, עכשיו זה מלחמת הישרדות,"
  },
  {
   "start": 135.55,
   "end": 136.83,
   "text": "זה יהיה תמריץ לחזקים"
  },
  {
   "start": 138.31,
   "end": 139.47,
   "text": "לנסות לקחת את האוכל."
  },
  {
   "start": 141.11,
   "end": 143.51,
   "text": "והם יעזבו את השטח הגרמני, אם לא יהיו פתאום שומרים,"
  },
  {
   "start": 144.41,
   "end": 148.79,
   "text": "אז ודאי שהמחורים החזקים יתנפלו על החלשים ויקחו מהם הכל."
  },
  {
   "start": 149.61,
   "end": 151.49,
   "text": "וככה עד מהרה יפרוץ קרב אכזרי,"
  },
  {
   "start": 152.95,
   "end": 158.19,
   "text": "ואז הם ייכנסו באמצע ויוכלו לראות, לחזור ככה משחק דמים בשידור חי,"
  },
  {
   "start": 164.38,
   "end": 165.1,
   "text": "והם העמידו את"
  },
  {
   "start": 165.72,
   "end": 167.78,
   "text": "את היהודים מהמשלוח האחרון,"
  },
  {
   "start": 168.74,
   "end": 171.5,
   "text": "והחלו לעבור בין הקהל היהודי המורעב."
  },
  {
   "start": 175.98,
   "end": 177.1,
   "text": "אתם יודעים מה הם תכוננו לחלק?"
  },
  {
   "start": 178.32,
   "end": 178.76,
   "text": "על מה מדובר?"
  },
  {
   "start": 179.22,
   "end": 181.36,
   "text": "על שני גרם מרגרינה לכל אחד."
  },
  {
   "start": 182.34,
   "end": 184.98,
   "text": "שני גרם מרגרינה 700 קלוריות."
  },
  {
   "start": 186.14,
   "end": 188.98,
   "text": "שני גרם מרגרינה זה חיות למספר ימים."
  },
  {
   "start": 190.3,
   "end": 190.62,
   "text": "ואז,"
  },
  {
   "start": 191.48,
   "end": 195.94,
   "text": "מי שיקבל מרגרינה זוכה בחיים קרה הגרמני."
  },
  {
   "start": 196.76,
   "end": 198.98,
   "text": "מי שיקבל מרגרינה הוא זה שיחיה,"
  },
  {
   "start": 198.98,
   "end": 199.7,
   "text": "והוא זה שישרוד."
  },
  {
   "start": 201.5,
   "end": 201.9,
   "text": "אתה, אתה,"
  },
  {
   "start": 202.98,
   "end": 204.0,
   "text": "אתה שם, זקן,"
  },
  {
   "start": 204.94,
   "end": 206.2,
   "text": "תקבל מנה כפולה,"
  },
  {
   "start": 206.84,
   "end": 207.62,
   "text": "צחק הקאפו."
  },
  {
   "start": 210.22,
   "end": 211.0,
   "text": "הוא פנה אל הרב"
  },
  {
   "start": 212.44,
   "end": 213.0,
   "text": "כשהוא אמר,"
  },
  {
   "start": 214.08,
   "end": 215.52,
   "text": "אתה, זקן, תקבל מנה כפולה."
  },
  {
   "start": 216.54,
   "end": 218.82,
   "text": "וכולם נעמדים, כל היהודים, מביטים אל הרב,"
  },
  {
   "start": 219.84,
   "end": 222.12,
   "text": "הרב שתמיד היה לגביהם מקור של חיזוק,"
  },
  {
   "start": 222.94,
   "end": 225.0,
   "text": "והם שומעים את הרב ממלמל, נס מן השמיים."
  },
  {
   "start": 226.86,
   "end": 229.48,
   "text": "נס מן השמיים, וכולו אחוז התלהבות,"
  },
  {
   "start": 230.36,
   "end": 233.48,
   "text": "ומאות עיניים מורעבות ננעצו בו."
  },
  {
   "start": 234.8,
   "end": 238.6,
   "text": "הגרמני זרק את פירוי המרגרינה לרצפה,"
  },
  {
   "start": 240.16,
   "end": 241.6,
   "text": "וכל כך נהנה לראות את הרב"
  },
  {
   "start": 242.16,
   "end": 244.22,
   "text": "משתטח בלוא קומתו ואוסף"
  },
  {
   "start": 245.2,
   "end": 246.88,
   "text": "כל פירור של מרגרינה,"
  },
  {
   "start": 247.92,
   "end": 249.3,
   "text": "כל פירור של חיות."
  },
  {
   "start": 258.82,
   "end": 259.88,
   "text": "אווירת המשבר,"
  },
  {
   "start": 260.54,
   "end": 261.6,
   "text": "אווירת הלחץ,"
  },
  {
   "start": 262.1,
   "end": 263.5,
   "text": "הייתה תלויה בחלל האוויר."
  },
  {
   "start": 264.94,
   "end": 267.58,
   "text": "לגרמנים לא נותר רק מה לצאת למספר דקות,"
  },
  {
   "start": 267.66,
   "end": 270.36,
   "text": "לתת זמן ליהודים ככה להתבשל בתוך עצמם ו..."
  },
  {
   "start": 271.68,
   "end": 273.18,
   "text": "והחגיגה תתחיל."
  },
  {
   "start": 275.25,
   "end": 281.51,
   "text": "ובאמת הם סימנו אחד לשני ויצאו מהאולם הגדול בו היו מרוכזים היהודים."
  },
  {
   "start": 285.66,
   "end": 289.8,
   "text": "מצפים לחזור בעוד כמה דקות לראות איך היהודים מתנפלים על הרעב שלהם,"
  },
  {
   "start": 290.2,
   "end": 295.14,
   "text": "מתנפלים על כל האנשים המבוגרים ותולשים מהם את האוכל."
  },
  {
   "start": 299.76,
   "end": 301.28,
   "text": "זה מה שהם ציפו, בגלל זה הם יצאו."
  },
  {
   "start": 302.08,
   "end": 302.64,
   "text": "יצאו,"
  },
  {
   "start": 303.56,
   "end": 307.38,
   "text": "משאירים את היהודים להתמודד עם הגורל,"
  },
  {
   "start": 308.14,
   "end": 309.64,
   "text": "הגורל האכזר שהם העידו להם."
  },
  {
   "start": 320.92,
   "end": 321.7,
   "text": "היהודים בתוכם,"
  },
  {
   "start": 322.28,
   "end": 323.06,
   "text": "אף אחד לא הבין."
  },
  {
   "start": 324.34,
   "end": 324.56,
   "text": "הרב,"
  },
  {
   "start": 325.38,
   "end": 326.8,
   "text": "אתה זה שהיית מקור חיזוק,"
  },
  {
   "start": 327.3,
   "end": 328.92,
   "text": "לפני כולנו פתאום אתה נשבר,"
  },
  {
   "start": 329.94,
   "end": 332.4,
   "text": "משפיל את עצמך בשביל כמה פירורי מרגרינה,"
  },
  {
   "start": 332.84,
   "end": 334.22,
   "text": "מתנפל כאילו לא ראית?"
  },
  {
   "start": 334.9,
   "end": 335.44,
   "text": "מה זה?"
  },
  {
   "start": 336.4,
   "end": 336.98,
   "text": "הרב, אתה,"
  },
  {
   "start": 337.54,
   "end": 340.58,
   "text": "אתה זה שאמרת לנו לשמור על דרך ארץ,"
  },
  {
   "start": 341.12,
   "end": 343.42,
   "text": "על היהדות שלנו גם בתוך המוות הזה?"
  },
  {
   "start": 344.7,
   "end": 345.3,
   "text": "גם אתה?"
  },
  {
   "start": 349.2,
   "end": 352.9,
   "text": "לפתע נשמע קולו של הרב, נשמות טובות, נס!"
  },
  {
   "start": 353.62,
   "end": 354.78,
   "text": "נס חנוכה!"
  },
  {
   "start": 355.48,
   "end": 359.2,
   "text": "על ידי המרגרינה אפשר להדליק נרות חנוכה, חנוכה היום!"
  },
  {
   "start": 359.66,
   "end": 361.92,
   "text": "אפשר להדליק נרות חנוכה, קרא הרב!"
  },
  {
   "start": 363.62,
   "end": 364.28,
   "text": "ושקט,"
  },
  {
   "start": 365.3,
   "end": 366.7,
   "text": "ושקט השתרר לו באולם."
  },
  {
   "start": 369.46,
   "end": 371.82,
   "text": "לפתע הכל היה מובן,"
  },
  {
   "start": 372.36,
   "end": 374.04,
   "text": "לפתע הכל היה ברור."
  },
  {
   "start": 375.78,
   "end": 378.88,
   "text": "הרב לא קרע ברך עבור אוכל,"
  },
  {
   "start": 380.02,
   "end": 382.48,
   "text": "הרב קרע ברך עבור"
  },
  {
   "start": 384.12,
   "end": 385.22,
   "text": "נרות חנוכה."
  },
  {
   "start": 387.24,
   "end": 389.66,
   "text": "על מנת להאיר לכולם את הנשמה,"
  },
  {
   "start": 391.89,
   "end": 393.61,
   "text": "ועתה הכל היה נראה אחרת."
  },
  {
   "start": 396.33,
   "end": 400.85,
   "text": "עתה כולם הבינו, הגרמני הגס, שבע מגושם, זרק אוכל לגוף,"
  },
  {
   "start": 404.61,
   "end": 405.69,
   "text": "והרבי אסף"
  },
  {
   "start": 406.51,
   "end": 407.73,
   "text": "מזון לנשמה."
  },
  {
   "start": 411.18,
   "end": 412.12,
   "text": "לפתע הכל השתנה."
  },
  {
   "start": 412.84,
   "end": 415.56,
   "text": "לפתע כל האווירה באחת התחלפה לה."
  },
  {
   "start": 416.1,
   "end": 416.76,
   "text": "נר של חנוכה."
  },
  {
   "start": 417.46,
   "end": 420.44,
   "text": "נר של חנוכה! פשטה הקריאה בכל המחנה."
  },
  {
   "start": 420.76,
   "end": 421.58,
   "text": "נר של חנוכה!"
  },
  {
   "start": 426.08,
   "end": 428.28,
   "text": "והפנים המעונות זרחו להם,"
  },
  {
   "start": 428.82,
   "end": 431.3,
   "text": "והעיניים של כולם זרו באור מיוחד,"
  },
  {
   "start": 431.84,
   "end": 433.52,
   "text": "אור של חנוכה,"
  },
  {
   "start": 435.56,
   "end": 436.8,
   "text": "אור של אמונה."
  },
  {
   "start": 440.94,
   "end": 443.68,
   "text": "והרב פרם את הבגדים שלו העליונים,"
  },
  {
   "start": 444.2,
   "end": 445.72,
   "text": "ועשה מהם פתילות."
  },
  {
   "start": 447.88,
   "end": 452.6,
   "text": "לא היה אכפת לו שאולי מאבד את המעיל שהגן עליו מהקור הגרמני,"
  },
  {
   "start": 455.67,
   "end": 456.53,
   "text": "שהוא מסכן את"
  },
  {
   "start": 457.27,
   "end": 458.83,
   "text": "הבריאות שלו, לא היה אכפת לו."
  },
  {
   "start": 460.19,
   "end": 460.47,
   "text": "אישה"
  },
  {
   "start": 461.11,
   "end": 463.15,
   "text": "הלכה ונתנה את כפתורי הכסף שהיו לה,"
  },
  {
   "start": 464.49,
   "end": 469.15,
   "text": "ועד מהרה עמדה חנוכיה מאולתרת עם כפתורי כסף,"
  },
  {
   "start": 469.81,
   "end": 470.57,
   "text": "עם פתילות"
  },
  {
   "start": 471.37,
   "end": 473.09,
   "text": "ועם מרגרינה להדלקה,"
  },
  {
   "start": 475.31,
   "end": 478.33,
   "text": "והרב ברך והדליק"
  },
  {
   "start": 479.13,
   "end": 480.61,
   "text": "נרות של חנוכה."
  },
  {
   "start": 482.67,
   "end": 483.49,
   "text": "בלב התופת,"
  },
  {
   "start": 484.13,
   "end": 485.31,
   "text": "בלב אושוויץ,"
  },
  {
   "start": 486.05,
   "end": 489.41,
   "text": "שלהבת קודש בערה לה בלבבות"
  },
  {
   "start": 490.37,
   "end": 491.53,
   "text": "של כל היהודים."
  },
  {
   "start": 496.23,
   "end": 497.13,
   "text": "משב רוח מקפיא"
  },
  {
   "start": 498.31,
   "end": 501.13,
   "text": "חדר אל האולם כשהגרמנים חזרו פנימה."
  },
  {
   "start": 502.63,
   "end": 503.61,
   "text": "במקום קרב,"
  },
  {
   "start": 504.39,
   "end": 504.93,
   "text": "דמים,"
  },
  {
   "start": 505.85,
   "end": 507.33,
   "text": "הם ראו אור בעיניים,"
  },
  {
   "start": 507.95,
   "end": 509.55,
   "text": "הם ראו אחדות בלב!"
  },
  {
   "start": 511.27,
   "end": 523.89,
   "text": "המפקד הגרמני לא הבין, הזעם חנק את גרונו! הוא לא הבין איך אפשר לעשות דבר כזה! איך אפשר שהעם היהודי יתעלה מעליהם עם כל מה שהשפילו?"
  },
  {
   "start": 524.59,
   "end": 527.37,
   "text": "אני אראה לכם, הוא זעק, אתם תשלמו ביוקר!"
  },
  {
   "start": 529.27,
   "end": 530.29,
   "text": "ולפתע הוא יצא,"
  },
  {
   "start": 530.99,
   "end": 532.03,
   "text": "יצא וברח משם,"
  },
  {
   "start": 532.91,
   "end": 534.37,
   "text": "כדי שלא יראו אותו נשבר,"
  },
  {
   "start": 534.99,
   "end": 536.61,
   "text": "כי בתוך תוכו הוא ידע את האמת,"
  },
  {
   "start": 537.11,
   "end": 542.99,
   "text": "הוא יטט את הגדלות של עם הנצח שמוותר על האוכל,"
  },
  {
   "start": 543.63,
   "end": 546.71,
   "text": "מוותר על הגוף שלו למען הנשמה שלו."
  },
  {
   "start": 548.41,
   "end": 552.37,
   "text": "ניצחון של הנשמה היה כניצחון של הנצח."
  },
  {
   "start": 555.58,
   "end": 558.52,
   "text": "הם פגעו בגוף אבל בנשמה, את הנשמה אי אפשר לכבות."
  },
  {
   "start": 562.53,
   "end": 566.85,
   "text": "האור הזה דלק אז ודולק עד היום."
  },
  {
   "start": 568.37,
   "end": 569.03,
   "text": "כך זה היה,"
  },
  {
   "start": 569.99,
   "end": 570.73,
   "text": "כך זה הווה,"
  },
  {
   "start": 570.73,
   "end": 578.84,
   "text": "וכך זה יהיה מעטים כנגד רבינו מעטים כנגד רבינו."
  }
 ]
}