{
 "disc": "35ת- חנוכה מעטים כנגד רבים",
 "track": "Track01",
 "duration": 1876.176,
 "segments": [
  {
   "start": 25.65,
   "end": 26.51,
   "text": "ז'יטומיר."
  },
  {
   "start": 28.05,
   "end": 30.05,
   "text": "ז'יטומיר הייתה עיירת יהודית טיפוסית."
  },
  {
   "start": 31.69,
   "end": 32.95,
   "text": "לפני כמאתיים שנה,"
  },
  {
   "start": 33.91,
   "end": 36.55,
   "text": "ולב העיירה היה בית מדרש, שם ישבו,"
  },
  {
   "start": 37.37,
   "end": 38.57,
   "text": "הצטופפו להם עשרות בחורים,"
  },
  {
   "start": 39.17,
   "end": 40.11,
   "text": "עשרות יהודים,"
  },
  {
   "start": 40.67,
   "end": 42.49,
   "text": "בחברות ולמדו את התורה הקדושה."
  },
  {
   "start": 44.41,
   "end": 49.27,
   "text": "מדי זמן נשלף אחד מהבחורים היוצא לשידוך"
  },
  {
   "start": 52.22,
   "end": 54.56,
   "text": "והיה חוזר עם בשורת נישואים ועם עתיד חדש."
  },
  {
   "start": 55.94,
   "end": 57.38,
   "text": "כך גם קרה למנחם,"
  },
  {
   "start": 57.98,
   "end": 58.68,
   "text": "מנחם פרנק."
  },
  {
   "start": 60.46,
   "end": 63.72,
   "text": "מנחם פרנק זכה להשתדך עם בת, בת של סוחר,"
  },
  {
   "start": 64.92,
   "end": 66.56,
   "text": "סוחר עשיר מהעיר, מעיירה ברוד."
  },
  {
   "start": 73.55,
   "end": 77.97,
   "text": "הוא נפרד, עזב את הבית מדרש ועקר לעיירה ברוד בעקבות אשתו."
  },
  {
   "start": 80.15,
   "end": 82.17,
   "text": "שם הוא היה סמוך על שולחן החותן שלו."
  },
  {
   "start": 84.52,
   "end": 85.12,
   "text": "כך הוא ישב"
  },
  {
   "start": 87.04,
   "end": 87.74,
   "text": "זמן מה,"
  },
  {
   "start": 88.58,
   "end": 90.56,
   "text": "אבל לאט לאט, בהתחלה הוא שם לב לזה קצת,"
  },
  {
   "start": 91.28,
   "end": 94.58,
   "text": "אבל עד זה הלך והתגבר הרמיזות, השתיקה הרועמת."
  },
  {
   "start": 97.42,
   "end": 103.8,
   "text": "משפחת אשתו לא היו כל כך מרוצים מכך שהחתן החדש שלהם יושב כל היום ולומד."
  },
  {
   "start": 104.26,
   "end": 106.68,
   "text": "הם היו מעדיפים קצת שהוא יעבוד, קצת יעזור להם בעסקים."
  },
  {
   "start": 108.32,
   "end": 108.62,
   "text": "אבל הוא,"
  },
  {
   "start": 109.92,
   "end": 110.76,
   "text": "הוא עמד על שלו,"
  },
  {
   "start": 116.16,
   "end": 116.86,
   "text": "עד לאותו לילה."
  },
  {
   "start": 118.0,
   "end": 119.28,
   "text": "באותו לילה אשתו"
  },
  {
   "start": 120.7,
   "end": 121.1,
   "text": "נכנסה"
  },
  {
   "start": 122.24,
   "end": 124.62,
   "text": "באמצע אלימות ואומרת לו, מנחם, אבא שלח אותי, תראה."
  },
  {
   "start": 125.2,
   "end": 127.26,
   "text": "מנחם, תמיד אנחנו אומרים לאבא ואימא לא."
  },
  {
   "start": 127.9,
   "end": 130.18,
   "text": "אבל תראה, עכשיו בסך הכול יש איזו חבורה שמה,"
  },
  {
   "start": 130.7,
   "end": 134.84,
   "text": "קבוצה של גויים שזקוקים להנהלת חשבונות,"
  },
  {
   "start": 135.58,
   "end": 137.18,
   "text": "לחלק קצת הרווחים שהם הרוויחו."
  },
  {
   "start": 139.16,
   "end": 139.76,
   "text": "אז בוא, בוא,"
  },
  {
   "start": 140.3,
   "end": 143.98,
   "text": "בוא תעזור להם, והם מוכנים לשלם על זה דמי תיווך."
  },
  {
   "start": 144.66,
   "end": 147.8,
   "text": "מה אכפת לך? כמה אנחנו צריכים לבקש מאבא שלי טובות?"
  },
  {
   "start": 153.24,
   "end": 154.4,
   "text": "מנחם עשה חשבון קצר,"
  },
  {
   "start": 155.7,
   "end": 156.88,
   "text": "אמרת לו אולי יהיה לי קצת שקט."
  },
  {
   "start": 158.24,
   "end": 158.8,
   "text": "והוא הסכים."
  },
  {
   "start": 162.11,
   "end": 165.83,
   "text": "קבוצת הגויים לא הייתה קבוצה של סוחרים צדיקים ותמימים,"
  },
  {
   "start": 166.61,
   "end": 167.53,
   "text": "בלשון עדינה."
  },
  {
   "start": 168.55,
   "end": 171.19,
   "text": "מה אכפת לך? הם גויים, מנחם. הם גויים, מה אכפת לך?"
  },
  {
   "start": 171.65,
   "end": 172.59,
   "text": "מה הזניין שלנו?"
  },
  {
   "start": 173.71,
   "end": 174.95,
   "text": "טוב, פעם אחת וזהו."
  },
  {
   "start": 178.36,
   "end": 180.88,
   "text": "תוך מחצית השעה נגמר הכל, נסגר הכל."
  },
  {
   "start": 184.64,
   "end": 185.2,
   "text": "הם היו מרוצים,"
  },
  {
   "start": 186.42,
   "end": 188.64,
   "text": "והם שילמו סכום יפה לכל הדירות."
  },
  {
   "start": 197.43,
   "end": 198.15,
   "text": "חודש אחר כך,"
  },
  {
   "start": 199.57,
   "end": 199.99,
   "text": "מנחם."
  },
  {
   "start": 200.69,
   "end": 201.25,
   "text": "מנחם."
  },
  {
   "start": 202.21,
   "end": 202.69,
   "text": "בכתה."
  },
  {
   "start": 203.41,
   "end": 204.67,
   "text": "בכתה אשתו עוד פעם אחת."
  },
  {
   "start": 205.37,
   "end": 206.67,
   "text": "עוד פעם אחת, מה יקרה?"
  },
  {
   "start": 207.71,
   "end": 208.31,
   "text": "מה יקרה?"
  },
  {
   "start": 211.21,
   "end": 214.45,
   "text": "אז עוד פעם אחת תתווך שם ותדמה, מה בסך הכל אתה עושה?"
  },
  {
   "start": 215.07,
   "end": 216.37,
   "text": "מחלק ביניהם את הכסף"
  },
  {
   "start": 217.63,
   "end": 220.09,
   "text": "ומקבל על זה סכום בכלל לא רע."
  },
  {
   "start": 228.35,
   "end": 230.37,
   "text": "טוב, זו הפעם האחרונה, אמר מנחם."
  },
  {
   "start": 232.47,
   "end": 235.11,
   "text": "אבל זו לא הייתה הפעם האחרונה, עוד לחץ ועוד לחץ."
  },
  {
   "start": 236.53,
   "end": 237.19,
   "text": "ולאט לאט"
  },
  {
   "start": 238.83,
   "end": 239.87,
   "text": "כבר לא היה צריך ללחוץ."
  },
  {
   "start": 240.79,
   "end": 241.87,
   "text": "זה נהפך להרגל,"
  },
  {
   "start": 242.39,
   "end": 243.85,
   "text": "להיות המנהל החשבונות"
  },
  {
   "start": 244.49,
   "end": 245.27,
   "text": "של אותה חבורה,"
  },
  {
   "start": 246.27,
   "end": 247.15,
   "text": "חבורת שודדים."
  },
  {
   "start": 248.53,
   "end": 251.23,
   "text": "ולאט לאט מנחם נהפך למנהל החלוקה"
  },
  {
   "start": 252.23,
   "end": 252.99,
   "text": "של אותה חבורה."
  },
  {
   "start": 257.81,
   "end": 261.45,
   "text": "אדם עושה עבירה קלה, נראה לו כבסדר, לא נורא."
  },
  {
   "start": 262.31,
   "end": 266.87,
   "text": "בהתחלה זה חמור, לאט לאט זה יורד ההשפעה, לאחרי זה נהפך לו כהרגל ובכלל כהיתר."
  },
  {
   "start": 267.51,
   "end": 270.83,
   "text": "ומנחם התחיל להרגיש שבעצם יש לו פרנסה לא רעה, קצת מהצד."
  },
  {
   "start": 292.26,
   "end": 293.96,
   "text": "הדפיקות ההיסטריות בדלת העירו אותם."
  },
  {
   "start": 295.06,
   "end": 296.94,
   "text": "מי באמצע הלילה דופק ככה?"
  },
  {
   "start": 297.64,
   "end": 298.68,
   "text": "מנחם פתח את הדלת."
  },
  {
   "start": 307.04,
   "end": 307.5,
   "text": "בפתח"
  },
  {
   "start": 308.42,
   "end": 309.26,
   "text": "עמד לו איוון."
  },
  {
   "start": 309.46,
   "end": 311.8,
   "text": "מראשי חבורת השודדים,"
  },
  {
   "start": 313.12,
   "end": 314.58,
   "text": "הבגדים שלו היו ספוגים מדם."
  },
  {
   "start": 315.46,
   "end": 315.92,
   "text": "מנחם,"
  },
  {
   "start": 316.58,
   "end": 317.68,
   "text": "אנחנו עשינו פעולה הלילה."
  },
  {
   "start": 318.54,
   "end": 321.56,
   "text": "אנחנו תקפנו רוזן מקומי והתברר,"
  },
  {
   "start": 322.36,
   "end": 327.28,
   "text": "התברר לנו שיש לו שומרים שנמצאים איתו במרכבה."
  },
  {
   "start": 332.86,
   "end": 336.4,
   "text": "מנחם, אנחנו נמצאים בעיצומו של קרב לא רחוק מכאן."
  },
  {
   "start": 337.16,
   "end": 338.02,
   "text": "אנחנו חייבים עזרה."
  },
  {
   "start": 339.82,
   "end": 342.94,
   "text": "מנחם נרתע כאילו הוא נכווה, מה קשור? אני לא קשור לזה."
  },
  {
   "start": 343.28,
   "end": 344.18,
   "text": "מה אתם רוצים ממני?"
  },
  {
   "start": 344.96,
   "end": 345.96,
   "text": "מה הקשר שלי לזה?"
  },
  {
   "start": 346.78,
   "end": 348.48,
   "text": "אני בסך הכל הייתי מנהל חלוקה שלכם."
  },
  {
   "start": 349.22,
   "end": 353.08,
   "text": "אתה טועם, מנחם, אם אנחנו נפסיד, אם אנחנו ניפול,"
  },
  {
   "start": 353.72,
   "end": 356.84,
   "text": "השם שלך יימסר גם מול המשטרה."
  },
  {
   "start": 357.58,
   "end": 359.94,
   "text": "תבין, מנחם, אנחנו חייבים כל, כל כוח,"
  },
  {
   "start": 360.48,
   "end": 362.16,
   "text": "כל יד, אתה חייב לבוא ולעזור,"
  },
  {
   "start": 363.02,
   "end": 363.84,
   "text": "ולו רק לפעם אחת."
  },
  {
   "start": 369.14,
   "end": 370.68,
   "text": "מנחם, אתה חייב ללכת איתם."
  },
  {
   "start": 372.22,
   "end": 373.52,
   "text": "אתה חייב ללכת איתם, מנחם."
  },
  {
   "start": 375.06,
   "end": 375.82,
   "text": "איזו בושה."
  },
  {
   "start": 380.36,
   "end": 380.9,
   "text": "אין ברירה."
  },
  {
   "start": 381.96,
   "end": 382.66,
   "text": "חייבים ללכת."
  },
  {
   "start": 385.52,
   "end": 386.06,
   "text": "והמילים"
  },
  {
   "start": 387.66,
   "end": 389.3,
   "text": "עוד התדהדו בראשו כשהוא יצא."
  },
  {
   "start": 390.1,
   "end": 391.2,
   "text": "יצא בעקבות איוון."
  },
  {
   "start": 393.26,
   "end": 395.18,
   "text": "מובל לידי כוח שטני שהשתלט עליו."
  },
  {
   "start": 404.93,
   "end": 405.93,
   "text": "מנחם חזר הביתה."
  },
  {
   "start": 407.51,
   "end": 408.53,
   "text": "מיקץ מספר שעות."
  },
  {
   "start": 409.41,
   "end": 412.23,
   "text": "הוא הלך, התקלח במשך שעות,"
  },
  {
   "start": 414.72,
   "end": 415.82,
   "text": "ונכנס למיטה שותק."
  },
  {
   "start": 417.52,
   "end": 420.74,
   "text": "למחרת הוא התעורר ויצא מהבית שלו."
  },
  {
   "start": 422.3,
   "end": 422.84,
   "text": "מנחם"
  },
  {
   "start": 423.48,
   "end": 424.88,
   "text": "כבר לא היה אותו אדם."
  },
  {
   "start": 428.01,
   "end": 429.89,
   "text": "מה קורה איתך בלילות, מנחם?"
  },
  {
   "start": 430.39,
   "end": 432.01,
   "text": "שאלה מינה אשתו בדאגה,"
  },
  {
   "start": 432.63,
   "end": 433.55,
   "text": "אבל הוא כבר לא ענה."
  },
  {
   "start": 434.39,
   "end": 435.99,
   "text": "בזמן האחרון הוא מרבה בשתיקה."
  },
  {
   "start": 439.66,
   "end": 440.02,
   "text": "מינה,"
  },
  {
   "start": 441.72,
   "end": 443.84,
   "text": "ששמה לב שבעלה נעלם בלילות,"
  },
  {
   "start": 445.14,
   "end": 445.68,
   "text": "התחילה ללחוץ,"
  },
  {
   "start": 446.66,
   "end": 448.14,
   "text": "לספר איפה אתה נעלם?"
  },
  {
   "start": 449.2,
   "end": 449.8,
   "text": "איפה אתה נעלם?"
  },
  {
   "start": 450.66,
   "end": 451.48,
   "text": "אני רוצה לדעת."
  },
  {
   "start": 454.8,
   "end": 455.82,
   "text": "אבל המבט בעיניו"
  },
  {
   "start": 458.62,
   "end": 460.16,
   "text": "של מנחם גרם לה לעצור."
  },
  {
   "start": 460.84,
   "end": 461.26,
   "text": "נמאס לי."
  },
  {
   "start": 462.26,
   "end": 464.88,
   "text": "נמאס לי מכם, אתם הרחקתם אותי מהתורה,"
  },
  {
   "start": 465.66,
   "end": 467.14,
   "text": "הכנסתם אותי מאור לחושך."
  },
  {
   "start": 468.14,
   "end": 471.28,
   "text": "כבר אין לי מה להפסיד, סינן מנחם."
  },
  {
   "start": 472.04,
   "end": 476.54,
   "text": "ומינה הבינה בפעם הראשונה את הטעות האיומה שהיא עשתה."
  },
  {
   "start": 479.72,
   "end": 480.9,
   "text": "זה היה מנחם אחר,"
  },
  {
   "start": 481.4,
   "end": 482.86,
   "text": "מנחם עם הרבה חושך,"
  },
  {
   "start": 483.34,
   "end": 485.38,
   "text": "שמסתיר את האור בנשמה שלו."
  },
  {
   "start": 510.5,
   "end": 512.04,
   "text": "ככל שמחוגי השעון"
  },
  {
   "start": 514.04,
   "end": 515.42,
   "text": "התקדמו להם עוד ועוד,"
  },
  {
   "start": 516.66,
   "end": 517.3,
   "text": "השינוי"
  },
  {
   "start": 518.44,
   "end": 522.74,
   "text": "במנחם הלך והתעצם, ומינה לא יכלה לעצור את זה."
  },
  {
   "start": 523.08,
   "end": 525.4,
   "text": "היא מרגישה שהיא מאבדת את בעלה, אבל מה היא תעשה?"
  },
  {
   "start": 526.84,
   "end": 528.26,
   "text": "מה היא תעשה? עכשיו זה כבר מאוחר."
  },
  {
   "start": 529.34,
   "end": 530.14,
   "text": "היא התחילה לבכות,"
  },
  {
   "start": 531.04,
   "end": 532.24,
   "text": "היא התחילה להתפלל השם."
  },
  {
   "start": 533.2,
   "end": 535.9,
   "text": "חודשים היא לא התפללה, כמו שצריך."
  },
  {
   "start": 539.66,
   "end": 541.2,
   "text": "וסוף סוף היא לוקחת את הסידור,"
  },
  {
   "start": 541.6,
   "end": 544.18,
   "text": "ונחל של דמעות מרטיב את הסידור."
  },
  {
   "start": 544.64,
   "end": 546.28,
   "text": "בורא עולם תחזיר לי את בעלי,"
  },
  {
   "start": 553.78,
   "end": 555.08,
   "text": "אבל כאילו הכל נאטם מסביב."
  },
  {
   "start": 555.64,
   "end": 559.98,
   "text": "מנחם עזב את הבית."
  },
  {
   "start": 563.43,
   "end": 565.39,
   "text": "מנחם הצטרף לחבורת השודדים,"
  },
  {
   "start": 567.41,
   "end": 568.61,
   "text": "ומינה נשארה מאחור,"
  },
  {
   "start": 570.13,
   "end": 571.23,
   "text": "בודדה וגלמודה."
  },
  {
   "start": 573.11,
   "end": 573.43,
   "text": "היא לא הספיקה,"
  },
  {
   "start": 574.79,
   "end": 579.63,
   "text": "היא לא הספיקה לספר למנחם שבבטן שלה היא נושאת הבן שלהם."
  },
  {
   "start": 584.48,
   "end": 588.4,
   "text": "אם עד, עד לפני כמה זמן העתיד היה ורוד מבחינתה,"
  },
  {
   "start": 589.68,
   "end": 591.74,
   "text": "היום כבר היא לא יודעת לאן, לאיזו מציאות."
  },
  {
   "start": 592.52,
   "end": 593.6,
   "text": "הילד שלה יוולד."
  },
  {
   "start": 595.52,
   "end": 597.38,
   "text": "ומינה התחילה בתהליך ארוך,"
  },
  {
   "start": 598.14,
   "end": 598.5,
   "text": "איטי,"
  },
  {
   "start": 602.68,
   "end": 603.36,
   "text": "של תשובה."
  },
  {
   "start": 608.97,
   "end": 609.55,
   "text": "כל צעד,"
  },
  {
   "start": 610.69,
   "end": 612.03,
   "text": "כל צעד אל השם יתברך,"
  },
  {
   "start": 612.75,
   "end": 615.91,
   "text": "חשף בפניה את הטעויות שהיא עשתה,"
  },
  {
   "start": 619.56,
   "end": 622.48,
   "text": "את העוצמה של האסון שהיא הנחיתה על עצמה,"
  },
  {
   "start": 626.38,
   "end": 627.22,
   "text": "והיא החלה לפתוח"
  },
  {
   "start": 628.34,
   "end": 630.82,
   "text": "במעשי חסד, במעשים של זיכוי רבים,"
  },
  {
   "start": 631.86,
   "end": 632.58,
   "text": "על מנת לכפר,"
  },
  {
   "start": 633.52,
   "end": 634.56,
   "text": "לכפר על עצמה."
  },
  {
   "start": 636.78,
   "end": 638.08,
   "text": "אולי לתת לילד של העתיד,"
  },
  {
   "start": 639.46,
   "end": 640.18,
   "text": "עתיד טוב יותר."
  },
  {
   "start": 641.36,
   "end": 642.74,
   "text": "לילה-לילה אישה בודדה"
  },
  {
   "start": 643.74,
   "end": 665.12,
   "text": "מרטיבה את הקר בבכי, עברו להם שנים."
  },
  {
   "start": 668.24,
   "end": 668.92,
   "text": "הרחק מברוד,"
  },
  {
   "start": 670.06,
   "end": 671.56,
   "text": "בדרך המובילה לרוז'ין."
  },
  {
   "start": 673.02,
   "end": 673.78,
   "text": "בדרך המובילה"
  },
  {
   "start": 675.86,
   "end": 676.72,
   "text": "אל האדמו״ר,"
  },
  {
   "start": 677.38,
   "end": 680.24,
   "text": "רבי ישראל מרוז'ין, זכר צדיק וקדוש לברכה."
  },
  {
   "start": 682.7,
   "end": 684.64,
   "text": "סופת הגשמים הייתה איומה,"
  },
  {
   "start": 686.7,
   "end": 688.98,
   "text": "והעגלה שהתנודדה לה בחוץ,"
  },
  {
   "start": 689.42,
   "end": 691.64,
   "text": "מתנסה להתקדם קדימה, מנסה לפלס לה דרך"
  },
  {
   "start": 692.3,
   "end": 694.86,
   "text": "במעבה היער חשבה להישבר."
  },
  {
   "start": 697.92,
   "end": 698.64,
   "text": "האיש על העגלה"
  },
  {
   "start": 700.02,
   "end": 702.48,
   "text": "הטה אותה אל דרך העפר המוליכה"
  },
  {
   "start": 703.16,
   "end": 711.02,
   "text": "אל בית האכסניה כל דקה בחוץ."
  },
  {
   "start": 712.4,
   "end": 713.2,
   "text": "משמעה סכנה."
  },
  {
   "start": 714.18,
   "end": 715.36,
   "text": "הוא חייב להגיע לאכסניה."
  },
  {
   "start": 717.98,
   "end": 719.36,
   "text": "דלת האכסניה נפתחה."
  },
  {
   "start": 720.3,
   "end": 721.7,
   "text": "בעל האכסניה, שבתאי,"
  },
  {
   "start": 724.62,
   "end": 725.22,
   "text": "הכיר את האיש."
  },
  {
   "start": 726.3,
   "end": 726.94,
   "text": "משה, תיכנס."
  },
  {
   "start": 727.26,
   "end": 728.44,
   "text": "משה, תיכנס. בוא, מה קרה?"
  },
  {
   "start": 728.9,
   "end": 730.28,
   "text": "בשעה כזאת, איך הגעת לכאן?"
  },
  {
   "start": 740.73,
   "end": 742.19,
   "text": "הגשמים בחוץ, הסערות,"
  },
  {
   "start": 743.21,
   "end": 744.99,
   "text": "סיפרו את סיפורו של משה שנתקע בדרך,"
  },
  {
   "start": 745.71,
   "end": 746.97,
   "text": "שהגשמים והשלוליות"
  },
  {
   "start": 748.05,
   "end": 749.09,
   "text": "וסופות השלגים"
  },
  {
   "start": 750.99,
   "end": 752.07,
   "text": "מנעו ממנו להגיע."
  },
  {
   "start": 752.81,
   "end": 755.47,
   "text": "הוא היה צריך להגיע בבוקר לאכסניה, הוא הגיע בערב."
  },
  {
   "start": 759.48,
   "end": 760.02,
   "text": "משה חסיד"
  },
  {
   "start": 761.42,
   "end": 763.16,
   "text": "ותלמיד של רבי ישראל מרוז'ין,"
  },
  {
   "start": 764.44,
   "end": 766.24,
   "text": "כתלמיד נאמן, עשה את הדרך אל רבו,"
  },
  {
   "start": 767.26,
   "end": 769.48,
   "text": "כמדי שנה, תמיד הוא היה נעצר שם באכסניה,"
  },
  {
   "start": 770.26,
   "end": 772.38,
   "text": "מתארח וממשיך הלאה. גם השנה,"
  },
  {
   "start": 775.47,
   "end": 779.37,
   "text": "רק לא היה צפוי כל כך שיגיע בשעות כאלה, הוא לא הספיק אפילו להדליק נר של חנוכה."
  },
  {
   "start": 781.82,
   "end": 782.74,
   "text": "משה התפלל ערבית,"
  },
  {
   "start": 783.4,
   "end": 784.78,
   "text": "אחר כך הדליק נר של חנוכה."
  },
  {
   "start": 786.18,
   "end": 786.96,
   "text": "כולם ישנים,"
  },
  {
   "start": 787.72,
   "end": 791.84,
   "text": "חוץ ממשה, שיושב סגור לו בחדר, מביט בנרות החנוכה,"
  },
  {
   "start": 792.48,
   "end": 793.26,
   "text": "ולאט לאט"
  },
  {
   "start": 794.72,
   "end": 795.32,
   "text": "נרדם."
  },
  {
   "start": 796.52,
   "end": 797.04,
   "text": "העייפות"
  },
  {
   "start": 797.88,
   "end": 798.68,
   "text": "השתלטה עליו."
  },
  {
   "start": 821.56,
   "end": 822.74,
   "text": "נקישות נשמעו בדלת."
  },
  {
   "start": 825.25,
   "end": 826.35,
   "text": "הן בהתחלה היו חלושות,"
  },
  {
   "start": 827.39,
   "end": 828.45,
   "text": "אבל לאט לאט הן התחזקו."
  },
  {
   "start": 829.09,
   "end": 832.59,
   "text": "עוד ועוד נקישות שהלכו והתחזקו ונהפכו לחבטות."
  },
  {
   "start": 833.45,
   "end": 838.15,
   "text": "בני הבית שהתעוררו למשמע החבטות נעמדו כמו מסומרים למקומותיהם מפחד."
  },
  {
   "start": 839.75,
   "end": 842.93,
   "text": "ולפתע נשמעו זעקות מקפיאות דם מבחוץ."
  },
  {
   "start": 844.41,
   "end": 847.59,
   "text": "זעה קרה חילחלה לה במורד גבו של שבתאי בעל האכסניה."
  },
  {
   "start": 850.99,
   "end": 851.71,
   "text": "מכת גרזן,"
  },
  {
   "start": 852.37,
   "end": 853.25,
   "text": "מכת גרזן בדלת,"
  },
  {
   "start": 854.05,
   "end": 855.29,
   "text": "והנה נפרצה הדלת."
  },
  {
   "start": 856.31,
   "end": 856.93,
   "text": "וחבורה,"
  },
  {
   "start": 857.93,
   "end": 860.77,
   "text": "חבורה של בריונים, חבורה של שודדים, פרצה אל תוך הבית."
  },
  {
   "start": 861.75,
   "end": 864.67,
   "text": "בחסות סופת השלגים בחוץ,"
  },
  {
   "start": 865.47,
   "end": 866.59,
   "text": "אף אחד לא ישמע כלום,"
  },
  {
   "start": 867.31,
   "end": 868.05,
   "text": "אף אחד לא ידע."
  },
  {
   "start": 870.39,
   "end": 871.03,
   "text": "והשודדים,"
  },
  {
   "start": 871.79,
   "end": 872.29,
   "text": "תוך דקות,"
  },
  {
   "start": 874.7,
   "end": 877.62,
   "text": "התנפלו על בני הבית חסרי ישע, היכו אותם מכות באכזריות,"
  },
  {
   "start": 878.12,
   "end": 878.92,
   "text": "וקשרו אותם"
  },
  {
   "start": 879.64,
   "end": 880.62,
   "text": "אל גרם המדרגות."
  },
  {
   "start": 881.48,
   "end": 884.34,
   "text": "אחרי זה, בצומה מאורגנת, הם התחילו להתחלק לשני קבוצות, אחת אוספת שלל,"
  },
  {
   "start": 885.26,
   "end": 887.68,
   "text": "והשנייה פורצת, פותחת, שוברת."
  },
  {
   "start": 889.44,
   "end": 892.36,
   "text": "כל רהיט בבית, וכך הם עברו חדר-חדר."
  },
  {
   "start": 894.65,
   "end": 895.39,
   "text": "למעלה בחדר"
  },
  {
   "start": 896.55,
   "end": 897.33,
   "text": "יושב לו משה."
  },
  {
   "start": 898.25,
   "end": 899.37,
   "text": "משה היה חיוור כמו מת."
  },
  {
   "start": 900.75,
   "end": 901.93,
   "text": "ליבו הולם בחוזקה."
  },
  {
   "start": 903.23,
   "end": 903.75,
   "text": "הם לא גילו אותו."
  },
  {
   "start": 905.19,
   "end": 907.03,
   "text": "הוא הציץ מחור המנעול, רואה את השודדים,"
  },
  {
   "start": 907.43,
   "end": 908.57,
   "text": "מבין שכוונתם,"
  },
  {
   "start": 910.95,
   "end": 912.95,
   "text": "כוונתם לרצוח את הקורבנות."
  },
  {
   "start": 913.77,
   "end": 915.59,
   "text": "הם אפילו לא טרחו לכסות את הפנים שלהם."
  },
  {
   "start": 916.83,
   "end": 919.25,
   "text": "לא הייתה להם כוונה להשאיר אחריהם עדים."
  },
  {
   "start": 927.0,
   "end": 927.78,
   "text": "מלאך המוות"
  },
  {
   "start": 929.4,
   "end": 931.02,
   "text": "מרחף לו מהלך, סניה."
  },
  {
   "start": 933.33,
   "end": 934.77,
   "text": "טוב, מה אני יכול לעשות במצב כזה?"
  },
  {
   "start": 935.27,
   "end": 935.99,
   "text": "שאל את עצמו,"
  },
  {
   "start": 937.03,
   "end": 937.19,
   "text": "משה."
  },
  {
   "start": 938.57,
   "end": 938.99,
   "text": "ומשה"
  },
  {
   "start": 940.57,
   "end": 941.39,
   "text": "החל לגרוס"
  },
  {
   "start": 942.91,
   "end": 946.27,
   "text": "את הלימוד שלו בניגון חרישי, בדבקות,"
  },
  {
   "start": 947.03,
   "end": 949.45,
   "text": "תוך שהוא שם את מבטחו בקדוש ברוך הוא."
  },
  {
   "start": 951.65,
   "end": 952.79,
   "text": "ממול נרות חנוכה"
  },
  {
   "start": 953.47,
   "end": 954.73,
   "text": "שלחו אליו את עורם,"
  },
  {
   "start": 956.07,
   "end": 959.05,
   "text": "ושלהבת הנרות נראית לה כנעל את זילי הלימוד."
  },
  {
   "start": 960.27,
   "end": 962.31,
   "text": "ככל שגברה הדבקות של משה,"
  },
  {
   "start": 962.87,
   "end": 964.49,
   "text": "ככל שהוא שקע בלימוד,"
  },
  {
   "start": 965.13,
   "end": 966.53,
   "text": "ככה גבר קולו,"
  },
  {
   "start": 967.23,
   "end": 967.99,
   "text": "והוא לא שם לב"
  },
  {
   "start": 968.83,
   "end": 972.09,
   "text": "איך קול הלימוד נשמע אל מחוץ לחדר."
  },
  {
   "start": 1005.23,
   "end": 1006.09,
   "text": "קולות הניגון,"
  },
  {
   "start": 1006.85,
   "end": 1010.41,
   "text": "קולות הניגון הגיעו לאוזניו של מנהיג חבורת השודדים,"
  },
  {
   "start": 1011.23,
   "end": 1012.43,
   "text": "והוא פתח בריצה,"
  },
  {
   "start": 1012.91,
   "end": 1015.11,
   "text": "הוא פתח בריצה מהירה אל דלת חדרו של משה."
  },
  {
   "start": 1021.43,
   "end": 1022.23,
   "text": "בעיטה אדירה,"
  },
  {
   "start": 1023.43,
   "end": 1024.53,
   "text": "והדלת נפרצה לרווחה."
  },
  {
   "start": 1029.25,
   "end": 1030.19,
   "text": "משה קפץ בבהלה,"
  },
  {
   "start": 1031.13,
   "end": 1031.91,
   "text": "לרגע הוא קפא,"
  },
  {
   "start": 1031.91,
   "end": 1033.81,
   "text": "הוא ניצב,"
  },
  {
   "start": 1034.73,
   "end": 1035.43,
   "text": "הוא ניצב מולו,"
  },
  {
   "start": 1036.77,
   "end": 1039.27,
   "text": "מנהיג השודדים, רוצח אכזרי וקשוח."
  },
  {
   "start": 1041.13,
   "end": 1041.79,
   "text": "משה התעשת מיד."
  },
  {
   "start": 1044.23,
   "end": 1047.79,
   "text": "הוא עצם את עיניו והחל קורא, שמע ישראל,"
  },
  {
   "start": 1048.65,
   "end": 1049.85,
   "text": "אדוני אלוהינו,"
  },
  {
   "start": 1050.39,
   "end": 1051.33,
   "text": "אדוני אחד,"
  },
  {
   "start": 1052.13,
   "end": 1054.35,
   "text": "תוך שהוא מכין את עצמו למוות הקרב ובא."
  },
  {
   "start": 1055.61,
   "end": 1057.47,
   "text": "דממה השתררה לה בחדר,"
  },
  {
   "start": 1058.05,
   "end": 1058.77,
   "text": "דממת מוות,"
  },
  {
   "start": 1062.18,
   "end": 1067.33,
   "text": "ומשה פקח. ולפתע,"
  },
  {
   "start": 1068.07,
   "end": 1069.27,
   "text": "הוא רואה מולו את הרוצח,"
  },
  {
   "start": 1070.25,
   "end": 1072.75,
   "text": "לוטש עיניים פעורות לרווחה"
  },
  {
   "start": 1073.43,
   "end": 1074.85,
   "text": "בנרות החנוכה,"
  },
  {
   "start": 1078.04,
   "end": 1080.24,
   "text": "בנרות החנוכה שיבהבו כנגדו."
  },
  {
   "start": 1084.44,
   "end": 1085.26,
   "text": "היום חנוכה?"
  },
  {
   "start": 1086.94,
   "end": 1087.06,
   "text": "כן,"
  },
  {
   "start": 1087.84,
   "end": 1088.84,
   "text": "חנוכה,"
  },
  {
   "start": 1090.2,
   "end": 1090.62,
   "text": "נרות,"
  },
  {
   "start": 1091.64,
   "end": 1092.16,
   "text": "שמן."
  },
  {
   "start": 1096.17,
   "end": 1096.47,
   "text": "מה זה?"
  },
  {
   "start": 1097.25,
   "end": 1099.83,
   "text": "הצביע הרוצח אל הגמרא הפתוחה."
  },
  {
   "start": 1100.69,
   "end": 1101.45,
   "text": "זו גמרא?"
  },
  {
   "start": 1106.23,
   "end": 1107.15,
   "text": "מלמל משה."
  },
  {
   "start": 1108.45,
   "end": 1109.19,
   "text": "והרוצח"
  },
  {
   "start": 1109.75,
   "end": 1114.75,
   "text": "הפנה את פניו, והנרות, הנרות האירו לו את הפנים,"
  },
  {
   "start": 1116.27,
   "end": 1121.75,
   "text": "וללא קול החלו דמעות זולגות מעיניו במורד לחיו."
  },
  {
   "start": 1124.77,
   "end": 1126.13,
   "text": "הרוצח נשא את עיניו,"
  },
  {
   "start": 1126.77,
   "end": 1127.69,
   "text": "עיניים דומעות,"
  },
  {
   "start": 1128.43,
   "end": 1129.99,
   "text": "עיניים ספוגות בכאב,"
  },
  {
   "start": 1131.47,
   "end": 1132.65,
   "text": "והתבונן במשה"
  },
  {
   "start": 1133.21,
   "end": 1134.07,
   "text": "במבט מוזר."
  },
  {
   "start": 1134.87,
   "end": 1135.75,
   "text": "אתה משה, נכון?"
  },
  {
   "start": 1137.83,
   "end": 1138.51,
   "text": "הוא אומר לו, כן."
  },
  {
   "start": 1139.99,
   "end": 1140.89,
   "text": "משה מז'יתומיר,"
  },
  {
   "start": 1141.67,
   "end": 1142.09,
   "text": "כן,"
  },
  {
   "start": 1144.66,
   "end": 1145.34,
   "text": "איך אתה יודע?"
  },
  {
   "start": 1146.76,
   "end": 1147.68,
   "text": "אתה יודע מי אני?"
  },
  {
   "start": 1151.65,
   "end": 1154.09,
   "text": "אני החברותא שלך מבית המדרש בז'יתומים."
  },
  {
   "start": 1155.09,
   "end": 1156.41,
   "text": "אני מנחם פרנק!"
  },
  {
   "start": 1157.85,
   "end": 1158.63,
   "text": "זה אני!"
  },
  {
   "start": 1167.12,
   "end": 1169.02,
   "text": "ומשה החל לרעוד בכל גופו."
  },
  {
   "start": 1171.58,
   "end": 1172.84,
   "text": "דקות ארוכות הם אחזו."
  },
  {
   "start": 1174.36,
   "end": 1175.42,
   "text": "איש ביד רעהו,"
  },
  {
   "start": 1177.45,
   "end": 1177.99,
   "text": "במבט"
  },
  {
   "start": 1179.37,
   "end": 1203.67,
   "text": "שאומר הכל מקץ מספר דקות."
  },
  {
   "start": 1204.51,
   "end": 1206.67,
   "text": "התנתק מנחם לפתע,"
  },
  {
   "start": 1207.65,
   "end": 1208.49,
   "text": "ומבטו התחלף."
  },
  {
   "start": 1209.41,
   "end": 1210.77,
   "text": "מעצב למבט קר,"
  },
  {
   "start": 1211.83,
   "end": 1212.91,
   "text": "תישאר כאן, אל תצא."
  },
  {
   "start": 1214.53,
   "end": 1216.03,
   "text": "הוא כינס את כל בני החבורה שלהם ואמר,"
  },
  {
   "start": 1217.33,
   "end": 1217.99,
   "text": "תקשיבו עכשיו,"
  },
  {
   "start": 1219.05,
   "end": 1219.19,
   "text": "אלה"
  },
  {
   "start": 1219.87,
   "end": 1221.01,
   "text": "זה המשפחה שלי."
  },
  {
   "start": 1222.81,
   "end": 1225.21,
   "text": "אנחנו עוזבים אותם פה, משחררים אותם וחוזרים הביתה."
  },
  {
   "start": 1230.13,
   "end": 1232.59,
   "text": "השודדים צייתו לכל מה שהוא אמר,"
  },
  {
   "start": 1233.21,
   "end": 1236.79,
   "text": "ותוך דקות התרוקנה האכסניה מאימת המוות ששרתה בה."
  },
  {
   "start": 1246.44,
   "end": 1247.1,
   "text": "למחרת בבוקר,"
  },
  {
   "start": 1248.28,
   "end": 1249.88,
   "text": "רסה משה את דרכו לרוז'ין,"
  },
  {
   "start": 1250.84,
   "end": 1253.44,
   "text": "תוך שהוא נפרד מבעל האכסניה שלו, הפסיק להודות"
  },
  {
   "start": 1254.02,
   "end": 1258.32,
   "text": "ולהלל את השם יתברך על נס החנוכה שנעשה לו ולמשפחתו."
  },
  {
   "start": 1259.74,
   "end": 1261.7,
   "text": "וככה העגלה עושה את דרכה במהירות,"
  },
  {
   "start": 1264.63,
   "end": 1266.35,
   "text": "כשמשה מנווט את דרך במיומנות."
  },
  {
   "start": 1267.87,
   "end": 1268.31,
   "text": "אבל אז,"
  },
  {
   "start": 1268.95,
   "end": 1270.85,
   "text": "אז על אם הדרך, ניצבה לדמות."
  },
  {
   "start": 1272.11,
   "end": 1273.47,
   "text": "וכשהעגלה התקרבה,"
  },
  {
   "start": 1274.49,
   "end": 1275.97,
   "text": "הרימה הדמות את ידה,"
  },
  {
   "start": 1279.42,
   "end": 1280.66,
   "text": "משה עצר את העגלה,"
  },
  {
   "start": 1282.02,
   "end": 1284.22,
   "text": "ומנחם פרנק עלה עליה."
  },
  {
   "start": 1293.14,
   "end": 1296.0,
   "text": "העגלה המשיכה לנוע כששני הידידים,"
  },
  {
   "start": 1296.74,
   "end": 1297.32,
   "text": "החברותה,"
  },
  {
   "start": 1298.5,
   "end": 1300.64,
   "text": "שוב ביחד, כמו אז בז'יטומיר,"
  },
  {
   "start": 1301.92,
   "end": 1305.6,
   "text": "ביחד על העגלה בדרך המובילה אל רבם של ישראל,"
  },
  {
   "start": 1306.56,
   "end": 1308.44,
   "text": "אל רבי ישראל מרוז'ין,"
  },
  {
   "start": 1322.44,
   "end": 1323.66,
   "text": "שם ברוז'ין מול הרב."
  },
  {
   "start": 1325.24,
   "end": 1326.14,
   "text": "אמר מנחם,"
  },
  {
   "start": 1326.92,
   "end": 1329.4,
   "text": "שנים לא הרגשתי את האור, את האור,"
  },
  {
   "start": 1330.08,
   "end": 1330.92,
   "text": "את האור היהודי,"
  },
  {
   "start": 1331.8,
   "end": 1333.06,
   "text": "ולפתע נכנסתי לחדר,"
  },
  {
   "start": 1333.98,
   "end": 1334.94,
   "text": "והייתה שם גמרה,"
  },
  {
   "start": 1335.6,
   "end": 1336.36,
   "text": "היו שם נרות חנוכה,"
  },
  {
   "start": 1338.4,
   "end": 1339.34,
   "text": "בתיקות התורה,"
  },
  {
   "start": 1339.9,
   "end": 1340.6,
   "text": "אור היהדות,"
  },
  {
   "start": 1341.72,
   "end": 1343.08,
   "text": "נשמה, שבת,"
  },
  {
   "start": 1345.21,
   "end": 1346.07,
   "text": "משפחה."
  },
  {
   "start": 1347.47,
   "end": 1350.53,
   "text": "כאילו העירו אותי מאיזה חלום בלהות של שנים."
  },
  {
   "start": 1356.9,
   "end": 1358.08,
   "text": "כך אמרו ברוז'ין,"
  },
  {
   "start": 1358.78,
   "end": 1359.9,
   "text": "כך אמרו ברוז'ין."
  },
  {
   "start": 1361.96,
   "end": 1365.18,
   "text": "בחג החנוכה ניצחו מעטים את הרבים."
  },
  {
   "start": 1369.53,
   "end": 1371.19,
   "text": "מה זה ניצחו מעטים את הרבים?"
  },
  {
   "start": 1371.77,
   "end": 1372.57,
   "text": "לא רק במלחמה,"
  },
  {
   "start": 1373.49,
   "end": 1380.23,
   "text": "אלא בחג החנוכה ניצחו מעטים יהודים עם מעט מעט מעט מעשים טובים,"
  },
  {
   "start": 1380.73,
   "end": 1382.01,
   "text": "מעט מעט מצוות,"
  },
  {
   "start": 1382.53,
   "end": 1383.79,
   "text": "מעט מעט אור."
  },
  {
   "start": 1384.35,
   "end": 1386.29,
   "text": "ניצחו את הרבים, את החטאים,"
  },
  {
   "start": 1386.75,
   "end": 1388.21,
   "text": "את הרבה חטאים שיש להם,"
  },
  {
   "start": 1388.55,
   "end": 1390.07,
   "text": "את הרבה החושך שיש להם."
  },
  {
   "start": 1390.59,
   "end": 1392.99,
   "text": "זה המעטים שניצחו את הרבים."
  },
  {
   "start": 1393.91,
   "end": 1396.71,
   "text": "כמו שמעטים ניצחו את הרבים בשדה המערכה,"
  },
  {
   "start": 1397.31,
   "end": 1401.37,
   "text": "גם יהודים עם מעט מעשים טובים והרבה חטאים"
  },
  {
   "start": 1401.37,
   "end": 1403.95,
   "text": "יכולים המעטים לנצח את הרבים."
  },
  {
   "start": 1405.11,
   "end": 1408.73,
   "text": "יכול האור, הקצת אור, להניס את החושך."
  },
  {
   "start": 1414.3,
   "end": 1416.6,
   "text": "בתום חג החנוכה, משה חזר לביתו,"
  },
  {
   "start": 1417.44,
   "end": 1417.82,
   "text": "לבד."
  },
  {
   "start": 1418.7,
   "end": 1421.1,
   "text": "מנחם נשאר ברוז'ים."
  },
  {
   "start": 1449.27,
   "end": 1449.87,
   "text": "שנתיים,"
  },
  {
   "start": 1450.81,
   "end": 1451.81,
   "text": "שנתיים אחר כך,"
  },
  {
   "start": 1453.96,
   "end": 1454.54,
   "text": "חג החנוכה."
  },
  {
   "start": 1456.67,
   "end": 1457.09,
   "text": "בברוד,"
  },
  {
   "start": 1459.89,
   "end": 1460.47,
   "text": "בתלמוד תורה."
  },
  {
   "start": 1464.83,
   "end": 1465.21,
   "text": "מסיבת חנוכה."
  },
  {
   "start": 1465.87,
   "end": 1466.57,
   "text": "כל הילדים,"
  },
  {
   "start": 1467.39,
   "end": 1468.69,
   "text": "כל הילדים לבושים חגיגית."
  },
  {
   "start": 1469.91,
   "end": 1471.41,
   "text": "מסיבת חנוכה וחידון חנוכה,"
  },
  {
   "start": 1472.05,
   "end": 1473.07,
   "text": "הילדים עליזים,"
  },
  {
   "start": 1473.75,
   "end": 1477.19,
   "text": "נעמדים ליד ההורים שלהם, כולם מצפים, כולם אוהבים את המסיבות,"
  },
  {
   "start": 1478.35,
   "end": 1481.37,
   "text": "את האור המיוחד שמלווה את החגים."
  },
  {
   "start": 1487.58,
   "end": 1488.16,
   "text": "האימהות היו"
  },
  {
   "start": 1489.78,
   "end": 1491.3,
   "text": "מביטות מאחור בגאווה,"
  },
  {
   "start": 1492.08,
   "end": 1494.56,
   "text": "בהערצה באב ובבן שלו."
  },
  {
   "start": 1495.12,
   "end": 1496.16,
   "text": "אף אחד כמעט לא שם לב"
  },
  {
   "start": 1496.82,
   "end": 1499.62,
   "text": "שבקצה השני של האולם עמד לו ילד,"
  },
  {
   "start": 1500.44,
   "end": 1500.86,
   "text": "ילד עצוב,"
  },
  {
   "start": 1504.12,
   "end": 1504.9,
   "text": "ילד בלי שמחה,"
  },
  {
   "start": 1505.76,
   "end": 1506.28,
   "text": "ילד בודד,"
  },
  {
   "start": 1506.9,
   "end": 1507.18,
   "text": "בלי אבא."
  },
  {
   "start": 1508.78,
   "end": 1510.34,
   "text": "מתאמץ לענות על החידון לבד,"
  },
  {
   "start": 1510.96,
   "end": 1513.08,
   "text": "כשכולם עם מבט של שמחה בעיניים,"
  },
  {
   "start": 1513.7,
   "end": 1516.28,
   "text": "הוא עמד לו עם העיניים הגדולות שלו,"
  },
  {
   "start": 1516.86,
   "end": 1518.08,
   "text": "והן היו כל כך עצובות."
  },
  {
   "start": 1519.28,
   "end": 1519.78,
   "text": "מדי פעם,"
  },
  {
   "start": 1520.54,
   "end": 1524.76,
   "text": "מדי פעם הוא הרשה לעצמו לחטוף איזה מבט אל מקום האימהות."
  },
  {
   "start": 1526.26,
   "end": 1528.96,
   "text": "טר במבטו אחר אמא, אמא שלו,"
  },
  {
   "start": 1531.32,
   "end": 1532.04,
   "text": "אבל היא לא הייתה שם,"
  },
  {
   "start": 1544.42,
   "end": 1546.36,
   "text": "באולם התלמוד תורה החידון בעיצומו."
  },
  {
   "start": 1547.32,
   "end": 1547.82,
   "text": "כל ילד"
  },
  {
   "start": 1548.82,
   "end": 1551.68,
   "text": "נשאל מספר שאלות, הוא יכול להיעזר באבא שלו."
  },
  {
   "start": 1552.88,
   "end": 1554.24,
   "text": "וככה נמשך החידון,"
  },
  {
   "start": 1555.2,
   "end": 1556.0,
   "text": "ועכשיו הגיעו"
  },
  {
   "start": 1556.76,
   "end": 1561.06,
   "text": "אל הילד הבודד בפינה,"
  },
  {
   "start": 1562.48,
   "end": 1564.16,
   "text": "שכאילו נדבק לקיר"
  },
  {
   "start": 1564.92,
   "end": 1567.16,
   "text": "כמחפש לו הגנה, הוא היה לבד,"
  },
  {
   "start": 1568.06,
   "end": 1568.54,
   "text": "זה לא קל."
  },
  {
   "start": 1570.16,
   "end": 1571.18,
   "text": "הוא קיבל את השאלות,"
  },
  {
   "start": 1572.98,
   "end": 1574.08,
   "text": "הביט בשאלון,"
  },
  {
   "start": 1575.7,
   "end": 1578.44,
   "text": "הרים את העיניים אל עבר מקום האימהות."
  },
  {
   "start": 1578.76,
   "end": 1579.36,
   "text": "אמא הגיעה?"
  },
  {
   "start": 1581.2,
   "end": 1581.44,
   "text": "ואז,"
  },
  {
   "start": 1582.36,
   "end": 1583.22,
   "text": "אז הוא ראה אותה."
  },
  {
   "start": 1584.04,
   "end": 1584.76,
   "text": "היא עמדה שם,"
  },
  {
   "start": 1585.44,
   "end": 1585.68,
   "text": "אימא,"
  },
  {
   "start": 1586.7,
   "end": 1588.62,
   "text": "עומדת מביטה בו בפנים קורנות."
  },
  {
   "start": 1590.3,
   "end": 1590.5,
   "text": "אבל,"
  },
  {
   "start": 1592.36,
   "end": 1593.32,
   "text": "מה היא מסמנת לי?"
  },
  {
   "start": 1594.56,
   "end": 1595.92,
   "text": "אימא החלה מסמנת לו משהו."
  },
  {
   "start": 1596.68,
   "end": 1597.46,
   "text": "הוא לא כל כך הבין."
  },
  {
   "start": 1601.91,
   "end": 1602.37,
   "text": "מה היא מסמנת?"
  },
  {
   "start": 1603.93,
   "end": 1605.43,
   "text": "ואז אימא הרימה את היד שלה"
  },
  {
   "start": 1606.57,
   "end": 1607.57,
   "text": "לכיוון האיש,"
  },
  {
   "start": 1608.27,
   "end": 1609.59,
   "text": "האיש שעמד לו בפינה."
  },
  {
   "start": 1611.21,
   "end": 1612.35,
   "text": "מניעת השפתיים."
  },
  {
   "start": 1612.35,
   "end": 1616.65,
   "text": "מינה,"
  },
  {
   "start": 1618.82,
   "end": 1619.46,
   "text": "מינה עיננה,"
  },
  {
   "start": 1622.15,
   "end": 1623.47,
   "text": "מנסה לרמוז לילד שלה,"
  },
  {
   "start": 1624.71,
   "end": 1626.67,
   "text": "שסוף סוף החלום התגשם."
  },
  {
   "start": 1628.03,
   "end": 1628.99,
   "text": "לילד אין אבא,"
  },
  {
   "start": 1629.77,
   "end": 1634.83,
   "text": "אמר אחד השמשים לצוות הרבנים, אין מה לעשות, אין לו אבא, אז הוא יצטרך לענות לבד?"
  },
  {
   "start": 1636.05,
   "end": 1637.31,
   "text": "לילד יש אבא."
  },
  {
   "start": 1638.53,
   "end": 1639.33,
   "text": "נשמע הכל,"
  },
  {
   "start": 1640.27,
   "end": 1640.83,
   "text": "וכולם,"
  },
  {
   "start": 1641.45,
   "end": 1645.95,
   "text": "כולם עשו את מבטם אל האיש הגבוה שהתקרב מפינת האולם."
  },
  {
   "start": 1647.41,
   "end": 1648.37,
   "text": "אני אבא של גד,"
  },
  {
   "start": 1649.15,
   "end": 1649.81,
   "text": "אמר האיש,"
  },
  {
   "start": 1651.23,
   "end": 1651.79,
   "text": "ונעמד"
  },
  {
   "start": 1652.81,
   "end": 1654.21,
   "text": "מאחורי הילד,"
  },
  {
   "start": 1654.85,
   "end": 1655.63,
   "text": "מאחורי הבן שלו."
  },
  {
   "start": 1657.57,
   "end": 1659.99,
   "text": "אתה מרשה לי לעזור לך?"
  },
  {
   "start": 1660.63,
   "end": 1661.87,
   "text": "הוא לחש בקול רועד,"
  },
  {
   "start": 1668.06,
   "end": 1668.56,
   "text": "וגד."
  },
  {
   "start": 1669.74,
   "end": 1671.96,
   "text": "הילד הנהן בדמעות."
  },
  {
   "start": 1673.28,
   "end": 1673.48,
   "text": "כן,"
  },
  {
   "start": 1674.58,
   "end": 1674.92,
   "text": "כן,"
  },
  {
   "start": 1675.98,
   "end": 1676.6,
   "text": "כן אבא,"
  },
  {
   "start": 1678.64,
   "end": 1678.94,
   "text": "כן."
  },
  {
   "start": 1684.01,
   "end": 1687.89,
   "text": "ומיחד החלו לענות על החידון,"
  },
  {
   "start": 1688.81,
   "end": 1689.61,
   "text": "ושם מאחור,"
  },
  {
   "start": 1690.71,
   "end": 1691.47,
   "text": "בביתה מינה,"
  },
  {
   "start": 1692.65,
   "end": 1694.01,
   "text": "רואה את כל התפילות שלה."
  },
  {
   "start": 1695.49,
   "end": 1696.23,
   "text": "מאות תפילות"
  },
  {
   "start": 1697.71,
   "end": 1702.87,
   "text": "שעשו את הדרך לשמיים וסללו את הדרך"
  },
  {
   "start": 1703.69,
   "end": 1704.81,
   "text": "למנחם לחזור"
  },
  {
   "start": 1705.45,
   "end": 1706.23,
   "text": "חזרה הביתה."
  },
  {
   "start": 1707.39,
   "end": 1709.17,
   "text": "לתקן, לתקן את מה?"
  },
  {
   "start": 1710.63,
   "end": 1712.09,
   "text": "את מה שהם עוללו לעצמם."
  },
  {
   "start": 1719.35,
   "end": 1719.89,
   "text": "נס חנוכה,"
  },
  {
   "start": 1720.93,
   "end": 1722.45,
   "text": "1860,"
  },
  {
   "start": 1723.33,
   "end": 1724.15,
   "text": "משפחת פרנק"
  },
  {
   "start": 1726.53,
   "end": 1726.99,
   "text": "חזרה"
  },
  {
   "start": 1728.07,
   "end": 1728.99,
   "text": "להיות משפחה,"
  },
  {
   "start": 1733.52,
   "end": 1735.08,
   "text": "מעטים כנגד רבים."
  },
  {
   "start": 1736.14,
   "end": 1738.16,
   "text": "חג החנוכה בא ואמר ואומר לנו,"
  },
  {
   "start": 1738.96,
   "end": 1741.0,
   "text": "מעטים ניצחו את הרבים?"
  },
  {
   "start": 1741.52,
   "end": 1743.26,
   "text": "אל תסתכל רק על שדה המערכה."
  },
  {
   "start": 1744.52,
   "end": 1745.32,
   "text": "בכל יהודי,"
  },
  {
   "start": 1745.96,
   "end": 1747.42,
   "text": "בכל יהודי יש נשמה,"
  },
  {
   "start": 1748.2,
   "end": 1750.78,
   "text": "בכל יהודי יש נפש,"
  },
  {
   "start": 1751.32,
   "end": 1752.18,
   "text": "גם בך,"
  },
  {
   "start": 1752.76,
   "end": 1753.4,
   "text": "גם בך."
  },
  {
   "start": 1754.74,
   "end": 1759.56,
   "text": "יש מלחמה ויש מעטים ויש רבים."
  },
  {
   "start": 1760.28,
   "end": 1763.8,
   "text": "תדע לך, תדעי לך, גם אם המעשים הטובים,"
  },
  {
   "start": 1764.54,
   "end": 1766.24,
   "text": "גם אם המצוות הן מעטות,"
  },
  {
   "start": 1767.16,
   "end": 1769.2,
   "text": "גם אם המעשים הטובים הם מעטים,"
  },
  {
   "start": 1769.74,
   "end": 1771.36,
   "text": "הם ינצחו את הרבים."
  },
  {
   "start": 1772.06,
   "end": 1774.42,
   "text": "כי האור היהודי, כי המעט"
  },
  {
   "start": 1775.4,
   "end": 1778.28,
   "text": "שיש בנשמה, ידחה את החושך."
  },
  {
   "start": 1779.66,
   "end": 1780.28,
   "text": "חג החנוכה."
  },
  {
   "start": 1790.7,
   "end": 1791.86,
   "text": "בא חג החנוכה לומר לנו,"
  },
  {
   "start": 1792.76,
   "end": 1795.88,
   "text": "מעטים כנגד רבים, וזה לא רק החג החנוכה."
  },
  {
   "start": 1797.04,
   "end": 1797.5,
   "text": "כל יום,"
  },
  {
   "start": 1798.36,
   "end": 1799.02,
   "text": "כל יום,"
  },
  {
   "start": 1800.16,
   "end": 1802.2,
   "text": "תכניסו את זה טוב-טוב לנשמה."
  },
  {
   "start": 1803.78,
   "end": 1804.76,
   "text": "אין יהודי,"
  },
  {
   "start": 1805.52,
   "end": 1810.28,
   "text": "אין יהודי שבורא עולם לא חפץ בעיקרו,"
  },
  {
   "start": 1810.94,
   "end": 1813.5,
   "text": "שבורא עולם לא מתפלל, מבקש."
  },
  {
   "start": 1814.08,
   "end": 1815.7,
   "text": "בוא, בוא אליי, בני."
  },
  {
   "start": 1816.96,
   "end": 1818.68,
   "text": "תאמין בעצמך."
  },
  {
   "start": 1819.24,
   "end": 1822.52,
   "text": "גם אם אתה מרגיש את הפחות, אתה מרגיש אסור לך להרגיש ככה."
  },
  {
   "start": 1823.08,
   "end": 1825.8,
   "text": "כי המעט טוב שבך, על זה תסתכל."
  },
  {
   "start": 1826.18,
   "end": 1828.34,
   "text": "כי המעטים מנצחים את הרבים."
  },
  {
   "start": 1828.86,
   "end": 1832.12,
   "text": "גם בך הנקודות הטובות שלך, המצוות שלך,"
  },
  {
   "start": 1832.52,
   "end": 1834.3,
   "text": "מה שאתם עושים לכבוד השם יתברך,"
  },
  {
   "start": 1834.68,
   "end": 1836.04,
   "text": "מנצחים את הרבים."
  },
  {
   "start": 1840.18,
   "end": 1842.7,
   "text": "אז מה שנשאר לנו זה רק להוסיף עוד נקודה טובה,"
  },
  {
   "start": 1843.08,
   "end": 1843.74,
   "text": "עוד מצווה,"
  },
  {
   "start": 1844.32,
   "end": 1850.46,
   "text": "עוד אמונה, עוד תורה, עוד אחדות, עוד אהבה לכבוד השם יתברך."
  },
  {
   "start": 1850.88,
   "end": 1858.56,
   "text": "כי צריך לדעת, אין יהודי בעולם, אין יהודייה בעולם שלא מקושרים אל השם יתברך,"
  },
  {
   "start": 1859.04,
   "end": 1864.1,
   "text": "שלא בורא להם יבוא ויגאל את כולנו בזכות המעט הזה."
  },
  {
   "start": 1865.12,
   "end": 1867.76,
   "text": "המעט אור שיש לכל אחד מאיתנו."
  }
 ]
}