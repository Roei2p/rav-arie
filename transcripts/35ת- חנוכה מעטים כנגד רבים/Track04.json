{
 "disc": "35ת- חנוכה מעטים כנגד רבים",
 "track": "Track04",
 "duration": 823.152,
 "segments": [
  {
   "start": 0.73,
   "end": 2.35,
   "text": "העיר צנעה שבתימן."
  },
  {
   "start": 5.36,
   "end": 7.34,
   "text": "הקהילה היהודית שם, בתימן,"
  },
  {
   "start": 8.08,
   "end": 9.4,
   "text": "בתקופה שאנחנו מדברים עליה,"
  },
  {
   "start": 11.2,
   "end": 12.26,
   "text": "הייתה בלחץ גדול."
  },
  {
   "start": 13.34,
   "end": 13.88,
   "text": "באותה תקופה"
  },
  {
   "start": 14.96,
   "end": 17.56,
   "text": "היה הנסיך אחמד הוא זה ששלט למעשה בתימן,"
  },
  {
   "start": 18.18,
   "end": 19.16,
   "text": "והיה מרד כנגדו."
  },
  {
   "start": 20.38,
   "end": 26.42,
   "text": "וכתוצאה מהמרד, שאומנם באמת דוכא, היה חשש בכל אופן לפגיעות ביהודים, היה פחד שעוד פעם יהיה מרד, שעוד פעם יקרה משהו,"
  },
  {
   "start": 27.72,
   "end": 30.24,
   "text": "ותמיד, מי אשם? מה שקורה היהודים."
  },
  {
   "start": 36.47,
   "end": 36.93,
   "text": "וככה,"
  },
  {
   "start": 38.79,
   "end": 40.77,
   "text": "אז באמת באותה תקופה הייתה אוזן קשבת"
  },
  {
   "start": 41.39,
   "end": 46.59,
   "text": "לשני האנשים שנראו ככה כבני תורה שהגיעו מארץ ישראל לארץ הקדושה."
  },
  {
   "start": 48.72,
   "end": 51.26,
   "text": "והם החלו לשכנע שם יהודים לעזוב את תימן,"
  },
  {
   "start": 52.38,
   "end": 54.6,
   "text": "לעלות לארץ המובטחת אל חיי קדושה וטהרה."
  },
  {
   "start": 61.31,
   "end": 61.99,
   "text": "יוסף צנעני."
  },
  {
   "start": 62.91,
   "end": 65.17,
   "text": "יוסף צנעני היה מתוח מאוד. למה?"
  },
  {
   "start": 65.97,
   "end": 67.45,
   "text": "למה הוא היה מתוח? כי השני הבנים שלו,"
  },
  {
   "start": 68.07,
   "end": 68.93,
   "text": "סלם ויחיה,"
  },
  {
   "start": 70.07,
   "end": 71.35,
   "text": "היו אמורים להיות בין הנושאים."
  },
  {
   "start": 72.55,
   "end": 73.47,
   "text": "הם היו בניו היחידים"
  },
  {
   "start": 74.23,
   "end": 74.85,
   "text": "של יוסף"
  },
  {
   "start": 75.45,
   "end": 76.69,
   "text": "ושל רעייתו המסורה."
  },
  {
   "start": 78.49,
   "end": 80.37,
   "text": "הם נעשה היו אומרים לנסוע עם הדודים שלהם,"
  },
  {
   "start": 81.31,
   "end": 85.85,
   "text": "כי יוסף היה חייב עדיין לסגור את העסקים שלו, הוא היה צורף ידוע,"
  },
  {
   "start": 86.31,
   "end": 88.35,
   "text": "וזה לא פשוט ככה לעזוב את הכל ולנסוע,"
  },
  {
   "start": 89.49,
   "end": 92.29,
   "text": "אז הוא אמר, טוב, קודם כל אתם תיסעו עם הדוד,"
  },
  {
   "start": 92.93,
   "end": 94.97,
   "text": "ואני אגיע, אני אגיע בהמשך, בסבב הבא."
  },
  {
   "start": 96.85,
   "end": 101.53,
   "text": "אפילו בדמיון הפרוע שלהם הם לא דמיינו מה יכול לקרות."
  },
  {
   "start": 103.51,
   "end": 107.25,
   "text": "בינתיים בארץ התקבלו דיווחי השליחים בשמחה."
  },
  {
   "start": 107.99,
   "end": 109.67,
   "text": "אלפי עולים מתעתדים לעלות ארצה,"
  },
  {
   "start": 110.65,
   "end": 112.19,
   "text": "כשהמשמעות היא כוח עבודה."
  },
  {
   "start": 113.17,
   "end": 114.37,
   "text": "תוספת של כוח עבודה,"
  },
  {
   "start": 114.83,
   "end": 116.93,
   "text": "תוספת של כוח צבאי שהארץ שיבעה לה,"
  },
  {
   "start": 117.49,
   "end": 118.29,
   "text": "תנופה כלכלית."
  },
  {
   "start": 119.99,
   "end": 120.83,
   "text": "הבעיה היחידה הייתה"
  },
  {
   "start": 121.99,
   "end": 125.31,
   "text": "שהעולים שומרים תורה ומצוות ובארץ לא כל כך התלהבו מזה."
  },
  {
   "start": 126.81,
   "end": 129.73,
   "text": "אבל כבר נמצא פתרון לכך,"
  },
  {
   "start": 131.15,
   "end": 131.53,
   "text": "כך הם אמרו,"
  },
  {
   "start": 142.32,
   "end": 142.92,
   "text": "את הפרידה"
  },
  {
   "start": 143.88,
   "end": 147.08,
   "text": "את הפרידה מהאימא,"
  },
  {
   "start": 150.53,
   "end": 151.63,
   "text": "קשה לתאר במילים."
  },
  {
   "start": 152.53,
   "end": 154.87,
   "text": "האימא, האימא המסורה והאהובה,"
  },
  {
   "start": 156.07,
   "end": 161.15,
   "text": "תפסה את הילדים כתופסת את החיים. זה היו הילדים שהיא כל כך השקיעה בהם."
  },
  {
   "start": 164.56,
   "end": 165.44,
   "text": "הדמעות ירדו"
  },
  {
   "start": 166.9,
   "end": 167.5,
   "text": "מעליהם."
  },
  {
   "start": 169.0,
   "end": 169.34,
   "text": "סלם,"
  },
  {
   "start": 170.28,
   "end": 171.56,
   "text": "סלם תשמור על עצמך."
  },
  {
   "start": 172.76,
   "end": 175.48,
   "text": "סלם, אני אבוא אחריכם, אל תדאגו, תשמרו על עצמכם רק."
  },
  {
   "start": 177.58,
   "end": 178.72,
   "text": "אני אתפלל עליכם."
  },
  {
   "start": 178.96,
   "end": 179.86,
   "text": "תשמר על עצמך,"
  },
  {
   "start": 182.49,
   "end": 183.25,
   "text": "אנחנו מבטיחים,"
  },
  {
   "start": 184.43,
   "end": 185.51,
   "text": "אמרו האחים כאחד."
  },
  {
   "start": 188.75,
   "end": 191.31,
   "text": "ואז האימא הוציאה מהתיק שהיא לקחה איתה."
  },
  {
   "start": 192.63,
   "end": 194.99,
   "text": "הוציאה חנוכיית כסף."
  },
  {
   "start": 196.21,
   "end": 197.03,
   "text": "כסף טהור."
  },
  {
   "start": 198.79,
   "end": 200.09,
   "text": "חנוכיית כסף שהיא עשתה."
  },
  {
   "start": 201.35,
   "end": 202.01,
   "text": "מעשה ידיה."
  },
  {
   "start": 203.55,
   "end": 204.59,
   "text": "והיא הגישה לסלם,"
  },
  {
   "start": 207.03,
   "end": 209.25,
   "text": "בנה הבכור, ואמרה לו, קח סלם,"
  },
  {
   "start": 209.97,
   "end": 210.61,
   "text": "זה שלך."
  },
  {
   "start": 212.45,
   "end": 213.89,
   "text": "כל פעם שתדליק תזכור אותי."
  },
  {
   "start": 215.09,
   "end": 216.27,
   "text": "כל פעם שתדליק תזכור את אבא,"
  },
  {
   "start": 217.25,
   "end": 218.37,
   "text": "כל פעם שתדליק"
  },
  {
   "start": 219.31,
   "end": 220.81,
   "text": "תזכור את כל מה שנתנו לך."
  },
  {
   "start": 225.14,
   "end": 225.72,
   "text": "ואחרי זה,"
  },
  {
   "start": 226.5,
   "end": 229.82,
   "text": "היא הסתובבה כלפי יחיא והוציאה חנוכיית כסף"
  },
  {
   "start": 230.54,
   "end": 230.98,
   "text": "עוד אחת."
  },
  {
   "start": 232.22,
   "end": 233.44,
   "text": "עוד אחת מעשה ידיה."
  },
  {
   "start": 234.32,
   "end": 234.82,
   "text": "עוד אחת"
  },
  {
   "start": 235.38,
   "end": 238.42,
   "text": "עוד חנוכייה שיצאה למעשה מהלב שלה."
  },
  {
   "start": 239.96,
   "end": 240.74,
   "text": "ליבה של אימא."
  },
  {
   "start": 242.04,
   "end": 244.06,
   "text": "והיא הגישה את החנוכייה ואמרה ליחיא,"
  },
  {
   "start": 246.88,
   "end": 247.88,
   "text": "אל תשכח אף פעם"
  },
  {
   "start": 248.72,
   "end": 250.44,
   "text": "מי הטב ומאיפה באת."
  },
  {
   "start": 256.97,
   "end": 257.61,
   "text": "יותר מאוחר,"
  },
  {
   "start": 258.49,
   "end": 259.33,
   "text": "ארץ ישראל,"
  },
  {
   "start": 260.91,
   "end": 262.47,
   "text": "סלם ויחי הם מצאו את עצמם"
  },
  {
   "start": 263.99,
   "end": 265.15,
   "text": "במאבק אדיר"
  },
  {
   "start": 266.43,
   "end": 267.25,
   "text": "על אמונתם."
  },
  {
   "start": 267.79,
   "end": 272.23,
   "text": "הם לא דמיינו בחלומות הפרועים שלהם שיכול להיות מצב כזה."
  },
  {
   "start": 279.23,
   "end": 279.83,
   "text": "וכשבאו,"
  },
  {
   "start": 282.76,
   "end": 283.56,
   "text": "כשבאו ולקחו"
  },
  {
   "start": 285.56,
   "end": 286.24,
   "text": "את סלם,"
  },
  {
   "start": 288.26,
   "end": 290.04,
   "text": "בוא תנסה לציון. אם לא, אני מחזיר אותך מיד,"
  },
  {
   "start": 290.04,
   "end": 292.0,
   "text": "אמר המדריך"
  },
  {
   "start": 293.56,
   "end": 300.28,
   "text": "וסאלם האמין שבסך הכל לוקחים אותו לראות מקום שאם ימצא חן בעיניו"
  },
  {
   "start": 301.54,
   "end": 302.96,
   "text": "הוא יוכל לבוא ולהגיד לאחיו"
  },
  {
   "start": 303.84,
   "end": 305.02,
   "text": "יחיא להצטרף אליו"
  },
  {
   "start": 308.26,
   "end": 309.78,
   "text": "וסאלם עלה לרכב"
  },
  {
   "start": 310.86,
   "end": 311.5,
   "text": "והם נסעו"
  },
  {
   "start": 312.8,
   "end": 321.79,
   "text": "וככה יחיא וסאלם שהופרדו נשארו לבד במערכה על האמונה שלהם,"
  },
  {
   "start": 322.17,
   "end": 324.87,
   "text": "על היהדות שלהם ויום רודף יום"
  },
  {
   "start": 325.43,
   "end": 328.05,
   "text": "ויום רודף יום, שנה רדפה שנה,"
  },
  {
   "start": 328.57,
   "end": 329.89,
   "text": "וכור ההיתוך בלע את כולם."
  },
  {
   "start": 339.16,
   "end": 341.76,
   "text": "כור ההיתוך בלע את כולם אל קרבו,"
  },
  {
   "start": 342.36,
   "end": 343.7,
   "text": "ומשאיר בדרך עקבות."
  },
  {
   "start": 345.06,
   "end": 347.04,
   "text": "פאות, כיפה, תורה, שבת,"
  },
  {
   "start": 354.94,
   "end": 355.6,
   "text": "כך עברו להם"
  },
  {
   "start": 356.84,
   "end": 357.88,
   "text": "עשרים וארבע שנים."
  },
  {
   "start": 359.12,
   "end": 360.46,
   "text": "עשרים וארבע שנים אחר כך,"
  },
  {
   "start": 364.96,
   "end": 367.2,
   "text": "מלחמת יום הכיפורים פורצת."
  },
  {
   "start": 370.91,
   "end": 371.85,
   "text": "המלחמה האיומה הזאת."
  },
  {
   "start": 378.01,
   "end": 378.71,
   "text": "עם ישראל,"
  },
  {
   "start": 378.71,
   "end": 382.91,
   "text": "בהשגחה מהשם יתברך בניסי ניסים מצליח"
  },
  {
   "start": 384.13,
   "end": 384.65,
   "text": "מצליח"
  },
  {
   "start": 385.63,
   "end": 387.79,
   "text": "למגר את הצבאות הסורים והמצריים."
  },
  {
   "start": 389.01,
   "end": 396.87,
   "text": "ובדרום שם במדבר סיני השטח המדברי בתום המלחמה, בתום הקרבות מאויש בחטיבת חייר."
  },
  {
   "start": 400.49,
   "end": 401.67,
   "text": "ימי מילואים ארוכים"
  },
  {
   "start": 402.67,
   "end": 406.61,
   "text": "ממתינים לחיילים שם בחולות של מדבר סיני."
  },
  {
   "start": 409.75,
   "end": 410.33,
   "text": "בין האוהלים"
  },
  {
   "start": 411.37,
   "end": 413.61,
   "text": "בין האוהלים של החטיבה בשעת ערב מוקדמת"
  },
  {
   "start": 416.03,
   "end": 417.21,
   "text": "נדלק אור מיוחד,"
  },
  {
   "start": 420.04,
   "end": 421.12,
   "text": "אורה של חנוכיה,"
  },
  {
   "start": 423.82,
   "end": 424.78,
   "text": "חנוכיית כסף."
  },
  {
   "start": 428.37,
   "end": 429.37,
   "text": "חנוכיית כסף"
  },
  {
   "start": 430.21,
   "end": 431.67,
   "text": "שנעשתה על ידי אימא."
  },
  {
   "start": 433.19,
   "end": 434.63,
   "text": "בערה לה בלילה השקט,"
  },
  {
   "start": 437.8,
   "end": 438.08,
   "text": "שם,"
  },
  {
   "start": 439.16,
   "end": 440.72,
   "text": "שם במדבר מול החנוכיה,"
  },
  {
   "start": 441.6,
   "end": 442.38,
   "text": "עמד לו חיים."
  },
  {
   "start": 442.98,
   "end": 444.44,
   "text": "חיים מביט באור המרצד,"
  },
  {
   "start": 445.32,
   "end": 448.28,
   "text": "והאור ככה מקפץ לו ומרצד למול עיניו."
  },
  {
   "start": 449.9,
   "end": 451.22,
   "text": "שעתו הייתה שעת השקט,"
  },
  {
   "start": 452.06,
   "end": 454.68,
   "text": "ואז הציפו אותו הזיכרונות,"
  },
  {
   "start": 457.39,
   "end": 457.87,
   "text": "תימן,"
  },
  {
   "start": 458.53,
   "end": 459.39,
   "text": "אבא, אמא,"
  },
  {
   "start": 462.51,
   "end": 462.99,
   "text": "סאלם,"
  },
  {
   "start": 465.2,
   "end": 465.7,
   "text": "הניתוק,"
  },
  {
   "start": 469.03,
   "end": 470.29,
   "text": "כבר הוא לא יחיה, הוא חיים,"
  },
  {
   "start": 473.18,
   "end": 474.0,
   "text": "כבר יש לו משפחה,"
  },
  {
   "start": 475.2,
   "end": 476.28,
   "text": "והוא כל כך רחוק"
  },
  {
   "start": 479.2,
   "end": 480.36,
   "text": "מאבא שבשמיים."
  },
  {
   "start": 481.58,
   "end": 484.12,
   "text": "ולפתע הוא הרגיש איך צער ממלא את כל ישותו,"
  },
  {
   "start": 485.26,
   "end": 486.9,
   "text": "והוא הרגיש צורך, אני חייב ללכת,"
  },
  {
   "start": 487.46,
   "end": 488.58,
   "text": "להרגיע את הנשמה שלי."
  },
  {
   "start": 489.02,
   "end": 490.84,
   "text": "הוא החל צועד להרגיע את הנשמה שלו,"
  },
  {
   "start": 491.16,
   "end": 492.7,
   "text": "את הנשמה הסוערת שבתוכו."
  },
  {
   "start": 493.5,
   "end": 494.36,
   "text": "והוא הולך והסתובב."
  },
  {
   "start": 506.98,
   "end": 507.76,
   "text": "לפתע הוא נעצר."
  },
  {
   "start": 509.18,
   "end": 509.88,
   "text": "לפתע הוא נעצר."
  },
  {
   "start": 510.82,
   "end": 511.54,
   "text": "זה היה מולו."
  },
  {
   "start": 513.3,
   "end": 517.71,
   "text": "הוא התקדם לא מאמין,"
  },
  {
   "start": 518.35,
   "end": 519.37,
   "text": "כאילו מפחד להגיע,"
  },
  {
   "start": 520.15,
   "end": 522.05,
   "text": "כאילו מפחד ממה שהוא עתיד לגלות עכשיו."
  },
  {
   "start": 525.83,
   "end": 526.07,
   "text": "חיים"
  },
  {
   "start": 527.15,
   "end": 527.53,
   "text": "עמד"
  },
  {
   "start": 528.37,
   "end": 529.65,
   "text": "מול אור מרצד"
  },
  {
   "start": 531.19,
   "end": 532.69,
   "text": "של נרות חנוכה"
  },
  {
   "start": 533.39,
   "end": 536.83,
   "text": "שבהבו מולו מתוך חנוכיית כסף,"
  },
  {
   "start": 538.15,
   "end": 539.49,
   "text": "מתוך חנוכיית כסף"
  },
  {
   "start": 540.25,
   "end": 541.69,
   "text": "שנעשתה על ידי אמא."
  },
  {
   "start": 546.7,
   "end": 548.02,
   "text": "של מי החנוכיה הזאת?"
  },
  {
   "start": 549.24,
   "end": 550.48,
   "text": "הוא קרא בקול משונה."
  },
  {
   "start": 551.32,
   "end": 554.18,
   "text": "אפילו הוא עצמו לא זיהה את הקול שלו. של מי החנוכיה הזאת?"
  },
  {
   "start": 557.26,
   "end": 558.36,
   "text": "זו החנוכיה של שלומי."
  },
  {
   "start": 559.62,
   "end": 559.96,
   "text": "שלומי,"
  },
  {
   "start": 560.7,
   "end": 561.18,
   "text": "מי זה שלומי?"
  },
  {
   "start": 563.38,
   "end": 564.12,
   "text": "תקראו לו לפה."
  },
  {
   "start": 564.82,
   "end": 565.3,
   "text": "מי זה שלומי?"
  },
  {
   "start": 581.84,
   "end": 582.9,
   "text": "שניות אחר כך"
  },
  {
   "start": 583.54,
   "end": 584.8,
   "text": "הם עמדו זה מול זה."
  },
  {
   "start": 588.36,
   "end": 589.0,
   "text": "קראת לי?"
  },
  {
   "start": 590.14,
   "end": 591.0,
   "text": "שאל שלומי."
  },
  {
   "start": 594.42,
   "end": 594.92,
   "text": "חיים."
  },
  {
   "start": 598.74,
   "end": 599.26,
   "text": "חיים הביט."
  },
  {
   "start": 600.06,
   "end": 601.5,
   "text": "מבעד לבלורית,"
  },
  {
   "start": 602.96,
   "end": 604.62,
   "text": "מבעד לשנים שחלפו."
  },
  {
   "start": 608.43,
   "end": 610.91,
   "text": "לשלומי היה קול של בית אבא."
  },
  {
   "start": 617.6,
   "end": 619.7,
   "text": "קול שהזכיר את אמא."
  },
  {
   "start": 623.64,
   "end": 624.2,
   "text": "סלם!"
  },
  {
   "start": 626.12,
   "end": 626.82,
   "text": "סלם!"
  },
  {
   "start": 630.89,
   "end": 633.51,
   "text": "צמרמורת אחזה בגופו של שלומי,"
  },
  {
   "start": 634.83,
   "end": 636.21,
   "text": "או יותר נכון של סלם."
  },
  {
   "start": 637.03,
   "end": 637.33,
   "text": "אחי!"
  },
  {
   "start": 646.04,
   "end": 647.1,
   "text": "אני לא יכול לתאר את המילים,"
  },
  {
   "start": 649.4,
   "end": 652.72,
   "text": "את המילים שזרמו מגרונו של"
  },
  {
   "start": 654.56,
   "end": 654.94,
   "text": "חיים."
  },
  {
   "start": 658.02,
   "end": 658.92,
   "text": "אני לא יכול לתאר את ההתרגשות"
  },
  {
   "start": 659.7,
   "end": 661.22,
   "text": "שנראתה על פניו של שלומי,"
  },
  {
   "start": 661.78,
   "end": 662.42,
   "text": "של סאלם."
  },
  {
   "start": 664.06,
   "end": 666.36,
   "text": "אפילו החיילים הקשוחים ביותר התרגשו."
  },
  {
   "start": 669.75,
   "end": 671.21,
   "text": "סאלם, ראית את אבא מאז?"
  },
  {
   "start": 673.63,
   "end": 674.69,
   "text": "ראית את אמא מאז?"
  },
  {
   "start": 677.06,
   "end": 677.4,
   "text": "לא."
  },
  {
   "start": 679.72,
   "end": 680.96,
   "text": "ושניהם פרצו בבכי."
  },
  {
   "start": 684.12,
   "end": 685.72,
   "text": "שני האחים שגנבו להם את בית אבא,"
  },
  {
   "start": 687.3,
   "end": 688.72,
   "text": "ובאו נרות חנוכה,"
  },
  {
   "start": 689.36,
   "end": 690.84,
   "text": "והחזירו אותם זה לזה."
  },
  {
   "start": 692.48,
   "end": 693.68,
   "text": "אותה חנוכיית כסף"
  },
  {
   "start": 694.8,
   "end": 695.64,
   "text": "שאמא עשתה."
  },
  {
   "start": 696.52,
   "end": 700.22,
   "text": "אני לא יודע אם זה מעשה ידיה או מעשה הלב שלה."
  },
  {
   "start": 702.12,
   "end": 703.6,
   "text": "עברו שנים, שנים אחר כך,"
  },
  {
   "start": 704.5,
   "end": 706.72,
   "text": "יחיא וסלם העמיקו את הקשרים שלהם."
  },
  {
   "start": 707.98,
   "end": 709.54,
   "text": "הם חיפשו את אבא ואימא שלהם"
  },
  {
   "start": 710.4,
   "end": 711.08,
   "text": "ללא הצלחה,"
  },
  {
   "start": 714.12,
   "end": 714.22,
   "text": "אבל,"
  },
  {
   "start": 717.6,
   "end": 718.3,
   "text": "אבל שניהם,"
  },
  {
   "start": 719.14,
   "end": 720.34,
   "text": "שניהם התקרבו ליהדות."
  },
  {
   "start": 721.8,
   "end": 722.14,
   "text": "שניהם,"
  },
  {
   "start": 725.56,
   "end": 728.16,
   "text": "שניהם הצליחו בעזרת המעט,"
  },
  {
   "start": 729.14,
   "end": 730.84,
   "text": "מעט מעשים טובים שלהם."
  },
  {
   "start": 731.74,
   "end": 734.02,
   "text": "בעזרת המעט יהדות שעוד נותרה להם,"
  },
  {
   "start": 735.14,
   "end": 736.7,
   "text": "להפוך את כל הבית שלהם"
  },
  {
   "start": 738.46,
   "end": 739.74,
   "text": "למשכן של תורה."
  },
  {
   "start": 743.08,
   "end": 744.46,
   "text": "הם עשו את כל הדרך הביתה"
  },
  {
   "start": 745.08,
   "end": 746.64,
   "text": "כדי לא לבייש את יוסף צנעני"
  },
  {
   "start": 747.28,
   "end": 754.26,
   "text": "ואת האימא המסורה שבנתה בית יהודי,"
  },
  {
   "start": 757.26,
   "end": 759.5,
   "text": "שאת הלב שלה השקיעה בחנוכיית הכסף"
  },
  {
   "start": 760.28,
   "end": 762.38,
   "text": "ואותה חנוכיית כסף לא אכזבה."
  },
  {
   "start": 764.44,
   "end": 765.76,
   "text": "גם אחרי עשרות שנים"
  },
  {
   "start": 766.52,
   "end": 769.3,
   "text": "היא באה ולקחה את האחים והחזיר אותם."
  },
  {
   "start": 770.06,
   "end": 772.7,
   "text": "החזירה אותם אחד אל זרועות השני."
  }
 ]
}