{
 "disc": "שמשון לוחם יהודי א",
 "track": "Track02",
 "duration": 923.16,
 "segments": [
  {
   "start": 3.79,
   "end": 4.21,
   "text": "ועתה,"
  },
  {
   "start": 27.7,
   "end": 29.22,
   "text": "ועתה נתחיל להיכנס פנימה,"
  },
  {
   "start": 30.44,
   "end": 31.38,
   "text": "אל גיבור יהודי,"
  },
  {
   "start": 33.2,
   "end": 37.88,
   "text": "שידע יותר מכל את מה שאנו זקוקים לו היום יותר מכל,"
  },
  {
   "start": 38.5,
   "end": 41.62,
   "text": "לדעת לקום, להתרומם, להילחם,"
  },
  {
   "start": 41.96,
   "end": 42.78,
   "text": "משיא השפלות,"
  },
  {
   "start": 44.12,
   "end": 45.44,
   "text": "אל אי שם במעלות קדושים."
  },
  {
   "start": 49.8,
   "end": 50.24,
   "text": "המקרה,"
  },
  {
   "start": 51.54,
   "end": 54.02,
   "text": "האירועים התרחשו להם בתקופת השופטים."
  },
  {
   "start": 56.3,
   "end": 57.18,
   "text": "באותה תקופה של"
  },
  {
   "start": 59.14,
   "end": 60.38,
   "text": "אין מלך בישראל,"
  },
  {
   "start": 62.46,
   "end": 63.3,
   "text": "ועם ישראל"
  },
  {
   "start": 65.0,
   "end": 67.04,
   "text": "נע לו בין השנים בארץ ישראל,"
  },
  {
   "start": 69.42,
   "end": 72.32,
   "text": "כאשר יש איזה מעין מידה כנגד מידה."
  },
  {
   "start": 72.9,
   "end": 75.76,
   "text": "כשעם ישראל, עם הקדוש ברוך הוא, הם מצליחים."
  },
  {
   "start": 77.66,
   "end": 82.74,
   "text": "כולם מתרחקים מהם ומצליחים לקיים סדרי חיים תקינים."
  },
  {
   "start": 83.42,
   "end": 85.18,
   "text": "כשעם ישראל מתרחק מהשם,"
  },
  {
   "start": 87.02,
   "end": 89.62,
   "text": "מיד מתחילים פיגועי טרור, מלחמות,"
  },
  {
   "start": 90.2,
   "end": 91.42,
   "text": "מצב חירום כלכלי,"
  },
  {
   "start": 92.98,
   "end": 93.36,
   "text": "בעיות,"
  },
  {
   "start": 95.22,
   "end": 99.06,
   "text": "ועם ישראל נהפך לעם שנשלטים על ידי אומות אחרות."
  },
  {
   "start": 100.86,
   "end": 107.2,
   "text": "כך מוצאים עצמם עם ישראל בארץ ישראל בשנת 2731 לבריאת העולם,"
  },
  {
   "start": 108.32,
   "end": 110.9,
   "text": "תחת שעבוד אחד העמים הקשים,"
  },
  {
   "start": 111.52,
   "end": 115.12,
   "text": "אחד העמים האכזריים ביותר שהיו מאז ומעולם,"
  },
  {
   "start": 115.78,
   "end": 116.5,
   "text": "פלישתים,"
  },
  {
   "start": 117.64,
   "end": 118.52,
   "text": "פלסטים."
  },
  {
   "start": 129.66,
   "end": 130.76,
   "text": "כך ארבעים שנה,"
  },
  {
   "start": 131.64,
   "end": 136.98,
   "text": "ארבעים שנה תחת עול פלישתים שפוגעים בעם ישראל,"
  },
  {
   "start": 137.76,
   "end": 139.5,
   "text": "שהורגים חפים מפשע,"
  },
  {
   "start": 140.14,
   "end": 146.54,
   "text": "שמתעללים בילדים, נשים וזקנים,"
  },
  {
   "start": 149.22,
   "end": 152.46,
   "text": "שעושים בעם ישראל ככל העולם על רוחם."
  },
  {
   "start": 153.72,
   "end": 160.64,
   "text": "ובני ישראל, עם ישראל, נאנקים תחת אכזריות הפלישתים ששולטים בנו,"
  },
  {
   "start": 161.48,
   "end": 162.7,
   "text": "וכל הזמן"
  },
  {
   "start": 164.82,
   "end": 169.1,
   "text": "עם ישראל מתחיל להבין לאט-לאט שהוא צריך להתפלל לישועה."
  },
  {
   "start": 170.46,
   "end": 174.24,
   "text": "מתחיל להתפלל לישועה שבוחר העולם ישלח להם איזה שליח"
  },
  {
   "start": 174.82,
   "end": 177.02,
   "text": "שילחם להם את המלחמה שלהם,"
  },
  {
   "start": 177.74,
   "end": 179.34,
   "text": "שיביע את הכאב שלהם,"
  },
  {
   "start": 179.78,
   "end": 218.46,
   "text": "שירחיק מהם את פלישתים ברחבי נחלת שבט יהודה,"
  },
  {
   "start": 219.98,
   "end": 220.58,
   "text": "בצורעה."
  },
  {
   "start": 222.14,
   "end": 222.6,
   "text": "מתגורר לו"
  },
  {
   "start": 222.6,
   "end": 225.38,
   "text": "הוא יהודי ושמו מנוח,"
  },
  {
   "start": 226.28,
   "end": 226.92,
   "text": "יהודי חשוב,"
  },
  {
   "start": 228.16,
   "end": 228.9,
   "text": "יהודי מכובד,"
  },
  {
   "start": 230.94,
   "end": 233.88,
   "text": "בעל מעשה חסד וטוב לב נודעים."
  },
  {
   "start": 242.16,
   "end": 243.28,
   "text": "תלמיד חכם הוא לא היה,"
  },
  {
   "start": 244.54,
   "end": 248.4,
   "text": "אבל תרומתו לעולם התורה הייתה ניכרת,"
  },
  {
   "start": 250.54,
   "end": 251.34,
   "text": "ובשמיים,"
  },
  {
   "start": 252.14,
   "end": 254.18,
   "text": "בשמיים היה מנוח חשוב כל כך,"
  },
  {
   "start": 255.96,
   "end": 258.38,
   "text": "עד שכאשר בועז,"
  },
  {
   "start": 259.1,
   "end": 260.9,
   "text": "בועז היה אחד ממנהיגי ישראל,"
  },
  {
   "start": 261.74,
   "end": 264.3,
   "text": "בועז היה שופט בעם ישראל."
  },
  {
   "start": 266.08,
   "end": 267.28,
   "text": "בועז עשה סעודה,"
  },
  {
   "start": 268.1,
   "end": 270.08,
   "text": "היו לו שלושים בנות ושלושים בנים."
  },
  {
   "start": 270.8,
   "end": 273.92,
   "text": "וכשהוא עשה סעודה לנישואי שלושים בניו"
  },
  {
   "start": 274.56,
   "end": 275.54,
   "text": "ושלושים בנותיו,"
  },
  {
   "start": 276.34,
   "end": 278.14,
   "text": "הוא הזמין את כל נכבדי ישראל."
  },
  {
   "start": 279.84,
   "end": 281.0,
   "text": "את מנוח הוא לא הזמין,"
  },
  {
   "start": 286.06,
   "end": 289.2,
   "text": "ומתו כל בניו ובנותיו."
  },
  {
   "start": 290.6,
   "end": 291.98,
   "text": "כי מנוח היה חשוב מאוד."
  },
  {
   "start": 293.46,
   "end": 294.84,
   "text": "אולי לא נראה תלמיד חכם,"
  },
  {
   "start": 294.96,
   "end": 295.8,
   "text": "לא תלמיד חכם,"
  },
  {
   "start": 296.46,
   "end": 303.98,
   "text": "אבל מעשיו הטובים עשו רושם בשמיים וגם בארץ."
  },
  {
   "start": 305.68,
   "end": 307.02,
   "text": "מנוח היה משבט דן,"
  },
  {
   "start": 308.54,
   "end": 310.68,
   "text": "אותו שבט דן שחטאו בעבודה זרה,"
  },
  {
   "start": 311.44,
   "end": 316.06,
   "text": "שגרמו על ידי עבודת העבודה הזרה שלהם נזק לכלל ישראל."
  },
  {
   "start": 317.46,
   "end": 318.54,
   "text": "אבל מתוך השבט"
  },
  {
   "start": 319.22,
   "end": 320.26,
   "text": "בלט לו מנוח,"
  },
  {
   "start": 321.1,
   "end": 322.08,
   "text": "לא תלמיד חכם,"
  },
  {
   "start": 322.66,
   "end": 325.26,
   "text": "אבל בעל דרך והשקפה נכונה."
  },
  {
   "start": 326.68,
   "end": 327.1,
   "text": "הוא לא טעה,"
  },
  {
   "start": 327.9,
   "end": 329.22,
   "text": "הוא לא הלך אחרי השבט שלו,"
  },
  {
   "start": 329.98,
   "end": 344.23,
   "text": "הוא הלך אחרי הקדוש ברוך הוא. אשתו של מנוח,"
  },
  {
   "start": 345.17,
   "end": 346.29,
   "text": "קראו לה צללפונית."
  },
  {
   "start": 348.78,
   "end": 349.88,
   "text": "למה קראו לה צללפונית?"
  },
  {
   "start": 351.28,
   "end": 353.42,
   "text": "כי היא הייתה נאצלת מנחווה,"
  },
  {
   "start": 354.36,
   "end": 356.3,
   "text": "מנחווה שהייתה פינת העולם."
  },
  {
   "start": 357.96,
   "end": 360.58,
   "text": "אותה צללפונית הייתה אישה צדקת, יראת שמיים,"
  },
  {
   "start": 363.29,
   "end": 365.21,
   "text": "והם חיו להם בשלווה ובקדושה,"
  },
  {
   "start": 366.15,
   "end": 368.65,
   "text": "אבל היה איזה ענן אחד שמעיב על הבית שלהם."
  },
  {
   "start": 370.43,
   "end": 371.49,
   "text": "לא היה להם ילדים."
  },
  {
   "start": 373.51,
   "end": 374.41,
   "text": "הסביבה הקרובה,"
  },
  {
   "start": 375.19,
   "end": 375.59,
   "text": "משום מה,"
  },
  {
   "start": 376.59,
   "end": 377.93,
   "text": "האשימה דווקא את מנוח,"
  },
  {
   "start": 379.53,
   "end": 381.35,
   "text": "כאילו בגללו אין ילדים,"
  },
  {
   "start": 382.05,
   "end": 383.39,
   "text": "ומנוח היה סובל בדממה,"
  },
  {
   "start": 384.11,
   "end": 387.85,
   "text": "ובלבד שלא להוסיף צער על הצער של אשתו,"
  },
  {
   "start": 388.35,
   "end": 390.01,
   "text": "על הצער של רעייתו האהובה,"
  },
  {
   "start": 400.1,
   "end": 400.62,
   "text": "ויום אחד."
  },
  {
   "start": 401.98,
   "end": 402.7,
   "text": "אצל האלפונית"
  },
  {
   "start": 402.7,
   "end": 405.74,
   "text": "עושה את הדרך הביתה,"
  },
  {
   "start": 409.02,
   "end": 409.3,
   "text": "והנה"
  },
  {
   "start": 410.32,
   "end": 414.28,
   "text": "נראה בפניה אדם עם מראה נורא הוד,"
  },
  {
   "start": 415.46,
   "end": 417.56,
   "text": "ממש כמו מלאך השם."
  },
  {
   "start": 420.05,
   "end": 420.71,
   "text": "והוא אומר לה,"
  },
  {
   "start": 426.98,
   "end": 427.58,
   "text": "את עקרה,"
  },
  {
   "start": 428.9,
   "end": 431.02,
   "text": "לא מנוח בעלה, את,"
  },
  {
   "start": 433.18,
   "end": 435.92,
   "text": "אבל באתי לבשר לך שאת הזכי ללדת בן."
  },
  {
   "start": 437.16,
   "end": 437.32,
   "text": "והיא"
  },
  {
   "start": 438.04,
   "end": 440.14,
   "text": "היא לא יכולה להביט בו, היא רק שומעת."
  },
  {
   "start": 444.29,
   "end": 445.07,
   "text": "ממשיך אותו,"
  },
  {
   "start": 445.99,
   "end": 448.43,
   "text": "אותו איש, או נביא, או מלאך,"
  },
  {
   "start": 449.51,
   "end": 450.13,
   "text": "לומר לה,"
  },
  {
   "start": 450.85,
   "end": 451.69,
   "text": "הבן שיהיה לך"
  },
  {
   "start": 452.49,
   "end": 454.01,
   "text": "יהיה נזיר אלוהים,"
  },
  {
   "start": 458.04,
   "end": 459.14,
   "text": "דווקא נזיר אלוקים,"
  },
  {
   "start": 459.86,
   "end": 460.4,
   "text": "מידת הדין."
  },
  {
   "start": 462.74,
   "end": 464.22,
   "text": "והוא יהיה שליח השם,"
  },
  {
   "start": 464.98,
   "end": 468.08,
   "text": "להיפרע ולהינקם מפלישתים, להטיל בהם פחד."
  },
  {
   "start": 470.22,
   "end": 470.88,
   "text": "אבל את צריכה לדעת,"
  },
  {
   "start": 472.12,
   "end": 473.08,
   "text": "חשוב מאוד שתדעי,"
  },
  {
   "start": 474.54,
   "end": 476.04,
   "text": "הוא יצטרך להיות נזיר השם,"
  },
  {
   "start": 477.0,
   "end": 477.94,
   "text": "להינזר מיין,"
  },
  {
   "start": 478.78,
   "end": 481.2,
   "text": "ומורה לא יעלה על ראשו."
  },
  {
   "start": 483.1,
   "end": 483.88,
   "text": "סכין גילוח?"
  },
  {
   "start": 484.78,
   "end": 487.56,
   "text": "לגלח את השערות שלו בשום פנים ואופן?"
  },
  {
   "start": 489.84,
   "end": 490.72,
   "text": "רק את זה לא."
  },
  {
   "start": 493.66,
   "end": 495.82,
   "text": "ובאתי כאן להגיד לך ולהטרות בפנייך,"
  },
  {
   "start": 496.52,
   "end": 497.28,
   "text": "הילד שלך,"
  },
  {
   "start": 498.24,
   "end": 501.0,
   "text": "זה שייוולד לך אחרי כל כך הרבה שנים שאת מחכה."
  },
  {
   "start": 501.94,
   "end": 504.0,
   "text": "יהיה חייב להיות נזיר מבטן."
  },
  {
   "start": 504.94,
   "end": 507.22,
   "text": "עוד שאת תהיי בהיריון תצטרכי לשמור."
  },
  {
   "start": 507.76,
   "end": 509.48,
   "text": "את עצמך להינזר מיין,"
  },
  {
   "start": 510.06,
   "end": 511.56,
   "text": "מכל דבר של טומאה."
  },
  {
   "start": 513.14,
   "end": 515.0,
   "text": "לשמור את המחשבות שלך,"
  },
  {
   "start": 516.12,
   "end": 516.78,
   "text": "את כל דרכייך,"
  },
  {
   "start": 518.52,
   "end": 520.5,
   "text": "כדי שהילד הזה יצא טהור וקדוש."
  },
  {
   "start": 525.16,
   "end": 527.84,
   "text": "ואז נעלם אותו איש,"
  },
  {
   "start": 528.42,
   "end": 529.16,
   "text": "או אולי מלאך,"
  },
  {
   "start": 530.52,
   "end": 531.34,
   "text": "או אולי אדם רגיל."
  },
  {
   "start": 535.08,
   "end": 535.86,
   "text": "ואצל האלפונית"
  },
  {
   "start": 537.0,
   "end": 537.82,
   "text": "היא רצה הביתה,"
  },
  {
   "start": 538.84,
   "end": 540.32,
   "text": "מספרת בהתרגשות לבעלה,"
  },
  {
   "start": 542.8,
   "end": 545.48,
   "text": "ובמוחה מהדהדים דברי המלאך,"
  },
  {
   "start": 546.26,
   "end": 551.16,
   "text": "והוא יחל להושיע את ישראל מיד פלישתין."
  },
  {
   "start": 551.82,
   "end": 554.6,
   "text": "והוא יחל להושיע את ישראל מיד פלישתין."
  },
  {
   "start": 556.22,
   "end": 558.92,
   "text": "מנוח שואל אותה, תגידי לי, מה השם שלו?"
  },
  {
   "start": 561.2,
   "end": 563.76,
   "text": "הרי שם זה מהות של האדם, מה השם שלו?"
  },
  {
   "start": 565.06,
   "end": 567.68,
   "text": "עונה לו, אני אישי היקר, אני לא שאלתי,"
  },
  {
   "start": 568.18,
   "end": 569.54,
   "text": "אני לא יכלתי אפילו להביט בו."
  },
  {
   "start": 570.1,
   "end": 571.54,
   "text": "לא יכלתי, הייתי חייבת להוריד את העיניים למטה."
  },
  {
   "start": 574.41,
   "end": 574.85,
   "text": "מנוח"
  },
  {
   "start": 576.25,
   "end": 577.59,
   "text": "יודע את מה שעליו לעשות."
  },
  {
   "start": 579.03,
   "end": 580.57,
   "text": "כל כוחו של היהודי בפיו."
  },
  {
   "start": 581.59,
   "end": 583.27,
   "text": "הוא פשוט מתחיל להתפלל אל השם."
  },
  {
   "start": 584.01,
   "end": 586.05,
   "text": "מתחנן בורא עולם, תעשה לי טובה בעולם."
  },
  {
   "start": 586.91,
   "end": 586.93,
   "text": "אם"
  },
  {
   "start": 588.07,
   "end": 590.25,
   "text": "זה באמת מסר ממך יתברך,"
  },
  {
   "start": 590.93,
   "end": 591.99,
   "text": "שיבוא שנית,"
  },
  {
   "start": 592.69,
   "end": 593.59,
   "text": "שידריך אותנו."
  },
  {
   "start": 596.38,
   "end": 600.28,
   "text": "וככה הוא יושב ובוכה לראשי מדבריו בעולם, תעשה טובה בעולם."
  },
  {
   "start": 600.76,
   "end": 602.52,
   "text": "אני זקוק להדרכה, אנחנו זקוקים להדרכה."
  },
  {
   "start": 612.36,
   "end": 613.48,
   "text": "זמן מה אחר כך"
  },
  {
   "start": 614.78,
   "end": 616.1,
   "text": "בוסעת לצלפונית"
  },
  {
   "start": 617.82,
   "end": 618.38,
   "text": "אל ביתה."
  },
  {
   "start": 618.38,
   "end": 620.68,
   "text": "ממול היה כרם."
  },
  {
   "start": 622.26,
   "end": 622.88,
   "text": "היא התרחקה,"
  },
  {
   "start": 626.65,
   "end": 628.01,
   "text": "היא כבר התחילה להיזהר,"
  },
  {
   "start": 628.73,
   "end": 629.19,
   "text": "זהירות ביין,"
  },
  {
   "start": 630.35,
   "end": 631.15,
   "text": "גם מענבים."
  },
  {
   "start": 632.71,
   "end": 634.79,
   "text": "גם מכרם הענבים אני לא אכנס לשם,"
  },
  {
   "start": 636.11,
   "end": 637.21,
   "text": "כי אולי כבר עכשיו"
  },
  {
   "start": 638.63,
   "end": 639.65,
   "text": "אני צריכה להיזהר,"
  },
  {
   "start": 641.84,
   "end": 643.74,
   "text": "כי הילד שיהיה לי יהיה נזיר מבטן,"
  },
  {
   "start": 644.66,
   "end": 648.18,
   "text": "אז היא עוקפת את הכרם ועוברת דרך השדה."
  },
  {
   "start": 654.39,
   "end": 654.83,
   "text": "ושוב,"
  },
  {
   "start": 655.57,
   "end": 656.55,
   "text": "ושוב הוא לפניה."
  },
  {
   "start": 658.41,
   "end": 659.15,
   "text": "אותו איש,"
  },
  {
   "start": 661.48,
   "end": 662.32,
   "text": "נביא אולי,"
  },
  {
   "start": 663.52,
   "end": 664.98,
   "text": "אולי מלאך לפניה."
  },
  {
   "start": 666.24,
   "end": 668.32,
   "text": "היא לא ימתינה הרבה, היא מיירה הביתה"
  },
  {
   "start": 668.94,
   "end": 669.54,
   "text": "אל מנוח,"
  },
  {
   "start": 670.36,
   "end": 672.76,
   "text": "אל בעלה, בוא איתי, בוא אל השדה."
  },
  {
   "start": 673.44,
   "end": 676.02,
   "text": "ומנוח ממהר בעקבות אשתו, אל השדה."
  },
  {
   "start": 678.16,
   "end": 679.12,
   "text": "שם הוא נעצר,"
  },
  {
   "start": 680.46,
   "end": 680.92,
   "text": "מביט"
  },
  {
   "start": 681.66,
   "end": 682.58,
   "text": "כלא מאמין"
  },
  {
   "start": 683.78,
   "end": 686.36,
   "text": "באותו איש נורא הוד שלפניו."
  },
  {
   "start": 689.86,
   "end": 690.0,
   "text": "ו..."
  },
  {
   "start": 690.68,
   "end": 691.86,
   "text": "והוא שוב מזהיר אותם,"
  },
  {
   "start": 692.78,
   "end": 698.18,
   "text": "כמו שהוא אמר לצלפונית אותו דבר אומר למנוח ורעייתו"
  },
  {
   "start": 700.06,
   "end": 702.92,
   "text": "אני מזהיר אתכם, תשמרו על קדושת הילד,"
  },
  {
   "start": 703.54,
   "end": 707.36,
   "text": "הוא יהיה נזיר אלוקי מבטן והוא יחל להושיע את ישראל."
  },
  {
   "start": 723.56,
   "end": 723.88,
   "text": "מנוח,"
  },
  {
   "start": 729.92,
   "end": 730.26,
   "text": "מנוח,"
  },
  {
   "start": 731.24,
   "end": 732.9,
   "text": "מנוח משוכנע שלפניו נביא,"
  },
  {
   "start": 733.82,
   "end": 735.86,
   "text": "אז הוא מזמין אותו, בוא אליי לסעודה,"
  },
  {
   "start": 736.48,
   "end": 738.0,
   "text": "אני רוצה לעשות סעודה לכבודך."
  },
  {
   "start": 739.9,
   "end": 740.84,
   "text": "אומר לו המלאך,"
  },
  {
   "start": 741.82,
   "end": 745.64,
   "text": "אם תעצרני לא אוכל בלחמך."
  },
  {
   "start": 747.44,
   "end": 748.88,
   "text": "ואם תעשה עולה"
  },
  {
   "start": 750.3,
   "end": 751.72,
   "text": "לשם תעלמה."
  },
  {
   "start": 753.06,
   "end": 755.76,
   "text": "אמר לו המלאך, למה אתה רוצה לארח אותי? למה?"
  },
  {
   "start": 757.6,
   "end": 760.96,
   "text": "כי אתה יודע שאמרו חז״ל הקדושים כולה מארח תלמיד חכם,"
  },
  {
   "start": 762.06,
   "end": 764.6,
   "text": "כאילו הקריב קורבן תמיד בבית המקדש."
  },
  {
   "start": 765.68,
   "end": 766.22,
   "text": "אם כך,"
  },
  {
   "start": 767.54,
   "end": 769.8,
   "text": "תעלה עולה לשם במקום הזה."
  },
  {
   "start": 769.96,
   "end": 772.18,
   "text": "תעלה אתה קורבן, תשים קורבן עכשיו."
  },
  {
   "start": 772.64,
   "end": 775.38,
   "text": "תקריב קורבן לכבוד השם, אתה בעצמך עולה לשם."
  },
  {
   "start": 778.63,
   "end": 779.33,
   "text": "מנוח אומר לו,"
  },
  {
   "start": 780.07,
   "end": 781.63,
   "text": "טוב, אז לפחות תאמר לי מה השם שלך."
  },
  {
   "start": 784.04,
   "end": 786.3,
   "text": "מה השם שלך? שם זה מהות, מהות של האדם."
  },
  {
   "start": 787.54,
   "end": 788.8,
   "text": "אומר לו המלאך, תגיד לי,"
  },
  {
   "start": 789.64,
   "end": 790.86,
   "text": "למה זה תשאל לשמי?"
  },
  {
   "start": 791.72,
   "end": 792.12,
   "text": "והוא,"
  },
  {
   "start": 793.36,
   "end": 794.34,
   "text": "פה לי, פה לי."
  },
  {
   "start": 797.83,
   "end": 799.43,
   "text": "אתם יודעים למה הוא אמר לו והוא פה לי?"
  },
  {
   "start": 800.09,
   "end": 801.29,
   "text": "רמז לו המלאך."
  },
  {
   "start": 803.11,
   "end": 806.01,
   "text": "כי הרי מלאך, צריך לדעת מלאך בשמיים,"
  },
  {
   "start": 806.57,
   "end": 808.55,
   "text": "נקרא השם שלו על שם השליחות שלו."
  },
  {
   "start": 811.51,
   "end": 813.45,
   "text": "כל מלאך משתנה בהתאם לשליחות שלו."
  },
  {
   "start": 816.62,
   "end": 817.9,
   "text": "ובתורה הקדושה,"
  },
  {
   "start": 818.42,
   "end": 823.04,
   "text": "בפרשת נזיר כתוב, איש כי יפלי לנדור נדר נזיר."
  },
  {
   "start": 824.58,
   "end": 829.8,
   "text": "רמז לו המלאך, אני נקרא על שם השליחות שלי, אני מלאך, לא נביא, לא איש, מלאך."
  },
  {
   "start": 830.68,
   "end": 832.1,
   "text": "ונקרא על שם השליחות שלי."
  },
  {
   "start": 832.7,
   "end": 834.48,
   "text": "באתי להגיד לך שיהיה לך בן נזיר,"
  },
  {
   "start": 835.24,
   "end": 837.24,
   "text": "כי יפלי, בגלל זה פלי אני נקרא."
  },
  {
   "start": 838.42,
   "end": 838.76,
   "text": "לא רק זה,"
  },
  {
   "start": 839.6,
   "end": 841.32,
   "text": "אלא אומר הארי הקדוש,"
  },
  {
   "start": 841.86,
   "end": 843.58,
   "text": "מגלה לנו הארי הקדוש,"
  },
  {
   "start": 844.88,
   "end": 849.1,
   "text": "שהשם שפוקד את העקרות זה פ״א,"
  },
  {
   "start": 851.36,
   "end": 852.96,
   "text": "מלאך שקוראים לו פ״א,"
  },
  {
   "start": 859.05,
   "end": 860.89,
   "text": "ולכן הוא בא גם לפקוד,"
  },
  {
   "start": 862.35,
   "end": 864.19,
   "text": "לברך את סללפונית"
  },
  {
   "start": 866.3,
   "end": 869.42,
   "text": "שמעקרה תוכל להוליד ילדים."
  },
  {
   "start": 871.89,
   "end": 873.31,
   "text": "וחוץ מזה אומר לו המלאך,"
  },
  {
   "start": 874.65,
   "end": 875.15,
   "text": "מנוח,"
  },
  {
   "start": 876.21,
   "end": 879.81,
   "text": "אל תעסיק את עצמך בנסתר ממך ובמופלא ממך."
  },
  {
   "start": 880.61,
   "end": 881.43,
   "text": "תישאר תמים"
  },
  {
   "start": 882.57,
   "end": 883.29,
   "text": "כפי שאתה."
  }
 ]
}