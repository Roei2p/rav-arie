{
 "disc": "שמשון לוחם יהודי א",
 "track": "Track01",
 "duration": 1122.192,
 "segments": [
  {
   "start": 4.16,
   "end": 5.16,
   "text": "המקרה שלפנינו"
  },
  {
   "start": 7.41,
   "end": 10.71,
   "text": "זה מקרה שלמעשה עדיין לא נגמר."
  },
  {
   "start": 13.33,
   "end": 15.97,
   "text": "אם כן, תשאלו מדוע בחרנו בו."
  },
  {
   "start": 18.43,
   "end": 18.95,
   "text": "כי היום,"
  },
  {
   "start": 20.11,
   "end": 21.63,
   "text": "היום בעת המלחמה הגדולה,"
  },
  {
   "start": 22.83,
   "end": 24.05,
   "text": "מלחמת היצרים,"
  },
  {
   "start": 24.85,
   "end": 26.05,
   "text": "מלחמת אור בחושך,"
  },
  {
   "start": 26.93,
   "end": 28.41,
   "text": "מעטים מול רבים,"
  },
  {
   "start": 30.94,
   "end": 33.06,
   "text": "המעט אור שבתוך האדם,"
  },
  {
   "start": 34.02,
   "end": 36.46,
   "text": "מול הרבה הרבה נפילות וקשיים."
  },
  {
   "start": 36.46,
   "end": 42.8,
   "text": "אנחנו צריכים אולי היום יותר מתמיד לשאוב מהמקרה הזה כוחות,"
  },
  {
   "start": 43.46,
   "end": 45.24,
   "text": "כוחות להמשך המלחמה עד הסוף."
  },
  {
   "start": 46.28,
   "end": 50.2,
   "text": "כי להילחם זה התפקיד של היהודי,"
  },
  {
   "start": 50.8,
   "end": 52.02,
   "text": "זה התפקיד של היהודייה."
  },
  {
   "start": 52.94,
   "end": 54.38,
   "text": "וזה התפקיד שלנו היום,"
  },
  {
   "start": 55.44,
   "end": 60.18,
   "text": "וזה יהיה התפקיד של היהודי-יהודייה עד כלות הנשימה, להילחם."
  },
  {
   "start": 61.26,
   "end": 64.9,
   "text": "אז היום נפרוס בפניכם את אחד מהאירועים שנכתבו בתנ״ך."
  },
  {
   "start": 66.64,
   "end": 69.74,
   "text": "את אחד מהאירועים שנכתבו בתנ״ך לנצח,"
  },
  {
   "start": 70.5,
   "end": 72.3,
   "text": "על מנת שיבואו דורות אחרים,"
  },
  {
   "start": 72.78,
   "end": 73.92,
   "text": "דורות כמו שלנו,"
  },
  {
   "start": 74.28,
   "end": 75.16,
   "text": "וישאבו כוחות,"
  },
  {
   "start": 75.7,
   "end": 77.8,
   "text": "וידעו ללמוד מהצלחות,"
  },
  {
   "start": 79.48,
   "end": 81.64,
   "text": "וגם ללמוד מטעויות."
  },
  {
   "start": 83.44,
   "end": 83.78,
   "text": "היום,"
  },
  {
   "start": 84.6,
   "end": 85.8,
   "text": "בחסדי השם יתברך,"
  },
  {
   "start": 87.42,
   "end": 90.36,
   "text": "ברצות השם דרכי איש, גם אויביו ישלימו."
  },
  {
   "start": 91.9,
   "end": 93.06,
   "text": "רק בחסדי השם יתברך,"
  },
  {
   "start": 94.3,
   "end": 95.42,
   "text": "ולכבוד השם יתברך,"
  },
  {
   "start": 95.98,
   "end": 97.22,
   "text": "היום נעסוק באדם,"
  },
  {
   "start": 98.16,
   "end": 98.82,
   "text": "אדם מיוחד,"
  },
  {
   "start": 99.48,
   "end": 103.18,
   "text": "אדם שעל כתפיו הרחבות הוטל תפקיד רם ונישא,"
  },
  {
   "start": 104.1,
   "end": 104.94,
   "text": "ובד בבד"
  },
  {
   "start": 105.84,
   "end": 109.94,
   "text": "ניתנו בו יצרים חזקים, יצרים סוערים,"
  },
  {
   "start": 110.7,
   "end": 113.5,
   "text": "על מנת שיוכל לתקן נשמות גבוהות מן העבר,"
  },
  {
   "start": 114.38,
   "end": 117.36,
   "text": "ועם כל אלו יצא היהודי למלחמה."
  },
  {
   "start": 119.3,
   "end": 121.0,
   "text": "ואתם יודעים מה הוא עשה?"
  },
  {
   "start": 121.68,
   "end": 122.1,
   "text": "הוא פשוט נלחם,"
  },
  {
   "start": 123.52,
   "end": 124.24,
   "text": "ונלחם,"
  },
  {
   "start": 125.08,
   "end": 125.74,
   "text": "ונלחם,"
  },
  {
   "start": 126.8,
   "end": 127.82,
   "text": "עד הרגע האחרון,"
  },
  {
   "start": 129.18,
   "end": 129.96,
   "text": "וגם יותר,"
  },
  {
   "start": 131.82,
   "end": 132.92,
   "text": "ואף יותר."
  },
  {
   "start": 135.1,
   "end": 137.58,
   "text": "וככה גם אנחנו היום, כולנו באנו לתקן."
  },
  {
   "start": 139.91,
   "end": 141.27,
   "text": "כולנו בדור שלנו,"
  },
  {
   "start": 142.11,
   "end": 142.75,
   "text": "נשמות"
  },
  {
   "start": 143.53,
   "end": 144.55,
   "text": "מגלגולים קודמים,"
  },
  {
   "start": 145.81,
   "end": 148.43,
   "text": "שאולי בהזדמנות, אולי כמעט אחרונה,"
  },
  {
   "start": 148.95,
   "end": 150.17,
   "text": "צריכים להצליח,"
  },
  {
   "start": 150.99,
   "end": 152.73,
   "text": "להילחם ולהילחם."
  },
  {
   "start": 158.43,
   "end": 159.57,
   "text": "אז בואו נתחיל מההתחלה,"
  },
  {
   "start": 160.59,
   "end": 162.07,
   "text": "אבל ממש מההתחלה,"
  },
  {
   "start": 162.47,
   "end": 165.05,
   "text": "בהתחלה לא נראה הכל מובן אולי,"
  },
  {
   "start": 165.87,
   "end": 167.99,
   "text": "אבל אט אט הכל הסתדר,"
  },
  {
   "start": 168.59,
   "end": 174.25,
   "text": "כמו באיזה פאזל מדהים מבית היוצר של מלך מלכי המלכים הקדוש ברוך הוא."
  },
  {
   "start": 176.15,
   "end": 178.69,
   "text": "בואו נתחיל בחסדי השם יתברך."
  },
  {
   "start": 185.94,
   "end": 191.43,
   "text": "אחד מן המלכים הקדמונים קראו לו לוטן."
  },
  {
   "start": 194.21,
   "end": 196.15,
   "text": "ללוטן הייתה אחות,"
  },
  {
   "start": 197.61,
   "end": 198.43,
   "text": "בת מלכים."
  },
  {
   "start": 200.79,
   "end": 202.39,
   "text": "בת מלכים ושמה תמנע."
  },
  {
   "start": 203.17,
   "end": 205.03,
   "text": "תמנע אחות לוטן."
  },
  {
   "start": 206.67,
   "end": 209.43,
   "text": "אותה תמנע הייתה עם שאיפות רוחניות גדולות."
  },
  {
   "start": 212.08,
   "end": 212.98,
   "text": "היא הייתה אישה מיוחדת,"
  },
  {
   "start": 214.02,
   "end": 215.86,
   "text": "למרות שהיא הייתה נסיכה עם הרבה כסף,"
  },
  {
   "start": 216.68,
   "end": 217.8,
   "text": "נסיכה עם יופי"
  },
  {
   "start": 218.7,
   "end": 220.24,
   "text": "ועם הרבה הרבה חומרניות."
  },
  {
   "start": 221.92,
   "end": 223.02,
   "text": "היא מואסת בכל אלו,"
  },
  {
   "start": 224.28,
   "end": 225.58,
   "text": "והיא רוצה להצטרף"
  },
  {
   "start": 226.26,
   "end": 227.2,
   "text": "אל האומה העברית,"
  },
  {
   "start": 228.22,
   "end": 229.16,
   "text": "לעם ישראל."
  },
  {
   "start": 231.62,
   "end": 234.36,
   "text": "תמנע רצתה להתגייר."
  },
  {
   "start": 234.36,
   "end": 236.88,
   "text": "גיור אמיתי."
  },
  {
   "start": 239.12,
   "end": 241.38,
   "text": "לשם כך היא פנתה לאברהם,"
  },
  {
   "start": 242.12,
   "end": 242.72,
   "text": "עמוד החסד,"
  },
  {
   "start": 243.7,
   "end": 244.36,
   "text": "אותו יהודי,"
  },
  {
   "start": 245.94,
   "end": 246.96,
   "text": "אברהם העברי,"
  },
  {
   "start": 250.82,
   "end": 253.88,
   "text": "שעושה נפשות בכל העולם,"
  },
  {
   "start": 254.64,
   "end": 255.64,
   "text": "לכבוד השם יתברך."
  },
  {
   "start": 257.92,
   "end": 258.94,
   "text": "היא פונה לאברהם,"
  },
  {
   "start": 259.46,
   "end": 260.0,
   "text": "ואברהם,"
  },
  {
   "start": 260.66,
   "end": 263.6,
   "text": "זה אברהם שהסתובב בכל העולם"
  },
  {
   "start": 264.28,
   "end": 265.22,
   "text": "לגייר אנשים,"
  },
  {
   "start": 266.22,
   "end": 269.38,
   "text": "שמסר נפש כדי לקרב נשמות"
  },
  {
   "start": 270.78,
   "end": 272.06,
   "text": "לאביהם שבשמיים,"
  },
  {
   "start": 273.14,
   "end": 275.58,
   "text": "מסרב לקבל אותה."
  },
  {
   "start": 276.32,
   "end": 277.02,
   "text": "את לא,"
  },
  {
   "start": 278.4,
   "end": 279.16,
   "text": "אותך לא."
  },
  {
   "start": 281.85,
   "end": 282.51,
   "text": "לא מובן."
  },
  {
   "start": 287.23,
   "end": 288.51,
   "text": "אתם יודעים מה יותר לא מובן?"
  },
  {
   "start": 289.75,
   "end": 292.25,
   "text": "איך תמנע לא מתייאשת."
  },
  {
   "start": 295.58,
   "end": 297.18,
   "text": "היא ממתינה בסבלנות."
  },
  {
   "start": 318.61,
   "end": 319.85,
   "text": "תמנע לא מתייאשת."
  },
  {
   "start": 320.55,
   "end": 322.11,
   "text": "היא ממתינה בסבלנות"
  },
  {
   "start": 324.87,
   "end": 327.29,
   "text": "לאבי האומה השני, ליצחק,"
  },
  {
   "start": 327.97,
   "end": 328.75,
   "text": "עמוד התפילה,"
  },
  {
   "start": 329.97,
   "end": 330.93,
   "text": "והיא באה לפניו"
  },
  {
   "start": 332.29,
   "end": 337.13,
   "text": "ומבקשת אני רוצה להצטרף לעם הקודש, לעם ישראל,"
  },
  {
   "start": 338.31,
   "end": 338.99,
   "text": "ויצחק"
  },
  {
   "start": 339.63,
   "end": 341.75,
   "text": "לא מוכן לקבל אותה."
  },
  {
   "start": 349.37,
   "end": 351.73,
   "text": "אבל יצחק, למה אתה לא מקבל אותה? היא כל כך רוצה."
  },
  {
   "start": 352.41,
   "end": 352.91,
   "text": "תן לה סיכוי."
  },
  {
   "start": 354.49,
   "end": 355.79,
   "text": "מה פתאום אתם מונעים ממנה?"
  },
  {
   "start": 356.15,
   "end": 357.39,
   "text": "אברהם, יצחק."
  },
  {
   "start": 362.07,
   "end": 362.43,
   "text": "פלא,"
  },
  {
   "start": 363.85,
   "end": 364.51,
   "text": "פשוט פלא."
  },
  {
   "start": 365.69,
   "end": 366.69,
   "text": "והפלא היותר גדול,"
  },
  {
   "start": 367.45,
   "end": 369.55,
   "text": "שאותה תמנע לא מוותרת."
  },
  {
   "start": 371.94,
   "end": 375.36,
   "text": "היא באה גם לפני יעקב, עמוד התורה."
  },
  {
   "start": 377.24,
   "end": 381.68,
   "text": "והיא רוצה ומתחננת, אני רוצה להצטרף לעם ישראל."
  },
  {
   "start": 382.78,
   "end": 383.82,
   "text": "אני רוצה להינשא ליהודי,"
  },
  {
   "start": 388.93,
   "end": 390.19,
   "text": "לגדולי ישראל."
  },
  {
   "start": 392.17,
   "end": 393.11,
   "text": "וגם יעקב,"
  },
  {
   "start": 394.05,
   "end": 394.85,
   "text": "עמוד התורה,"
  },
  {
   "start": 395.47,
   "end": 400.3,
   "text": "מסרב לקבל אותה לעם ישראל בפלאות."
  },
  {
   "start": 401.26,
   "end": 420.74,
   "text": "לא מובן מה אותה תימנע, אמרה."
  },
  {
   "start": 421.94,
   "end": 422.86,
   "text": "יותר נכון, מה היא עשתה?"
  },
  {
   "start": 423.78,
   "end": 424.1,
   "text": "היא לא התייאשה."
  },
  {
   "start": 425.4,
   "end": 426.46,
   "text": "היא לא הטיחה דברים."
  },
  {
   "start": 427.58,
   "end": 429.08,
   "text": "היא אמרה, מוטב"
  },
  {
   "start": 430.04,
   "end": 431.76,
   "text": "שאני אהיה שפחה"
  },
  {
   "start": 432.5,
   "end": 433.48,
   "text": "לאומה העברית,"
  },
  {
   "start": 435.36,
   "end": 437.1,
   "text": "לבדים של השם יתברך,"
  },
  {
   "start": 437.8,
   "end": 442.22,
   "text": "ולא אהיה גבירה, נסיכה, מלכה באומה אחרת."
  },
  {
   "start": 443.2,
   "end": 443.78,
   "text": "והיא הולכת"
  },
  {
   "start": 444.5,
   "end": 445.98,
   "text": "ונהיית פילגש,"
  },
  {
   "start": 446.3,
   "end": 448.68,
   "text": "לאליפז בן עשיו,"
  },
  {
   "start": 449.68,
   "end": 450.68,
   "text": "נכד של יצחק."
  },
  {
   "start": 451.38,
   "end": 452.54,
   "text": "לפחות אני אזכה להיות"
  },
  {
   "start": 454.08,
   "end": 454.88,
   "text": "מחוברת"
  },
  {
   "start": 455.66,
   "end": 456.92,
   "text": "לנכד של יצחק"
  },
  {
   "start": 457.9,
   "end": 458.74,
   "text": "דרך עשיו."
  },
  {
   "start": 467.33,
   "end": 470.45,
   "text": "איך ייתכן שהאבות הקדושים לא קיבלו אותה?"
  },
  {
   "start": 476.27,
   "end": 485.87,
   "text": "הם הכל כך אכזרים הרי? כל המטרה, האבות הקדושים כל כך רצו לקרב את כל הבריות, את כל בני האדם בעולם אל השם יתברך, שכולם יצטופפו בצל השם."
  },
  {
   "start": 486.59,
   "end": 487.43,
   "text": "למה אותה לא?"
  },
  {
   "start": 488.03,
   "end": 488.53,
   "text": "צריך לדעת."
  },
  {
   "start": 489.31,
   "end": 496.09,
   "text": "צריך לדעת כי ברוח קודשם ראו שטוב ממנה לא יצא לעם ישראל."
  },
  {
   "start": 497.07,
   "end": 499.43,
   "text": "שאפילו שחיצונית נראה שהיא רוצה יהדות,"
  },
  {
   "start": 499.79,
   "end": 500.59,
   "text": "היא רוצה צניעות,"
  },
  {
   "start": 500.95,
   "end": 501.63,
   "text": "היא רוצה טהרה,"
  },
  {
   "start": 502.29,
   "end": 503.25,
   "text": "אבל הפנימיות,"
  },
  {
   "start": 504.43,
   "end": 504.99,
   "text": "הפנימיות,"
  },
  {
   "start": 508.4,
   "end": 508.98,
   "text": "כך הם חשבו,"
  },
  {
   "start": 509.7,
   "end": 510.6,
   "text": "כך הם ראו ברוח קודשם."
  },
  {
   "start": 512.22,
   "end": 513.8,
   "text": "אבל בכל אופן בשמיים,"
  },
  {
   "start": 514.64,
   "end": 516.46,
   "text": "בשמיים היה צער גדול."
  },
  {
   "start": 517.24,
   "end": 518.86,
   "text": "בכל אופן הייתם צריכים לקבל אותה."
  },
  {
   "start": 519.66,
   "end": 521.14,
   "text": "לא הייתם צריכים לעשות חשבונות,"
  },
  {
   "start": 521.3,
   "end": 524.76,
   "text": "לא להרחיק אותה כל כך, לא להרחיק אותה כל כך."
  },
  {
   "start": 525.48,
   "end": 531.94,
   "text": "לכן מהשידוך הזה תמנע עם אליפאז הבן של עשו נולד ילד."
  },
  {
   "start": 533.4,
   "end": 534.34,
   "text": "נולד יצור,"
  },
  {
   "start": 534.94,
   "end": 535.34,
   "text": "עמלק,"
  },
  {
   "start": 536.58,
   "end": 539.86,
   "text": "שכולו קרירות ותפקידו לקרר את היהודי,"
  },
  {
   "start": 540.2,
   "end": 541.44,
   "text": "את היהודייה בעבודת השם."
  },
  {
   "start": 546.24,
   "end": 546.84,
   "text": "ומה אם תמנע?"
  },
  {
   "start": 548.24,
   "end": 552.94,
   "text": "האם תינתן לה הזדמנות להצטרף לעם ישראל ממש?"
  },
  {
   "start": 553.48,
   "end": 557.06,
   "text": "לממש את שאיפותיה שנראות אולי כל כך טוב כלפי חוץ,"
  },
  {
   "start": 557.7,
   "end": 563.06,
   "text": "ורק לעיניהם הרואות למרחוק של האבות הקדושים נראה הכל אחרת?"
  },
  {
   "start": 564.26,
   "end": 565.98,
   "text": "האם בכל אופן ייתנו לה איזה סיכוי?"
  },
  {
   "start": 567.02,
   "end": 569.84,
   "text": "הרי בדרך שאדם רוצה ללך, מוליכים אותו."
  },
  {
   "start": 570.42,
   "end": 572.16,
   "text": "כשאדם רוצה ללכת בדרך הטוב,"
  },
  {
   "start": 572.68,
   "end": 573.82,
   "text": "נותנים לו ללכת בדרך הטוב."
  },
  {
   "start": 574.2,
   "end": 575.94,
   "text": "כשאדם רוצה ללכת בדרך הפחות טובה,"
  },
  {
   "start": 576.76,
   "end": 577.56,
   "text": "גם שם נותנים לו."
  },
  {
   "start": 580.06,
   "end": 581.04,
   "text": "האם ייתנו לה סיכוי?"
  },
  {
   "start": 582.08,
   "end": 583.04,
   "text": "את זה נראה בהמשך."
  },
  {
   "start": 585.3,
   "end": 586.12,
   "text": "את זה נראה בהמשך."
  },
  {
   "start": 588.16,
   "end": 591.52,
   "text": "בואו נעבור מכאן לעוד הקדמה הכרחית נוספת,"
  },
  {
   "start": 592.22,
   "end": 594.16,
   "text": "לפני שאנחנו מתחילים בעזרת השם"
  },
  {
   "start": 597.87,
   "end": 598.23,
   "text": "בנושא שלנו."
  },
  {
   "start": 603.39,
   "end": 604.59,
   "text": "לכל השבטים הקדושים"
  },
  {
   "start": 606.03,
   "end": 606.75,
   "text": "יש ילדים."
  },
  {
   "start": 608.81,
   "end": 610.01,
   "text": "למעט שבט אחד,"
  },
  {
   "start": 611.37,
   "end": 613.69,
   "text": "שלשבט הזה היה בן אחד."
  },
  {
   "start": 615.84,
   "end": 616.92,
   "text": "זה היה שבט דן."
  },
  {
   "start": 617.74,
   "end": 620.4,
   "text": "לדן היה בן אחד."
  },
  {
   "start": 621.24,
   "end": 622.72,
   "text": "שמו היה חושים,"
  },
  {
   "start": 623.72,
   "end": 625.18,
   "text": "חושים היה כבד שמיעה,"
  },
  {
   "start": 625.78,
   "end": 626.24,
   "text": "חושים"
  },
  {
   "start": 626.88,
   "end": 627.54,
   "text": "לא שמע."
  },
  {
   "start": 631.63,
   "end": 634.09,
   "text": "את חושים חנן הקדוש ברוך הוא בכוח רב,"
  },
  {
   "start": 634.97,
   "end": 636.55,
   "text": "ובהרבה הרבה אמונה פשוטה."
  },
  {
   "start": 638.35,
   "end": 639.21,
   "text": "והנה מגיע יום,"
  },
  {
   "start": 639.87,
   "end": 640.79,
   "text": "יום של צער,"
  },
  {
   "start": 641.47,
   "end": 642.79,
   "text": "אבל כבד בכל העולם."
  },
  {
   "start": 643.51,
   "end": 644.11,
   "text": "יעקב,"
  },
  {
   "start": 644.77,
   "end": 645.97,
   "text": "יעקב אבינו נפטר."
  },
  {
   "start": 654.78,
   "end": 656.7,
   "text": "ויעל יוסף לקבור את אביו,"
  },
  {
   "start": 657.4,
   "end": 660.48,
   "text": "ויעלו איתו עבדי פרעה וכל בית יוסף."
  },
  {
   "start": 661.86,
   "end": 662.34,
   "text": "ואחיו,"
  },
  {
   "start": 663.58,
   "end": 664.2,
   "text": "וכולם עולים"
  },
  {
   "start": 664.74,
   "end": 665.8,
   "text": "לארץ כנען"
  },
  {
   "start": 666.36,
   "end": 669.04,
   "text": "לקבור את יעקב במערת המכפלה."
  },
  {
   "start": 673.14,
   "end": 673.62,
   "text": "בכנען"
  },
  {
   "start": 674.76,
   "end": 676.54,
   "text": "כולם מכבדים את בני ישראל."
  },
  {
   "start": 677.96,
   "end": 684.0,
   "text": "לעיני המצרים המשתאים לא ידעו יעקב."
  },
  {
   "start": 685.96,
   "end": 687.72,
   "text": "ובני ישראל חשובים כל כך,"
  },
  {
   "start": 690.71,
   "end": 691.11,
   "text": "אבל אז"
  },
  {
   "start": 692.09,
   "end": 696.63,
   "text": "אל אזור מערת המכפלה מגיעים בני עשיו"
  },
  {
   "start": 696.63,
   "end": 698.99,
   "text": "וגם בני ישמעאל,"
  },
  {
   "start": 700.33,
   "end": 700.95,
   "text": "ובנוסף"
  },
  {
   "start": 701.63,
   "end": 702.47,
   "text": "גם בני קטורה,"
  },
  {
   "start": 704.01,
   "end": 704.81,
   "text": "וכולם באים"
  },
  {
   "start": 708.17,
   "end": 708.87,
   "text": "להילחם"
  },
  {
   "start": 711.06,
   "end": 715.12,
   "text": "כדי למנוע מיעקב להיקבר במערה, במערת המכפלה."
  },
  {
   "start": 718.93,
   "end": 720.05,
   "text": "אבל אז ברגע שהם באו,"
  },
  {
   "start": 720.83,
   "end": 724.41,
   "text": "והם רואים על הארון של יעקב את הכתר של יוסף,"
  },
  {
   "start": 725.33,
   "end": 726.51,
   "text": "יוסף מושל מצרים,"
  },
  {
   "start": 727.59,
   "end": 728.99,
   "text": "מיד הניחו את הכתרים שלהם,"
  },
  {
   "start": 729.69,
   "end": 733.15,
   "text": "ותלו אותם גם הם על ארון הנפטר הקדוש."
  },
  {
   "start": 733.61,
   "end": 737.75,
   "text": "וכך למדוו כתרים"
  },
  {
   "start": 738.47,
   "end": 739.47,
   "text": "של מלכים"
  },
  {
   "start": 740.03,
   "end": 742.29,
   "text": "נתלים להם בארון של יעקב."
  },
  {
   "start": 752.08,
   "end": 752.86,
   "text": "הכל היה מוכן לקבורה,"
  },
  {
   "start": 755.46,
   "end": 756.32,
   "text": "אז מאי שם"
  },
  {
   "start": 757.0,
   "end": 760.06,
   "text": "הגיחה לה דמות גדולה"
  },
  {
   "start": 760.86,
   "end": 762.3,
   "text": "ונעמדה לה בפתח המערה."
  },
  {
   "start": 764.12,
   "end": 764.56,
   "text": "עשיו,"
  },
  {
   "start": 765.6,
   "end": 769.24,
   "text": "עשיו, אחיו של יעקב הגיע למקום,"
  },
  {
   "start": 770.14,
   "end": 772.42,
   "text": "ועשיו עוצר את כל מסע ההלוויה."
  },
  {
   "start": 774.52,
   "end": 776.94,
   "text": "אני לא מוכן שיעקב יקבר כאן,"
  },
  {
   "start": 777.96,
   "end": 780.6,
   "text": "זה המקום חלקת קבר שלי."
  },
  {
   "start": 782.12,
   "end": 783.88,
   "text": "טוען עשיו בקשיחות."
  },
  {
   "start": 784.78,
   "end": 786.72,
   "text": "במערה קבורים אדם וחווה,"
  },
  {
   "start": 787.38,
   "end": 788.44,
   "text": "אברהם ושרה,"
  },
  {
   "start": 789.1,
   "end": 790.04,
   "text": "יצחק ורבקה."
  },
  {
   "start": 791.0,
   "end": 791.96,
   "text": "יש עוד שני מקומות,"
  },
  {
   "start": 792.92,
   "end": 793.7,
   "text": "מקום אחד ליעקב,"
  },
  {
   "start": 794.74,
   "end": 795.58,
   "text": "מקום אחד לעשיו."
  },
  {
   "start": 796.76,
   "end": 798.4,
   "text": "יעקב קבר את לאה,"
  },
  {
   "start": 799.64,
   "end": 800.52,
   "text": "ככה טוען עשיו,"
  },
  {
   "start": 801.24,
   "end": 802.48,
   "text": "נשאר המקום שלי."
  },
  {
   "start": 805.98,
   "end": 808.94,
   "text": "וחוץ מזה, לאה הייתה צריכה להינשא לי, למעשה."
  },
  {
   "start": 811.48,
   "end": 814.9,
   "text": "היא הבכורה של לבן צריכה להינשא לי."
  },
  {
   "start": 819.45,
   "end": 820.51,
   "text": "ומתחיל ויכוח"
  },
  {
   "start": 822.03,
   "end": 823.19,
   "text": "של מי הקבר הריק."
  },
  {
   "start": 824.25,
   "end": 825.21,
   "text": "עשיו מתעקש."
  },
  {
   "start": 826.49,
   "end": 828.85,
   "text": "הוא רוצה לראות אישור כשמזכירים לו."
  },
  {
   "start": 829.15,
   "end": 830.21,
   "text": "עשיו, אל תשכח."
  },
  {
   "start": 830.77,
   "end": 834.15,
   "text": "הרי אתה מכרת את הבכורה ואת חלקה,"
  },
  {
   "start": 834.63,
   "end": 836.35,
   "text": "חלקת הקבר שלך, אתה זוכר אולי?"
  },
  {
   "start": 837.31,
   "end": 837.69,
   "text": "והוא"
  },
  {
   "start": 837.69,
   "end": 841.53,
   "text": "הוא לא כל כך מעוניין להיזכר."
  },
  {
   "start": 842.41,
   "end": 844.65,
   "text": "הוא טוען, אני רוצה לראות אישור הוכחה."
  },
  {
   "start": 846.37,
   "end": 846.97,
   "text": "אין ברירה."
  },
  {
   "start": 847.71,
   "end": 849.91,
   "text": "הארון של יעקב מונח בארץ,"
  },
  {
   "start": 850.51,
   "end": 852.85,
   "text": "ונפתלי נשלח למצרים."
  },
  {
   "start": 853.51,
   "end": 855.25,
   "text": "נפתלי על איילה שלוחה."
  },
  {
   "start": 855.79,
   "end": 857.93,
   "text": "נפתלי איילה שלוחה נשלח למצרים"
  },
  {
   "start": 858.93,
   "end": 859.75,
   "text": "להביא אישור"
  },
  {
   "start": 862.48,
   "end": 865.62,
   "text": "שיוכיח שעשיו מכר את חלקת הקבר שלו במערת המכפלה."
  },
  {
   "start": 872.13,
   "end": 873.31,
   "text": "כל נעצר וממתין"
  },
  {
   "start": 874.17,
   "end": 875.43,
   "text": "לשובו של נפתלי."
  },
  {
   "start": 876.09,
   "end": 876.99,
   "text": "עשיו כבר תכנן"
  },
  {
   "start": 877.55,
   "end": 878.17,
   "text": "מה לומר"
  },
  {
   "start": 878.75,
   "end": 882.81,
   "text": "כשיוגש בפניו המסמך המעיד על מכירת הקבר ליעקב."
  },
  {
   "start": 884.09,
   "end": 884.49,
   "text": "איך אני?"
  },
  {
   "start": 885.29,
   "end": 885.95,
   "text": "איך אני אתחמק?"
  },
  {
   "start": 888.28,
   "end": 889.46,
   "text": "עשיו לא התכוון לוותר,"
  },
  {
   "start": 890.72,
   "end": 891.64,
   "text": "אבל לפחות הוא הרוויח זמן."
  },
  {
   "start": 895.1,
   "end": 896.82,
   "text": "אבל דבר אחד הוא לא לקח בחשבון."
  },
  {
   "start": 898.58,
   "end": 900.16,
   "text": "היה שם גם חושים בן דן."
  },
  {
   "start": 901.04,
   "end": 903.7,
   "text": "חושים בן דן לא שומע."
  },
  {
   "start": 904.12,
   "end": 904.76,
   "text": "הוא חירש."
  },
  {
   "start": 905.74,
   "end": 906.64,
   "text": "הוא רק רואה."
  },
  {
   "start": 907.32,
   "end": 916.18,
   "text": "ומה שחושים בן דן רואה, הוא רואה את יעקב הסבא שלו שוכב בביזיון."
  },
  {
   "start": 922.0,
   "end": 925.2,
   "text": "הוא רואה איך מעכבים את סבא שלו מלהיקבר."
  },
  {
   "start": 926.78,
   "end": 927.16,
   "text": "למה?"
  },
  {
   "start": 928.06,
   "end": 929.26,
   "text": "הוא רוצה לדעת למה."
  },
  {
   "start": 930.44,
   "end": 931.52,
   "text": "ואז מסבירים לו,"
  },
  {
   "start": 932.06,
   "end": 932.98,
   "text": "מראים לו את מה קורה."
  },
  {
   "start": 933.6,
   "end": 934.6,
   "text": "תראה, עשיו מעכב."
  },
  {
   "start": 936.56,
   "end": 938.9,
   "text": "וכולם למעשה ממתינים לנפתלי שיחזור ממצרים."
  },
  {
   "start": 941.44,
   "end": 941.86,
   "text": "חושים"
  },
  {
   "start": 942.86,
   "end": 945.08,
   "text": "רואה רק את מה שלפניו."
  },
  {
   "start": 945.74,
   "end": 948.14,
   "text": "יעקב שוכב בביזיון,"
  },
  {
   "start": 948.92,
   "end": 949.6,
   "text": "לא נקבר,"
  },
  {
   "start": 950.44,
   "end": 951.54,
   "text": "יש לו צער למת."
  },
  {
   "start": 952.52,
   "end": 954.04,
   "text": "עשיו מעכב את כולם"
  },
  {
   "start": 954.62,
   "end": 957.02,
   "text": "עד שיגיע נפתלי סוף סוף ממצרים,"
  },
  {
   "start": 957.66,
   "end": 959.88,
   "text": "בנתן יהיה סבא שלי מונח בביזיון?"
  },
  {
   "start": 960.86,
   "end": 961.82,
   "text": "חושים בן דן"
  },
  {
   "start": 962.82,
   "end": 963.56,
   "text": "לא חיכה הרבה."
  },
  {
   "start": 966.0,
   "end": 969.72,
   "text": "הוא לקח עלת עץ שהייתה נמצאת בסמוך,"
  },
  {
   "start": 970.34,
   "end": 971.7,
   "text": "התקרב במהירות אל עשיו"
  },
  {
   "start": 972.28,
   "end": 975.32,
   "text": "והיכה בראשו של עשיו בעוצמה אדירה."
  },
  {
   "start": 977.62,
   "end": 978.7,
   "text": "מכה קטרנית."
  },
  {
   "start": 979.8,
   "end": 981.26,
   "text": "הכוח של חושים היה עצום."
  },
  {
   "start": 982.56,
   "end": 983.18,
   "text": "מהמכה,"
  },
  {
   "start": 984.62,
   "end": 988.06,
   "text": "מהמכה העצומה הזאת, האדירה הזאת, בראשו של עשיו,"
  },
  {
   "start": 988.6,
   "end": 995.44,
   "text": "מעוצמת המכה יצאו עיניו של עשיו מחוריהם ונפלו למרגלות יעקב."
  },
  {
   "start": 996.58,
   "end": 997.06,
   "text": "ועשיו"
  },
  {
   "start": 997.74,
   "end": 998.38,
   "text": "נפל בית,"
  },
  {
   "start": 1001.28,
   "end": 1002.36,
   "text": "ואז נדהמו כולם."
  },
  {
   "start": 1004.24,
   "end": 1004.52,
   "text": "לפתע"
  },
  {
   "start": 1005.4,
   "end": 1007.56,
   "text": "עיני יעקב המת,"
  },
  {
   "start": 1008.32,
   "end": 1010.38,
   "text": "עיני יעקב המת נפתחו לפתע,"
  },
  {
   "start": 1013.21,
   "end": 1013.75,
   "text": "מביטות"
  },
  {
   "start": 1014.87,
   "end": 1018.05,
   "text": "בראשו של עשיו ובעיניו של עשיו שלמרגלותיו."
  },
  {
   "start": 1019.49,
   "end": 1020.17,
   "text": "ואז הוא חייך,"
  },
  {
   "start": 1021.59,
   "end": 1022.99,
   "text": "ואז יעקב חייך,"
  },
  {
   "start": 1026.54,
   "end": 1027.36,
   "text": "עשיו נהרג."
  },
  {
   "start": 1028.92,
   "end": 1032.76,
   "text": "בו ביום שיעקב בא לקבורה,"
  },
  {
   "start": 1034.06,
   "end": 1036.68,
   "text": "נתקיימה לה נבואת האמא הגדולה, רבקה."
  },
  {
   "start": 1037.68,
   "end": 1040.82,
   "text": "למה אשכול גם שניכם ביום אחד?"
  },
  {
   "start": 1045.92,
   "end": 1050.96,
   "text": "למותר לציין שיעקב כמובן נקבר ללא שהיות במערת המכפלה."
  },
  {
   "start": 1065.04,
   "end": 1066.4,
   "text": "זה היה חושים בן דן."
  },
  {
   "start": 1068.16,
   "end": 1072.74,
   "text": "חושים בן דן נפטר מאוחר יותר,"
  },
  {
   "start": 1073.66,
   "end": 1074.78,
   "text": "אבל לא סיים את תפקידו."
  },
  {
   "start": 1076.04,
   "end": 1076.54,
   "text": "חושים"
  },
  {
   "start": 1078.26,
   "end": 1079.26,
   "text": "זה אותיות משיח,"
  },
  {
   "start": 1080.72,
   "end": 1081.56,
   "text": "משיח בן דן,"
  },
  {
   "start": 1082.7,
   "end": 1083.68,
   "text": "ומשבט דן"
  },
  {
   "start": 1084.66,
   "end": 1089.06,
   "text": "יצא עוד משיח ששורש נשמתו הוא אותו חושים,"
  },
  {
   "start": 1089.84,
   "end": 1094.3,
   "text": "והוא יצטרך להילחם במלחמה הגדולה מכל המלחמות,"
  },
  {
   "start": 1094.9,
   "end": 1095.66,
   "text": "מלחמת היצר,"
  },
  {
   "start": 1097.12,
   "end": 1098.28,
   "text": "מול כוחו של עשיו,"
  },
  {
   "start": 1099.34,
   "end": 1100.14,
   "text": "כוח התאווה."
  },
  {
   "start": 1114.42,
   "end": 1115.04,
   "text": "עד כאן ההקדמה."
  }
 ]
}