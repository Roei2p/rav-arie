{
 "disc": "שמשון לוחם יהודי א",
 "track": "Track04",
 "duration": 2033.184,
 "segments": [
  {
   "start": 7.05,
   "end": 7.27,
   "text": "עזה,"
  },
  {
   "start": 8.35,
   "end": 10.73,
   "text": "עזה עיר פלישתית מאז ומתמיד."
  },
  {
   "start": 12.21,
   "end": 15.29,
   "text": "מאז ומתמיד עיר שצופנת בחובה צרות."
  },
  {
   "start": 17.51,
   "end": 18.05,
   "text": "משהו פנימי"
  },
  {
   "start": 19.13,
   "end": 20.67,
   "text": "מושך את שמשון אל העיר הזו."
  },
  {
   "start": 23.14,
   "end": 23.58,
   "text": "המאבק"
  },
  {
   "start": 25.34,
   "end": 26.24,
   "text": "בתוכו החל."
  },
  {
   "start": 27.88,
   "end": 28.68,
   "text": "שמשון היה זהיר."
  },
  {
   "start": 30.64,
   "end": 33.8,
   "text": "הוא ידע שכלל מספר אחד בקדושה,"
  },
  {
   "start": 34.7,
   "end": 37.12,
   "text": "שמירת עיניים, שמור את העיניים."
  },
  {
   "start": 38.94,
   "end": 39.4,
   "text": "והוא הקפיד,"
  },
  {
   "start": 40.06,
   "end": 41.16,
   "text": "הוא היה בטוח שהוא לא ייכשל."
  },
  {
   "start": 42.48,
   "end": 43.76,
   "text": "אבל חזל הקדושים,"
  },
  {
   "start": 44.56,
   "end": 48.16,
   "text": "חזל הקדושים הזהירו את האדם, אל תיכנס לניסיון."
  },
  {
   "start": 51.94,
   "end": 55.08,
   "text": "שמשון היה בטוח שמדובר באדם רגיל,"
  },
  {
   "start": 55.82,
   "end": 56.78,
   "text": "אבל אצלו זה אחרת."
  },
  {
   "start": 61.96,
   "end": 62.14,
   "text": "אבל,"
  },
  {
   "start": 63.8,
   "end": 64.56,
   "text": "אבל שם,"
  },
  {
   "start": 65.4,
   "end": 66.08,
   "text": "שם בעזה,"
  },
  {
   "start": 69.62,
   "end": 70.7,
   "text": "שם בעזה הוא ראה אותה,"
  },
  {
   "start": 71.56,
   "end": 72.42,
   "text": "אישה פלישתית,"
  },
  {
   "start": 75.64,
   "end": 77.94,
   "text": "ודווקא היא מצאה חן בעיניו."
  },
  {
   "start": 78.24,
   "end": 80.58,
   "text": "הוא ראה ונכווה."
  },
  {
   "start": 83.18,
   "end": 86.9,
   "text": "שמשון רוצה לגייר אותה ואחר כך לשאת אותה לאישה,"
  },
  {
   "start": 89.64,
   "end": 92.32,
   "text": "אבל הוא יודע שהוא לא יעז לעשות משהו,"
  },
  {
   "start": 92.94,
   "end": 97.22,
   "text": "לא יעז לעשות דבר כלשהו לפני שהוא ידבר עם ההורים שלו."
  },
  {
   "start": 98.74,
   "end": 99.4,
   "text": "הוא מגיע הביתה,"
  },
  {
   "start": 103.17,
   "end": 104.23,
   "text": "הוא לא מדבר עם אמא,"
  },
  {
   "start": 106.52,
   "end": 108.1,
   "text": "הוא מדבר רק עם אבא שלו, עם מנוח."
  },
  {
   "start": 110.36,
   "end": 114.5,
   "text": "שמשון חשש לשבור את ליבה של אמא שלו."
  },
  {
   "start": 115.2,
   "end": 117.68,
   "text": "הוא ידע כמה היא הקפידה ושמרה על קדושתו,"
  },
  {
   "start": 120.19,
   "end": 121.25,
   "text": "אז הוא מדבר עם אבא שלו."
  },
  {
   "start": 124.3,
   "end": 129.42,
   "text": "אבל תוך כמה זמן גם אמא שומעת,"
  },
  {
   "start": 131.81,
   "end": 133.49,
   "text": "וכמו שהוא תיאר לעצמו,"
  },
  {
   "start": 134.97,
   "end": 136.23,
   "text": "ליבה של אמא נשבר,"
  },
  {
   "start": 137.67,
   "end": 138.75,
   "text": "והם מתחננים בפניו,"
  },
  {
   "start": 145.96,
   "end": 147.36,
   "text": "בני זה רק בעיניים שלך."
  },
  {
   "start": 148.84,
   "end": 152.02,
   "text": "אתה רואה בעיניים שלך היא ישרה, אתה אומר היא ישרה בעיניי,"
  },
  {
   "start": 152.5,
   "end": 153.36,
   "text": "זה בעיניים שלך."
  },
  {
   "start": 154.16,
   "end": 157.2,
   "text": "בני העיניים שלך, העיניים זה פתחי הנשמה,"
  },
  {
   "start": 157.98,
   "end": 159.44,
   "text": "לכן צריך כל כך לשמור עליהם."
  },
  {
   "start": 160.18,
   "end": 161.36,
   "text": "למה לא שמרת עליהם?"
  },
  {
   "start": 161.72,
   "end": 164.48,
   "text": "תגיד לי, אין מבנות ישראל איזה מישהי שתתאים לך?"
  },
  {
   "start": 165.1,
   "end": 165.84,
   "text": "בוכה לו אמו."
  },
  {
   "start": 168.6,
   "end": 169.38,
   "text": "ושמשון,"
  },
  {
   "start": 170.18,
   "end": 171.2,
   "text": "שמשון מסביר להם."
  },
  {
   "start": 171.7,
   "end": 173.66,
   "text": "אומר להם, אתם לא מבינים, זו הנקודה."
  },
  {
   "start": 174.38,
   "end": 177.52,
   "text": "אם דווקא מכל בנו תעמי, דווקא זו הפלישתית,"
  },
  {
   "start": 178.06,
   "end": 179.64,
   "text": "דווקא היא מצאה חן בעיניי,"
  },
  {
   "start": 180.06,
   "end": 182.16,
   "text": "הרי זה סימן שזו גזירה משמיים."
  },
  {
   "start": 183.4,
   "end": 184.36,
   "text": "זו גזירה משמיים."
  },
  {
   "start": 194.54,
   "end": 196.98,
   "text": "שמשון צדק בחלק מהדברים."
  },
  {
   "start": 197.68,
   "end": 198.38,
   "text": "באותו זמן,"
  },
  {
   "start": 198.84,
   "end": 200.92,
   "text": "בשמיים נפסק,"
  },
  {
   "start": 201.64,
   "end": 202.4,
   "text": "אתה שמשון,"
  },
  {
   "start": 203.04,
   "end": 204.08,
   "text": "לא שמרת את העיניים,"
  },
  {
   "start": 204.82,
   "end": 206.58,
   "text": "טעית והלכת אחרי עיניך."
  },
  {
   "start": 208.72,
   "end": 210.88,
   "text": "אתה אומנם תהיה אמצעי להינקם בפלישתים,"
  },
  {
   "start": 211.86,
   "end": 213.18,
   "text": "אבל זה יהיה בצורה כואבת עבורך."
  },
  {
   "start": 214.92,
   "end": 219.16,
   "text": "כי בדרך שאדם רוצה ללך, כך מוליכים אותו."
  },
  {
   "start": 219.5,
   "end": 223.54,
   "text": "והוריו של שמשון לא יודעים כי מהקדוש ברוך הוא יצא הדבר."
  },
  {
   "start": 228.41,
   "end": 229.11,
   "text": "ושמשון"
  },
  {
   "start": 229.83,
   "end": 232.03,
   "text": "צריך לתקן, אבל בצורה כואבת."
  },
  {
   "start": 233.37,
   "end": 234.55,
   "text": "יש שני אפשרויות לתיקון."
  },
  {
   "start": 235.85,
   "end": 236.51,
   "text": "בצורה טובה,"
  },
  {
   "start": 238.75,
   "end": 239.99,
   "text": "שמורה, בצורה כואבת."
  },
  {
   "start": 246.19,
   "end": 246.63,
   "text": "ומנוח."
  },
  {
   "start": 247.47,
   "end": 248.39,
   "text": "מנוח ורעייתו."
  },
  {
   "start": 248.91,
   "end": 249.65,
   "text": "ושמשון."
  },
  {
   "start": 251.35,
   "end": 252.25,
   "text": "יורדים לתמנת."
  },
  {
   "start": 253.39,
   "end": 254.05,
   "text": "עיר פלישתית."
  },
  {
   "start": 255.19,
   "end": 257.05,
   "text": "שם היו כרמים רבים זרועים."
  },
  {
   "start": 262.9,
   "end": 264.12,
   "text": "תראה, בני אהובי, תראה."
  },
  {
   "start": 264.54,
   "end": 266.54,
   "text": "תראה את הכרמים של תמנת הפלישתית."
  },
  {
   "start": 267.12,
   "end": 268.56,
   "text": "תראה את הכרמים, איך הם זרועים כלאיים."
  },
  {
   "start": 269.7,
   "end": 270.68,
   "text": "הכל מעורב."
  },
  {
   "start": 271.32,
   "end": 273.32,
   "text": "תדע לך, ככה גם הבנות שלהם."
  },
  {
   "start": 273.86,
   "end": 274.84,
   "text": "הבנות שלהם זרועות כלאיים."
  },
  {
   "start": 275.82,
   "end": 278.72,
   "text": "הכל מעורב, אין מוסר, אין צניעות."
  },
  {
   "start": 279.16,
   "end": 281.12,
   "text": "בני אל, אל תעשה את זה."
  },
  {
   "start": 282.12,
   "end": 282.68,
   "text": "אבל שמשון,"
  },
  {
   "start": 283.32,
   "end": 284.4,
   "text": "משהו פנימי מושך אותו."
  },
  {
   "start": 292.52,
   "end": 293.7,
   "text": "מאבק כוחות איתנים"
  },
  {
   "start": 295.34,
   "end": 296.3,
   "text": "מתנהל בתוכו,"
  },
  {
   "start": 298.95,
   "end": 299.31,
   "text": "וכך"
  },
  {
   "start": 300.25,
   "end": 301.01,
   "text": "הוא פוסע לו,"
  },
  {
   "start": 302.59,
   "end": 302.99,
   "text": "לבד."
  },
  {
   "start": 304.37,
   "end": 309.13,
   "text": "ממשיך בדרכו הארוכה והמתפתלת,"
  },
  {
   "start": 310.01,
   "end": 311.33,
   "text": "בתמנת היוקרמים."
  },
  {
   "start": 312.09,
   "end": 314.05,
   "text": "שמשון שמר על הנזירות שלו."
  },
  {
   "start": 315.05,
   "end": 317.51,
   "text": "הוא לא ייכנס לכרמים, הוא גם לא יתקרב אליהם."
  },
  {
   "start": 320.25,
   "end": 321.41,
   "text": "הוא עוקף את הכרמים"
  },
  {
   "start": 324.48,
   "end": 325.48,
   "text": "כדי לא להתקרב אליהם."
  },
  {
   "start": 326.2,
   "end": 328.76,
   "text": "אוי, שמשון, אם היית מצלם, אצליח לשמור ככה את עיניך,"
  },
  {
   "start": 329.88,
   "end": 331.0,
   "text": "אולי הכל היה נראה אחרת."
  },
  {
   "start": 332.56,
   "end": 333.16,
   "text": "אבל זה לא קל."
  },
  {
   "start": 333.74,
   "end": 335.64,
   "text": "עם עוצמה אדירה כזו להתמודד."
  },
  {
   "start": 336.34,
   "end": 339.82,
   "text": "עם עוצמה אדירה כזו להילחם דקה-דקה, שעה-שעה."
  },
  {
   "start": 341.66,
   "end": 342.12,
   "text": "הדברים לא פשוטים."
  },
  {
   "start": 345.47,
   "end": 346.61,
   "text": "ושמשון פוסע לו לבד."
  },
  {
   "start": 347.47,
   "end": 348.63,
   "text": "ממשיך בדרכו הארוכה,"
  },
  {
   "start": 349.65,
   "end": 350.07,
   "text": "ואז"
  },
  {
   "start": 351.67,
   "end": 351.83,
   "text": "שם,"
  },
  {
   "start": 352.57,
   "end": 355.31,
   "text": "באמצע הדרך, העוקפת את כרמי תמנת,"
  },
  {
   "start": 356.23,
   "end": 356.95,
   "text": "ניצב לו,"
  },
  {
   "start": 357.81,
   "end": 358.97,
   "text": "לא פחות ולא יותר,"
  },
  {
   "start": 359.85,
   "end": 360.67,
   "text": "כפיר אריות."
  },
  {
   "start": 362.29,
   "end": 364.13,
   "text": "מביט לו באיש הפוסע למולו"
  },
  {
   "start": 364.79,
   "end": 365.35,
   "text": "במבט אימתני."
  },
  {
   "start": 369.58,
   "end": 370.42,
   "text": "שמשון נעצר."
  },
  {
   "start": 371.78,
   "end": 372.64,
   "text": "האריה מזדקף."
  },
  {
   "start": 374.36,
   "end": 378.23,
   "text": "שואג ורץ."
  },
  {
   "start": 380.98,
   "end": 383.06,
   "text": "מזנק לעבר שמשון."
  },
  {
   "start": 386.64,
   "end": 388.32,
   "text": "אז קורא הבלתי ייאמן."
  },
  {
   "start": 390.44,
   "end": 393.66,
   "text": "משהתקרב האריה אל שמשון,"
  },
  {
   "start": 395.5,
   "end": 398.3,
   "text": "הרים שמשון את הידיים שלו במהירות מדהימה,"
  },
  {
   "start": 399.36,
   "end": 400.52,
   "text": "ולפט בשתי ידיו"
  },
  {
   "start": 401.16,
   "end": 404.32,
   "text": "את פיו הפעור ונוטף הריר של האריה,"
  },
  {
   "start": 407.34,
   "end": 411.68,
   "text": "כשבעוצמה אדירה על-טבעית הוא בולם את גוף האריה המזנק עליו."
  },
  {
   "start": 413.26,
   "end": 416.74,
   "text": "הכל קפל לשנייה בשמשון,"
  },
  {
   "start": 417.9,
   "end": 419.04,
   "text": "ביצע תנועה אחת,"
  },
  {
   "start": 420.68,
   "end": 423.26,
   "text": "מהירה, קטלנית,"
  },
  {
   "start": 431.13,
   "end": 433.93,
   "text": "ופשוט, תאריה,"
  },
  {
   "start": 435.29,
   "end": 436.81,
   "text": "כאילו מדובר באיזה גדי,"
  },
  {
   "start": 437.61,
   "end": 439.91,
   "text": "גדי בן יומו רך בשר ועדין."
  },
  {
   "start": 455.54,
   "end": 458.84,
   "text": "שמשון שמט את גביעת האריה מאחוריו,"
  },
  {
   "start": 459.98,
   "end": 460.7,
   "text": "והמשיך הלאה."
  },
  {
   "start": 462.0,
   "end": 465.92,
   "text": "הוא אף לא טרח לספר לאיש על אותה מתנת שמיים שקיבל"
  },
  {
   "start": 467.0,
   "end": 468.18,
   "text": "כוח כה עצום."
  },
  {
   "start": 470.18,
   "end": 470.84,
   "text": "מתנת שמיים."
  },
  {
   "start": 472.16,
   "end": 472.86,
   "text": "לך שמשון,"
  },
  {
   "start": 473.48,
   "end": 474.74,
   "text": "לך בכוחך זה."
  },
  {
   "start": 491.23,
   "end": 491.67,
   "text": "שמשון,"
  },
  {
   "start": 491.67,
   "end": 495.95,
   "text": "נפגש עם האישה הפלישתית."
  },
  {
   "start": 497.67,
   "end": 498.03,
   "text": "מדבר איתה,"
  },
  {
   "start": 498.99,
   "end": 500.03,
   "text": "הוא רוצה להתרשם ממנה."
  },
  {
   "start": 503.04,
   "end": 504.94,
   "text": "אחר כך הוא חוזר לבית שלו מרוצה."
  },
  {
   "start": 506.06,
   "end": 509.24,
   "text": "לא לפני שסיכמו על נישואים בדיוק בעוד שנה."
  },
  {
   "start": 515.84,
   "end": 516.94,
   "text": "הימים חולפים מהר."
  },
  {
   "start": 518.3,
   "end": 519.58,
   "text": "חלפה ועברה לה שנה,"
  },
  {
   "start": 520.94,
   "end": 522.16,
   "text": "ושמשון מוצא את עצמו"
  },
  {
   "start": 523.0,
   "end": 524.02,
   "text": "חוזר אל תמנת."
  },
  {
   "start": 526.14,
   "end": 526.72,
   "text": "שם בדרך,"
  },
  {
   "start": 527.54,
   "end": 529.38,
   "text": "בדרך הארוכה העוקפת את הכרמים,"
  },
  {
   "start": 530.44,
   "end": 533.2,
   "text": "הוא נעצר במקום בו שנה לפני כן"
  },
  {
   "start": 533.94,
   "end": 536.18,
   "text": "ניצח את האריה בסייעתא דשמיא,"
  },
  {
   "start": 537.12,
   "end": 538.52,
   "text": "הוא בא לברך על הנס,"
  },
  {
   "start": 542.08,
   "end": 542.68,
   "text": "ואז הוא מביט"
  },
  {
   "start": 543.6,
   "end": 544.34,
   "text": "בצד הדרך"
  },
  {
   "start": 545.38,
   "end": 548.08,
   "text": "ומבחין לו בגוויית האריה,"
  },
  {
   "start": 549.76,
   "end": 550.42,
   "text": "ומתוכה"
  },
  {
   "start": 551.22,
   "end": 552.38,
   "text": "ניגר דבש,"
  },
  {
   "start": 553.26,
   "end": 554.42,
   "text": "נוטף לו דבש."
  },
  {
   "start": 555.58,
   "end": 561.16,
   "text": "קפוצת דבורים הפכה את השלד של האריה הזה לקוורת פעילה,"
  },
  {
   "start": 561.94,
   "end": 562.86,
   "text": "והדבש נוטף החוצה,"
  },
  {
   "start": 567.26,
   "end": 568.68,
   "text": "שמשון בדרך אל תמנת."
  },
  {
   "start": 569.92,
   "end": 570.86,
   "text": "רוח כלילה"
  },
  {
   "start": 571.74,
   "end": 572.6,
   "text": "מנשבת לה,"
  },
  {
   "start": 573.28,
   "end": 575.0,
   "text": "כאומרת שמשון, שמשון,"
  },
  {
   "start": 575.78,
   "end": 577.98,
   "text": "תראה את הדבש, אמנם הוא מתוק,"
  },
  {
   "start": 579.1,
   "end": 582.92,
   "text": "אבל תמיד בקרבתו תמצא גם דברים עוקצות,"
  },
  {
   "start": 583.9,
   "end": 585.18,
   "text": "תמצא גם דבורים עוקצות."
  },
  {
   "start": 587.14,
   "end": 587.7,
   "text": "גם אישה,"
  },
  {
   "start": 588.46,
   "end": 590.26,
   "text": "אישה בגמטריה זה דבש."
  },
  {
   "start": 591.28,
   "end": 591.76,
   "text": "תיזהר,"
  },
  {
   "start": 592.52,
   "end": 593.74,
   "text": "תיזהר שלא יהיו בקרבתה,"
  },
  {
   "start": 594.7,
   "end": 595.9,
   "text": "כל מיני דבורים עוקצות,"
  },
  {
   "start": 596.74,
   "end": 597.38,
   "text": "סביבה לא הגונה,"
  },
  {
   "start": 602.98,
   "end": 603.48,
   "text": "בתמנת,"
  },
  {
   "start": 604.56,
   "end": 606.02,
   "text": "עם בואו של החתן היהודי,"
  },
  {
   "start": 608.98,
   "end": 609.86,
   "text": "האבא של הכלה,"
  },
  {
   "start": 612.01,
   "end": 614.95,
   "text": "מגיע עם שלושים מהחברים שלו לחתונה,"
  },
  {
   "start": 616.01,
   "end": 618.37,
   "text": "והם שמחים ועולזים בחסודת החתונה."
  },
  {
   "start": 619.85,
   "end": 620.75,
   "text": "ואז כך, באמצע,"
  },
  {
   "start": 621.41,
   "end": 623.99,
   "text": "מבקשים משמשון, תאמר משהו, תגיד משהו."
  },
  {
   "start": 625.77,
   "end": 626.67,
   "text": "שמשון מחייך ואומר,"
  },
  {
   "start": 627.71,
   "end": 628.77,
   "text": "בואו אני אחוד לכם חידה."
  },
  {
   "start": 630.19,
   "end": 630.53,
   "text": "תראו,"
  },
  {
   "start": 631.37,
   "end": 633.27,
   "text": "אם אתם תפטרו,"
  },
  {
   "start": 634.09,
   "end": 636.25,
   "text": "אני אתן לכם מתנות, אם לא, אתם תיתנו לי."
  },
  {
   "start": 637.45,
   "end": 637.95,
   "text": "אמרו לו, מה?"
  },
  {
   "start": 639.29,
   "end": 641.29,
   "text": "אמר להם, תדעו, אני אחוד לכם חידה."
  },
  {
   "start": 642.39,
   "end": 643.53,
   "text": "אני אתן לכם זמן לפטור."
  },
  {
   "start": 644.21,
   "end": 646.63,
   "text": "אם תדעו, תקבלו ממני 30 סדינים,"
  },
  {
   "start": 647.57,
   "end": 649.15,
   "text": "30 סדינים ו-30 חליפות."
  },
  {
   "start": 649.89,
   "end": 651.37,
   "text": "ואם לא תדעו, אני מקבל מכם."
  },
  {
   "start": 652.97,
   "end": 653.71,
   "text": "אמרו לו, בסדר,"
  },
  {
   "start": 654.89,
   "end": 655.37,
   "text": "למה לא?"
  },
  {
   "start": 657.11,
   "end": 658.83,
   "text": "והכל ככה מתוך רוח טובה."
  },
  {
   "start": 679.36,
   "end": 679.86,
   "text": "שמשון,"
  },
  {
   "start": 680.28,
   "end": 681.26,
   "text": "קם וחד להם חידה."
  },
  {
   "start": 682.58,
   "end": 683.28,
   "text": "אומר להם, מה זה?"
  },
  {
   "start": 684.08,
   "end": 686.78,
   "text": "מהאוכל יצא מאכל,"
  },
  {
   "start": 687.68,
   "end": 688.94,
   "text": "ומאז יצא מתוק."
  },
  {
   "start": 689.62,
   "end": 690.58,
   "text": "מהאוכל,"
  },
  {
   "start": 693.1,
   "end": 696.0,
   "text": "מהאוכל יצא מאכל,"
  },
  {
   "start": 696.62,
   "end": 697.54,
   "text": "ומאז יצא מתוק."
  },
  {
   "start": 702.98,
   "end": 703.68,
   "text": "לחידה כזאת"
  },
  {
   "start": 704.32,
   "end": 704.84,
   "text": "הם לא התכוננו."
  },
  {
   "start": 710.28,
   "end": 711.84,
   "text": "פלישתים לא יודעים."
  },
  {
   "start": 713.78,
   "end": 714.84,
   "text": "הפלישתים לא יודעים מה לענות."
  },
  {
   "start": 716.4,
   "end": 718.38,
   "text": "ושמשון פשוט לא מכיר את הפלישתים."
  },
  {
   "start": 723.18,
   "end": 723.62,
   "text": "הם לא יודעים."
  },
  {
   "start": 724.9,
   "end": 726.58,
   "text": "והם לא מתכוונים לוותר."
  },
  {
   "start": 727.8,
   "end": 729.1,
   "text": "הם לא מתכוונים להפסיד"
  },
  {
   "start": 729.76,
   "end": 730.52,
   "text": "ליהודי הזה."
  },
  {
   "start": 735.06,
   "end": 737.14,
   "text": "שמשון לא מזהה את אותות האיבה בעיניהם."
  },
  {
   "start": 742.4,
   "end": 743.7,
   "text": "בזמן שהוא הולך להתפלל,"
  },
  {
   "start": 744.34,
   "end": 746.06,
   "text": "בזמן שהוא עוסק בדברים של קדושה,"
  },
  {
   "start": 746.86,
   "end": 748.18,
   "text": "הם מתחילים להתחבר לאשתו."
  },
  {
   "start": 753.52,
   "end": 754.84,
   "text": "הם לא שמעו לקדושת הבית,"
  },
  {
   "start": 756.02,
   "end": 757.34,
   "text": "ולא אכפת להם מזה."
  },
  {
   "start": 758.12,
   "end": 758.72,
   "text": "הם רוצים"
  },
  {
   "start": 759.84,
   "end": 760.76,
   "text": "לא להפסיד."
  },
  {
   "start": 766.81,
   "end": 767.33,
   "text": "אחר כך"
  },
  {
   "start": 770.32,
   "end": 771.58,
   "text": "הם באים ומאיימים."
  },
  {
   "start": 772.38,
   "end": 774.94,
   "text": "תופסים את אשתו של שמשון ומאיימים עליה."
  },
  {
   "start": 775.46,
   "end": 775.82,
   "text": "תדעי לך,"
  },
  {
   "start": 776.42,
   "end": 781.56,
   "text": "אם את לא תגידי לנו את פתרון החידה, אם לא תוציאי מבעליך את פתרון החידה,"
  },
  {
   "start": 782.14,
   "end": 783.98,
   "text": "אנחנו נשרוף אותך באש,"
  },
  {
   "start": 784.46,
   "end": 787.5,
   "text": "ואת בית אבא שלך נשרוף יחד עם אבא שלך."
  },
  {
   "start": 793.97,
   "end": 796.77,
   "text": "בדרך כלל מחתונה נולדים קירוב ואחדות."
  },
  {
   "start": 797.91,
   "end": 801.25,
   "text": "בחתונה הזו נזרעים זרעי שנאה ודם."
  },
  {
   "start": 803.15,
   "end": 804.03,
   "text": "ואשת שמשון"
  },
  {
   "start": 806.22,
   "end": 811.0,
   "text": "לא מגלה לבעלה את מה שקורה איתה."
  },
  {
   "start": 812.12,
   "end": 813.14,
   "text": "במקום זה היא בוכה לו,"
  },
  {
   "start": 814.38,
   "end": 814.92,
   "text": "תגלה לי."
  },
  {
   "start": 815.48,
   "end": 818.28,
   "text": "מבטיחה לו, אני לא אגלה כלום, תגידי לי רק את החידה."
  },
  {
   "start": 819.12,
   "end": 820.18,
   "text": "וכך היא מציקה לו,"
  },
  {
   "start": 820.8,
   "end": 821.44,
   "text": "ומציקה לו."
  },
  {
   "start": 823.58,
   "end": 824.28,
   "text": "שבע ברכות,"
  },
  {
   "start": 825.4,
   "end": 826.26,
   "text": "שבע ימי חושך."
  },
  {
   "start": 828.4,
   "end": 831.9,
   "text": "ושמשון אומר לה, תראי, להורים שלי לא סיפרתי. מה אכפת לך לא לדעת?"
  },
  {
   "start": 833.16,
   "end": 835.68,
   "text": "לא, אבל אני רוצה לדעת, והיא לא נותנת לו מנוחה."
  },
  {
   "start": 836.46,
   "end": 839.04,
   "text": "לבסוף שמעון, שמשון,"
  },
  {
   "start": 839.82,
   "end": 840.92,
   "text": "לבסוף שמשון אומר,"
  },
  {
   "start": 842.62,
   "end": 843.24,
   "text": "אומר לה את התשובה."
  },
  {
   "start": 844.66,
   "end": 845.64,
   "text": "אומר לה, מהאוכל."
  },
  {
   "start": 848.0,
   "end": 849.28,
   "text": "זה לא אוכל, אלא מהאוכל."
  },
  {
   "start": 850.74,
   "end": 852.52,
   "text": "מהאוכל, מה זה אוכל?"
  },
  {
   "start": 852.94,
   "end": 853.7,
   "text": "האריה,"
  },
  {
   "start": 854.28,
   "end": 855.54,
   "text": "האריה שאוכל אחרים,"
  },
  {
   "start": 856.06,
   "end": 858.34,
   "text": "יצא מאכל, יצא דבש."
  },
  {
   "start": 859.36,
   "end": 861.86,
   "text": "ומאז גם אריה יצא מתוק דבש."
  },
  {
   "start": 863.02,
   "end": 864.48,
   "text": "ולכו תראו שם על אם הדרך."
  },
  {
   "start": 865.76,
   "end": 866.8,
   "text": "ליד כרמי תמנת,"
  },
  {
   "start": 867.58,
   "end": 867.78,
   "text": "איך"
  },
  {
   "start": 868.86,
   "end": 870.34,
   "text": "מתוך אריה יוצא דבש."
  },
  {
   "start": 870.98,
   "end": 872.68,
   "text": "מהאוכל יצא מאכל."
  },
  {
   "start": 875.12,
   "end": 876.68,
   "text": "מהאוכל בעלי חיים יצא מאכל."
  },
  {
   "start": 882.45,
   "end": 883.19,
   "text": "ואז היא נרגעה,"
  },
  {
   "start": 884.79,
   "end": 885.91,
   "text": "והלכה וסיפרה את החידה,"
  },
  {
   "start": 886.99,
   "end": 890.94,
   "text": "את פתרון החידה לפלישתים."
  },
  {
   "start": 892.84,
   "end": 893.52,
   "text": "יום אחרון לפתרון."
  },
  {
   "start": 894.92,
   "end": 896.7,
   "text": "והשמועה כבר פשטה בכל העיר."
  },
  {
   "start": 897.98,
   "end": 899.3,
   "text": "הפלישתים פרסמו את זה,"
  },
  {
   "start": 900.08,
   "end": 901.9,
   "text": "כדי שזה ייראה כאילו כל כך פשוט,"
  },
  {
   "start": 902.24,
   "end": 902.56,
   "text": "כולם יודעים,"
  },
  {
   "start": 903.8,
   "end": 905.0,
   "text": "בכלל לא חידה חכמה."
  },
  {
   "start": 905.92,
   "end": 907.28,
   "text": "וככה ילגלגו על שמשון,"
  },
  {
   "start": 907.92,
   "end": 908.88,
   "text": "ויצערו עוד יותר."
  },
  {
   "start": 909.56,
   "end": 910.04,
   "text": "ולא רק זה,"
  },
  {
   "start": 910.62,
   "end": 912.92,
   "text": "אלא בכוונה הם ממתינים עד הרגע האחרון,"
  },
  {
   "start": 913.38,
   "end": 914.48,
   "text": "כדי שהוא יחשוב שהנה,"
  },
  {
   "start": 914.82,
   "end": 916.76,
   "text": "אף אחד לא יודע לפתור את החידה שלו."
  },
  {
   "start": 918.4,
   "end": 919.4,
   "text": "ואז ברגע האחרון,"
  },
  {
   "start": 920.44,
   "end": 932.86,
   "text": "הם באו ובחיוך מגלים בפניו את פתרון החידה ושמשון."
  },
  {
   "start": 934.96,
   "end": 940.22,
   "text": "אצל שמשון הכל יתפרץ באחת."
  },
  {
   "start": 942.69,
   "end": 943.51,
   "text": "אצל שמשון"
  },
  {
   "start": 944.53,
   "end": 945.69,
   "text": "הכל התפרץ באחת."
  },
  {
   "start": 946.87,
   "end": 949.01,
   "text": "הוא חש בתנועה חשודה סביבות אשתו."
  },
  {
   "start": 950.47,
   "end": 951.11,
   "text": "עכשיו הוא הבין הכל."
  },
  {
   "start": 954.84,
   "end": 957.16,
   "text": "הבין שהייתה כאן מלכודת."
  },
  {
   "start": 958.48,
   "end": 960.14,
   "text": "כל זה בשביל לדעת את פתרון החידה."
  },
  {
   "start": 963.45,
   "end": 965.31,
   "text": "לולא חרשתם בעגלתי,"
  },
  {
   "start": 965.99,
   "end": 967.31,
   "text": "לא מצאתם חידתי."
  },
  {
   "start": 968.03,
   "end": 972.23,
   "text": "אם לא הייתם הולכים ומכריחים את אשתי להוציא ממני,"
  },
  {
   "start": 972.71,
   "end": 973.89,
   "text": "לא ידעתם את פתרון החידה."
  },
  {
   "start": 973.89,
   "end": 977.05,
   "text": "שמשון חש כל כך פגוע,"
  },
  {
   "start": 978.71,
   "end": 980.33,
   "text": "הוא כל כך טרח ועמל,"
  },
  {
   "start": 981.23,
   "end": 982.11,
   "text": "גייר את אשתו,"
  },
  {
   "start": 982.63,
   "end": 984.99,
   "text": "כשתהיה אשתו שלו, רק שלו,"
  },
  {
   "start": 985.57,
   "end": 986.67,
   "text": "שומרת אמונים,"
  },
  {
   "start": 987.35,
   "end": 988.77,
   "text": "שומרת סוד רק שלו."
  },
  {
   "start": 989.97,
   "end": 992.69,
   "text": "והנה, עוד לפני שנוצר איזה קשר כלשהו,"
  },
  {
   "start": 993.63,
   "end": 994.61,
   "text": "בגידה כל כך צורבת,"
  },
  {
   "start": 996.19,
   "end": 997.33,
   "text": "באמון שנתן בה,"
  },
  {
   "start": 1000.42,
   "end": 1001.4,
   "text": "ושמשון זועם."
  },
  {
   "start": 1002.86,
   "end": 1003.16,
   "text": "והם,"
  },
  {
   "start": 1004.08,
   "end": 1004.6,
   "text": "הם לא מוותרים,"
  },
  {
   "start": 1005.6,
   "end": 1007.16,
   "text": "אנחנו ממתינים למה שהבטחת,"
  },
  {
   "start": 1008.56,
   "end": 1010.78,
   "text": "שלושים סדינים, שלושים חבילות."
  },
  {
   "start": 1013.46,
   "end": 1015.14,
   "text": "שמשון נוטש בזעם את תמנת,"
  },
  {
   "start": 1016.14,
   "end": 1018.5,
   "text": "ופוסע אל אשקלון הסמוכה."
  },
  {
   "start": 1020.56,
   "end": 1021.06,
   "text": "שם לפתע,"
  },
  {
   "start": 1022.68,
   "end": 1023.56,
   "text": "כך באמצע הדרך,"
  },
  {
   "start": 1024.18,
   "end": 1025.84,
   "text": "הוא נתקל בחבורת פלישתים צוהלת,"
  },
  {
   "start": 1026.72,
   "end": 1028.16,
   "text": "שחוסמת לו את הדרך,"
  },
  {
   "start": 1032.99,
   "end": 1035.83,
   "text": "ואז הוא התפרץ בחמת סעם."
  },
  {
   "start": 1037.59,
   "end": 1038.69,
   "text": "תוך דקות סבורות,"
  },
  {
   "start": 1039.49,
   "end": 1044.35,
   "text": "תוך דקות ספורות האזור היה זרוע גופות מרוטשות של פלישתים."
  },
  {
   "start": 1052.91,
   "end": 1053.47,
   "text": "בינתיים,"
  },
  {
   "start": 1064.04,
   "end": 1064.92,
   "text": "בינתיים בתמנת,"
  },
  {
   "start": 1065.86,
   "end": 1067.76,
   "text": "החיים ממשיכים במתכונתם הרגילה."
  },
  {
   "start": 1069.68,
   "end": 1072.84,
   "text": "שלושים החברים מסובים סביב שולחן ארוך,"
  },
  {
   "start": 1073.4,
   "end": 1074.4,
   "text": "אוכלים וצוהלים."
  },
  {
   "start": 1078.62,
   "end": 1080.04,
   "text": "נראה ששום דבר לא יזיז להם,"
  },
  {
   "start": 1080.68,
   "end": 1082.88,
   "text": "לא ישנה, לא יפר את השלווה שלהם."
  },
  {
   "start": 1086.23,
   "end": 1086.61,
   "text": "אז לפתע,"
  },
  {
   "start": 1088.9,
   "end": 1091.86,
   "text": "בקול רעש מחריש אוזניים,"
  },
  {
   "start": 1093.22,
   "end": 1095.9,
   "text": "ניחתות להן 30 חליפות"
  },
  {
   "start": 1097.64,
   "end": 1100.7,
   "text": "של פלישתים מתים על השולחן."
  },
  {
   "start": 1104.21,
   "end": 1105.05,
   "text": "שמשון מופיע."
  },
  {
   "start": 1105.95,
   "end": 1106.25,
   "text": "קחו,"
  },
  {
   "start": 1107.29,
   "end": 1108.71,
   "text": "חצי ממה שהבטחתי לכם,"
  },
  {
   "start": 1109.93,
   "end": 1110.91,
   "text": "זה מה שמגיע לכם."
  },
  {
   "start": 1113.55,
   "end": 1114.77,
   "text": "והם בויים בתדהמה בחליפות."
  },
  {
   "start": 1119.15,
   "end": 1120.83,
   "text": "30 חליפות של פלישתים"
  },
  {
   "start": 1124.62,
   "end": 1125.4,
   "text": "שנלקחו"
  },
  {
   "start": 1127.18,
   "end": 1130.36,
   "text": "מאותם פלישתים מאשקלון שמתו."
  },
  {
   "start": 1131.26,
   "end": 1132.82,
   "text": "ושמשון עוזב את אמנת,"
  },
  {
   "start": 1133.6,
   "end": 1134.8,
   "text": "חוזר הביתה להירגע,"
  },
  {
   "start": 1137.01,
   "end": 1137.99,
   "text": "להירגע מהכאב,"
  },
  {
   "start": 1140.07,
   "end": 1143.63,
   "text": "מהבגידה שאשתו גילתה את מצפוני ליבו,"
  },
  {
   "start": 1144.69,
   "end": 1148.67,
   "text": "ומהיחס שקיבל מפלישתי."
  },
  {
   "start": 1182.91,
   "end": 1185.13,
   "text": "שמשון חזר הביתה,"
  },
  {
   "start": 1186.93,
   "end": 1188.03,
   "text": "נמצא בבית הוריו."
  },
  {
   "start": 1190.53,
   "end": 1195.55,
   "text": "זה הזמן להתחזק בתורה ומצוות."
  },
  {
   "start": 1196.17,
   "end": 1198.15,
   "text": "זה הזמן לחשוב ולהירגע."
  },
  {
   "start": 1201.0,
   "end": 1205.86,
   "text": "ואכן, מקץ זמן מה שמשון חוזר אל תמנת."
  },
  {
   "start": 1207.22,
   "end": 1208.26,
   "text": "רוצה לקחת את אשתו,"
  },
  {
   "start": 1209.12,
   "end": 1210.0,
   "text": "לפייס אותה,"
  },
  {
   "start": 1211.62,
   "end": 1214.78,
   "text": "להתחיל בבניית חיים חדשים איתה,"
  },
  {
   "start": 1221.52,
   "end": 1222.7,
   "text": "לבנות קן משותף,"
  },
  {
   "start": 1223.92,
   "end": 1225.3,
   "text": "בית יהודי חם,"
  },
  {
   "start": 1226.04,
   "end": 1227.1,
   "text": "בית יהודי אוהב,"
  },
  {
   "start": 1227.86,
   "end": 1229.46,
   "text": "לתת סיכוי, לתת תקווה."
  },
  {
   "start": 1231.98,
   "end": 1234.58,
   "text": "הוא מגיע אל בית אבא של אשתו,"
  },
  {
   "start": 1237.64,
   "end": 1237.9,
   "text": "שלום."
  },
  {
   "start": 1238.76,
   "end": 1239.42,
   "text": "היכן אשתי?"
  },
  {
   "start": 1240.32,
   "end": 1241.38,
   "text": "באתי לקחת את אשתי,"
  },
  {
   "start": 1242.12,
   "end": 1242.96,
   "text": "באתי לדבר איתה."
  },
  {
   "start": 1244.86,
   "end": 1249.18,
   "text": "ואז הוא ראה את האבא מגמגם במבוכה, תראה,"
  },
  {
   "start": 1250.12,
   "end": 1250.68,
   "text": "מה קרה?"
  },
  {
   "start": 1252.26,
   "end": 1253.74,
   "text": "שמשון מבין שמשהו קרה."
  },
  {
   "start": 1254.88,
   "end": 1256.7,
   "text": "שמשון מתחיל לחפש אחרי אשתו,"
  },
  {
   "start": 1259.34,
   "end": 1263.96,
   "text": "ואז נודע לו האמת המרה."
  },
  {
   "start": 1265.36,
   "end": 1266.74,
   "text": "אשתו של שמשון"
  },
  {
   "start": 1268.16,
   "end": 1272.34,
   "text": "ניתנה לראש החברים שהיו בחתונתם,"
  },
  {
   "start": 1272.9,
   "end": 1274.62,
   "text": "לשושבין של שמשון,"
  },
  {
   "start": 1275.32,
   "end": 1275.9,
   "text": "לאישה."
  },
  {
   "start": 1277.64,
   "end": 1278.94,
   "text": "אשתו של שמשון"
  },
  {
   "start": 1280.0,
   "end": 1285.9,
   "text": "ניתנה כאישה לפלישתי, ראש החבורה שם,"
  },
  {
   "start": 1291.2,
   "end": 1292.94,
   "text": "והכל התנפץ לו באחת."
  },
  {
   "start": 1294.46,
   "end": 1295.56,
   "text": "גזלו את אשתו ממנו."
  },
  {
   "start": 1297.12,
   "end": 1297.76,
   "text": "בלב קר"
  },
  {
   "start": 1299.12,
   "end": 1299.98,
   "text": "כל התקוות נגוזו."
  },
  {
   "start": 1303.39,
   "end": 1307.37,
   "text": "מעטה של חושך עפף את שמשון המיוסר."
  },
  {
   "start": 1307.37,
   "end": 1309.45,
   "text": "כואב ופגוע,"
  },
  {
   "start": 1310.23,
   "end": 1312.27,
   "text": "הפלישתים חיללו את קדושת נישואיו,"
  },
  {
   "start": 1313.65,
   "end": 1315.65,
   "text": "וכולם מסביב ידעו את זה,"
  },
  {
   "start": 1316.17,
   "end": 1317.89,
   "text": "ולאף אחד לא היה אכפת,"
  },
  {
   "start": 1318.83,
   "end": 1321.43,
   "text": "אלא כולם שם שמחו ושיתפו פעולה."
  },
  {
   "start": 1324.14,
   "end": 1325.8,
   "text": "הם ישלמו על זה."
  },
  {
   "start": 1327.14,
   "end": 1328.32,
   "text": "הם ישלמו על זה."
  },
  {
   "start": 1345.82,
   "end": 1346.78,
   "text": "את הכאב הזה,"
  },
  {
   "start": 1353.42,
   "end": 1353.72,
   "text": "הכאב"
  },
  {
   "start": 1355.32,
   "end": 1356.7,
   "text": "שמניע את שמשון"
  },
  {
   "start": 1357.68,
   "end": 1358.78,
   "text": "לבצע את תפקידו"
  },
  {
   "start": 1360.1,
   "end": 1361.06,
   "text": "לנקום בפלישתים."
  },
  {
   "start": 1370.62,
   "end": 1371.3,
   "text": "אחת החיות,"
  },
  {
   "start": 1372.8,
   "end": 1373.76,
   "text": "בין בעלי החיים,"
  },
  {
   "start": 1374.42,
   "end": 1376.12,
   "text": "שיודעת יותר מכל להתחמק"
  },
  {
   "start": 1376.84,
   "end": 1377.68,
   "text": "היטב מרודפיה,"
  },
  {
   "start": 1378.42,
   "end": 1378.96,
   "text": "זה השועל."
  },
  {
   "start": 1380.08,
   "end": 1381.44,
   "text": "כל כך קשה לתפוס אותו,"
  },
  {
   "start": 1382.14,
   "end": 1383.14,
   "text": "כל כך קשה לצוד אותו."
  },
  {
   "start": 1384.78,
   "end": 1385.94,
   "text": "שמשון צד שועלים,"
  },
  {
   "start": 1388.14,
   "end": 1388.64,
   "text": "לא אחד,"
  },
  {
   "start": 1390.02,
   "end": 1390.62,
   "text": "גם לא שניים."
  },
  {
   "start": 1391.52,
   "end": 1392.9,
   "text": "שלוש מאות שועלים,"
  },
  {
   "start": 1396.12,
   "end": 1396.46,
   "text": "איזו עוצמה."
  },
  {
   "start": 1398.32,
   "end": 1401.98,
   "text": "והוא לוקח וקושר כל שני שועלים בזנבות שלהם,"
  },
  {
   "start": 1402.88,
   "end": 1405.28,
   "text": "ואל הזנבות שלהם הוא הצמיד לפיד בוער."
  },
  {
   "start": 1407.2,
   "end": 1409.44,
   "text": "ואז הוא לוקח את השועלים, 300 שועלים,"
  },
  {
   "start": 1410.46,
   "end": 1412.0,
   "text": "ומשחרר את השועלים,"
  },
  {
   "start": 1412.6,
   "end": 1416.18,
   "text": "היישר אל מטעי היבול והתבואה של פלישתים,"
  },
  {
   "start": 1417.12,
   "end": 1417.74,
   "text": "היישר"
  },
  {
   "start": 1418.42,
   "end": 1420.6,
   "text": "אל העושר הפלישתי, אל התבואה,"
  },
  {
   "start": 1421.66,
   "end": 1423.84,
   "text": "אל המזון, אל הכלכלה,"
  },
  {
   "start": 1424.74,
   "end": 1426.6,
   "text": "אל מחסני הכלכלה של פלישתים."
  },
  {
   "start": 1428.44,
   "end": 1428.82,
   "text": "השועל"
  },
  {
   "start": 1429.44,
   "end": 1430.86,
   "text": "נוהג לחזור לאחוריו,"
  },
  {
   "start": 1431.68,
   "end": 1434.52,
   "text": "שני שואלים שקשורים יוצרים מעגל,"
  },
  {
   "start": 1435.54,
   "end": 1437.02,
   "text": "מעגל של אש,"
  },
  {
   "start": 1439.3,
   "end": 1442.28,
   "text": "לו משאירים מטר על מטר של תבואה"
  },
  {
   "start": 1444.24,
   "end": 1447.24,
   "text": "ללא נחלי אש,"
  },
  {
   "start": 1447.9,
   "end": 1448.8,
   "text": "נחשולים של אש,"
  },
  {
   "start": 1450.36,
   "end": 1461.5,
   "text": "חורבן כלכלי תוך שעות ספורות נוחתת מכה כלכלית אדירה על כל שדות התבואה"
  },
  {
   "start": 1462.2,
   "end": 1463.7,
   "text": "המפורסמים של פלישתי."
  },
  {
   "start": 1466.0,
   "end": 1469.76,
   "text": "ממדי האסון הכלכלי שניחת על פלישתים היו כבדים מנשוא,"
  },
  {
   "start": 1470.92,
   "end": 1472.16,
   "text": "ועד מהרה מתפרסם"
  },
  {
   "start": 1474.53,
   "end": 1480.31,
   "text": "שהמבצע של כל זה זהו שמשון שנוקם בהם על אשתו,"
  },
  {
   "start": 1481.03,
   "end": 1482.93,
   "text": "על שגזלו את אשתו ולקחו אותה."
  },
  {
   "start": 1484.91,
   "end": 1485.91,
   "text": "נציגי פלישתים"
  },
  {
   "start": 1486.91,
   "end": 1488.03,
   "text": "באים אל תמנת,"
  },
  {
   "start": 1492.4,
   "end": 1496.68,
   "text": "כואבים את האובדן הכלכלי, את החורבן הכלכלי ששמשון"
  },
  {
   "start": 1497.92,
   "end": 1498.18,
   "text": "הטיל"
  },
  {
   "start": 1499.38,
   "end": 1500.1,
   "text": "על פלישתים."
  },
  {
   "start": 1500.74,
   "end": 1505.14,
   "text": "הם תופסים את אבא של הכלה ושורפים אותו לעיני כולם"
  },
  {
   "start": 1506.16,
   "end": 1508.4,
   "text": "ואת כל הבית שלו הם שורפים באש."
  },
  {
   "start": 1510.24,
   "end": 1511.78,
   "text": "אחר כך הם תופסים את הכלה,"
  },
  {
   "start": 1513.02,
   "end": 1514.16,
   "text": "את אשתו של שמשון,"
  },
  {
   "start": 1515.1,
   "end": 1516.8,
   "text": "ושורפים גם אותה באש."
  },
  {
   "start": 1520.52,
   "end": 1520.8,
   "text": "איך?"
  },
  {
   "start": 1521.34,
   "end": 1522.64,
   "text": "איך סיבכת אותנו"
  },
  {
   "start": 1524.5,
   "end": 1525.36,
   "text": "עם שמשון?"
  },
  {
   "start": 1529.21,
   "end": 1529.69,
   "text": "ואז"
  },
  {
   "start": 1531.61,
   "end": 1532.63,
   "text": "אותם פלישתים,"
  },
  {
   "start": 1533.51,
   "end": 1534.83,
   "text": "אותו גדוד של פלישתים,"
  },
  {
   "start": 1538.9,
   "end": 1541.18,
   "text": "מסב את פניו, המטרה היא הפעם שמשון."
  },
  {
   "start": 1542.56,
   "end": 1543.62,
   "text": "הם שרפו את בית אשתו,"
  },
  {
   "start": 1545.08,
   "end": 1545.62,
   "text": "את אשתו,"
  },
  {
   "start": 1546.16,
   "end": 1546.68,
   "text": "את אביה."
  },
  {
   "start": 1548.08,
   "end": 1549.28,
   "text": "עכשיו המטרה היא שמשון,"
  },
  {
   "start": 1550.54,
   "end": 1553.9,
   "text": "וגדוד הפלישתים מקיף את סביבותיו של שמשון."
  },
  {
   "start": 1557.71,
   "end": 1558.13,
   "text": "שמשון"
  },
  {
   "start": 1559.17,
   "end": 1559.75,
   "text": "לא בורח."
  },
  {
   "start": 1560.81,
   "end": 1561.79,
   "text": "הוא קם ואומר להם,"
  },
  {
   "start": 1564.67,
   "end": 1566.87,
   "text": "אם אתם הייתם עושים כך קודם,"
  },
  {
   "start": 1567.71,
   "end": 1571.49,
   "text": "אם הייתם דואגים לטפל בהם קודם,"
  },
  {
   "start": 1572.83,
   "end": 1574.79,
   "text": "שלא לדאוג שלא יקרה דברים כאלה,"
  },
  {
   "start": 1575.27,
   "end": 1576.27,
   "text": "שלא יגזלו את אשתי,"
  },
  {
   "start": 1576.65,
   "end": 1579.41,
   "text": "שלא יפגעו בי כך פעם אחרי פעם,"
  },
  {
   "start": 1579.89,
   "end": 1583.41,
   "text": "ולא יפגעו בעם ישראל פעם אחרי פעם, הייתי שותק."
  },
  {
   "start": 1584.93,
   "end": 1585.49,
   "text": "אבל עכשיו"
  },
  {
   "start": 1586.11,
   "end": 1589.33,
   "text": "אני לא אפסיק עד שאני אפרע גם מכם."
  },
  {
   "start": 1591.63,
   "end": 1593.73,
   "text": "ורוח השם מפעמת לה בשמשון."
  },
  {
   "start": 1595.39,
   "end": 1595.97,
   "text": "והוא יוצא,"
  },
  {
   "start": 1596.89,
   "end": 1599.05,
   "text": "יוצא אל מולם למלחמה."
  },
  {
   "start": 1612.2,
   "end": 1613.32,
   "text": "מסתמנת לה תוצאה."
  },
  {
   "start": 1614.88,
   "end": 1615.5,
   "text": "הפלישתים"
  },
  {
   "start": 1616.4,
   "end": 1618.14,
   "text": "מוכים שוק על ירך."
  },
  {
   "start": 1619.58,
   "end": 1620.46,
   "text": "שוק על ירך."
  },
  {
   "start": 1621.28,
   "end": 1623.4,
   "text": "חלק הימיהם היה רכוב על סוסים."
  },
  {
   "start": 1624.42,
   "end": 1625.52,
   "text": "שמשון הלם בהם,"
  },
  {
   "start": 1626.16,
   "end": 1626.66,
   "text": "בירכיים."
  },
  {
   "start": 1628.84,
   "end": 1630.7,
   "text": "ואלו שהלכו ברגליים שלהם,"
  },
  {
   "start": 1631.82,
   "end": 1633.7,
   "text": "שמשון היכה אותם בשוקיים שלהם,"
  },
  {
   "start": 1635.22,
   "end": 1636.42,
   "text": "והם נשארים נכים."
  },
  {
   "start": 1640.57,
   "end": 1641.89,
   "text": "אלו שברחו משדה הקרב,"
  },
  {
   "start": 1642.43,
   "end": 1644.93,
   "text": "בפחד איום, ראו את העוצמה של שמשון."
  },
  {
   "start": 1645.41,
   "end": 1646.97,
   "text": "אי אפשר לנצח אחד כזה."
  },
  {
   "start": 1648.83,
   "end": 1649.41,
   "text": "מהפחד,"
  },
  {
   "start": 1650.03,
   "end": 1651.75,
   "text": "שהם ברחו בפחד איום מהלחץ."
  },
  {
   "start": 1652.75,
   "end": 1654.89,
   "text": "בדרך חלקם נפלו על פניהם,"
  },
  {
   "start": 1655.59,
   "end": 1656.45,
   "text": "והשוק שלהם"
  },
  {
   "start": 1657.09,
   "end": 1658.55,
   "text": "נכפף לו על ירחם."
  },
  {
   "start": 1660.13,
   "end": 1661.51,
   "text": "והפלישתים הוכו,"
  },
  {
   "start": 1662.35,
   "end": 1664.31,
   "text": "והפלישתים הוכו שוק על ירך."
  },
  {
   "start": 1670.09,
   "end": 1672.43,
   "text": "דבר המפלה מתפרסם בכל ארץ ישראל,"
  },
  {
   "start": 1673.93,
   "end": 1674.59,
   "text": "וגם בפלישתים,"
  },
  {
   "start": 1683.77,
   "end": 1684.71,
   "text": "בארץ ישראל."
  },
  {
   "start": 1686.03,
   "end": 1687.79,
   "text": "ארץ זרועת פחד."
  },
  {
   "start": 1689.67,
   "end": 1690.31,
   "text": "מפלישתים"
  },
  {
   "start": 1690.31,
   "end": 1692.87,
   "text": "עושה את דרכו יהודי,"
  },
  {
   "start": 1694.49,
   "end": 1695.21,
   "text": "יהודי בודד,"
  },
  {
   "start": 1696.45,
   "end": 1697.27,
   "text": "עושה את דרכו"
  },
  {
   "start": 1698.19,
   "end": 1699.27,
   "text": "אל עבר נקרת"
  },
  {
   "start": 1700.51,
   "end": 1701.49,
   "text": "סלע עטם."
  },
  {
   "start": 1702.99,
   "end": 1703.81,
   "text": "שם במקום הזה,"
  },
  {
   "start": 1704.53,
   "end": 1705.71,
   "text": "בנקרת סלע עטם,"
  },
  {
   "start": 1706.93,
   "end": 1707.73,
   "text": "יושב שם"
  },
  {
   "start": 1709.37,
   "end": 1710.75,
   "text": "ומתבודד עם בוראו."
  },
  {
   "start": 1712.79,
   "end": 1713.63,
   "text": "שמשון הצדיק,"
  },
  {
   "start": 1714.65,
   "end": 1715.85,
   "text": "שסובל כל כך,"
  },
  {
   "start": 1716.79,
   "end": 1717.93,
   "text": "יושב לו שם בדד,"
  },
  {
   "start": 1720.35,
   "end": 1721.57,
   "text": "ואתם יודעים מה מפריע לו?"
  },
  {
   "start": 1722.65,
   "end": 1724.07,
   "text": "ממה הוא חושש? שמשון מפחד."
  },
  {
   "start": 1725.25,
   "end": 1728.73,
   "text": "שמשון מפחד שמא יבואו האחים שלו"
  },
  {
   "start": 1729.39,
   "end": 1731.89,
   "text": "מבני יהודה ויכעסו עליו,"
  },
  {
   "start": 1732.41,
   "end": 1736.41,
   "text": "שגרם לפלישתים לפחד מישראל, להילחץ,"
  },
  {
   "start": 1736.83,
   "end": 1739.45,
   "text": "ועכשיו פלישתים יציקו יותר לישראל."
  },
  {
   "start": 1742.11,
   "end": 1745.05,
   "text": "והחשש הגדול של שמשון מאז שהוא ילד קטן,"
  },
  {
   "start": 1746.23,
   "end": 1749.77,
   "text": "שמשון אוהבם של ישראל, החשש הגדול שמא,"
  },
  {
   "start": 1750.23,
   "end": 1751.15,
   "text": "חס וחלילה,"
  },
  {
   "start": 1751.81,
   "end": 1752.43,
   "text": "הוא יפגע"
  },
  {
   "start": 1753.41,
   "end": 1756.33,
   "text": "או ייפגע איזה יהודי, חס וחלילה ממנו."
  },
  {
   "start": 1762.34,
   "end": 1765.74,
   "text": "כל השנים נזהר שמשון מלהקפיד על אדם מישראל."
  },
  {
   "start": 1767.46,
   "end": 1769.44,
   "text": "שמשון, כשגילה את הכוח העצום שלו,"
  },
  {
   "start": 1770.04,
   "end": 1770.92,
   "text": "הוא היה כל כך רגיש,"
  },
  {
   "start": 1772.04,
   "end": 1772.96,
   "text": "היה תמיד מוותר,"
  },
  {
   "start": 1773.54,
   "end": 1782.74,
   "text": "לא נכנס להקפדות, למריבות עם שום יהודי, ושחס וחלילה לא יצטרך להיפגע אותו אחד מהכוח שחנן אותו השם,"
  },
  {
   "start": 1783.32,
   "end": 1783.9,
   "text": "את שמשון."
  },
  {
   "start": 1783.9,
   "end": 1787.76,
   "text": "ועכשיו הוא יושב פשוט מפחד"
  },
  {
   "start": 1788.42,
   "end": 1791.0,
   "text": "שחס וחלילה לא יבואו מעם ישראל"
  },
  {
   "start": 1792.86,
   "end": 1794.2,
   "text": "הוא יצטרך לפגוע בהם."
  },
  {
   "start": 1796.06,
   "end": 1807.49,
   "text": "הוא יושב מתבודד וחושש וחששותיו של שמשון מתעמתות."
  },
  {
   "start": 1809.15,
   "end": 1810.61,
   "text": "צבא של פלישתים"
  },
  {
   "start": 1811.45,
   "end": 1818.64,
   "text": "עולים על יהודה וכל בני יהודה נלחצים מה קרה?"
  },
  {
   "start": 1819.1,
   "end": 1819.76,
   "text": "מה עשינו?"
  },
  {
   "start": 1821.2,
   "end": 1824.96,
   "text": "והפלישתים דורשים מבני יהודה,"
  },
  {
   "start": 1825.66,
   "end": 1825.96,
   "text": "אתם,"
  },
  {
   "start": 1826.7,
   "end": 1828.42,
   "text": "אתם תאסרו את שמשון,"
  },
  {
   "start": 1829.06,
   "end": 1830.62,
   "text": "שמשון היהודי שלכם."
  },
  {
   "start": 1831.16,
   "end": 1833.98,
   "text": "אתם תאסרו אותו, ותסגירו אותו לידינו,"
  },
  {
   "start": 1834.34,
   "end": 1836.52,
   "text": "ואם לא רעב המר יחר איתכם."
  },
  {
   "start": 1839.52,
   "end": 1840.56,
   "text": "והם לא יודעים מה לעשות."
  },
  {
   "start": 1841.48,
   "end": 1842.18,
   "text": "מה אתה יכול לעשות?"
  },
  {
   "start": 1848.12,
   "end": 1848.54,
   "text": "וכך,"
  },
  {
   "start": 1849.74,
   "end": 1850.44,
   "text": "אין ברירה,"
  },
  {
   "start": 1855.94,
   "end": 1862.6,
   "text": "שלושת אלפים יהודים יוצאים"
  },
  {
   "start": 1863.42,
   "end": 1864.44,
   "text": "אחר שמשון."
  },
  {
   "start": 1865.96,
   "end": 1867.14,
   "text": "שלושת אלפים יהודים"
  },
  {
   "start": 1868.36,
   "end": 1869.44,
   "text": "אחרי שמשון"
  },
  {
   "start": 1870.32,
   "end": 1871.94,
   "text": "יוצאים אחרי שמשון"
  },
  {
   "start": 1872.54,
   "end": 1873.6,
   "text": "עם צער בלב"
  },
  {
   "start": 1874.48,
   "end": 1874.86,
   "text": "ופחד בעיניים."
  },
  {
   "start": 1876.06,
   "end": 1876.98,
   "text": "עושים את דרכם"
  },
  {
   "start": 1877.7,
   "end": 1879.18,
   "text": "אל סעיף סלע עטם,"
  },
  {
   "start": 1880.08,
   "end": 1881.26,
   "text": "שם יושב לו שמשון."
  },
  {
   "start": 1882.52,
   "end": 1883.6,
   "text": "לתפוס את שמשון,"
  },
  {
   "start": 1884.7,
   "end": 1886.18,
   "text": "את תקוותם של ישראל"
  },
  {
   "start": 1887.76,
   "end": 1890.56,
   "text": "ולהסגיר אותו לפלישתים."
  },
  {
   "start": 1893.45,
   "end": 1899.53,
   "text": "וכך אולי להציל תינוקות של בית רבן שלא חטאו ומוות של יהודים רבים,"
  },
  {
   "start": 1900.85,
   "end": 1902.61,
   "text": "כי הפלישתים לא ירחמו על אף אחד."
  },
  {
   "start": 1904.53,
   "end": 1906.61,
   "text": "וכך עושים להם את דרכם"
  },
  {
   "start": 1908.8,
   "end": 1910.06,
   "text": "שלושת אלפים יהודים,"
  },
  {
   "start": 1910.94,
   "end": 1912.12,
   "text": "האחים של שמשון,"
  },
  {
   "start": 1913.04,
   "end": 1916.46,
   "text": "בדרך ללכוד את שמשון שכל כך כל כך אוהב אותם,"
  },
  {
   "start": 1917.44,
   "end": 1920.54,
   "text": "שכל ימיו חושש מלפגוע ביהודי."
  },
  {
   "start": 1954.03,
   "end": 1955.35,
   "text": "מה יקרה במפגש הזה?"
  },
  {
   "start": 1972.94,
   "end": 1973.16,
   "text": "עזה,"
  },
  {
   "start": 1974.22,
   "end": 1976.58,
   "text": "עזה עיר פלישתית מאז ומתמיד."
  },
  {
   "start": 1978.08,
   "end": 1981.12,
   "text": "מאז ומתמיד עיר שצופנת בחובה צרות."
  },
  {
   "start": 1983.36,
   "end": 1983.94,
   "text": "משהו פנימי"
  },
  {
   "start": 1985.0,
   "end": 1986.54,
   "text": "מושך את שמשון אל העיר הזו."
  },
  {
   "start": 1989.02,
   "end": 1992.11,
   "text": "המאבק בתוכו החל."
  },
  {
   "start": 1993.75,
   "end": 1994.57,
   "text": "שמשון היה זהיר."
  },
  {
   "start": 1996.49,
   "end": 1999.65,
   "text": "הוא ידע שכלל מספר אחד בקדושה"
  },
  {
   "start": 2000.39,
   "end": 2002.99,
   "text": "שמירת עיניים, שמור את העיניים."
  },
  {
   "start": 2003.83,
   "end": 2005.25,
   "text": "והוא הקפיד,"
  },
  {
   "start": 2005.91,
   "end": 2007.05,
   "text": "הוא היה בטוח שהוא לא ייכשל."
  },
  {
   "start": 2008.35,
   "end": 2009.67,
   "text": "אבל חזל הקדושים,"
  },
  {
   "start": 2010.43,
   "end": 2014.09,
   "text": "חזל הקדושים הזהירו את האדם, אל תיכנס לניסיון."
  },
  {
   "start": 2017.79,
   "end": 2020.97,
   "text": "שמשון היה בטוח שמדובר באדם רגיל,"
  },
  {
   "start": 2021.69,
   "end": 2022.69,
   "text": "אבל אצלו זה אחרת."
  },
  {
   "start": 2027.83,
   "end": 2028.03,
   "text": "אבל,"
  },
  {
   "start": 2029.67,
   "end": 2030.43,
   "text": "אבל שם,"
  },
  {
   "start": 2031.27,
   "end": 2031.93,
   "text": "שם בעזה."
  }
 ]
}