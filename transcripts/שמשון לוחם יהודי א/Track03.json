{
 "disc": "שמשון לוחם יהודי א",
 "track": "Track03",
 "duration": 708.168,
 "segments": [
  {
   "start": 20.08,
   "end": 42.07,
   "text": "המנוח לקח גדי עזים ומנחה ופשוט בונה לו,"
  },
  {
   "start": 45.07,
   "end": 45.95,
   "text": "מעלה לו קורבן."
  },
  {
   "start": 47.73,
   "end": 76.31,
   "text": "קורבן עולה לה שם וכך הם מתעסקים בקורבן והמלאך שהם חושבים שהוא נביא"
  },
  {
   "start": 77.57,
   "end": 79.49,
   "text": "או תלמיד חכם גדול"
  },
  {
   "start": 81.86,
   "end": 82.3,
   "text": "מביט בהם."
  },
  {
   "start": 90.96,
   "end": 95.84,
   "text": "ואז הם מדליקים את האש וכשהאש פורצת ועולה לה להאהבה,"
  },
  {
   "start": 96.76,
   "end": 97.1,
   "text": "מה עלה?"
  },
  {
   "start": 97.82,
   "end": 100.24,
   "text": "מעלה לכיוון טחול השמיים."
  },
  {
   "start": 104.6,
   "end": 105.58,
   "text": "הנביא המוזר הזה"
  },
  {
   "start": 106.36,
   "end": 107.46,
   "text": "עולה על המזבח,"
  },
  {
   "start": 110.22,
   "end": 111.3,
   "text": "עולה על המזבח,"
  },
  {
   "start": 112.36,
   "end": 114.06,
   "text": "ונכנס כולו,"
  },
  {
   "start": 114.76,
   "end": 116.92,
   "text": "אבל כולו, אל הלהבה,"
  },
  {
   "start": 117.5,
   "end": 118.86,
   "text": "אל תוך האש,"
  },
  {
   "start": 119.42,
   "end": 121.1,
   "text": "ודרך האש הוא עולה,"
  },
  {
   "start": 121.72,
   "end": 124.5,
   "text": "עולה ומסתלסל לו השמיים,"
  },
  {
   "start": 126.66,
   "end": 127.76,
   "text": "פלאי פלאות,"
  },
  {
   "start": 128.5,
   "end": 132.62,
   "text": "ומנוח ואשתו ברגע שהם ראו את אותו,"
  },
  {
   "start": 133.94,
   "end": 140.94,
   "text": "עולה דרך האש אל מרומי שמיים."
  },
  {
   "start": 142.02,
   "end": 142.54,
   "text": "הם הבינו,"
  },
  {
   "start": 143.22,
   "end": 143.82,
   "text": "זה לא איש,"
  },
  {
   "start": 144.5,
   "end": 145.14,
   "text": "גם לא נביא,"
  },
  {
   "start": 145.84,
   "end": 147.7,
   "text": "זה מלאך השם צבקות."
  },
  {
   "start": 148.86,
   "end": 150.0,
   "text": "והם נפלו על פניהם,"
  },
  {
   "start": 154.7,
   "end": 155.32,
   "text": "ונפלו על פניהם."
  },
  {
   "start": 156.94,
   "end": 158.06,
   "text": "אמרו חזל הקדושים,"
  },
  {
   "start": 159.0,
   "end": 160.42,
   "text": "אתם יודעים מי זה אותו מלאך היה?"
  },
  {
   "start": 161.22,
   "end": 163.82,
   "text": "זה אותו מלאך שבא לבשר על הולדת יצחק."
  },
  {
   "start": 164.94,
   "end": 167.08,
   "text": "אבל אותו מלאך פשוט נשלח במדויק,"
  },
  {
   "start": 167.72,
   "end": 168.96,
   "text": "לך תודיע ליצחק,"
  },
  {
   "start": 169.88,
   "end": 170.96,
   "text": "שיוולד לו"
  },
  {
   "start": 172.7,
   "end": 174.84,
   "text": "בן, לך תודיע לאברהם, סליחה, שיוולד לו בן."
  },
  {
   "start": 178.46,
   "end": 181.12,
   "text": "ואותו מלאך הלך ושינה מעט מהשליחות שלו."
  },
  {
   "start": 181.84,
   "end": 183.14,
   "text": "הוא הגיע קודם לסרה."
  },
  {
   "start": 184.32,
   "end": 186.38,
   "text": "לא ביצעת במדויק את השליחות שלך?"
  },
  {
   "start": 187.2,
   "end": 192.48,
   "text": "אותו מלאך לא יכל לעלות חזרה למעלה אל המקום שלו בגנזי מרומים"
  },
  {
   "start": 193.1,
   "end": 196.18,
   "text": "עד אותו יום עם מנוח ורעייתו."
  },
  {
   "start": 197.8,
   "end": 199.24,
   "text": "אז הוא נשלח לבשר להם"
  },
  {
   "start": 201.49,
   "end": 202.69,
   "text": "שיוולד להם בן."
  },
  {
   "start": 204.09,
   "end": 204.97,
   "text": "נזיר מבטן."
  },
  {
   "start": 219.85,
   "end": 220.27,
   "text": "ואכן,"
  },
  {
   "start": 221.59,
   "end": 222.41,
   "text": "עברה שנה,"
  },
  {
   "start": 225.0,
   "end": 225.88,
   "text": "ואצל האלפונית"
  },
  {
   "start": 227.68,
   "end": 228.7,
   "text": "יולדת בן."
  },
  {
   "start": 231.21,
   "end": 232.03,
   "text": "כשהבן נולד,"
  },
  {
   "start": 233.05,
   "end": 234.13,
   "text": "היא רואה את זיו יופיו,"
  },
  {
   "start": 234.93,
   "end": 236.21,
   "text": "היא זוכרת את דברי המלאך,"
  },
  {
   "start": 237.37,
   "end": 239.27,
   "text": "והוא יחל להושיע את ישראל."
  },
  {
   "start": 242.62,
   "end": 242.64,
   "text": "אז"
  },
  {
   "start": 243.22,
   "end": 244.76,
   "text": "אמו מרימה את התינוק"
  },
  {
   "start": 247.35,
   "end": 249.11,
   "text": "ומחליטה לקרוא לו בשם שמשון."
  },
  {
   "start": 251.97,
   "end": 254.17,
   "text": "כמעין שמו של הקדוש ברוך הוא,"
  },
  {
   "start": 255.01,
   "end": 258.71,
   "text": "שנאמר כי שמש ומגן השם אלוקים,"
  },
  {
   "start": 259.79,
   "end": 260.49,
   "text": "היא קראה לו שמשון."
  },
  {
   "start": 264.56,
   "end": 265.56,
   "text": "ואותה צללפונית,"
  },
  {
   "start": 266.32,
   "end": 267.12,
   "text": "האמא הצדקת,"
  },
  {
   "start": 267.98,
   "end": 272.1,
   "text": "ששומרת על עצמה ושמרה כל כך על עצמה כל ההיריון,"
  },
  {
   "start": 272.64,
   "end": 274.06,
   "text": "היא התנזרה מכל יין,"
  },
  {
   "start": 274.52,
   "end": 277.48,
   "text": "מכל טומאה, השתדלה לשמוע רק דברי תורה,"
  },
  {
   "start": 278.0,
   "end": 280.14,
   "text": "רק להיחשף לדברים של קדושה."
  },
  {
   "start": 281.42,
   "end": 283.24,
   "text": "היא ידעה כמה זה משפיע על התינוק שבבטנה,"
  },
  {
   "start": 283.24,
   "end": 288.0,
   "text": "היא רק סחה את עצמה במעיינות הקדושה של עם ישראל."
  },
  {
   "start": 289.12,
   "end": 292.38,
   "text": "עתה היא מתבוננת בבן שלה, שגדל"
  },
  {
   "start": 294.4,
   "end": 294.98,
   "text": "וגדל"
  },
  {
   "start": 298.78,
   "end": 299.52,
   "text": "דבר אחד."
  },
  {
   "start": 303.67,
   "end": 305.89,
   "text": "היא ראתה רוצה לשאול את המלאך,"
  },
  {
   "start": 307.81,
   "end": 308.47,
   "text": "ולא שאלה"
  },
  {
   "start": 309.37,
   "end": 311.71,
   "text": "למה כל כך חשוב שהבן שלה"
  },
  {
   "start": 312.27,
   "end": 313.35,
   "text": "זה הבן המתוק שלה,"
  },
  {
   "start": 314.05,
   "end": 315.31,
   "text": "זה הבן הצדיק שלה,"
  },
  {
   "start": 316.01,
   "end": 319.67,
   "text": "למה כל כך חשוב שיהיה נזיר אלוקים מהבטן?"
  },
  {
   "start": 325.85,
   "end": 326.37,
   "text": "את זה המלאך"
  },
  {
   "start": 327.15,
   "end": 327.83,
   "text": "לא סיפר לה."
  },
  {
   "start": 328.99,
   "end": 329.47,
   "text": "מה זה משנה?"
  },
  {
   "start": 340.11,
   "end": 340.93,
   "text": "אילו רק ידעה"
  },
  {
   "start": 341.67,
   "end": 343.25,
   "text": "שהבן שלה, שמשון,"
  },
  {
   "start": 344.15,
   "end": 345.91,
   "text": "הוא נשמה כל כך גבוהה,"
  },
  {
   "start": 347.43,
   "end": 353.21,
   "text": "שהיא אותה נשמה באה לנסות ולהקים את נשמת משיח בן דן."
  },
  {
   "start": 354.71,
   "end": 356.61,
   "text": "משיח זה חושים,"
  },
  {
   "start": 357.33,
   "end": 359.81,
   "text": "שמשון היה נשמת חושים בן דן."
  },
  {
   "start": 360.69,
   "end": 361.75,
   "text": "חושים הרג את עשיו."
  },
  {
   "start": 363.15,
   "end": 364.69,
   "text": "חושים הרג את עשיו."
  },
  {
   "start": 365.23,
   "end": 367.43,
   "text": "שמשון היה נשמת חושים בן דן."
  },
  {
   "start": 368.55,
   "end": 369.43,
   "text": "אתה הרגת את עשיו."
  },
  {
   "start": 370.43,
   "end": 375.43,
   "text": "עכשיו שמשון ייאלץ להילחם עם לא פחות ולא יותר קליפת עשיו,"
  },
  {
   "start": 376.33,
   "end": 377.41,
   "text": "עם כוח התאווה."
  },
  {
   "start": 378.35,
   "end": 381.05,
   "text": "כוח עשיו היה ביופי בחוסר צניעות,"
  },
  {
   "start": 381.63,
   "end": 383.33,
   "text": "ושמשון יימשך"
  },
  {
   "start": 385.05,
   "end": 385.91,
   "text": "לכוחות אלו,"
  },
  {
   "start": 386.73,
   "end": 391.21,
   "text": "והוא יצטרך להתמודד עם ניסיונות ועם ניצוץ העשיו שבתוכו."
  },
  {
   "start": 391.79,
   "end": 393.45,
   "text": "לכן הוא צריך להיות נזיר מבטן,"
  },
  {
   "start": 394.01,
   "end": 395.93,
   "text": "כדי שיוכל להתמודד במלחמה הזאת."
  },
  {
   "start": 397.19,
   "end": 398.61,
   "text": "להתרחק כבר מעכשיו,"
  },
  {
   "start": 399.77,
   "end": 400.81,
   "text": "כדי שיהיה לו כוח."
  },
  {
   "start": 402.61,
   "end": 404.91,
   "text": "צריך לדעת שגם בדור שלנו, דור של משיח,"
  },
  {
   "start": 405.49,
   "end": 408.85,
   "text": "באמת רואים שההתמודדות שלנו היא עם קליפת עשיו,"
  },
  {
   "start": 409.61,
   "end": 411.79,
   "text": "עם כוח התאווה, עם חוסר הצניעות."
  },
  {
   "start": 412.71,
   "end": 417.47,
   "text": "אילו רק ידעה אותה אימא גדולה, אותה צדקת,"
  },
  {
   "start": 418.07,
   "end": 420.01,
   "text": "שהבן שלה, בנה האהוב,"
  },
  {
   "start": 420.53,
   "end": 426.11,
   "text": "צריך לתקן ולהתמודד עם מה שהותירו האבות הקדושים,"
  },
  {
   "start": 426.77,
   "end": 428.93,
   "text": "אברהם, יצחק ויעקב."
  },
  {
   "start": 430.15,
   "end": 432.61,
   "text": "עם זה שמשון יצטרך להתמודד"
  },
  {
   "start": 434.73,
   "end": 435.67,
   "text": "עם אותן כוחות אפלים."
  },
  {
   "start": 437.59,
   "end": 440.83,
   "text": "אילו רק ידעה אותה אימא צדקת, שהבן שלה,"
  },
  {
   "start": 441.65,
   "end": 443.25,
   "text": "הבן של היחיד, שמשון."
  },
  {
   "start": 443.95,
   "end": 445.43,
   "text": "יש בו נשמה כל כך גבוהה,"
  },
  {
   "start": 446.27,
   "end": 447.71,
   "text": "שהוטלה בה כל כך הרבה תיקונים,"
  },
  {
   "start": 448.65,
   "end": 451.23,
   "text": "ואפילו את נשמת נדב הכהן."
  },
  {
   "start": 451.93,
   "end": 453.71,
   "text": "נדב הכהן בן אהרון הכהן,"
  },
  {
   "start": 454.13,
   "end": 455.05,
   "text": "שמת במדבר,"
  },
  {
   "start": 455.41,
   "end": 457.83,
   "text": "כי הוא נכנס שטוי יין למקדש,"
  },
  {
   "start": 458.27,
   "end": 460.83,
   "text": "והוא גם סירב לשאת אישה מעם ישראל."
  },
  {
   "start": 461.45,
   "end": 462.67,
   "text": "ועכשיו שמשון."
  },
  {
   "start": 463.43,
   "end": 465.75,
   "text": "שמשון יצטרך לתקן את זה, את נשמת נדב,"
  },
  {
   "start": 466.55,
   "end": 468.01,
   "text": "על ידי התנזרות מיין,"
  },
  {
   "start": 468.73,
   "end": 473.41,
   "text": "ולכן גם יצטרך להינשא להימשך לבת גויים דווקא."
  },
  {
   "start": 477.11,
   "end": 477.95,
   "text": "והוא שמשון,"
  },
  {
   "start": 478.63,
   "end": 480.19,
   "text": "בעל הנשמה המיוחדת כל כך."
  },
  {
   "start": 481.37,
   "end": 484.69,
   "text": "עליו מוטלים תיקונים וניסיונות כאלו."
  },
  {
   "start": 488.42,
   "end": 488.72,
   "text": "גם אנחנו,"
  },
  {
   "start": 489.7,
   "end": 493.24,
   "text": "אילו רק ידענו שכל הניסיונות והקשיים שלנו,"
  },
  {
   "start": 494.04,
   "end": 494.8,
   "text": "כן שלנו כאן,"
  },
  {
   "start": 495.46,
   "end": 496.02,
   "text": "בדור שלנו,"
  },
  {
   "start": 496.8,
   "end": 500.38,
   "text": "צריכים לדעת שככל שהאדם יש לו קשיים וניסיונות,"
  },
  {
   "start": 501.16,
   "end": 503.96,
   "text": "מתנוצצת בו נשמה כל כך קדושה,"
  },
  {
   "start": 504.74,
   "end": 505.7,
   "text": "כל כך גבוהה."
  },
  {
   "start": 507.16,
   "end": 508.34,
   "text": "אומר הארי הקדוש,"
  },
  {
   "start": 510.0,
   "end": 512.92,
   "text": "שככל שהנשמה יותר גבוהה,"
  },
  {
   "start": 513.48,
   "end": 514.62,
   "text": "ככה המאבק שלה,"
  },
  {
   "start": 515.3,
   "end": 516.38,
   "text": "הניסיונות שלה יותר גבוהים."
  },
  {
   "start": 518.54,
   "end": 523.16,
   "text": "וכל מה שאנחנו ממשיכים להילחם ולא מרפים ומשתדלים בקרב להשם יתברך,"
  },
  {
   "start": 523.64,
   "end": 524.66,
   "text": "לכבוד השם יתברך,"
  },
  {
   "start": 525.2,
   "end": 525.96,
   "text": "בלי פשרות,"
  },
  {
   "start": 526.78,
   "end": 528.06,
   "text": "באהבה להשם יתברך,"
  },
  {
   "start": 528.68,
   "end": 534.24,
   "text": "אנחנו מתקנים ובונים נשמות ועולמות עליונים ומקרבים את נשמת המשיח."
  },
  {
   "start": 535.12,
   "end": 536.6,
   "text": "צריך לדעת, לגויים"
  },
  {
   "start": 537.74,
   "end": 539.04,
   "text": "אין את הבעיות האלה,"
  },
  {
   "start": 539.84,
   "end": 541.02,
   "text": "כי אין להם מה לתקן הרבה"
  },
  {
   "start": 541.62,
   "end": 542.62,
   "text": "בעולמות עליונים."
  },
  {
   "start": 543.2,
   "end": 543.7,
   "text": "אבל בנו,"
  },
  {
   "start": 544.32,
   "end": 546.02,
   "text": "אנחנו הבנים של השם יתברך,"
  },
  {
   "start": 546.54,
   "end": 548.98,
   "text": "בידינו תלוי כל העולם, כל העולמות."
  },
  {
   "start": 549.58,
   "end": 550.68,
   "text": "אילו רק היינו יודעים את זה,"
  },
  {
   "start": 551.08,
   "end": 553.48,
   "text": "אבל באמת היינו מבינים את גודל נשמתנו,"
  },
  {
   "start": 553.86,
   "end": 555.22,
   "text": "היינו מאושרים כל היום."
  },
  {
   "start": 558.1,
   "end": 563.5,
   "text": "היינו אומרים לניסיונות שלנו, בואו, בואו, בואו עלינו. אם היינו רק מבינים את העוצמה של זה,"
  },
  {
   "start": 564.7,
   "end": 566.98,
   "text": "כך שמשון, עם נשמה כל כך גבוהה,"
  },
  {
   "start": 568.9,
   "end": 571.28,
   "text": "צריך להתמודד עם עוצמות"
  },
  {
   "start": 571.92,
   "end": 574.84,
   "text": "של יצרים ושל כוחות טומאה כל כך גדולים."
  },
  {
   "start": 588.56,
   "end": 589.86,
   "text": "וכך בארץ ישראל,"
  },
  {
   "start": 590.68,
   "end": 593.54,
   "text": "בני ישראל נאנקים תחת קובץ הרות פלישתים."
  },
  {
   "start": 594.72,
   "end": 595.76,
   "text": "ובמחנה דן,"
  },
  {
   "start": 596.82,
   "end": 599.5,
   "text": "אי שם במחנה דן, בן צורעה,"
  },
  {
   "start": 599.96,
   "end": 602.54,
   "text": "ובין אשתאול נסתובב לו נער,"
  },
  {
   "start": 603.82,
   "end": 604.16,
   "text": "נער מיוחד."
  },
  {
   "start": 606.04,
   "end": 608.82,
   "text": "ותחל רוח השם לפעמו."
  },
  {
   "start": 609.74,
   "end": 612.2,
   "text": "שמשון הנער חש באיזה רוח,"
  },
  {
   "start": 612.66,
   "end": 613.94,
   "text": "רוח מיוחדת גבורה,"
  },
  {
   "start": 614.4,
   "end": 616.7,
   "text": "רוח גבורת השם ננסחת בו מדי פעם."
  },
  {
   "start": 617.52,
   "end": 619.12,
   "text": "וכשפועמת בו הרוח הזו,"
  },
  {
   "start": 620.04,
   "end": 620.6,
   "text": "הוא היה מהרהר,"
  },
  {
   "start": 621.28,
   "end": 626.96,
   "text": "היו תופסות את מוחו מחשבות איך הוא הולך ונלחם בפלישתים,"
  },
  {
   "start": 627.36,
   "end": 630.1,
   "text": "שלא פוסקים מלצער את בני עמו האהובים,"
  },
  {
   "start": 631.12,
   "end": 633.08,
   "text": "את עם ישראל, את בנות ישראל."
  },
  {
   "start": 636.26,
   "end": 637.54,
   "text": "כך חולפים להם הימים,"
  },
  {
   "start": 638.46,
   "end": 640.26,
   "text": "ובין צורעה ובין אשתאול,"
  },
  {
   "start": 640.84,
   "end": 642.66,
   "text": "גודל יהודי רם ונישא"
  },
  {
   "start": 643.24,
   "end": 644.66,
   "text": "מבני עמו עם ישראל,"
  },
  {
   "start": 645.46,
   "end": 649.96,
   "text": "ורוח הקודש שורה עליו בצורה כל כך נכבדה,"
  },
  {
   "start": 650.86,
   "end": 653.9,
   "text": "עד שהיה היה רועד ומרטט,"
  },
  {
   "start": 655.02,
   "end": 657.16,
   "text": "ושערות ראשו היו מכות זו בזו,"
  },
  {
   "start": 657.7,
   "end": 659.82,
   "text": "וקולם היה נשמע למרחוק."
  },
  {
   "start": 661.26,
   "end": 666.54,
   "text": "כשרוח הקודש הייתה שורה עליו, היו שערות ראשו מכות זו בזו,"
  },
  {
   "start": 666.98,
   "end": 669.04,
   "text": "וקולם היה נשמע למרחוק."
  },
  {
   "start": 671.62,
   "end": 675.08,
   "text": "ואז שוב הייתה ננסחת בו אותה רוח קבורה מיוחדת,"
  },
  {
   "start": 675.64,
   "end": 676.54,
   "text": "נוסחת בו עוז,"
  },
  {
   "start": 677.16,
   "end": 678.96,
   "text": "עוז מיוחד ששמור."
  }
 ]
}