{
 "disc": "4ד- דוד המלך",
 "track": "Track03",
 "duration": 1370.184,
 "segments": [
  {
   "start": 21.6,
   "end": 22.82,
   "text": "אם מדברים על קשיים,"
  },
  {
   "start": 24.08,
   "end": 24.74,
   "text": "אם מדברים על"
  },
  {
   "start": 26.0,
   "end": 27.6,
   "text": "דרכים של איסורים,"
  },
  {
   "start": 28.5,
   "end": 29.16,
   "text": "מאמצים,"
  },
  {
   "start": 30.92,
   "end": 34.62,
   "text": "כדי להצליח בעבודת השם, מי לנו כדוד מלך ישראל,"
  },
  {
   "start": 37.19,
   "end": 38.35,
   "text": "הסמל הגדול של עם ישראל."
  },
  {
   "start": 40.11,
   "end": 43.63,
   "text": "דוד מולך בירושלים,"
  },
  {
   "start": 44.57,
   "end": 45.09,
   "text": "סוף-סוף,"
  },
  {
   "start": 45.93,
   "end": 47.59,
   "text": "אחרי איסורים, אחרי קשיים,"
  },
  {
   "start": 48.65,
   "end": 48.93,
   "text": "אחרי"
  },
  {
   "start": 49.93,
   "end": 51.23,
   "text": "תקופה ארוכה של רדיפות,"
  },
  {
   "start": 51.47,
   "end": 55.87,
   "text": "סוף-סוף הוא מגיע אל המנוחה ואל הנחלה."
  },
  {
   "start": 57.79,
   "end": 58.09,
   "text": "באמת כך?"
  },
  {
   "start": 65.3,
   "end": 66.42,
   "text": "באמת ככה? אמנם?"
  },
  {
   "start": 69.99,
   "end": 70.49,
   "text": "לא ולא."
  },
  {
   "start": 74.74,
   "end": 77.86,
   "text": "יום אחד מגיעה הידיעה,"
  },
  {
   "start": 78.98,
   "end": 79.58,
   "text": "אבשלום,"
  },
  {
   "start": 80.52,
   "end": 81.24,
   "text": "הבן שלך,"
  },
  {
   "start": 82.32,
   "end": 84.2,
   "text": "לא פחות ולא יותר הבן שלך,"
  },
  {
   "start": 85.1,
   "end": 85.56,
   "text": "מורד בך."
  },
  {
   "start": 86.9,
   "end": 88.5,
   "text": "ורבים מעם ישראל איתו."
  },
  {
   "start": 89.74,
   "end": 90.58,
   "text": "ודוד המלך,"
  },
  {
   "start": 92.1,
   "end": 92.98,
   "text": "ממלך"
  },
  {
   "start": 93.94,
   "end": 94.98,
   "text": "נאלץ לברוח."
  },
  {
   "start": 96.36,
   "end": 98.3,
   "text": "הוא לא מספיק אפילו לקחת סוסים."
  },
  {
   "start": 99.56,
   "end": 100.82,
   "text": "הוא בורח ברגליים."
  },
  {
   "start": 101.6,
   "end": 103.94,
   "text": "משאיר הכל מאחוריו, הכל."
  },
  {
   "start": 104.46,
   "end": 107.32,
   "text": "ממלך ישראל שלכאורה יש לו הכל."
  },
  {
   "start": 108.62,
   "end": 109.4,
   "text": "אין לו כלום."
  },
  {
   "start": 110.0,
   "end": 111.44,
   "text": "איבד את הכל בשנייה."
  },
  {
   "start": 112.16,
   "end": 114.98,
   "text": "בזמן כל כך קצר הוא נהפך לעני,"
  },
  {
   "start": 115.46,
   "end": 116.44,
   "text": "לחסר בית,"
  },
  {
   "start": 117.02,
   "end": 117.74,
   "text": "לנרדף."
  },
  {
   "start": 119.8,
   "end": 121.68,
   "text": "כמה זה קשה לאדם רגיל."
  },
  {
   "start": 122.52,
   "end": 127.06,
   "text": "כמה זה בלתי נסבל לאחד שהוא מלך."
  },
  {
   "start": 133.26,
   "end": 137.4,
   "text": "ואתם יודעים על מה דוד המלך חושב? דוד המלך הולך וביקש,"
  },
  {
   "start": 137.98,
   "end": 138.92,
   "text": "אומר המדרש,"
  },
  {
   "start": 139.26,
   "end": 141.86,
   "text": "דוד המלך ביקש לעבוד עבודה זרה."
  },
  {
   "start": 142.84,
   "end": 145.3,
   "text": "פגש אותו חושי הערקי, אומר לו דוד המלך,"
  },
  {
   "start": 145.98,
   "end": 146.8,
   "text": "מה אתה עושה?"
  },
  {
   "start": 147.6,
   "end": 151.48,
   "text": "מה אתה מחפש לעבוד עבודה זרה? יאמרו העולם,"
  },
  {
   "start": 152.06,
   "end": 155.8,
   "text": "יאמרו מלך שכמותך עובד עבודה זרה."
  },
  {
   "start": 156.52,
   "end": 157.56,
   "text": "אמר דוד המלך,"
  },
  {
   "start": 158.62,
   "end": 162.92,
   "text": "יאמרו מלך שכמותי יהרוג אותו הבן שלו."
  },
  {
   "start": 164.62,
   "end": 165.36,
   "text": "אתם יודעים מה הכוונה?"
  },
  {
   "start": 168.48,
   "end": 169.02,
   "text": "בשביל זה צריך"
  },
  {
   "start": 170.6,
   "end": 172.72,
   "text": "להמשיל את זה. היה איזה מלך אחד,"
  },
  {
   "start": 173.78,
   "end": 175.08,
   "text": "שהיה לו אחד שם מלצר,"
  },
  {
   "start": 176.32,
   "end": 177.74,
   "text": "שהיה מה זה נאמן לו?"
  },
  {
   "start": 178.62,
   "end": 180.62,
   "text": "כל מה שהמלך היה אומר הוא היה עושה."
  },
  {
   "start": 182.12,
   "end": 182.56,
   "text": "יום אחד,"
  },
  {
   "start": 184.12,
   "end": 185.68,
   "text": "באמצע ארוחה מלכותית,"
  },
  {
   "start": 189.36,
   "end": 192.58,
   "text": "התגלה זבוב במרק של המלך,"
  },
  {
   "start": 193.38,
   "end": 194.36,
   "text": "והמלך כולו רתח."
  },
  {
   "start": 195.32,
   "end": 200.48,
   "text": "זה היה מלך כולו רתח, הוא לא היה מוכן לסבול את זה. אצלי זבוב במרק, אצלי,"
  },
  {
   "start": 201.5,
   "end": 202.5,
   "text": "הוא אמר, תביאו לי את המלצר."
  },
  {
   "start": 204.8,
   "end": 206.24,
   "text": "הוא אומר למלצר, תראה מה הזבוב הזה,"
  },
  {
   "start": 207.28,
   "end": 208.32,
   "text": "אתה תשלם על זה ביוקר."
  },
  {
   "start": 209.46,
   "end": 212.36,
   "text": "את הראש שלך יסירו ממך, זעק המלך."
  },
  {
   "start": 213.7,
   "end": 214.4,
   "text": "שמע את זה המלצר,"
  },
  {
   "start": 214.4,
   "end": 218.46,
   "text": "המלצר תפס את צלחת המרק"
  },
  {
   "start": 219.5,
   "end": 222.78,
   "text": "ושפך את כולה על ראשו של המלך."
  },
  {
   "start": 223.54,
   "end": 225.08,
   "text": "והמרק ניתף ככה על בגדי המלך,"
  },
  {
   "start": 225.92,
   "end": 230.06,
   "text": "והמלך כולו זועם, תכניסו אותו לכלא, פסק דין מוות!"
  },
  {
   "start": 232.3,
   "end": 233.22,
   "text": "והם הכניסו אותו לכלא,"
  },
  {
   "start": 234.78,
   "end": 235.38,
   "text": "והמלך"
  },
  {
   "start": 236.62,
   "end": 238.24,
   "text": "הלך וניקה את עצמו."
  },
  {
   "start": 238.8,
   "end": 241.2,
   "text": "למחרת בבוקר המלך קם קצת יותר רגוע."
  },
  {
   "start": 241.9,
   "end": 243.14,
   "text": "הוא יושב וחושב, הוא לא מבין."
  },
  {
   "start": 244.04,
   "end": 247.92,
   "text": "הרי המלצר הזה נאמן לי כל כך הרבה שנים."
  },
  {
   "start": 248.96,
   "end": 252.78,
   "text": "אוהב אותי כל כך הרבה שנים. מה קרה? מה קרה? אני לא מבין."
  },
  {
   "start": 254.0,
   "end": 256.66,
   "text": "הרי הוא מכיר אותי, הוא יודע שאני מתרגז מהר."
  },
  {
   "start": 257.12,
   "end": 259.92,
   "text": "אז הייתי אומר לו, פסק דין מוות, לוקח אותו לכלא."
  },
  {
   "start": 261.08,
   "end": 263.32,
   "text": "אבל למחרת מוותר לו, הוא יודע, הוא מכיר אותי."
  },
  {
   "start": 265.32,
   "end": 268.76,
   "text": "אבל עכשיו שהוא שפך לי את המרק, אני כבר לא אסלח לו."
  },
  {
   "start": 269.46,
   "end": 270.64,
   "text": "אני לא מבין מה קרה לו."
  },
  {
   "start": 271.64,
   "end": 274.08,
   "text": "והמלך הלך ניגש אל תא הכלא,"
  },
  {
   "start": 274.76,
   "end": 277.12,
   "text": "אל אותו מלצר ואומר לו, אני רוצה לדבר איתך."
  },
  {
   "start": 278.12,
   "end": 280.84,
   "text": "אני רוצה לשאול אותך, מה עשית? למה? תסביר לי."
  },
  {
   "start": 282.1,
   "end": 282.78,
   "text": "אמר לו המלצר,"
  },
  {
   "start": 283.84,
   "end": 287.2,
   "text": "אדוני המלך, אתה לא יודע כמה אני אוהב אותך."
  },
  {
   "start": 287.84,
   "end": 293.0,
   "text": "אדוני המלך, הרי אם אני הייתי הולך לכלא עכשיו פסק דין מוות"
  },
  {
   "start": 293.54,
   "end": 296.98,
   "text": "על זה שזבוב נמצא אצלך במרק,"
  },
  {
   "start": 297.96,
   "end": 300.28,
   "text": "כל העולם היה אומר, איזה מלך זה."
  },
  {
   "start": 300.86,
   "end": 306.16,
   "text": "על דבר כזה קטן הוא הולך והורג את היהודי, את האדם הנאמן לו ביותר?"
  },
  {
   "start": 308.16,
   "end": 311.24,
   "text": "ואולי אנשים לא היו רוצים להיות תחת המלכות שלך."
  },
  {
   "start": 312.64,
   "end": 314.02,
   "text": "ואני כל כך אוהב אותך."
  },
  {
   "start": 315.08,
   "end": 317.32,
   "text": "כל כך אוהב אותך, אוהב אותך יותר מאת עצמי."
  },
  {
   "start": 318.34,
   "end": 322.08,
   "text": "ואמרתי, מה אני אעשה כדי שלא יאשימו אותך?"
  },
  {
   "start": 322.64,
   "end": 324.12,
   "text": "כדי שיאשימו אותי."
  },
  {
   "start": 324.58,
   "end": 328.3,
   "text": "אז לקחתי את הצלחת מרק ושפכתי עליך."
  },
  {
   "start": 329.28,
   "end": 332.68,
   "text": "ועכשיו כולם יגידו שאני אשם"
  },
  {
   "start": 333.52,
   "end": 335.1,
   "text": "וכבוד המלך לא ינזק."
  },
  {
   "start": 336.68,
   "end": 337.28,
   "text": "שמע את זה המלך,"
  },
  {
   "start": 338.56,
   "end": 339.88,
   "text": "כל כך התפעל"
  },
  {
   "start": 346.34,
   "end": 347.7,
   "text": "ושחרר את המלצר."
  },
  {
   "start": 348.8,
   "end": 349.84,
   "text": "ככה דוד המלך."
  },
  {
   "start": 350.54,
   "end": 352.12,
   "text": "דוד המלך אמר, אם עכשיו,"
  },
  {
   "start": 353.3,
   "end": 360.14,
   "text": "אם עכשיו אני רק אברח, יגידו בסדר, דוד המלך שכל כך הרבה עבד את השם,"
  },
  {
   "start": 360.68,
   "end": 363.5,
   "text": "שקצב את ספר התהילים, זה מה שמגיע לו?"
  },
  {
   "start": 364.24,
   "end": 367.5,
   "text": "לברוח מהבית מהבן שלו שהוא רוצה להרוג אותו."
  },
  {
   "start": 368.46,
   "end": 370.9,
   "text": "אני אלך ואעבוד עבודה זרה, ואז"
  },
  {
   "start": 372.0,
   "end": 375.2,
   "text": "כולם יגידו, מגיע לו, עכשיו אנחנו מבינים למה זה קרה לו."
  },
  {
   "start": 378.16,
   "end": 379.32,
   "text": "ולא חס וחלילה"
  },
  {
   "start": 380.62,
   "end": 383.22,
   "text": "ישאלו שאלות על קודש הבריחו."
  },
  {
   "start": 384.5,
   "end": 386.32,
   "text": "אמר לו חושייה ארכי,"
  },
  {
   "start": 386.98,
   "end": 388.24,
   "text": "אשריך דוד,"
  },
  {
   "start": 389.24,
   "end": 390.44,
   "text": "אבל אתה לא צריך לדאוג."
  },
  {
   "start": 391.58,
   "end": 393.54,
   "text": "אתה יודע הרי בתורה הקדושה"
  },
  {
   "start": 393.54,
   "end": 400.78,
   "text": "נסמכה פרשת יפת תואר לפרשת בן סורר ומורה."
  },
  {
   "start": 401.38,
   "end": 405.24,
   "text": "ללמד אותנו שהאדם שהולך למלחמה ולוקח אישה יפת תואר,"
  },
  {
   "start": 405.74,
   "end": 410.4,
   "text": "צריך להיזהר כי התוצאה של זה ייוולד לו בן סורר ומורה."
  },
  {
   "start": 411.4,
   "end": 412.98,
   "text": "שימרוד בו שיעשה לו צרות."
  },
  {
   "start": 413.72,
   "end": 415.82,
   "text": "אבשלום הוא הבן של"
  },
  {
   "start": 416.96,
   "end": 417.58,
   "text": "מעכה"
  },
  {
   "start": 418.48,
   "end": 419.58,
   "text": "בת מלך גשור."
  },
  {
   "start": 420.58,
   "end": 422.16,
   "text": "אמו הייתה יפת תואר."
  },
  {
   "start": 424.24,
   "end": 427.92,
   "text": "אז כולם יגידו, כן, בגלל שהוא עבר, הנה הוא לקח, זו לא עבירה,"
  },
  {
   "start": 428.54,
   "end": 431.36,
   "text": "הוא לקח אישה יפה תואר, אז הנה התורה צודקת במאה אחוז."
  },
  {
   "start": 432.4,
   "end": 433.38,
   "text": "ודוד המלך שמח."
  },
  {
   "start": 434.82,
   "end": 437.56,
   "text": "דוד המלך כששמע את זה, שמח."
  },
  {
   "start": 438.34,
   "end": 442.92,
   "text": "אמר מזמור לדוד בבורכו בבני אבשלום. אני פחדתי, חשבתי, יגידו,"
  },
  {
   "start": 443.58,
   "end": 445.42,
   "text": "אולי יאכילו לשם שמיים מזה."
  },
  {
   "start": 445.94,
   "end": 446.84,
   "text": "אבל אני רואה, הנה יופי,"
  },
  {
   "start": 447.54,
   "end": 448.64,
   "text": "כבוד התורה."
  },
  {
   "start": 448.96,
   "end": 450.72,
   "text": "רואים כולם שהתורה אמת."
  },
  {
   "start": 454.97,
   "end": 455.59,
   "text": "והוא ברח."
  },
  {
   "start": 457.72,
   "end": 459.42,
   "text": "ולא עובד עבודה זרה. תראו מה זה."
  },
  {
   "start": 460.34,
   "end": 464.72,
   "text": "תראו על מה דוד המלך חושב בזמן כל כך היום. מה כבוד שמיים?"
  },
  {
   "start": 465.7,
   "end": 467.64,
   "text": "כשקשה לו, כשנזרק מהכל."
  },
  {
   "start": 469.82,
   "end": 470.86,
   "text": "כשהבן שלו"
  },
  {
   "start": 471.52,
   "end": 473.2,
   "text": "זה האויב מספר אחד שלו."
  },
  {
   "start": 474.0,
   "end": 475.7,
   "text": "אז במקום להישבר, להתייאש,"
  },
  {
   "start": 477.62,
   "end": 479.08,
   "text": "הוא חושב על כבוד השם."
  },
  {
   "start": 485.18,
   "end": 487.14,
   "text": "ואז בא צדוק הכהן ואביתר הכהנים."
  },
  {
   "start": 488.14,
   "end": 490.64,
   "text": "צדוק ואביתר הכהנים ומצרפים אליו את אהרון."
  },
  {
   "start": 491.26,
   "end": 493.0,
   "text": "לפחות תהיה לנו אחיזה רוחנית."
  },
  {
   "start": 494.2,
   "end": 494.66,
   "text": "אבל דוד,"
  },
  {
   "start": 495.74,
   "end": 497.9,
   "text": "דוד חס על כבוד הארון."
  },
  {
   "start": 498.58,
   "end": 499.72,
   "text": "זה ארון הקודש."
  },
  {
   "start": 500.14,
   "end": 502.38,
   "text": "דוד יודע שהכל מהקדוש ברוך הוא."
  },
  {
   "start": 502.88,
   "end": 503.58,
   "text": "דוד הולך עם כולם,"
  },
  {
   "start": 504.86,
   "end": 508.94,
   "text": "עם כל האנשים שלו, אבל הוא מנותק מהם. הוא מחובר אל השם יתברך."
  },
  {
   "start": 509.48,
   "end": 512.16,
   "text": "וכשאתה מחובר מחוברת לשם יתברך,"
  },
  {
   "start": 512.72,
   "end": 515.78,
   "text": "אפשר לעבור את הכל, אפשר לעבור את הכל."
  },
  {
   "start": 516.3,
   "end": 517.1,
   "text": "דוד המלך אומר,"
  },
  {
   "start": 519.22,
   "end": 520.74,
   "text": "תראו איזה משפט של אמונה."
  },
  {
   "start": 521.46,
   "end": 523.44,
   "text": "אמר דוד המלך לכהנים, תראו,"
  },
  {
   "start": 523.98,
   "end": 526.6,
   "text": "אם רצון השם להחזיר אותי למלכות שלי,"
  },
  {
   "start": 527.06,
   "end": 528.18,
   "text": "אני עוד אראה את הארון הזה."
  },
  {
   "start": 529.42,
   "end": 531.84,
   "text": "ואם לא, אז מה יעזור לי הארון?"
  },
  {
   "start": 532.48,
   "end": 534.68,
   "text": "אם הקדוש ברוך הוא רוצה שאני אהיה מלך,"
  },
  {
   "start": 535.24,
   "end": 538.14,
   "text": "אני עוד אזכה לראות את הארון, לא צריך להטריח את הארון בשביל זה."
  },
  {
   "start": 540.0,
   "end": 542.68,
   "text": "הארון לא מגיע לו להשתתף איתי בבריכה."
  },
  {
   "start": 544.54,
   "end": 547.44,
   "text": "אני השם העוונות שלי, הארון, אין לו עוונות כולו טהור."
  },
  {
   "start": 548.02,
   "end": 549.56,
   "text": "תחזירו את ארון הקודש!"
  },
  {
   "start": 562.0,
   "end": 563.72,
   "text": "ודוד המלך ממשיך ללכת."
  },
  {
   "start": 564.0,
   "end": 568.74,
   "text": "ובדרך שלו, באותה דרך רצופה מכשולים וייסורים,"
  },
  {
   "start": 569.6,
   "end": 572.86,
   "text": "יוצא לקראתו יהודי בשם שמעי בן גרה."
  },
  {
   "start": 574.24,
   "end": 577.68,
   "text": "והוא מבייש את דוד לעיני כולם,"
  },
  {
   "start": 578.4,
   "end": 580.6,
   "text": "ומקלל את דוד לעיני כולם,"
  },
  {
   "start": 581.46,
   "end": 584.76,
   "text": "וסוקל באבנים את דוד לעיני כולם."
  },
  {
   "start": 586.18,
   "end": 587.76,
   "text": "ואבישי בן צרויה,"
  },
  {
   "start": 589.5,
   "end": 591.12,
   "text": "שר הצבא של דוד,"
  },
  {
   "start": 591.88,
   "end": 592.98,
   "text": "מבקש מהמלך,"
  },
  {
   "start": 594.5,
   "end": 595.96,
   "text": "דקה אחת תן לי שנייה אחת."
  },
  {
   "start": 596.98,
   "end": 599.96,
   "text": "למה יקלל הכלב המת הזה את אדוני המלך?"
  },
  {
   "start": 600.52,
   "end": 603.2,
   "text": "העברה נא ואסירה את ראשו, כך הוא אומר."
  },
  {
   "start": 603.98,
   "end": 610.1,
   "text": "למה יקלל הכלב המת את אדוני המלך? העברה נא תן לי שנייה ואסירה את ראשו."
  },
  {
   "start": 613.36,
   "end": 616.02,
   "text": "ודוד מלמד אותנו שיעור באמונה,"
  },
  {
   "start": 618.02,
   "end": 620.54,
   "text": "שיעור איך להסתכל על העולם."
  },
  {
   "start": 622.22,
   "end": 624.54,
   "text": "דוד אומר, הניחו לו ויכלל,"
  },
  {
   "start": 624.54,
   "end": 627.38,
   "text": "כי השם אמר לו."
  },
  {
   "start": 628.58,
   "end": 631.02,
   "text": "הניחו לו ויקלל כי אמר לו השם."
  },
  {
   "start": 635.74,
   "end": 639.36,
   "text": "גם אם הוא מקלל אותי, גם אם הקשיים זה מהקדוש ברוך הוא."
  },
  {
   "start": 640.2,
   "end": 643.64,
   "text": "זה מגיע לי ואני צריך לקבל את זה בשמחה ובטוב לבב."
  },
  {
   "start": 644.76,
   "end": 646.14,
   "text": "וככה שמעי מקלל אותו,"
  },
  {
   "start": 647.12,
   "end": 647.88,
   "text": "סוקל אותו,"
  },
  {
   "start": 648.84,
   "end": 652.26,
   "text": "זורק עפר ואפר זמן רב דרך ארוכה."
  },
  {
   "start": 653.0,
   "end": 654.62,
   "text": "והמלך דוד שותק,"
  },
  {
   "start": 655.44,
   "end": 657.9,
   "text": "והמלך דוד סופג."
  },
  {
   "start": 686.08,
   "end": 686.94,
   "text": "בינתיים בבית אבשלום,"
  },
  {
   "start": 688.76,
   "end": 690.7,
   "text": "שמרד באבא שלו."
  },
  {
   "start": 691.82,
   "end": 692.7,
   "text": "בא אחיתופל,"
  },
  {
   "start": 693.72,
   "end": 697.3,
   "text": "אחיתופל היועץ לשעבר של דוד, ומייעץ לאבשלום להרוג את דוד."
  },
  {
   "start": 698.6,
   "end": 701.5,
   "text": "והרעיון מוצא חן בעיני אבשלום."
  },
  {
   "start": 704.15,
   "end": 705.47,
   "text": "אין לו בעיה עם זה."
  },
  {
   "start": 707.41,
   "end": 710.29,
   "text": "אין לו בעיה ללכת ולהרוג את אבא."
  },
  {
   "start": 715.84,
   "end": 716.18,
   "text": "וכך"
  },
  {
   "start": 718.18,
   "end": 719.7,
   "text": "אבשלום הכין את הצבא שלו,"
  },
  {
   "start": 723.15,
   "end": 723.83,
   "text": "והם יוצאים"
  },
  {
   "start": 723.83,
   "end": 731.85,
   "text": "למלחמה כנגד אנשי דוד מעטים אנשי דוד מעטים"
  },
  {
   "start": 732.49,
   "end": 739.17,
   "text": "כנגד רבים אנשי הצבא שאיגד אבשלום רבים."
  },
  {
   "start": 749.91,
   "end": 755.55,
   "text": "דוד פונה לאנשים ואומר להם תעשו לי טובה תרחמו על אבשלום תרחמו עליו"
  },
  {
   "start": 759.6,
   "end": 760.74,
   "text": "והמלחמה יוצאת"
  },
  {
   "start": 761.62,
   "end": 763.08,
   "text": "הם נפגשים ביער"
  },
  {
   "start": 765.41,
   "end": 767.49,
   "text": "מלחמה עקובה מדם"
  },
  {
   "start": 768.33,
   "end": 768.83,
   "text": "קרבות"
  },
  {
   "start": 771.79,
   "end": 772.91,
   "text": "ותוך זמן קצר"
  },
  {
   "start": 781.57,
   "end": 782.91,
   "text": "כולם רואים את התוצאות."
  },
  {
   "start": 783.93,
   "end": 785.09,
   "text": "צבאו של אבשלום מובס,"
  },
  {
   "start": 786.97,
   "end": 788.09,
   "text": "מובס ללא תנאי."
  },
  {
   "start": 788.65,
   "end": 791.31,
   "text": "ואבשלום שבורח, האבשלום שנס על נפשו,"
  },
  {
   "start": 792.23,
   "end": 794.47,
   "text": "תוך שהוא רוכב על פרד, בתוך היער."
  },
  {
   "start": 797.51,
   "end": 798.07,
   "text": "אז אבשלום"
  },
  {
   "start": 798.89,
   "end": 801.03,
   "text": "זה הנזיר עם הסערות,"
  },
  {
   "start": 801.69,
   "end": 802.69,
   "text": "הסערות היפות שלו,"
  },
  {
   "start": 803.41,
   "end": 804.85,
   "text": "הסערות שעליהן הוא התפאר,"
  },
  {
   "start": 805.47,
   "end": 806.51,
   "text": "שאותן הוא לא גילח."
  },
  {
   "start": 808.25,
   "end": 810.13,
   "text": "אבשלום נתפס בסערות,"
  },
  {
   "start": 810.73,
   "end": 812.45,
   "text": "נתלה בשערות ראשו הנפלאות,"
  },
  {
   "start": 813.29,
   "end": 814.37,
   "text": "בסבך עץ האלה,"
  },
  {
   "start": 815.35,
   "end": 816.97,
   "text": "בין שמיים וארץ."
  },
  {
   "start": 819.16,
   "end": 820.36,
   "text": "אומרים חז'ל הקדושים,"
  },
  {
   "start": 821.2,
   "end": 823.36,
   "text": "אבישלום הרי יכל להשתחרר,"
  },
  {
   "start": 824.0,
   "end": 825.06,
   "text": "תוריד את הענף"
  },
  {
   "start": 828.63,
   "end": 829.89,
   "text": "שתופס לך את השערות."
  },
  {
   "start": 831.03,
   "end": 832.43,
   "text": "אומרים חז'ל הקדושים,"
  },
  {
   "start": 833.59,
   "end": 837.15,
   "text": "אבישלום אבשלום ראה גיהנום פתוחה תחתיו."
  },
  {
   "start": 839.78,
   "end": 844.02,
   "text": "לפתע בשנייה הבין אבשלום עד כמה הוא טעה."
  },
  {
   "start": 845.0,
   "end": 847.82,
   "text": "הבין אבשלום עד כמה רחוק הוא הגיע,"
  },
  {
   "start": 848.42,
   "end": 849.58,
   "text": "עד כמה הוא קלקל."
  },
  {
   "start": 850.5,
   "end": 852.38,
   "text": "הבין אבשלום מה צפוי לו."
  },
  {
   "start": 854.32,
   "end": 855.86,
   "text": "לכן הוא לא כרת את הענף,"
  },
  {
   "start": 856.64,
   "end": 859.58,
   "text": "אלא המתין בשקט איום, בשקט מיוסר,"
  },
  {
   "start": 861.14,
   "end": 861.78,
   "text": "למותו."
  },
  {
   "start": 863.42,
   "end": 866.32,
   "text": "אם נתפסתי דווקא בסערות של הנזירות שלי,"
  },
  {
   "start": 867.22,
   "end": 869.4,
   "text": "סימן שטעיתי לאורך כל הדרך."
  },
  {
   "start": 870.98,
   "end": 871.68,
   "text": "על מה המחשבה?"
  },
  {
   "start": 871.74,
   "end": 872.14,
   "text": "שווה,"
  },
  {
   "start": 873.52,
   "end": 874.48,
   "text": "אולי האחרונה"
  },
  {
   "start": 876.18,
   "end": 877.56,
   "text": "במוחו של אבשלום."
  },
  {
   "start": 880.72,
   "end": 882.58,
   "text": "אל המקום מגיע יואב בן צרויה,"
  },
  {
   "start": 884.69,
   "end": 886.71,
   "text": "מטיל חיצים בלבו של אבשלום."
  },
  {
   "start": 887.59,
   "end": 890.01,
   "text": "אבשלום מפרפר עדיין חי,"
  },
  {
   "start": 891.55,
   "end": 894.89,
   "text": "ואז מגיעים עוד עשרה נערים והורגים אותו."
  },
  {
   "start": 897.62,
   "end": 901.24,
   "text": "אמרו חז״ל הקדושים, אבשלום אין לו חלק בעולם הבא,"
  },
  {
   "start": 902.1,
   "end": 905.46,
   "text": "שנאמר, ויכו את אבשלום וימיתוהו,"
  },
  {
   "start": 906.0,
   "end": 907.96,
   "text": "ויכוהו את אבשלום בעולם הזה,"
  },
  {
   "start": 908.72,
   "end": 909.4,
   "text": "וימיתוהו"
  },
  {
   "start": 910.1,
   "end": 911.12,
   "text": "בעולם הבא."
  },
  {
   "start": 926.04,
   "end": 927.38,
   "text": "דוד ממתין לתוצאות."
  },
  {
   "start": 929.52,
   "end": 929.9,
   "text": "מודאג."
  },
  {
   "start": 930.98,
   "end": 932.76,
   "text": "למרות הכל, הוא אבא,"
  },
  {
   "start": 933.62,
   "end": 934.56,
   "text": "וזה הילד שלו."
  },
  {
   "start": 941.16,
   "end": 942.78,
   "text": "ודוד מקבל את הבשורה."
  },
  {
   "start": 945.44,
   "end": 947.88,
   "text": "אבל הוא מקבל את הבשורה כמו אבא,"
  },
  {
   "start": 948.92,
   "end": 950.46,
   "text": "עם לב של אבא."
  },
  {
   "start": 951.5,
   "end": 952.72,
   "text": "ודוד המלך,"
  },
  {
   "start": 953.92,
   "end": 956.14,
   "text": "שכשהוא הלך וברח על חייו,"
  },
  {
   "start": 956.66,
   "end": 962.36,
   "text": "כשהוא נס וספג ביזיונות וקשיים, אומללות ועוני,"
  },
  {
   "start": 964.46,
   "end": 966.22,
   "text": "צר ויגון הוא לא בכה."
  },
  {
   "start": 967.22,
   "end": 967.92,
   "text": "אבל הפעם,"
  },
  {
   "start": 968.8,
   "end": 974.78,
   "text": "הפעם דוד אומר הפסוק, ויעל על עליית השער ויבק."
  },
  {
   "start": 975.76,
   "end": 977.42,
   "text": "התחיל דוד לבכות."
  },
  {
   "start": 979.14,
   "end": 983.16,
   "text": "ויעל על עליית השער ויבק, וכה אמר בלכתו,"
  },
  {
   "start": 983.8,
   "end": 985.08,
   "text": "בני,"
  },
  {
   "start": 985.62,
   "end": 1000.84,
   "text": "אבשלום בני, בני אבשלום מי יתן מותי אני תחתיך אבשלום בני,"
  },
  {
   "start": 1001.9,
   "end": 1010.57,
   "text": "בני דוד התמלאת צער על שהבן שלו מת בעוונו"
  },
  {
   "start": 1011.49,
   "end": 1020.03,
   "text": "אומרים חזל הקדושים אומר המדרש כל פעם שדוד זעק בני אבשלום בני"
  },
  {
   "start": 1020.03,
   "end": 1028.57,
   "text": "כל פעם הוא העלה את אבשלום ופעל והעלה את אבשלום מדיוטה של הגיהנום"
  },
  {
   "start": 1028.93,
   "end": 1048.24,
   "text": "בני הוא זעק והעלה את נשמתו של אבשלום מהמדור התחתון בגיהנום אבשלום הוא זעק והעלה אותו עוד מדור בני ועוד דוד עוד מדור בני עוד למעלה אבשלום עוד"
  },
  {
   "start": 1048.78,
   "end": 1052.78,
   "text": "מי יתן מותי, אני תחתיך, אני מוכן למות!"
  },
  {
   "start": 1054.04,
   "end": 1056.92,
   "text": "אבשלום! עוד אחד!"
  },
  {
   "start": 1057.54,
   "end": 1059.14,
   "text": "בני! והנה,"
  },
  {
   "start": 1059.68,
   "end": 1060.78,
   "text": "הוא העלה אותו למעלה,"
  },
  {
   "start": 1061.34,
   "end": 1064.94,
   "text": "ובפעם האחרונה שהוא זעק, בני!"
  },
  {
   "start": 1065.34,
   "end": 1067.64,
   "text": "הוא העלה אותו, הוציא אותו מגיהנום,"
  },
  {
   "start": 1068.24,
   "end": 1074.92,
   "text": "והעביר את הנשמה שלו לגן עדי."
  },
  {
   "start": 1075.16,
   "end": 1083.85,
   "text": "תראו איזה כוח זכה דוד בזכות האמונה והדבקות גם כשקשה,"
  },
  {
   "start": 1084.67,
   "end": 1086.57,
   "text": "גם בצרות, גם בקשיים."
  },
  {
   "start": 1086.99,
   "end": 1090.01,
   "text": "כל הזמן אמונה, כל הזמן התחזקות,"
  },
  {
   "start": 1090.53,
   "end": 1092.25,
   "text": "כל הזמן סבלנות."
  },
  {
   "start": 1093.59,
   "end": 1096.63,
   "text": "אתם יודעים, גם כשהוא ברח מפני אבשלום אמר דוד המלך,"
  },
  {
   "start": 1097.39,
   "end": 1100.89,
   "text": "תראו מה זה, כמה אנחנו צריכים להגיד, אנחנו, אנחנו."
  },
  {
   "start": 1101.79,
   "end": 1104.15,
   "text": "אמר דוד, יעקב ברח מעשיו."
  },
  {
   "start": 1105.17,
   "end": 1106.63,
   "text": "משה ברח מפרעה."
  },
  {
   "start": 1107.13,
   "end": 1108.93,
   "text": "אליהו ברח מאחאב,"
  },
  {
   "start": 1109.65,
   "end": 1111.23,
   "text": "ואני בורח כמותם."
  },
  {
   "start": 1112.71,
   "end": 1117.53,
   "text": "בסך הכל, כל הגדולים, כולם ברחו, כולם סבלו, כולם עלהם דרך חתחתים."
  },
  {
   "start": 1118.31,
   "end": 1119.31,
   "text": "אז גם אני כמוהם."
  },
  {
   "start": 1119.85,
   "end": 1121.23,
   "text": "ככה אנחנו צריכים להגיד גם אנחנו."
  },
  {
   "start": 1121.87,
   "end": 1123.03,
   "text": "אנחנו פחות מדוד המלך?"
  },
  {
   "start": 1123.93,
   "end": 1125.43,
   "text": "את פחות מדוד המלך?"
  },
  {
   "start": 1125.91,
   "end": 1128.65,
   "text": "אתה פחות מדוד? אנחנו, אני פחות מדוד המלך?"
  },
  {
   "start": 1130.45,
   "end": 1134.75,
   "text": "דוד המלך אמר, זכרתי משפטיך מעולם השם ואתנחם."
  },
  {
   "start": 1134.75,
   "end": 1141.11,
   "text": "דוד המלך היה מתנחם, אני זוכר, מורה עולם, איך אתה נתנהגת עם כולם, הרי כולם ככה, זה הדרך."
  },
  {
   "start": 1141.71,
   "end": 1144.59,
   "text": "זה הדרך לקנות, זה הדרך לעבוד את השם."
  },
  {
   "start": 1146.05,
   "end": 1149.49,
   "text": "ככה אנחנו צריכים לזכור, כמו שדוד זכר, ככה אנחנו צריכים לזכור אנחנו."
  },
  {
   "start": 1149.99,
   "end": 1150.75,
   "text": "ולהתחזק."
  },
  {
   "start": 1151.41,
   "end": 1153.27,
   "text": "לא הולך לי בלימוד, אז מה?"
  },
  {
   "start": 1154.75,
   "end": 1156.37,
   "text": "לא הולך לי במה שאני מבקש."
  },
  {
   "start": 1158.51,
   "end": 1160.89,
   "text": "חסר לי פה, חסר לי ילדים, חסר לי זיווק, חסר לי..."
  },
  {
   "start": 1161.39,
   "end": 1166.01,
   "text": "אני מתחזק, אני לא מוותר. פרנסה לא... צוחקים עליי כולם, לא אכפת לי, מקלל לי משהו."
  },
  {
   "start": 1166.03,
   "end": 1169.99,
   "text": "שלא יעשו, אני הולך, אני לא פחות מדוד, מה זה?"
  },
  {
   "start": 1171.69,
   "end": 1172.17,
   "text": "צריך להתחזק!"
  },
  {
   "start": 1194.63,
   "end": 1195.27,
   "text": "תראו מה זה,"
  },
  {
   "start": 1195.89,
   "end": 1201.91,
   "text": "כשדוד הוכרח לברוח מירושלים, אתם יודעים מה אומר הפסוק? תראו, רק מהפסוקים אפשר להבין הכל."
  },
  {
   "start": 1202.77,
   "end": 1205.67,
   "text": "ודוד עולה במעלה הזיתים, עולה ובוכה,"
  },
  {
   "start": 1206.35,
   "end": 1207.51,
   "text": "וראש לא חפוי,"
  },
  {
   "start": 1207.95,
   "end": 1210.57,
   "text": "והוא הולך יחף, אפילו לא היה לו נעליים כשהוא ברח מאבשלום."
  },
  {
   "start": 1211.69,
   "end": 1214.75,
   "text": "וכבר נדמה שהמלכות עוברת לידי אבשלום. אתם יודעים מה אומר אז דוד?"
  },
  {
   "start": 1215.51,
   "end": 1216.25,
   "text": "תקשיבו מה הוא אומר."
  },
  {
   "start": 1216.25,
   "end": 1218.89,
   "text": "אם אמצא חן בעיני השם,"
  },
  {
   "start": 1219.33,
   "end": 1221.81,
   "text": "ואשיבני ורעני אותו ואתנבאו."
  },
  {
   "start": 1222.69,
   "end": 1223.03,
   "text": "בסדר."
  },
  {
   "start": 1223.81,
   "end": 1227.11,
   "text": "ואם כה יאמר לא חפצתי בך, ואם הוא יגיד לא רוצה אותך?"
  },
  {
   "start": 1227.47,
   "end": 1231.35,
   "text": "הנני יעשה לי כאשר טוב בעיניו,"
  },
  {
   "start": 1232.01,
   "end": 1235.73,
   "text": "הנני אני מוכן, יעשה בי כטוב בעיניו,"
  },
  {
   "start": 1236.13,
   "end": 1238.73,
   "text": "הנני לא אובדן המלוכה, אני מוכן."
  },
  {
   "start": 1239.47,
   "end": 1240.95,
   "text": "מה, גשימים בין סגירה מקלל?"
  },
  {
   "start": 1241.23,
   "end": 1243.79,
   "text": "הנני מוכן, מה שהשם רוצה, אני מוכן."
  },
  {
   "start": 1244.43,
   "end": 1246.21,
   "text": "הנני יעשה בי כטוב בעיניו,"
  },
  {
   "start": 1246.33,
   "end": 1247.33,
   "text": "מה יבזו אותי?"
  },
  {
   "start": 1247.85,
   "end": 1249.73,
   "text": "הנני כטוב בעיניו."
  },
  {
   "start": 1250.73,
   "end": 1253.03,
   "text": "הנני יעשה בי כטוב בעיניו."
  },
  {
   "start": 1253.45,
   "end": 1256.81,
   "text": "ירקו עליי, הנני יעשה בי כטוב בעיניו."
  },
  {
   "start": 1258.05,
   "end": 1260.69,
   "text": "ישפיל אותי, הנני כטוב בעיניו."
  },
  {
   "start": 1262.17,
   "end": 1266.63,
   "text": "מה יכול להיות? הרי מהקדוש ברוך הוא זה, אין לי רצון עצמי, יש לי רק מטרה אחת."
  },
  {
   "start": 1267.15,
   "end": 1270.23,
   "text": "הנני יעשה בי כטוב בעיניו, לרצון השם."
  },
  {
   "start": 1270.79,
   "end": 1274.09,
   "text": "נפלתי, הנני יעשה בי כטוב בעיניו."
  },
  {
   "start": 1275.01,
   "end": 1278.31,
   "text": "יאמור לי, תעלה, יגיד לי, תעלה, עכשיו הנה זה זמן של עלייה."
  },
  {
   "start": 1278.69,
   "end": 1280.61,
   "text": "הינני יעשה בי כתוב בעיניו."
  },
  {
   "start": 1280.97,
   "end": 1284.07,
   "text": "יגיד לי לרדת, הינני יעשה בי כתוב בעיניו."
  },
  {
   "start": 1285.05,
   "end": 1287.77,
   "text": "יגיד לי, לא רוצה אותך. לא רוצה, אין בעיה גם."
  },
  {
   "start": 1289.27,
   "end": 1290.59,
   "text": "לכן שמואל אמר על דוד,"
  },
  {
   "start": 1291.99,
   "end": 1294.67,
   "text": "ביקש הקדוש ברוך הוא לא איש כלבבו."
  },
  {
   "start": 1295.99,
   "end": 1297.45,
   "text": "ביקש בורא עולם ומצא."
  },
  {
   "start": 1300.81,
   "end": 1303.21,
   "text": "מצאתי את דוד עבדי, זעק השם מגבריו."
  },
  {
   "start": 1305.74,
   "end": 1306.5,
   "text": "זה היה דוד המלך."
  },
  {
   "start": 1307.44,
   "end": 1308.46,
   "text": "זה מלך המשיח שלנו."
  },
  {
   "start": 1309.34,
   "end": 1311.02,
   "text": "בדור גאולה שלנו, בורא העולם,"
  },
  {
   "start": 1311.48,
   "end": 1313.98,
   "text": "שתה לדוד כבר אז להגיד לנו, תראו את הדרך."
  },
  {
   "start": 1314.96,
   "end": 1315.86,
   "text": "תראו את הדרך."
  },
  {
   "start": 1316.32,
   "end": 1319.74,
   "text": "הנני יעשה בי כטוב בעיניו."
  },
  {
   "start": 1320.64,
   "end": 1324.26,
   "text": "הכל מהשם, אני מוכן, הנה כולי לכבוד השם."
  },
  {
   "start": 1324.8,
   "end": 1331.22,
   "text": "נפילות, ירידות, עליות, מש... הכל, הכל טוב, רע, יעשה בי כטוב בעיניו."
  }
 ]
}