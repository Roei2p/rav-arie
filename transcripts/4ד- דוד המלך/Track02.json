{
 "disc": "4ד- דוד המלך",
 "track": "Track02",
 "duration": 1316.16,
 "segments": [
  {
   "start": 5.34,
   "end": 10.66,
   "text": "בכתבי הארי הקדוש רשום כי בדורו של ישי עדיין לא הייתה מבוררת"
  },
  {
   "start": 11.44,
   "end": 14.54,
   "text": "ההלכה לא יבוא עמוני ומואבי בקהל השם."
  },
  {
   "start": 15.96,
   "end": 16.98,
   "text": "עמוני ולא עמונית."
  },
  {
   "start": 17.76,
   "end": 18.76,
   "text": "עמוניתית יכולה לבוא,"
  },
  {
   "start": 19.42,
   "end": 20.3,
   "text": "מואבית יכולה."
  },
  {
   "start": 21.42,
   "end": 21.94,
   "text": "ישי,"
  },
  {
   "start": 23.18,
   "end": 25.56,
   "text": "ישי גדול הדור היה נכד של רות המואבייה."
  },
  {
   "start": 26.38,
   "end": 29.88,
   "text": "והוא רצה, הוא שאף שלפחות אחד מהבנים שלו,"
  },
  {
   "start": 30.74,
   "end": 31.76,
   "text": "אחד מהבנים שלו יהיה"
  },
  {
   "start": 31.76,
   "end": 35.46,
   "text": "לא דווקא מאיזה זרע של מואב,"
  },
  {
   "start": 36.0,
   "end": 41.37,
   "text": "הוא רצה ככה לגמרי שבן אחד לפחות."
  },
  {
   "start": 42.23,
   "end": 44.25,
   "text": "אז הייתה לו שפחה,"
  },
  {
   "start": 45.15,
   "end": 48.91,
   "text": "והוא ידע שאם הוא יכול לקחת את השפחה ולשחרר אותה"
  },
  {
   "start": 49.63,
   "end": 51.91,
   "text": "על ידי שהוא נישא לה, נושא אותה לאישה,"
  },
  {
   "start": 53.55,
   "end": 55.03,
   "text": "והיא יוולד להם בן,"
  },
  {
   "start": 56.43,
   "end": 58.89,
   "text": "אז הבן הזה כבר לא יהיה"
  },
  {
   "start": 60.83,
   "end": 61.67,
   "text": "קשור למואב."
  },
  {
   "start": 66.32,
   "end": 67.62,
   "text": "השפחה שמעה את זה."
  },
  {
   "start": 68.94,
   "end": 69.42,
   "text": "השפחה,"
  },
  {
   "start": 70.4,
   "end": 71.14,
   "text": "מה שהיא עשתה,"
  },
  {
   "start": 73.1,
   "end": 73.64,
   "text": "היא הלכה,"
  },
  {
   "start": 74.16,
   "end": 76.82,
   "text": "הלכה לגברת שלה, לאשתו של ישי,"
  },
  {
   "start": 80.2,
   "end": 81.44,
   "text": "לנצבת בת דדיאל,"
  },
  {
   "start": 82.74,
   "end": 83.4,
   "text": "וסיפרה לה,"
  },
  {
   "start": 99.1,
   "end": 99.72,
   "text": "והיא ביקשה,"
  },
  {
   "start": 100.48,
   "end": 101.18,
   "text": "השפחה ביקשה"
  },
  {
   "start": 102.54,
   "end": 105.8,
   "text": "עצה איך להימלט מזה."
  },
  {
   "start": 110.6,
   "end": 112.18,
   "text": "ואשת ישי, נצבת בת דדיאל,"
  },
  {
   "start": 113.92,
   "end": 114.5,
   "text": "הסכימה"
  },
  {
   "start": 115.5,
   "end": 117.42,
   "text": "בחסות הלילה להתחלף איתה."
  },
  {
   "start": 124.61,
   "end": 125.37,
   "text": "אישה היא לא ידעה."
  },
  {
   "start": 127.53,
   "end": 128.23,
   "text": "הוא לא שם לב."
  },
  {
   "start": 132.02,
   "end": 132.84,
   "text": "ומה שקרה,"
  },
  {
   "start": 136.12,
   "end": 137.4,
   "text": "שנצבת בת אדיאל"
  },
  {
   "start": 150.0,
   "end": 150.92,
   "text": "ילדה בן."
  },
  {
   "start": 153.09,
   "end": 154.79,
   "text": "מקץ תשעה חודשים ילדה בן."
  },
  {
   "start": 167.12,
   "end": 168.84,
   "text": "אישה היא קיבלת זה כל כך קשה."
  },
  {
   "start": 170.32,
   "end": 171.12,
   "text": "איך יכול להיות?"
  },
  {
   "start": 178.52,
   "end": 179.36,
   "text": "זה לא יכול להיות."
  },
  {
   "start": 188.21,
   "end": 192.89,
   "text": "הרי אשתי נצבת בת אדיאל לא הייתה איתי באותה תקופה."
  },
  {
   "start": 194.61,
   "end": 195.23,
   "text": "לא יכול להיות."
  },
  {
   "start": 196.07,
   "end": 198.33,
   "text": "ונצוות בת אדיאלו מספרת, שותקת."
  },
  {
   "start": 200.87,
   "end": 203.47,
   "text": "וישי מתרחק ממנה."
  },
  {
   "start": 204.63,
   "end": 205.49,
   "text": "והילדים שלה"
  },
  {
   "start": 207.05,
   "end": 207.77,
   "text": "היו לה ילדים"
  },
  {
   "start": 209.57,
   "end": 210.33,
   "text": "כבר גדולים,"
  },
  {
   "start": 211.19,
   "end": 211.83,
   "text": "מתרחקים ממנה."
  },
  {
   "start": 213.03,
   "end": 213.71,
   "text": "אמא, מה עשית לנו?"
  },
  {
   "start": 214.59,
   "end": 215.29,
   "text": "איזו בושה."
  },
  {
   "start": 219.46,
   "end": 220.58,
   "text": "והילד שנולד,"
  },
  {
   "start": 221.84,
   "end": 224.08,
   "text": "לתינוק שנולד היא קרתה לו דוד."
  },
  {
   "start": 226.32,
   "end": 227.6,
   "text": "ודוד כשנולד,"
  },
  {
   "start": 228.42,
   "end": 231.92,
   "text": "הוא היה כל כך בזוי בעיני כולם."
  },
  {
   "start": 233.2,
   "end": 236.48,
   "text": "כל כך נמאס ודחוי בעיני כולם."
  },
  {
   "start": 237.6,
   "end": 238.34,
   "text": "ילד קטן"
  },
  {
   "start": 239.0,
   "end": 240.78,
   "text": "שנולד אל מציאות עגומה,"
  },
  {
   "start": 241.96,
   "end": 244.06,
   "text": "בו אף אחד לא רוצה את קרבתו."
  },
  {
   "start": 248.48,
   "end": 252.54,
   "text": "אפילו לאכול, כולם היו אוכלים בשולחן אחד ולא הקצו מקום"
  },
  {
   "start": 253.32,
   "end": 254.68,
   "text": "בפינה שנייה של הבית,"
  },
  {
   "start": 255.4,
   "end": 256.52,
   "text": "על שולחן נפרד."
  },
  {
   "start": 257.64,
   "end": 258.82,
   "text": "רחוק מכולם,"
  },
  {
   "start": 259.74,
   "end": 260.84,
   "text": "נבדל מכולם."
  },
  {
   "start": 266.0,
   "end": 269.42,
   "text": "וכך הוא גדל למציאות שבה אף אחד לא מעוניין בו."
  },
  {
   "start": 271.72,
   "end": 274.0,
   "text": "רק אמא שלו תומכת בו."
  },
  {
   "start": 274.76,
   "end": 277.34,
   "text": "כל אדם, כל ילד אולי היה נשבר מזה."
  },
  {
   "start": 278.04,
   "end": 282.98,
   "text": "כל ילד היה מקבל מזה קרירות גדולה, אבל דוד הוא משהו אחר."
  },
  {
   "start": 283.7,
   "end": 287.86,
   "text": "דוד בוחר לחסות בצל השכינה."
  },
  {
   "start": 288.56,
   "end": 294.86,
   "text": "דוד בוחר להתחבר אל קודש אבריך ואל הקדוש ברוך הוא."
  },
  {
   "start": 295.88,
   "end": 306.2,
   "text": "אמר רבי חמא בר חנינא אין לך אומנות בזויה יותר משל רועה שכל ימיו הולך במקלו ותרמילו ומאחר שאין לך אומנות כזו בזויה"
  },
  {
   "start": 306.78,
   "end": 309.28,
   "text": "זו המקצוע, זו האומנות"
  },
  {
   "start": 310.74,
   "end": 311.82,
   "text": "ששלחו את דוד אליה."
  },
  {
   "start": 314.56,
   "end": 317.44,
   "text": "אמרו האחים של דוד אמר ישי לך תהיה רועה,"
  },
  {
   "start": 317.9,
   "end": 318.66,
   "text": "לך תהיה רועה,"
  },
  {
   "start": 319.92,
   "end": 321.16,
   "text": "תראה את הצאן שלנו"
  },
  {
   "start": 322.46,
   "end": 326.64,
   "text": "ודוד מוצא את עצמו במרעה"
  },
  {
   "start": 327.74,
   "end": 328.32,
   "text": "רועה צאן,"
  },
  {
   "start": 331.56,
   "end": 332.1,
   "text": "שם במרעה."
  },
  {
   "start": 334.35,
   "end": 335.55,
   "text": "במקום להיות עצוב,"
  },
  {
   "start": 336.33,
   "end": 339.51,
   "text": "שם במרעה הוא מדבר עם השם, הוא שר להשם,"
  },
  {
   "start": 340.01,
   "end": 346.13,
   "text": "הוא מתחבר בעוותות של אהבה למלך מלכי המלכים הקדוש ברוך הוא."
  },
  {
   "start": 346.49,
   "end": 347.07,
   "text": "שם הוא מתעלה,"
  },
  {
   "start": 347.77,
   "end": 349.15,
   "text": "שם הוא לומד את התורה הקדושה,"
  },
  {
   "start": 349.71,
   "end": 353.73,
   "text": "שם הוא כותב את התהילים, את המזמורים הנפלאים."
  },
  {
   "start": 382.64,
   "end": 384.28,
   "text": "דוד עצמו כתב בתהילים"
  },
  {
   "start": 384.28,
   "end": 390.26,
   "text": "מוזר הייתי לאחייך, ונוכרי לי בני אמי."
  },
  {
   "start": 394.86,
   "end": 397.2,
   "text": "בבית הוא לא היה שפל ובזוי,"
  },
  {
   "start": 398.86,
   "end": 400.48,
   "text": "מתועב היה בבית,"
  },
  {
   "start": 401.4,
   "end": 403.72,
   "text": "אבל לא היה אצל הקדוש ברוך הוא אהוב,"
  },
  {
   "start": 404.62,
   "end": 415.82,
   "text": "חביב ונחמד, בנו האהוב של הקדוש ברוך הוא, ודוד,"
  },
  {
   "start": 416.48,
   "end": 417.4,
   "text": "דוד לא נשבר."
  },
  {
   "start": 418.44,
   "end": 420.72,
   "text": "דוד ממשיך לדבוק בשם, הוא לא יודע מה יהיה."
  },
  {
   "start": 421.08,
   "end": 422.84,
   "text": "אולי כל ימיו הוא יהיה ככה."
  },
  {
   "start": 423.14,
   "end": 425.64,
   "text": "אולי כל ימיו נגזר עליו לסבול ככה,"
  },
  {
   "start": 426.18,
   "end": 427.56,
   "text": "אבל הוא יסבול את זה בשמחה."
  },
  {
   "start": 428.86,
   "end": 431.5,
   "text": "הוא יתחבר אל השם, הוא והקדוש ברוך הוא."
  },
  {
   "start": 434.33,
   "end": 435.21,
   "text": "וכך דוד,"
  },
  {
   "start": 435.97,
   "end": 437.39,
   "text": "דוד גדל למציאות איומה,"
  },
  {
   "start": 438.99,
   "end": 440.49,
   "text": "למציאות של לחץ."
  },
  {
   "start": 446.47,
   "end": 449.61,
   "text": "מי יכול לעמוד? מי יכולה לעמוד בלחצים כאלה?"
  },
  {
   "start": 457.86,
   "end": 458.42,
   "text": "ונראה,"
  },
  {
   "start": 460.08,
   "end": 461.66,
   "text": "ונראה שאין לזה קץ."
  },
  {
   "start": 462.9,
   "end": 463.0,
   "text": "אבל,"
  },
  {
   "start": 463.94,
   "end": 465.1,
   "text": "אבל בשמיים חשבו אחרת."
  },
  {
   "start": 471.48,
   "end": 472.42,
   "text": "בארץ ישראל"
  },
  {
   "start": 473.4,
   "end": 474.1,
   "text": "היה רועה,"
  },
  {
   "start": 474.82,
   "end": 475.38,
   "text": "היה נביא,"
  },
  {
   "start": 477.12,
   "end": 478.56,
   "text": "שמואל הנביא."
  },
  {
   "start": 479.24,
   "end": 481.9,
   "text": "והקדוש ברוך הוא נגלה לשמואל הנביא ואומר לו,"
  },
  {
   "start": 483.74,
   "end": 486.88,
   "text": "והקדוש ברוך הוא נגלה לשמואל הנביא ואומר לו,"
  },
  {
   "start": 487.96,
   "end": 489.88,
   "text": "תמלא את הקרן שלך שמן."
  },
  {
   "start": 491.04,
   "end": 493.06,
   "text": "אני שולח אותך אל ישי בית הלחמי,"
  },
  {
   "start": 494.18,
   "end": 496.3,
   "text": "כי ראיתי באחד הבנים שלו,"
  },
  {
   "start": 497.3,
   "end": 499.86,
   "text": "שמתאים לי למלך."
  },
  {
   "start": 502.87,
   "end": 505.79,
   "text": "ושמואל לוקח את הקרן, לוקח את השמן,"
  },
  {
   "start": 506.67,
   "end": 508.19,
   "text": "בו הוא משך את שאול המלך,"
  },
  {
   "start": 509.27,
   "end": 513.99,
   "text": "ועכשיו הוא לוקח את השמן כדי למשוך את המלך השני של עם ישראל."
  },
  {
   "start": 515.51,
   "end": 517.77,
   "text": "הוא מגיע לבית לחם, וכשהוא מגיע,"
  },
  {
   "start": 518.63,
   "end": 521.11,
   "text": "ויחרדו זקני העיר לקראתו, התחילו לפחד."
  },
  {
   "start": 521.53,
   "end": 521.91,
   "text": "מה קרה?"
  },
  {
   "start": 522.55,
   "end": 526.13,
   "text": "מה קרה כששמואל מגיע לכאן? מה קרה הנביא הגדול? אולי מישהו עשה חטא גדול?"
  },
  {
   "start": 526.63,
   "end": 529.29,
   "text": "ששמואל הנביא צריך לבוא לעיר פה להוכיח אותנו?"
  },
  {
   "start": 530.11,
   "end": 531.95,
   "text": "אז הוא אומר להם, אל תדאגו, לא, אני באתי פה,"
  },
  {
   "start": 531.95,
   "end": 539.77,
   "text": "לזבוח לה' אל תדאגו זה בסדר ואז כולם שמה נרגעו בחרו להם אולם גדול"
  },
  {
   "start": 540.37,
   "end": 544.03,
   "text": "גדול ומתאים כזה אולם מהודר בכל בית לחם"
  },
  {
   "start": 545.25,
   "end": 551.99,
   "text": "ולמעמד הנשגב והנורא הזה הוזמנו נכבדי העיירה, כל הגדולים החשובים, כל תלמידי החכמים"
  },
  {
   "start": 555.92,
   "end": 558.04,
   "text": "וגם ישי והילדים שלו"
  },
  {
   "start": 561.55,
   "end": 565.07,
   "text": "ושמואל נכנס אל האולם מחפש מי זה ישי"
  },
  {
   "start": 565.07,
   "end": 568.33,
   "text": "וישי ניגש לשמואל"
  },
  {
   "start": 569.77,
   "end": 571.37,
   "text": "הוא אומר לו, תראה לי את הבנים שלך"
  },
  {
   "start": 573.81,
   "end": 576.01,
   "text": "ושמואל עובר בן אחרי בן"
  },
  {
   "start": 577.03,
   "end": 581.35,
   "text": "וכל בן בעולם אומר לו, זה לא הבן, זה לא זה"
  },
  {
   "start": 582.13,
   "end": 583.23,
   "text": "זה לא זה"
  },
  {
   "start": 584.25,
   "end": 585.71,
   "text": "וכך הוא עובר את כל הבנים"
  },
  {
   "start": 588.15,
   "end": 590.11,
   "text": "וכשנגמרו כל הבנים"
  },
  {
   "start": 592.79,
   "end": 595.63,
   "text": "שמואל פונה לישי ואומר לו, תגיד לי, זה כל הילדים שלך?"
  },
  {
   "start": 596.15,
   "end": 596.81,
   "text": "הוא אומר לו, כן?"
  },
  {
   "start": 601.37,
   "end": 601.93,
   "text": "הוא אומר לו, תראה"
  },
  {
   "start": 602.93,
   "end": 605.97,
   "text": "הקדוש ברוך הוא אמר לי, לך אל ישי בית הלחמי,"
  },
  {
   "start": 608.13,
   "end": 610.39,
   "text": "ואתה אומר לי, הילדים שלך תמו?"
  },
  {
   "start": 611.33,
   "end": 612.13,
   "text": "לא יכול להיות."
  },
  {
   "start": 613.03,
   "end": 614.01,
   "text": "אתה מסתיר משהו."
  },
  {
   "start": 614.83,
   "end": 616.75,
   "text": "יש איזה בן אחד שאתה מסתיר ממני."
  },
  {
   "start": 618.09,
   "end": 618.61,
   "text": "וישי,"
  },
  {
   "start": 619.35,
   "end": 619.89,
   "text": "מחביר כולו,"
  },
  {
   "start": 623.36,
   "end": 624.88,
   "text": "נשאר עוד אחד, הוא ממלמל."
  },
  {
   "start": 627.64,
   "end": 628.16,
   "text": "דוד,"
  },
  {
   "start": 628.9,
   "end": 630.46,
   "text": "הוא רועה צאן."
  },
  {
   "start": 632.69,
   "end": 634.17,
   "text": "עזוב אותו, הוא שם רועה צאן."
  },
  {
   "start": 635.73,
   "end": 636.93,
   "text": "אמר לו שמואל הנביא,"
  },
  {
   "start": 637.85,
   "end": 639.71,
   "text": "שלח את תביא לי את הרועה צאן הזה."
  },
  {
   "start": 640.91,
   "end": 642.29,
   "text": "את זה הרועה צאן עם החליל,"
  },
  {
   "start": 646.77,
   "end": 649.51,
   "text": "עם השמחה, עם הפשטות, תביא לי אותו לפה."
  },
  {
   "start": 653.28,
   "end": 655.86,
   "text": "ושליח נשלח לקרוא לדוד אל הצאן."
  },
  {
   "start": 660.44,
   "end": 662.0,
   "text": "השליח מגיע אל המרעה,"
  },
  {
   "start": 662.86,
   "end": 664.26,
   "text": "קר של דשא מרהיב."
  },
  {
   "start": 665.72,
   "end": 669.84,
   "text": "כבשים משוטטים להנאתם,"
  },
  {
   "start": 671.16,
   "end": 672.52,
   "text": "ונער חמודות."
  },
  {
   "start": 674.64,
   "end": 674.92,
   "text": "דוד,"
  },
  {
   "start": 675.76,
   "end": 679.48,
   "text": "דואג לכל כבשה וכבשה לכל טלה וטלה."
  },
  {
   "start": 681.3,
   "end": 681.88,
   "text": "שומר,"
  },
  {
   "start": 682.66,
   "end": 686.48,
   "text": "מנגן ושר תהילות לשם יתברך."
  },
  {
   "start": 690.24,
   "end": 691.6,
   "text": "בא השליח ואומר,"
  },
  {
   "start": 692.36,
   "end": 692.84,
   "text": "דוד,"
  },
  {
   "start": 693.54,
   "end": 694.32,
   "text": "דוד הרועה,"
  },
  {
   "start": 695.56,
   "end": 695.86,
   "text": "לך,"
  },
  {
   "start": 696.84,
   "end": 698.68,
   "text": "לך אל בית לחם אל האולם הגדול שמע,"
  },
  {
   "start": 699.34,
   "end": 700.68,
   "text": "מחכה לך שמואל הנביא."
  },
  {
   "start": 703.52,
   "end": 704.0,
   "text": "ודוד,"
  },
  {
   "start": 705.44,
   "end": 706.38,
   "text": "עוזב את הצאן,"
  },
  {
   "start": 707.14,
   "end": 709.9,
   "text": "לא לפני שהוא משאיר את אותו שליח כשומר, רץ הביתה."
  },
  {
   "start": 711.02,
   "end": 711.66,
   "text": "רץ הביתה."
  },
  {
   "start": 712.38,
   "end": 713.04,
   "text": "למה לא לעולם?"
  },
  {
   "start": 713.5,
   "end": 714.2,
   "text": "דוד יודע."
  },
  {
   "start": 714.66,
   "end": 715.58,
   "text": "אפילו שאני רואה."
  },
  {
   "start": 716.26,
   "end": 717.46,
   "text": "אפילו שאני רואה צאן."
  },
  {
   "start": 717.98,
   "end": 720.3,
   "text": "צריך לכבד תלמידי חכמים."
  },
  {
   "start": 720.78,
   "end": 722.26,
   "text": "צריך לכבד את כבוד התורה."
  },
  {
   "start": 722.62,
   "end": 727.08,
   "text": "ואם שמואל הנביא רוצה אותי, אני לא יודע מה הוא רוצה, בין לטוב, בין לפחות טוב."
  },
  {
   "start": 727.94,
   "end": 729.42,
   "text": "אני אתלבש בצורה מכובדת."
  },
  {
   "start": 730.68,
   "end": 731.52,
   "text": "הוא רץ הביתה"
  },
  {
   "start": 732.12,
   "end": 733.2,
   "text": "להחליף בגדים."
  },
  {
   "start": 738.46,
   "end": 740.88,
   "text": "הוא מגיע הביתה, מתחיל לחפש לו בגדים."
  },
  {
   "start": 742.18,
   "end": 743.88,
   "text": "ולפתע הוא מרגיש דמות מסתכלת עליו,"
  },
  {
   "start": 743.94,
   "end": 745.54,
   "text": "נוכחות של דמות, הוא מסתובב."
  },
  {
   "start": 746.88,
   "end": 752.24,
   "text": "בפתח החדר עומדת לה נצוות בת אדיאל,"
  },
  {
   "start": 753.02,
   "end": 753.88,
   "text": "האמא של דוד."
  },
  {
   "start": 754.72,
   "end": 755.88,
   "text": "בני היקר, מה קורה פה?"
  },
  {
   "start": 756.94,
   "end": 758.38,
   "text": "מה קרה בתה באמצע היום?"
  },
  {
   "start": 759.42,
   "end": 759.72,
   "text": "אמא,"
  },
  {
   "start": 760.74,
   "end": 761.5,
   "text": "אמא קראו לי."
  },
  {
   "start": 762.2,
   "end": 763.78,
   "text": "אמרו לי ששמואל הנביא בא,"
  },
  {
   "start": 764.34,
   "end": 766.16,
   "text": "בא לבית לחם והוא רוצה לדבר איתי."
  },
  {
   "start": 767.02,
   "end": 769.0,
   "text": "הוא הזמין אותי לבוא אליו, אני חייב ללכת."
  },
  {
   "start": 769.58,
   "end": 770.54,
   "text": "אז באתי להתלבש,"
  },
  {
   "start": 771.3,
   "end": 774.84,
   "text": "להתלבש בגדים שאני אוכל לבוא אל הנביא הקדוש הזה."
  },
  {
   "start": 780.56,
   "end": 781.84,
   "text": "ונצוות בתדיאל"
  },
  {
   "start": 783.18,
   "end": 784.28,
   "text": "נצוות בתדיאל אומרת"
  },
  {
   "start": 785.06,
   "end": 786.28,
   "text": "לדוד, לבן שלה,"
  },
  {
   "start": 787.46,
   "end": 788.44,
   "text": "למחמד עיניה."
  },
  {
   "start": 790.16,
   "end": 790.8,
   "text": "אומרת לו, בני,"
  },
  {
   "start": 791.42,
   "end": 792.48,
   "text": "אני מצטרפת אליך,"
  },
  {
   "start": 793.14,
   "end": 794.22,
   "text": "אני רוצה לדעת מה קורה,"
  },
  {
   "start": 794.94,
   "end": 798.4,
   "text": "לדעת מה שמואל הנביא רוצה ממך, מה הבן שלי."
  },
  {
   "start": 801.94,
   "end": 803.98,
   "text": "היא מנגבת דמעה קטנה מעיניה."
  },
  {
   "start": 804.74,
   "end": 808.22,
   "text": "מפחדת, מה, מה, מה שמואל הנביא רוצה מהבן שלי?"
  },
  {
   "start": 809.58,
   "end": 810.98,
   "text": "ובאולם, שמה בבית לחם,"
  },
  {
   "start": 812.44,
   "end": 814.82,
   "text": "ישי חיוור כמו סידו והילדים שלו."
  },
  {
   "start": 815.7,
   "end": 817.94,
   "text": "בטח שמואל הנביא עכשיו בא להוכיח אותנו,"
  },
  {
   "start": 818.62,
   "end": 819.6,
   "text": "בא להראות לכולנו,"
  },
  {
   "start": 820.06,
   "end": 821.92,
   "text": "לכל עם ישראל את החרפה שלנו,"
  },
  {
   "start": 822.24,
   "end": 823.6,
   "text": "שיש לנו בן לא הגון,"
  },
  {
   "start": 824.64,
   "end": 825.46,
   "text": "את אותו דוד."
  },
  {
   "start": 826.78,
   "end": 827.58,
   "text": "איזו בושה."
  },
  {
   "start": 828.16,
   "end": 829.48,
   "text": "בא להראות לנו את הבושה,"
  },
  {
   "start": 830.24,
   "end": 835.16,
   "text": "את הכלימה שהחזקנו."
  },
  {
   "start": 837.0,
   "end": 841.87,
   "text": "בן לא, לא הגון כל כך."
  },
  {
   "start": 846.16,
   "end": 847.04,
   "text": "ודוד המלך"
  },
  {
   "start": 848.0,
   "end": 850.74,
   "text": "ואימא שלו פוסעים יחדיו,"
  },
  {
   "start": 852.14,
   "end": 852.82,
   "text": "מתקרבים,"
  },
  {
   "start": 853.64,
   "end": 854.56,
   "text": "מתקרבים אל האולם."
  },
  {
   "start": 857.71,
   "end": 858.73,
   "text": "דוד המלך ניגש,"
  },
  {
   "start": 860.17,
   "end": 861.01,
   "text": "הנה הדלת מולו."
  },
  {
   "start": 864.83,
   "end": 866.99,
   "text": "הוא לוחץ, לוחץ על הידית,"
  },
  {
   "start": 868.37,
   "end": 869.45,
   "text": "והדלת נפתחת."
  },
  {
   "start": 873.83,
   "end": 875.13,
   "text": "והוא נכנס פנימה."
  },
  {
   "start": 885.69,
   "end": 886.59,
   "text": "ואז הוא נכנס."
  },
  {
   "start": 887.37,
   "end": 889.71,
   "text": "ואז לפתע שמואל שם לב."
  },
  {
   "start": 890.51,
   "end": 898.21,
   "text": "ופתאום הקדוש ברוך הוא אומר לשמואל משיחי עומד בפתח ואתה יושב המשיח שלי עומד ואתה יושב"
  },
  {
   "start": 899.57,
   "end": 909.81,
   "text": "קום תמשך אותו כי זה הוא ואז שמואל קם ופונה אל דוד אל מרכז האולם ודוד כופה על מקומו"
  },
  {
   "start": 910.53,
   "end": 916.05,
   "text": "וכל הקהל מסתכל וכשכל הקהל רואים את שמואל קם גם הם קמים"
  },
  {
   "start": 917.19,
   "end": 918.39,
   "text": "וכל הקהל קם"
  },
  {
   "start": 919.01,
   "end": 920.49,
   "text": "וכל העולם קם."
  },
  {
   "start": 921.73,
   "end": 922.69,
   "text": "וישי קם,"
  },
  {
   "start": 923.27,
   "end": 924.25,
   "text": "והפנים קמים."
  },
  {
   "start": 927.37,
   "end": 930.29,
   "text": "ושמואל פוסע אל דוד המלך."
  },
  {
   "start": 931.69,
   "end": 939.98,
   "text": "אל דוד המלך לוקח את הקרן ומושך אותו,"
  },
  {
   "start": 940.8,
   "end": 943.06,
   "text": "מושך אותו למלך על ישראל."
  },
  {
   "start": 944.94,
   "end": 945.46,
   "text": "ופתאום"
  },
  {
   "start": 946.12,
   "end": 946.92,
   "text": "כל העולם"
  },
  {
   "start": 947.68,
   "end": 950.1,
   "text": "נמלא בקול תרועה ושמחה,"
  },
  {
   "start": 950.72,
   "end": 952.94,
   "text": "יחי אדוננו המלך דוד,"
  },
  {
   "start": 953.5,
   "end": 956.0,
   "text": "יחי המלך, יחי המלך."
  },
  {
   "start": 957.3,
   "end": 959.08,
   "text": "מלך חדש לעם ישראל,"
  },
  {
   "start": 970.22,
   "end": 971.04,
   "text": "מלך חדש."
  },
  {
   "start": 971.42,
   "end": 972.28,
   "text": "וישי המום,"
  },
  {
   "start": 972.92,
   "end": 973.98,
   "text": "וכל הנאספים"
  },
  {
   "start": 975.88,
   "end": 977.26,
   "text": "נרעדים משמחה."
  },
  {
   "start": 977.86,
   "end": 980.64,
   "text": "וישי פתאום, האמת מול הפנים."
  },
  {
   "start": 981.0,
   "end": 982.02,
   "text": "הוא טעה כל השנים,"
  },
  {
   "start": 982.6,
   "end": 983.8,
   "text": "הוא טעה כל השנים."
  },
  {
   "start": 984.88,
   "end": 986.1,
   "text": "והפנים מסתכלים,"
  },
  {
   "start": 986.64,
   "end": 987.54,
   "text": "לא מאמינים."
  },
  {
   "start": 988.26,
   "end": 990.92,
   "text": "האח שלנו הוא מלך ישראל!"
  },
  {
   "start": 991.4,
   "end": 992.18,
   "text": "הוא קדוש!"
  },
  {
   "start": 992.88,
   "end": 993.94,
   "text": "הוא המלך!"
  },
  {
   "start": 994.32,
   "end": 997.16,
   "text": "הוא המלך! ואז השפתיים שלהם ממלמלות,"
  },
  {
   "start": 997.64,
   "end": 998.52,
   "text": "יחי המלך!"
  },
  {
   "start": 999.06,
   "end": 999.76,
   "text": "יחי המלך!"
  },
  {
   "start": 1013.09,
   "end": 1013.85,
   "text": "ואי שם,"
  },
  {
   "start": 1014.87,
   "end": 1015.73,
   "text": "מבחוץ,"
  },
  {
   "start": 1016.63,
   "end": 1017.67,
   "text": "מבעד לחלון,"
  },
  {
   "start": 1019.49,
   "end": 1023.19,
   "text": "נשמע קול בכי מחריד,"
  },
  {
   "start": 1025.44,
   "end": 1026.1,
   "text": "והעולם"
  },
  {
   "start": 1027.04,
   "end": 1028.22,
   "text": "לפתע נדם."
  },
  {
   "start": 1028.22,
   "end": 1031.38,
   "text": "קול בכי מחרית נשמע,"
  },
  {
   "start": 1033.26,
   "end": 1034.88,
   "text": "ניצבת בת אדיאל,"
  },
  {
   "start": 1036.1,
   "end": 1037.16,
   "text": "אמא של דוד,"
  },
  {
   "start": 1038.68,
   "end": 1040.38,
   "text": "מתייפחת לה בבכי,"
  },
  {
   "start": 1042.54,
   "end": 1045.32,
   "text": "כל עשרים ושמונה השנים,"
  },
  {
   "start": 1046.34,
   "end": 1048.54,
   "text": "עשרים ושמונה שנות עלבונות,"
  },
  {
   "start": 1049.52,
   "end": 1054.02,
   "text": "עשרים ושמונה שנות ביזיונות שלה ושל הבן שלה,"
  },
  {
   "start": 1055.84,
   "end": 1056.7,
   "text": "מצאו פורקן"
  },
  {
   "start": 1057.48,
   "end": 1060.46,
   "text": "בזרם דמעות שפרץ מעיניה."
  },
  {
   "start": 1064.57,
   "end": 1065.57,
   "text": "היא בוכה,"
  },
  {
   "start": 1070.37,
   "end": 1076.56,
   "text": "האמא הגדולה בוכה, עכשיו נפתרה התעלומה."
  },
  {
   "start": 1077.58,
   "end": 1078.46,
   "text": "פה עונה חסות,"
  },
  {
   "start": 1079.92,
   "end": 1080.7,
   "text": "הנביא גילה זאת."
  },
  {
   "start": 1081.64,
   "end": 1082.18,
   "text": "דוד,"
  },
  {
   "start": 1082.92,
   "end": 1087.76,
   "text": "דוד איננו בן פסול, איננו בן בזוי, אלא קודש,"
  },
  {
   "start": 1088.46,
   "end": 1090.2,
   "text": "קדוש לאבא קדוש."
  },
  {
   "start": 1091.32,
   "end": 1095.34,
   "text": "בכל מיני קדושה וטהרה התגלתה האמת,"
  },
  {
   "start": 1095.9,
   "end": 1100.52,
   "text": "ונצוות, התגלתה האמת,"
  },
  {
   "start": 1101.0,
   "end": 1102.9,
   "text": "ונצוות בתדיאל"
  },
  {
   "start": 1103.8,
   "end": 1108.98,
   "text": "בוכה בכי של עשרים ושמונה שנות כאב."
  },
  {
   "start": 1114.14,
   "end": 1114.8,
   "text": "והדמעות האלה,"
  },
  {
   "start": 1115.98,
   "end": 1118.72,
   "text": "הדמעות האלה עולות אל כיסא הכבוד,"
  },
  {
   "start": 1119.54,
   "end": 1120.56,
   "text": "דמעות של גיל,"
  },
  {
   "start": 1121.3,
   "end": 1122.26,
   "text": "דמעות של שמחה."
  },
  {
   "start": 1131.13,
   "end": 1132.87,
   "text": "אמרה נצוות בתדיאל"
  },
  {
   "start": 1134.29,
   "end": 1135.95,
   "text": "אבן מעשו הבונים"
  },
  {
   "start": 1139.28,
   "end": 1140.58,
   "text": "הייתה לראש פינה."
  },
  {
   "start": 1141.58,
   "end": 1148.46,
   "text": "אבן מעשו אי בן שמעשו הבונים הבנים הייתה לראש פינה."
  },
  {
   "start": 1150.32,
   "end": 1151.32,
   "text": "דוד המלך,"
  },
  {
   "start": 1152.24,
   "end": 1153.16,
   "text": "מלך ישראל,"
  },
  {
   "start": 1155.5,
   "end": 1156.68,
   "text": "משיח ובן דוד,"
  },
  {
   "start": 1158.2,
   "end": 1166.64,
   "text": "דוד המלך גדל וסבל והושפל ובוזה עד שבסוף"
  },
  {
   "start": 1167.16,
   "end": 1173.48,
   "text": "כל העולם גילה שהוא יהלום, הוא הבן של השם יתברך, בן קדוש וטהור."
  },
  {
   "start": 1174.84,
   "end": 1176.52,
   "text": "בהתחלה כולם לעגו עליו,"
  },
  {
   "start": 1177.22,
   "end": 1183.34,
   "text": "והוא סבל והוא שתק, אבל הוא לא ויתר על החיבור שלו לשם יתברך, הוא לא ויתר על זה."
  },
  {
   "start": 1183.82,
   "end": 1186.88,
   "text": "הוא לא ויתר על האהבה שלו לשם יתברך, לא ויתר."
  },
  {
   "start": 1189.23,
   "end": 1192.45,
   "text": "ובסוף הוא זה שנהיה למלך ישראל."
  },
  {
   "start": 1193.81,
   "end": 1195.93,
   "text": "והוא השאיר לנו את הדרך חיים הזאת."
  },
  {
   "start": 1196.67,
   "end": 1200.29,
   "text": "צריך לדעת בתקופה שלנו, תקופת הגאולה זה תקופת דוד המלך."
  },
  {
   "start": 1201.23,
   "end": 1204.79,
   "text": "אנחנו מרגישים לפעמים מבוזים, לועגים לנו, צוחקים,"
  },
  {
   "start": 1205.71,
   "end": 1209.77,
   "text": "מה שאנחנו אומרים. אתה כבר מפקפק, אתה לא יודע מה, הדרך שלי נכונה או לא?"
  },
  {
   "start": 1210.25,
   "end": 1213.05,
   "text": "התקרבתי לשם, זה נכון או לא? אני כבר לא יודע, אני מבולבל!"
  },
  {
   "start": 1214.23,
   "end": 1214.87,
   "text": "אבל סבלנות."
  },
  {
   "start": 1215.97,
   "end": 1217.53,
   "text": "דוד המלך חיכה 28 שנה,"
  },
  {
   "start": 1218.19,
   "end": 1220.83,
   "text": "מבקש מאיתנו סבלנות, אני בזבוזתי,"
  },
  {
   "start": 1221.49,
   "end": 1222.91,
   "text": "אני הושפלתי!"
  },
  {
   "start": 1223.65,
   "end": 1224.71,
   "text": "אני בערך ישראל,"
  },
  {
   "start": 1224.71,
   "end": 1226.21,
   "text": "אל תראו איך היה לי!"
  },
  {
   "start": 1226.69,
   "end": 1229.07,
   "text": "עד שבסוף האמת יצאה לאור."
  },
  {
   "start": 1230.07,
   "end": 1231.59,
   "text": "ככה גם יהיה עם עם ישראל,"
  },
  {
   "start": 1232.17,
   "end": 1233.15,
   "text": "ככה יהיה גם איתכם,"
  },
  {
   "start": 1233.63,
   "end": 1235.11,
   "text": "ככה יהיה גם איתנו כולנו."
  },
  {
   "start": 1235.91,
   "end": 1237.43,
   "text": "אז היום מסתכלים ואומרים, מי אתם?"
  },
  {
   "start": 1238.03,
   "end": 1238.51,
   "text": "מה אתם?"
  },
  {
   "start": 1238.85,
   "end": 1244.11,
   "text": "ההרגשה שלנו, לבד, בודדים במערכת, קשיים, לא הולך בדיוק כמו שרוצים,"
  },
  {
   "start": 1244.51,
   "end": 1245.65,
   "text": "התשובה לא כמו שרוצים,"
  },
  {
   "start": 1245.91,
   "end": 1249.19,
   "text": "הכלכלה לא הולכת כמו שרוצים, הכל לא כמו שרוצים, הילדים הכל."
  },
  {
   "start": 1250.01,
   "end": 1250.07,
   "text": "אבל,"
  },
  {
   "start": 1251.83,
   "end": 1253.37,
   "text": "אבל בורא העולם בא ואומר סבלנות,"
  },
  {
   "start": 1254.83,
   "end": 1256.71,
   "text": "תראו, עוד כל העולם,"
  },
  {
   "start": 1257.23,
   "end": 1261.55,
   "text": "כל אותי עולם יבוא וירצה להיות כמוכם,"
  },
  {
   "start": 1262.71,
   "end": 1267.33,
   "text": "כל העולם כולו יהיה כעפר לרגלינו."
  },
  {
   "start": 1273.44,
   "end": 1277.4,
   "text": "זה סוד הגאולה של דוד המלך, דוד מלך ישראל, משיח בן דוד,"
  },
  {
   "start": 1279.68,
   "end": 1281.24,
   "text": "יבוא ויגאל סופית."
  },
  {
   "start": 1283.17,
   "end": 1283.71,
   "text": "את מי הוא יגאל?"
  },
  {
   "start": 1284.39,
   "end": 1285.95,
   "text": "את מי שילך בדרך שלו,"
  },
  {
   "start": 1286.41,
   "end": 1287.43,
   "text": "שבקשיים,"
  },
  {
   "start": 1288.09,
   "end": 1291.59,
   "text": "בייסורים, הלך ונדבק אל השם יתברך,"
  },
  {
   "start": 1291.59,
   "end": 1293.99,
   "text": "הלך ושר שירים לשם יתברך."
  }
 ]
}