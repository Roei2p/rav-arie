{
 "disc": "4ד- דוד המלך",
 "track": "Track04",
 "duration": 872.16,
 "segments": [
  {
   "start": 13.42,
   "end": 13.92,
   "text": "בווילנה,"
  },
  {
   "start": 15.02,
   "end": 16.62,
   "text": "בווילנה הייתה קופת צדקה"
  },
  {
   "start": 18.36,
   "end": 20.7,
   "text": "של הגאון ואב בית דין, הרב קרמר,"
  },
  {
   "start": 21.82,
   "end": 22.74,
   "text": "זכר צדיק לברכה."
  },
  {
   "start": 24.26,
   "end": 25.26,
   "text": "כשהוא נפטר,"
  },
  {
   "start": 25.86,
   "end": 28.08,
   "text": "כשהרב קרמר נפטר, הוא השאיר כסף,"
  },
  {
   "start": 29.8,
   "end": 36.92,
   "text": "סכום קבוע שממנו כל חודש יופרש שכר לחתן, לחתן שלו,"
  },
  {
   "start": 38.96,
   "end": 40.88,
   "text": "כדי שיוכל לקיים את המשפחה שלו"
  },
  {
   "start": 41.46,
   "end": 43.54,
   "text": "וללמוד תורה בשקט ובנחת."
  },
  {
   "start": 52.19,
   "end": 59.19,
   "text": "ומדוע הרב קרמר טרח כל כך כדי שהחתן שלו ישב וילמד תורה ויקבל שכר קבוע?"
  },
  {
   "start": 59.79,
   "end": 62.73,
   "text": "כי לחתן של הרב קרמר קראו רבי אליהו."
  },
  {
   "start": 64.33,
   "end": 65.37,
   "text": "וזה היה בעיר וילנה."
  },
  {
   "start": 66.85,
   "end": 69.37,
   "text": "והחתן של הרב קרמר היה גאון גדול."
  },
  {
   "start": 70.71,
   "end": 71.41,
   "text": "הגאון מווילנה."
  },
  {
   "start": 75.77,
   "end": 77.87,
   "text": "וכך בראשית דרכו של הגאון בווילנה"
  },
  {
   "start": 79.19,
   "end": 81.99,
   "text": "היה גבאי של קופת אותה קופת חסד,"
  },
  {
   "start": 82.87,
   "end": 85.95,
   "text": "קראו לו זאב, הוא היה מביא כל חודש חמישים רובל"
  },
  {
   "start": 88.09,
   "end": 89.65,
   "text": "לגאון כדי שהגאון יספיק,"
  },
  {
   "start": 90.61,
   "end": 92.97,
   "text": "אשתו תספיק לקלקל את הבית, אשתו הייתה מנהלת את הבית."
  },
  {
   "start": 95.69,
   "end": 100.65,
   "text": "והעיר וילנה הייתה שמחה ומאושרת שאישיות תורנית כזאת דגולה נמצאת בתוכה."
  },
  {
   "start": 104.14,
   "end": 104.42,
   "text": "ככה"
  },
  {
   "start": 105.68,
   "end": 106.62,
   "text": "עברה לה התקופה"
  },
  {
   "start": 109.28,
   "end": 111.12,
   "text": "ונראה שהכול שלו, הכול רגוע."
  },
  {
   "start": 120.6,
   "end": 126.26,
   "text": "אבל יש בית אחד בווילנה,"
  },
  {
   "start": 127.24,
   "end": 128.54,
   "text": "לפחות בית אחד שאנחנו יודעים עליו,"
  },
  {
   "start": 128.54,
   "end": 132.34,
   "text": "ששם הרוחות קצת היו סוערות, לא בדיוק שקטות."
  },
  {
   "start": 136.08,
   "end": 136.6,
   "text": "הצעקות"
  },
  {
   "start": 137.34,
   "end": 140.18,
   "text": "מבית זאב הגבאי היו הפעם רמות."
  },
  {
   "start": 141.46,
   "end": 141.74,
   "text": "שקט!"
  },
  {
   "start": 142.82,
   "end": 143.64,
   "text": "השכנים ישמעו!"
  },
  {
   "start": 146.43,
   "end": 147.01,
   "text": "אמר זאב."
  },
  {
   "start": 148.35,
   "end": 148.75,
   "text": "אבל אשתו,"
  },
  {
   "start": 149.33,
   "end": 152.37,
   "text": "אשתו צעקה, שישמעו! שידעו את האמת!"
  },
  {
   "start": 156.17,
   "end": 159.11,
   "text": "המצב הכלכלי הקשה שפקד אותם"
  },
  {
   "start": 159.65,
   "end": 160.57,
   "text": "עורר מחלוקות,"
  },
  {
   "start": 161.05,
   "end": 161.87,
   "text": "עורר זעם,"
  },
  {
   "start": 162.23,
   "end": 162.85,
   "text": "עורר תסכול,"
  },
  {
   "start": 163.01,
   "end": 164.21,
   "text": "לא היה נעים להיות בבית כזה."
  },
  {
   "start": 164.21,
   "end": 164.49,
   "text": "כזה."
  },
  {
   "start": 166.05,
   "end": 167.43,
   "text": "כבר מספר שבועות זאב"
  },
  {
   "start": 169.21,
   "end": 171.35,
   "text": "לא מצליח לישון, אינו עוצם עין."
  },
  {
   "start": 171.95,
   "end": 174.65,
   "text": "הלחץ, העצבנות, מאיפה יביא מקור פרנסה?"
  },
  {
   "start": 176.33,
   "end": 178.61,
   "text": "והעיר וילנה נמה את שנתה? אף אחד לא יודע."
  },
  {
   "start": 185.06,
   "end": 185.7,
   "text": "לזאב,"
  },
  {
   "start": 187.66,
   "end": 190.58,
   "text": "כך הוא הרגיש, לא נותרה לי ברירה, כך הוא חשב."
  },
  {
   "start": 193.87,
   "end": 194.69,
   "text": "הפעם הבאה כשהוא בא"
  },
  {
   "start": 195.55,
   "end": 196.65,
   "text": "עם חמישים הרובל"
  },
  {
   "start": 197.51,
   "end": 198.57,
   "text": "לתת לגאון מווילנה"
  },
  {
   "start": 198.57,
   "end": 202.85,
   "text": "את דפיקות הלב שלו הוא שמע עד לאוזניו."
  },
  {
   "start": 205.14,
   "end": 208.76,
   "text": "לרגע היה נראה לו שהגאון עצמו רואה את דפיקות הלב שלו."
  },
  {
   "start": 210.42,
   "end": 212.64,
   "text": "הגאון חייך כדרכו, אמר תודה במאור פנים,"
  },
  {
   "start": 213.78,
   "end": 215.2,
   "text": "וזאב יצא החוצה ונמלט."
  },
  {
   "start": 216.5,
   "end": 218.26,
   "text": "הוא נתן רק ארבעים רובל לגאון."
  },
  {
   "start": 219.24,
   "end": 221.36,
   "text": "עשר רובל היו אצלו בכיס."
  },
  {
   "start": 224.36,
   "end": 225.06,
   "text": "טוב, הרב צדיק,"
  },
  {
   "start": 225.58,
   "end": 227.66,
   "text": "הרב ישתוק, חודש הבא כבר אני אחזיר לו."
  },
  {
   "start": 228.02,
   "end": 231.12,
   "text": "לפחות עשר רובל ככה להרגיע את העניינים בבית, ואני אסתדר כבר,"
  },
  {
   "start": 231.2,
   "end": 232.66,
   "text": "ובן השבוע, חודש הבא אני אחזיר לו."
  },
  {
   "start": 233.4,
   "end": 235.38,
   "text": "לפחות תהיה קצת שקט, כך הוא חשב לו."
  },
  {
   "start": 239.67,
   "end": 240.31,
   "text": "חודש הבא,"
  },
  {
   "start": 242.99,
   "end": 243.23,
   "text": "שוב,"
  },
  {
   "start": 243.89,
   "end": 244.73,
   "text": "ארבעים רובל."
  },
  {
   "start": 246.35,
   "end": 247.51,
   "text": "הגאון חייך כרגיל,"
  },
  {
   "start": 248.35,
   "end": 249.97,
   "text": "כאילו כלום לא קרה לו, סופר את הכסף."
  },
  {
   "start": 251.25,
   "end": 253.49,
   "text": "וזאב פרץ לו בהנחת רווחה כשהוא יצא"
  },
  {
   "start": 254.13,
   "end": 254.63,
   "text": "מבית הגאון."
  },
  {
   "start": 258.0,
   "end": 260.72,
   "text": "כך עובר לו עוד חודש ועוד חודש."
  },
  {
   "start": 263.95,
   "end": 267.21,
   "text": "וכשאדם מתרגל לקחת, לגנוב,"
  },
  {
   "start": 269.78,
   "end": 271.26,
   "text": "הוא דעת פורץ את כל המעצורים."
  },
  {
   "start": 273.26,
   "end": 273.62,
   "text": "וכך,"
  },
  {
   "start": 276.24,
   "end": 279.22,
   "text": "כבר תקופה ארוכה זאב הגבאי לא מביא בכלל"
  },
  {
   "start": 279.84,
   "end": 282.24,
   "text": "את השכר החודשי מקופת הצדקה של הרב קרמר."
  },
  {
   "start": 283.74,
   "end": 286.12,
   "text": "את הכסף כולו הוא החל משלשל לכיסו,"
  },
  {
   "start": 290.57,
   "end": 292.03,
   "text": "ובבית הגאון מווילנה,"
  },
  {
   "start": 292.89,
   "end": 295.53,
   "text": "במקום לקבל איזה שכר על כל הלימוד שלו,"
  },
  {
   "start": 296.11,
   "end": 297.77,
   "text": "על כל הדבקות בשם יתברך,"
  },
  {
   "start": 298.33,
   "end": 300.33,
   "text": "על כל העוצמה הרוחנית של אשתו,"
  },
  {
   "start": 300.93,
   "end": 302.23,
   "text": "חשים מחסור איום."
  },
  {
   "start": 305.76,
   "end": 306.6,
   "text": "אשת הגאון,"
  },
  {
   "start": 307.04,
   "end": 310.14,
   "text": "שהתמודדה עם זרם הכסף שהחל לרדת, לא אמרה כלום."
  },
  {
   "start": 310.72,
   "end": 311.76,
   "text": "אם בעלה שותק,"
  },
  {
   "start": 312.42,
   "end": 312.96,
   "text": "מה היא תגיד?"
  },
  {
   "start": 314.38,
   "end": 315.24,
   "text": "עדיף שאני אשתוק."
  },
  {
   "start": 316.14,
   "end": 317.64,
   "text": "והם סובלים בדממה."
  },
  {
   "start": 320.08,
   "end": 325.1,
   "text": "היא מנהלת הבית בתקציב אפסיק עימה. היא לוקחת בגדים, מחדשת בגדים לילדים על ידי תפירות."
  },
  {
   "start": 326.12,
   "end": 328.16,
   "text": "על ידי אלתור של בדים שהיא מוצאת,"
  },
  {
   "start": 328.64,
   "end": 330.48,
   "text": "היא תופרת בגדים לטובת הילדים."
  },
  {
   "start": 335.06,
   "end": 335.5,
   "text": "זה כואב,"
  },
  {
   "start": 336.54,
   "end": 338.3,
   "text": "זה קשה, תדעו לכם, במיוחד לאישה."
  },
  {
   "start": 339.48,
   "end": 341.56,
   "text": "אישה שרוצה ואוהבת לבשל."
  },
  {
   "start": 342.4,
   "end": 345.28,
   "text": "שרוצה קצת לתת משהו חום בבית חום של אימא,"
  },
  {
   "start": 345.44,
   "end": 347.84,
   "text": "ואין לה מה לתת לאכול."
  },
  {
   "start": 348.94,
   "end": 350.5,
   "text": "אין לה מה להכין אוכל לבעלה."
  },
  {
   "start": 353.58,
   "end": 355.1,
   "text": "אבל הוא לא בא בטרוניה,"
  },
  {
   "start": 359.32,
   "end": 360.02,
   "text": "והיא שותקת."
  },
  {
   "start": 360.9,
   "end": 365.86,
   "text": "היא יודעת שהכל לא שווה אף מבט אחד של צער מבעלה הגאון."
  },
  {
   "start": 368.25,
   "end": 369.29,
   "text": "האוכל שהיא אוכלת,"
  },
  {
   "start": 370.73,
   "end": 371.91,
   "text": "הנחת שיש לה,"
  },
  {
   "start": 373.87,
   "end": 375.13,
   "text": "אתם יודעים מה האוכל שלה?"
  },
  {
   "start": 375.57,
   "end": 376.33,
   "text": "האוכל שלה,"
  },
  {
   "start": 376.97,
   "end": 378.57,
   "text": "שככה בשעות הלילה המאוחרות"
  },
  {
   "start": 380.29,
   "end": 381.19,
   "text": "היא יכולה להביט,"
  },
  {
   "start": 382.35,
   "end": 392.09,
   "text": "אל בעלה השוקד על תורת הבורא יומם ולילה וכולו שלהבת של תורה ואורה את זה אי אפשר לקחת ממנה"
  },
  {
   "start": 392.77,
   "end": 393.87,
   "text": "כל זה שלה"
  },
  {
   "start": 396.67,
   "end": 397.81,
   "text": "וזה שווה את הכל"
  },
  {
   "start": 399.53,
   "end": 404.41,
   "text": "אז קשה אז זה מייאש יום רודף יום ולא נראה שיש סיכוי"
  },
  {
   "start": 406.86,
   "end": 407.5,
   "text": "זה שווה"
  },
  {
   "start": 408.82,
   "end": 413.64,
   "text": "וזה נותן לה עוד כוח לעוד יום כל לילה כך הילדים הולכים לישון"
  },
  {
   "start": 415.3,
   "end": 416.64,
   "text": "והיא יושבת ומתענגת,"
  },
  {
   "start": 420.89,
   "end": 421.65,
   "text": "יום רודף יום,"
  },
  {
   "start": 422.75,
   "end": 423.47,
   "text": "חודש אחר כך,"
  },
  {
   "start": 426.05,
   "end": 427.05,
   "text": "ביקור משפחתי."
  },
  {
   "start": 428.55,
   "end": 431.95,
   "text": "משפחתה של הכלה, אשת הגאון מווילנה מגיעה,"
  },
  {
   "start": 434.18,
   "end": 435.58,
   "text": "ואחרי כמה מילות נימוסים,"
  },
  {
   "start": 439.62,
   "end": 440.66,
   "text": "הן אומרות לה, תראי,"
  },
  {
   "start": 441.86,
   "end": 442.42,
   "text": "אחותנו,"
  },
  {
   "start": 442.96,
   "end": 446.1,
   "text": "שמענו על העוני המחריד בו אתם חיים, יש גבול."
  },
  {
   "start": 447.56,
   "end": 448.02,
   "text": "יש גבול."
  },
  {
   "start": 448.74,
   "end": 449.18,
   "text": "לבסוף,"
  },
  {
   "start": 450.2,
   "end": 452.44,
   "text": "הן היו בטוחות הרי אלא אי אפשר, לא יכול להיות,"
  },
  {
   "start": 453.28,
   "end": 454.68,
   "text": "שהתעסקים לחיות במצב הזה."
  },
  {
   "start": 456.06,
   "end": 457.66,
   "text": "עם אחד שכל היום יושב לומד תורה,"
  },
  {
   "start": 460.14,
   "end": 462.0,
   "text": "וכשכולם יוצאים לעבוד הוא ממשיך."
  },
  {
   "start": 463.48,
   "end": 465.74,
   "text": "לבסוף הם פונות אליה ואומרות לה תקשיבו,"
  },
  {
   "start": 466.72,
   "end": 466.98,
   "text": "תקשיבי."
  },
  {
   "start": 468.86,
   "end": 469.6,
   "text": "אנחנו נתמוך בך,"
  },
  {
   "start": 470.26,
   "end": 471.26,
   "text": "אנחנו המשפחה שלך."
  },
  {
   "start": 472.04,
   "end": 473.22,
   "text": "בואי תתגרשי ממנו."
  },
  {
   "start": 474.3,
   "end": 477.16,
   "text": "בואי תתגרשי מנו ועוד תזכי להקים בית חדש, בית נורמלי."
  },
  {
   "start": 478.18,
   "end": 479.2,
   "text": "ככה אי אפשר לחיות."
  },
  {
   "start": 479.7,
   "end": 481.44,
   "text": "בואי תתני סיכוי לילדים שלך."
  },
  {
   "start": 482.4,
   "end": 485.26,
   "text": "הם באו לאשתו של הגאון מווילנה,"
  },
  {
   "start": 485.96,
   "end": 487.28,
   "text": "בואי תתגרשי ממנו."
  },
  {
   "start": 503.87,
   "end": 504.61,
   "text": "קמה אישה,"
  },
  {
   "start": 508.88,
   "end": 509.56,
   "text": "קמה אישה,"
  },
  {
   "start": 511.6,
   "end": 515.98,
   "text": "פורסת בפניהם שני גופיות של בעלה."
  },
  {
   "start": 517.26,
   "end": 518.54,
   "text": "תגידו לי, היא אמרה להם."
  },
  {
   "start": 519.34,
   "end": 521.44,
   "text": "היא הוציאה שתי גופיות, אמרה להם, תסתכלו על שתי גופיות."
  },
  {
   "start": 522.16,
   "end": 522.98,
   "text": "אחת אני כיבסתי"
  },
  {
   "start": 525.1,
   "end": 525.5,
   "text": "היום,"
  },
  {
   "start": 526.2,
   "end": 530.56,
   "text": "ואחת לפני כביסה, ואני לא מכבסת כל יום וגם לא כל יומיים."
  },
  {
   "start": 531.22,
   "end": 533.04,
   "text": "תקופה ארוכה אני לא מכבסת בגלל המצב."
  },
  {
   "start": 533.96,
   "end": 536.72,
   "text": "זאת כיבסתי היום, מכובסת, מסודרת,"
  },
  {
   "start": 538.08,
   "end": 540.02,
   "text": "וזאת כמה שבועות כבר"
  },
  {
   "start": 541.24,
   "end": 541.98,
   "text": "בעלי לובש אותם."
  },
  {
   "start": 542.94,
   "end": 543.42,
   "text": "תגידו לי,"
  },
  {
   "start": 544.94,
   "end": 545.68,
   "text": "אם אתם מזהות?"
  },
  {
   "start": 547.72,
   "end": 549.06,
   "text": "מי זו זאת ומי זו זאת?"
  },
  {
   "start": 551.36,
   "end": 553.46,
   "text": "והן מביטות ובודקות,"
  },
  {
   "start": 556.14,
   "end": 556.92,
   "text": "וקשה להם להבחין."
  },
  {
   "start": 558.22,
   "end": 560.46,
   "text": "לבסוף הם לקחו אחת ואמרו זאת הגופייה."
  },
  {
   "start": 561.08,
   "end": 564.8,
   "text": "קמה אשתו של הגאון מוילנה ואמרה להם, טעות!"
  },
  {
   "start": 566.0,
   "end": 567.7,
   "text": "את זו שחשבתם מכובסת,"
  },
  {
   "start": 568.2,
   "end": 569.8,
   "text": "את זו שחשבתם נקייה,"
  },
  {
   "start": 570.28,
   "end": 572.36,
   "text": "הוא לובש רצוף כמר חודש שלם,"
  },
  {
   "start": 572.94,
   "end": 574.16,
   "text": "ועכשיו היא לפני כביסה."
  },
  {
   "start": 574.92,
   "end": 577.26,
   "text": "ותגידו לי אתם, עם כל מה שיש לכם,"
  },
  {
   "start": 577.94,
   "end": 581.26,
   "text": "תגידו לי, מגוף קדוש שכזה אתם רוצים שאני אתגרש?"
  },
  {
   "start": 582.44,
   "end": 585.52,
   "text": "מגוף קדוש כזה אתם רוצים שאני אתגרש?"
  },
  {
   "start": 588.71,
   "end": 589.55,
   "text": "נשתררה דממה בבית,"
  },
  {
   "start": 591.21,
   "end": 592.29,
   "text": "ויותר לא נאמר דבר."
  },
  {
   "start": 600.73,
   "end": 602.09,
   "text": "עברו להם מספר חודשים."
  },
  {
   "start": 602.97,
   "end": 605.31,
   "text": "בבית הגבאי זאב נשמעו הנחות."
  },
  {
   "start": 606.95,
   "end": 608.53,
   "text": "הגבאי על ערש דבאי."
  },
  {
   "start": 609.93,
   "end": 611.81,
   "text": "ואז הוא מבקש את רב העיר וילנה,"
  },
  {
   "start": 612.39,
   "end": 613.81,
   "text": "את רבי שמואל מווילנה,"
  },
  {
   "start": 614.61,
   "end": 616.61,
   "text": "ואת הגאון ועוד מספר אנשים."
  },
  {
   "start": 618.19,
   "end": 619.47,
   "text": "וכך על ערש דבאי,"
  },
  {
   "start": 619.99,
   "end": 621.09,
   "text": "כשהוא על סף מותו,"
  },
  {
   "start": 622.37,
   "end": 624.25,
   "text": "מתוודה הגבאי."
  },
  {
   "start": 625.51,
   "end": 626.25,
   "text": "אני לקחתי."
  },
  {
   "start": 627.03,
   "end": 628.13,
   "text": "אני לקחתי את כל ה..."
  },
  {
   "start": 628.91,
   "end": 633.59,
   "text": "את כל התקציב החודשי של הרב קרמר אליי."
  },
  {
   "start": 634.77,
   "end": 635.85,
   "text": "המצב שלי היה כשל,"
  },
  {
   "start": 636.87,
   "end": 638.11,
   "text": "אז חטאתי, לקחתי."
  },
  {
   "start": 639.79,
   "end": 641.15,
   "text": "וכולם מזועזעים,"
  },
  {
   "start": 641.73,
   "end": 643.43,
   "text": "כולם מבינים מה קרה."
  },
  {
   "start": 646.68,
   "end": 647.08,
   "text": "הרב,"
  },
  {
   "start": 647.9,
   "end": 650.12,
   "text": "הגאון מווילנה, אתה ידעת את זה ושתקת."
  },
  {
   "start": 651.5,
   "end": 653.06,
   "text": "ואני שמחתי על זה שתשתוק."
  },
  {
   "start": 654.28,
   "end": 657.08,
   "text": "ואני עכשיו פונה לך, אני מבקש ממך מחילה."
  },
  {
   "start": 661.53,
   "end": 663.73,
   "text": "והגאון מווילנה לפני כולם."
  },
  {
   "start": 666.5,
   "end": 668.14,
   "text": "קם ומוחה לו."
  },
  {
   "start": 668.74,
   "end": 669.86,
   "text": "קם ומוחה לו."
  },
  {
   "start": 679.53,
   "end": 680.99,
   "text": "והעיר וילנה רעשה."
  },
  {
   "start": 681.85,
   "end": 683.63,
   "text": "והעיר וילנה הזדעזעה לה."
  },
  {
   "start": 684.55,
   "end": 685.69,
   "text": "כולם היו נפעמים."
  },
  {
   "start": 687.07,
   "end": 688.49,
   "text": "כולם דיברו על גודלם"
  },
  {
   "start": 689.17,
   "end": 689.85,
   "text": "של הזוג"
  },
  {
   "start": 691.23,
   "end": 691.87,
   "text": "הקדוש הזה."
  },
  {
   "start": 696.89,
   "end": 698.11,
   "text": "שעת ערב בווילנה."
  },
  {
   "start": 700.72,
   "end": 704.26,
   "text": "המצב בבית הגרא, הגאון מווילנה השתפר. הם קיבלו תקציב,"
  },
  {
   "start": 704.98,
   "end": 710.86,
   "text": "ולא רק זה, גם העיר וילנה ידעה לדאוג מעתה ששום דבר לא יחסר."
  },
  {
   "start": 710.88,
   "end": 712.2,
   "text": "בבית הגאון ורעייתו."
  },
  {
   "start": 713.46,
   "end": 714.52,
   "text": "שעת ערב בווילנה,"
  },
  {
   "start": 715.48,
   "end": 717.0,
   "text": "הגאון שקוד על תלמודו,"
  },
  {
   "start": 718.98,
   "end": 720.08,
   "text": "ושם מבעד לדלת,"
  },
  {
   "start": 721.92,
   "end": 724.1,
   "text": "זוג עיניים נוצצות מביטות בו."
  },
  {
   "start": 726.28,
   "end": 729.5,
   "text": "אשת הגאון מביטה בו, בתורה שלומד."
  },
  {
   "start": 730.94,
   "end": 732.68,
   "text": "התורה הזאת היא שלג."
  },
  {
   "start": 733.44,
   "end": 735.58,
   "text": "את זה אי אפשר לקחת ממנה."
  },
  {
   "start": 736.82,
   "end": 737.86,
   "text": "וזה שווה הכול."
  },
  {
   "start": 739.32,
   "end": 740.64,
   "text": "וזה שווה אפילו יותר מהכל."
  },
  {
   "start": 740.88,
   "end": 744.88,
   "text": "אז המשפחה שלי באו ואמרו,"
  },
  {
   "start": 745.68,
   "end": 747.38,
   "text": "אז השכנות באו ודיברו,"
  },
  {
   "start": 748.2,
   "end": 751.54,
   "text": "אז כולם חשבו שאלו לא חיים."
  },
  {
   "start": 752.46,
   "end": 754.18,
   "text": "אבל אני יודעת את האמת,"
  },
  {
   "start": 755.1,
   "end": 757.92,
   "text": "ועל האמת הזאת כדאי ללכת עד הסוף,"
  },
  {
   "start": 762.98,
   "end": 764.9,
   "text": "על האמת הזאת כדאי ללכת עד הסוף."
  },
  {
   "start": 767.66,
   "end": 768.32,
   "text": "והם הלכו."
  },
  {
   "start": 769.48,
   "end": 770.2,
   "text": "מי היו השכנות?"
  },
  {
   "start": 771.04,
   "end": 771.44,
   "text": "אנחנו לא יודעים."
  },
  {
   "start": 776.76,
   "end": 778.76,
   "text": "מי היו המשפחה שלך? אנחנו לא יודעים."
  },
  {
   "start": 779.66,
   "end": 781.48,
   "text": "אבל מי הגאון מווילנה?"
  },
  {
   "start": 782.32,
   "end": 788.1,
   "text": "מה התורה שלו עשתה לכל עם ישראל? את זה כולם יודעים כאן בעולם הזה."
  },
  {
   "start": 789.36,
   "end": 791.16,
   "text": "ואתם יודעים מה יש להם בעולם הבא?"
  },
  {
   "start": 792.3,
   "end": 797.02,
   "text": "את זה עשרים אלף שעות שידור לא יספיקו לתאר."
  },
  {
   "start": 802.06,
   "end": 803.7,
   "text": "כך נבנה הבית של הגאון מווילנה."
  },
  {
   "start": 807.64,
   "end": 810.24,
   "text": "אבן מעשו הבונים הייתה לראש פינה."
  },
  {
   "start": 810.78,
   "end": 814.64,
   "text": "את הדרך הקשה הזו עזבו רבים וטובים."
  },
  {
   "start": 814.8,
   "end": 815.92,
   "text": "היו הרבה גאונים."
  },
  {
   "start": 817.6,
   "end": 819.32,
   "text": "אבל לא כל אחד רצה לסבול."
  },
  {
   "start": 819.98,
   "end": 821.94,
   "text": "לא כל אחד רצה את הקשיים האלה."
  },
  {
   "start": 822.48,
   "end": 823.9,
   "text": "והם עזבו ונטשו,"
  },
  {
   "start": 824.44,
   "end": 825.74,
   "text": "ואף אחד לא יודע עליהם."
  },
  {
   "start": 826.74,
   "end": 829.12,
   "text": "הגאון מווילנה בחר בדרך הזו."
  },
  {
   "start": 829.46,
   "end": 830.82,
   "text": "הגאון מווילנה התניד."
  },
  {
   "start": 831.42,
   "end": 832.16,
   "text": "לא נשבר."
  },
  {
   "start": 832.7,
   "end": 833.4,
   "text": "וזכה."
  },
  {
   "start": 835.28,
   "end": 837.1,
   "text": "אשתו לא נשברה."
  },
  {
   "start": 838.02,
   "end": 838.86,
   "text": "וזכתה."
  },
  {
   "start": 839.9,
   "end": 840.48,
   "text": "ככה גם אנחנו."
  },
  {
   "start": 841.84,
   "end": 842.44,
   "text": "לא נשבר."
  },
  {
   "start": 843.14,
   "end": 844.92,
   "text": "לא נשבר,"
  },
  {
   "start": 846.32,
   "end": 847.6,
   "text": "ונזכה בעזרת השם."
  },
  {
   "start": 848.3,
   "end": 852.42,
   "text": "כי אבן מעשו הבונים הייתה לראש פינה."
  },
  {
   "start": 853.14,
   "end": 856.08,
   "text": "כי יש כלל בעולם, אבן מעשו הבונים,"
  },
  {
   "start": 856.6,
   "end": 858.16,
   "text": "את מה שכולם אוהבים."
  },
  {
   "start": 858.58,
   "end": 861.14,
   "text": "אבל אתה הולך, אתה הולך עם השם יתברך,"
  },
  {
   "start": 861.54,
   "end": 863.26,
   "text": "שכל העולם יהיה בצד אחד."
  },
  {
   "start": 863.8,
   "end": 865.84,
   "text": "אתה תהיה עם הקדוש ברוך הוא בצד השני."
  },
  {
   "start": 866.16,
   "end": 869.6,
   "text": "אבן מעשו הבונים הייתה לראש פינה."
  }
 ]
}