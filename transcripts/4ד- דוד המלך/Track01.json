{
 "disc": "4ד- דוד המלך",
 "track": "Track01",
 "duration": 156.168,
 "segments": [
  {
   "start": 28.14,
   "end": 29.44,
   "text": "היום נדבר קצת,"
  },
  {
   "start": 31.73,
   "end": 34.03,
   "text": "קצת הרבה על נושאים פשוטים,"
  },
  {
   "start": 35.97,
   "end": 37.33,
   "text": "אבל חשובים לכולנו."
  },
  {
   "start": 39.9,
   "end": 41.08,
   "text": "היום נדבר על אמונה,"
  },
  {
   "start": 42.22,
   "end": 43.26,
   "text": "על אמונה והתחזקות,"
  },
  {
   "start": 44.5,
   "end": 45.5,
   "text": "למרות שקשה."
  },
  {
   "start": 48.65,
   "end": 49.95,
   "text": "על אמונה והתחזקות"
  },
  {
   "start": 53.27,
   "end": 55.39,
   "text": "למרות המצב הכלכלי הנורא."
  },
  {
   "start": 57.05,
   "end": 58.35,
   "text": "על אמונה והתחזקות"
  },
  {
   "start": 59.65,
   "end": 62.77,
   "text": "למרות התחושה שאתה ואת"
  },
  {
   "start": 63.39,
   "end": 64.41,
   "text": "ואני וכולנו"
  },
  {
   "start": 66.57,
   "end": 67.65,
   "text": "בודדים במערכה,"
  },
  {
   "start": 70.5,
   "end": 72.78,
   "text": "למרות שהחיים לא בדיוק כמו שתכננו."
  },
  {
   "start": 74.48,
   "end": 75.46,
   "text": "אבל למרות הכל,"
  },
  {
   "start": 76.44,
   "end": 77.48,
   "text": "למרות כל אלו,"
  },
  {
   "start": 80.02,
   "end": 81.18,
   "text": "לא נעזוב את השם,"
  },
  {
   "start": 81.9,
   "end": 83.34,
   "text": "לא נעזוב את התורה הקדושה,"
  },
  {
   "start": 83.98,
   "end": 85.02,
   "text": "לא נעזוב את המצוות."
  },
  {
   "start": 86.24,
   "end": 86.94,
   "text": "נמשיך,"
  },
  {
   "start": 87.42,
   "end": 91.36,
   "text": "נילחם עד כלות הכוחות ויותר."
  },
  {
   "start": 92.66,
   "end": 94.58,
   "text": "כי צריך לדעת ככה בונים עולם."
  },
  {
   "start": 95.94,
   "end": 97.04,
   "text": "רק ככה בונים עולם."
  },
  {
   "start": 101.55,
   "end": 105.71,
   "text": "אבן מעשו הבונים הייתה לראש פינה."
  },
  {
   "start": 109.27,
   "end": 113.17,
   "text": "גם אותה אבן קטנה שהבונים הקבלנים,"
  },
  {
   "start": 114.03,
   "end": 116.05,
   "text": "אלה שבנו את הבניין,"
  },
  {
   "start": 116.81,
   "end": 117.91,
   "text": "לא מסתכלים עליה בכלל,"
  },
  {
   "start": 118.93,
   "end": 120.61,
   "text": "היא בסוף זאת שנהפכת לראש פינה."
  },
  {
   "start": 124.48,
   "end": 124.82,
   "text": "אותה אבן,"
  },
  {
   "start": 126.3,
   "end": 127.04,
   "text": "אותה נשמה,"
  },
  {
   "start": 127.94,
   "end": 131.68,
   "text": "אותה נשמה של בן ישראל, בת ישראל, אותה נשמה שלנו,"
  },
  {
   "start": 131.68,
   "end": 137.26,
   "text": "שלכאורה רחוקה לכאורה"
  },
  {
   "start": 139.08,
   "end": 141.46,
   "text": "אולי לא מצליחה כל כך, ככה זה נראה."
  },
  {
   "start": 142.46,
   "end": 143.7,
   "text": "הייתה לראש פינה"
  },
  {
   "start": 144.48,
   "end": 146.96,
   "text": "לעתיד לבוא, והעתיד הזה קרוב."
  },
  {
   "start": 148.06,
   "end": 149.72,
   "text": "תתגלה כראש פינה, כגולת הכותרת."
  }
 ]
}