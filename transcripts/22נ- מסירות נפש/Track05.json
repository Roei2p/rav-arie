{
 "disc": "22נ- מסירות נפש",
 "track": "Track05",
 "duration": 450.192,
 "segments": [
  {
   "start": 0.66,
   "end": 1.12,
   "text": "אתם יודעים,"
  },
  {
   "start": 1.9,
   "end": 3.44,
   "text": "הקדוש ברוך הוא ברא עולם נפלא."
  },
  {
   "start": 4.24,
   "end": 6.26,
   "text": "מהעולם שלנו ניתן ללמוד הרבה דברים."
  },
  {
   "start": 7.96,
   "end": 9.5,
   "text": "וכל בריאה באה ללמד אותנו."
  },
  {
   "start": 10.76,
   "end": 11.32,
   "text": "יש לדוגמה"
  },
  {
   "start": 12.62,
   "end": 13.32,
   "text": "בעל חיים."
  },
  {
   "start": 14.68,
   "end": 16.24,
   "text": "בעל חיים, שועל."
  },
  {
   "start": 22.12,
   "end": 23.92,
   "text": "יש כמה סוגים של שועלים."
  },
  {
   "start": 24.74,
   "end": 25.46,
   "text": "יש שועל הכחול,"
  },
  {
   "start": 26.18,
   "end": 26.86,
   "text": "שועל האדום,"
  },
  {
   "start": 28.26,
   "end": 29.56,
   "text": "שועל גרנלנד"
  },
  {
   "start": 30.32,
   "end": 31.26,
   "text": "והשועל הארכתי."
  },
  {
   "start": 33.32,
   "end": 34.22,
   "text": "ועוד כמה סוגים."
  },
  {
   "start": 35.1,
   "end": 38.14,
   "text": "בואו נדבר על השועל הארכתי."
  },
  {
   "start": 39.22,
   "end": 40.0,
   "text": "השועל הארכתי,"
  },
  {
   "start": 42.54,
   "end": 43.72,
   "text": "כשהוא בוחר לו בת זוג,"
  },
  {
   "start": 44.82,
   "end": 46.2,
   "text": "כשהוא מקים משפחה,"
  },
  {
   "start": 49.05,
   "end": 50.05,
   "text": "אז אותה משפחה,"
  },
  {
   "start": 50.51,
   "end": 53.53,
   "text": "הוא והבת זוג שלו נאמנים לכל ימי חייהם."
  },
  {
   "start": 56.12,
   "end": 57.48,
   "text": "וכשמתחיל הקיץ,"
  },
  {
   "start": 58.42,
   "end": 61.89,
   "text": "כשהפריחה באוויר,"
  },
  {
   "start": 62.47,
   "end": 64.35,
   "text": "נולדים להם שועלים קטנים."
  },
  {
   "start": 64.87,
   "end": 65.69,
   "text": "אתם יודעים כמה?"
  },
  {
   "start": 66.27,
   "end": 67.85,
   "text": "בדרך כלל שישייה."
  },
  {
   "start": 69.11,
   "end": 70.17,
   "text": "בדרך כלל שישה."
  },
  {
   "start": 73.29,
   "end": 73.81,
   "text": "השועל,"
  },
  {
   "start": 74.43,
   "end": 79.15,
   "text": "צריך לדעת שהשואל הינו אחד מהחיות הנרדפות ביותר בעולם."
  },
  {
   "start": 83.03,
   "end": 86.43,
   "text": "אחד מהחיות הנרדפות ביותר בעולם. מי לא רוצה אותו?"
  },
  {
   "start": 87.17,
   "end": 88.21,
   "text": "מי לא רוצה להרוג אותו?"
  },
  {
   "start": 94.63,
   "end": 95.61,
   "text": "השואל הארכתי,"
  },
  {
   "start": 96.15,
   "end": 97.95,
   "text": "הוא לא מחפש כל מיני עניינים."
  },
  {
   "start": 98.71,
   "end": 99.31,
   "text": "הוא הולך,"
  },
  {
   "start": 100.31,
   "end": 101.31,
   "text": "הוא הולך ועסוק"
  },
  {
   "start": 102.03,
   "end": 102.93,
   "text": "זמן רב"
  },
  {
   "start": 103.69,
   "end": 107.51,
   "text": "מהחיים שלו לחפש אוכל לגורים,"
  },
  {
   "start": 108.23,
   "end": 109.63,
   "text": "לחפש אוכל לגורים שלו."
  },
  {
   "start": 112.93,
   "end": 117.17,
   "text": "אז אתם יודעים מה עושה השועל הארכתי? תראו מה זה, רק לשמוע את זה ולהתרגש מזה."
  },
  {
   "start": 117.85,
   "end": 121.11,
   "text": "כמה הקדוש ברוך הוא רוצה שנסתכל על הבריאה ונלמד ממנה."
  },
  {
   "start": 123.07,
   "end": 128.17,
   "text": "השועל הארכתי לא ישן במאורה הקטנה שלו, הוא בונה מאורה, הוא לא ישן שמה, לא."
  },
  {
   "start": 128.49,
   "end": 129.53,
   "text": "הוא ישן לידה."
  },
  {
   "start": 130.43,
   "end": 131.21,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 131.65,
   "end": 131.91,
   "text": "למה?"
  },
  {
   "start": 132.75,
   "end": 133.31,
   "text": "כי אם,"
  },
  {
   "start": 133.95,
   "end": 136.41,
   "text": "אם חס וחלילה תגיע סכנה כלשהי,"
  },
  {
   "start": 137.29,
   "end": 143.75,
   "text": "אם יבוא איזה גורם מאיים מכל המאות האלה שרוצים לפגוע בו, מכל הציידים,"
  },
  {
   "start": 144.11,
   "end": 145.75,
   "text": "מכל האויבים והטורפים שלו,"
  },
  {
   "start": 146.63,
   "end": 148.11,
   "text": "אם מגיעה סכנה כלשהי,"
  },
  {
   "start": 148.99,
   "end": 150.41,
   "text": "אז כדי שהילדים שלו,"
  },
  {
   "start": 150.75,
   "end": 153.11,
   "text": "כדי שהגורים הקטנים שלו, חסרי האונים,"
  },
  {
   "start": 153.45,
   "end": 154.31,
   "text": "לא ייפגעו,"
  },
  {
   "start": 154.85,
   "end": 155.39,
   "text": "אז מה הוא עושה?"
  },
  {
   "start": 155.73,
   "end": 158.29,
   "text": "הוא עושה רעש ומושך צוט את תשומת לב."
  },
  {
   "start": 159.91,
   "end": 160.73,
   "text": "ואז הוא מתחיל לברוח,"
  },
  {
   "start": 161.63,
   "end": 164.71,
   "text": "וכל האויבים כולם רודפים אחריו,"
  },
  {
   "start": 165.27,
   "end": 166.65,
   "text": "ולא שמים לב למאורה,"
  },
  {
   "start": 167.47,
   "end": 168.81,
   "text": "לא שמים לב לגורים שלו."
  },
  {
   "start": 169.45,
   "end": 170.83,
   "text": "הוא נאבך המטרה,"
  },
  {
   "start": 171.25,
   "end": 173.47,
   "text": "הוא מוסר את עצמו, אולי הוא ימות,"
  },
  {
   "start": 173.79,
   "end": 174.43,
   "text": "אולי הוא ייפצע,"
  },
  {
   "start": 174.87,
   "end": 175.61,
   "text": "אולי הוא לא יחזור,"
  },
  {
   "start": 176.39,
   "end": 180.05,
   "text": "אבל הוא ימסור את עצמו כדי שהילדים שלו, הגורים,"
  },
  {
   "start": 181.53,
   "end": 182.65,
   "text": "יצליחו לחיות."
  },
  {
   "start": 186.69,
   "end": 189.27,
   "text": "תראו איזה נסירות נפש של בעל חיים,"
  },
  {
   "start": 190.29,
   "end": 192.29,
   "text": "בלי חוכמה, בלי בינה, בלי דעת,"
  },
  {
   "start": 193.09,
   "end": 193.63,
   "text": "בלי נשמה,"
  },
  {
   "start": 194.39,
   "end": 195.29,
   "text": "בלי ללמוד בבית ספר,"
  },
  {
   "start": 201.18,
   "end": 205.28,
   "text": "בא הקדוש ברוך הוא ובורא את השועל ללמד אותנו,"
  },
  {
   "start": 205.96,
   "end": 208.3,
   "text": "להגיד לנו תראה יהודי, תראי יהודייה,"
  },
  {
   "start": 208.84,
   "end": 209.96,
   "text": "תראו את השועל,"
  },
  {
   "start": 210.92,
   "end": 211.9,
   "text": "תראו את השועל."
  },
  {
   "start": 212.78,
   "end": 213.52,
   "text": "הוא מבין,"
  },
  {
   "start": 214.08,
   "end": 215.5,
   "text": "הוא מבין אמנם אני חשוב,"
  },
  {
   "start": 216.44,
   "end": 217.52,
   "text": "אבל אני חייב,"
  },
  {
   "start": 218.16,
   "end": 222.78,
   "text": "אני חייב לקחת את כל-כולי ולמסור את כל-כולי,"
  },
  {
   "start": 223.38,
   "end": 227.72,
   "text": "ולהשתדל כמה שאפשר כדי לתת חיות לדור ההמשך,"
  },
  {
   "start": 228.56,
   "end": 230.18,
   "text": "ושיהיו עוד שועלים בעולם."
  },
  {
   "start": 232.88,
   "end": 235.24,
   "text": "כדי שיהיה לגורים שלי, לילדים שלי,"
  },
  {
   "start": 236.04,
   "end": 236.92,
   "text": "איך לחיות."
  },
  {
   "start": 239.04,
   "end": 240.28,
   "text": "קל וחומר,"
  },
  {
   "start": 241.66,
   "end": 246.58,
   "text": "היהודי ויהודייה, שכל החיות והמשך העם היהודי"
  },
  {
   "start": 247.48,
   "end": 250.72,
   "text": "תלוי בנו, תלוי ביהדות שלנו."
  },
  {
   "start": 251.46,
   "end": 254.16,
   "text": "תלוי ביהדות שלנו, כן."
  },
  {
   "start": 257.22,
   "end": 258.92,
   "text": "אתם יודעים, היה שואה בגרמניה."
  },
  {
   "start": 259.58,
   "end": 266.34,
   "text": "מ-1939 עד 1945 רצחו הנאצים שישה מיליון יהודים."
  },
  {
   "start": 268.95,
   "end": 274.29,
   "text": "ואנחנו רגילים לדבר שזה הטבח הגדול ביותר שנעשה בעם ישראל ובכלל בעם בעולם."
  },
  {
   "start": 275.19,
   "end": 277.73,
   "text": "הושמדו שישה מיליון יהודים."
  },
  {
   "start": 278.43,
   "end": 282.35,
   "text": "אתם יודעים שמאז 1945 ועד היום"
  },
  {
   "start": 283.67,
   "end": 287.21,
   "text": "הושמדו הרבה יותר משישה מיליון יהודים?"
  },
  {
   "start": 287.21,
   "end": 292.57,
   "text": "יש יותר משישה מיליון יהודים מתבוללים,"
  },
  {
   "start": 294.03,
   "end": 297.17,
   "text": "נעלמו מעם ישראל, נכחדו."
  },
  {
   "start": 297.95,
   "end": 301.11,
   "text": "את אלה שנרצחו בשואה, הנשמה שלהם בגן עדן."
  },
  {
   "start": 301.75,
   "end": 303.99,
   "text": "אלה גם הנשמה שלהם לא בגן עדן."
  },
  {
   "start": 306.63,
   "end": 308.47,
   "text": "כמה נשאר מעם ישראל היום?"
  },
  {
   "start": 310.45,
   "end": 314.43,
   "text": "מה ייתן את הכוח לילדים הקטנים בגנים,"
  },
  {
   "start": 315.31,
   "end": 316.11,
   "text": "במעונות,"
  },
  {
   "start": 316.97,
   "end": 318.25,
   "text": "להישאר יהודים?"
  },
  {
   "start": 320.01,
   "end": 324.51,
   "text": "להמשיך לחיות על אדמת המדינה הזאת מול מיליוני ערבים."
  },
  {
   "start": 325.53,
   "end": 327.47,
   "text": "העיניים שלהם נשואות אלינו,"
  },
  {
   "start": 328.21,
   "end": 328.71,
   "text": "אליך,"
  },
  {
   "start": 329.33,
   "end": 331.81,
   "text": "אלייך, אליי, אלינו."
  },
  {
   "start": 332.89,
   "end": 336.21,
   "text": "מתחננות, תנו לנו זהות יהודית,"
  },
  {
   "start": 336.81,
   "end": 338.47,
   "text": "תנו לנו בשביל מה לחיות."
  },
  {
   "start": 340.92,
   "end": 343.02,
   "text": "תלמדו אותנו מה חשוב בחיים."
  },
  {
   "start": 344.94,
   "end": 346.32,
   "text": "ואת זה אסור לנו לשכוח,"
  },
  {
   "start": 347.24,
   "end": 348.8,
   "text": "ועל זה אסור לנו לוותר."
  },
  {
   "start": 349.36,
   "end": 355.04,
   "text": "ורק בגלל זה, לא משנה אם יש לנו ילדים, אין לנו ילדים, זה לא משנה, לא משנה."
  },
  {
   "start": 356.12,
   "end": 357.16,
   "text": "אנחנו כל כך חשובים,"
  },
  {
   "start": 358.02,
   "end": 360.9,
   "text": "אנחנו חייבים להטביע את החותם שלנו בהיסטוריה."
  },
  {
   "start": 361.38,
   "end": 363.34,
   "text": "עוד ילמדו היסטוריה על התקופה הזאת,"
  },
  {
   "start": 363.78,
   "end": 365.58,
   "text": "ויגידו, בתקופה הזאת היה,"
  },
  {
   "start": 366.34,
   "end": 368.44,
   "text": "היה בעם ישראל קשיים ביטחוניים,"
  },
  {
   "start": 369.02,
   "end": 371.62,
   "text": "בעם ישראל קמו ונלחמו נגד התורה."
  },
  {
   "start": 372.9,
   "end": 374.14,
   "text": "מה אנחנו עשינו?"
  },
  {
   "start": 375.58,
   "end": 376.82,
   "text": "מה אנחנו עשינו?"
  },
  {
   "start": 377.32,
   "end": 378.08,
   "text": "נשברנו?"
  },
  {
   "start": 378.5,
   "end": 383.44,
   "text": "הרמנו ידיים, או להפך, לא ויתרנו, חיזקנו עוד תורה,"
  },
  {
   "start": 383.84,
   "end": 384.76,
   "text": "עוד מצוות,"
  },
  {
   "start": 385.34,
   "end": 385.98,
   "text": "עוד דבר,"
  },
  {
   "start": 386.48,
   "end": 386.74,
   "text": "עוד דברים."
  },
  {
   "start": 387.54,
   "end": 388.28,
   "text": "לא לוותר,"
  },
  {
   "start": 389.0,
   "end": 393.04,
   "text": "לא לוותר, לקום ולזעוק, לקום ולעשות,"
  },
  {
   "start": 393.56,
   "end": 394.5,
   "text": "לקום ולעשות."
  },
  {
   "start": 395.56,
   "end": 396.64,
   "text": "יכבוד השם יתברך,"
  },
  {
   "start": 397.28,
   "end": 401.88,
   "text": "וצריך לדעת שמסירות נפש זה לא רק למות על קידוש השם,"
  },
  {
   "start": 402.5,
   "end": 405.0,
   "text": "מסירות נפש זה לחיות על קידוש השם."
  },
  {
   "start": 407.2,
   "end": 408.66,
   "text": "כל לב ולב יהודי,"
  },
  {
   "start": 409.64,
   "end": 413.28,
   "text": "אם יהיה בו מסירות נפש, הוא יהפך לבית מקדש קטן."
  },
  {
   "start": 413.74,
   "end": 416.48,
   "text": "אתה לא תראה יהודי ברחוב, זה בית מקדש ברחוב."
  },
  {
   "start": 417.2,
   "end": 420.74,
   "text": "לא יהודי, לא יהודי. הקודש-קודשים הולכים ברחוב, כן."
  },
  {
   "start": 421.2,
   "end": 423.92,
   "text": "בתי מקדש, עשרות אלפי, מאות אלפי,"
  },
  {
   "start": 424.24,
   "end": 426.06,
   "text": "מיליוני בתי מקדש."
  },
  {
   "start": 426.8,
   "end": 430.46,
   "text": "ואם דבר כזה, בורא עולם לא יבוא ויבנה את בית המקדש, ודאי שיבנה."
  },
  {
   "start": 431.38,
   "end": 435.92,
   "text": "ותדעו לכם, המסירות נפש הזאת תשפיע על הסביבה ועל הילדים."
  },
  {
   "start": 436.46,
   "end": 439.14,
   "text": "והילדים הקטנים ימסרו נפש לכבוד השם יתברך."
  },
  {
   "start": 439.52,
   "end": 441.8,
   "text": "בואו אנחנו נהיה הבית מקדש."
  },
  {
   "start": 442.76,
   "end": 444.86,
   "text": "אנחנו נבנה, אנחנו נהיה הקבלנים."
  }
 ]
}