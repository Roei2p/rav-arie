{
 "disc": "22נ- מסירות נפש",
 "track": "Track02",
 "duration": 1373.184,
 "segments": [
  {
   "start": 24.2,
   "end": 24.88,
   "text": "הרב המלמד"
  },
  {
   "start": 26.14,
   "end": 27.06,
   "text": "היה חסר אונים."
  },
  {
   "start": 29.38,
   "end": 31.56,
   "text": "בכיתה של ילדים רכים ועדינים,"
  },
  {
   "start": 32.4,
   "end": 33.2,
   "text": "הם בלטו שם,"
  },
  {
   "start": 34.46,
   "end": 36.14,
   "text": "שניהם כמו איזה שני פרוז'קטורים,"
  },
  {
   "start": 37.4,
   "end": 38.08,
   "text": "שני יתומים,"
  },
  {
   "start": 39.28,
   "end": 41.76,
   "text": "חסרי מסגרת אמיתית, מסגרת של ממש,"
  },
  {
   "start": 42.3,
   "end": 43.96,
   "text": "מסתובבים מרבית היום ברחובות."
  },
  {
   "start": 44.94,
   "end": 45.86,
   "text": "וכשבאים ללימודים,"
  },
  {
   "start": 46.24,
   "end": 49.6,
   "text": "אז כל אווירת הלימוד הייתה נהרסת, וכל הכיתה הייתה נהרסת."
  },
  {
   "start": 51.48,
   "end": 54.58,
   "text": "מעשי שובבות, אלימות וחוסר משמעת היה להם לחם חוק."
  },
  {
   "start": 55.62,
   "end": 57.08,
   "text": "ופשוט אי אפשר היה להשתלט עליהם."
  },
  {
   "start": 58.76,
   "end": 59.48,
   "text": "והרב המלמד,"
  },
  {
   "start": 59.78,
   "end": 63.06,
   "text": "רבי אריה ליב גרונדי, זכר צדיק וקדוש לברכה,"
  },
  {
   "start": 63.56,
   "end": 64.28,
   "text": "בכה עליהם,"
  },
  {
   "start": 65.2,
   "end": 66.28,
   "text": "התפלל עבורם."
  },
  {
   "start": 71.43,
   "end": 73.13,
   "text": "לפרנסי הקהילה לא נותרה ברירה."
  },
  {
   "start": 74.31,
   "end": 76.23,
   "text": "הייתה זו אספה כואבת, אספה קשה."
  },
  {
   "start": 77.49,
   "end": 78.57,
   "text": "אב בסוף הם החליטו,"
  },
  {
   "start": 79.09,
   "end": 80.33,
   "text": "לטובת כל הילדים,"
  },
  {
   "start": 80.83,
   "end": 83.71,
   "text": "על דעת הרוב להוציא את היתומים מהתלמוד תורה."
  },
  {
   "start": 84.43,
   "end": 85.31,
   "text": "אין ברירה אחרת."
  },
  {
   "start": 88.38,
   "end": 89.86,
   "text": "וככה נותרו אותם ילדים,"
  },
  {
   "start": 90.74,
   "end": 91.72,
   "text": "אותם ילדים יתומים"
  },
  {
   "start": 92.6,
   "end": 93.9,
   "text": "עם מקום מפלט אחד,"
  },
  {
   "start": 95.54,
   "end": 95.98,
   "text": "הרחוב."
  },
  {
   "start": 97.82,
   "end": 100.02,
   "text": "והמלמד שלהם, רבי אריה לייבגרונדי,"
  },
  {
   "start": 100.58,
   "end": 101.84,
   "text": "יושב, בוכה,"
  },
  {
   "start": 102.76,
   "end": 105.66,
   "text": "מתפלל עליהם ובוכה לילה-לילה."
  },
  {
   "start": 107.81,
   "end": 108.89,
   "text": "והיתומים ברחוב,"
  },
  {
   "start": 109.91,
   "end": 111.71,
   "text": "והרחוב קלט אותם אל קרבו,"
  },
  {
   "start": 112.79,
   "end": 114.89,
   "text": "אל כור ההיתוך של פשע,"
  },
  {
   "start": 115.71,
   "end": 116.23,
   "text": "של אלימות,"
  },
  {
   "start": 117.15,
   "end": 117.49,
   "text": "של עוני."
  },
  {
   "start": 120.4,
   "end": 121.36,
   "text": "שני הילדים גדלו"
  },
  {
   "start": 121.36,
   "end": 123.74,
   "text": "והפכו לבחורים."
  },
  {
   "start": 125.0,
   "end": 129.08,
   "text": "הם הצטרפו לכנופיות הפשע ששכנו ביערות שמסביב לעיר,"
  },
  {
   "start": 130.06,
   "end": 131.56,
   "text": "ועם הזמן קנו להם מעמד"
  },
  {
   "start": 132.32,
   "end": 133.02,
   "text": "בין הכנופיות."
  },
  {
   "start": 134.6,
   "end": 135.68,
   "text": "לא ארכו הימים,"
  },
  {
   "start": 136.34,
   "end": 137.58,
   "text": "לא ארכו החודשים,"
  },
  {
   "start": 138.6,
   "end": 139.62,
   "text": "לא ארכו השנים,"
  },
  {
   "start": 139.98,
   "end": 143.0,
   "text": "והם נהיו למנהיגי כנופיות הפשע של הסביבה,"
  },
  {
   "start": 143.54,
   "end": 145.52,
   "text": "זורעים אימה ופחד סביבה."
  },
  {
   "start": 148.19,
   "end": 149.27,
   "text": "אי אפשר היה לעצור אותם."
  },
  {
   "start": 160.58,
   "end": 161.06,
   "text": "ביער,"
  },
  {
   "start": 162.02,
   "end": 165.24,
   "text": "יום אחד עוברת לה מרכבת הדואר המלכותית של פולין,"
  },
  {
   "start": 165.98,
   "end": 167.02,
   "text": "מתנהלת לה בעצלתיים."
  },
  {
   "start": 168.2,
   "end": 170.8,
   "text": "נושאתי בתוכה את כספי המיסים של אזרחי המדינה,"
  },
  {
   "start": 171.92,
   "end": 173.28,
   "text": "ואותה מרכבה חצתה את היער."
  },
  {
   "start": 175.61,
   "end": 178.31,
   "text": "למרות שהיער היה ידוע שיש בו כנופיות פשע,"
  },
  {
   "start": 178.93,
   "end": 180.65,
   "text": "המרכבה לא הייתה מלווה באבטחה כבדה."
  },
  {
   "start": 181.49,
   "end": 181.95,
   "text": "לא היה צורך."
  },
  {
   "start": 182.67,
   "end": 186.57,
   "text": "אף אדם לא יעיז את פניו כנגד בית המלוכה הפולנית."
  },
  {
   "start": 189.26,
   "end": 191.36,
   "text": "אבל הבלתי צפוי, הבלתי יאומן קרה."
  },
  {
   "start": 191.88,
   "end": 194.62,
   "text": "לפתע ביער, התקפה פתאומית,"
  },
  {
   "start": 195.38,
   "end": 197.2,
   "text": "התקפה פתאומית שארכה אולי דקות מספר,"
  },
  {
   "start": 197.58,
   "end": 200.18,
   "text": "ועוד לפני שאנשי המרכבה הבינו מה קורה זה נגמר."
  },
  {
   "start": 201.3,
   "end": 201.52,
   "text": "כך,"
  },
  {
   "start": 202.3,
   "end": 204.96,
   "text": "לפתע באישון לילה, במאהבה היער,"
  },
  {
   "start": 205.5,
   "end": 209.72,
   "text": "הותקפה לראשונה בתולדות פולין מרכבת הדואר של המלכות,"
  },
  {
   "start": 210.26,
   "end": 211.7,
   "text": "וכל הכסף שבה נשדד."
  },
  {
   "start": 212.44,
   "end": 213.52,
   "text": "הלא יאומן קרה,"
  },
  {
   "start": 214.32,
   "end": 215.3,
   "text": "הכלים נשברו,"
  },
  {
   "start": 216.32,
   "end": 217.3,
   "text": "הכללים נפרצו,"
  },
  {
   "start": 218.14,
   "end": 221.28,
   "text": "וכשפשטה הידיעה, נרעדו כולם והמתינו לבאות."
  },
  {
   "start": 222.2,
   "end": 224.58,
   "text": "הם ידעו שעניין כזה לא יכול לעבור בשתיקה."
  },
  {
   "start": 230.77,
   "end": 231.71,
   "text": "יומיים אחר כך,"
  },
  {
   "start": 232.65,
   "end": 238.45,
   "text": "מלך פולין יוצא בראש גדודי צבא ומקטר את היער"
  },
  {
   "start": 239.09,
   "end": 240.75,
   "text": "בו הסתתרו כנופיות הפשע."
  },
  {
   "start": 243.9,
   "end": 246.54,
   "text": "על פי פקודת המלך החיילים חודרים אל תוך היער,"
  },
  {
   "start": 247.02,
   "end": 249.48,
   "text": "יורים והורגים בכל מי שנקרע בדרכם."
  },
  {
   "start": 250.82,
   "end": 257.18,
   "text": "וכך בתוך קרב קצר ואכזרי בין החיילים ובין השודדים נהרגו להם מרבית השודדים."
  },
  {
   "start": 258.96,
   "end": 260.24,
   "text": "ואת שני הבחורים היהודים,"
  },
  {
   "start": 261.34,
   "end": 262.22,
   "text": "ראשי הכנופיות,"
  },
  {
   "start": 263.46,
   "end": 263.88,
   "text": "תפסו"
  },
  {
   "start": 264.56,
   "end": 282.46,
   "text": "חיים לפי פקודת המלך."
  },
  {
   "start": 284.48,
   "end": 286.16,
   "text": "במרכז העיר"
  },
  {
   "start": 287.96,
   "end": 290.02,
   "text": "בו נולדו אותם יתומים,"
  },
  {
   "start": 291.52,
   "end": 293.64,
   "text": "היום מנהיגי כנופיות הפשע,"
  },
  {
   "start": 294.54,
   "end": 295.62,
   "text": "וצבא במה גדולה,"
  },
  {
   "start": 297.16,
   "end": 298.98,
   "text": "ועליה המוקד,"
  },
  {
   "start": 302.92,
   "end": 305.88,
   "text": "הוצאה להורג בשרפה, שדהיה גזר דין של המלך,"
  },
  {
   "start": 306.54,
   "end": 307.92,
   "text": "קבל עם ועדה,"
  },
  {
   "start": 308.62,
   "end": 309.94,
   "text": "למען יראו וייראו."
  },
  {
   "start": 311.4,
   "end": 315.14,
   "text": "ולפקודת המלך נערו אנשים מכל מחוזות פולין אל העיר בה גדלו שני היתומים."
  },
  {
   "start": 315.64,
   "end": 317.04,
   "text": "כולם באים לראות את המחזה,"
  },
  {
   "start": 318.24,
   "end": 319.5,
   "text": "את טקס ההוצאה להורג."
  },
  {
   "start": 339.26,
   "end": 342.94,
   "text": "בשעה היעודה הובלו שני השודדים לכיוון הבמה."
  },
  {
   "start": 343.88,
   "end": 345.46,
   "text": "המון עצום ורב נאסף,"
  },
  {
   "start": 346.24,
   "end": 347.76,
   "text": "מביטים בצמד הבחורים."
  },
  {
   "start": 349.02,
   "end": 352.1,
   "text": "בינתיים הסתודדו להם על בימת הכבוד"
  },
  {
   "start": 354.7,
   "end": 355.58,
   "text": "המלך והבישוף."
  },
  {
   "start": 360.02,
   "end": 361.44,
   "text": "וכולם ממתינים."
  },
  {
   "start": 369.16,
   "end": 371.52,
   "text": "הבישוף סיים לדבר עם המלך,"
  },
  {
   "start": 372.7,
   "end": 374.14,
   "text": "ואז הוא בא ונעמד מול השניים,"
  },
  {
   "start": 375.9,
   "end": 376.66,
   "text": "וכך הוא אמר להם,"
  },
  {
   "start": 380.07,
   "end": 380.63,
   "text": "שודדים,"
  },
  {
   "start": 382.53,
   "end": 382.97,
   "text": "יהודים,"
  },
  {
   "start": 384.07,
   "end": 384.83,
   "text": "אם תודו,"
  },
  {
   "start": 385.81,
   "end": 386.65,
   "text": "אם תגידו את האמת,"
  },
  {
   "start": 387.53,
   "end": 390.91,
   "text": "שמי ששכנע אתכם לפגוע במרכבה של המלך,"
  },
  {
   "start": 391.61,
   "end": 392.97,
   "text": "לפגוע בכבוד המלך,"
  },
  {
   "start": 393.77,
   "end": 395.49,
   "text": "זה האחים שלכם היהודים,"
  },
  {
   "start": 396.75,
   "end": 397.67,
   "text": "תושבי העיר הזאת."
  },
  {
   "start": 398.67,
   "end": 401.25,
   "text": "המלך מסכים במחווה של חסד"
  },
  {
   "start": 401.95,
   "end": 407.01,
   "text": "להמיר לכם את עונש המוות בשרפה למוות קל ונעים יותר,"
  },
  {
   "start": 407.73,
   "end": 408.53,
   "text": "למוות בתלייה."
  },
  {
   "start": 421.76,
   "end": 424.46,
   "text": "השניים הביטו בקהל הנאספים,"
  },
  {
   "start": 425.28,
   "end": 426.02,
   "text": "הביטו ברעב,"
  },
  {
   "start": 428.41,
   "end": 429.45,
   "text": "הביטו, הביטו ביהודים,"
  },
  {
   "start": 430.43,
   "end": 433.75,
   "text": "הביטו בכל המוני האנשים שנאספו."
  },
  {
   "start": 435.49,
   "end": 437.11,
   "text": "בתוך הקהל הם הבחינו ביהודי העיר,"
  },
  {
   "start": 437.53,
   "end": 439.37,
   "text": "באלה שזרקו אותם מהתלמוד תורה."
  },
  {
   "start": 440.35,
   "end": 443.09,
   "text": "הם ראו את אלה שהרחיקו את הבנים שלהם כשהיו קטנים מהם."
  },
  {
   "start": 445.69,
   "end": 447.01,
   "text": "הם ראו את אלה שלא סייעו להם."
  },
  {
   "start": 449.07,
   "end": 449.35,
   "text": "ואז"
  },
  {
   "start": 450.31,
   "end": 452.29,
   "text": "הרימו את ראשם ואמרו,"
  },
  {
   "start": 453.51,
   "end": 456.21,
   "text": "יהודי העיר הם יהודים טובים."
  },
  {
   "start": 456.95,
   "end": 459.59,
   "text": "איש מהם לא קשור אל מעשינו ואלינו."
  },
  {
   "start": 460.37,
   "end": 461.57,
   "text": "רק אנחנו אשמים."
  },
  {
   "start": 462.43,
   "end": 463.37,
   "text": "רק אנחנו."
  },
  {
   "start": 463.75,
   "end": 465.55,
   "text": "והיהודים נקיים."
  },
  {
   "start": 469.52,
   "end": 472.26,
   "text": "קשה להחמיק את קריאת ההתפעלות."
  },
  {
   "start": 472.92,
   "end": 476.18,
   "text": "שפרצה מהקהל ערב, לנוכח אצילות הנפש שכזו."
  },
  {
   "start": 476.96,
   "end": 482.24,
   "text": "יהודים, יהודיות, גויים, גויות, לא יכלו להסתיר את ההתפעלות שלהם מגבהות,"
  },
  {
   "start": 483.1,
   "end": 485.82,
   "text": "מגדלות, מהעוצמה של הלב"
  },
  {
   "start": 489.16,
   "end": 490.12,
   "text": "של אותם שניים."
  },
  {
   "start": 518.76,
   "end": 521.32,
   "text": "הבישוף הפנה את מבטו אל המלך"
  },
  {
   "start": 522.08,
   "end": 522.94,
   "text": "כממתין לאישור,"
  },
  {
   "start": 523.64,
   "end": 524.62,
   "text": "והמלך הנהיד את ראשו."
  },
  {
   "start": 525.58,
   "end": 526.76,
   "text": "אז הבישוף הרים את קולו ואמר,"
  },
  {
   "start": 527.38,
   "end": 531.26,
   "text": "הודרם מותו מלך פולין מוכן בצעד חריג להציל אתכם ממוות,"
  },
  {
   "start": 532.14,
   "end": 533.02,
   "text": "לחון אתכם"
  },
  {
   "start": 533.72,
   "end": 536.78,
   "text": "ולשנות את גזר הדין לעונש קל."
  },
  {
   "start": 538.6,
   "end": 540.18,
   "text": "במקום מיטה עונש קל,"
  },
  {
   "start": 540.88,
   "end": 544.38,
   "text": "אם רק תודו שהיהודים הם אלו שהסיתו אתכם,"
  },
  {
   "start": 545.56,
   "end": 551.32,
   "text": "והם למעשה שותפים לפשע המר והנמהר הזה."
  },
  {
   "start": 554.47,
   "end": 560.23,
   "text": "תוכניתם של הבישוף והמלך להפוך את האירוע הזה למוקד של פרעות ביהודים קרמה לעור וגדים."
  },
  {
   "start": 562.09,
   "end": 562.93,
   "text": "היהודים נחרדו,"
  },
  {
   "start": 562.93,
   "end": 565.87,
   "text": "הם הבינו שגורלם נחרץ."
  },
  {
   "start": 566.67,
   "end": 569.15,
   "text": "מה יעצור את שני הבחורים מלהציל את חייהם?"
  },
  {
   "start": 570.25,
   "end": 572.31,
   "text": "הרי אחיהם היהודים לא התייחסו אליהם באמת."
  },
  {
   "start": 572.91,
   "end": 573.81,
   "text": "הם דחו אותם."
  },
  {
   "start": 574.15,
   "end": 575.85,
   "text": "מנקודת מבטם הם התרחקו מהם,"
  },
  {
   "start": 576.23,
   "end": 580.59,
   "text": "וכל השנים בכלל אותם שניים לא היה קשר בינם לבין יהדות, לא היה כלום."
  },
  {
   "start": 581.97,
   "end": 583.23,
   "text": "לכן התשובה הייתה ברורה."
  },
  {
   "start": 584.27,
   "end": 584.77,
   "text": "החיים שלהם מעדיפים,"
  },
  {
   "start": 586.23,
   "end": 588.67,
   "text": "והבישוף כבר החל לחכך את ידיו בהנאה."
  },
  {
   "start": 593.73,
   "end": 594.11,
   "text": "ואז,"
  },
  {
   "start": 594.81,
   "end": 595.71,
   "text": "מעל כולם."
  },
  {
   "start": 597.11,
   "end": 598.73,
   "text": "בצורה ברורה ובוטחת"
  },
  {
   "start": 599.35,
   "end": 600.41,
   "text": "נשמעה קריאה"
  },
  {
   "start": 601.09,
   "end": 601.49,
   "text": "לא!"
  },
  {
   "start": 603.41,
   "end": 607.61,
   "text": "קולם ששני הבחורים האמיצים התנשא לו בכיכר העיר לא!"
  },
  {
   "start": 608.33,
   "end": 618.63,
   "text": "היהודים אינם אשמים ולא תצליחו לגרום לנו להיות כנגד אחינו ואחיותינו בית ישראל ואפילו במחיר חיינו."
  },
  {
   "start": 621.94,
   "end": 624.22,
   "text": "מניין הם שאבו את רוח הגבורה הזו?"
  },
  {
   "start": 625.6,
   "end": 627.38,
   "text": "מהיכן היא פעמה בנשמתם?"
  },
  {
   "start": 627.38,
   "end": 633.16,
   "text": "מאיפה אותה רוח של קידוש שם שמיים, של אהבת ישראל,"
  },
  {
   "start": 635.32,
   "end": 639.04,
   "text": "של אכפתיות לבנים ובנות של מלך מלכי המלאכים הקדוש ברוך הוא?"
  },
  {
   "start": 640.14,
   "end": 641.98,
   "text": "אף אחד לא יכל להסביר, אף אחד לא ידע גם."
  },
  {
   "start": 643.24,
   "end": 644.98,
   "text": "מאות זוגות עיניים של יהודים,"
  },
  {
   "start": 645.78,
   "end": 648.9,
   "text": "של יהודיות, הביטו בהערצה בשני הבחורים,"
  },
  {
   "start": 649.56,
   "end": 652.6,
   "text": "שחרף הכול נשמתם נותרה טהורה,"
  },
  {
   "start": 654.02,
   "end": 656.92,
   "text": "וגדלות נשמתו של היהודי הבהיקה"
  },
  {
   "start": 657.38,
   "end": 664.73,
   "text": "לעיני כל ואז הבישוף פנה אליהם"
  },
  {
   "start": 665.65,
   "end": 672.92,
   "text": "באקט של ייאוש חייכם ינתנו לכם במתנה אם תקבלו עליכם"
  },
  {
   "start": 673.84,
   "end": 674.82,
   "text": "את הדת שלנו"
  },
  {
   "start": 675.44,
   "end": 676.64,
   "text": "אם בסך הכל"
  },
  {
   "start": 677.72,
   "end": 679.76,
   "text": "תמירו את הדת שלכם"
  },
  {
   "start": 681.56,
   "end": 682.2,
   "text": "והשניים"
  },
  {
   "start": 682.88,
   "end": 687.46,
   "text": "הביטו אחד אל השני ואז הביטו אל הבישוף וחייכו"
  },
  {
   "start": 688.82,
   "end": 693.26,
   "text": "והוא הרשה לעצמו לנשום בהקלה הם מסכימים"
  },
  {
   "start": 694.22,
   "end": 695.14,
   "text": "אמי חייכים."
  },
  {
   "start": 697.64,
   "end": 698.28,
   "text": "וזה היה האות."
  },
  {
   "start": 698.8,
   "end": 701.02,
   "text": "אל המקום הובא צלב ענק עשוי משיש טהור."
  },
  {
   "start": 701.78,
   "end": 704.24,
   "text": "הבישוף ניגש קדימה. הנה, קחו את הסמל שלנו."
  },
  {
   "start": 704.6,
   "end": 705.3,
   "text": "נשקו אותו."
  },
  {
   "start": 705.82,
   "end": 708.32,
   "text": "ואחר כך נתחיל בטקס, בטקס המרת הדת."
  },
  {
   "start": 709.84,
   "end": 711.44,
   "text": "וכל הקהל עצר את נשימתו."
  },
  {
   "start": 715.8,
   "end": 716.24,
   "text": "והשניים"
  },
  {
   "start": 717.34,
   "end": 718.22,
   "text": "לקחו את הצלב,"
  },
  {
   "start": 720.38,
   "end": 721.54,
   "text": "ובכוחות משותפים"
  },
  {
   "start": 723.48,
   "end": 725.1,
   "text": "הרימו אותו למעלה למעלה."
  },
  {
   "start": 727.54,
   "end": 727.94,
   "text": "ואז,"
  },
  {
   "start": 730.07,
   "end": 730.65,
   "text": "באחת,"
  },
  {
   "start": 731.95,
   "end": 735.35,
   "text": "לפני שמישהו הבין מה הם מתכננים לעשות,"
  },
  {
   "start": 736.67,
   "end": 737.55,
   "text": "הם לקחו את הצלב,"
  },
  {
   "start": 738.99,
   "end": 742.95,
   "text": "זרקו אותו על הרצפה והוא התנפץ לרסיסים,"
  },
  {
   "start": 744.35,
   "end": 748.97,
   "text": "מנפץ את הדמיונות, את המחשבות של הבישוף,"
  },
  {
   "start": 749.51,
   "end": 750.21,
   "text": "של המלך,"
  },
  {
   "start": 750.71,
   "end": 754.71,
   "text": "של כולם, שאותם שני יהודים ימירו את דתם."
  },
  {
   "start": 755.67,
   "end": 759.71,
   "text": "את הזעם של הבישוף אי אפשר היה לתאר במילים."
  },
  {
   "start": 761.01,
   "end": 762.37,
   "text": "המלך פולין קם נסער,"
  },
  {
   "start": 762.81,
   "end": 769.69,
   "text": "לא יודע לזעוק בכעס או לקרוא בהערצה אל מול דבורת הרוח של שני הפושעים היהודים."
  },
  {
   "start": 805.19,
   "end": 805.99,
   "text": "המלך והבישוף"
  },
  {
   "start": 807.51,
   "end": 808.25,
   "text": "נדברו ביניהם."
  },
  {
   "start": 809.39,
   "end": 812.19,
   "text": "אי אפשר היה לשבור את רוחם של היהודים האלו,"
  },
  {
   "start": 812.99,
   "end": 814.25,
   "text": "שאומנם הרחוב היה הבית שלהם,"
  },
  {
   "start": 815.45,
   "end": 820.03,
   "text": "אבל נשמתם הייתה רחבה מניים וצפנה בחובה כוחות בל ימנו."
  },
  {
   "start": 822.05,
   "end": 822.35,
   "text": "המלך"
  },
  {
   "start": 822.35,
   "end": 826.59,
   "text": "הודיע על גזר הדין עקב התנהגותם של היהודים."
  },
  {
   "start": 827.89,
   "end": 828.93,
   "text": "גזר דין איום ונורא."
  },
  {
   "start": 835.21,
   "end": 836.33,
   "text": "ידיהם של השניים"
  },
  {
   "start": 837.13,
   "end": 840.41,
   "text": "יוכנסו לקירר או תחת"
  },
  {
   "start": 841.01,
   "end": 842.71,
   "text": "עם זפת מבעבעת."
  },
  {
   "start": 843.39,
   "end": 845.85,
   "text": "אתם שברתם את הצלב בידיים שלכם?"
  },
  {
   "start": 846.93,
   "end": 850.87,
   "text": "נאותותם ידיים ייכנסו לקירר או תחת עם זפת מבעבעת."
  },
  {
   "start": 851.97,
   "end": 852.41,
   "text": "וכך,"
  },
  {
   "start": 853.05,
   "end": 855.55,
   "text": "תוך ייסורי תופת איומים,"
  },
  {
   "start": 856.33,
   "end": 859.73,
   "text": "יועלו אחר כך על המוקד וישרפו חיים."
  },
  {
   "start": 861.94,
   "end": 864.78,
   "text": "וכשגמר המלך להקרד גזר הדין,"
  },
  {
   "start": 866.08,
   "end": 868.32,
   "text": "הם נלקחו ונקשרו,"
  },
  {
   "start": 869.62,
   "end": 873.24,
   "text": "ואל המקום הובאה עקירה מלאה זפת רותחת."
  },
  {
   "start": 875.44,
   "end": 876.54,
   "text": "והידיים שלהם,"
  },
  {
   "start": 877.8,
   "end": 892.85,
   "text": "הידיים שלהם הוכנסו פנימה אל תוך ידי התליין שעטף אותם והכין אותם,"
  },
  {
   "start": 892.85,
   "end": 899.05,
   "text": "קשר אותם והכין אותם להכנסה אל תוך הקירה הרותחת,"
  },
  {
   "start": 902.42,
   "end": 905.54,
   "text": "וכל ההמון השתתק לו."
  },
  {
   "start": 911.46,
   "end": 913.5,
   "text": "עיניהם של השניים נפערו לרווחה."
  },
  {
   "start": 916.8,
   "end": 919.68,
   "text": "ריח הזפת המצחין התחיל לעלות באפם,"
  },
  {
   "start": 927.24,
   "end": 927.68,
   "text": "ואז"
  },
  {
   "start": 929.44,
   "end": 933.54,
   "text": "הידיים שלהם הוכנסו פנימה אל הזפת,"
  },
  {
   "start": 934.38,
   "end": 957.94,
   "text": "המצחין והמבעבע, והידיים הוצאו,"
  },
  {
   "start": 959.0,
   "end": 959.7,
   "text": "או יותר נכון,"
  },
  {
   "start": 960.46,
   "end": 961.74,
   "text": "מה שנשאר מהם,"
  },
  {
   "start": 962.72,
   "end": 964.52,
   "text": "מאותו בליל של עצמות,"
  },
  {
   "start": 965.82,
   "end": 971.94,
   "text": "בשר וזפת שנמס בייסורים איומים,"
  },
  {
   "start": 977.5,
   "end": 986.46,
   "text": "הקשוחים ביותר שבנות הקהל הזדעזעו."
  },
  {
   "start": 987.62,
   "end": 992.98,
   "text": "איש לא יכל להישאר אדיש, הלבבות פעמו בחרדה,"
  },
  {
   "start": 994.98,
   "end": 996.74,
   "text": "אפילו המלך כיסה את פניו."
  },
  {
   "start": 1010.75,
   "end": 1021.72,
   "text": "ושני האחים, שני האחים"
  },
  {
   "start": 1023.24,
   "end": 1025.3,
   "text": "שעמדו בגבורה,"
  },
  {
   "start": 1028.66,
   "end": 1029.96,
   "text": "בחריקת שיניים,"
  },
  {
   "start": 1030.44,
   "end": 1032.22,
   "text": "בהנחות קטועות,"
  },
  {
   "start": 1033.2,
   "end": 1036.06,
   "text": "מקבלים על עצמם את הייסורים."
  },
  {
   "start": 1052.5,
   "end": 1052.88,
   "text": "ואז,"
  },
  {
   "start": 1053.98,
   "end": 1058.06,
   "text": "אז קרה משהו שאיש מהנאספים לא ישכח."
  },
  {
   "start": 1059.08,
   "end": 1061.16,
   "text": "כל ימי חייהם הם יזכרו את המראה הזה."
  },
  {
   "start": 1063.32,
   "end": 1064.9,
   "text": "עם מה שנשאר מהידיים שלהם,"
  },
  {
   "start": 1066.74,
   "end": 1070.04,
   "text": "תוך ייסורים וכאבים שאי אפשר לתאר,"
  },
  {
   "start": 1071.16,
   "end": 1073.32,
   "text": "הם אט אט הרימו את הידיים,"
  },
  {
   "start": 1074.34,
   "end": 1075.66,
   "text": "ובתנועות איטיות,"
  },
  {
   "start": 1076.68,
   "end": 1078.08,
   "text": "בתנועות מאומצות,"
  },
  {
   "start": 1079.62,
   "end": 1088.16,
   "text": "הם פשוט החלו למחוא כפיים במה שנשאר מהידיים,"
  },
  {
   "start": 1089.5,
   "end": 1091.42,
   "text": "זפת אל זפת, בשר אל בשר,"
  },
  {
   "start": 1092.36,
   "end": 1095.04,
   "text": "והמלך פער את פיו בתדהמה,"
  },
  {
   "start": 1095.76,
   "end": 1096.48,
   "text": "אפילו הבישוף"
  },
  {
   "start": 1097.16,
   "end": 1098.08,
   "text": "כפה על עומדו."
  },
  {
   "start": 1102.23,
   "end": 1108.31,
   "text": "מחזה מצמרר ומרגש כל כך נגלה לעין כול, הם מכרו כאף."
  },
  {
   "start": 1108.93,
   "end": 1118.99,
   "text": "ועם השקט שהשתרר לו נשמע לפתע קולם מתנגן לו בניגון ניגונה של הנשמה."
  },
  {
   "start": 1120.15,
   "end": 1136.83,
   "text": "הם שרו לשם יתברך כיסופים ותשוקה לשם יתברך מתוך הכאבים מול המוות שמחכה להם מוחאים כפיים בתוך הייסורים העוטפים אותם הם מחאו כפיים ושרו בערגה אל השם יתברך"
  },
  {
   "start": 1137.37,
   "end": 1139.39,
   "text": "מחזה כל כך עוטה הוד והדר,"
  },
  {
   "start": 1140.03,
   "end": 1146.51,
   "text": "כאילו הם היו יודעים שעוד זמן קצר הם עולים ומתאחדים יחד בעולם שכולו טוב."
  },
  {
   "start": 1147.99,
   "end": 1149.93,
   "text": "קהילת היהודים נרעדה כולה"
  },
  {
   "start": 1150.95,
   "end": 1154.83,
   "text": "בפני כל, כל הנאספים, כל היהודים נראו שובלי דמעות,"
  },
  {
   "start": 1155.53,
   "end": 1161.37,
   "text": "נער, נערה, צעיר, צעירה, בוכי, זקן, זקנה,"
  },
  {
   "start": 1161.71,
   "end": 1163.69,
   "text": "כולם נפעמו עד כלות נשמתם,"
  },
  {
   "start": 1164.33,
   "end": 1167.51,
   "text": "מקבורתם, מקדושתם של הבחורים."
  },
  {
   "start": 1169.45,
   "end": 1172.09,
   "text": "והתליין לא חיכה הרבה."
  },
  {
   "start": 1173.09,
   "end": 1175.07,
   "text": "הוא החל מצית את האש במוקד,"
  },
  {
   "start": 1175.97,
   "end": 1179.09,
   "text": "כשהם ממשיכים בשארית כוחותם לשיר."
  },
  {
   "start": 1180.15,
   "end": 1180.97,
   "text": "מתוך הלב,"
  },
  {
   "start": 1181.59,
   "end": 1184.79,
   "text": "מתוך הנשמה, מי עמקי הנשמה,"
  },
  {
   "start": 1185.37,
   "end": 1194.88,
   "text": "תוך כדי מחיאות כפיים קצובות בעזרת מה שעוד נשאר מהידיים והאמון מסביב."
  },
  {
   "start": 1195.14,
   "end": 1198.14,
   "text": "גויים רבים לא יכלו להסתיר את הערצה שלהם."
  },
  {
   "start": 1201.21,
   "end": 1209.73,
   "text": "שירת הנאשמה התנגדה לה היכן שהוא והלב עלה לגדותיו ופרץ של בכי חנוק לפית הנשמע מבין הגהל."
  },
  {
   "start": 1210.77,
   "end": 1211.91,
   "text": "גברים, נשים,"
  },
  {
   "start": 1212.53,
   "end": 1221.03,
   "text": "יהודים, גויים הרשו לעצמם לתת דרור לצלילי הלב בשעה שנשמותיהם של שני הקדושים היהודים נזקו להם אל על,"
  },
  {
   "start": 1221.61,
   "end": 1222.89,
   "text": "אל אבא שבשמיים."
  },
  {
   "start": 1231.66,
   "end": 1232.12,
   "text": "לימים,"
  },
  {
   "start": 1232.12,
   "end": 1237.26,
   "text": "סיפר המלמד רבי אריה לייב גרונדי,"
  },
  {
   "start": 1238.24,
   "end": 1240.74,
   "text": "זכר צדיק וקדוש לברכה, שנוכח באותו מעמד."
  },
  {
   "start": 1242.34,
   "end": 1247.6,
   "text": "כל פעם שהיו רוצים למחוא כפיים מהחסידים, התלמידים שלו בשירים, היה אומר אל תמחאו כפיים, אני לא יכול."
  },
  {
   "start": 1248.28,
   "end": 1251.42,
   "text": "אחרי ששמעתי את מחיאות הכפיים של אותם שניים."
  },
  {
   "start": 1252.08,
   "end": 1254.56,
   "text": "כל מחיאות כפיים מחיאות מחווירות לעומת זה."
  },
  {
   "start": 1255.14,
   "end": 1256.76,
   "text": "אי אפשר לשמוע, אני לא יכול."
  },
  {
   "start": 1257.78,
   "end": 1259.68,
   "text": "כל מחיאות כפיים מחווירות."
  },
  {
   "start": 1260.56,
   "end": 1267.52,
   "text": "מחווירות עלובות ליד אותן מחיאות כפיים שיצאו משתי הבחורים האלה,"
  },
  {
   "start": 1268.16,
   "end": 1270.54,
   "text": "מחיאות כפיים של דבקות בשם יתברך."
  },
  {
   "start": 1284.88,
   "end": 1291.84,
   "text": "נשמותיהם ששני הצדיקים נסקו להם לשמיים, נשאו להם לשמיים,"
  },
  {
   "start": 1292.46,
   "end": 1295.26,
   "text": "מותירים אחריהם קהילה יהודית שלמה,"
  },
  {
   "start": 1295.7,
   "end": 1298.64,
   "text": "קהילה יהודית חיה ותוססת ללא פגע,"
  },
  {
   "start": 1299.06,
   "end": 1301.52,
   "text": "משאירות אחריהן שובל של קידוש השם,"
  },
  {
   "start": 1302.2,
   "end": 1303.6,
   "text": "של ניגון מיוחד,"
  },
  {
   "start": 1303.94,
   "end": 1305.5,
   "text": "של ניגון של יהודי,"
  },
  {
   "start": 1306.1,
   "end": 1307.7,
   "text": "ניגונה של הנשמה,"
  },
  {
   "start": 1308.12,
   "end": 1309.56,
   "text": "ניגונה של הנשמה,"
  },
  {
   "start": 1309.94,
   "end": 1312.96,
   "text": "שברגעים של מבחן הורידה את הקליפות,"
  },
  {
   "start": 1313.5,
   "end": 1314.7,
   "text": "הורידה את המניעים,"
  },
  {
   "start": 1317.17,
   "end": 1318.97,
   "text": "ודבקה לה באבא שבשמיים,"
  },
  {
   "start": 1319.53,
   "end": 1321.25,
   "text": "באהבה וביראה,"
  },
  {
   "start": 1321.87,
   "end": 1322.81,
   "text": "כמו שכולנו,"
  },
  {
   "start": 1323.95,
   "end": 1326.09,
   "text": "כמו בן פורש שמחפש את אבא,"
  },
  {
   "start": 1326.57,
   "end": 1330.67,
   "text": "כמו בת אוהבת שאת השם אוהבת."
  },
  {
   "start": 1334.46,
   "end": 1336.82,
   "text": "ואת מחיאות הכפיים האלה צריכים להדהד,"
  },
  {
   "start": 1337.44,
   "end": 1339.24,
   "text": "לכל אחת ואחת מאיתנו."
  },
  {
   "start": 1341.36,
   "end": 1342.72,
   "text": "לכל אחת ואחד."
  },
  {
   "start": 1343.98,
   "end": 1345.98,
   "text": "כולנו ביחד, בחסדי השם יתברך."
  },
  {
   "start": 1346.92,
   "end": 1348.66,
   "text": "צריכים לנגן את ניגון הנשמה."
  },
  {
   "start": 1348.98,
   "end": 1350.52,
   "text": "ניגון של קרבה לשם יתברך."
  },
  {
   "start": 1350.96,
   "end": 1353.16,
   "text": "למסור נפש לשם יתברך. לא לשכוח."
  },
  {
   "start": 1353.5,
   "end": 1358.52,
   "text": "אם יהיה שם איזה מחבל, אם אנחנו רואים מחבלים שמוכנים למסור נפש על שטויות,"
  },
  {
   "start": 1358.92,
   "end": 1360.82,
   "text": "על נזק, על הרס של עולם,"
  },
  {
   "start": 1361.36,
   "end": 1361.56,
   "text": "על טומאה,"
  },
  {
   "start": 1363.38,
   "end": 1366.32,
   "text": "אנחנו מחויבים למסור נפש על קדושה,"
  },
  {
   "start": 1366.32,
   "end": 1371.28,
   "text": "על בניין עולם לכבוד מלך מלכי המלכים הקדוש ברוך הוא"
  }
 ]
}