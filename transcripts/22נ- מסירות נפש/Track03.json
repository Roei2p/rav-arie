{
 "disc": "22נ- מסירות נפש",
 "track": "Track03",
 "duration": 1446.12,
 "segments": [
  {
   "start": 19.96,
   "end": 23.56,
   "text": "אחד מהאדמו״רים הקדושים שהפליאו את העולם היהודי"
  },
  {
   "start": 24.4,
   "end": 25.96,
   "text": "בתולדות חייו המסתוריים"
  },
  {
   "start": 26.88,
   "end": 28.2,
   "text": "היה רבי שלמה מקרלין."
  },
  {
   "start": 29.5,
   "end": 30.7,
   "text": "זכרו יגן עלינו אמן."
  },
  {
   "start": 37.44,
   "end": 41.02,
   "text": "רבי שלמה מקרלין היה ממשיך דרכו של הרבי אהרון הגדול מקרלין,"
  },
  {
   "start": 45.45,
   "end": 46.71,
   "text": "ופעם אחת בא אליו יהודי,"
  },
  {
   "start": 47.61,
   "end": 49.73,
   "text": "יהודי עני שהתחיל לבכות על המצב הקשה שלו."
  },
  {
   "start": 52.07,
   "end": 54.09,
   "text": "ורבי שלמה מקרלין נשבר ליבו בקרבו,"
  },
  {
   "start": 54.79,
   "end": 56.39,
   "text": "אמר לו, אתה יודע מה יהודי? שב פה, תמתין."
  },
  {
   "start": 57.59,
   "end": 59.73,
   "text": "אמר לה, שמע שלא לך תקרא לרבי ברוך ישראל."
  },
  {
   "start": 61.45,
   "end": 62.85,
   "text": "העשיר של העיירה, לך תקרא לו."
  },
  {
   "start": 65.64,
   "end": 66.88,
   "text": "ורבי ברוך ישראל הגיע,"
  },
  {
   "start": 67.66,
   "end": 68.66,
   "text": "אמר להם, טוב, שב פה,"
  },
  {
   "start": 69.36,
   "end": 70.52,
   "text": "תקשיבו עכשיו שניכם,"
  },
  {
   "start": 71.2,
   "end": 71.68,
   "text": "תקשיבו טוב"
  },
  {
   "start": 72.4,
   "end": 73.86,
   "text": "למה שאני מספר לכם."
  },
  {
   "start": 74.54,
   "end": 75.18,
   "text": "זמן מה,"
  },
  {
   "start": 75.7,
   "end": 78.36,
   "text": "אחרי שאני נהיתי אדמו״ר, אמר רבי שלמה מקרלין,"
  },
  {
   "start": 79.36,
   "end": 81.16,
   "text": "ניתן לי רשות מן השמיים,"
  },
  {
   "start": 82.28,
   "end": 83.8,
   "text": "בעקבות תפילות ארוכות,"
  },
  {
   "start": 84.88,
   "end": 87.8,
   "text": "לראות את מה שאחרים לא רואים."
  },
  {
   "start": 90.62,
   "end": 91.86,
   "text": "ואני שמחתי כל כך,"
  },
  {
   "start": 92.62,
   "end": 94.82,
   "text": "שאני יכול לראות"
  },
  {
   "start": 96.26,
   "end": 99.3,
   "text": "מה שבדרך כלל אין רשות לעין לראות."
  },
  {
   "start": 101.75,
   "end": 102.17,
   "text": "והנה,"
  },
  {
   "start": 102.75,
   "end": 103.75,
   "text": "זמן קצר אחר כך,"
  },
  {
   "start": 104.65,
   "end": 108.47,
   "text": "באו לי יהודים ממשפחה מפורסמת ומכובדת והתחילו לבכות לי."
  },
  {
   "start": 109.15,
   "end": 116.81,
   "text": "האבא שלהם, האבא שלהם שוכב גוסס על ערש דווי ומתפלל, מבקשים תעשה טובה כבוד הרב ותתפלל לעבורנו."
  },
  {
   "start": 118.33,
   "end": 121.23,
   "text": "ובאותו זמן נפתחת הדלת"
  },
  {
   "start": 124.17,
   "end": 125.31,
   "text": "ולחדר נכנסים"
  },
  {
   "start": 126.27,
   "end": 128.79,
   "text": "גבאי ההקדש המקומי,"
  },
  {
   "start": 129.97,
   "end": 130.57,
   "text": "אומרים, תראה,"
  },
  {
   "start": 131.09,
   "end": 131.63,
   "text": "כבוד הרב,"
  },
  {
   "start": 132.35,
   "end": 133.49,
   "text": "שוכבת לה שם אישה"
  },
  {
   "start": 134.51,
   "end": 135.45,
   "text": "קורעת ללדת,"
  },
  {
   "start": 136.17,
   "end": 139.25,
   "text": "היא בסכנה, התינוק בסכנה, הרב יתפלל,"
  },
  {
   "start": 139.93,
   "end": 140.81,
   "text": "הרב יעשה משהו."
  },
  {
   "start": 143.07,
   "end": 143.51,
   "text": "ואני,"
  },
  {
   "start": 144.45,
   "end": 145.27,
   "text": "אני עומד בתווך,"
  },
  {
   "start": 146.61,
   "end": 147.51,
   "text": "ואני רואה,"
  },
  {
   "start": 149.05,
   "end": 150.23,
   "text": "אני רואה מה שהם לא רואים,"
  },
  {
   "start": 150.93,
   "end": 151.69,
   "text": "אני רואה שהנשמה,"
  },
  {
   "start": 152.55,
   "end": 154.29,
   "text": "הנשמה של האבא הגוסס,"
  },
  {
   "start": 154.83,
   "end": 159.45,
   "text": "צריכה לעבור אל הילד שאמור להיוולד."
  },
  {
   "start": 160.11,
   "end": 162.55,
   "text": "ועד שהגוסס לא ילך לבית עולמו,"
  },
  {
   "start": 163.45,
   "end": 164.55,
   "text": "הילד לא יצא,"
  },
  {
   "start": 166.37,
   "end": 166.99,
   "text": "לא ייוולד."
  },
  {
   "start": 168.11,
   "end": 168.71,
   "text": "מה אני אסביר להם?"
  },
  {
   "start": 169.65,
   "end": 170.61,
   "text": "עבור מי אני אתפלל?"
  },
  {
   "start": 171.53,
   "end": 172.25,
   "text": "מה אני אעשה?"
  },
  {
   "start": 172.99,
   "end": 173.75,
   "text": "נקרעתי."
  },
  {
   "start": 174.93,
   "end": 175.51,
   "text": "אבל לא היה לי ברירה."
  },
  {
   "start": 176.61,
   "end": 177.59,
   "text": "החלטתי מה שהחלטתי,"
  },
  {
   "start": 178.49,
   "end": 179.43,
   "text": "עשיתי מה שעשיתי."
  },
  {
   "start": 181.31,
   "end": 183.15,
   "text": "וזמן קצר אחר כך,"
  },
  {
   "start": 185.53,
   "end": 189.75,
   "text": "מבית האבא הגוסס נשמעו יללות בכי,"
  },
  {
   "start": 192.11,
   "end": 193.41,
   "text": "ומההקדש המקומי"
  },
  {
   "start": 194.61,
   "end": 195.99,
   "text": "נשמעו קריאות שמחה,"
  },
  {
   "start": 196.75,
   "end": 197.11,
   "text": "נולד בן."
  },
  {
   "start": 204.88,
   "end": 206.22,
   "text": "שבע שנים אחר כך,"
  },
  {
   "start": 207.72,
   "end": 209.78,
   "text": "שבע שנים אחר כך אני יושב בבית שלי,"
  },
  {
   "start": 210.56,
   "end": 212.22,
   "text": "לומד תורה כהרגלי בקודש,"
  },
  {
   "start": 213.74,
   "end": 215.38,
   "text": "ולפתע אני נקרא בדחיפות"
  },
  {
   "start": 217.0,
   "end": 219.62,
   "text": "אל בית העשיר של קרלין."
  },
  {
   "start": 221.48,
   "end": 223.56,
   "text": "אותו עשיר, אותו אבא עשיר שנפטר"
  },
  {
   "start": 224.22,
   "end": 225.18,
   "text": "שבע שנים לפני כן."
  },
  {
   "start": 226.62,
   "end": 228.02,
   "text": "יש בר מצווה לבן שלו."
  },
  {
   "start": 228.68,
   "end": 229.98,
   "text": "הבן שלו הקטן הגיע לגיל מצוות,"
  },
  {
   "start": 231.1,
   "end": 231.72,
   "text": "אותו יתום מאבא."
  },
  {
   "start": 233.2,
   "end": 236.32,
   "text": "ויש שם איזה ילד אחד, עני בן שבע, שמשתולל."
  },
  {
   "start": 237.42,
   "end": 240.78,
   "text": "הוא פשוט רוצה לשבת על הכיסא של האבא, של הנפטר,"
  },
  {
   "start": 241.98,
   "end": 243.64,
   "text": "ומתחוללת מהומה של ממש,"
  },
  {
   "start": 246.19,
   "end": 246.63,
   "text": "וקוראים לי"
  },
  {
   "start": 249.77,
   "end": 251.19,
   "text": "כדי להסביר להרגיע את הילד."
  },
  {
   "start": 256.12,
   "end": 256.8,
   "text": "ואני בא לשם,"
  },
  {
   "start": 257.64,
   "end": 258.88,
   "text": "והילד שורח, זה שלי,"
  },
  {
   "start": 259.36,
   "end": 261.44,
   "text": "הכיסא שלי, זה המקום שלי."
  },
  {
   "start": 262.4,
   "end": 263.2,
   "text": "ואני שוב נקרע."
  },
  {
   "start": 264.88,
   "end": 266.24,
   "text": "איך אני יכול להסביר להם"
  },
  {
   "start": 266.8,
   "end": 268.02,
   "text": "שהילד צודק?"
  },
  {
   "start": 269.48,
   "end": 269.88,
   "text": "בילד"
  },
  {
   "start": 270.5,
   "end": 275.52,
   "text": "נמצאת שוכנת לה הנשמה של האבא. איך אני אסביר להם? מי יכול להסביר להם?"
  },
  {
   "start": 276.22,
   "end": 277.24,
   "text": "ואני לא יודע מה לעשות."
  },
  {
   "start": 277.8,
   "end": 278.6,
   "text": "ואני לא יכול להסביר."
  },
  {
   "start": 279.6,
   "end": 280.18,
   "text": "כי פשוט,"
  },
  {
   "start": 281.06,
   "end": 282.72,
   "text": "בזמן שניתן לי לראות,"
  },
  {
   "start": 283.96,
   "end": 287.42,
   "text": "בזמן שניתן לי לראות מה שלאחרים לא ניתן לראות,"
  },
  {
   "start": 291.18,
   "end": 294.18,
   "text": "נמסר לי שאסור לי לגלות, אני חייב לשמור הכל בתוכי."
  },
  {
   "start": 296.84,
   "end": 298.54,
   "text": "ואני נקרע ולא יכול להסביר."
  },
  {
   "start": 302.42,
   "end": 303.9,
   "text": "לא יכול להסביר להם שהילד צודק."
  },
  {
   "start": 305.7,
   "end": 306.52,
   "text": "אז אתם יודעים מה עשיתי?"
  },
  {
   "start": 307.34,
   "end": 308.3,
   "text": "חזרתי הביתה"
  },
  {
   "start": 309.0,
   "end": 312.24,
   "text": "והתחלתי לבכות לקדוש ברוך הוא, בורא העולם."
  },
  {
   "start": 312.9,
   "end": 315.78,
   "text": "תעשה לי טובה, תיקח ממני את היכולת הזו."
  },
  {
   "start": 317.64,
   "end": 320.02,
   "text": "אני לא רוצה, אני רוצה לראות כמו אדם רגיל."
  },
  {
   "start": 320.02,
   "end": 325.26,
   "text": "אני לא רוצה לראות מעבר לזה, אני לא יכול לעמוד בכך."
  },
  {
   "start": 329.85,
   "end": 331.85,
   "text": "והבקשה שלי, התפילה שלי, התקבלה."
  },
  {
   "start": 332.67,
   "end": 335.09,
   "text": "אמנם לפעמים יותר קל לתת"
  },
  {
   "start": 336.23,
   "end": 337.39,
   "text": "איזה שפע מסוים,"
  },
  {
   "start": 338.03,
   "end": 339.27,
   "text": "ולא בקלות לוקחים."
  },
  {
   "start": 340.39,
   "end": 346.05,
   "text": "היא הסתעייה לי מילתא, היה לי סייעתא דשמיא, ברור עולם עזה, לשא איתי חסד ולקח ממני."
  },
  {
   "start": 347.37,
   "end": 347.95,
   "text": "אבל תדעו לכם,"
  },
  {
   "start": 348.75,
   "end": 350.45,
   "text": "הוא לקח את המתנה הזו שהוא נתן לי,"
  },
  {
   "start": 351.23,
   "end": 351.93,
   "text": "אבל קצת,"
  },
  {
   "start": 352.73,
   "end": 353.67,
   "text": "קצת נשאר."
  },
  {
   "start": 354.89,
   "end": 355.73,
   "text": "ועכשיו אני אומר לכם,"
  },
  {
   "start": 356.53,
   "end": 357.17,
   "text": "ברוך ישראל,"
  },
  {
   "start": 357.89,
   "end": 358.57,
   "text": "אתה חייב"
  },
  {
   "start": 359.21,
   "end": 361.29,
   "text": "לעני הזה כסף מגלגול קודם."
  },
  {
   "start": 362.17,
   "end": 364.09,
   "text": "כדאי לך עכשיו להחזיר את זה, בטוב,"
  },
  {
   "start": 369.24,
   "end": 371.1,
   "text": "ולא תצטרך להחזיר את זה יותר מאוחר,"
  },
  {
   "start": 371.62,
   "end": 372.12,
   "text": "בפחות טוב."
  },
  {
   "start": 374.54,
   "end": 375.48,
   "text": "וברוך ישראל"
  },
  {
   "start": 376.56,
   "end": 377.04,
   "text": "הנהן"
  },
  {
   "start": 377.8,
   "end": 379.74,
   "text": "ונתן לעני את כל צורכו."
  },
  {
   "start": 383.35,
   "end": 384.75,
   "text": "אמר להם רבי שלמה מקרלין,"
  },
  {
   "start": 385.69,
   "end": 386.25,
   "text": "תדעו לכם,"
  },
  {
   "start": 386.87,
   "end": 389.33,
   "text": "אסור לשאול, אסור להרהר,"
  },
  {
   "start": 389.77,
   "end": 392.65,
   "text": "אחרי מה שקורה בעולם, אתה לא יכול לדעת כלום."
  },
  {
   "start": 398.46,
   "end": 399.08,
   "text": "והם יצאו,"
  },
  {
   "start": 399.72,
   "end": 400.7,
   "text": "העני והעשיר,"
  },
  {
   "start": 401.96,
   "end": 402.64,
   "text": "עם חיוך רחב."
  },
  {
   "start": 413.68,
   "end": 414.78,
   "text": "זמן מה אחר כך,"
  },
  {
   "start": 415.88,
   "end": 417.24,
   "text": "קם רבי שלמה מקרלין,"
  },
  {
   "start": 417.92,
   "end": 418.48,
   "text": "עזב את"
  },
  {
   "start": 419.6,
   "end": 422.44,
   "text": "העיר קרלין ועבר ללודמיר."
  },
  {
   "start": 425.3,
   "end": 427.44,
   "text": "ושם הוא ישב נהיה הרב של לודמיר."
  },
  {
   "start": 428.04,
   "end": 429.06,
   "text": "איש לא מבין מדוע,"
  },
  {
   "start": 429.74,
   "end": 430.52,
   "text": "איש לא מבין למה."
  },
  {
   "start": 433.25,
   "end": 434.73,
   "text": "מספר ימים אחרי שהוא הגיע ללודמיר,"
  },
  {
   "start": 435.25,
   "end": 436.93,
   "text": "הוא ביקש לסייר בבית הקברות."
  },
  {
   "start": 439.24,
   "end": 441.32,
   "text": "שנבין, רבי שלמה מקרילון היה צעיר,"
  },
  {
   "start": 442.52,
   "end": 443.4,
   "text": "לא היה בגיל מבוגר,"
  },
  {
   "start": 444.26,
   "end": 446.1,
   "text": "אבל הוא רוצה לראות את בית הקברות."
  },
  {
   "start": 447.1,
   "end": 448.76,
   "text": "וכשהוא מגיע לבית הקברות הוא מסייר,"
  },
  {
   "start": 449.64,
   "end": 450.94,
   "text": "עד שהוא הגיע לאיזה מקום,"
  },
  {
   "start": 451.62,
   "end": 452.54,
   "text": "מקום לא של מיוחסים,"
  },
  {
   "start": 453.66,
   "end": 454.68,
   "text": "לא של צדיקים,"
  },
  {
   "start": 456.2,
   "end": 457.58,
   "text": "אי שם בפינת בית הקברות,"
  },
  {
   "start": 458.26,
   "end": 459.34,
   "text": "מקום של יהודים פשוטים."
  },
  {
   "start": 459.9,
   "end": 461.06,
   "text": "לפתע הוא מסמן, הנה, שם."
  },
  {
   "start": 462.66,
   "end": 464.48,
   "text": "הוא אומר להשמה שלו, אתה רואה את זה?"
  },
  {
   "start": 464.9,
   "end": 465.66,
   "text": "אתה רואה את המקום הזה?"
  },
  {
   "start": 466.5,
   "end": 469.62,
   "text": "מקום הזה, את המקום הזה אני רוצה לי לחלקת קבר."
  },
  {
   "start": 469.94,
   "end": 472.2,
   "text": "כשאני אמות, אני רוצה להיקבר כאן."
  },
  {
   "start": 473.1,
   "end": 477.16,
   "text": "זה מקום נאה למקדשי שמו יתברך."
  },
  {
   "start": 477.88,
   "end": 480.3,
   "text": "זה מקום נאה למקדשי שמו יתברך."
  },
  {
   "start": 481.64,
   "end": 483.34,
   "text": "ואנשי החברה קדישא לא מבינים."
  },
  {
   "start": 483.98,
   "end": 486.24,
   "text": "מסתכלים אחד על השני, אף אחד לא מבין, איש לא מבין."
  },
  {
   "start": 487.1,
   "end": 488.68,
   "text": "למה הרב, אתה צעיר לימים?"
  },
  {
   "start": 489.2,
   "end": 490.82,
   "text": "מה אתה דואג עכשיו לחלקת קבר?"
  },
  {
   "start": 491.58,
   "end": 492.58,
   "text": "ומה פשר המילים?"
  },
  {
   "start": 493.84,
   "end": 495.5,
   "text": "מקום נאה למקדשי שמו יתברך."
  },
  {
   "start": 496.42,
   "end": 497.96,
   "text": "לא מובן,"
  },
  {
   "start": 498.78,
   "end": 499.28,
   "text": "לא ידוע."
  },
  {
   "start": 520.72,
   "end": 521.54,
   "text": "חודש תמוז,"
  },
  {
   "start": 524.47,
   "end": 526.01,
   "text": "שנת תקנב,"
  },
  {
   "start": 527.05,
   "end": 528.63,
   "text": "לודמיר התעוררה לחיים."
  },
  {
   "start": 529.41,
   "end": 533.71,
   "text": "הצדיק הקדוש, רבי אריה לייב סארס, הגיע."
  },
  {
   "start": 534.77,
   "end": 539.07,
   "text": "אמנם ניסה להגיע בחסות החשיכה, בשקט, במסתור,"
  },
  {
   "start": 540.05,
   "end": 543.31,
   "text": "אבל מנהיג ל״ו הצדיקים הנסתרים נחשף,"
  },
  {
   "start": 543.97,
   "end": 545.29,
   "text": "רבי אריה לייב סארס."
  },
  {
   "start": 546.37,
   "end": 547.47,
   "text": "הצדיק הקדוש הגיע."
  },
  {
   "start": 548.51,
   "end": 550.89,
   "text": "וכולם יודעים, השמועה עוברת מפה לאוזן,"
  },
  {
   "start": 551.33,
   "end": 552.21,
   "text": "הוא מסתגר לו בחדר,"
  },
  {
   "start": 553.21,
   "end": 555.47,
   "text": "באחד מהאכסניות של העיר לודמיר,"
  },
  {
   "start": 556.51,
   "end": 557.89,
   "text": "וכל היום הוא עסוק בתפילות,"
  },
  {
   "start": 558.81,
   "end": 560.71,
   "text": "והכל בחשאי והכל בשקט."
  },
  {
   "start": 562.43,
   "end": 565.97,
   "text": "וככה השמועה פושטת לה כבשדה קוצים,"
  },
  {
   "start": 567.15,
   "end": 569.23,
   "text": "עד שהיא מגיעה לחדרו של הרב,"
  },
  {
   "start": 569.81,
   "end": 571.19,
   "text": "רבי שלמה מקרלין."
  },
  {
   "start": 572.13,
   "end": 575.75,
   "text": "כששמע רבי שלמה מקרלין, שרבי אריה לייב סארס,"
  },
  {
   "start": 576.95,
   "end": 577.73,
   "text": "שהיה מנהיג"
  },
  {
   "start": 578.61,
   "end": 581.39,
   "text": "ל״ו הצדיקים הנסתרים, בכל דור צריך לדעת."
  },
  {
   "start": 582.05,
   "end": 585.49,
   "text": "יש ל״ו צדיקים נסתרים, שעליהם העולם עומד."
  },
  {
   "start": 587.98,
   "end": 591.72,
   "text": "נראים אנשים פשוטים, רגילים, אולי אפילו פחות מפשוטים,"
  },
  {
   "start": 592.78,
   "end": 594.54,
   "text": "ולמעשה הם צדיקים נסתרים."
  },
  {
   "start": 596.28,
   "end": 598.78,
   "text": "רבי אריה לייבסרס באותה תקופה היה המנהיג שלהם."
  },
  {
   "start": 603.04,
   "end": 605.2,
   "text": "וכשרבי שלמה מיקר לנשמה,"
  },
  {
   "start": 605.68,
   "end": 606.76,
   "text": "שאריה לייבסרס,"
  },
  {
   "start": 607.06,
   "end": 608.5,
   "text": "רבי אריה לייבסרס הגיע,"
  },
  {
   "start": 608.92,
   "end": 609.8,
   "text": "וכל היום הוא בתפילות,"
  },
  {
   "start": 610.82,
   "end": 611.86,
   "text": "קרא לתלמיד שלו,"
  },
  {
   "start": 612.3,
   "end": 614.78,
   "text": "לתלמיד אולי מספר אחת שלו, רבי אשר מסטולין,"
  },
  {
   "start": 615.6,
   "end": 616.8,
   "text": "ואמר לו, רב אשר,"
  },
  {
   "start": 617.68,
   "end": 621.98,
   "text": "לך אל רבי אריה לייבן סארס ותשאל אותו בשמי,"
  },
  {
   "start": 623.04,
   "end": 626.32,
   "text": "מה אתה רוצה? ככה תגיד לו, מה אתה רוצה?"
  },
  {
   "start": 627.14,
   "end": 628.48,
   "text": "אני הרב של העיר,"
  },
  {
   "start": 629.18,
   "end": 631.04,
   "text": "והרב של העיר קובע."
  },
  {
   "start": 632.58,
   "end": 634.82,
   "text": "ככה תגיד לו, אל תשאל למה,"
  },
  {
   "start": 635.58,
   "end": 637.18,
   "text": "אל תשאל הסברים,"
  },
  {
   "start": 637.88,
   "end": 638.4,
   "text": "כלום."
  },
  {
   "start": 638.92,
   "end": 640.12,
   "text": "תמסור לו את ההודעה הזאת."
  },
  {
   "start": 640.88,
   "end": 642.08,
   "text": "זמן קצר אחר כך,"
  },
  {
   "start": 642.9,
   "end": 643.64,
   "text": "בחשש,"
  },
  {
   "start": 644.22,
   "end": 647.34,
   "text": "נכנס לו רבי אשר מסטולין אל הקודש פנימה."
  },
  {
   "start": 649.1,
   "end": 650.8,
   "text": "הוא פונה אל רבי אריה לייבסארס"
  },
  {
   "start": 652.16,
   "end": 652.84,
   "text": "ומוסר לו,"
  },
  {
   "start": 653.48,
   "end": 656.0,
   "text": "אומר לו בשם מורי ורבי הרב"
  },
  {
   "start": 656.54,
   "end": 657.48,
   "text": "שלמה מקרלין,"
  },
  {
   "start": 658.42,
   "end": 660.4,
   "text": "ביקש למסור לכבוד הרב."
  },
  {
   "start": 661.74,
   "end": 662.1,
   "text": "הוא אמר,"
  },
  {
   "start": 663.5,
   "end": 665.9,
   "text": "זה לשון ההודעה, זו לשון ההודעה,"
  },
  {
   "start": 666.48,
   "end": 667.24,
   "text": "מה אתה רוצה?"
  },
  {
   "start": 667.76,
   "end": 668.8,
   "text": "אני הרב של העיר,"
  },
  {
   "start": 669.54,
   "end": 670.98,
   "text": "והרב של העיר קובע."
  },
  {
   "start": 672.74,
   "end": 675.08,
   "text": "רבי אריה לייבסרס כפה על מקומו."
  },
  {
   "start": 676.32,
   "end": 678.68,
   "text": "פניו התעוותו להם בכאב,"
  },
  {
   "start": 680.46,
   "end": 682.14,
   "text": "ודמעות החלו נושרות מעיניו."
  },
  {
   "start": 685.82,
   "end": 686.98,
   "text": "הוא פשוט החל בוכה"
  },
  {
   "start": 690.29,
   "end": 691.73,
   "text": "מקץ דקות ארוכות,"
  },
  {
   "start": 695.26,
   "end": 701.54,
   "text": "כשהרצפה כבר התמלאה לה ברטיבות"
  },
  {
   "start": 702.7,
   "end": 704.78,
   "text": "מדמעותיו של רבי אריה לייבסרס."
  },
  {
   "start": 706.18,
   "end": 707.4,
   "text": "הוא חלץ את תפיליו,"
  },
  {
   "start": 708.34,
   "end": 709.36,
   "text": "קיפל את הטלית שלו,"
  },
  {
   "start": 710.34,
   "end": 714.0,
   "text": "ועד מהרה נעלם מהעיר כלעומת שבה,"
  },
  {
   "start": 716.34,
   "end": 716.94,
   "text": "ואיש לא הבין,"
  },
  {
   "start": 718.34,
   "end": 718.98,
   "text": "איש לא ידע,"
  },
  {
   "start": 722.29,
   "end": 722.79,
   "text": "תעלומה,"
  },
  {
   "start": 744.46,
   "end": 746.64,
   "text": "שבת קודש, יז בתמוז,"
  },
  {
   "start": 747.7,
   "end": 748.58,
   "text": "והעיר לודמיר"
  },
  {
   "start": 749.44,
   "end": 750.46,
   "text": "בחרדה נוראה."
  },
  {
   "start": 753.73,
   "end": 754.49,
   "text": "גדודי קוזאקים,"
  },
  {
   "start": 755.37,
   "end": 756.13,
   "text": "רוצחים,"
  },
  {
   "start": 756.77,
   "end": 757.57,
   "text": "פשטו על העיירה,"
  },
  {
   "start": 760.18,
   "end": 763.58,
   "text": "ויהודים החלו בורחים מכל המקומות,"
  },
  {
   "start": 764.1,
   "end": 766.56,
   "text": "רצים על מנת להציל את נפשם."
  },
  {
   "start": 769.45,
   "end": 770.31,
   "text": "הרחוב התמלא,"
  },
  {
   "start": 771.49,
   "end": 772.53,
   "text": "ביריות,"
  },
  {
   "start": 775.8,
   "end": 776.22,
   "text": "בדם,"
  },
  {
   "start": 779.06,
   "end": 779.36,
   "text": "במוות."
  },
  {
   "start": 789.07,
   "end": 791.13,
   "text": "רבים מהיהודים, למעשה רוב,"
  },
  {
   "start": 791.77,
   "end": 792.83,
   "text": "רוב תושבי לודמיר,"
  },
  {
   "start": 793.35,
   "end": 795.97,
   "text": "ברחו בבהלה אל בית המדרש הגדול."
  },
  {
   "start": 798.81,
   "end": 800.77,
   "text": "לחסות בצילו של רבי שלמה מקרלין."
  },
  {
   "start": 802.55,
   "end": 804.67,
   "text": "מאות יהודים הצטופפו להם בבית המדרש."
  },
  {
   "start": 805.77,
   "end": 806.71,
   "text": "מסביב אמה ופחד."
  },
  {
   "start": 808.67,
   "end": 810.21,
   "text": "הדי התפוצצויות הפגזים"
  },
  {
   "start": 811.51,
   "end": 812.13,
   "text": "נשמעו"
  },
  {
   "start": 812.87,
   "end": 813.49,
   "text": "מכל פינה."
  },
  {
   "start": 814.49,
   "end": 816.43,
   "text": "יריות מכל עבר,"
  },
  {
   "start": 817.89,
   "end": 818.91,
   "text": "רכו של המוות"
  },
  {
   "start": 819.53,
   "end": 820.49,
   "text": "נישא באוויר"
  },
  {
   "start": 840.77,
   "end": 841.91,
   "text": "בבית המדרש."
  },
  {
   "start": 842.57,
   "end": 844.05,
   "text": "דמותו עטורת ההוד"
  },
  {
   "start": 844.67,
   "end": 845.39,
   "text": "של הרב."
  },
  {
   "start": 847.13,
   "end": 849.33,
   "text": "כל היהודים שוכבים, מפוחדים,"
  },
  {
   "start": 849.91,
   "end": 852.21,
   "text": "והרב עומד במרכז בית המדרש."
  },
  {
   "start": 853.19,
   "end": 853.57,
   "text": "הדמות שלו,"
  },
  {
   "start": 854.31,
   "end": 856.33,
   "text": "בעלת ההוד וההדר,"
  },
  {
   "start": 856.77,
   "end": 859.29,
   "text": "בעלת הקדושה שאופפת את כל-כולו,"
  },
  {
   "start": 859.73,
   "end": 861.43,
   "text": "נראית ממש כמשוחכת"
  },
  {
   "start": 862.25,
   "end": 864.49,
   "text": "על מאות היהודים המפוחדים שבסביבו."
  },
  {
   "start": 865.33,
   "end": 867.85,
   "text": "רבי שלמה מקרלין, עטוף בטלית,"
  },
  {
   "start": 868.57,
   "end": 871.33,
   "text": "עומד ניצב במרכז בית המדרש,"
  },
  {
   "start": 871.93,
   "end": 873.75,
   "text": "כולו דבקות בשם יתברך,"
  },
  {
   "start": 874.71,
   "end": 879.89,
   "text": "בעוד כל היהודים תופסים להם מחסה ברצפת בית המדרש."
  },
  {
   "start": 881.23,
   "end": 882.27,
   "text": "רבי שלמה מקרלין"
  },
  {
   "start": 883.45,
   "end": 884.33,
   "text": "היה מתפלל,"
  },
  {
   "start": 885.55,
   "end": 889.13,
   "text": "ככהן גדול בשעתו, מכפר על כל עם ישראל."
  },
  {
   "start": 889.77,
   "end": 890.67,
   "text": "ידיו פרוסות,"
  },
  {
   "start": 893.11,
   "end": 894.11,
   "text": "אל על השמיים,"
  },
  {
   "start": 895.91,
   "end": 896.83,
   "text": "וראשו נישא"
  },
  {
   "start": 897.95,
   "end": 899.15,
   "text": "בין ענני שמיים."
  },
  {
   "start": 921.36,
   "end": 924.3,
   "text": "החלון הגדול התנפץ ברעש אדיר."
  },
  {
   "start": 926.9,
   "end": 929.22,
   "text": "החלון הגדול התנפץ ברעש מחריש אוזניים."
  },
  {
   "start": 930.9,
   "end": 935.97,
   "text": "הקוזקים הגיעו אל בית המדרש, תוך שניות"
  },
  {
   "start": 937.15,
   "end": 939.85,
   "text": "אש תופת ניחתה על היהודים בבית המדרש."
  },
  {
   "start": 941.47,
   "end": 943.09,
   "text": "אלפי כדורים שרקו מסביב."
  },
  {
   "start": 944.63,
   "end": 945.71,
   "text": "עפים להם מסביב."
  },
  {
   "start": 947.93,
   "end": 950.23,
   "text": "אבל אז אתה רואה דבר לא יאומן."
  },
  {
   "start": 951.01,
   "end": 952.57,
   "text": "הכדורים עפו להם מסביב."
  },
  {
   "start": 953.11,
   "end": 954.21,
   "text": "אלפי כדורים."
  },
  {
   "start": 955.79,
   "end": 959.17,
   "text": "אבל כמו שיש איזו יד שמזיזה אותם,"
  },
  {
   "start": 959.81,
   "end": 960.81,
   "text": "שמונעת אותם"
  },
  {
   "start": 961.63,
   "end": 963.03,
   "text": "מלפגוע באיש."
  },
  {
   "start": 964.27,
   "end": 964.71,
   "text": "נס."
  },
  {
   "start": 967.18,
   "end": 968.54,
   "text": "בבית המדרש הייתה חומת מגן,"
  },
  {
   "start": 969.44,
   "end": 970.7,
   "text": "חומת מגן רוחנית"
  },
  {
   "start": 971.34,
   "end": 972.32,
   "text": "שמשוחחת לה"
  },
  {
   "start": 973.36,
   "end": 974.12,
   "text": "על בני העיירה."
  },
  {
   "start": 976.47,
   "end": 978.51,
   "text": "ובהתחלה אולי לא הרגשת בזה."
  },
  {
   "start": 978.91,
   "end": 980.35,
   "text": "לאט לאט החלו כולם"
  },
  {
   "start": 980.87,
   "end": 984.77,
   "text": "להכיר בנס המיוחד שמתרחש לנגד עיניהם."
  },
  {
   "start": 985.35,
   "end": 987.09,
   "text": "הקוזקים לא מבינים, הם יורים!"
  },
  {
   "start": 987.65,
   "end": 987.99,
   "text": "ואיש לא נפגע."
  },
  {
   "start": 989.51,
   "end": 990.07,
   "text": "ויהודים,"
  },
  {
   "start": 990.99,
   "end": 992.01,
   "text": "הלב מתרונן,"
  },
  {
   "start": 993.27,
   "end": 994.09,
   "text": "מצד שני,"
  },
  {
   "start": 994.89,
   "end": 995.25,
   "text": "כופה מפחד."
  },
  {
   "start": 1009.04,
   "end": 1009.58,
   "text": "והרב,"
  },
  {
   "start": 1030.68,
   "end": 1031.7,
   "text": "והרב עומד,"
  },
  {
   "start": 1032.72,
   "end": 1033.96,
   "text": "עיניו עצומות,"
  },
  {
   "start": 1034.88,
   "end": 1036.56,
   "text": "שפתיו מתנועעות"
  },
  {
   "start": 1037.16,
   "end": 1038.44,
   "text": "וידיו פרושות."
  },
  {
   "start": 1039.88,
   "end": 1041.96,
   "text": "כל-כולו מחובר לשם."
  },
  {
   "start": 1042.6,
   "end": 1044.06,
   "text": "אלפי כדורים מסביב,"
  },
  {
   "start": 1044.86,
   "end": 1046.02,
   "text": "והוא נמצא במקום אחר."
  },
  {
   "start": 1050.9,
   "end": 1051.32,
   "text": "אבל אז,"
  },
  {
   "start": 1054.32,
   "end": 1056.58,
   "text": "אבל אז קרה הבלצי צפוי."
  },
  {
   "start": 1061.91,
   "end": 1063.13,
   "text": "הבת של רבי שלמה מקרלין"
  },
  {
   "start": 1064.03,
   "end": 1065.27,
   "text": "צרחה לאבא, אבא!"
  },
  {
   "start": 1065.87,
   "end": 1067.27,
   "text": "אבא תיזהר, אבא!"
  },
  {
   "start": 1069.6,
   "end": 1071.8,
   "text": "והזעקה הזאת חדרה,"
  },
  {
   "start": 1072.72,
   "end": 1074.78,
   "text": "ולשנייה, אולי שבריר שנייה,"
  },
  {
   "start": 1075.94,
   "end": 1079.16,
   "text": "נותק רבי שלמה מקרלין מדבקותו בשם יתברך."
  },
  {
   "start": 1082.09,
   "end": 1082.45,
   "text": "ואז,"
  },
  {
   "start": 1084.65,
   "end": 1085.57,
   "text": "באותה שנייה,"
  },
  {
   "start": 1086.71,
   "end": 1087.45,
   "text": "הרד גורל."
  },
  {
   "start": 1088.89,
   "end": 1089.23,
   "text": "בחלון,"
  },
  {
   "start": 1089.97,
   "end": 1091.73,
   "text": "שם בחלון ניצב לו מפקד הקוזאקים."
  },
  {
   "start": 1092.93,
   "end": 1094.73,
   "text": "אינו מאמין למה שמתרחש לנגד עיניו."
  },
  {
   "start": 1096.07,
   "end": 1097.03,
   "text": "הוא הרים את הרובה שלו."
  },
  {
   "start": 1098.57,
   "end": 1099.49,
   "text": "היה לו רובה מיוחד."
  },
  {
   "start": 1100.27,
   "end": 1101.15,
   "text": "רובה קצוץ-זקנה."
  },
  {
   "start": 1102.11,
   "end": 1103.21,
   "text": "רובה צייד קצוץ-זקנה."
  },
  {
   "start": 1103.83,
   "end": 1104.35,
   "text": "פגיעה"
  },
  {
   "start": 1105.25,
   "end": 1106.75,
   "text": "מרסקת עצמות."
  },
  {
   "start": 1107.37,
   "end": 1108.25,
   "text": "הוא כיוון אל הרב,"
  },
  {
   "start": 1113.34,
   "end": 1116.68,
   "text": "ובאותה שנייה שהרב נותק מהדבקות בשם,"
  },
  {
   "start": 1121.31,
   "end": 1123.67,
   "text": "האצבע סחטה את ההדק."
  },
  {
   "start": 1124.53,
   "end": 1127.77,
   "text": "ומטען של עופרת רב עוצמה יצא."
  },
  {
   "start": 1136.78,
   "end": 1139.22,
   "text": "גופו של הרב נרתע כמעט."
  },
  {
   "start": 1140.62,
   "end": 1141.64,
   "text": "אבל הוא נותר עומד"
  },
  {
   "start": 1147.38,
   "end": 1148.26,
   "text": "באותה שנייה."
  },
  {
   "start": 1149.54,
   "end": 1150.28,
   "text": "איבד המפקד,"
  },
  {
   "start": 1151.22,
   "end": 1154.3,
   "text": "מפקד הקוזאקי, את שיווי משקלו ונפל מהסוס שלו."
  },
  {
   "start": 1154.86,
   "end": 1157.74,
   "text": "הסוס שהיה מאולף, שהיה נאמן לו שנים."
  },
  {
   "start": 1158.52,
   "end": 1161.04,
   "text": "והסוס הזה החל משתולל, ללא שום סיבה,"
  },
  {
   "start": 1161.66,
   "end": 1163.48,
   "text": "כשהוא רומס את הקוזאקי"
  },
  {
   "start": 1164.6,
   "end": 1165.02,
   "text": "למוות."
  },
  {
   "start": 1167.75,
   "end": 1169.71,
   "text": "הרוצח הגדול,"
  },
  {
   "start": 1170.57,
   "end": 1171.11,
   "text": "מפקד הקוזאקים,"
  },
  {
   "start": 1174.26,
   "end": 1176.54,
   "text": "מצא את מותו בידי סוסו האהוב."
  },
  {
   "start": 1178.44,
   "end": 1179.68,
   "text": "דקות מספר אחר כך"
  },
  {
   "start": 1180.28,
   "end": 1180.66,
   "text": "נעלמו הקוזאקים,"
  },
  {
   "start": 1182.2,
   "end": 1184.36,
   "text": "משאירים אחריהם הרס וחורבן,"
  },
  {
   "start": 1193.14,
   "end": 1194.48,
   "text": "ואת המפקד שלהם,"
  },
  {
   "start": 1195.22,
   "end": 1196.68,
   "text": "את הגופה שלו הם השאירו מאחור."
  },
  {
   "start": 1242.23,
   "end": 1243.05,
   "text": "יהודי העיירה,"
  },
  {
   "start": 1244.09,
   "end": 1245.03,
   "text": "יהודי לודמיר,"
  },
  {
   "start": 1245.85,
   "end": 1247.35,
   "text": "ניצלו מפגיעה בגופם."
  },
  {
   "start": 1250.3,
   "end": 1251.82,
   "text": "כל מי שהיה בבית המדרש,"
  },
  {
   "start": 1252.5,
   "end": 1260.69,
   "text": "כל מי שהייתה בבית המדרש אפילו לא נשרטו לבד מאחד."
  },
  {
   "start": 1262.39,
   "end": 1266.17,
   "text": "הצדיק רבי שלמה מקרלינג שנותר עומד"
  },
  {
   "start": 1267.21,
   "end": 1268.63,
   "text": "גם כשכתם של דם"
  },
  {
   "start": 1269.63,
   "end": 1271.47,
   "text": "התפשט לו בגופו."
  },
  {
   "start": 1276.03,
   "end": 1278.31,
   "text": "רק כשנעלמו להם הרוצחים,"
  },
  {
   "start": 1280.29,
   "end": 1281.61,
   "text": "אז כאילו הרשה לעצמו."
  },
  {
   "start": 1284.28,
   "end": 1285.24,
   "text": "אז נפל הצדיק"
  },
  {
   "start": 1286.5,
   "end": 1287.48,
   "text": "ומתבוסס בדמו."
  },
  {
   "start": 1292.1,
   "end": 1293.96,
   "text": "חמישה ימים שכב במיטתו,"
  },
  {
   "start": 1297.43,
   "end": 1298.51,
   "text": "אפוף כאבים."
  },
  {
   "start": 1299.83,
   "end": 1302.55,
   "text": "כל המאמצים להציל אותו עולים בתוהו."
  },
  {
   "start": 1303.13,
   "end": 1304.33,
   "text": "לא הצליחו לעצור את"
  },
  {
   "start": 1304.93,
   "end": 1307.71,
   "text": "זרימת הדם הבלתי פוסקת מהגוף שלו."
  },
  {
   "start": 1309.15,
   "end": 1309.39,
   "text": "והוא,"
  },
  {
   "start": 1310.41,
   "end": 1312.01,
   "text": "בשעות בהן היה בהכרה,"
  },
  {
   "start": 1313.31,
   "end": 1313.85,
   "text": "היה לומד"
  },
  {
   "start": 1314.89,
   "end": 1315.93,
   "text": "קצת זוהר קדוש,"
  },
  {
   "start": 1316.67,
   "end": 1317.35,
   "text": "קצת גמרא,"
  },
  {
   "start": 1318.01,
   "end": 1318.81,
   "text": "עם הייסורים,"
  },
  {
   "start": 1319.71,
   "end": 1320.41,
   "text": "עם הכאבים."
  },
  {
   "start": 1320.93,
   "end": 1321.89,
   "text": "היה מתפלל השם,"
  },
  {
   "start": 1322.75,
   "end": 1323.55,
   "text": "עם הייסורים."
  },
  {
   "start": 1324.13,
   "end": 1324.83,
   "text": "עם הכאבים,"
  },
  {
   "start": 1338.28,
   "end": 1339.1,
   "text": "ביום החמישי,"
  },
  {
   "start": 1340.8,
   "end": 1341.76,
   "text": "כב בתמוז,"
  },
  {
   "start": 1346.55,
   "end": 1347.57,
   "text": "לפתח חיוך רחב"
  },
  {
   "start": 1348.35,
   "end": 1349.63,
   "text": "התפשט על פניו הכאובות,"
  },
  {
   "start": 1351.01,
   "end": 1352.07,
   "text": "והרבי החל לומר,"
  },
  {
   "start": 1352.99,
   "end": 1353.81,
   "text": "וינתלם,"
  },
  {
   "start": 1354.47,
   "end": 1356.25,
   "text": "וינסאם כי מעולם,"
  },
  {
   "start": 1357.03,
   "end": 1357.95,
   "text": "וינתלם,"
  },
  {
   "start": 1358.59,
   "end": 1360.23,
   "text": "וינסאם כי מעולם."
  },
  {
   "start": 1361.69,
   "end": 1362.03,
   "text": "ואז,"
  },
  {
   "start": 1362.73,
   "end": 1364.37,
   "text": "כאילו נפתחו שערי השמיים,"
  },
  {
   "start": 1365.63,
   "end": 1366.39,
   "text": "וינתלם,"
  },
  {
   "start": 1366.93,
   "end": 1368.29,
   "text": "וינסאם כי מעולם,"
  },
  {
   "start": 1368.93,
   "end": 1371.19,
   "text": "ונשמתו עלתה בסערה השמיימה."
  },
  {
   "start": 1372.01,
   "end": 1374.51,
   "text": "פועלם נטל את הנשמה ונשא אותה"
  },
  {
   "start": 1375.19,
   "end": 1375.75,
   "text": "מעלה-מעלה."
  },
  {
   "start": 1376.71,
   "end": 1377.67,
   "text": "רבי שלמה מקרלין,"
  },
  {
   "start": 1378.41,
   "end": 1379.95,
   "text": "בן 54 במותו,"
  },
  {
   "start": 1383.15,
   "end": 1386.29,
   "text": "נקבר בחלקת הקבר שהוא כל כך רצה,"
  },
  {
   "start": 1386.97,
   "end": 1390.43,
   "text": "חלקת קבר שמתאימה למקדשי שמו יתברך,"
  },
  {
   "start": 1391.23,
   "end": 1391.95,
   "text": "כמו שהוא אמר,"
  },
  {
   "start": 1392.71,
   "end": 1393.41,
   "text": "כמו שהוא רצה."
  },
  {
   "start": 1395.17,
   "end": 1396.43,
   "text": "וזמן מה אחר כך"
  },
  {
   "start": 1396.43,
   "end": 1402.59,
   "text": "נפתרה תעלומת בואו של רבי אריה לייבסארס."
  },
  {
   "start": 1404.45,
   "end": 1410.25,
   "text": "אז הבינו כל יהודי לודמיר שהצדיק רבי אריה לייבסארס"
  },
  {
   "start": 1411.15,
   "end": 1411.97,
   "text": "בא להתפלל,"
  },
  {
   "start": 1412.67,
   "end": 1415.89,
   "text": "להרעיש עולמות עליונים ולהציל את נפשו של הרב."
  },
  {
   "start": 1417.81,
   "end": 1418.41,
   "text": "והרב,"
  },
  {
   "start": 1419.11,
   "end": 1421.75,
   "text": "רבי שלמה מקרלין, השם ייקום דמו,"
  },
  {
   "start": 1422.43,
   "end": 1428.03,
   "text": "ביקש ממנו לא להתערב כדי שהוא יוכל לזכות לקדש את שמו יתברך."
  },
  {
   "start": 1429.77,
   "end": 1431.01,
   "text": "רבי שלמה מקרלי,"
  },
  {
   "start": 1431.63,
   "end": 1434.51,
   "text": "נקדש שם שמיים, השם ייקום דמו."
  },
  {
   "start": 1435.89,
   "end": 1437.27,
   "text": "זכרו יגן עלינו, אמן."
  }
 ]
}