{
 "disc": "22נ- מסירות נפש",
 "track": "Track04",
 "duration": 721.176,
 "segments": [
  {
   "start": 9.93,
   "end": 20.96,
   "text": "אתם יודעים, זה היה בברדיצ'וב בתקופתו של סנגורם של ישראל, רבי לוי יצחק מברדיצ'וב."
  },
  {
   "start": 22.14,
   "end": 23.84,
   "text": "יום אחד בא אליו רבי ברוך ממזיבוש."
  },
  {
   "start": 24.24,
   "end": 26.76,
   "text": "רבי ברוך ממזיבוש היה הנכד של הבעל שם טוב."
  },
  {
   "start": 28.14,
   "end": 30.38,
   "text": "בא אליו רבי ברוך ממזיבוש ואומר לו,"
  },
  {
   "start": 31.22,
   "end": 34.54,
   "text": "לרבי לוי יצחק מברדיצ'וב, ואומר לו, תדע לך, כבוד הרב,"
  },
  {
   "start": 35.3,
   "end": 36.66,
   "text": "צריך להרבות בתפילות,"
  },
  {
   "start": 38.14,
   "end": 42.52,
   "text": "כי השנה יש גזרה קשה מאוד על עם ישראל."
  },
  {
   "start": 43.7,
   "end": 45.76,
   "text": "שאם היא תצא לפועל, אוי ואבוי."
  },
  {
   "start": 46.8,
   "end": 48.14,
   "text": "רבי לוי יצחק מברדיצ'וב"
  },
  {
   "start": 49.58,
   "end": 50.88,
   "text": "יצא לרחובות העיר."
  },
  {
   "start": 51.94,
   "end": 55.34,
   "text": "קטרוג גדול על עם ישראל, מה הוא יעשה? איך אפשר לבטל את זה?"
  },
  {
   "start": 55.68,
   "end": 57.22,
   "text": "והוא מסתובב ברחובות ברדיצ'וב,"
  },
  {
   "start": 57.74,
   "end": 61.38,
   "text": "מתפלל השם בעולם, תאיר לי דרך, תאיר לי בורא עולם דרך."
  },
  {
   "start": 62.34,
   "end": 63.66,
   "text": "דרך שאני אוכל לפעול בה,"
  },
  {
   "start": 64.18,
   "end": 66.84,
   "text": "להיטיב עם הבנים שלך, עם הבנים הנפלאים שלך."
  },
  {
   "start": 68.36,
   "end": 70.26,
   "text": "ולפתע, תוך כדי שככה שהוא מדבר אל השם,"
  },
  {
   "start": 71.24,
   "end": 71.76,
   "text": "פתאום הוא רואה"
  },
  {
   "start": 71.76,
   "end": 77.32,
   "text": "איזה ניצוץ של אור מבליח לו בחשיכה מאחד הבתים,"
  },
  {
   "start": 77.88,
   "end": 80.44,
   "text": "או יותר נכון מאחד הצריפים בפאתי האיוברדיצ'וב."
  },
  {
   "start": 82.48,
   "end": 83.32,
   "text": "הוא אמר, אם האור הזה"
  },
  {
   "start": 85.4,
   "end": 86.2,
   "text": "מעיר לי כך,"
  },
  {
   "start": 87.72,
   "end": 88.16,
   "text": "כנראה"
  },
  {
   "start": 89.48,
   "end": 91.0,
   "text": "מעולם רוצה שאני אלך לשם,"
  },
  {
   "start": 91.86,
   "end": 92.92,
   "text": "והוא הולך אל כיוון האור."
  },
  {
   "start": 94.52,
   "end": 95.84,
   "text": "והוא נעצר ליד צריף,"
  },
  {
   "start": 96.6,
   "end": 97.4,
   "text": "מט ליפול,"
  },
  {
   "start": 98.22,
   "end": 99.06,
   "text": "דופק בדלת."
  },
  {
   "start": 100.46,
   "end": 101.62,
   "text": "אז נפתחה לה הדלת,"
  },
  {
   "start": 101.76,
   "end": 104.36,
   "text": "ויצאה אישה"
  },
  {
   "start": 106.18,
   "end": 107.08,
   "text": "והאישה נרעדה"
  },
  {
   "start": 108.54,
   "end": 110.1,
   "text": "היא הייתה בטוחה שהרב בא להעיר לה"
  },
  {
   "start": 110.94,
   "end": 113.92,
   "text": "להגיד לה על משהו, אז הסתכלה, אמרה הרב"
  },
  {
   "start": 119.5,
   "end": 121.58,
   "text": "את העונש שלי כבר קיבלתי"
  },
  {
   "start": 122.6,
   "end": 124.26,
   "text": "האם אני לא כיפרתי מספיק?"
  },
  {
   "start": 127.85,
   "end": 128.75,
   "text": "והרב מסתכל"
  },
  {
   "start": 147.41,
   "end": 148.07,
   "text": "והאישה הבינה"
  },
  {
   "start": 150.17,
   "end": 153.25,
   "text": "שאולי הרב לא מבין על מה היא מדברת, אמרה הרב"
  },
  {
   "start": 154.11,
   "end": 156.51,
   "text": "אתה יודע הרב, כשאני הייתי בן בת 17"
  },
  {
   "start": 157.85,
   "end": 158.97,
   "text": "גרתי הרחק מכאן,"
  },
  {
   "start": 161.9,
   "end": 164.24,
   "text": "וכשהייתי בת 17, אבא ואימא"
  },
  {
   "start": 165.18,
   "end": 165.92,
   "text": "נפטרו בתאונה."
  },
  {
   "start": 168.34,
   "end": 169.7,
   "text": "איבדתי את שניהם ביום אחד,"
  },
  {
   "start": 170.84,
   "end": 173.74,
   "text": "וישבתי שבעה והייתי כל כך עצובה,"
  },
  {
   "start": 174.6,
   "end": 175.98,
   "text": "וכשנגמרו ימי האבל,"
  },
  {
   "start": 176.72,
   "end": 178.16,
   "text": "לא ידעתי מה אני עושה בעולם,"
  },
  {
   "start": 179.4,
   "end": 182.94,
   "text": "אבל דבר אחד ידעתי, לאבא יש מחלבה."
  },
  {
   "start": 185.04,
   "end": 186.02,
   "text": "אותה אני יודעת להפעיל."
  },
  {
   "start": 187.0,
   "end": 189.2,
   "text": "הזמן שנשאר זה רק ללכת לפריץ המקומי,"
  },
  {
   "start": 189.68,
   "end": 190.98,
   "text": "ולקבל ממנו שכירות."
  },
  {
   "start": 192.02,
   "end": 195.42,
   "text": "אולי הוא יסכים לתת לי את זה במחיר קצת בהנחה, כדי שאני אוכל להסתדר,"
  },
  {
   "start": 196.08,
   "end": 197.42,
   "text": "ואוכל להתפרנס מהמחלבה,"
  },
  {
   "start": 198.22,
   "end": 199.76,
   "text": "ולחיות קצת ברווחה."
  },
  {
   "start": 201.4,
   "end": 202.1,
   "text": "והלכתי,"
  },
  {
   "start": 203.0,
   "end": 204.34,
   "text": "הלכתי אל אותו פריץ,"
  },
  {
   "start": 206.92,
   "end": 208.16,
   "text": "ונכנסתי בפנים,"
  },
  {
   "start": 210.39,
   "end": 211.45,
   "text": "ואותו פריץ,"
  },
  {
   "start": 213.13,
   "end": 214.05,
   "text": "הוא מדבר איתי,"
  },
  {
   "start": 214.71,
   "end": 216.91,
   "text": "והוא לא מסיר את העיניים מהשיער שלי,"
  },
  {
   "start": 217.63,
   "end": 219.53,
   "text": "אותו שיער שגידלתי שנים,"
  },
  {
   "start": 220.23,
   "end": 225.61,
   "text": "אותו שיער שאימא הייתה מסרקת אותי במשך שעות בערב שבת."
  },
  {
   "start": 243.5,
   "end": 244.1,
   "text": "ולפתע,"
  },
  {
   "start": 245.04,
   "end": 245.72,
   "text": "תוך כדי דיבור,"
  },
  {
   "start": 246.68,
   "end": 249.86,
   "text": "תוך כדי שאני מסבירה לו שאני צריכה את המחלבה,"
  },
  {
   "start": 250.36,
   "end": 253.08,
   "text": "שאני זקוקה לה, שנשארתי לבד בעולם,"
  },
  {
   "start": 254.56,
   "end": 255.4,
   "text": "הוא אומר לי, תראי,"
  },
  {
   "start": 256.9,
   "end": 261.33,
   "text": "אם תיתני לי לנגוע לך בשיער,"
  },
  {
   "start": 266.76,
   "end": 268.56,
   "text": "אני אתן לך לשלם רק חצי מחיר"
  },
  {
   "start": 269.18,
   "end": 270.06,
   "text": "על המחלבה."
  },
  {
   "start": 270.9,
   "end": 273.66,
   "text": "ואני נותרתי קפואה, מבולבלת,"
  },
  {
   "start": 274.42,
   "end": 275.38,
   "text": "ילדה בת 17,"
  },
  {
   "start": 276.0,
   "end": 276.52,
   "text": "מה אני עושה?"
  },
  {
   "start": 278.3,
   "end": 279.3,
   "text": "מה קורה לי?"
  },
  {
   "start": 281.06,
   "end": 282.4,
   "text": "והוא לא חיכה הרבה, הוא התקרב,"
  },
  {
   "start": 284.34,
   "end": 285.82,
   "text": "ואז לפתע נתעוררתי,"
  },
  {
   "start": 286.88,
   "end": 290.68,
   "text": "כמו מתוך חלום בלהות, מה אני עושה?"
  },
  {
   "start": 292.18,
   "end": 293.66,
   "text": "ותוך שנייה זינקתי החוצה,"
  },
  {
   "start": 294.26,
   "end": 294.5,
   "text": "ורצתי,"
  },
  {
   "start": 295.22,
   "end": 295.72,
   "text": "וברחתי,"
  },
  {
   "start": 296.32,
   "end": 297.94,
   "text": "ורצתי, וברחתי."
  },
  {
   "start": 299.52,
   "end": 301.0,
   "text": "כל הלילה אני רצה,"
  },
  {
   "start": 302.3,
   "end": 304.32,
   "text": "שעות אני רצה להגיע הביתה."
  },
  {
   "start": 308.7,
   "end": 310.28,
   "text": "אל הפריץ הגעתי בעגלה,"
  },
  {
   "start": 311.12,
   "end": 313.16,
   "text": "וכל הלילה אני רצה להגיע הביתה,"
  },
  {
   "start": 313.82,
   "end": 316.34,
   "text": "להתרחק כמו בורחת מהאש."
  },
  {
   "start": 317.7,
   "end": 318.84,
   "text": "עד שהגעתי אל הבית,"
  },
  {
   "start": 319.64,
   "end": 321.74,
   "text": "סגרתי את הדלת אחריי חזק חזק."
  },
  {
   "start": 323.24,
   "end": 325.26,
   "text": "נשארתי בבית והתחלתי לבכות"
  },
  {
   "start": 326.14,
   "end": 326.88,
   "text": "ולבכות."
  },
  {
   "start": 328.88,
   "end": 329.8,
   "text": "מה פתאום נתתי לו?"
  },
  {
   "start": 331.08,
   "end": 332.14,
   "text": "לנקוע לי בשיער"
  },
  {
   "start": 334.75,
   "end": 335.87,
   "text": "ואת שארית הלילה."
  },
  {
   "start": 337.33,
   "end": 337.83,
   "text": "בכיתי,"
  },
  {
   "start": 338.77,
   "end": 339.99,
   "text": "בכיתי ובכיתי."
  },
  {
   "start": 343.18,
   "end": 343.96,
   "text": "בבוקר קמתי,"
  },
  {
   "start": 345.68,
   "end": 347.36,
   "text": "ועם החלטה נחושה בלב"
  },
  {
   "start": 348.76,
   "end": 349.74,
   "text": "הלכתי למגירה,"
  },
  {
   "start": 350.6,
   "end": 351.72,
   "text": "הוצאתי מספריים,"
  },
  {
   "start": 352.8,
   "end": 356.12,
   "text": "והתחלתי לגזור את השיער."
  },
  {
   "start": 356.92,
   "end": 364.14,
   "text": "את השיער שגידלתי שנים התחלתי לגזור ולגזור ולגזור."
  },
  {
   "start": 370.54,
   "end": 372.76,
   "text": "אחר כך לקחתי את כל החפצים שלי,"
  },
  {
   "start": 373.44,
   "end": 374.6,
   "text": "החפצים האישיים,"
  },
  {
   "start": 375.56,
   "end": 378.54,
   "text": "ועזבתי את המחלבה,"
  },
  {
   "start": 379.88,
   "end": 384.05,
   "text": "ועזבתי את הגינה שהיה לנו,"
  },
  {
   "start": 385.03,
   "end": 388.87,
   "text": "ועזבתי את הבית, את הבית שלי שנותר לי,"
  },
  {
   "start": 389.95,
   "end": 393.71,
   "text": "ולקחתי את מעט החפצים האישיים, הרסתי אותם בתיק קטן,"
  },
  {
   "start": 394.97,
   "end": 395.91,
   "text": "ויצאתי משם,"
  },
  {
   "start": 397.43,
   "end": 398.45,
   "text": "מאותו כפר."
  },
  {
   "start": 400.19,
   "end": 401.09,
   "text": "יצאתי והלכתי."
  },
  {
   "start": 402.61,
   "end": 405.17,
   "text": "הלכתי והלכתי עד שהגעתי לברדיצ'ו,"
  },
  {
   "start": 406.47,
   "end": 413.15,
   "text": "וכאן בעיר ברדיצ'וב הלכתי והזכרתי את עצמי למשרתת"
  },
  {
   "start": 413.91,
   "end": 414.89,
   "text": "בבית של יהודים"
  },
  {
   "start": 415.85,
   "end": 417.75,
   "text": "ועבדתי כמשרתת שנים"
  },
  {
   "start": 418.57,
   "end": 419.89,
   "text": "תמורת שכר זעום"
  },
  {
   "start": 424.08,
   "end": 426.6,
   "text": "במקום להיות בת"
  },
  {
   "start": 427.76,
   "end": 431.82,
   "text": "שמנהלת מחלבה שאולי מסודרת כלכלית."
  },
  {
   "start": 434.03,
   "end": 439.21,
   "text": "חיי היו קשים אבל לרגע לא הצטערתי ואחרי זה חיתנו אותי"
  },
  {
   "start": 441.55,
   "end": 442.73,
   "text": "עם יתום עני,"
  },
  {
   "start": 443.73,
   "end": 444.83,
   "text": "וחיינו בקשיים."
  },
  {
   "start": 445.77,
   "end": 449.17,
   "text": "ואתה רואה, כבוד הרב, הנה, זה הצריף,"
  },
  {
   "start": 449.79,
   "end": 450.61,
   "text": "פה אנחנו חיים."
  },
  {
   "start": 452.93,
   "end": 456.41,
   "text": "הבעל שלי נפטר לא מזמן, ואני אלמנה לבד."
  },
  {
   "start": 458.07,
   "end": 459.69,
   "text": "והרב כולו אחוז התרגשות."
  },
  {
   "start": 461.71,
   "end": 462.99,
   "text": "מביט בה בהתפעלות,"
  },
  {
   "start": 464.33,
   "end": 465.23,
   "text": "ואומר לה, תגידי לי,"
  },
  {
   "start": 465.97,
   "end": 467.17,
   "text": "בת ישראל חשובה."
  },
  {
   "start": 467.91,
   "end": 476.02,
   "text": "תגידי לי, בת ישראל קדושה, מה עשית עם השיער?"
  },
  {
   "start": 476.82,
   "end": 484.21,
   "text": "אמרה לו בת ישראל,"
  },
  {
   "start": 485.29,
   "end": 486.83,
   "text": "אמרה לו אותה אישה,"
  },
  {
   "start": 489.39,
   "end": 490.03,
   "text": "כבוד הרב,"
  },
  {
   "start": 490.99,
   "end": 493.75,
   "text": "את השיער זרקתי לפח"
  },
  {
   "start": 496.32,
   "end": 499.22,
   "text": "מיטלטל אחד שהשארתי."
  },
  {
   "start": 501.24,
   "end": 503.16,
   "text": "אתה יודע למה הרב השארתי אותו?"
  },
  {
   "start": 504.4,
   "end": 505.14,
   "text": "כי כל השנים,"
  },
  {
   "start": 506.1,
   "end": 507.08,
   "text": "כשקשה לי,"
  },
  {
   "start": 507.82,
   "end": 508.8,
   "text": "כשכואב לי,"
  },
  {
   "start": 509.68,
   "end": 511.76,
   "text": "כשבכי מתפרץ מתוכי,"
  },
  {
   "start": 512.56,
   "end": 513.74,
   "text": "אני רצה על הבית."
  },
  {
   "start": 514.98,
   "end": 516.54,
   "text": "ומוציאה את הטלטל,"
  },
  {
   "start": 517.66,
   "end": 519.6,
   "text": "מוציאה את הטלטל הזה שהשארתי,"
  },
  {
   "start": 520.54,
   "end": 523.8,
   "text": "ומסתכלת ואומרת בורא עולם אתה צודק,"
  },
  {
   "start": 524.64,
   "end": 525.26,
   "text": "בורא עולם"
  },
  {
   "start": 526.32,
   "end": 529.76,
   "text": "שווה לי כל מה שקשה לי, כל הצער,"
  },
  {
   "start": 530.34,
   "end": 531.36,
   "text": "כל הכאב,"
  },
  {
   "start": 531.92,
   "end": 533.22,
   "text": "שווה לי הכל,"
  },
  {
   "start": 533.8,
   "end": 534.74,
   "text": "וכככה כל פעם"
  },
  {
   "start": 535.58,
   "end": 537.48,
   "text": "אני מתחזקת מהטלטל הזה,"
  },
  {
   "start": 537.96,
   "end": 540.84,
   "text": "אני מוציאה אותו והוא נותן לי כל כך כוח,"
  },
  {
   "start": 541.34,
   "end": 547.92,
   "text": "ואני יודעת שהשם יתברך צודק וכל כך כדאי לי הכל ובלבד להישאר יהודייה כשרה."
  },
  {
   "start": 550.34,
   "end": 553.64,
   "text": "רבי לוי יצחק מברדיצ'וב יצא החוצה"
  },
  {
   "start": 555.22,
   "end": 558.38,
   "text": "בדמעות נשא עיניים"
  },
  {
   "start": 559.36,
   "end": 562.62,
   "text": "אל השמיים ואמר ריבונו של עולם,"
  },
  {
   "start": 563.5,
   "end": 564.88,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 565.62,
   "end": 568.0,
   "text": "אם יש כף מאזניים בשמיים"
  },
  {
   "start": 568.98,
   "end": 573.32,
   "text": "וישימו את הגזירה של עם ישראל על כף אחת."
  },
  {
   "start": 575.62,
   "end": 580.56,
   "text": "ובכף השנייה ישימו את הטלטל של אותה יהודייה,"
  },
  {
   "start": 581.18,
   "end": 583.54,
   "text": "של אותה בת ישראל צדקת."
  },
  {
   "start": 584.44,
   "end": 587.06,
   "text": "ריבונו של עולם, אין לי ספק,"
  },
  {
   "start": 587.68,
   "end": 590.66,
   "text": "אין לי ספק מי יכריע את הכף"
  },
  {
   "start": 591.3,
   "end": 592.88,
   "text": "ויבטל את הגזירה."
  },
  {
   "start": 602.08,
   "end": 603.76,
   "text": "והגזירה בוטלה."
  },
  {
   "start": 605.0,
   "end": 606.38,
   "text": "והגזירה בוטלה."
  },
  {
   "start": 617.07,
   "end": 620.69,
   "text": "בא בורא עולם ואומר לנו,"
  },
  {
   "start": 624.05,
   "end": 625.81,
   "text": "תדעו לכם, בניי בנותיי,"
  },
  {
   "start": 628.61,
   "end": 630.59,
   "text": "שלא פעם לאורך ההיסטוריה היהודית,"
  },
  {
   "start": 632.07,
   "end": 634.71,
   "text": "אנחנו, עם ישראל, היינו מעטים כנגד רבים,"
  },
  {
   "start": 635.41,
   "end": 636.41,
   "text": "ותמיד ניצחנו."
  },
  {
   "start": 640.06,
   "end": 644.2,
   "text": "הסוד הזה של מעטים כנגד רבים זה לא רק במלחמות."
  },
  {
   "start": 645.56,
   "end": 649.4,
   "text": "הסוד הזה של המעטים כנגד רבים זה גם"
  },
  {
   "start": 649.4,
   "end": 651.36,
   "text": "בתוכנו,"
  },
  {
   "start": 653.43,
   "end": 654.41,
   "text": "כאשר באנו,"
  },
  {
   "start": 655.11,
   "end": 656.51,
   "text": "יש לפעמים מעטים,"
  },
  {
   "start": 657.15,
   "end": 659.63,
   "text": "מעט מעשים טובים,"
  },
  {
   "start": 660.09,
   "end": 661.03,
   "text": "מעט אור,"
  },
  {
   "start": 661.55,
   "end": 662.53,
   "text": "מעט טוב,"
  },
  {
   "start": 663.07,
   "end": 664.47,
   "text": "והרבה הרבה חושך,"
  },
  {
   "start": 665.03,
   "end": 666.37,
   "text": "והרבה הרבה חטאים."
  },
  {
   "start": 667.39,
   "end": 672.49,
   "text": "אבל בא בורא עולם ואומר, בניי היקרים, בנותיי החשובות,"
  },
  {
   "start": 675.16,
   "end": 678.52,
   "text": "המעטים ניצחו את הרבים,"
  },
  {
   "start": 679.28,
   "end": 681.7,
   "text": "המעטים ינצחו את הרבים,"
  },
  {
   "start": 682.2,
   "end": 683.7,
   "text": "המעט מעשים טובים,"
  },
  {
   "start": 684.38,
   "end": 687.54,
   "text": "המעט אור שיש לכל אחד ואחת,"
  },
  {
   "start": 690.18,
   "end": 691.42,
   "text": "הם ינצחו."
  },
  {
   "start": 692.56,
   "end": 695.08,
   "text": "אני אדאג לנס כמו נס חנוכה,"
  },
  {
   "start": 695.5,
   "end": 697.46,
   "text": "כמו נס מלחמת ששת הימים,"
  },
  {
   "start": 697.8,
   "end": 699.52,
   "text": "כמו נס מלחמת המפרץ,"
  },
  {
   "start": 701.24,
   "end": 705.24,
   "text": "כמו כל הניסים שקרו לעם ישראל בכל הזמנים."
  },
  {
   "start": 706.42,
   "end": 709.08,
   "text": "והמעטים שבתוכנו,"
  },
  {
   "start": 709.68,
   "end": 712.46,
   "text": "המעשים הטובים, ינצחו,"
  },
  {
   "start": 713.16,
   "end": 714.22,
   "text": "יזככו,"
  },
  {
   "start": 714.96,
   "end": 720.12,
   "text": "יעלו את היהודים בכל אתר, בכל מקום שהם נמצאים."
  }
 ]
}