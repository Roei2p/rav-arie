{
 "disc": "22נ- מסירות נפש",
 "track": "Track01",
 "duration": 192.168,
 "segments": [
  {
   "start": 0.54,
   "end": 21.64,
   "text": "אומר רבי אברהם גורז'ינסקי, בעל ספר תורת אברהם,"
  },
  {
   "start": 24.9,
   "end": 25.58,
   "text": "שאם מישהו,"
  },
  {
   "start": 26.38,
   "end": 27.74,
   "text": "אם עם ישראל רוצה,"
  },
  {
   "start": 30.07,
   "end": 33.83,
   "text": "רוצה לדעת למה קורים הדברים כמו שהם קורים."
  },
  {
   "start": 34.73,
   "end": 37.19,
   "text": "אז פעם כשהיו צרות היו הולכים לנביא,"
  },
  {
   "start": 37.57,
   "end": 40.35,
   "text": "היו שואלים את הנביאים, את הנביאים, הייתה תקופת הנביאים כשאתה בא לנביא,"
  },
  {
   "start": 41.01,
   "end": 41.83,
   "text": "את באה לנביא,"
  },
  {
   "start": 42.33,
   "end": 43.97,
   "text": "שואלים, יש לי בעיה כזאת וכזאת,"
  },
  {
   "start": 44.83,
   "end": 45.21,
   "text": "למה זה?"
  },
  {
   "start": 46.05,
   "end": 47.11,
   "text": "והנביא היה אומר בדיוק,"
  },
  {
   "start": 48.39,
   "end": 50.47,
   "text": "היום אין לנו נביאים."
  },
  {
   "start": 51.31,
   "end": 52.55,
   "text": "אומר התורת אברהם,"
  },
  {
   "start": 53.21,
   "end": 56.51,
   "text": "היום הצרות שלנו אלו הנביאים."
  },
  {
   "start": 57.31,
   "end": 60.51,
   "text": "אם אתה רוצה לדעת, אם את רוצה לדעת, למה?"
  },
  {
   "start": 60.99,
   "end": 62.47,
   "text": "למה כל כך אנחנו קשה לנו?"
  },
  {
   "start": 63.65,
   "end": 66.23,
   "text": "למה יש בזמן האחרון כל כך הרבה קשיים?"
  },
  {
   "start": 68.82,
   "end": 70.24,
   "text": "תסתכל על הקשיים,"
  },
  {
   "start": 70.84,
   "end": 72.08,
   "text": "תסתכלי על הקשיים,"
  },
  {
   "start": 72.52,
   "end": 76.08,
   "text": "ומכאן תדעי בורא העולם רוצה לרמוז לנו בקשיים, בצרות,"
  },
  {
   "start": 76.62,
   "end": 77.44,
   "text": "בכאבים,"
  },
  {
   "start": 77.8,
   "end": 79.14,
   "text": "במה אנחנו לקויים."
  },
  {
   "start": 79.98,
   "end": 84.9,
   "text": "אז אם אנחנו רואים שיש אנשים שמוכנים להתאבד בשביל לגרום לנו לנזקים,"
  },
  {
   "start": 85.8,
   "end": 88.48,
   "text": "להילחם בנו למרות שהם נפצעים להמשיך להילחם,"
  },
  {
   "start": 91.17,
   "end": 91.87,
   "text": "מוכנים למות,"
  },
  {
   "start": 92.41,
   "end": 94.59,
   "text": "מוכנים למסור את הנפש שלהם כדי להזיק לנו,"
  },
  {
   "start": 96.03,
   "end": 98.57,
   "text": "אנחנו צריכים לדעת שבורא העולם רומז לנו,"
  },
  {
   "start": 99.07,
   "end": 102.93,
   "text": "שחסר לנו היום, שאנחנו צריכים להתחזק היום הרבה הרבה,"
  },
  {
   "start": 103.39,
   "end": 104.05,
   "text": "שזה אולי"
  },
  {
   "start": 105.09,
   "end": 109.49,
   "text": "היעד שלנו מספר אחד, למסור נפש לכבוד השם יתברך,"
  },
  {
   "start": 110.47,
   "end": 112.77,
   "text": "למסור נפש לבנות עולם."
  },
  {
   "start": 113.97,
   "end": 116.55,
   "text": "האויב מוסר נפש להרוס עולם."
  },
  {
   "start": 117.57,
   "end": 120.43,
   "text": "היהודי, היהודייה צריכים למסור נפש לבנות עולם."
  },
  {
   "start": 121.97,
   "end": 124.21,
   "text": "היום צריך מסירות נפש לתורה."
  },
  {
   "start": 125.57,
   "end": 126.69,
   "text": "מסירות נפש לצניעות."
  },
  {
   "start": 127.67,
   "end": 133.05,
   "text": "כשבת ישראל הולכת בצניעות היא מוסרת נפש. צריך מסירות נפש כדי להיות צנועה."
  },
  {
   "start": 135.15,
   "end": 136.49,
   "text": "היום יש כל כך הרבה חוסר."
  },
  {
   "start": 137.87,
   "end": 138.95,
   "text": "חוסר משווע."
  },
  {
   "start": 139.79,
   "end": 143.57,
   "text": "בעוד מצוות, בעוד מצוות, שהעולם יתמלא כולו מצוות."
  },
  {
   "start": 144.05,
   "end": 146.43,
   "text": "צריך למסור נפש על מצוות. היו בחורים צעירים,"
  },
  {
   "start": 147.05,
   "end": 147.75,
   "text": "בחורות צעירות,"
  },
  {
   "start": 148.39,
   "end": 149.27,
   "text": "מוסרים נפש"
  },
  {
   "start": 150.45,
   "end": 152.41,
   "text": "למען מצוות השם יתברך."
  },
  {
   "start": 153.75,
   "end": 154.73,
   "text": "צריך להצטרף אליהם."
  },
  {
   "start": 155.67,
   "end": 156.53,
   "text": "צריך להצטרף אליהם."
  },
  {
   "start": 159.09,
   "end": 161.77,
   "text": "מעטים כנגד רבים תמיד היה כך עם ישראל."
  },
  {
   "start": 162.67,
   "end": 165.59,
   "text": "המעט אור ניצח את החושך."
  },
  {
   "start": 166.31,
   "end": 167.53,
   "text": "היה הרבה חושך בעולם."
  },
  {
   "start": 168.07,
   "end": 173.22,
   "text": "באו אותם מעטים יהודים וסילקו."
  },
  {
   "start": 174.12,
   "end": 174.9,
   "text": "סילקו את החושך."
  },
  {
   "start": 176.36,
   "end": 177.58,
   "text": "אז בואו בעזרת השם היום."
  },
  {
   "start": 178.26,
   "end": 182.08,
   "text": "היום אנחנו מדברים על כל הדברים האלה, על כל המכלול הזה של להיות יהודי"
  },
  {
   "start": 183.12,
   "end": 184.36,
   "text": "במסירות נפש."
  },
  {
   "start": 184.78,
   "end": 187.34,
   "text": "היום הנושא שלנו הוא מסירות נפש."
  },
  {
   "start": 188.42,
   "end": 189.94,
   "text": "מסירות נפש."
  }
 ]
}