{
 "disc": "10י- יהודי יחודי",
 "track": "Track01",
 "duration": 773.184,
 "segments": [
  {
   "start": 17.99,
   "end": 19.25,
   "text": "רבי יצחק בעל שם"
  },
  {
   "start": 20.31,
   "end": 21.23,
   "text": "ממיכלשטט."
  },
  {
   "start": 23.15,
   "end": 23.37,
   "text": "ילד,"
  },
  {
   "start": 24.51,
   "end": 25.57,
   "text": "כשהיה עדיין ילד,"
  },
  {
   "start": 27.96,
   "end": 32.22,
   "text": "נודע שמו בכל הארץ כילד חכם ונבון,"
  },
  {
   "start": 36.23,
   "end": 36.69,
   "text": "שמע עליו."
  },
  {
   "start": 37.35,
   "end": 40.67,
   "text": "אז הזמין את הילד היהודי לטהות על קנקנו,"
  },
  {
   "start": 42.21,
   "end": 44.19,
   "text": "והוא מוזמן לטירה של הדוכס."
  },
  {
   "start": 45.23,
   "end": 46.17,
   "text": "הוא נכנס פנימה,"
  },
  {
   "start": 46.91,
   "end": 49.53,
   "text": "והוא מוצא את עצמו במבוך."
  },
  {
   "start": 49.53,
   "end": 49.97,
   "text": "מבוך."
  },
  {
   "start": 51.33,
   "end": 51.75,
   "text": "גינה,"
  },
  {
   "start": 54.16,
   "end": 54.58,
   "text": "דשא,"
  },
  {
   "start": 55.18,
   "end": 55.46,
   "text": "ירק,"
  },
  {
   "start": 56.6,
   "end": 58.28,
   "text": "צמחיה שופעת מכל הכיוונים,"
  },
  {
   "start": 58.78,
   "end": 60.64,
   "text": "אבל הכל מסודר בצורה מופתית."
  },
  {
   "start": 64.04,
   "end": 67.28,
   "text": "ולאן שתלך אתה מוצא את עצמך בתוך מבוך של שבילים."
  },
  {
   "start": 68.5,
   "end": 70.92,
   "text": "הוא פוגש אנשים משרתים, שואל אותם,"
  },
  {
   "start": 71.58,
   "end": 74.32,
   "text": "היכן נמצא הדוכס, אבל איש מהם לא עונה לו."
  },
  {
   "start": 75.86,
   "end": 77.76,
   "text": "ואז הוא הולך, מנסה להסתדר בכוחות עצמו."
  },
  {
   "start": 80.21,
   "end": 81.73,
   "text": "ואז הוא מבחין ששם,"
  },
  {
   "start": 82.87,
   "end": 83.43,
   "text": "קצת רחוק,"
  },
  {
   "start": 84.27,
   "end": 85.13,
   "text": "יש חלון."
  },
  {
   "start": 86.87,
   "end": 90.49,
   "text": "לא כמו כל הבתים הקטנים עם החלונות שאורים מסביב,"
  },
  {
   "start": 90.97,
   "end": 91.53,
   "text": "יש שם חלון,"
  },
  {
   "start": 92.25,
   "end": 93.69,
   "text": "ולחלון היה וילון."
  },
  {
   "start": 95.21,
   "end": 97.27,
   "text": "אמר רבי יצחק בעל שם מיכלשטט,"
  },
  {
   "start": 97.83,
   "end": 98.61,
   "text": "ילד יהודי,"
  },
  {
   "start": 99.81,
   "end": 100.83,
   "text": "ילד יהודי חכם,"
  },
  {
   "start": 108.2,
   "end": 109.94,
   "text": "מי יכול באמת להרשות לעצמו"
  },
  {
   "start": 111.48,
   "end": 112.78,
   "text": "שהוא יראה את כולם,"
  },
  {
   "start": 113.54,
   "end": 115.24,
   "text": "ואם הוא רוצה אף אחד לא יראה אותו,"
  },
  {
   "start": 116.3,
   "end": 117.38,
   "text": "רק מי ששולט על הכול."
  },
  {
   "start": 119.04,
   "end": 119.78,
   "text": "בורא עולם,"
  },
  {
   "start": 121.16,
   "end": 121.6,
   "text": "ברור עולם,"
  },
  {
   "start": 122.18,
   "end": 123.38,
   "text": "הוא יכול להסתיר את עצמו,"
  },
  {
   "start": 124.08,
   "end": 126.72,
   "text": "שאף אחד לא יראה אותו, אבל הוא רואה את כל אחד ואחד."
  },
  {
   "start": 128.34,
   "end": 130.48,
   "text": "הוא גם יודע את המחשבות של כל אחד ואחד."
  },
  {
   "start": 131.24,
   "end": 132.14,
   "text": "אז אם יש פה מישהו,"
  },
  {
   "start": 132.78,
   "end": 134.16,
   "text": "בטירה הזאת, בבית הזה,"
  },
  {
   "start": 134.66,
   "end": 136.7,
   "text": "שהוא כאן בעולם הזה אחראי על הטירה,"
  },
  {
   "start": 137.46,
   "end": 139.16,
   "text": "ויש לו קצת בעלות על הטירה,"
  },
  {
   "start": 139.94,
   "end": 140.88,
   "text": "הוא היחיד שיכול"
  },
  {
   "start": 142.28,
   "end": 144.74,
   "text": "ליצור מצב שמהחלון הוא יראה את כולם,"
  },
  {
   "start": 145.5,
   "end": 147.12,
   "text": "אבל הווילון יסתיר אותו מעין כולם."
  },
  {
   "start": 147.4,
   "end": 150.44,
   "text": "זה החלום, זה הבית של אדוכס."
  },
  {
   "start": 150.9,
   "end": 153.28,
   "text": "והוא שם את פעמיו ומגיע לשם."
  },
  {
   "start": 154.7,
   "end": 155.38,
   "text": "והוא לא טועה."
  },
  {
   "start": 156.4,
   "end": 157.78,
   "text": "הוא לא טועה, הוא דופק בדלת."
  },
  {
   "start": 159.28,
   "end": 161.68,
   "text": "פותחים לו את הדלת והוא מוצא את עצמו מול אדוכס."
  },
  {
   "start": 163.66,
   "end": 166.48,
   "text": "ואדוכס מחייך, שואל אותו, תגיד לי, איך מצאת את הדרך אליי?"
  },
  {
   "start": 169.04,
   "end": 169.96,
   "text": "ואז הוא מספר לו."
  },
  {
   "start": 172.2,
   "end": 175.32,
   "text": "מחייך אדוכס, ואומר לו, תגיד לי, ילד יהודי."
  },
  {
   "start": 176.84,
   "end": 178.0,
   "text": "ואם היית שואל,"
  },
  {
   "start": 179.36,
   "end": 180.44,
   "text": "אם היית שואל,"
  },
  {
   "start": 180.72,
   "end": 181.98,
   "text": "את המשרתים שלי."
  },
  {
   "start": 183.22,
   "end": 184.58,
   "text": "וכולם היו מטעים אותך?"
  },
  {
   "start": 185.24,
   "end": 188.88,
   "text": "אם אני הייתי דואג, אומר לכולם, כל אחד יאמר לך על כיוון שונה."
  },
  {
   "start": 189.6,
   "end": 191.36,
   "text": "כל אחד יאמר לך על כיוון שונה."
  },
  {
   "start": 191.98,
   "end": 192.6,
   "text": "מה היית עושה?"
  },
  {
   "start": 193.3,
   "end": 194.46,
   "text": "הרי כולם היו מטעים אותך."
  },
  {
   "start": 199.92,
   "end": 200.26,
   "text": "חייך"
  },
  {
   "start": 201.16,
   "end": 203.54,
   "text": "רבי יצחק בעל שם ממיכלשטט ואמר לו,"
  },
  {
   "start": 204.2,
   "end": 205.32,
   "text": "הייתי הולך על פי הרוב."
  },
  {
   "start": 209.54,
   "end": 212.28,
   "text": "חייך חזרה הדוכס ואמר לו, תגיד לי ילד יהודי,"
  },
  {
   "start": 214.18,
   "end": 215.6,
   "text": "היית הולך על פי הרוב?"
  },
  {
   "start": 215.96,
   "end": 216.62,
   "text": "אומר לו, כן."
  },
  {
   "start": 217.52,
   "end": 220.64,
   "text": "אתה תמיד הולך ככה לפי הרוב? אומר לו, צריך ללכת לפי הרוב."
  },
  {
   "start": 221.9,
   "end": 223.4,
   "text": "חייך הדוכס ואמר לו, ילד,"
  },
  {
   "start": 224.24,
   "end": 226.46,
   "text": "אם כך, מדוע אתה יהודי?"
  },
  {
   "start": 227.68,
   "end": 229.0,
   "text": "רוב העולם לא יהודי."
  },
  {
   "start": 231.02,
   "end": 232.18,
   "text": "רוב העולם זה גויין."
  },
  {
   "start": 233.0,
   "end": 234.22,
   "text": "למה אתה הולך על פי הרוב?"
  },
  {
   "start": 241.72,
   "end": 243.22,
   "text": "אמר לו רבי יצחק בעל שם."
  },
  {
   "start": 243.98,
   "end": 245.16,
   "text": "אמר לו הילד המופלא הזה."
  },
  {
   "start": 248.28,
   "end": 250.06,
   "text": "דוכס, כבוד הדוכס,"
  },
  {
   "start": 251.0,
   "end": 252.78,
   "text": "כשאני בא לכאן ואני לא יודע,"
  },
  {
   "start": 253.4,
   "end": 255.5,
   "text": "ואני לא יודע היכן נמצא חדר הדוכס,"
  },
  {
   "start": 256.38,
   "end": 257.28,
   "text": "אז אני בא ושואל,"
  },
  {
   "start": 259.3,
   "end": 260.62,
   "text": "וכשעונים לי תשובות,"
  },
  {
   "start": 261.48,
   "end": 262.54,
   "text": "אז אני אלך על פי הרוב."
  },
  {
   "start": 263.56,
   "end": 265.76,
   "text": "אבל עכשיו, כשאני כבר יודע,"
  },
  {
   "start": 266.5,
   "end": 268.28,
   "text": "כבר יודע היכן נמצא הדוכס,"
  },
  {
   "start": 269.3,
   "end": 274.68,
   "text": "אז גם אם כל המשרתים יאמרו לי, יצביעו לי על כיוון אחר, על חדר אחר,"
  },
  {
   "start": 275.88,
   "end": 278.36,
   "text": "אני לא אשמע להם, כי אני יודע את האמת."
  },
  {
   "start": 283.73,
   "end": 284.79,
   "text": "אותו דבר הדוכס,"
  },
  {
   "start": 285.79,
   "end": 286.59,
   "text": "כך גם עם היהדות."
  },
  {
   "start": 289.62,
   "end": 291.76,
   "text": "כשאני לא יודע, אם לא הייתי יודע את האמת,"
  },
  {
   "start": 292.72,
   "end": 294.42,
   "text": "זה אחרת."
  },
  {
   "start": 296.1,
   "end": 296.26,
   "text": "אבל,"
  },
  {
   "start": 297.24,
   "end": 298.46,
   "text": "אבל כבוד הדוכס,"
  },
  {
   "start": 299.2,
   "end": 300.66,
   "text": "אמר רבי יצחק בעל שם,"
  },
  {
   "start": 302.06,
   "end": 302.72,
   "text": "כך עם היהדות,"
  },
  {
   "start": 304.26,
   "end": 306.88,
   "text": "אני יודע שהיהדות זו האמת,"
  },
  {
   "start": 307.58,
   "end": 308.78,
   "text": "שיש בורא עולם,"
  },
  {
   "start": 310.06,
   "end": 311.94,
   "text": "שמשה קיבל תורה מסיני."
  },
  {
   "start": 312.64,
   "end": 315.42,
   "text": "ועכשיו, כשאני כבר יודע את האמת,"
  },
  {
   "start": 316.24,
   "end": 318.58,
   "text": "גם אם כל העולם יהיו מצד אחד,"
  },
  {
   "start": 319.16,
   "end": 322.64,
   "text": "גם אם כל העולם יאמרו לי וילכו לצד אחד,"
  },
  {
   "start": 323.32,
   "end": 328.28,
   "text": "אני אהיה בצד השני עם האמת ועם ריבונו של עולם."
  },
  {
   "start": 333.97,
   "end": 337.67,
   "text": "והדוכס יתפעל מהילד ושלח אותו לשלום."
  },
  {
   "start": 340.03,
   "end": 341.11,
   "text": "יהודי יהודייה,"
  },
  {
   "start": 342.29,
   "end": 345.17,
   "text": "יהודי זה מלשון ייחודי,"
  },
  {
   "start": 346.09,
   "end": 346.77,
   "text": "מיוחד."
  },
  {
   "start": 347.43,
   "end": 350.37,
   "text": "כל אחד מאיתנו צריך לדעת כמה אנחנו מיוחדים."
  },
  {
   "start": 352.88,
   "end": 354.6,
   "text": "כמה אנחנו מיוחדים."
  },
  {
   "start": 355.46,
   "end": 358.9,
   "text": "השורש של עם ישראל הוא מאברהם העברי, זה אבי האומה העברית."
  },
  {
   "start": 359.42,
   "end": 360.92,
   "text": "למה הוא נקרא אברהם העברי?"
  },
  {
   "start": 361.34,
   "end": 365.44,
   "text": "כי בתקופה שלו כל העולם היה בעבר אחד של העולם,"
  },
  {
   "start": 365.76,
   "end": 366.86,
   "text": "של השקפת החיים,"
  },
  {
   "start": 367.7,
   "end": 368.8,
   "text": "של דרך החיים."
  },
  {
   "start": 369.22,
   "end": 373.7,
   "text": "ואברהם אבינו לבד, כנגד כל העולם, הוא הולך עם האמת."
  },
  {
   "start": 374.8,
   "end": 375.84,
   "text": "הוא הולך עם האמת,"
  },
  {
   "start": 376.44,
   "end": 378.14,
   "text": "והוא מנצח והוא מצליח."
  },
  {
   "start": 379.16,
   "end": 380.78,
   "text": "כי הוא הולך עם ריבונו של עולם."
  },
  {
   "start": 386.8,
   "end": 389.72,
   "text": "יהודי יכול להגיע לפסגות הגדולות ביותר. אתה,"
  },
  {
   "start": 390.28,
   "end": 393.86,
   "text": "כולנו יחד יכולים להגיע לפסגות הגדולות ביותר,"
  },
  {
   "start": 394.26,
   "end": 397.04,
   "text": "כאשר אנחנו מממשים את עצמנו, אנחנו."
  },
  {
   "start": 398.89,
   "end": 401.71,
   "text": "אתם יודעים, עם ישראל ממש מזעזע, עם ישראל."
  },
  {
   "start": 402.47,
   "end": 404.45,
   "text": "עם ישראל לפני חטא העגל."
  },
  {
   "start": 406.17,
   "end": 407.65,
   "text": "איזה דרגה רוחנית הוא היה,"
  },
  {
   "start": 408.31,
   "end": 412.03,
   "text": "שהוא ראה את כבוד השם, אש אוכלת, בהר סיני,"
  },
  {
   "start": 413.05,
   "end": 414.27,
   "text": "ולא היה בעיה."
  },
  {
   "start": 414.83,
   "end": 417.23,
   "text": "כולם הסתכלו, דרגות של נבואה לכל אחד."
  },
  {
   "start": 417.69,
   "end": 420.61,
   "text": "ואחרי החטא,"
  },
  {
   "start": 421.33,
   "end": 421.99,
   "text": "חטא העגל,"
  },
  {
   "start": 422.99,
   "end": 425.43,
   "text": "רק כי ירד משה רבנו, לא כבוד השם,"
  },
  {
   "start": 425.81,
   "end": 427.61,
   "text": "לא כאש אוכלת בראש הר סיני,"
  },
  {
   "start": 428.09,
   "end": 428.77,
   "text": "משה רבנו,"
  },
  {
   "start": 429.27,
   "end": 430.61,
   "text": "אור פניו קורן,"
  },
  {
   "start": 431.57,
   "end": 432.73,
   "text": "והם מפחדים ממנו,"
  },
  {
   "start": 433.25,
   "end": 435.19,
   "text": "לא יכלו להתקרב אליו פחד פחדים,"
  },
  {
   "start": 436.73,
   "end": 439.95,
   "text": "כי החטא הוריד את עם ישראל עד לכך שהם מפחדים"
  },
  {
   "start": 441.33,
   "end": 445.67,
   "text": "מאור פניו של משה שהקרין להם קדושה."
  },
  {
   "start": 447.33,
   "end": 448.95,
   "text": "ולמה הם חטאו בחטא העגל?"
  },
  {
   "start": 449.85,
   "end": 450.81,
   "text": "עקרון העדר."
  },
  {
   "start": 452.93,
   "end": 458.11,
   "text": "משה רבנו לא בא, קצת בלבול, רצים אחרי כולם, בהלה, עדר."
  },
  {
   "start": 460.54,
   "end": 465.1,
   "text": "כאשר בעולם צועק יהודי, אתה ייחודי, יהודיית מיוחדת!"
  },
  {
   "start": 466.9,
   "end": 471.8,
   "text": "את לא יכולה להיות כמו כולם, את לא יכולה להיות כמו כל העולם, כי את יהודיית, הבת שלי,"
  },
  {
   "start": 476.78,
   "end": 481.64,
   "text": "בת של אחד יחיד ומיוחד, גם היא צריכה להיות מיוחדת, בן של אחד יחיד ומיוחד צריך להיות מיוחד."
  },
  {
   "start": 482.28,
   "end": 483.18,
   "text": "וכך גם היום,"
  },
  {
   "start": 483.72,
   "end": 487.54,
   "text": "גם היום יש לנו התמודדות גדולה מאוד מול עקרון העדר, גם היום."
  },
  {
   "start": 488.5,
   "end": 489.18,
   "text": "גם היום."
  },
  {
   "start": 490.52,
   "end": 491.64,
   "text": "וגם היום צריך לדעת,"
  },
  {
   "start": 502.02,
   "end": 502.86,
   "text": "גם היום."
  },
  {
   "start": 503.9,
   "end": 506.4,
   "text": "גם היום מתפוצצת לה הנשמה של היהודי,"
  },
  {
   "start": 506.72,
   "end": 508.14,
   "text": "מבעד לכל המסכים,"
  },
  {
   "start": 509.14,
   "end": 515.16,
   "text": "מבעד לכל החושך שהיא נמצאת ומגלה מדי פעם את הנשמה הטהורה שנתת בי,"
  },
  {
   "start": 515.82,
   "end": 516.84,
   "text": "את הייחודיות שלה,"
  },
  {
   "start": 517.54,
   "end": 519.26,
   "text": "את היופי המקסים שלה,"
  },
  {
   "start": 520.0,
   "end": 522.72,
   "text": "של עם ישראל כולו, של כל יהודי ויהודייה."
  },
  {
   "start": 523.46,
   "end": 524.96,
   "text": "כל יהודי ויהודייה."
  },
  {
   "start": 540.48,
   "end": 541.36,
   "text": "לפני זמן לא רב"
  },
  {
   "start": 543.54,
   "end": 544.22,
   "text": "הייתה מסיבה,"
  },
  {
   "start": 547.08,
   "end": 547.72,
   "text": "באיזה יום?"
  },
  {
   "start": 548.3,
   "end": 549.5,
   "text": "לצערנו הרב, ביום השבת."
  },
  {
   "start": 551.5,
   "end": 552.12,
   "text": "מסיבה באילת,"
  },
  {
   "start": 553.24,
   "end": 555.34,
   "text": "שהוזמנו אליה אלפי בני נוער"
  },
  {
   "start": 556.1,
   "end": 558.26,
   "text": "ששילמו ממיטב כספם."
  },
  {
   "start": 559.84,
   "end": 564.0,
   "text": "נוער שקרוב-טרוב זמנו מבלה במסיבות."
  },
  {
   "start": 564.78,
   "end": 568.24,
   "text": "נוער שכל השבוע מחכה למסיבה של סוף השבוע."
  },
  {
   "start": 572.85,
   "end": 574.99,
   "text": "סיפר אחד מאותם באים של המסיבה."
  },
  {
   "start": 576.39,
   "end": 580.09,
   "text": "הם נסעו לאילת, אנשים הגיעו מצפון הארץ,"
  },
  {
   "start": 580.09,
   "end": 588.49,
   "text": "נסעו לדרום הארץ מחיפה לאילת מגיעים אחרי שהם שילמו כרטיס ואחרי שהם נסעו את כל הדרך מגיעים לשם"
  },
  {
   "start": 591.06,
   "end": 596.04,
   "text": "הוא מספר כולם מתקדמים לפתע הם נכנסים והם נעצרים"
  },
  {
   "start": 597.26,
   "end": 599.78,
   "text": "המומים מסתובבים חזרה והולכים"
  },
  {
   "start": 600.46,
   "end": 601.68,
   "text": "אחד אחרי השני"
  },
  {
   "start": 602.52,
   "end": 603.78,
   "text": "אחת אחרי השנייה"
  },
  {
   "start": 606.67,
   "end": 611.73,
   "text": "והוא אומר אני לא מבין מה קורה פה כולם יוצאים נכנסים לפתע נעצרים באמצע"
  },
  {
   "start": 612.57,
   "end": 616.89,
   "text": "הלם, מסתובבים וחוזרים חזרה, לא יכולים להיכנס."
  },
  {
   "start": 617.77,
   "end": 618.83,
   "text": "כאילו משהו חוסם אותם."
  },
  {
   "start": 620.67,
   "end": 623.35,
   "text": "ואז הגיע התור שלי, הוא מספר, אני מתקדם, כך הוא סיפר,"
  },
  {
   "start": 624.13,
   "end": 624.73,
   "text": "מתקדם."
  },
  {
   "start": 625.67,
   "end": 627.25,
   "text": "ואז אני מגיע לאותה נקודה,"
  },
  {
   "start": 628.27,
   "end": 629.51,
   "text": "ונעצר גם אני."
  },
  {
   "start": 630.59,
   "end": 633.17,
   "text": "למול עיניי התנוסס לו שם עגל,"
  },
  {
   "start": 634.95,
   "end": 637.47,
   "text": "עגל מצופה זהב,"
  },
  {
   "start": 638.29,
   "end": 639.65,
   "text": "שעשו מארגני המסיבה."
  },
  {
   "start": 643.27,
   "end": 646.61,
   "text": "הם החליטו לשים עגל במרכז שם, עגל מצופה זהב."
  },
  {
   "start": 647.67,
   "end": 651.67,
   "text": "וכשאני ראיתי את העגל, נזכרתי בתורה."
  },
  {
   "start": 653.41,
   "end": 655.91,
   "text": "זאת שאולי אני רחוק ממנה, כך מספר אותו אחד,"
  },
  {
   "start": 656.61,
   "end": 657.89,
   "text": "אבל עגל, אני לא,"
  },
  {
   "start": 658.51,
   "end": 660.59,
   "text": "אני לא רוצה לעשות את חטא העגל שנית."
  },
  {
   "start": 661.79,
   "end": 664.31,
   "text": "נעצרתי, כמו כל החברים לפניכם,"
  },
  {
   "start": 664.75,
   "end": 671.93,
   "text": "כמו כל אותם בני נוער שרחוקים מתורה ומצוות, אבל משהו בנשמה אומר להם, אל תתקרבו, זה לא,"
  },
  {
   "start": 672.43,
   "end": 673.81,
   "text": "זה לא טוב, זה לא רצון השם."
  },
  {
   "start": 674.87,
   "end": 675.81,
   "text": "הסתובבתי חזרה"
  },
  {
   "start": 677.91,
   "end": 679.19,
   "text": "ולא העזתי להיכנס,"
  },
  {
   "start": 680.67,
   "end": 682.87,
   "text": "וכמו אלפי בני נוער חזרתי חזרה."
  },
  {
   "start": 683.99,
   "end": 688.67,
   "text": "למסיבה הזאת שהייתה מתוכנית היו מוזמנים כבר, הגיעו אלפי בני נוער"
  },
  {
   "start": 690.43,
   "end": 691.55,
   "text": "בודדים"
  },
  {
   "start": 693.09,
   "end": 695.45,
   "text": "אפשר לספור אותם על יד אחת, שתי ידיים."
  },
  {
   "start": 696.57,
   "end": 698.47,
   "text": "בני הנוער שהיו בפנים, זה הכל."
  },
  {
   "start": 699.33,
   "end": 701.25,
   "text": "המסיבה הזאת נעצרה."
  },
  {
   "start": 702.43,
   "end": 704.39,
   "text": "הכוח היהודי, נשמה טהורה,"
  },
  {
   "start": 705.25,
   "end": 706.13,
   "text": "אפילו כבר בשבת,"
  },
  {
   "start": 707.15,
   "end": 710.33,
   "text": "אפילו שהכול הכול מכוון לעבר הטומאה,"
  },
  {
   "start": 710.95,
   "end": 717.45,
   "text": "פתאום אתה מגיע ואתה רואה לפתע איך המסכים יורדים ומתגלה,"
  },
  {
   "start": 717.87,
   "end": 719.25,
   "text": "מתגלה עם ישראל הנפלא,"
  },
  {
   "start": 719.71,
   "end": 720.97,
   "text": "עם ישראל הקדוש,"
  },
  {
   "start": 721.49,
   "end": 722.55,
   "text": "עם ישראל שלנו."
  },
  {
   "start": 723.03,
   "end": 723.81,
   "text": "ואז אתה יודע,"
  },
  {
   "start": 724.21,
   "end": 728.31,
   "text": "ואז אנחנו כולנו צריכים להתחזק מזה, מה שהיום, עם כל מה שקורה היום,"
  },
  {
   "start": 728.63,
   "end": 729.21,
   "text": "עם כל החושך,"
  },
  {
   "start": 729.75,
   "end": 731.65,
   "text": "עם כל הריחוק, עם הכל, עם הכל,"
  },
  {
   "start": 732.09,
   "end": 733.65,
   "text": "אבל יהודי הוא ייחודי,"
  },
  {
   "start": 734.03,
   "end": 744.31,
   "text": "יהודי הוא משהו מיוחד ואנחנו צריכים לשמור על זה וצריכים לחזק את זה וצריכים להתעודד מזה וצריכים לא להתייאש לדעת שאשרינו שזכינו לעם קדוש כזה,"
  },
  {
   "start": 744.75,
   "end": 745.67,
   "text": "לעם קדוש כזה."
  },
  {
   "start": 746.45,
   "end": 753.03,
   "text": "אז בואו נתעלה מעל הכל, מעל הוויכוחים היומיומיים, מעל הכעסים, מעל הכל, מעל האפריות של היומיום."
  },
  {
   "start": 753.63,
   "end": 754.33,
   "text": "בואו ביחד,"
  },
  {
   "start": 754.73,
   "end": 757.51,
   "text": "בואו ביחד ניתן לנו, לעם ישראל,"
  },
  {
   "start": 757.93,
   "end": 761.01,
   "text": "הזדמנות אמיתית להתקרב לאבא שבשמיים,"
  },
  {
   "start": 761.29,
   "end": 762.25,
   "text": "לדבר אמונה,"
  },
  {
   "start": 767.32,
   "end": 770.2,
   "text": "להיות ייחודי."
  }
 ]
}