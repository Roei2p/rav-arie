{
 "disc": "10י- יהודי יחודי",
 "track": "Track05",
 "duration": 1415.16,
 "segments": [
  {
   "start": 6.02,
   "end": 6.9,
   "text": "פרנקפורט"
  },
  {
   "start": 8.22,
   "end": 10.24,
   "text": "עיר ידועה וגדולה בגרמניה."
  },
  {
   "start": 12.34,
   "end": 13.16,
   "text": "בפרנקפורט"
  },
  {
   "start": 14.22,
   "end": 19.96,
   "text": "הייתה פינה שאליה לא נהגו תושבי העיר להגיע בלי סיבה מיוחדת."
  },
  {
   "start": 21.16,
   "end": 22.36,
   "text": "זה היה הגטו היהודי."
  },
  {
   "start": 23.38,
   "end": 24.96,
   "text": "שם היו מרוכזים כל היהודים."
  },
  {
   "start": 27.52,
   "end": 28.04,
   "text": "ולכן,"
  },
  {
   "start": 28.58,
   "end": 30.22,
   "text": "בואה של הכרכרה המלכותית"
  },
  {
   "start": 30.94,
   "end": 31.88,
   "text": "אל הגטו היהודי,"
  },
  {
   "start": 32.52,
   "end": 34.12,
   "text": "עורר הדים בכל האזור."
  },
  {
   "start": 35.32,
   "end": 38.14,
   "text": "והכרכרה המלכותית נעצרת לה במרכז הגטו."
  },
  {
   "start": 40.41,
   "end": 49.23,
   "text": "וממנה יוצא יורש העצר הנסיך וילהלם,"
  },
  {
   "start": 51.67,
   "end": 57.15,
   "text": "יורש העצר הצעיר בלוויית יועץ המלך, יועצו של אביו המלך."
  },
  {
   "start": 58.79,
   "end": 60.33,
   "text": "אבא של וילהלם, המלך,"
  },
  {
   "start": 60.85,
   "end": 64.39,
   "text": "שלח את הבן שלו להכיר מקרוב את הגטו היהודי."
  },
  {
   "start": 65.29,
   "end": 67.89,
   "text": "הוא אמר לו, פני לך לשם, יום אחד אתה תהיה מלך."
  },
  {
   "start": 68.87,
   "end": 71.01,
   "text": "כדאי, אתה תשמע הרבה סיפורים על היהודים."
  },
  {
   "start": 71.81,
   "end": 73.65,
   "text": "כדאי שתראה אותם במו עיניך,"
  },
  {
   "start": 74.39,
   "end": 75.59,
   "text": "כדי שכשיבואו אליך,"
  },
  {
   "start": 76.17,
   "end": 78.89,
   "text": "בעתיד שתהיה מלך ויספרו עליהם כל מיני דברים,"
  },
  {
   "start": 79.57,
   "end": 82.95,
   "text": "תדע במה מדובר, תדע לזהות מה אמת, מה שקר."
  },
  {
   "start": 87.06,
   "end": 90.08,
   "text": "וכך הם מוצאים את עצמם במרכז הגטו."
  },
  {
   "start": 92.44,
   "end": 95.74,
   "text": "הנסיך וילהלם פונה ליועץ של ידו ואומר לו, יועץ,"
  },
  {
   "start": 96.36,
   "end": 98.74,
   "text": "מדוע כל כך הרבה מדברים על היהודים?"
  },
  {
   "start": 99.7,
   "end": 101.76,
   "text": "למה מדברים כל כך הרבה על היהודים?"
  },
  {
   "start": 102.24,
   "end": 106.24,
   "text": "כך הוא שואל כשהם פוסעים שניהם יחדיו בגטו הצער."
  },
  {
   "start": 106.88,
   "end": 108.2,
   "text": "כן,"
  },
  {
   "start": 108.86,
   "end": 110.82,
   "text": "נשמע קול, מדברים עלינו הרבה,"
  },
  {
   "start": 111.46,
   "end": 113.86,
   "text": "הרבה שקרים ועלילות מדברים על היהודים,"
  },
  {
   "start": 114.44,
   "end": 116.4,
   "text": "נשמע קול נמרץ מצד ימין."
  },
  {
   "start": 117.42,
   "end": 118.54,
   "text": "הנסיך וילל מסתובב,"
  },
  {
   "start": 119.42,
   "end": 120.32,
   "text": "מולו עומד ילד יהודי,"
  },
  {
   "start": 121.9,
   "end": 123.38,
   "text": "עומד ילד יהודי ומביט בו,"
  },
  {
   "start": 123.96,
   "end": 126.6,
   "text": "כשמעיניו ניבט מבט נחוש,"
  },
  {
   "start": 127.34,
   "end": 127.98,
   "text": "ילד יהודי"
  },
  {
   "start": 128.92,
   "end": 132.74,
   "text": "שגדל בעולם שנושם שנאה ליהודים."
  },
  {
   "start": 134.72,
   "end": 136.38,
   "text": "והנסיך הצעיר יתפלא כל כך"
  },
  {
   "start": 137.1,
   "end": 139.66,
   "text": "למראה האומץ והנחישות שנשמעו מהילד הזה."
  },
  {
   "start": 140.56,
   "end": 143.98,
   "text": "אז הוא שלף מטבע ובהינף יד זרק אותה לעבר הילד."
  },
  {
   "start": 145.82,
   "end": 147.98,
   "text": "הילד היהודי בתנועת יד מהירה תפס אותה"
  },
  {
   "start": 149.04,
   "end": 150.26,
   "text": "עוד במעופה באוויר."
  },
  {
   "start": 151.44,
   "end": 156.0,
   "text": "ניכר היה שמעולם הילד הזה לא אחז במטבע יקרה כל כך."
  },
  {
   "start": 159.19,
   "end": 161.59,
   "text": "הילד היהודי הביט בווילהלם, בנסיך ווילהלם."
  },
  {
   "start": 162.61,
   "end": 165.53,
   "text": "הביט במטבע ואז הוא פנה אל פינת הרחוב,"
  },
  {
   "start": 166.15,
   "end": 169.59,
   "text": "שם עמדו זוג זקנים עניים פושטי יד, קבצנים,"
  },
  {
   "start": 170.77,
   "end": 173.55,
   "text": "והוא נתן להם את המטבע שקיבל."
  },
  {
   "start": 178.59,
   "end": 179.77,
   "text": "ולנסיך וילהלם,"
  },
  {
   "start": 180.77,
   "end": 182.73,
   "text": "לנסיך וילהלם שעמד נדהם,"
  },
  {
   "start": 184.59,
   "end": 185.95,
   "text": "אמר הילד בהתנצלות,"
  },
  {
   "start": 187.87,
   "end": 189.39,
   "text": "אני לא התאמצתי בשביל זה,"
  },
  {
   "start": 190.41,
   "end": 191.15,
   "text": "אז זה לא מגיע לי."
  },
  {
   "start": 198.6,
   "end": 202.48,
   "text": "הנסיך וילהלם לא נתקל מעודו באצילות נפש שכזו."
  },
  {
   "start": 203.62,
   "end": 204.42,
   "text": "איך קוראים לך?"
  },
  {
   "start": 205.24,
   "end": 205.94,
   "text": "קוראים לי מאיר."
  },
  {
   "start": 206.9,
   "end": 209.1,
   "text": "מאיר אנשיל רוטשילד."
  },
  {
   "start": 210.24,
   "end": 211.08,
   "text": "ואיך קוראים לך?"
  },
  {
   "start": 212.26,
   "end": 213.16,
   "text": "שאל הילד היהודי,"
  },
  {
   "start": 214.82,
   "end": 215.8,
   "text": "הנסיך וילהלם."
  },
  {
   "start": 217.2,
   "end": 218.04,
   "text": "הנסיך וילהלם,"
  },
  {
   "start": 218.92,
   "end": 221.3,
   "text": "אתה הנסיך וילהלם, אז מה אתה עושה כאן?"
  },
  {
   "start": 222.16,
   "end": 223.84,
   "text": "כנראה באת לראות את הגטו היהודי."
  },
  {
   "start": 224.92,
   "end": 228.38,
   "text": "אל תלך לבד, כדאי שאני, אני מכיר את הגטו, אני אראה לך את הגטו שלנו."
  },
  {
   "start": 228.8,
   "end": 229.48,
   "text": "זה יקל עליך."
  },
  {
   "start": 231.5,
   "end": 233.8,
   "text": "ומאיר הקטן מתלווה לנסיך והיועץ שלו."
  },
  {
   "start": 238.0,
   "end": 238.84,
   "text": "כך הם מסיירים."
  },
  {
   "start": 240.02,
   "end": 262.77,
   "text": "מצרים בגטו, פעם הסיור."
  },
  {
   "start": 264.57,
   "end": 268.87,
   "text": "כשתם הסיור שוב שלף הנסיך מטבע והגיש למאיר."
  },
  {
   "start": 269.91,
   "end": 272.61,
   "text": "והפעם מאיר לקח את המטבע ואמר תודה,"
  },
  {
   "start": 273.89,
   "end": 275.35,
   "text": "והכניס את המטבע אל הכיס שלו."
  },
  {
   "start": 276.01,
   "end": 276.75,
   "text": "הפעם זה מגיע לי."
  },
  {
   "start": 279.89,
   "end": 281.03,
   "text": "הנסיך התקרב אל מאיר,"
  },
  {
   "start": 283.73,
   "end": 284.73,
   "text": "אחז בכתפיו."
  },
  {
   "start": 285.67,
   "end": 287.97,
   "text": "מאיר, אתה מוצא חן בעיניי."
  },
  {
   "start": 288.59,
   "end": 289.67,
   "text": "אתה מוצא חן בעיניי."
  },
  {
   "start": 290.37,
   "end": 292.19,
   "text": "אם רק תמיר את הדת שלך,"
  },
  {
   "start": 292.61,
   "end": 294.87,
   "text": "אני מבטיח לך שכשאגדל,"
  },
  {
   "start": 295.73,
   "end": 297.51,
   "text": "אני אמנה אותך לשר אצלי."
  },
  {
   "start": 299.35,
   "end": 300.11,
   "text": "אין סיכוי,"
  },
  {
   "start": 303.47,
   "end": 307.31,
   "text": "אין סיכוי, לעולם לא ענה מאיר, בהחלטיות שאינה משתמעת לשני פנים."
  },
  {
   "start": 314.36,
   "end": 315.34,
   "text": "טוב נכנע הנסיך,"
  },
  {
   "start": 315.76,
   "end": 318.08,
   "text": "אבל בכל אופן, אם תצטרך משהו בעתיד,"
  },
  {
   "start": 318.54,
   "end": 319.86,
   "text": "אני מבקש שתפנה אליי."
  },
  {
   "start": 321.74,
   "end": 323.38,
   "text": "תפנה אליי ואני אשתדל לעזור לך."
  },
  {
   "start": 324.18,
   "end": 325.88,
   "text": "אני אשתדל לזכור אותך."
  },
  {
   "start": 329.19,
   "end": 329.63,
   "text": "ומאיר,"
  },
  {
   "start": 330.17,
   "end": 332.05,
   "text": "זה הילד היהודי הקטן מהגטו,"
  },
  {
   "start": 332.77,
   "end": 334.25,
   "text": "גם הוא פנה אל הנסיך וילהלם,"
  },
  {
   "start": 334.87,
   "end": 336.91,
   "text": "ואמר לו בקול רציני ובוטח,"
  },
  {
   "start": 337.57,
   "end": 340.53,
   "text": "גם אתה הנסיך וילהלם, אם תצטרך משהו,"
  },
  {
   "start": 341.85,
   "end": 342.45,
   "text": "תבוא אליי,"
  },
  {
   "start": 343.37,
   "end": 345.67,
   "text": "ואני אשתדל לעזור לך ככל יכולתי."
  },
  {
   "start": 346.85,
   "end": 349.85,
   "text": "אל תשכח, אם יש לך איזו בעיה, תבוא."
  },
  {
   "start": 350.89,
   "end": 352.05,
   "text": "מאיר אנשיל רוטשילד,"
  },
  {
   "start": 352.71,
   "end": 353.81,
   "text": "גטו פרנקפורט,"
  },
  {
   "start": 354.69,
   "end": 355.17,
   "text": "אל תשכח."
  },
  {
   "start": 356.83,
   "end": 358.81,
   "text": "הנסיך ויועץ המלך שהיה איתו התקשו,"
  },
  {
   "start": 359.37,
   "end": 365.73,
   "text": "התקשו להחניק את הצחוק שלהם למשמע התמימות הילדותית של הילד היהודי המדהים שנגלה לעיניהם."
  },
  {
   "start": 370.29,
   "end": 372.09,
   "text": "וכך הם נפרדו לדרכם לשלום."
  },
  {
   "start": 376.74,
   "end": 377.72,
   "text": "שנים אחר כך,"
  },
  {
   "start": 379.58,
   "end": 380.06,
   "text": "רוטשילד,"
  },
  {
   "start": 381.42,
   "end": 382.72,
   "text": "סוחר מצליח,"
  },
  {
   "start": 383.9,
   "end": 385.44,
   "text": "מנהל אפילו בנק קטן,"
  },
  {
   "start": 386.08,
   "end": 387.2,
   "text": "בנק רוטשילד."
  },
  {
   "start": 393.9,
   "end": 394.98,
   "text": "והנסיך וילהלם,"
  },
  {
   "start": 395.56,
   "end": 398.5,
   "text": "הנסיך וילהלם, שמחפש איש מהימן,"
  },
  {
   "start": 399.18,
   "end": 403.78,
   "text": "זוכר אותו, וממנה אותו ליועץ הכספי שלו."
  },
  {
   "start": 405.44,
   "end": 406.88,
   "text": "כך חולפות להם השנים,"
  },
  {
   "start": 408.26,
   "end": 410.54,
   "text": "עד שיום אחד מגיע יומר ונמהר,"
  },
  {
   "start": 411.74,
   "end": 420.2,
   "text": "היום בו האישה מצרפת קם לו קיסר קורסיקאי ושמו נפוליאון בונפרטה,"
  },
  {
   "start": 421.6,
   "end": 425.56,
   "text": "שמתחיל להתקדם בצעדי ענק,"
  },
  {
   "start": 426.3,
   "end": 427.48,
   "text": "שוטף לו את כל אירופה,"
  },
  {
   "start": 429.56,
   "end": 430.82,
   "text": "מאיים לו על כל אירופה."
  },
  {
   "start": 432.28,
   "end": 435.64,
   "text": "יום אחד מגיעה הסכנה, הסכנה הצרפתית הזו,"
  },
  {
   "start": 436.42,
   "end": 439.3,
   "text": "מתדפקת לה על שערי פרנקפורט."
  },
  {
   "start": 442.43,
   "end": 452.2,
   "text": "העיר הגיע באותו יום אל הבית שלו עייף ומותש אחרי שהוא נכנס הביתה."
  },
  {
   "start": 453.12,
   "end": 454.16,
   "text": "פונה אליו הבן שלו, אבא,"
  },
  {
   "start": 454.84,
   "end": 456.3,
   "text": "אבא, יש מישהו זר בפתח,"
  },
  {
   "start": 456.92,
   "end": 457.52,
   "text": "רוצה אותך."
  },
  {
   "start": 458.68,
   "end": 459.76,
   "text": "תאמר להם שיבואו מחר."
  },
  {
   "start": 461.56,
   "end": 462.5,
   "text": "הילד פנה והסתובב,"
  },
  {
   "start": 463.24,
   "end": 464.82,
   "text": "אבל מקץ דקה הוא חוזר, אבא,"
  },
  {
   "start": 465.82,
   "end": 476.54,
   "text": "אבא, האדם שבפתח הוא ביקש לומר לך שהבטחת לו פעם אחת כשהיית ילד שמתי שיצטרך אותך יבוא אל מאיר אנשיל רוטשילד"
  },
  {
   "start": 477.08,
   "end": 484.94,
   "text": "מגטו פרנקפורט והוא השתדל לעזור לו."
  },
  {
   "start": 488.92,
   "end": 489.88,
   "text": "מאיר קפץ ממקומו"
  },
  {
   "start": 490.6,
   "end": 491.68,
   "text": "אל עבר דלת הכניסה,"
  },
  {
   "start": 492.42,
   "end": 495.04,
   "text": "מכניס בבהילות את הזר שראשו היה מכוסה."
  },
  {
   "start": 495.98,
   "end": 497.84,
   "text": "היה זה לא פחות ולא יותר מאשר הנסיך וילהלן."
  },
  {
   "start": 500.02,
   "end": 500.82,
   "text": "אני חייב להימלט מכאן,"
  },
  {
   "start": 502.16,
   "end": 502.86,
   "text": "אומר הנסיך,"
  },
  {
   "start": 504.1,
   "end": 504.98,
   "text": "לפני שנפוליאון"
  },
  {
   "start": 505.56,
   "end": 508.5,
   "text": "נכנס וכובש את העיר, אין לי, אין לי סיכוי נגדו,"
  },
  {
   "start": 509.56,
   "end": 510.64,
   "text": "לחש הנסיך בהתרגשות,"
  },
  {
   "start": 511.28,
   "end": 511.62,
   "text": "מהולה בפחד."
  },
  {
   "start": 514.04,
   "end": 515.6,
   "text": "מה אני יכול לעזור לך, מר רוטשילד?"
  },
  {
   "start": 516.62,
   "end": 517.28,
   "text": "יש לי בקשה ממך."
  },
  {
   "start": 518.54,
   "end": 519.04,
   "text": "נמצא,"
  },
  {
   "start": 519.8,
   "end": 525.32,
   "text": "נמצא כאן באמתחתי צר הכסף והזהב שלי,"
  },
  {
   "start": 526.12,
   "end": 527.3,
   "text": "ומה שאני מבקש,"
  },
  {
   "start": 527.9,
   "end": 529.02,
   "text": "שתשמור לי עליהם."
  },
  {
   "start": 530.6,
   "end": 534.78,
   "text": "אין לי שום אדם שניתן לסמוך עליו, רק אתה."
  },
  {
   "start": 535.16,
   "end": 538.72,
   "text": "אתה יהודי, אתה מקושר אל השם, אל הקדוש ברוך הוא."
  },
  {
   "start": 540.3,
   "end": 543.72,
   "text": "המוסר היהודי עליו אני סומך."
  },
  {
   "start": 545.87,
   "end": 549.07,
   "text": "תשמור לי על הכסף, על האוצר, כדי שאם יום אחד אני אחזור,"
  },
  {
   "start": 549.49,
   "end": 550.43,
   "text": "אני אוכל לקחת אותו."
  },
  {
   "start": 551.69,
   "end": 555.03,
   "text": "אין לי שום אדם שניתן לסמוך עליו, חוץ ממך, מאיר."
  },
  {
   "start": 559.39,
   "end": 560.09,
   "text": "אתה יהודי,"
  },
  {
   "start": 560.57,
   "end": 562.19,
   "text": "אתה מיוחד ואני יודע את זה."
  },
  {
   "start": 563.37,
   "end": 564.05,
   "text": "ורוטשילד נענה,"
  },
  {
   "start": 566.17,
   "end": 566.99,
   "text": "נענה בחיוב,"
  },
  {
   "start": 567.61,
   "end": 570.85,
   "text": "בגלל ההבטחה שלו מאז, שהיו קטנים."
  },
  {
   "start": 571.91,
   "end": 573.13,
   "text": "שעה קלה אחר כך,"
  },
  {
   "start": 573.49,
   "end": 577.35,
   "text": "שעה קלה אחר כך, הנסיך וילהלם יוצא מביתו ונעלם."
  },
  {
   "start": 577.35,
   "end": 584.29,
   "text": "24 שעות אחר כך שוטף צבאו של נפוליאון בונפרטה את פרנקפורט."
  },
  {
   "start": 593.5,
   "end": 594.72,
   "text": "הדפיקות היו רמות,"
  },
  {
   "start": 598.38,
   "end": 603.3,
   "text": "הדפיקות היו מאיימות בפתח ביתו של מאיר עין של רוטשילד."
  },
  {
   "start": 604.28,
   "end": 606.16,
   "text": "שם בפרנקפורט,"
  },
  {
   "start": 606.62,
   "end": 609.46,
   "text": "בפתח ניצבים קציני הצבא הצרפתי."
  },
  {
   "start": 610.94,
   "end": 620.14,
   "text": "אתה מזומן לבוא לנפוליאון, יש לך זימון להגיע לנפוליאון והוא מובל תחת משמר אל נפוליאון."
  },
  {
   "start": 623.01,
   "end": 623.69,
   "text": "לחקירה."
  },
  {
   "start": 624.27,
   "end": 626.17,
   "text": "היכן כספו של הנסיך וילהלם,"
  },
  {
   "start": 627.07,
   "end": 628.07,
   "text": "הנסיך הנעלם,"
  },
  {
   "start": 629.03,
   "end": 630.45,
   "text": "ולפי המידע שיש בידי,"
  },
  {
   "start": 631.15,
   "end": 636.11,
   "text": "אתה האיש שאם הוא יפקיד בידי מישהו את הכסף, זה אצלך."
  },
  {
   "start": 636.71,
   "end": 637.99,
   "text": "היכן כל הכסף שלו?"
  },
  {
   "start": 639.57,
   "end": 640.51,
   "text": "ורוטשילד שותק,"
  },
  {
   "start": 643.18,
   "end": 643.78,
   "text": "הוא יהודי."
  },
  {
   "start": 646.05,
   "end": 647.39,
   "text": "יהודי זה שם, זה אמינות."
  },
  {
   "start": 648.09,
   "end": 649.17,
   "text": "יהודי זה משהו מיוחד."
  },
  {
   "start": 653.44,
   "end": 654.6,
   "text": "הם מבטיחים לו הבטחות,"
  },
  {
   "start": 655.3,
   "end": 656.76,
   "text": "אבל יהודי לא קונים בכסף."
  },
  {
   "start": 657.6,
   "end": 661.22,
   "text": "כשזה לא עוזר, הם מתחילים להפיל עליו לחצים,"
  },
  {
   "start": 661.84,
   "end": 662.5,
   "text": "עינויים."
  },
  {
   "start": 663.88,
   "end": 665.24,
   "text": "ומאיר אינשיל רוטשילד"
  },
  {
   "start": 666.22,
   "end": 668.1,
   "text": "בוחר לו לשתוק."
  },
  {
   "start": 674.25,
   "end": 686.98,
   "text": "החקירה מתארכת, וכל זמן שהוא במעצר,"
  },
  {
   "start": 687.52,
   "end": 688.54,
   "text": "הוא שומר על שתיקה."
  },
  {
   "start": 689.28,
   "end": 690.78,
   "text": "מאיימים על החיים שלו,"
  },
  {
   "start": 691.74,
   "end": 693.82,
   "text": "ומאיר שותק."
  },
  {
   "start": 698.35,
   "end": 699.21,
   "text": "זה משהו מיוחד."
  },
  {
   "start": 700.15,
   "end": 702.43,
   "text": "מבטיחים לו טובות הנאה, הוא לא מוכן."
  },
  {
   "start": 705.25,
   "end": 709.01,
   "text": "יש לו פיקדון, הוא צריך לשמור על זה."
  },
  {
   "start": 711.27,
   "end": 711.67,
   "text": "אבל אז,"
  },
  {
   "start": 712.25,
   "end": 713.93,
   "text": "יום אחד הם פונים אליו ואומרים לו, תדע לך,"
  },
  {
   "start": 714.79,
   "end": 715.29,
   "text": "אם אתה לא,"
  },
  {
   "start": 716.47,
   "end": 717.89,
   "text": "תביא לידינו את כל הכסף."
  },
  {
   "start": 721.22,
   "end": 723.26,
   "text": "כל קהילת היהודים תהיה בסכנה."
  },
  {
   "start": 724.66,
   "end": 727.06,
   "text": "אנחנו נהרוג את כל היהודים, נער ועד זקן,"
  },
  {
   "start": 730.48,
   "end": 731.82,
   "text": "ואיש עוניו שהתרחבו,"
  },
  {
   "start": 732.48,
   "end": 733.42,
   "text": "גילו על הפחד שלו."
  },
  {
   "start": 735.88,
   "end": 737.58,
   "text": "זו הייתה נקודת השבירה של רוטשילד."
  },
  {
   "start": 739.04,
   "end": 741.86,
   "text": "חיי יהודים, ילדים קטנים, נשים, גברים,"
  },
  {
   "start": 742.36,
   "end": 744.38,
   "text": "האחים שלו, האחיות שלו, עם ישראל,"
  },
  {
   "start": 745.0,
   "end": 746.14,
   "text": "יהודי יכול להיפגע."
  },
  {
   "start": 748.69,
   "end": 749.21,
   "text": "והוא נכנע."
  },
  {
   "start": 775.76,
   "end": 777.78,
   "text": "בלווית משמר הוא נכנס אל הבית שלו,"
  },
  {
   "start": 780.09,
   "end": 781.23,
   "text": "מאחורי אחת התמונות."
  },
  {
   "start": 782.63,
   "end": 784.47,
   "text": "הוא מזיז אותה וחושף כספת סודית."
  },
  {
   "start": 785.45,
   "end": 787.47,
   "text": "משם נשלפים כל אוצרות הכסף,"
  },
  {
   "start": 792.4,
   "end": 794.16,
   "text": "והצרפתים הולכים שמחים."
  },
  {
   "start": 795.9,
   "end": 796.66,
   "text": "אבל בורא עולם"
  },
  {
   "start": 797.22,
   "end": 799.0,
   "text": "רואה את המאמץ של הבן שלו."
  },
  {
   "start": 799.92,
   "end": 800.66,
   "text": "אתם יודעים מה קורה?"
  },
  {
   "start": 801.54,
   "end": 804.88,
   "text": "ברחבי אירופה מתפרסם שמו של רוטשילד."
  },
  {
   "start": 805.9,
   "end": 814.78,
   "text": "מתפרסמת עמידתו ההמתנה מול העינויים והלחצים שמפתיע את כל הגויים שאינם רגילים ליושר ואמינות שכזו."
  },
  {
   "start": 815.92,
   "end": 817.54,
   "text": "ואפילו שבסוף, בלית ברירה,"
  },
  {
   "start": 817.96,
   "end": 821.14,
   "text": "נמסר רכושו של הנסיך על מנת להציל את כל חיי היהודים,"
  },
  {
   "start": 821.88,
   "end": 824.58,
   "text": "שמו של רוטשילד נישא בפי כול."
  },
  {
   "start": 826.54,
   "end": 830.56,
   "text": "הקב' ברוך הוא רואה את הבן שלו לא מנצל את הימים הטרופים האלה,"
  },
  {
   "start": 831.46,
   "end": 834.16,
   "text": "ימי הפחד והאימה לגנבת רכוש הנסיך."
  },
  {
   "start": 835.82,
   "end": 837.58,
   "text": "כמו שאולי הרבה גויים היו עושים,"
  },
  {
   "start": 838.08,
   "end": 839.16,
   "text": "אלא מנצל את זה ליושר,"
  },
  {
   "start": 839.82,
   "end": 844.82,
   "text": "לקידוש שם שמיים שכל העולם ידע מה זה יהודי, מה היא מעלת יהודי."
  },
  {
   "start": 848.45,
   "end": 852.37,
   "text": "ולפתע העסקים של רוטשילד מתרחבים,"
  },
  {
   "start": 852.77,
   "end": 856.93,
   "text": "כולם רוצים לבוא ולעשות עסקים עם אדם אמין כל כך."
  },
  {
   "start": 860.64,
   "end": 862.54,
   "text": "שפע נוחת מן השמיים לרוטשילד,"
  },
  {
   "start": 862.98,
   "end": 864.82,
   "text": "ומאות סוחרים פוקדים את הבנק שלו."
  },
  {
   "start": 865.38,
   "end": 867.18,
   "text": "עם סולם ערכים יהודי כזה,"
  },
  {
   "start": 867.56,
   "end": 869.24,
   "text": "כולם מעוניינים לעשות עסקים."
  },
  {
   "start": 869.94,
   "end": 871.24,
   "text": "והעסקים שלו פורחים."
  },
  {
   "start": 877.68,
   "end": 879.22,
   "text": "נפוליאון בונפרטה נפל."
  },
  {
   "start": 880.12,
   "end": 880.4,
   "text": "שם,"
  },
  {
   "start": 881.06,
   "end": 882.3,
   "text": "שם בערבות רוסיה,"
  },
  {
   "start": 882.74,
   "end": 884.56,
   "text": "נכשל המצביא הצרפתי,"
  },
  {
   "start": 885.08,
   "end": 887.82,
   "text": "ואירופה סוף סוף השתחררה מעולו המכביד."
  },
  {
   "start": 903.8,
   "end": 904.6,
   "text": "לפרנקפורט"
  },
  {
   "start": 905.26,
   "end": 906.64,
   "text": "חוזר הנסיר וילהלם"
  },
  {
   "start": 907.34,
   "end": 908.66,
   "text": "מקץ שנות היעדרות."
  },
  {
   "start": 912.36,
   "end": 916.26,
   "text": "קרכרה מלכותית מפלסת את דרכה בגטו היהודים שם,"
  },
  {
   "start": 916.88,
   "end": 917.48,
   "text": "בפרנקפורט."
  },
  {
   "start": 919.74,
   "end": 920.94,
   "text": "זה לא היה מחזה שבשגרה."
  },
  {
   "start": 921.34,
   "end": 924.94,
   "text": "אז כולם נאספים, כולם באים לראות,"
  },
  {
   "start": 925.84,
   "end": 929.96,
   "text": "והכרכרה נעצרת מול ביתו של מאיר אנשיל רוטשילד."
  },
  {
   "start": 931.28,
   "end": 935.58,
   "text": "מן הכרכרה יורד הנסיך וילהלם בכבודו ובעצמו,"
  },
  {
   "start": 936.4,
   "end": 938.22,
   "text": "והוא שם את טעמיו אל ביתו של מאיר."
  },
  {
   "start": 946.83,
   "end": 947.93,
   "text": "כשהדלת נפתחת,"
  },
  {
   "start": 949.39,
   "end": 950.89,
   "text": "הוא שואל, מאיר בבית?"
  },
  {
   "start": 952.61,
   "end": 954.57,
   "text": "והבן של מאיר, זה שפתח את הדלת,"
  },
  {
   "start": 955.33,
   "end": 955.89,
   "text": "אומר לו,"
  },
  {
   "start": 957.82,
   "end": 958.42,
   "text": "היכן הוא?"
  },
  {
   "start": 958.42,
   "end": 961.72,
   "text": "אבא כבר, אבא כבר לא יהיה יותר."
  },
  {
   "start": 963.26,
   "end": 964.5,
   "text": "אבא כבר לא יגור כאן יותר."
  },
  {
   "start": 965.42,
   "end": 966.66,
   "text": "אבא נפטר מן העולם,"
  },
  {
   "start": 967.7,
   "end": 969.42,
   "text": "אומר הבן בקול עצוב ושקט."
  },
  {
   "start": 971.14,
   "end": 973.44,
   "text": "מאיר, נפטר מן העולם,"
  },
  {
   "start": 974.08,
   "end": 975.42,
   "text": "קרא הנסיך בצער."
  },
  {
   "start": 976.88,
   "end": 977.66,
   "text": "ואני באתי,"
  },
  {
   "start": 978.34,
   "end": 980.12,
   "text": "כל כך רציתי לפגוש אותו,"
  },
  {
   "start": 982.42,
   "end": 984.54,
   "text": "להביע בפניו את הערכה שלי,"
  },
  {
   "start": 984.82,
   "end": 989.2,
   "text": "את ההוקרה שלי על שהשתדל כל כך לשמור על החול הרכוש שלי."
  },
  {
   "start": 990.0,
   "end": 992.54,
   "text": "ואפילו שלחצו אותו, ואני יודע כמה לחצו אותו,"
  },
  {
   "start": 993.32,
   "end": 994.92,
   "text": "הוא התאמץ כל כך,"
  },
  {
   "start": 995.5,
   "end": 996.72,
   "text": "עד שלא הייתה ברירה,"
  },
  {
   "start": 997.42,
   "end": 998.54,
   "text": "ורק אז נכנע"
  },
  {
   "start": 999.28,
   "end": 1000.92,
   "text": "כדי לתת חיים לכל היהודים,"
  },
  {
   "start": 1002.08,
   "end": 1002.92,
   "text": "ונתן להם."
  },
  {
   "start": 1004.58,
   "end": 1005.44,
   "text": "כשאני שמעתי,"
  },
  {
   "start": 1006.24,
   "end": 1009.22,
   "text": "כששמעתי ממקום עכבואי כל כך התפעלתי,"
  },
  {
   "start": 1009.84,
   "end": 1010.82,
   "text": "מהיושר,"
  },
  {
   "start": 1011.56,
   "end": 1012.62,
   "text": "מההגינות,"
  },
  {
   "start": 1013.56,
   "end": 1014.66,
   "text": "כל כך התפעלתי."
  },
  {
   "start": 1016.74,
   "end": 1019.1,
   "text": "רק יהודי שקשור לבורא עולם,"
  },
  {
   "start": 1020.72,
   "end": 1023.26,
   "text": "יכול להגיע לדרגות כאלה."
  },
  {
   "start": 1024.36,
   "end": 1026.72,
   "text": "זה מה שהבנתי כשהפקדתי בידיו את הכסף,"
  },
  {
   "start": 1027.34,
   "end": 1028.48,
   "text": "וזה מה שהוא הוכיח לי"
  },
  {
   "start": 1030.2,
   "end": 1031.42,
   "text": "והראה לכל העולם."
  },
  {
   "start": 1033.16,
   "end": 1036.06,
   "text": "ועכשיו אתה אומר לי שאיחרתי את המועד."
  },
  {
   "start": 1037.5,
   "end": 1038.62,
   "text": "איזה כאב יש לי."
  },
  {
   "start": 1051.58,
   "end": 1054.8,
   "text": "ואז הבן, הבן של מאיר רנשילד רוטשילד,"
  },
  {
   "start": 1055.66,
   "end": 1056.7,
   "text": "אמר כבוד הנסיך,"
  },
  {
   "start": 1057.38,
   "end": 1057.54,
   "text": "בוא,"
  },
  {
   "start": 1058.64,
   "end": 1059.54,
   "text": "בוא תיכנס אל הבית."
  },
  {
   "start": 1062.32,
   "end": 1064.08,
   "text": "אתה אינך יודע כנראה מה קרה באמת."
  },
  {
   "start": 1065.32,
   "end": 1068.28,
   "text": "והנסיך נכנס בעקבות הבן של מאיר,"
  },
  {
   "start": 1071.37,
   "end": 1072.75,
   "text": "וכשהנסיך מתיישב,"
  },
  {
   "start": 1073.63,
   "end": 1075.93,
   "text": "הבן של רוטשילד אומר לו, תדע לך,"
  },
  {
   "start": 1076.83,
   "end": 1077.61,
   "text": "כבוד הנסיך,"
  },
  {
   "start": 1079.21,
   "end": 1082.51,
   "text": "כשלאבא שלי לא הייתה ברירה,"
  },
  {
   "start": 1084.72,
   "end": 1085.8,
   "text": "כשהוא נכנע,"
  },
  {
   "start": 1090.1,
   "end": 1093.38,
   "text": "אז הוא ניגש עם קציני נפוליאון אל הבית,"
  },
  {
   "start": 1094.24,
   "end": 1096.32,
   "text": "ונתן להם את כל אוצרות הכסף"
  },
  {
   "start": 1097.76,
   "end": 1099.96,
   "text": "שהוא החביא כאן בכספת"
  },
  {
   "start": 1100.48,
   "end": 1101.72,
   "text": "שמאחורי התמונה."
  },
  {
   "start": 1103.4,
   "end": 1104.44,
   "text": "אבל הנסיר וילל,"
  },
  {
   "start": 1105.56,
   "end": 1107.14,
   "text": "זה לא היה הכסף שלך,"
  },
  {
   "start": 1109.8,
   "end": 1111.34,
   "text": "זה היה הכסף של אבא."
  },
  {
   "start": 1112.44,
   "end": 1114.68,
   "text": "הוא הוליך אותם אל אוצרות הכסף שלו,"
  },
  {
   "start": 1116.22,
   "end": 1118.56,
   "text": "ונתן את כל הכסף שהיה לו."
  },
  {
   "start": 1120.42,
   "end": 1122.82,
   "text": "הכסף שלך שמור כאן,"
  },
  {
   "start": 1123.5,
   "end": 1127.12,
   "text": "מתחת למרצפות, בכספת נוספת נסתרת מן העין."
  },
  {
   "start": 1128.96,
   "end": 1130.9,
   "text": "אבא העדיף לתת את כל הרכוש שלו,"
  },
  {
   "start": 1131.26,
   "end": 1138.52,
   "text": "ובלבד לא לאבד את האמון לשמור על המילה על הפיקדון שהפקדת בידיו."
  },
  {
   "start": 1140.12,
   "end": 1140.88,
   "text": "איש לא יודע,"
  },
  {
   "start": 1141.48,
   "end": 1143.14,
   "text": "אבל הכסף שלך שמור לבטח,"
  },
  {
   "start": 1156.14,
   "end": 1157.22,
   "text": "הנסיך וילהלם,"
  },
  {
   "start": 1157.68,
   "end": 1158.88,
   "text": "מתיישב בתדהמה."
  },
  {
   "start": 1160.12,
   "end": 1160.42,
   "text": "רגע,"
  },
  {
   "start": 1161.42,
   "end": 1162.96,
   "text": "של מי אתה אומר היה הכסף?"
  },
  {
   "start": 1163.9,
   "end": 1165.86,
   "text": "שמאיר אינשילד רוטשילד נתן?"
  },
  {
   "start": 1168.7,
   "end": 1169.8,
   "text": "זה היה כסף של אבא."
  },
  {
   "start": 1170.8,
   "end": 1172.7,
   "text": "היה כסף שלו שהוא חסך שנים."
  },
  {
   "start": 1175.4,
   "end": 1177.08,
   "text": "אבא העדיף לתת את כל הרכוש שלו."
  },
  {
   "start": 1177.7,
   "end": 1185.34,
   "text": "ובלבד לא לפגוע באמון של אדם שהפקיד בידיים של יהודי את כל הרכוש שלו בשעה כל כך קשה."
  },
  {
   "start": 1194.85,
   "end": 1198.51,
   "text": "הנסיך וילהלם נתן למילים לחדור לתודעתו."
  },
  {
   "start": 1199.45,
   "end": 1200.37,
   "text": "הוא ישב ופשוט בכה,"
  },
  {
   "start": 1201.61,
   "end": 1206.77,
   "text": "בכה מהתרגשות לגודל העוצמה שנפרסה אל מול פניו."
  },
  {
   "start": 1212.28,
   "end": 1214.38,
   "text": "הילד היהודי מהגטו בפרנקפורט"
  },
  {
   "start": 1214.9,
   "end": 1218.2,
   "text": "הוכיח שוב שיהודי זה משהו אחר."
  },
  {
   "start": 1218.74,
   "end": 1221.44,
   "text": "יהודי זה משהו בלתי נתפס, בלתי מובן."
  },
  {
   "start": 1222.16,
   "end": 1224.58,
   "text": "משהו שהוא ממש בצלם אלוקים."
  },
  {
   "start": 1227.6,
   "end": 1228.96,
   "text": "מקץ דקות מספר,"
  },
  {
   "start": 1229.68,
   "end": 1230.4,
   "text": "קם הנסיך."
  },
  {
   "start": 1232.54,
   "end": 1232.64,
   "text": "טוב,"
  },
  {
   "start": 1233.56,
   "end": 1234.44,
   "text": "אני מעניק לכם"
  },
  {
   "start": 1235.04,
   "end": 1236.72,
   "text": "את האוצר הזה במתנה."
  },
  {
   "start": 1237.98,
   "end": 1238.78,
   "text": "מגיע לכם."
  },
  {
   "start": 1242.14,
   "end": 1242.4,
   "text": "הרי,"
  },
  {
   "start": 1244.18,
   "end": 1246.1,
   "text": "הרי נתתם את הכסף שלכם,"
  },
  {
   "start": 1246.86,
   "end": 1247.6,
   "text": "קחו אותו במתנה."
  },
  {
   "start": 1250.26,
   "end": 1253.7,
   "text": "אבל אז קם הבן של מאיר אנשיל רוטשילד,"
  },
  {
   "start": 1254.28,
   "end": 1256.18,
   "text": "ובקול נמרץ, קול שהזכיר את אבא,"
  },
  {
   "start": 1257.2,
   "end": 1257.8,
   "text": "את אבא שלו."
  },
  {
   "start": 1258.68,
   "end": 1259.64,
   "text": "אמר כבוד הנסיך,"
  },
  {
   "start": 1260.58,
   "end": 1264.54,
   "text": "אבא ביקש לפני מותו מאיתנו להחזיר לך את הכסף."
  },
  {
   "start": 1265.66,
   "end": 1266.5,
   "text": "זה הרצון שלו,"
  },
  {
   "start": 1267.32,
   "end": 1268.52,
   "text": "ואנחנו צריכים לכבד אותו."
  },
  {
   "start": 1270.34,
   "end": 1274.24,
   "text": "אבא אמר שעבור הכסף הזה הוא לא התאמץ מספיק."
  },
  {
   "start": 1275.46,
   "end": 1277.34,
   "text": "וכבר תדע לך, הנסיך וילהל,"
  },
  {
   "start": 1277.8,
   "end": 1279.04,
   "text": "אבא אמר להודיע לך"
  },
  {
   "start": 1279.04,
   "end": 1287.0,
   "text": "שריבונו של עולם החזיר לי אבא בכפל כפליים, כך הוא אמר, תגידו לנסיך וילהם,"
  },
  {
   "start": 1287.52,
   "end": 1290.84,
   "text": "שלא ידאג, ריבונו של עולם החזיר לי בכפל כפליים,"
  },
  {
   "start": 1291.62,
   "end": 1294.42,
   "text": "אל תדאג, ריבונו של עולם לא נשאר חייו."
  },
  {
   "start": 1303.25,
   "end": 1303.91,
   "text": "והנסיך,"
  },
  {
   "start": 1304.79,
   "end": 1307.03,
   "text": "הנסיך וילהם יצא משם, נסער כולו,"
  },
  {
   "start": 1308.51,
   "end": 1310.13,
   "text": "ועד מהרה פורסם הדבר,"
  },
  {
   "start": 1310.89,
   "end": 1317.62,
   "text": "ושם שמיים קודש לו בכל העולם, וכידוע,"
  },
  {
   "start": 1317.62,
   "end": 1320.54,
   "text": "ריבונו של עולם אינו נשאר חייו,"
  },
  {
   "start": 1321.44,
   "end": 1324.2,
   "text": "הוא גם לא נשאר חייו למשפחת רוטשילד."
  },
  {
   "start": 1325.66,
   "end": 1327.84,
   "text": "ככה זה כשיהודי מתנהג כיהודי,"
  },
  {
   "start": 1328.36,
   "end": 1368.62,
   "text": "משפיע על עצמו ועל כל הצאצאים שלו דורות אחרי דורות. צריכים להכניס את הדברים פנימה אלינו,"
  },
  {
   "start": 1369.2,
   "end": 1373.56,
   "text": "לדעת שיהודי זה ייחודי, שיהודייה זה משהו מיוחד,"
  },
  {
   "start": 1374.08,
   "end": 1374.92,
   "text": "בדור שלנו."
  },
  {
   "start": 1377.08,
   "end": 1377.52,
   "text": "כל כך"
  },
  {
   "start": 1378.86,
   "end": 1380.18,
   "text": "כואב בשמיים,"
  },
  {
   "start": 1381.1,
   "end": 1385.72,
   "text": "אם הקדוש ברוך הוא יצטרך לראות איזה יהודי שמנסה להיות כמו גוי,"
  },
  {
   "start": 1386.74,
   "end": 1388.98,
   "text": "כמו זה שם בארצות הברית, שם באירופה,"
  },
  {
   "start": 1391.1,
   "end": 1392.66,
   "text": "כשאם תיקח את כל העולם,"
  },
  {
   "start": 1393.44,
   "end": 1398.92,
   "text": "אין אדם שיכול להגיע לדרגן כל כך נשגבה כמו היהודי,"
  },
  {
   "start": 1399.7,
   "end": 1400.54,
   "text": "כמו היהודייה."
  }
 ]
}