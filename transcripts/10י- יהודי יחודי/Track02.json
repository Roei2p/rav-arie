{
 "disc": "10י- יהודי יחודי",
 "track": "Track02",
 "duration": 1057.176,
 "segments": [
  {
   "start": 10.16,
   "end": 10.94,
   "text": "אם יש יהודי,"
  },
  {
   "start": 12.16,
   "end": 20.94,
   "text": "אם יש יהודי שהוא יכול לתת לנו סימן דרך איך יהודי הוא ייחודי,"
  },
  {
   "start": 21.76,
   "end": 27.24,
   "text": "איך יהודי תמיד הוכיח את עצמו גם ברגעים הקשים ואולי במיוחד ברגעים הקשים,"
  },
  {
   "start": 31.46,
   "end": 35.22,
   "text": "אז יש יהודי אחד שכבר כתבו ספר עליו,"
  },
  {
   "start": 36.0,
   "end": 42.85,
   "text": "בספר כתוב מופת הדור והדרוב ועוד מחמאות וכינויים."
  },
  {
   "start": 44.91,
   "end": 47.53,
   "text": "שמי שהכיר את הרב הזה,"
  },
  {
   "start": 48.03,
   "end": 50.01,
   "text": "את הרב המיוחד הזה, את הקדוש הזה,"
  },
  {
   "start": 51.07,
   "end": 56.99,
   "text": "יודע שהכינויים האלה עוד מעטים מאוד,"
  },
  {
   "start": 58.41,
   "end": 61.41,
   "text": "מעט מזער ממה שבאמת."
  },
  {
   "start": 64.04,
   "end": 67.42,
   "text": "אז בואו בעזרת השם, בואו נלך, בואו נצעד בעקבות יהודי,"
  },
  {
   "start": 68.02,
   "end": 69.94,
   "text": "יהודי מיוחד, יהודי ייחודי."
  },
  {
   "start": 72.86,
   "end": 74.88,
   "text": "הרב רבי יקותיאל יהודה הלברשטם,"
  },
  {
   "start": 75.4,
   "end": 78.42,
   "text": "זכר צדיק וקדוש לברכה, האדמו״ר מקלויזנבורג,"
  },
  {
   "start": 78.9,
   "end": 82.16,
   "text": "שכשהוא היה בשואה,"
  },
  {
   "start": 82.78,
   "end": 84.78,
   "text": "שנבין, הוא הגיע לשואה,"
  },
  {
   "start": 85.5,
   "end": 86.54,
   "text": "הוא היה בתקופת השואה,"
  },
  {
   "start": 87.12,
   "end": 88.82,
   "text": "היה לו אישה ואחד עשרה ילדים."
  },
  {
   "start": 90.14,
   "end": 91.84,
   "text": "והנאצים, יימח שמם וזכרם,"
  },
  {
   "start": 92.32,
   "end": 95.26,
   "text": "הרגו לו את כל הילדים, ילד אחרי ילד."
  },
  {
   "start": 96.76,
   "end": 97.94,
   "text": "ואחרי זה גם את אשתו."
  },
  {
   "start": 98.84,
   "end": 99.88,
   "text": "והוא נותר בודד."
  },
  {
   "start": 101.14,
   "end": 102.44,
   "text": "ובמקום להישבר,"
  },
  {
   "start": 103.08,
   "end": 104.14,
   "text": "במקום להאשים,"
  },
  {
   "start": 104.58,
   "end": 105.52,
   "text": "במקום לצעוק,"
  },
  {
   "start": 106.12,
   "end": 108.68,
   "text": "הוא היה הרוח החיה המעודדת במחנות."
  },
  {
   "start": 109.24,
   "end": 111.08,
   "text": "הוא הקפיד על כל מצווה מצצווה."
  },
  {
   "start": 111.56,
   "end": 114.96,
   "text": "הוא נשאר ביהדות שלו, יהיה מה שיהיה, אותו הגרמנים לא ישברו."
  },
  {
   "start": 115.56,
   "end": 116.46,
   "text": "יהודי ינצח אותם."
  },
  {
   "start": 117.24,
   "end": 119.48,
   "text": "והוא המשיך, והמשיך, והמשיך."
  },
  {
   "start": 120.14,
   "end": 123.06,
   "text": "הוא הגיע פעם אחת למחנה עם מנוטו אושוויץ."
  },
  {
   "start": 123.82,
   "end": 125.6,
   "text": "בכניסה שם היה צריך לעשות גילוח,"
  },
  {
   "start": 126.38,
   "end": 127.28,
   "text": "גילוח בטהר."
  },
  {
   "start": 128.82,
   "end": 130.7,
   "text": "ואדמו״ר מצאנז, בצל המוות,"
  },
  {
   "start": 131.42,
   "end": 134.94,
   "text": "הוא לא מוותר על שום דבר, אבל להתגלח בטהר זה איסור מהתורה,"
  },
  {
   "start": 135.08,
   "end": 135.58,
   "text": "אני לא מוכן,"
  },
  {
   "start": 136.1,
   "end": 136.7,
   "text": "והוא מסרף."
  },
  {
   "start": 137.72,
   "end": 138.64,
   "text": "ושמה תופסים אותו,"
  },
  {
   "start": 139.26,
   "end": 139.98,
   "text": "ומכים אותו,"
  },
  {
   "start": 140.38,
   "end": 142.58,
   "text": "ומכים אותו מכות שהן רסקות איברים,"
  },
  {
   "start": 143.28,
   "end": 145.18,
   "text": "והוא בשלו, בתער, הוא לא מוכן."
  },
  {
   "start": 146.04,
   "end": 147.84,
   "text": "והקדוש ברוך הוא יושב בשמיים,"
  },
  {
   "start": 148.26,
   "end": 151.24,
   "text": "רואה את הבן שלו, איך הוא מוסר נפש על מצווה קלה,"
  },
  {
   "start": 153.08,
   "end": 153.92,
   "text": "שולח יד"
  },
  {
   "start": 155.06,
   "end": 156.48,
   "text": "שמתערבת בנושא,"
  },
  {
   "start": 157.3,
   "end": 158.46,
   "text": "שמתערבת בעניינים,"
  },
  {
   "start": 159.1,
   "end": 161.34,
   "text": "שמתערבת במקרה הזה."
  },
  {
   "start": 161.92,
   "end": 163.46,
   "text": "ואז עובר שם איזה קצין גרמני,"
  },
  {
   "start": 163.46,
   "end": 167.3,
   "text": "מי מהקצינים הגרמנים באמת היה אכפת לו מיהודים?"
  },
  {
   "start": 167.96,
   "end": 171.28,
   "text": "אבל לפתע הקצין הזה מסתכל ואומר, מה קרה? מה אתם רוצים ממנו?"
  },
  {
   "start": 171.72,
   "end": 172.56,
   "text": "למה אתם מכים אותו?"
  },
  {
   "start": 173.12,
   "end": 173.72,
   "text": "מה העניין?"
  },
  {
   "start": 175.1,
   "end": 177.56,
   "text": "אמרו לו, הוא לא רוצה להסתפר בתער."
  },
  {
   "start": 178.56,
   "end": 181.26,
   "text": "הוא מוכן להוריד במספריים ולא בתער, מה זה שהוא יקבע לנו?"
  },
  {
   "start": 182.26,
   "end": 183.36,
   "text": "האסיר היהודי הזה?"
  },
  {
   "start": 184.4,
   "end": 188.02,
   "text": "אז הגרמני הסתכל עליהם ופתאום אומר להם, אתם יודעים מה? מה מתווכחים איתו? מה העניין?"
  },
  {
   "start": 188.6,
   "end": 190.12,
   "text": "שיהיה במספריים, עזבו אותו."
  },
  {
   "start": 194.35,
   "end": 197.99,
   "text": "כך האדמו״ר מצאנז נשאר ביהודיות שלו,"
  },
  {
   "start": 198.67,
   "end": 200.41,
   "text": "ביהדות שלו, בייחודיות שלו."
  },
  {
   "start": 201.59,
   "end": 203.91,
   "text": "פעם אחת מגיעה שמחת תורה."
  },
  {
   "start": 205.29,
   "end": 209.59,
   "text": "שמחת תורה, והרבי מצאנז אומר לכולם, תראו, מחר אני לא אצא לעבודה כי היא שמחת תורה."
  },
  {
   "start": 210.11,
   "end": 212.63,
   "text": "צריך לשמוח בשמחת תורה, לעשות הקפות."
  },
  {
   "start": 213.25,
   "end": 219.05,
   "text": "הוא מצא לפני כמה זמן קלף קטן, חלק מספר תורה ועוד דף מספר תהילים."
  },
  {
   "start": 219.57,
   "end": 220.57,
   "text": "זה היה מספיק בשבילו"
  },
  {
   "start": 220.57,
   "end": 224.87,
   "text": "כדי לשמש כספרי קודש"
  },
  {
   "start": 226.81,
   "end": 228.79,
   "text": "שאפשר לעשות איתם, לערוך איתם הקפות."
  },
  {
   "start": 248.32,
   "end": 249.08,
   "text": "מחרת בבוקר,"
  },
  {
   "start": 250.22,
   "end": 250.8,
   "text": "מסדר,"
  },
  {
   "start": 251.78,
   "end": 253.24,
   "text": "סופרים את כל האסירים,"
  },
  {
   "start": 255.1,
   "end": 256.02,
   "text": "ומה מתברר?"
  },
  {
   "start": 257.54,
   "end": 258.48,
   "text": "חסר אחד,"
  },
  {
   "start": 263.56,
   "end": 265.24,
   "text": "יקים, מסודרים."
  },
  {
   "start": 265.78,
   "end": 266.46,
   "text": "חסר אחד,"
  },
  {
   "start": 267.08,
   "end": 268.62,
   "text": "מיד נשלח צוות לחפש אותו."
  },
  {
   "start": 269.92,
   "end": 273.38,
   "text": "מחפשים, אוהל אחרי עוד, צריף אחרי צריף."
  },
  {
   "start": 288.32,
   "end": 292.75,
   "text": "אז הם מוצאים אותו, הם נעצרים בצריף,"
  },
  {
   "start": 293.49,
   "end": 294.81,
   "text": "הצריף של הרבי מצאנז."
  },
  {
   "start": 295.83,
   "end": 296.15,
   "text": "שם,"
  },
  {
   "start": 296.97,
   "end": 297.67,
   "text": "שם הם נעמדים,"
  },
  {
   "start": 303.56,
   "end": 304.68,
   "text": "שם הם נעמדים בצריף."
  },
  {
   "start": 310.58,
   "end": 313.0,
   "text": "הם מצאו את הרבי מצאנז באמצע תפילת שמונה עשרה"
  },
  {
   "start": 314.0,
   "end": 315.56,
   "text": "של שמחת תורה,"
  },
  {
   "start": 317.94,
   "end": 319.26,
   "text": "הם גוררים אותו החוצה."
  },
  {
   "start": 321.24,
   "end": 321.54,
   "text": "למה?"
  },
  {
   "start": 322.86,
   "end": 323.9,
   "text": "למה נשארת בצריף?"
  },
  {
   "start": 324.6,
   "end": 325.56,
   "text": "שואל אותו המפקד."
  },
  {
   "start": 326.7,
   "end": 327.38,
   "text": "שמחת תורה."
  },
  {
   "start": 328.16,
   "end": 334.38,
   "text": "זה חג שלנו היהודים, והמפקד שומע את זה."
  },
  {
   "start": 334.94,
   "end": 335.72,
   "text": "נהיה אדון כולו."
  },
  {
   "start": 337.04,
   "end": 337.76,
   "text": "מיד במקום,"
  },
  {
   "start": 338.42,
   "end": 340.24,
   "text": "דנים את הרבי מצאנז,"
  },
  {
   "start": 340.72,
   "end": 344.08,
   "text": "הוא נידון ל-25 מלכות כפולות."
  },
  {
   "start": 347.08,
   "end": 348.4,
   "text": "מה זה מלכות כפולות?"
  },
  {
   "start": 348.78,
   "end": 349.48,
   "text": "שנבין,"
  },
  {
   "start": 350.64,
   "end": 353.72,
   "text": "הנאצים, ימח שמם וזכרם, היו מכים את האסירים באלות."
  },
  {
   "start": 354.88,
   "end": 360.02,
   "text": "בהתחלה הם התחילו עם אלות עם עץ, אבל כשאלות העץ נשברו על הגב של היהודים האומללים,"
  },
  {
   "start": 362.83,
   "end": 364.25,
   "text": "הם עברו לאלות מגומי."
  },
  {
   "start": 365.21,
   "end": 366.01,
   "text": "והיו עומדים להם"
  },
  {
   "start": 366.79,
   "end": 369.13,
   "text": "הרי אדם בריונים גרמנים,"
  },
  {
   "start": 369.63,
   "end": 371.37,
   "text": "והיו מכים מכות אדירות"
  },
  {
   "start": 372.59,
   "end": 373.67,
   "text": "את היהודים האומללים."
  },
  {
   "start": 374.81,
   "end": 378.79,
   "text": "25 מכות כפולות זה אומר שעומד גרמני מצד ימין,"
  },
  {
   "start": 379.07,
   "end": 381.29,
   "text": "עומד גרמני מצד שמאל, משני הצדדים,"
  },
  {
   "start": 381.75,
   "end": 385.21,
   "text": "אחד נותן מכה והשני מיד נותן מכה אחריו,"
  },
  {
   "start": 385.73,
   "end": 388.21,
   "text": "משני הצדדים, שתי מכות על גב אחד,"
  },
  {
   "start": 388.71,
   "end": 389.85,
   "text": "זה נקרא מכה אחת כפולה."
  },
  {
   "start": 391.77,
   "end": 392.69,
   "text": "אחרי מכה כזאת,"
  },
  {
   "start": 393.53,
   "end": 393.79,
   "text": "אדם"
  },
  {
   "start": 393.79,
   "end": 396.93,
   "text": "לא נשאר חי."
  },
  {
   "start": 398.19,
   "end": 401.01,
   "text": "והאדמו״ר מצאנז נידון ל-25 מלכות כפולות,"
  },
  {
   "start": 402.05,
   "end": 403.33,
   "text": "אכזריות לשמה,"
  },
  {
   "start": 404.29,
   "end": 406.09,
   "text": "ומתחילים להכות אותו ללא רחמים,"
  },
  {
   "start": 407.09,
   "end": 407.75,
   "text": "לפני כולם,"
  },
  {
   "start": 408.35,
   "end": 410.67,
   "text": "וכולם נחרדים, אבל מה הם יכולים לעשות?"
  },
  {
   "start": 412.13,
   "end": 416.41,
   "text": "ובתום הסיוט הזה הוא נותר שכוב מוטל,"
  },
  {
   "start": 420.62,
   "end": 423.1,
   "text": "וכולם יוצאים, כולם יוצאים לעבודה,"
  },
  {
   "start": 424.3,
   "end": 425.5,
   "text": "כולם יוצאים לעבודה."
  },
  {
   "start": 432.63,
   "end": 435.65,
   "text": "אי אפשר היה לתאר את הבת הצער על פני האסירים."
  },
  {
   "start": 448.74,
   "end": 449.9,
   "text": "פוסעים שבורים,"
  },
  {
   "start": 451.34,
   "end": 455.29,
   "text": "שבורים, הרב מצאנז,"
  },
  {
   "start": 458.09,
   "end": 460.95,
   "text": "ומספיקים לראות איך גוררים אותו, את הגופה שלו."
  },
  {
   "start": 498.03,
   "end": 498.69,
   "text": "צהריים,"
  },
  {
   "start": 499.25,
   "end": 501.59,
   "text": "אחר הצהריים חוזרים האסירים היהודים מהעבודה."
  },
  {
   "start": 506.52,
   "end": 511.3,
   "text": "מאחד הצריפים נשמעות זעקות, מאחד הצריפים נשמעות זעקות."
  },
  {
   "start": 512.28,
   "end": 514.74,
   "text": "כל האסירים מסתובבים, מפנים את הבבט."
  },
  {
   "start": 515.28,
   "end": 516.46,
   "text": "זה היה הצריף של הרבי."
  },
  {
   "start": 516.46,
   "end": 522.0,
   "text": "הצריף של הרבי, משם, והצריף של הרב מצאנז, של האדמו״ר מצאנז,"
  },
  {
   "start": 522.34,
   "end": 523.2,
   "text": "משם נשמעים,"
  },
  {
   "start": 523.66,
   "end": 524.44,
   "text": "נשמעות להם,"
  },
  {
   "start": 525.18,
   "end": 526.86,
   "text": "הצעקות נשמעים הקולות,"
  },
  {
   "start": 528.3,
   "end": 529.44,
   "text": "וכולם מתקרבים,"
  },
  {
   "start": 530.06,
   "end": 531.28,
   "text": "כולם נאספים,"
  },
  {
   "start": 533.02,
   "end": 535.32,
   "text": "וכשהם נעמדים בפתח הצריף,"
  },
  {
   "start": 537.86,
   "end": 541.94,
   "text": "רעד של התרגשות אוחז בקולותם יהודים."
  },
  {
   "start": 546.52,
   "end": 552.62,
   "text": "המחזה שנגלה אליהם היה מרטיט במרכז"
  },
  {
   "start": 552.62,
   "end": 557.94,
   "text": "אז הצריף של האדמו״ר מצאנז היה מונח כיסא."
  },
  {
   "start": 559.12,
   "end": 564.4,
   "text": "על הכיסא היו קלף של ספר תורה,"
  },
  {
   "start": 565.8,
   "end": 567.14,
   "text": "דף של תהילים קרוע,"
  },
  {
   "start": 569.04,
   "end": 574.47,
   "text": "וסביב הכיסא נעה לה דמות כפופה,"
  },
  {
   "start": 574.97,
   "end": 577.43,
   "text": "שפופה מעוצמת הכאבים,"
  },
  {
   "start": 579.81,
   "end": 580.65,
   "text": "פצועה,"
  },
  {
   "start": 581.19,
   "end": 582.07,
   "text": "כואבת,"
  },
  {
   "start": 584.79,
   "end": 587.35,
   "text": "מן המכות הנוראות שהיא ספגה,"
  },
  {
   "start": 587.97,
   "end": 624.13,
   "text": "דמותו של האדמו״ר מצאנז והרב האדמו״ר מצאנז מסתובב באיטיות כל צעד כאב אבל הוא דורך על הכאבים הוא ממשיך קדימה והפה שלו ממלמל שישו ושמחו בשמחת תורה שישו ושמחו מצאנז"
  },
  {
   "start": 624.81,
   "end": 628.5,
   "text": "עושה הקפות של שמחת תורה"
  },
  {
   "start": 630.7,
   "end": 632.76,
   "text": "לא יעזור להם, לגרמנים."
  },
  {
   "start": 633.64,
   "end": 635.88,
   "text": "לא יעזור להם לאויבי ישראל."
  },
  {
   "start": 636.56,
   "end": 639.88,
   "text": "את הרוח היהודית, אותה אי אפשר לנצח."
  },
  {
   "start": 640.58,
   "end": 644.28,
   "text": "ייחודי זה יהודי, ויהודי זה ייחודי."
  },
  {
   "start": 645.24,
   "end": 648.1,
   "text": "והאדמו״ר מצאנז הוכיח את זה לכל העולם."
  },
  {
   "start": 648.78,
   "end": 649.2,
   "text": "שם,"
  },
  {
   "start": 649.82,
   "end": 652.38,
   "text": "בלב הגטו, בלב המחנות,"
  },
  {
   "start": 653.36,
   "end": 654.34,
   "text": "בשיא המוות,"
  },
  {
   "start": 655.06,
   "end": 655.76,
   "text": "הוא בא ומוכיח"
  },
  {
   "start": 657.34,
   "end": 657.84,
   "text": "את התואר,"
  },
  {
   "start": 658.6,
   "end": 659.0,
   "text": "טוהר,"
  },
  {
   "start": 659.7,
   "end": 661.72,
   "text": "את הייחודיות של עם ישראל,"
  },
  {
   "start": 662.2,
   "end": 663.54,
   "text": "אני יהודי עם נשמה,"
  },
  {
   "start": 681.66,
   "end": 682.28,
   "text": "כאשר,"
  },
  {
   "start": 683.38,
   "end": 684.42,
   "text": "כאשר יום אחד,"
  },
  {
   "start": 686.7,
   "end": 687.52,
   "text": "תראו מה זה יהודי,"
  },
  {
   "start": 688.38,
   "end": 689.34,
   "text": "תראו מי זה אנחנו,"
  },
  {
   "start": 690.28,
   "end": 692.84,
   "text": "אנחנו עם ישראל קדושים, אין את זה בעולם."
  },
  {
   "start": 694.3,
   "end": 695.26,
   "text": "בכל מקום אחר,"
  },
  {
   "start": 695.98,
   "end": 699.3,
   "text": "כשאנשים היו מגיעים למחנות כאלה, היו נהפכים לחיות טרף."
  },
  {
   "start": 701.95,
   "end": 704.19,
   "text": "ואדמו״ר מצאנז שומר על הערכים שלו,"
  },
  {
   "start": 704.75,
   "end": 706.07,
   "text": "שומר על היהדות שלו,"
  },
  {
   "start": 706.49,
   "end": 707.89,
   "text": "שומר על הנשמה שלו,"
  },
  {
   "start": 708.21,
   "end": 710.05,
   "text": "נשמה שנתת בי טהורה היא."
  },
  {
   "start": 710.91,
   "end": 713.29,
   "text": "וכאשר יום אחד הרבי מצאנז,"
  },
  {
   "start": 713.65,
   "end": 719.55,
   "text": "האדמו״ר מצאנז שהקפיד על כל מצווה קלה קבע חמורה בלב הסיוט הזה,"
  },
  {
   "start": 721.31,
   "end": 722.11,
   "text": "הוא הניח תפילין"
  },
  {
   "start": 722.99,
   "end": 724.07,
   "text": "שהיו חבויות אצלו,"
  },
  {
   "start": 725.11,
   "end": 726.07,
   "text": "ויום אחד הוא נתפס."
  },
  {
   "start": 726.95,
   "end": 729.33,
   "text": "לפי הסימנים של ארצות הבינו שהוא הניח תפילין."
  },
  {
   "start": 730.35,
   "end": 732.21,
   "text": "הגרמנים ללא חמלה תפסו לו את היד,"
  },
  {
   "start": 732.79,
   "end": 736.03,
   "text": "ופשוט פצעו לו אותה במהלומות אדירות."
  },
  {
   "start": 738.05,
   "end": 739.35,
   "text": "והוא מסתובב במחנה,"
  },
  {
   "start": 739.91,
   "end": 742.63,
   "text": "יד פצועה במצב לא מזהיר בכלל."
  },
  {
   "start": 743.25,
   "end": 746.25,
   "text": "ואת הרבי מצאנז, את האדמור מצאנז, אתם יודעים מה מעניין?"
  },
  {
   "start": 746.73,
   "end": 748.91,
   "text": "לא הכאבים שלו, לא כלום."
  },
  {
   "start": 749.33,
   "end": 752.23,
   "text": "מעניין אותו איך הוא מחר בבוקר קם להניח תפילין,"
  },
  {
   "start": 752.53,
   "end": 754.43,
   "text": "איך הוא שומר על היהודות שלו,"
  },
  {
   "start": 754.75,
   "end": 756.25,
   "text": "איך הוא שומר על הייחודיות שלו,"
  },
  {
   "start": 756.71,
   "end": 759.21,
   "text": "איך הוא מתעלם מעל הכל."
  },
  {
   "start": 759.97,
   "end": 761.53,
   "text": "אז הוא מחפש, לפתע הוא רואה שם בפינה,"
  },
  {
   "start": 762.05,
   "end": 762.77,
   "text": "הייתה שם מדורה."
  },
  {
   "start": 764.53,
   "end": 766.19,
   "text": "זה הייתה מדורה לא של יהודים."
  },
  {
   "start": 768.25,
   "end": 770.45,
   "text": "של אסירים פולנים-רוסים."
  },
  {
   "start": 771.21,
   "end": 773.93,
   "text": "במחנות היו גם אסירים פולנים-רוסים גויים."
  },
  {
   "start": 775.01,
   "end": 775.85,
   "text": "שבויי מלחמה,"
  },
  {
   "start": 776.71,
   "end": 779.41,
   "text": "שוודאי לא קיבלו יחס כמו היהודים, אבל בכל אופן היו האסירים."
  },
  {
   "start": 781.31,
   "end": 784.01,
   "text": "והוא פונה אליהם שם, מגיע אליהם, אומר להם, תשמעו, אתם אסירים כמוני,"
  },
  {
   "start": 784.49,
   "end": 785.33,
   "text": "אני בסך הכל,"
  },
  {
   "start": 787.09,
   "end": 790.57,
   "text": "בסך הכל רוצה עזרה."
  },
  {
   "start": 791.59,
   "end": 793.29,
   "text": "תנו לי שנייה לחמם את היד."
  },
  {
   "start": 797.89,
   "end": 799.73,
   "text": "הוא היה בטוח שיקבל עזרה כשהוא פנה"
  },
  {
   "start": 801.29,
   "end": 802.95,
   "text": "אל המדורה שם היו הגויים."
  },
  {
   "start": 803.85,
   "end": 805.87,
   "text": "אבל הגויים הביטו עליו ואמרו לו, ז'יד,"
  },
  {
   "start": 806.59,
   "end": 809.23,
   "text": "ז'יד זה כינוי גנאי ליהודי, אמרו לו, יהודי, לך מפה."
  },
  {
   "start": 810.69,
   "end": 813.31,
   "text": "לא נרשה לך פה להתקרב למדורה שלנו,"
  },
  {
   "start": 813.89,
   "end": 815.89,
   "text": "והם היכו אותו, והיכו אותו,"
  },
  {
   "start": 818.4,
   "end": 819.56,
   "text": "וכך הוא נאלץ לברוח."
  },
  {
   "start": 822.08,
   "end": 824.02,
   "text": "ראה המדורה בצד השני רץ גם לשמה,"
  },
  {
   "start": 825.04,
   "end": 826.16,
   "text": "מבקש מהם עזרה."
  },
  {
   "start": 827.74,
   "end": 828.52,
   "text": "וגם הם,"
  },
  {
   "start": 851.27,
   "end": 854.88,
   "text": "וגם הם, ירוש."
  },
  {
   "start": 855.38,
   "end": 860.2,
   "text": "לא מוכנים לתת לו, תן לי אפשרות לרפוא את הפצעים, לא מוכנים."
  },
  {
   "start": 862.3,
   "end": 863.62,
   "text": "אתם יודעים מה יהודי עשה?"
  },
  {
   "start": 865.52,
   "end": 872.96,
   "text": "כל אדם אחר היה אולי עומד ונשבע לנקום בכל הגויים בעולם,"
  },
  {
   "start": 873.88,
   "end": 875.66,
   "text": "אבל יהודי זה ייחודי,"
  },
  {
   "start": 876.32,
   "end": 879.78,
   "text": "יהודי זה משהו אחר, יהודי זה בצלם אלוקים ברא אותו,"
  },
  {
   "start": 880.54,
   "end": 884.22,
   "text": "זה הבן של השם יתברך, הבן המיוחד, הבן הנבחר של השם יתברך."
  },
  {
   "start": 885.0,
   "end": 893.76,
   "text": "עומד הרבי מצאנז, עומד האדמו״ר מצאנז שם בלב המוות והוא נדר נדר, הוא נדר נדר, הוא אמר ריבונו של עולם"
  },
  {
   "start": 895.0,
   "end": 897.34,
   "text": "והוא נדר, אם אני יוצא חי מפה,"
  },
  {
   "start": 899.06,
   "end": 902.52,
   "text": "אם אני יוצא חי מהמחנות האלה, מהמוות הזה, מהתופת הזו,"
  },
  {
   "start": 905.22,
   "end": 910.28,
   "text": "אז אני אגיע ואני אעשה את כל המאמצים לבנות מרכז רפואי"
  },
  {
   "start": 911.16,
   "end": 914.36,
   "text": "ששם יקבלו את כל העולם,"
  },
  {
   "start": 914.6,
   "end": 917.48,
   "text": "את כל ה... מכל הסוגים, את כל האנשים."
  },
  {
   "start": 918.02,
   "end": 919.8,
   "text": "לא יהיה מצב כמו שלי עשו,"
  },
  {
   "start": 920.44,
   "end": 922.22,
   "text": "שכשבזמן לאדם פצוע,"
  },
  {
   "start": 922.52,
   "end": 924.84,
   "text": "כשאני פצוע ואני רוצה עזרה, לא נותנים לי."
  },
  {
   "start": 925.98,
   "end": 927.5,
   "text": "לאחרים לא יהיה מצב כזה,"
  },
  {
   "start": 928.02,
   "end": 930.04,
   "text": "ואנחנו היהודים לא נעשה את זה לאף אחד."
  },
  {
   "start": 932.5,
   "end": 933.28,
   "text": "תראו איזה מחשבה,"
  },
  {
   "start": 934.04,
   "end": 938.58,
   "text": "תראו איזה עוצמה של נפש יהודית, איזו אצילות רוח."
  },
  {
   "start": 944.62,
   "end": 945.6,
   "text": "והאדמו״ר מצאנז"
  },
  {
   "start": 947.16,
   "end": 948.04,
   "text": "היה יהודי,"
  },
  {
   "start": 949.24,
   "end": 950.76,
   "text": "כמו שיהודי צריך להיות."
  },
  {
   "start": 951.5,
   "end": 954.22,
   "text": "עבר את השואה, ניצח את הגרמנים,"
  },
  {
   "start": 954.86,
   "end": 957.88,
   "text": "והגיע לארץ והשתכן לו בעיר נתניה."
  },
  {
   "start": 958.58,
   "end": 960.26,
   "text": "שם בנה לו את קריית סאנז,"
  },
  {
   "start": 961.28,
   "end": 962.36,
   "text": "ממלכת סאנז,"
  },
  {
   "start": 962.98,
   "end": 964.42,
   "text": "מקום של קדושה וטהרה."
  },
  {
   "start": 965.48,
   "end": 969.34,
   "text": "ושם מתנוסס לו, הוא בנה לו,"
  },
  {
   "start": 969.9,
   "end": 972.76,
   "text": "הוא ייסד את בית החולים לניאדו שבנתניה."
  },
  {
   "start": 974.66,
   "end": 975.66,
   "text": "בית החולים לניאדו,"
  },
  {
   "start": 976.2,
   "end": 980.38,
   "text": "שבתקנון שלו רשום שהם מקבלים כל אחד ואחד."
  },
  {
   "start": 980.38,
   "end": 985.74,
   "text": "יהודי זה משהו מיוחד."
  },
  {
   "start": 988.78,
   "end": 993.76,
   "text": "יהודי מגלה את היופי של הנשמה, יהודייה מגלה את היופי של הנשמה שלה."
  },
  {
   "start": 994.76,
   "end": 997.48,
   "text": "הרבה פעמים אתה יכול לראות את זה דווקא בעיטות משבר, בעיטות קשיים."
  },
  {
   "start": 999.74,
   "end": 1003.42,
   "text": "אבל אנחנו לא צריכים לחכות לעיטות משבר, צריכים היום לגלות את היופי שלנו."
  },
  {
   "start": 1004.88,
   "end": 1007.24,
   "text": "להיות שמחים במה שאנחנו, לא צריכים להיות"
  },
  {
   "start": 1008.7,
   "end": 1013.14,
   "text": "כמו כל הגויים, אין לנו מה ללמוד מהם. הם צריכים ללמוד מאיתנו, אנחנו אור לגויים."
  },
  {
   "start": 1013.72,
   "end": 1016.86,
   "text": "אתה אור לגויים, מה אתה צריך להיות כמו גוי, מה פתאום?"
  },
  {
   "start": 1017.2,
   "end": 1020.12,
   "text": "את אור לכל הגויות, צריכים ללמוד ממך,"
  },
  {
   "start": 1020.98,
   "end": 1022.8,
   "text": "ויש הרבה מה ללמוד מאיתנו."
  },
  {
   "start": 1023.46,
   "end": 1024.82,
   "text": "אז בואו בעזרת השם,"
  },
  {
   "start": 1025.46,
   "end": 1028.06,
   "text": "בואו נחזיר את הטוהר לנשמה,"
  },
  {
   "start": 1028.62,
   "end": 1034.2,
   "text": "בואו נחזיר את הטוהר לעולם. אור לגויים זה אנחנו, צריכים לדעת את הכוחות שלנו,"
  },
  {
   "start": 1034.54,
   "end": 1036.44,
   "text": "את הנשמה הנפלאה שלנו."
  }
 ]
}