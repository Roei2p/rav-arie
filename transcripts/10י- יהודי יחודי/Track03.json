{
 "disc": "10י- יהודי יחודי",
 "track": "Track03",
 "duration": 614.184,
 "segments": [
  {
   "start": 6.4,
   "end": 7.26,
   "text": "ארץ ישראל,"
  },
  {
   "start": 8.38,
   "end": 9.2,
   "text": "בעיר נתניה,"
  },
  {
   "start": 10.92,
   "end": 12.62,
   "text": "יורד לו אבל כבד."
  },
  {
   "start": 16.05,
   "end": 17.69,
   "text": "כך עזב אותנו, הלך לבית עולמו,"
  },
  {
   "start": 18.35,
   "end": 19.37,
   "text": "האדמור הקדוש,"
  },
  {
   "start": 19.89,
   "end": 21.17,
   "text": "האדמור הקדוש מצאנס."
  },
  {
   "start": 27.17,
   "end": 27.59,
   "text": "וכך"
  },
  {
   "start": 29.39,
   "end": 30.61,
   "text": "יושבים להם שבעה,"
  },
  {
   "start": 33.52,
   "end": 34.62,
   "text": "והעיר נתניה אבלה."
  },
  {
   "start": 36.46,
   "end": 37.04,
   "text": "בשבעה,"
  },
  {
   "start": 37.62,
   "end": 38.46,
   "text": "במהלך השבעה,"
  },
  {
   "start": 40.66,
   "end": 44.28,
   "text": "השבעה היתו מחולקים גברים לחוד ונשים,"
  },
  {
   "start": 45.0,
   "end": 46.16,
   "text": "שבמרכזם הרבנית,"
  },
  {
   "start": 47.06,
   "end": 49.72,
   "text": "אשתו של האדמו״ר מצאנז, כשהוא הגיע לארץ,"
  },
  {
   "start": 50.2,
   "end": 52.2,
   "text": "האדמו״ר מצאנז, שניצול מהשואה,"
  },
  {
   "start": 52.94,
   "end": 54.84,
   "text": "שאיבד את כל 11 הילדים שלו ואת אשתו,"
  },
  {
   "start": 55.3,
   "end": 56.76,
   "text": "אבל ניצח את כל הגרמנים,"
  },
  {
   "start": 57.68,
   "end": 59.52,
   "text": "ובא לארץ והקים את צאנז,"
  },
  {
   "start": 60.06,
   "end": 61.18,
   "text": "את ממלכת צאנז."
  },
  {
   "start": 62.94,
   "end": 64.6,
   "text": "אז הוא בא והקים לו בית מחדש."
  },
  {
   "start": 67.11,
   "end": 71.35,
   "text": "ועכשיו אשתו הרבנית, אחרי שנים, יושבת לשבעה בצער היום."
  },
  {
   "start": 72.37,
   "end": 73.45,
   "text": "ובמהלך השבעה,"
  },
  {
   "start": 75.86,
   "end": 77.26,
   "text": "אל אזור הנשים האבלות,"
  },
  {
   "start": 77.86,
   "end": 79.04,
   "text": "שבמרכזם הרבנית,"
  },
  {
   "start": 79.62,
   "end": 81.0,
   "text": "נכנסת לפתע,"
  },
  {
   "start": 81.62,
   "end": 85.76,
   "text": "אישה זרה שפונה, עושה את דרכה אל מקום,"
  },
  {
   "start": 86.4,
   "end": 87.3,
   "text": "מקום האבלות,"
  },
  {
   "start": 87.96,
   "end": 88.78,
   "text": "אל צד הנשים."
  },
  {
   "start": 89.74,
   "end": 90.32,
   "text": "ואז היא נעמדת,"
  },
  {
   "start": 91.14,
   "end": 92.2,
   "text": "נעמדת מול הרבנית"
  },
  {
   "start": 94.8,
   "end": 95.7,
   "text": "ושולפת"
  },
  {
   "start": 96.98,
   "end": 98.08,
   "text": "שקית שהייתה איתה."
  },
  {
   "start": 100.18,
   "end": 103.66,
   "text": "וכל העיניים ניבטות אל עבר השקית, אל עבר האישה שעומדת כך"
  },
  {
   "start": 105.48,
   "end": 106.38,
   "text": "באופן מוזר."
  },
  {
   "start": 107.42,
   "end": 108.98,
   "text": "ואז היא שולפת מתוך השקית"
  },
  {
   "start": 109.58,
   "end": 110.0,
   "text": "זוג"
  },
  {
   "start": 110.86,
   "end": 111.96,
   "text": "גרביים לבנות,"
  },
  {
   "start": 113.52,
   "end": 115.56,
   "text": "מניחה אותם על השולחן לפני הרבנית,"
  },
  {
   "start": 116.8,
   "end": 117.16,
   "text": "ואומרת,"
  },
  {
   "start": 118.52,
   "end": 119.98,
   "text": "כבוד הרבנית, באתי לנחם אותך."
  },
  {
   "start": 121.14,
   "end": 121.72,
   "text": "יהי רצון"
  },
  {
   "start": 123.52,
   "end": 124.16,
   "text": "שזה,"
  },
  {
   "start": 124.72,
   "end": 125.84,
   "text": "והיא מצביעה לגרביים,"
  },
  {
   "start": 126.7,
   "end": 127.68,
   "text": "יהיה לעילון נשמת הרב."
  },
  {
   "start": 129.6,
   "end": 130.44,
   "text": "והיא מסתובבת ללכת,"
  },
  {
   "start": 131.54,
   "end": 133.36,
   "text": "אבל אז עוצרים אותה, שואלים אותה, תגידי לי,"
  },
  {
   "start": 133.88,
   "end": 134.2,
   "text": "מה זה?"
  },
  {
   "start": 134.66,
   "end": 135.92,
   "text": "מה זה אמור להביע? מה קרה פה?"
  },
  {
   "start": 136.84,
   "end": 137.82,
   "text": "תוכלי להסביר לנו?"
  },
  {
   "start": 139.24,
   "end": 139.78,
   "text": "נעמדה."
  },
  {
   "start": 140.64,
   "end": 142.1,
   "text": "אותה אישה נעמדה מסתובבת"
  },
  {
   "start": 145.63,
   "end": 146.65,
   "text": "בביתה ברבנית"
  },
  {
   "start": 147.93,
   "end": 170.53,
   "text": "ומתחילה לספר, והיא סיפרה, זה היה לפני שנים,"
  },
  {
   "start": 171.47,
   "end": 171.75,
   "text": "שם,"
  },
  {
   "start": 172.99,
   "end": 173.71,
   "text": "שם בגטו,"
  },
  {
   "start": 174.79,
   "end": 176.03,
   "text": "שם במחנות המוות."
  },
  {
   "start": 177.07,
   "end": 177.65,
   "text": "צריך לדעת,"
  },
  {
   "start": 178.77,
   "end": 179.75,
   "text": "במחנות המוות"
  },
  {
   "start": 181.51,
   "end": 185.61,
   "text": "היה טמפרטורה בחורף קרה מאוד, מקפיאה,"
  },
  {
   "start": 187.23,
   "end": 190.31,
   "text": "מינוס 15 מעלות, מינוס 10 מעלות,"
  },
  {
   "start": 193.33,
   "end": 196.17,
   "text": "כדי שרק נבין טמפרטורה במקפיא,"
  },
  {
   "start": 197.03,
   "end": 200.93,
   "text": "במקפיא שיש לכל אדם בבית, היא מינוס ארבע מעלות."
  },
  {
   "start": 202.09,
   "end": 205.07,
   "text": "שם היה מינוס עשר מעלות, מינוס חמש עשרה מעלות."
  },
  {
   "start": 205.99,
   "end": 209.41,
   "text": "כלומר, אם לא היה לך בגדים, לא היה לך בגדים כמו שצריך."
  },
  {
   "start": 211.07,
   "end": 213.29,
   "text": "למי שלא היה בגדים כמו שצריך הוא נידון למוות,"
  },
  {
   "start": 213.67,
   "end": 214.59,
   "text": "במוקדם או במאוחר,"
  },
  {
   "start": 215.47,
   "end": 217.19,
   "text": "מדלקת ריאות או משאר מחלות,"
  },
  {
   "start": 217.93,
   "end": 219.05,
   "text": "או מסתם קיפאון,"
  },
  {
   "start": 221.46,
   "end": 222.36,
   "text": "סכנת מוות."
  },
  {
   "start": 227.3,
   "end": 227.64,
   "text": "ואז,"
  },
  {
   "start": 228.94,
   "end": 229.88,
   "text": "ואז אני הייתי שם."
  },
  {
   "start": 230.84,
   "end": 233.62,
   "text": "הייתי שם במחנות, סיפרה אותה אישה."
  },
  {
   "start": 234.92,
   "end": 236.28,
   "text": "הייתי נערה,"
  },
  {
   "start": 236.9,
   "end": 238.44,
   "text": "נערה לבד מסתובבת לה."
  },
  {
   "start": 246.87,
   "end": 247.95,
   "text": "הייתי נערה שם,"
  },
  {
   "start": 248.59,
   "end": 249.07,
   "text": "בגטו."
  },
  {
   "start": 251.38,
   "end": 252.82,
   "text": "והייתה לי בעיה, אני ידעתי."
  },
  {
   "start": 253.52,
   "end": 256.12,
   "text": "ידעתי שהזמן שלי ספור,"
  },
  {
   "start": 259.26,
   "end": 261.8,
   "text": "כי הגרביים שלי נקרעו זה מכבר,"
  },
  {
   "start": 262.78,
   "end": 263.94,
   "text": "ואין לי גרביים."
  },
  {
   "start": 265.6,
   "end": 267.06,
   "text": "וככה אני הולכת לי בגטו."
  },
  {
   "start": 267.76,
   "end": 269.38,
   "text": "ככה אני הולכת לי במחנות,"
  },
  {
   "start": 270.08,
   "end": 270.62,
   "text": "בא לי לבכות."
  },
  {
   "start": 272.14,
   "end": 273.4,
   "text": "אבל הטבעות כבר יבשות."
  },
  {
   "start": 279.71,
   "end": 281.93,
   "text": "כנראה מישהו אמר לרב הקדוש מצאנז,"
  },
  {
   "start": 282.39,
   "end": 283.29,
   "text": "שגם הוא היה במחנה,"
  },
  {
   "start": 284.47,
   "end": 286.97,
   "text": "שיש נערה יהודייה שמסתובבת בלי כרפיים."
  },
  {
   "start": 290.12,
   "end": 291.0,
   "text": "ואז לפתע כך,"
  },
  {
   "start": 292.02,
   "end": 292.8,
   "text": "ללא התראה,"
  },
  {
   "start": 295.64,
   "end": 296.88,
   "text": "פונה ליהודי ואומר לי,"
  },
  {
   "start": 297.98,
   "end": 298.46,
   "text": "נערה,"
  },
  {
   "start": 299.3,
   "end": 302.02,
   "text": "הרבי, הרבי מצאנז רוצה לדבר איתך."
  },
  {
   "start": 304.33,
   "end": 305.43,
   "text": "איתי לדבר מה..."
  },
  {
   "start": 306.59,
   "end": 308.23,
   "text": "הוא אמר, תבואי, הוא רוצה לדבר איתך."
  },
  {
   "start": 310.93,
   "end": 311.41,
   "text": "ואני באתי,"
  },
  {
   "start": 312.97,
   "end": 313.83,
   "text": "ושם הוא עמד."
  },
  {
   "start": 315.55,
   "end": 316.13,
   "text": "אז הוא אומר לי,"
  },
  {
   "start": 318.45,
   "end": 320.29,
   "text": "בקול עדין, בקול מתחשב,"
  },
  {
   "start": 321.15,
   "end": 322.99,
   "text": "בקול שכל כך מבין,"
  },
  {
   "start": 323.79,
   "end": 326.59,
   "text": "נערה יהודייה בלי גרפיים."
  },
  {
   "start": 327.37,
   "end": 329.85,
   "text": "זה אסור, זה חוסר צניעות."
  },
  {
   "start": 331.25,
   "end": 335.83,
   "text": "אסור. כל כבודה של בת מלך פנימה עד בת ישראל קדושה, תיהלום יקר,"
  },
  {
   "start": 336.37,
   "end": 338.05,
   "text": "מה פתאום שאת הולכת בלי גרפיים?"
  },
  {
   "start": 340.39,
   "end": 343.03,
   "text": "ועוד מול הגרמנים, הנאצים הארורים האלה,"
  },
  {
   "start": 345.93,
   "end": 349.67,
   "text": "שהעיניים שלהם הטמעות יביטו בבת ישראל לא שייך."
  },
  {
   "start": 350.73,
   "end": 354.15,
   "text": "נערה, אסור לך ללכת בלי גרביים, למה את הולכת בלי גרביים?"
  },
  {
   "start": 355.61,
   "end": 356.49,
   "text": "והוא כמעט בוכה."
  },
  {
   "start": 363.28,
   "end": 366.66,
   "text": "פניתי אל כבוד הרב, התחלתי לבכות ואמרתי לו, כבוד הרב,"
  },
  {
   "start": 367.94,
   "end": 370.2,
   "text": "אין לי גרביים, זה לא שאני לא רוצה."
  },
  {
   "start": 371.48,
   "end": 373.3,
   "text": "אין לי גרביים, אין לי."
  },
  {
   "start": 374.62,
   "end": 375.86,
   "text": "זה לא שאני לא רוצה."
  },
  {
   "start": 383.13,
   "end": 383.61,
   "text": "ולפתע"
  },
  {
   "start": 385.05,
   "end": 386.09,
   "text": "השפיל את העיניים"
  },
  {
   "start": 387.05,
   "end": 392.05,
   "text": "שעד עכשיו הביטו בספר שלפניו כדי לשמור את העיניים שלו,"
  },
  {
   "start": 392.85,
   "end": 394.79,
   "text": "כדי לראות בת ישראל לא צנועה,"
  },
  {
   "start": 395.55,
   "end": 395.99,
   "text": "הוריד,"
  },
  {
   "start": 397.11,
   "end": 399.87,
   "text": "שפיל את העיניים שלו למטה, אל עבר הנעליים,"
  },
  {
   "start": 400.63,
   "end": 402.79,
   "text": "הנעליים שלו, שהיו קרועות,"
  },
  {
   "start": 405.63,
   "end": 407.79,
   "text": "ואז הוא הוריד את הנעליים הקרועות שלו."
  },
  {
   "start": 409.67,
   "end": 411.17,
   "text": "ומתחתם היו גרביים,"
  },
  {
   "start": 411.91,
   "end": 413.97,
   "text": "גרביים חמות עבות לבנות."
  },
  {
   "start": 415.81,
   "end": 417.49,
   "text": "הוא פשט את הגרביים שלו,"
  },
  {
   "start": 418.19,
   "end": 419.21,
   "text": "אלו שהגנו עליו,"
  },
  {
   "start": 419.99,
   "end": 424.63,
   "text": "אלו ששמרו על הבריאות שלו, שהבטיחו לו המשך חיים תקינים כרגע,"
  },
  {
   "start": 425.77,
   "end": 430.03,
   "text": "שכל כך חשובים במלחמת ההישרדות כאן במחנות,"
  },
  {
   "start": 432.03,
   "end": 434.79,
   "text": "הוריד את הגרביים ונתן לי."
  },
  {
   "start": 437.13,
   "end": 438.13,
   "text": "ואני אמרתי לו, לא הרב,"
  },
  {
   "start": 438.73,
   "end": 441.07,
   "text": "זה החיים שלך, זה הבריאות שלך, אני לא יכולה לקחת."
  },
  {
   "start": 442.55,
   "end": 443.77,
   "text": "אבל הוא אמר בטון נחלטי,"
  },
  {
   "start": 447.31,
   "end": 448.21,
   "text": "את יהודיה,"
  },
  {
   "start": 448.93,
   "end": 449.99,
   "text": "את חייבת,"
  },
  {
   "start": 450.91,
   "end": 452.43,
   "text": "את חייבת להיות צנועה."
  },
  {
   "start": 453.45,
   "end": 457.43,
   "text": "אני לא חייב ללבוש גרביים, את חייבת ללבוש גרביים."
  },
  {
   "start": 469.08,
   "end": 470.06,
   "text": "והוא הסתובב והלך."
  },
  {
   "start": 470.9,
   "end": 472.44,
   "text": "ואני נשארתי עם הגרביים,"
  },
  {
   "start": 473.02,
   "end": 479.46,
   "text": "והגרביים החמות, הגרביים המגינות העוטפות האלה של כל עם ישראל."
  },
  {
   "start": 482.33,
   "end": 484.41,
   "text": "תדעי לך הרבנית, תדעו לכם כולכם,"
  },
  {
   "start": 485.71,
   "end": 487.55,
   "text": "הרבה פעמים בחיים שלי היו משברים."
  },
  {
   "start": 488.91,
   "end": 492.79,
   "text": "במחנות אז הייתי מגיע לנקודות השבירה שלי."
  },
  {
   "start": 493.25,
   "end": 495.27,
   "text": "כשהייתי מגיע לנקודות השבירה שם במחנות,"
  },
  {
   "start": 495.27,
   "end": 496.29,
   "text": "שם במוות הזה."
  },
  {
   "start": 499.26,
   "end": 503.4,
   "text": "אז לפתע החום של הגרביים היה מחזיק אותי,"
  },
  {
   "start": 503.86,
   "end": 504.9,
   "text": "היה מחזק אותי."
  },
  {
   "start": 505.3,
   "end": 509.16,
   "text": "החום של הגרביים של רב שנתן לנערה יהודייה חיים,"
  },
  {
   "start": 509.52,
   "end": 510.76,
   "text": "חיים וכבוד,"
  },
  {
   "start": 511.08,
   "end": 512.54,
   "text": "כבוד של בת מלך,"
  },
  {
   "start": 512.86,
   "end": 514.14,
   "text": "כבוד של בת ישראל."
  },
  {
   "start": 515.36,
   "end": 518.26,
   "text": "החום של הגרביים נסח בי כל כך הרבה כוח."
  },
  {
   "start": 521.93,
   "end": 522.37,
   "text": "כל פעם"
  },
  {
   "start": 522.95,
   "end": 526.65,
   "text": "בימי חיי שהייתי מגיעה לנקודת משבר,"
  },
  {
   "start": 527.27,
   "end": 528.55,
   "text": "לסף משבר."
  },
  {
   "start": 534.31,
   "end": 535.61,
   "text": "החום של הגרביים,"
  },
  {
   "start": 536.49,
   "end": 538.55,
   "text": "החום של הגרביים שמר עליי,"
  },
  {
   "start": 538.89,
   "end": 540.35,
   "text": "שמר על היהדות שלי,"
  },
  {
   "start": 540.79,
   "end": 542.85,
   "text": "שמר על הקשר אל השם יתברך."
  },
  {
   "start": 544.23,
   "end": 547.27,
   "text": "כל חיי אני לא אשכח את השיעור הזה,"
  },
  {
   "start": 547.87,
   "end": 548.15,
   "text": "שם,"
  },
  {
   "start": 548.71,
   "end": 549.53,
   "text": "בצל המוות,"
  },
  {
   "start": 550.21,
   "end": 550.53,
   "text": "שם,"
  },
  {
   "start": 552.42,
   "end": 555.06,
   "text": "כשהאמת רק היא מדברת."
  },
  {
   "start": 557.32,
   "end": 560.76,
   "text": "קיבלתי שיעור אמיתי מיהודי אמיתי,"
  },
  {
   "start": 561.58,
   "end": 562.96,
   "text": "מהי בת ישראל,"
  },
  {
   "start": 563.66,
   "end": 564.92,
   "text": "ומה זו יהודייה,"
  },
  {
   "start": 565.8,
   "end": 568.2,
   "text": "ומה זה יהודי ייחודי?"
  },
  {
   "start": 573.34,
   "end": 574.46,
   "text": "אז הגרביים האלה,"
  },
  {
   "start": 576.51,
   "end": 578.43,
   "text": "חשבתי מה אני יכולה לעשות?"
  },
  {
   "start": 579.17,
   "end": 581.95,
   "text": "אלה הגרביים, ילמדו גם הם זכות,"
  },
  {
   "start": 582.31,
   "end": 583.29,
   "text": "אני סמוכה ובטוחה,"
  },
  {
   "start": 583.79,
   "end": 584.93,
   "text": "על הרב הקדוש."
  },
  {
   "start": 587.04,
   "end": 587.38,
   "text": "כמה,"
  },
  {
   "start": 587.9,
   "end": 594.7,
   "text": "כמה כיתות של מלאכים יבואו לקחת את הגרביים האלה אל בית דין של מעלה,"
  },
  {
   "start": 595.4,
   "end": 599.1,
   "text": "להראות קבל עם ועדה לכל הפמלייה של מעלה."
  },
  {
   "start": 599.7,
   "end": 600.32,
   "text": "מה זה יהודי?"
  },
  {
   "start": 601.06,
   "end": 601.82,
   "text": "מה זה יהודי?"
  }
 ]
}