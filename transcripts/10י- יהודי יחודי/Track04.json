{
 "disc": "10י- יהודי יחודי",
 "track": "Track04",
 "duration": 418.2,
 "segments": [
  {
   "start": 3.94,
   "end": 4.86,
   "text": "סמינר לבנות"
  },
  {
   "start": 6.56,
   "end": 7.72,
   "text": "של בית יעקב,"
  },
  {
   "start": 8.72,
   "end": 9.98,
   "text": "93 בנות"
  },
  {
   "start": 10.98,
   "end": 11.6,
   "text": "שרוצות"
  },
  {
   "start": 12.8,
   "end": 16.42,
   "text": "לבנות בית יהודי כדת משה וישראל,"
  },
  {
   "start": 17.0,
   "end": 18.02,
   "text": "עם מקצוע מכובד."
  },
  {
   "start": 19.04,
   "end": 20.42,
   "text": "באה מלחמת העולם השנייה,"
  },
  {
   "start": 20.94,
   "end": 25.84,
   "text": "באים הנאצים עמך שמם וזכרם העמלקים ורוצים להרוס את הכל,"
  },
  {
   "start": 26.32,
   "end": 28.56,
   "text": "להרוס עולם של יהדות, עולם של נצח,"
  },
  {
   "start": 28.94,
   "end": 32.12,
   "text": "עולם של טהרה של בנות ישראל הקדושות והטהורות"
  },
  {
   "start": 32.88,
   "end": 35.5,
   "text": "והם באים, הגרמנים, כשהם מגיעים,"
  },
  {
   "start": 36.3,
   "end": 38.7,
   "text": "מדמודים שם לנהל את המקום."
  },
  {
   "start": 40.52,
   "end": 43.0,
   "text": "כל הסמינר, כל הבנות כאן,"
  },
  {
   "start": 44.6,
   "end": 48.04,
   "text": "כל הסמינר ייהפך לבית שעשועים עבור החיילים הגרמנים."
  },
  {
   "start": 49.7,
   "end": 52.24,
   "text": "יש לכם זמן להכין את כל הבנות."
  },
  {
   "start": 53.98,
   "end": 56.7,
   "text": "עוד 24 שעות יגיעו החיילים."
  },
  {
   "start": 66.79,
   "end": 69.09,
   "text": "וכך עומדת לה מנהלת בית יעקב שרה שנירר."
  },
  {
   "start": 71.89,
   "end": 72.31,
   "text": "עומדת"
  },
  {
   "start": 75.66,
   "end": 79.98,
   "text": "מלווה את הגרמנים שמסתלקים במבט החלטי,"
  },
  {
   "start": 80.64,
   "end": 81.54,
   "text": "היא יודעת מה לעשות."
  },
  {
   "start": 82.9,
   "end": 83.28,
   "text": "היא הלכה,"
  },
  {
   "start": 84.7,
   "end": 86.66,
   "text": "היא הלכה ופנתה לכל הבנות."
  },
  {
   "start": 89.88,
   "end": 91.5,
   "text": "אבל לפני שהיא פנתה לכל הבנות,"
  },
  {
   "start": 94.27,
   "end": 95.73,
   "text": "לפני שהיא פנתה לכל הבנות,"
  },
  {
   "start": 98.8,
   "end": 99.6,
   "text": "היא עשתה משהו נוסף."
  },
  {
   "start": 106.57,
   "end": 112.08,
   "text": "היא הלכה ודאגה להשיג גלולות,"
  },
  {
   "start": 112.9,
   "end": 114.2,
   "text": "גלולות של מוות."
  },
  {
   "start": 116.48,
   "end": 119.68,
   "text": "גלולות שיאפשרו לבנות ישראל הקדושות והטהורות"
  },
  {
   "start": 122.14,
   "end": 124.96,
   "text": "לצאת מעולם של טומאה לעולם של טוהר,"
  },
  {
   "start": 126.14,
   "end": 129.32,
   "text": "לשמור על השלמות הרוחנית שלהם."
  },
  {
   "start": 134.53,
   "end": 137.25,
   "text": "אז היא נכנסת שם אל בית הסמינר,"
  },
  {
   "start": 137.77,
   "end": 138.87,
   "text": "מכנסת את כל הבנות,"
  },
  {
   "start": 139.63,
   "end": 140.13,
   "text": "וכולן,"
  },
  {
   "start": 140.65,
   "end": 142.45,
   "text": "כולן דרוכות מביטות בה,"
  },
  {
   "start": 145.11,
   "end": 146.17,
   "text": "ואז היא מסבירה להם"
  },
  {
   "start": 147.07,
   "end": 147.95,
   "text": "מה הגרמני מתכנן?"
  },
  {
   "start": 151.09,
   "end": 153.65,
   "text": "יכולנו היינו לראות אולי דמעה"
  },
  {
   "start": 154.71,
   "end": 158.77,
   "text": "משתרבבת לה במורד לחייה של אחת, של שנייה,"
  },
  {
   "start": 159.71,
   "end": 161.69,
   "text": "אבל כולם גומעות כל מילה"
  },
  {
   "start": 162.85,
   "end": 164.07,
   "text": "מהמנהלת שמסבירה להם,"
  },
  {
   "start": 164.71,
   "end": 165.89,
   "text": "ומספרת להם ואומרת להם,"
  },
  {
   "start": 166.75,
   "end": 168.23,
   "text": "אבל יש לנו אפשרות אחרת."
  },
  {
   "start": 169.73,
   "end": 171.79,
   "text": "יש לנו אפשרות לא לטמא את עצמנו."
  },
  {
   "start": 173.19,
   "end": 173.79,
   "text": "יש איתי פה גלולות,"
  },
  {
   "start": 176.61,
   "end": 177.45,
   "text": "גלולות של מוות,"
  },
  {
   "start": 178.77,
   "end": 181.95,
   "text": "שיאפשר לנו לצאת מן העולם הזה בטהרה ובקדושה,"
  },
  {
   "start": 183.53,
   "end": 185.91,
   "text": "ולא לטמא לגרמנים."
  },
  {
   "start": 185.91,
   "end": 192.83,
   "text": "כל מי שמוכנה תבוא ותיקח גלולה ומי שלא"
  },
  {
   "start": 194.71,
   "end": 195.79,
   "text": "אני לא יודעת אם להאשים אותה."
  },
  {
   "start": 200.52,
   "end": 201.74,
   "text": "אתם יודעים מה קרה,"
  },
  {
   "start": 203.02,
   "end": 205.12,
   "text": "אני לא יודע מה היה קורה אם זה היה באומות אחרות,"
  },
  {
   "start": 206.72,
   "end": 210.54,
   "text": "אבל אצל עם ישראל יהודייה היא משהו מיוחד."
  },
  {
   "start": 211.32,
   "end": 212.6,
   "text": "93 בנות,"
  },
  {
   "start": 213.46,
   "end": 216.24,
   "text": "כל הבנות קמו כגוש אחד,"
  },
  {
   "start": 216.82,
   "end": 218.72,
   "text": "כגוף אחד, ניגשות."
  },
  {
   "start": 219.7,
   "end": 223.92,
   "text": "לקחת את גלולת המוות בכבוד, בגאון,"
  },
  {
   "start": 251.48,
   "end": 252.16,
   "text": "לקחה לגלולה."
  },
  {
   "start": 253.46,
   "end": 254.94,
   "text": "כל אחת מתייחדת עם עצמה,"
  },
  {
   "start": 257.56,
   "end": 259.22,
   "text": "כל אחת מתייחדת עם עצמה."
  },
  {
   "start": 262.69,
   "end": 281.86,
   "text": "יש לה זמן לשפוך תפילה לפני בורא עולם, לפני ריבונו של עולם."
  },
  {
   "start": 282.2,
   "end": 290.75,
   "text": "כל יהודייה ויהודייה מוכנה למות כדי לא להיטמא"
  },
  {
   "start": 292.27,
   "end": 293.23,
   "text": "על ידי גוי."
  },
  {
   "start": 296.0,
   "end": 297.76,
   "text": "24 שעות אחר כך"
  },
  {
   "start": 297.76,
   "end": 303.68,
   "text": "פורצים אל סמינר בית יעקב עשרות חיילים גרמנים,"
  },
  {
   "start": 304.52,
   "end": 305.84,
   "text": "עשרות קצינים גרמנים,"
  },
  {
   "start": 313.1,
   "end": 313.76,
   "text": "והם עומדים,"
  },
  {
   "start": 314.7,
   "end": 316.38,
   "text": "עומדים בדממה."
  },
  {
   "start": 323.18,
   "end": 324.04,
   "text": "הגרמנים באו"
  },
  {
   "start": 325.7,
   "end": 332.1,
   "text": "ומוצאים 93 גופות של נערות קדושות."
  },
  {
   "start": 334.48,
   "end": 340.32,
   "text": "93 גופות קדושות. הם מביטים, לא מאמינים,"
  },
  {
   "start": 341.18,
   "end": 343.6,
   "text": "לא מאמינים, הם כבשו כמעט את רוב אירופה."
  },
  {
   "start": 344.14,
   "end": 345.94,
   "text": "נתקלו בבנות מכל הסוגים."
  },
  {
   "start": 346.38,
   "end": 347.54,
   "text": "בנות כמו היהודיות,"
  },
  {
   "start": 348.16,
   "end": 348.92,
   "text": "הן לא פגשו."
  },
  {
   "start": 349.74,
   "end": 350.38,
   "text": "הן לא פגשו,"
  },
  {
   "start": 351.1,
   "end": 351.88,
   "text": "והן גם לא יפגשו."
  },
  {
   "start": 353.8,
   "end": 360.02,
   "text": "93 בנות ישראל ממשיכות את דרכם של שרה, יבקה רחל ולאה,"
  },
  {
   "start": 360.7,
   "end": 368.24,
   "text": "גבעת הלבונה, קובעות להן חותמת של טוהר, של כבוד, של ייחודיות בהיסטוריה העולמית."
  },
  {
   "start": 369.08,
   "end": 372.94,
   "text": "זה הייחוד של בנות ישראל, זה יהודייה."
  },
  {
   "start": 373.32,
   "end": 374.98,
   "text": "כמה זה אומר לנו היום,"
  },
  {
   "start": 375.32,
   "end": 387.16,
   "text": "לנו היום, כמה אומר לכל יהודייה, ויהודייה צריכה לתת כוחות בלב כל הטומאה, בלב הכול לא לוותר על היהודיות, על הייחודיות שלה, על הצניעות שלה, על הכבוד שלה, על יראת שמיים שלה,"
  },
  {
   "start": 388.0,
   "end": 391.6,
   "text": "על היופי הפנימי שלה, כל כבודה של בת מלך פנימה."
  },
  {
   "start": 392.0,
   "end": 396.94,
   "text": "את זה רק את, בת ישראל הקדושה, בת מלך, מלכי המלכים הקדוש ברוך הוא, יכולה לעשות."
  }
 ]
}