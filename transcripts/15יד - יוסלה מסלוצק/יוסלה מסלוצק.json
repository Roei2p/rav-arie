{
 "disc": "15יד - יוסלה מסלוצק",
 "track": "יוסלה מסלוצק",
 "duration": 2242.1159375,
 "segments": [
  {
   "start": 33.68,
   "end": 34.4,
   "text": "בכל מקום."
  },
  {
   "start": 35.48,
   "end": 38.9,
   "text": "יש את הטוב ויש את הפחות טוב."
  },
  {
   "start": 43.63,
   "end": 45.51,
   "text": "בעיר סלוצק הפחות טוב"
  },
  {
   "start": 46.93,
   "end": 47.47,
   "text": "הצטמצם"
  },
  {
   "start": 48.11,
   "end": 48.83,
   "text": "לשם אחד."
  },
  {
   "start": 50.15,
   "end": 51.65,
   "text": "שם אחד בעייתי,"
  },
  {
   "start": 53.41,
   "end": 56.39,
   "text": "שנישא בפי כל, שהכירו כולם,"
  },
  {
   "start": 57.89,
   "end": 58.43,
   "text": "יוסלה."
  },
  {
   "start": 60.68,
   "end": 61.56,
   "text": "יוסלה היה ילד."
  },
  {
   "start": 63.24,
   "end": 63.46,
   "text": "ילד"
  },
  {
   "start": 65.02,
   "end": 67.04,
   "text": "שמגיל קטן לא התאים לשום מסגרת."
  },
  {
   "start": 69.85,
   "end": 73.09,
   "text": "ילד שמגיל קטן לא מצא את עצמו בשום מקום,"
  },
  {
   "start": 74.35,
   "end": 75.21,
   "text": "מלבד מקום אחד,"
  },
  {
   "start": 75.91,
   "end": 76.71,
   "text": "שם בחוץ,"
  },
  {
   "start": 77.47,
   "end": 81.09,
   "text": "עם בעלי החיים, עם היונים, עם הכלבים,"
  },
  {
   "start": 81.77,
   "end": 82.61,
   "text": "עם החתולים."
  },
  {
   "start": 83.33,
   "end": 83.77,
   "text": "שם."
  },
  {
   "start": 85.11,
   "end": 85.45,
   "text": "שם."
  },
  {
   "start": 86.91,
   "end": 88.67,
   "text": "שם הוא מצא מקום להתפרק,"
  },
  {
   "start": 90.53,
   "end": 95.29,
   "text": "להשתולל, להשתובב, לקפוץ מגג לגג,"
  },
  {
   "start": 98.48,
   "end": 100.84,
   "text": "ובעיר שלווה ושקטה,"
  },
  {
   "start": 101.38,
   "end": 101.88,
   "text": "כמו סלוצק."
  },
  {
   "start": 104.1,
   "end": 105.08,
   "text": "יוסלה היה בולט מאוד,"
  },
  {
   "start": 109.26,
   "end": 109.96,
   "text": "מה יהיה איתו?"
  },
  {
   "start": 111.06,
   "end": 112.82,
   "text": "כולם התרחקו מהילד הזה."
  },
  {
   "start": 115.56,
   "end": 115.88,
   "text": "והוא,"
  },
  {
   "start": 117.82,
   "end": 120.76,
   "text": "הוא איש שלא מצא את עצמו בשום מסגרת,"
  },
  {
   "start": 122.28,
   "end": 123.52,
   "text": "בשום מקום לימוד,"
  },
  {
   "start": 129.18,
   "end": 131.46,
   "text": "שתה בצמא את הוואי הרחוב."
  },
  {
   "start": 133.2,
   "end": 135.96,
   "text": "חי לו בצורה שונה,"
  },
  {
   "start": 136.68,
   "end": 137.7,
   "text": "שונה מכולם."
  },
  {
   "start": 138.56,
   "end": 143.3,
   "text": "ילד שאולי כמעט בלתי ניתן לשליטה,"
  },
  {
   "start": 149.8,
   "end": 164.8,
   "text": "ילד שהדבר היחיד שהרגיע אותו אלו היו הכלבים,"
  },
  {
   "start": 165.48,
   "end": 167.44,
   "text": "החתולים והציפורים."
  },
  {
   "start": 169.65,
   "end": 171.87,
   "text": "וכך חולפים הימים,"
  },
  {
   "start": 174.94,
   "end": 176.16,
   "text": "עוברות להם השנים."
  },
  {
   "start": 177.96,
   "end": 178.5,
   "text": "ויום אחד,"
  },
  {
   "start": 179.38,
   "end": 180.26,
   "text": "יום אחד יוסלה,"
  },
  {
   "start": 181.08,
   "end": 181.8,
   "text": "כהרגלו,"
  },
  {
   "start": 182.64,
   "end": 189.5,
   "text": "מהגג של אחד הבתים הוא מחליק באמצעות המארזב,"
  },
  {
   "start": 191.95,
   "end": 192.75,
   "text": "ואז הוא נעצר"
  },
  {
   "start": 194.37,
   "end": 195.15,
   "text": "באמצע הדרך."
  },
  {
   "start": 196.85,
   "end": 197.77,
   "text": "שם דרך החלון,"
  },
  {
   "start": 198.67,
   "end": 200.39,
   "text": "שם דרך החלון הוא רואה מחזה,"
  },
  {
   "start": 201.75,
   "end": 205.89,
   "text": "מחזה שגורם לו להיעצר,"
  },
  {
   "start": 208.52,
   "end": 209.96,
   "text": "מרותק כולו אל החלון."
  },
  {
   "start": 212.08,
   "end": 212.7,
   "text": "והמחזה,"
  },
  {
   "start": 213.68,
   "end": 215.14,
   "text": "המחזה שנגלה לעיניו"
  },
  {
   "start": 217.56,
   "end": 218.84,
   "text": "היה מחזה של אבא,"
  },
  {
   "start": 219.58,
   "end": 221.14,
   "text": "אבא שגוער בבן שלו."
  },
  {
   "start": 224.72,
   "end": 225.16,
   "text": "והאבא היה"
  },
  {
   "start": 226.84,
   "end": 228.0,
   "text": "היה בצער גדול."
  },
  {
   "start": 228.74,
   "end": 230.34,
   "text": "הוא פנה אל הבן שלו ואמר לו,"
  },
  {
   "start": 230.96,
   "end": 232.32,
   "text": "תגיד לי מה אתה רוצה?"
  },
  {
   "start": 232.9,
   "end": 234.82,
   "text": "מה אתה רוצה להיות כמו יוסלה?"
  },
  {
   "start": 236.28,
   "end": 238.2,
   "text": "אתה רוצה להיות כמו יוסלה?"
  },
  {
   "start": 240.89,
   "end": 243.45,
   "text": "אני חושש, עם התנהגות כזאת בסוף אתה,"
  },
  {
   "start": 244.09,
   "end": 246.17,
   "text": "אתה חס וחלילה יכול להיות כמו יוסלה."
  },
  {
   "start": 247.41,
   "end": 247.77,
   "text": "והילד,"
  },
  {
   "start": 248.47,
   "end": 249.13,
   "text": "הילד רעד כולו,"
  },
  {
   "start": 250.11,
   "end": 250.97,
   "text": "נפגע כולו,"
  },
  {
   "start": 251.59,
   "end": 251.85,
   "text": "פשוט"
  },
  {
   "start": 252.93,
   "end": 254.41,
   "text": "ישב לו ממרר בבכי."
  },
  {
   "start": 257.16,
   "end": 258.06,
   "text": "שם בסלוצק"
  },
  {
   "start": 258.68,
   "end": 262.2,
   "text": "אף אחד לא רצה להיות כמו יוסלה."
  },
  {
   "start": 265.61,
   "end": 266.15,
   "text": "ויוסלה,"
  },
  {
   "start": 267.21,
   "end": 269.47,
   "text": "יוסלה החליק לו מטה אט אט"
  },
  {
   "start": 272.01,
   "end": 273.51,
   "text": "כשרגליו פגשו את הקרקע."
  },
  {
   "start": 274.69,
   "end": 276.91,
   "text": "הוא החל מתקדם לאיטו במעלה הרחוב,"
  },
  {
   "start": 278.01,
   "end": 278.53,
   "text": "פוסע,"
  },
  {
   "start": 279.53,
   "end": 280.35,
   "text": "מהורהר,"
  },
  {
   "start": 281.13,
   "end": 285.05,
   "text": "כשהמילים, המילים צפות ועולות להן שוב ושוב."
  },
  {
   "start": 289.32,
   "end": 290.8,
   "text": "אתה רוצה להיות כמו יוסלה?"
  },
  {
   "start": 291.8,
   "end": 293.18,
   "text": "אתה רוצה להיות כמו יוסלה?"
  },
  {
   "start": 294.9,
   "end": 295.36,
   "text": "יוסלה."
  },
  {
   "start": 296.28,
   "end": 297.34,
   "text": "יוסלה שם בפנים,"
  },
  {
   "start": 299.92,
   "end": 301.82,
   "text": "בתוך-תוכו לא היה רע."
  },
  {
   "start": 303.38,
   "end": 305.54,
   "text": "בעצם אין ילד רע."
  },
  {
   "start": 306.74,
   "end": 307.78,
   "text": "אין ילד רע."
  },
  {
   "start": 308.44,
   "end": 310.18,
   "text": "יש ילד שרע לו."
  },
  {
   "start": 312.96,
   "end": 313.58,
   "text": "ויוסלה,"
  },
  {
   "start": 314.28,
   "end": 317.76,
   "text": "יוסל לפתע הבין שהוא משמש כדוגמה,"
  },
  {
   "start": 318.78,
   "end": 320.16,
   "text": "כדוגמה לכל הלא-טוב,"
  },
  {
   "start": 322.71,
   "end": 323.95,
   "text": "כדוגמה הרעה בסלוצק,"
  },
  {
   "start": 326.28,
   "end": 332.06,
   "text": "החשש של כל משפחה בעיר שיהיה לה איזה יוסלשק כזה."
  },
  {
   "start": 335.32,
   "end": 335.86,
   "text": "והוא חשב,"
  },
  {
   "start": 337.22,
   "end": 338.02,
   "text": "אני יכול להיכנע,"
  },
  {
   "start": 339.08,
   "end": 339.88,
   "text": "אני יכול להפסיד,"
  },
  {
   "start": 341.18,
   "end": 344.36,
   "text": "לוותר, להרים ידיים, ככה אני,"
  },
  {
   "start": 344.92,
   "end": 347.1,
   "text": "זהו זה, זה כל מה שאני יכול להיות."
  },
  {
   "start": 354.58,
   "end": 355.6,
   "text": "אבל ישנה דרך אחרת."
  },
  {
   "start": 356.8,
   "end": 358.04,
   "text": "אפשר גם להילחם."
  },
  {
   "start": 359.22,
   "end": 359.96,
   "text": "להילחם,"
  },
  {
   "start": 360.92,
   "end": 361.88,
   "text": "ואולי גם,"
  },
  {
   "start": 362.44,
   "end": 363.96,
   "text": "ואולי גם לנצח."
  },
  {
   "start": 364.64,
   "end": 368.38,
   "text": "להילחם, ואולי גם לנצח."
  },
  {
   "start": 370.22,
   "end": 370.74,
   "text": "כך הוא חשב."
  },
  {
   "start": 372.88,
   "end": 374.02,
   "text": "ורגש של חיות,"
  },
  {
   "start": 374.68,
   "end": 376.98,
   "text": "רגש של חיות החל מציף את ליבו."
  },
  {
   "start": 381.31,
   "end": 382.15,
   "text": "אני יכול לנצח,"
  },
  {
   "start": 383.01,
   "end": 385.41,
   "text": "ואני יכול גם להרוויח,"
  },
  {
   "start": 386.07,
   "end": 390.41,
   "text": "להיות דבוק אל אבא שבשמיים,"
  },
  {
   "start": 391.07,
   "end": 393.49,
   "text": "אל מלך מלכי המלאכים הקדוש ברוך הוא."
  },
  {
   "start": 395.87,
   "end": 396.45,
   "text": "ויוסלה,"
  },
  {
   "start": 397.67,
   "end": 398.15,
   "text": "יוסלה,"
  },
  {
   "start": 399.59,
   "end": 400.67,
   "text": "שהיה ילד מיוחד,"
  },
  {
   "start": 404.28,
   "end": 408.18,
   "text": "יוסלה פסע הביתה כשההחלטה גואה בליבו."
  },
  {
   "start": 414.34,
   "end": 414.64,
   "text": "אבא,"
  },
  {
   "start": 415.72,
   "end": 416.96,
   "text": "אבא, אני רוצה לדבר איתך."
  },
  {
   "start": 418.6,
   "end": 419.46,
   "text": "אביו של יוסלה"
  },
  {
   "start": 420.8,
   "end": 423.34,
   "text": "העיף מבט טמא בבן שלו,"
  },
  {
   "start": 426.18,
   "end": 428.64,
   "text": "ברק מוזר ניצת לו בעיניו של יוסלה."
  },
  {
   "start": 429.94,
   "end": 430.2,
   "text": "אבא,"
  },
  {
   "start": 431.44,
   "end": 432.66,
   "text": "אבא, אני רוצה לדבר איתך."
  },
  {
   "start": 433.54,
   "end": 434.16,
   "text": "אני רוצה,"
  },
  {
   "start": 434.78,
   "end": 435.88,
   "text": "אני רוצה ללכת,"
  },
  {
   "start": 436.4,
   "end": 437.98,
   "text": "ללכת ללמוד בישיבה."
  },
  {
   "start": 438.8,
   "end": 440.6,
   "text": "אבא, אני רוצה ללכת ללמוד בישיבה."
  },
  {
   "start": 444.08,
   "end": 445.84,
   "text": "האב המופתע כמעט נפל מכיסאו."
  },
  {
   "start": 449.07,
   "end": 449.89,
   "text": "לישיבה?"
  },
  {
   "start": 453.04,
   "end": 454.22,
   "text": "כן, אבא, לישיבה."
  },
  {
   "start": 458.16,
   "end": 461.7,
   "text": "בביתו של יוסלה נשמעו צעדים כלילים."
  },
  {
   "start": 462.4,
   "end": 462.6,
   "text": "אמא,"
  },
  {
   "start": 463.34,
   "end": 464.52,
   "text": "אמא התקרבה אל אבא."
  },
  {
   "start": 465.76,
   "end": 469.46,
   "text": "ושני ההורים שכל כך כאבו את מצבם של הילד שלהם,"
  },
  {
   "start": 471.08,
   "end": 474.5,
   "text": "ושני ההורים שכל כך כאבו את מצבו של הילד שלהם,"
  },
  {
   "start": 476.02,
   "end": 476.58,
   "text": "הביטו בו"
  },
  {
   "start": 477.42,
   "end": 478.0,
   "text": "במבט שואל."
  },
  {
   "start": 482.54,
   "end": 485.46,
   "text": "הם לא ידעו, הם לא ידעו איך לומר לו,"
  },
  {
   "start": 486.36,
   "end": 487.7,
   "text": "שעוד לפני ישיבה"
  },
  {
   "start": 489.06,
   "end": 491.4,
   "text": "חובה עליו ללמוד לקרוא,"
  },
  {
   "start": 492.08,
   "end": 493.36,
   "text": "ללמוד לכתוב,"
  },
  {
   "start": 494.28,
   "end": 497.52,
   "text": "ובעצם להשלים את לימודי החומש,"
  },
  {
   "start": 499.84,
   "end": 500.48,
   "text": "המשניות,"
  },
  {
   "start": 504.46,
   "end": 505.34,
   "text": "אך מה הם יגידו לו?"
  },
  {
   "start": 507.04,
   "end": 511.08,
   "text": "איך הם ישברו את הרצון שלף את הנשמע בקולו?"
  },
  {
   "start": 512.84,
   "end": 513.16,
   "text": "בני,"
  },
  {
   "start": 514.3,
   "end": 514.9,
   "text": "פנתה אמא,"
  },
  {
   "start": 515.72,
   "end": 516.2,
   "text": "חשבת,"
  },
  {
   "start": 516.66,
   "end": 520.04,
   "text": "חשבת, בני, על איזה מקום ששם אתה רוצה לנסות,"
  },
  {
   "start": 520.56,
   "end": 521.82,
   "text": "ששם אתה רוצה להתחיל?"
  },
  {
   "start": 524.42,
   "end": 524.94,
   "text": "ויוסלה,"
  },
  {
   "start": 526.1,
   "end": 527.22,
   "text": "אולי מבלי משים,"
  },
  {
   "start": 527.9,
   "end": 529.84,
   "text": "הלא נתן להם הזדמנות להתאושש."
  },
  {
   "start": 530.94,
   "end": 531.24,
   "text": "כן,"
  },
  {
   "start": 531.78,
   "end": 532.6,
   "text": "יש לי מקום,"
  },
  {
   "start": 533.44,
   "end": 536.24,
   "text": "אליו אני רוצה להגיע, אליו אני רוצה להיכנס."
  },
  {
   "start": 537.04,
   "end": 539.7,
   "text": "אני רוצה ללמוד בישיבת וולוז'ין."
  },
  {
   "start": 540.48,
   "end": 543.12,
   "text": "אני רוצה ללמוד בישיבת וולוז'ין."
  },
  {
   "start": 545.68,
   "end": 548.1,
   "text": "וההורים החווירו,"
  },
  {
   "start": 549.26,
   "end": 549.84,
   "text": "החווירו כסיד."
  },
  {
   "start": 556.73,
   "end": 557.25,
   "text": "וולוז'ין."
  },
  {
   "start": 558.33,
   "end": 562.73,
   "text": "וולוז'ין הייתה הישיבה המובחרת ביותר, הישיבה מספר אחת בעולם התורה."
  },
  {
   "start": 564.09,
   "end": 566.67,
   "text": "לוולוז'ין היו מתקבלים רק הטובים ביותר."
  },
  {
   "start": 569.36,
   "end": 570.36,
   "text": "לוולוז'ין."
  },
  {
   "start": 571.76,
   "end": 576.24,
   "text": "כדי להגיע לוולוז'ין צריך להיות בקיאים במסכתות שלמות בשס."
  },
  {
   "start": 576.92,
   "end": 577.58,
   "text": "רק העילויים"
  },
  {
   "start": 578.4,
   "end": 579.86,
   "text": "הגיעו להיבחן בוולוז'ין."
  },
  {
   "start": 581.74,
   "end": 582.36,
   "text": "ולשם,"
  },
  {
   "start": 583.66,
   "end": 585.6,
   "text": "לשם לא פחות ולא יותר,"
  },
  {
   "start": 586.46,
   "end": 593.28,
   "text": "לוולוז'ין הגדולה יוסלה מסלוץ רוצה להגיע,"
  },
  {
   "start": 596.48,
   "end": 597.2,
   "text": "אבל יוסלה,"
  },
  {
   "start": 598.2,
   "end": 599.82,
   "text": "יוסלה היה נחוש בדעתו,"
  },
  {
   "start": 602.82,
   "end": 603.7,
   "text": "וההורים שלו"
  },
  {
   "start": 605.04,
   "end": 605.38,
   "text": "פשוט"
  },
  {
   "start": 607.87,
   "end": 608.77,
   "text": "לא יכלו לעמוד"
  },
  {
   "start": 610.25,
   "end": 611.05,
   "text": "מול הנחישות,"
  },
  {
   "start": 612.11,
   "end": 616.31,
   "text": "מול העוצמה הגדולה של הרצון של יהוסנה להיות,"
  },
  {
   "start": 616.97,
   "end": 617.83,
   "text": "להיות משהו."
  },
  {
   "start": 624.6,
   "end": 630.28,
   "text": "לא להיות עם הארץ, לא להיות בלי תורה, להיות משהו בעולם הזה,"
  },
  {
   "start": 630.86,
   "end": 633.3,
   "text": "ואחר כך שם בעולם הבא."
  },
  {
   "start": 636.36,
   "end": 638.8,
   "text": "לא נותר להם להורים אלא ללוות אותו."
  },
  {
   "start": 639.74,
   "end": 641.04,
   "text": "הם נפרדו ממנו בתפילה"
  },
  {
   "start": 641.8,
   "end": 652.12,
   "text": "שיצא לשלום וישוב מהרה לשלום ושלא ייפגע כל כך כשיצטרך כנראה לחזור כלאומת שבה."
  },
  {
   "start": 655.18,
   "end": 660.5,
   "text": "הם ידעו שליוסל'ה אין שום סיכוי וכך,"
  },
  {
   "start": 661.32,
   "end": 662.02,
   "text": "כך הוא יוצא לדרך,"
  },
  {
   "start": 663.12,
   "end": 663.58,
   "text": "לדרך"
  },
  {
   "start": 664.5,
   "end": 666.2,
   "text": "של מספר שבועות."
  },
  {
   "start": 668.36,
   "end": 669.24,
   "text": "כך הוא יוצא לדרך,"
  },
  {
   "start": 670.8,
   "end": 671.84,
   "text": "דרך ארוכה."
  },
  {
   "start": 673.28,
   "end": 674.0,
   "text": "הוא מצטווט"
  },
  {
   "start": 674.54,
   "end": 676.4,
   "text": "לעגלות"
  },
  {
   "start": 678.5,
   "end": 679.68,
   "text": "שנושאות עגלונים,"
  },
  {
   "start": 680.8,
   "end": 682.32,
   "text": "שנושאות נושאים יהודים."
  },
  {
   "start": 684.04,
   "end": 685.5,
   "text": "עגלות עם עגלונים יהודים,"
  },
  {
   "start": 686.52,
   "end": 688.24,
   "text": "כך זה היה אז בזמנים ההם,"
  },
  {
   "start": 689.02,
   "end": 690.1,
   "text": "ממקום למקום."
  },
  {
   "start": 691.44,
   "end": 693.9,
   "text": "היית נודד שבועות בדרכים."
  },
  {
   "start": 695.08,
   "end": 697.1,
   "text": "והעגלונים שואלים, לאן אתה צריך ילד?"
  },
  {
   "start": 698.3,
   "end": 698.98,
   "text": "והוא עונה,"
  },
  {
   "start": 699.7,
   "end": 701.96,
   "text": "לוולוז'ין, לישיבת וולוז'ין."
  },
  {
   "start": 705.04,
   "end": 705.22,
   "text": "כך"
  },
  {
   "start": 705.8,
   "end": 707.9,
   "text": "ועונה נחוש בדעתו,"
  },
  {
   "start": 708.9,
   "end": 714.06,
   "text": "לא שם לב לגיחוכים סמויים שמלווים את דרכו שבועיים,"
  },
  {
   "start": 723.61,
   "end": 725.27,
   "text": "שבועיים אחר כך."
  },
  {
   "start": 727.67,
   "end": 729.05,
   "text": "שערי ישיבת וולוז'ין"
  },
  {
   "start": 729.63,
   "end": 730.41,
   "text": "נפתחים להם,"
  },
  {
   "start": 731.25,
   "end": 732.71,
   "text": "ודמות של נער קטן"
  },
  {
   "start": 733.33,
   "end": 734.73,
   "text": "נראתה לה מתקרבת"
  },
  {
   "start": 735.33,
   "end": 736.39,
   "text": "אל דלתות הישיבה."
  },
  {
   "start": 741.18,
   "end": 742.32,
   "text": "דלתות הישיבה נפתחות,"
  },
  {
   "start": 743.38,
   "end": 747.98,
   "text": "ואת פניו של הנער יוסלה שנכנס אל אולם הישיבה"
  },
  {
   "start": 748.82,
   "end": 750.76,
   "text": "קידמו קולות הלומדים."
  },
  {
   "start": 752.72,
   "end": 753.2,
   "text": "לרגע,"
  },
  {
   "start": 754.08,
   "end": 755.98,
   "text": "לרגע הוא חש בפחד,"
  },
  {
   "start": 757.0,
   "end": 757.64,
   "text": "פחד בלב."
  },
  {
   "start": 759.64,
   "end": 761.14,
   "text": "כאילו איזה קול פנימי אומר לו,"
  },
  {
   "start": 761.9,
   "end": 762.96,
   "text": "ברח, יוסלה."
  },
  {
   "start": 763.66,
   "end": 765.14,
   "text": "ברח, יוסלה, זה לא בשבילך."
  },
  {
   "start": 765.88,
   "end": 766.9,
   "text": "תחזור לגגות."
  },
  {
   "start": 767.54,
   "end": 770.6,
   "text": "תחזור ליונים, לכלבים, לרחוב."
  },
  {
   "start": 771.06,
   "end": 772.04,
   "text": "מה אתה עושה פה?"
  },
  {
   "start": 773.06,
   "end": 774.3,
   "text": "יוסלה, עזוב אותך."
  },
  {
   "start": 775.6,
   "end": 777.64,
   "text": "יוסלה, זה לא בשבילך, תחזור חזרה."
  },
  {
   "start": 778.2,
   "end": 781.7,
   "text": "ככה זעק איזה קול, קול פנימי בתוכו."
  },
  {
   "start": 783.2,
   "end": 783.98,
   "text": "והוא נותר קפוא,"
  },
  {
   "start": 784.6,
   "end": 786.04,
   "text": "קפוא על עומדו,"
  },
  {
   "start": 788.2,
   "end": 789.06,
   "text": "קפוא על מקומו."
  },
  {
   "start": 793.0,
   "end": 793.98,
   "text": "אבל אז נשמע קול,"
  },
  {
   "start": 794.7,
   "end": 795.56,
   "text": "אה, סליחה?"
  },
  {
   "start": 796.48,
   "end": 797.68,
   "text": "במה ניתן לעזור לך?"
  },
  {
   "start": 799.3,
   "end": 802.7,
   "text": "קולו של אחד מהבחורים קטע את מחשבותיו,"
  },
  {
   "start": 803.9,
   "end": 804.52,
   "text": "את פחדיו."
  },
  {
   "start": 806.38,
   "end": 806.5,
   "text": "אני,"
  },
  {
   "start": 807.16,
   "end": 808.24,
   "text": "אני רוצה את ראש הישיבה."
  },
  {
   "start": 809.26,
   "end": 810.84,
   "text": "היכן נמצא ראש הישיבה?"
  },
  {
   "start": 819.89,
   "end": 820.57,
   "text": "ראש הישיבה?"
  },
  {
   "start": 821.53,
   "end": 822.13,
   "text": "שם למעלה."
  },
  {
   "start": 823.15,
   "end": 825.53,
   "text": "בקומה השנייה, במעלה המדרגות,"
  },
  {
   "start": 826.01,
   "end": 828.37,
   "text": "יש חדר, החדר של ראש הישיבה."
  },
  {
   "start": 831.06,
   "end": 832.26,
   "text": "ראש ישיבת וולוז'ין."
  },
  {
   "start": 833.32,
   "end": 836.42,
   "text": "היה לו פחות ולא יותר מאשר הגאון הגדול,"
  },
  {
   "start": 837.08,
   "end": 838.68,
   "text": "הגאון רבי חיימה וולוז'ין,"
  },
  {
   "start": 842.04,
   "end": 844.38,
   "text": "בעל מחבר הספר נפש החיים."
  },
  {
   "start": 846.34,
   "end": 848.04,
   "text": "אל ראש הישיבה לא מגיעים כך סתם."
  },
  {
   "start": 850.04,
   "end": 854.44,
   "text": "מי שרוצה להתקבל לישיבת וולוז'ין היה נבחן אצל המלמדים,"
  },
  {
   "start": 854.44,
   "end": 857.08,
   "text": "אצל הרבנים בישיבה, לא אצל ראש הישיבה."
  },
  {
   "start": 859.36,
   "end": 862.18,
   "text": "אבל הבחור שהפנה את יוסלו היה משוכנע,"
  },
  {
   "start": 862.88,
   "end": 864.68,
   "text": "על פי הביטחון שבקולו של הנער,"
  },
  {
   "start": 865.52,
   "end": 866.94,
   "text": "שהוא בן משפחה של הרב."
  },
  {
   "start": 867.86,
   "end": 870.68,
   "text": "לכן הוא הפנה אותו הישר אל חדר ראש הישיבה."
  },
  {
   "start": 894.78,
   "end": 895.22,
   "text": "הדפיקות,"
  },
  {
   "start": 896.26,
   "end": 897.04,
   "text": "הדפיקות בדלת,"
  },
  {
   "start": 898.48,
   "end": 901.56,
   "text": "גרמו לגאון הגדול רבי חיים מבולוז'ין"
  },
  {
   "start": 902.88,
   "end": 903.8,
   "text": "להרים את עיניו."
  },
  {
   "start": 907.76,
   "end": 908.2,
   "text": "כן, הוא אמר,"
  },
  {
   "start": 909.86,
   "end": 910.4,
   "text": "והדלת,"
  },
  {
   "start": 911.34,
   "end": 912.44,
   "text": "והדלת נפתחה."
  },
  {
   "start": 913.34,
   "end": 913.7,
   "text": "בפתח,"
  },
  {
   "start": 914.62,
   "end": 916.22,
   "text": "בפתח עמד נער לא מוכר."
  },
  {
   "start": 917.64,
   "end": 918.68,
   "text": "ראש ישיבה שהופתע"
  },
  {
   "start": 919.6,
   "end": 920.38,
   "text": "סימן לו להיכנס,"
  },
  {
   "start": 921.92,
   "end": 924.96,
   "text": "ויוסלה, יוסלה נכנס אל הקודש פנימה."
  },
  {
   "start": 927.58,
   "end": 928.46,
   "text": "מה ברצונך, ילד?"
  },
  {
   "start": 930.2,
   "end": 931.98,
   "text": "אני, אני רוצה ללמוד בישיבה."
  },
  {
   "start": 933.92,
   "end": 934.7,
   "text": "רבי חיים מביט"
  },
  {
   "start": 935.46,
   "end": 936.9,
   "text": "בילד שלמולו הרוקות."
  },
  {
   "start": 939.48,
   "end": 940.64,
   "text": "ומה אתה יודע ללמוד?"
  },
  {
   "start": 942.42,
   "end": 943.32,
   "text": "אני לא יודע ללמוד."
  },
  {
   "start": 944.76,
   "end": 945.48,
   "text": "אני לא יודע ללמוד,"
  },
  {
   "start": 946.22,
   "end": 946.8,
   "text": "אנא יוסלה,"
  },
  {
   "start": 949.71,
   "end": 951.61,
   "text": "נאנח ראש הישיבה, טוב,"
  },
  {
   "start": 952.57,
   "end": 954.43,
   "text": "אבל לפחות משניות אתה יודע."
  },
  {
   "start": 955.53,
   "end": 955.77,
   "text": "לא,"
  },
  {
   "start": 956.71,
   "end": 958.11,
   "text": "גם משניות אני לא יודע."
  },
  {
   "start": 959.47,
   "end": 960.31,
   "text": "קצת חומש?"
  },
  {
   "start": 961.77,
   "end": 962.07,
   "text": "לא,"
  },
  {
   "start": 963.05,
   "end": 963.83,
   "text": "גם חומש"
  },
  {
   "start": 964.45,
   "end": 965.05,
   "text": "אני לא יודע."
  },
  {
   "start": 968.08,
   "end": 968.74,
   "text": "תגיד לי,"
  },
  {
   "start": 969.34,
   "end": 969.8,
   "text": "לקרוא"
  },
  {
   "start": 970.66,
   "end": 971.26,
   "text": "אתה יודע?"
  },
  {
   "start": 973.18,
   "end": 974.26,
   "text": "לכתוב אתה יודע?"
  },
  {
   "start": 975.88,
   "end": 976.16,
   "text": "לא."
  },
  {
   "start": 977.52,
   "end": 978.24,
   "text": "כבוד הרב,"
  },
  {
   "start": 979.5,
   "end": 981.4,
   "text": "גם לקרוא וגם לכתוב אני לא יודע."
  },
  {
   "start": 984.61,
   "end": 985.05,
   "text": "נאנח,"
  },
  {
   "start": 985.91,
   "end": 986.33,
   "text": "נאנח,"
  },
  {
   "start": 987.47,
   "end": 988.97,
   "text": "הגאון רבי חיים אבולוז'ין,"
  },
  {
   "start": 989.79,
   "end": 992.87,
   "text": "בני, היכן היית בני כל השנים?"
  },
  {
   "start": 994.69,
   "end": 997.51,
   "text": "ויוסלה הרכין, הרכין ראש ושתק."
  },
  {
   "start": 998.87,
   "end": 999.93,
   "text": "הדברים היו מובנים,"
  },
  {
   "start": 1000.69,
   "end": 1002.53,
   "text": "לא היה צריך להוסיף מילה."
  },
  {
   "start": 1009.52,
   "end": 1010.68,
   "text": "רבי חיים אבולוז'ין הביט,"
  },
  {
   "start": 1011.5,
   "end": 1013.0,
   "text": "הביט ביוסלה בעיניים חודרות,"
  },
  {
   "start": 1014.0,
   "end": 1014.6,
   "text": "ואז הוא קם"
  },
  {
   "start": 1015.48,
   "end": 1016.66,
   "text": "וקרא לעוזר שלו."
  },
  {
   "start": 1017.04,
   "end": 1019.68,
   "text": "תקרא לכל הרבנים המלמדים של הישיבה."
  },
  {
   "start": 1023.64,
   "end": 1024.46,
   "text": "והם נכנסו."
  },
  {
   "start": 1027.14,
   "end": 1027.76,
   "text": "אמר להם,"
  },
  {
   "start": 1028.96,
   "end": 1030.16,
   "text": "אמר להם ראש הישיבה,"
  },
  {
   "start": 1030.88,
   "end": 1031.02,
   "text": "אתה,"
  },
  {
   "start": 1032.34,
   "end": 1033.38,
   "text": "אתה רואה את הילד הזה?"
  },
  {
   "start": 1034.42,
   "end": 1035.7,
   "text": "אתה תלמד אותו לקרוא,"
  },
  {
   "start": 1036.68,
   "end": 1039.54,
   "text": "ואתה יש לך משימה ללמד אותו לכתוב,"
  },
  {
   "start": 1040.22,
   "end": 1040.64,
   "text": "ואתה?"
  },
  {
   "start": 1042.58,
   "end": 1044.12,
   "text": "פנה ראש הישיבה למלמד אחר,"
  },
  {
   "start": 1044.84,
   "end": 1046.14,
   "text": "אתה תלמד אותו חומש,"
  },
  {
   "start": 1047.22,
   "end": 1048.54,
   "text": "ואתה תלמד אותו משנה,"
  },
  {
   "start": 1049.72,
   "end": 1050.56,
   "text": "ואתה,"
  },
  {
   "start": 1051.4,
   "end": 1054.52,
   "text": "אחרי שהוא יסיים את זה תפתח לו את עולם הגמרא."
  },
  {
   "start": 1057.63,
   "end": 1058.55,
   "text": "איך קוראים לך ילד?"
  },
  {
   "start": 1060.25,
   "end": 1060.73,
   "text": "יוסלה."
  },
  {
   "start": 1061.75,
   "end": 1062.35,
   "text": "יוסלה."
  },
  {
   "start": 1063.49,
   "end": 1064.89,
   "text": "ברוכים הבאים לוולוז'ין."
  },
  {
   "start": 1076.01,
   "end": 1076.73,
   "text": "ויוסלה."
  },
  {
   "start": 1077.51,
   "end": 1081.87,
   "text": "יוסלה נכנס לישיבת וולוז'ין."
  },
  {
   "start": 1085.71,
   "end": 1094.15,
   "text": "כשיש רצון ויש דבקות בשמיים מנהלים את העניינים באופן מפתיע ביותר."
  },
  {
   "start": 1097.26,
   "end": 1100.22,
   "text": "יוסלה החל ללמוד, לקרוא ולכתוב."
  },
  {
   "start": 1101.52,
   "end": 1104.4,
   "text": "אחרי זה למד גם חומש וגם משנה."
  },
  {
   "start": 1105.78,
   "end": 1108.14,
   "text": "זה לא היה קל כלל ועיקר."
  },
  {
   "start": 1109.08,
   "end": 1109.98,
   "text": "הלימוד היה קשה,"
  },
  {
   "start": 1110.82,
   "end": 1111.78,
   "text": "הלימוד היה שוחק,"
  },
  {
   "start": 1112.84,
   "end": 1114.6,
   "text": "אבל יוסלה חרק שיניים"
  },
  {
   "start": 1118.3,
   "end": 1119.8,
   "text": "והחזיק את עצמו בכוח,"
  },
  {
   "start": 1120.48,
   "end": 1121.28,
   "text": "צמוד לכיסא."
  },
  {
   "start": 1123.28,
   "end": 1124.28,
   "text": "לומד ולומד,"
  },
  {
   "start": 1125.0,
   "end": 1129.59,
   "text": "גומע בצמא,"
  },
  {
   "start": 1130.35,
   "end": 1132.63,
   "text": "גומע גם בימים הקשים,"
  },
  {
   "start": 1133.33,
   "end": 1134.25,
   "text": "היו ימים טובים,"
  },
  {
   "start": 1134.73,
   "end": 1136.79,
   "text": "היו גם ימים לא כל כך קלים."
  },
  {
   "start": 1137.85,
   "end": 1138.37,
   "text": "אבל יוסלה,"
  },
  {
   "start": 1139.27,
   "end": 1140.41,
   "text": "יוסלה הוא בא להילחם,"
  },
  {
   "start": 1141.21,
   "end": 1143.55,
   "text": "הוא בא להילחם והוא נלחם."
  },
  {
   "start": 1146.61,
   "end": 1150.31,
   "text": "וגם כשבאו חברים בהצעות כאלו ואחרות,"
  },
  {
   "start": 1150.87,
   "end": 1151.37,
   "text": "הוא סירב"
  },
  {
   "start": 1152.01,
   "end": 1152.87,
   "text": "מכל וכול,"
  },
  {
   "start": 1153.63,
   "end": 1154.19,
   "text": "אני לא נגרר,"
  },
  {
   "start": 1155.49,
   "end": 1156.75,
   "text": "אני לא חלק מהעדר."
  },
  {
   "start": 1160.01,
   "end": 1160.29,
   "text": "וכך,"
  },
  {
   "start": 1161.29,
   "end": 1164.01,
   "text": "גם כשוראה אותם נהנים לכאורה,"
  },
  {
   "start": 1164.77,
   "end": 1167.71,
   "text": "משתובבים להם בחוץ בנחת,"
  },
  {
   "start": 1168.23,
   "end": 1168.81,
   "text": "בקלילות,"
  },
  {
   "start": 1169.33,
   "end": 1170.19,
   "text": "ללא מחויבות,"
  },
  {
   "start": 1170.55,
   "end": 1178.98,
   "text": "ללא קשיים ולא היה קשה ולא היה קשה בלימוד,"
  },
  {
   "start": 1184.09,
   "end": 1185.93,
   "text": "אבל אני באתי,"
  },
  {
   "start": 1186.59,
   "end": 1187.47,
   "text": "אני באתי להילחם."
  },
  {
   "start": 1189.31,
   "end": 1198.13,
   "text": "יוסל'ה בא להילחם והוא לא התכוון לוותר בקלות, הוא התכוון להילחם, להילחם על מנת לנצח ולא להיגרר,"
  },
  {
   "start": 1198.35,
   "end": 1201.25,
   "text": "ולהיות מובל, ולא להיגרר ולהפסיד."
  },
  {
   "start": 1208.88,
   "end": 1209.98,
   "text": "שנתיים אחר כך"
  },
  {
   "start": 1210.62,
   "end": 1214.36,
   "text": "יוסלם יסלוצק מצטרף לחוג השמונה עשרה."
  },
  {
   "start": 1216.12,
   "end": 1216.92,
   "text": "חוג השמונה עשרה"
  },
  {
   "start": 1219.51,
   "end": 1219.99,
   "text": "היה חוג"
  },
  {
   "start": 1220.89,
   "end": 1222.47,
   "text": "מיוחד במינו בוולוז'י."
  },
  {
   "start": 1222.99,
   "end": 1232.48,
   "text": "שמונה עשרה שעות של לימוד רצופות מול הקיר."
  },
  {
   "start": 1239.47,
   "end": 1240.39,
   "text": "שמונה עשרה שעות"
  },
  {
   "start": 1241.45,
   "end": 1242.89,
   "text": "אתה לומד ולומד,"
  },
  {
   "start": 1243.71,
   "end": 1244.71,
   "text": "ורק שש שעות"
  },
  {
   "start": 1245.69,
   "end": 1250.35,
   "text": "שש שעות מיועדות לשאר, לשאר הדברים, לשאר הצרכים."
  },
  {
   "start": 1251.71,
   "end": 1253.19,
   "text": "זה החוג מיוחד."
  },
  {
   "start": 1253.87,
   "end": 1256.83,
   "text": "רק הטובים ביותר בוולוז'ין נמנו על החוג הזה."
  },
  {
   "start": 1261.07,
   "end": 1262.83,
   "text": "אחר זמן רב של מאמץ,"
  },
  {
   "start": 1263.59,
   "end": 1265.57,
   "text": "של יגיעה יומיומית,"
  },
  {
   "start": 1266.19,
   "end": 1269.09,
   "text": "של ויתור על חברים, על חיים קלים,"
  },
  {
   "start": 1269.61,
   "end": 1272.67,
   "text": "נפתח שער גדול בפני יוסלם."
  },
  {
   "start": 1273.25,
   "end": 1274.15,
   "text": "שערי תורה."
  },
  {
   "start": 1275.67,
   "end": 1276.53,
   "text": "שערי אורה."
  },
  {
   "start": 1277.45,
   "end": 1285.21,
   "text": "שערי טוהר הלב והלימוד נהיה באחת מושך כל כך מתוק מדבש."
  },
  {
   "start": 1300.39,
   "end": 1304.35,
   "text": "הדואר הגיע הכריז הדבר שהביא את המכתבים,"
  },
  {
   "start": 1304.87,
   "end": 1306.15,
   "text": "שהביא את המכתבים לישיבה."
  },
  {
   "start": 1307.19,
   "end": 1307.85,
   "text": "בין המכתבים"
  },
  {
   "start": 1308.83,
   "end": 1309.57,
   "text": "היה מכתב גם"
  },
  {
   "start": 1310.39,
   "end": 1310.75,
   "text": "עבור"
  },
  {
   "start": 1313.09,
   "end": 1313.99,
   "text": "יוסלם יסלוצק."
  },
  {
   "start": 1315.25,
   "end": 1315.71,
   "text": "היה זה מכתב"
  },
  {
   "start": 1317.21,
   "end": 1317.69,
   "text": "מאמא"
  },
  {
   "start": 1318.63,
   "end": 1322.91,
   "text": "במכתב אמא כותבת על שרפה גדולה שפרצה בעיר,"
  },
  {
   "start": 1325.52,
   "end": 1327.82,
   "text": "וגם חנות הבדים של אבא נפגעה,"
  },
  {
   "start": 1329.08,
   "end": 1329.74,
   "text": "ואבא עוסק"
  },
  {
   "start": 1331.18,
   "end": 1332.38,
   "text": "כיום בשיקום החנות."
  },
  {
   "start": 1334.5,
   "end": 1335.72,
   "text": "יוסלה לוקח את המכתב"
  },
  {
   "start": 1336.72,
   "end": 1338.0,
   "text": "ועולה בלב כבד"
  },
  {
   "start": 1338.82,
   "end": 1340.1,
   "text": "במעלה המדרגות,"
  },
  {
   "start": 1340.88,
   "end": 1342.68,
   "text": "הישאר אל חדר ראש הישיבה."
  },
  {
   "start": 1345.65,
   "end": 1346.09,
   "text": "הוא נכנס,"
  },
  {
   "start": 1348.93,
   "end": 1351.13,
   "text": "מראה את המכתב לראש הישיבה,"
  },
  {
   "start": 1354.5,
   "end": 1356.8,
   "text": "והגאון רבי חיים מבולוז'ין קורא את המכתב."
  },
  {
   "start": 1358.06,
   "end": 1362.56,
   "text": "כשסיים את קריאת המכתב הוא נאנח ואמר,"
  },
  {
   "start": 1364.0,
   "end": 1364.46,
   "text": "יוסלה,"
  },
  {
   "start": 1365.44,
   "end": 1366.32,
   "text": "יוסלה חזור ללימודים,"
  },
  {
   "start": 1368.95,
   "end": 1369.49,
   "text": "חזור ללימודים,"
  },
  {
   "start": 1370.53,
   "end": 1372.97,
   "text": "ויוסלה קם וחוזר"
  },
  {
   "start": 1373.89,
   "end": 1375.81,
   "text": "אל מעיין התורה הבלתי נדלה."
  },
  {
   "start": 1378.06,
   "end": 1379.12,
   "text": "חצי שנה אחר כך"
  },
  {
   "start": 1380.64,
   "end": 1382.26,
   "text": "מגיע עוד מכתב."
  },
  {
   "start": 1382.84,
   "end": 1386.2,
   "text": "אמא כותבת ומספרת שאבא בתקופה האחרונה"
  },
  {
   "start": 1388.44,
   "end": 1390.2,
   "text": "לא חש, לא חש בטוב."
  },
  {
   "start": 1392.16,
   "end": 1393.38,
   "text": "יוסלה לוקח את המכתב"
  },
  {
   "start": 1394.2,
   "end": 1395.38,
   "text": "ופוסע לו בכבדות,"
  },
  {
   "start": 1396.16,
   "end": 1399.92,
   "text": "ועולה במעלה המדרגות המובילות אל חדר ראש הישיבה."
  },
  {
   "start": 1403.07,
   "end": 1403.75,
   "text": "האם הכוונה"
  },
  {
   "start": 1405.63,
   "end": 1408.09,
   "text": "שיוסלה צריך לעזוב את הכול ולחזור לסלוץ?"
  },
  {
   "start": 1411.62,
   "end": 1413.5,
   "text": "הוא מציג את המכתב בפני ראש הישיבה."
  },
  {
   "start": 1414.84,
   "end": 1416.54,
   "text": "והגאון הגדול קורא,"
  },
  {
   "start": 1417.48,
   "end": 1417.88,
   "text": "נענח,"
  },
  {
   "start": 1419.12,
   "end": 1419.86,
   "text": "ובקול רועד"
  },
  {
   "start": 1420.48,
   "end": 1421.32,
   "text": "אומר יוסלה,"
  },
  {
   "start": 1422.1,
   "end": 1423.94,
   "text": "יוסלה, תחזור, תחזור ללמוד."
  },
  {
   "start": 1424.84,
   "end": 1427.38,
   "text": "את הלימוד בישיבה, את הלימוד שלך,"
  },
  {
   "start": 1428.42,
   "end": 1429.86,
   "text": "נזקוף לזכותו של אבא."
  },
  {
   "start": 1432.04,
   "end": 1433.4,
   "text": "אבא שלך צריך את הלימוד שלך,"
  },
  {
   "start": 1434.34,
   "end": 1435.14,
   "text": "את כוח התורה."
  },
  {
   "start": 1438.98,
   "end": 1439.48,
   "text": "ויוסלה,"
  },
  {
   "start": 1440.4,
   "end": 1441.88,
   "text": "יוסלה שומע לראש הישיבה,"
  },
  {
   "start": 1443.14,
   "end": 1443.94,
   "text": "לגדול התורה,"
  },
  {
   "start": 1444.66,
   "end": 1448.26,
   "text": "וחוזר לתורה האהובה כל כך,"
  },
  {
   "start": 1450.08,
   "end": 1452.14,
   "text": "שמקבלת אותו בזרועות פתוחות."
  },
  {
   "start": 1459.82,
   "end": 1460.76,
   "text": "כך עוברים הימים,"
  },
  {
   "start": 1468.2,
   "end": 1477.78,
   "text": "יום אחד הדבר משאיר ערימת מכתבים בפתח הישיבה ואחד מבחורי הישיבה הכניסם פנימה."
  },
  {
   "start": 1479.58,
   "end": 1481.48,
   "text": "כל אחד לקח את המכתב ומיועד לו."
  },
  {
   "start": 1482.42,
   "end": 1484.44,
   "text": "איש לא שם לב ליוסלה."
  },
  {
   "start": 1486.46,
   "end": 1486.94,
   "text": "יוסלה,"
  },
  {
   "start": 1488.18,
   "end": 1488.68,
   "text": "שעמד"
  },
  {
   "start": 1497.44,
   "end": 1500.42,
   "text": "לו במרכז האולם, במרכז אולם הישיבה,"
  },
  {
   "start": 1501.34,
   "end": 1502.02,
   "text": "מביט בדף"
  },
  {
   "start": 1502.66,
   "end": 1503.94,
   "text": "שממנו קרא זה עתה"
  },
  {
   "start": 1504.48,
   "end": 1505.92,
   "text": "את המכתב שהגיע עבורו"
  },
  {
   "start": 1506.56,
   "end": 1507.44,
   "text": "מאמו האהובה."
  },
  {
   "start": 1509.02,
   "end": 1509.44,
   "text": "יוסלה,"
  },
  {
   "start": 1511.46,
   "end": 1512.8,
   "text": "כשמכתב זה יגיע אליך,"
  },
  {
   "start": 1513.66,
   "end": 1514.64,
   "text": "כבר יסתיים הכל."
  },
  {
   "start": 1515.74,
   "end": 1518.88,
   "text": "אבל אני חייבת לבשר לך את אותה בשורת איוב,"
  },
  {
   "start": 1519.5,
   "end": 1519.7,
   "text": "אבא,"
  },
  {
   "start": 1520.5,
   "end": 1522.08,
   "text": "אבא שלך נפטר בפתאומיות,"
  },
  {
   "start": 1522.92,
   "end": 1523.48,
   "text": "איש לא צפה,"
  },
  {
   "start": 1526.66,
   "end": 1527.56,
   "text": "אבא נפטר."
  },
  {
   "start": 1529.2,
   "end": 1529.94,
   "text": "את השאר,"
  },
  {
   "start": 1530.84,
   "end": 1534.9,
   "text": "את השאר קרא יוסלה כבר בן עורפל, מבעד למסך,"
  },
  {
   "start": 1535.8,
   "end": 1541.36,
   "text": "מסך של דמעות שנגרו מעיניו וחנקו את גרונו."
  },
  {
   "start": 1543.28,
   "end": 1544.2,
   "text": "והוא עלה במדרגות,"
  },
  {
   "start": 1546.0,
   "end": 1547.34,
   "text": "מדרגה אחר מדרגה."
  },
  {
   "start": 1549.28,
   "end": 1558.42,
   "text": "הוא עלה במעלה המדרגות שלפתע נדמו לרגע כאינסופיות אל חדר ראש הישיבה."
  },
  {
   "start": 1559.6,
   "end": 1561.24,
   "text": "היא עושה להתיישב בדממה כאובה"
  },
  {
   "start": 1562.14,
   "end": 1563.28,
   "text": "והניח את המכתב"
  },
  {
   "start": 1565.34,
   "end": 1566.18,
   "text": "בשולחן הרב."
  },
  {
   "start": 1568.19,
   "end": 1568.69,
   "text": "רבי חיים,"
  },
  {
   "start": 1569.71,
   "end": 1570.71,
   "text": "רבי חיים אבולוז'ין,"
  },
  {
   "start": 1571.47,
   "end": 1572.33,
   "text": "קרא את המכתב."
  },
  {
   "start": 1577.98,
   "end": 1579.14,
   "text": "הוא הביט במבט רך"
  },
  {
   "start": 1579.82,
   "end": 1581.68,
   "text": "ומלא מלא צער"
  },
  {
   "start": 1582.78,
   "end": 1583.3,
   "text": "בתלמידו."
  },
  {
   "start": 1584.48,
   "end": 1585.14,
   "text": "ובעיניים,"
  },
  {
   "start": 1585.82,
   "end": 1589.14,
   "text": "בעיניו של ראש הישיבה שהחלו כבר לדמוע,"
  },
  {
   "start": 1590.28,
   "end": 1593.04,
   "text": "בעיניו של ראש הישיבה שהחלו, החלו לדמוע,"
  },
  {
   "start": 1593.68,
   "end": 1594.78,
   "text": "הוא אמר בקול שקט,"
  },
  {
   "start": 1596.32,
   "end": 1597.02,
   "text": "אבל כאוב."
  },
  {
   "start": 1597.72,
   "end": 1598.02,
   "text": "בני,"
  },
  {
   "start": 1599.56,
   "end": 1600.42,
   "text": "בני אהובי,"
  },
  {
   "start": 1601.44,
   "end": 1602.86,
   "text": "תתאבל על אבא שלך,"
  },
  {
   "start": 1604.38,
   "end": 1608.54,
   "text": "אבל מייד אחר כך תחזור כמה שיותר מהר,"
  },
  {
   "start": 1609.32,
   "end": 1614.62,
   "text": "תחזור כמה שיותר מהר אל עולם התורה שמחכה לך."
  },
  {
   "start": 1617.07,
   "end": 1619.67,
   "text": "הרב והתלמיד הביטו זה בזה במבט ארוך,"
  },
  {
   "start": 1620.61,
   "end": 1624.31,
   "text": "מבט של הבנה, מבט של חיזוק ועוצמה הדדיים,"
  },
  {
   "start": 1626.31,
   "end": 1628.59,
   "text": "ויוסלה פנה ויצא לאיתו,"
  },
  {
   "start": 1630.47,
   "end": 1630.87,
   "text": "יוצא,"
  },
  {
   "start": 1632.79,
   "end": 1636.09,
   "text": "למסע קצר של אבל על אביו,"
  },
  {
   "start": 1637.19,
   "end": 1639.55,
   "text": "וחוזר להמשיך את ניגון,"
  },
  {
   "start": 1640.31,
   "end": 1644.65,
   "text": "את ניגון התורה שמעולם לא פסק."
  },
  {
   "start": 1659.73,
   "end": 1660.79,
   "text": "חמש שנים אחר כך,"
  },
  {
   "start": 1664.62,
   "end": 1665.7,
   "text": "המשלחת הנכבדה"
  },
  {
   "start": 1668.34,
   "end": 1670.06,
   "text": "שפקדה את חדר ראש הישיבה"
  },
  {
   "start": 1671.0,
   "end": 1672.26,
   "text": "מילה את כל חלל החדר."
  },
  {
   "start": 1681.74,
   "end": 1683.74,
   "text": "נכבדי העיר סלוצק באו אל גדול הדור,"
  },
  {
   "start": 1684.12,
   "end": 1685.54,
   "text": "הגאון הגדול רבי חיים מבולוז'ין,"
  },
  {
   "start": 1686.98,
   "end": 1688.18,
   "text": "לקבל המלצה."
  },
  {
   "start": 1688.18,
   "end": 1694.76,
   "text": "רב עיר סלוצק נלקח לבית עולמו והם באו לקבל המלצה על רב חדש,"
  },
  {
   "start": 1695.46,
   "end": 1697.56,
   "text": "על גאון תורני שיכול,"
  },
  {
   "start": 1698.48,
   "end": 1702.14,
   "text": "יכול לעטר את העיר הנכבדה סלוצק."
  },
  {
   "start": 1710.38,
   "end": 1710.84,
   "text": "שומע,"
  },
  {
   "start": 1711.88,
   "end": 1713.42,
   "text": "שומע רבי חיים את בקשתם."
  },
  {
   "start": 1715.24,
   "end": 1716.68,
   "text": "אחר כך הוא קורא לעוזר שלו,"
  },
  {
   "start": 1717.32,
   "end": 1719.42,
   "text": "לוחש לו מספר מילים באוזנו,"
  },
  {
   "start": 1721.6,
   "end": 1722.42,
   "text": "והעוזר יוצא."
  },
  {
   "start": 1722.94,
   "end": 1727.4,
   "text": "ואז רבי חיים מבלוז'ין פונה אל המשלחת הכבודה ואומרים לו,"
  },
  {
   "start": 1728.02,
   "end": 1730.96,
   "text": "אתם מהעיר סלוצק, כמדומני, נכון?"
  },
  {
   "start": 1735.54,
   "end": 1737.9,
   "text": "אולי, אולי אתם זוכרים,"
  },
  {
   "start": 1738.52,
   "end": 1738.92,
   "text": "ילד,"
  },
  {
   "start": 1740.08,
   "end": 1741.48,
   "text": "ילד בשם יוסלה,"
  },
  {
   "start": 1742.14,
   "end": 1744.7,
   "text": "שהסתובב בסלוצק לפני מספר שנים,"
  },
  {
   "start": 1754.46,
   "end": 1755.68,
   "text": "חברי המשלחת לא אימצו את זיכרונם,"
  },
  {
   "start": 1756.74,
   "end": 1757.44,
   "text": "הם זכרו טוב,"
  },
  {
   "start": 1758.3,
   "end": 1758.9,
   "text": "הם נענחו,"
  },
  {
   "start": 1759.42,
   "end": 1760.38,
   "text": "ואמרו, כבוד הרב,"
  },
  {
   "start": 1761.04,
   "end": 1762.94,
   "text": "איך אפשר לשכוח את זה?"
  },
  {
   "start": 1763.5,
   "end": 1775.68,
   "text": "איך אפשר לשכוח את הצרה הזו שנחתה על העיר שלנו וברוך הוא וברוך שמו לפתע נעלמה כלעומת שבאה."
  },
  {
   "start": 1777.38,
   "end": 1785.78,
   "text": "יוסל היה מחולל הצהרות של איריס לוצק בחסדי השם יתברך כבוד הרב הוא נעלם בורח פתאומי והאמת כבוד הרב"
  },
  {
   "start": 1786.3,
   "end": 1791.84,
   "text": "איש אצלנו לא התיינן מדוע ולאן הוא נעלם פשוט"
  },
  {
   "start": 1792.62,
   "end": 1793.44,
   "text": "פשוט, כבוד הרב,"
  },
  {
   "start": 1794.26,
   "end": 1795.82,
   "text": "אבן כבדה נגולה מלב כולנו."
  },
  {
   "start": 1798.59,
   "end": 1799.19,
   "text": "אבל, כבוד הרב,"
  },
  {
   "start": 1800.05,
   "end": 1801.65,
   "text": "כבוד הרב, מדוע מזכיר לנו,"
  },
  {
   "start": 1802.57,
   "end": 1803.31,
   "text": "מזכיר לנו את זה?"
  },
  {
   "start": 1816.28,
   "end": 1816.78,
   "text": "דפיקות,"
  },
  {
   "start": 1817.78,
   "end": 1818.48,
   "text": "דפיקות בדלת,"
  },
  {
   "start": 1819.68,
   "end": 1820.9,
   "text": "קטעו את חילופי הדברים."
  },
  {
   "start": 1825.43,
   "end": 1825.85,
   "text": "כן,"
  },
  {
   "start": 1826.91,
   "end": 1827.89,
   "text": "אמר ראש הישיבה."
  },
  {
   "start": 1829.13,
   "end": 1829.71,
   "text": "והדלת"
  },
  {
   "start": 1830.33,
   "end": 1831.47,
   "text": "נפתחה לליטה,"
  },
  {
   "start": 1832.41,
   "end": 1833.83,
   "text": "ואל החדר נכנס פנימה."
  },
  {
   "start": 1834.57,
   "end": 1835.05,
   "text": "אברך,"
  },
  {
   "start": 1836.01,
   "end": 1836.91,
   "text": "הדור מראה."
  },
  {
   "start": 1837.83,
   "end": 1842.11,
   "text": "הבעל עיניים מתנוצצות להם באור יקרות של תורה."
  },
  {
   "start": 1843.37,
   "end": 1844.75,
   "text": "וכשהאברך נכנס,"
  },
  {
   "start": 1846.01,
   "end": 1847.13,
   "text": "אז קם גדול הדור,"
  },
  {
   "start": 1847.65,
   "end": 1849.45,
   "text": "הגאון הגדול רבי חיים מוולוז'ין,"
  },
  {
   "start": 1849.93,
   "end": 1851.83,
   "text": "ראש הישיבה קם מלא קומתו,"
  },
  {
   "start": 1852.61,
   "end": 1853.61,
   "text": "וכשהוא קם,"
  },
  {
   "start": 1854.27,
   "end": 1857.45,
   "text": "מיד קמו ראשי סלוץ גם הם,"
  },
  {
   "start": 1863.24,
   "end": 1866.18,
   "text": "וכולם מביטים באברי חדור המראה,"
  },
  {
   "start": 1867.62,
   "end": 1868.8,
   "text": "בעל העיניים המאירות,"
  },
  {
   "start": 1870.04,
   "end": 1870.36,
   "text": "ואז"
  },
  {
   "start": 1870.92,
   "end": 1871.84,
   "text": "הרים את ידו,"
  },
  {
   "start": 1872.48,
   "end": 1879.86,
   "text": "הגאון רבי חיים מוולוז'ין ואמר הנה הנה לפניכם יוסלה שלכם"
  },
  {
   "start": 1880.74,
   "end": 1882.74,
   "text": "זוכרים את יוסלה מסלוצק?"
  },
  {
   "start": 1884.52,
   "end": 1901.18,
   "text": "כבר הוא לא יוסלה מסלוצק לפניכם ניצב הגאון הגאון רבי יוסף פריימר מסלוצק לפניכם ניצב הגאון רבי יוסף מסלוצק והוא"
  },
  {
   "start": 1901.96,
   "end": 1905.06,
   "text": "והוא יהיה הרב של העיר סלוצק."
  },
  {
   "start": 1909.99,
   "end": 1912.15,
   "text": "כולם עמדו נרעשים,"
  },
  {
   "start": 1912.87,
   "end": 1913.39,
   "text": "המומים,"
  },
  {
   "start": 1914.55,
   "end": 1915.63,
   "text": "סביב הרב החדש,"
  },
  {
   "start": 1916.89,
   "end": 1917.45,
   "text": "מביטים,"
  },
  {
   "start": 1920.25,
   "end": 1921.47,
   "text": "מביטים בהערצה,"
  },
  {
   "start": 1923.37,
   "end": 1929.06,
   "text": "מביטים בהערצה ובהתפעלות ברב,"
  },
  {
   "start": 1929.64,
   "end": 1931.0,
   "text": "הרב החדש של סלוצק,"
  },
  {
   "start": 1931.78,
   "end": 1935.92,
   "text": "הגאון רבי יוסף מסלוצק."
  },
  {
   "start": 1942.07,
   "end": 1943.71,
   "text": "וסלוצק זכתה,"
  },
  {
   "start": 1944.55,
   "end": 1955.24,
   "text": "זכתה ברב מופלא שאיתר את העיר סלוצק והיה גאוות"
  },
  {
   "start": 1955.8,
   "end": 1961.37,
   "text": "העיר סלוצק ומיוסלה,"
  },
  {
   "start": 1962.15,
   "end": 1966.77,
   "text": "אותו יוסלה שם בין היונים בין הכלבים בין בעלי החיים."
  },
  {
   "start": 1969.22,
   "end": 1970.04,
   "text": "העיר סלוצק"
  },
  {
   "start": 1970.78,
   "end": 1974.42,
   "text": "זוכה לה לגאון רבי יוסף,"
  },
  {
   "start": 1975.3,
   "end": 1976.46,
   "text": "לסלוצק."
  },
  {
   "start": 1977.04,
   "end": 1979.38,
   "text": "ואימא, אימא של יוסלה,"
  },
  {
   "start": 1980.3,
   "end": 1985.44,
   "text": "אימא של יוסלה מרשה לעצמה לאחר שנים פשוט לבכות"
  },
  {
   "start": 1986.06,
   "end": 1991.48,
   "text": "ולבכות בבכי של שמחה שמחליף לו,"
  },
  {
   "start": 1992.88,
   "end": 1993.9,
   "text": "בכי של צער."
  },
  {
   "start": 1995.08,
   "end": 1996.24,
   "text": "ושם בשמיים,"
  },
  {
   "start": 1996.96,
   "end": 1998.9,
   "text": "שם בשמיים, אבא,"
  },
  {
   "start": 1999.5,
   "end": 2006.4,
   "text": "נשמתו של אביו של רבי יוסף מתענגת לה בגן עדן."
  },
  {
   "start": 2008.62,
   "end": 2011.36,
   "text": "בשמחה עד אין קץ."
  },
  {
   "start": 2034.79,
   "end": 2035.37,
   "text": "צריך לדעת"
  },
  {
   "start": 2036.65,
   "end": 2038.73,
   "text": "שלפני שנפרד"
  },
  {
   "start": 2040.25,
   "end": 2040.95,
   "text": "רבי יוסף"
  },
  {
   "start": 2041.67,
   "end": 2043.55,
   "text": "מסלוץ מישיבת וולוז'ין,"
  },
  {
   "start": 2044.37,
   "end": 2047.01,
   "text": "כינס הגאון רבי חיים מוולוז'ין את כל הישיבה."
  },
  {
   "start": 2048.39,
   "end": 2050.83,
   "text": "והוא אמר לפני כל הישיבה, במעמד כל הישיבה."
  },
  {
   "start": 2051.55,
   "end": 2052.85,
   "text": "הוא פנה לרבי יוסף ואמר לו,"
  },
  {
   "start": 2053.95,
   "end": 2055.55,
   "text": "רבי יוסף, אתה עמדת בקשיים,"
  },
  {
   "start": 2056.35,
   "end": 2059.51,
   "text": "עמדת בניסיונות אין ספור, נלחמת"
  },
  {
   "start": 2060.21,
   "end": 2060.59,
   "text": "וניצחת."
  },
  {
   "start": 2061.97,
   "end": 2063.87,
   "text": "נלחמת וניצחת."
  },
  {
   "start": 2066.06,
   "end": 2069.18,
   "text": "תדע לך, גם כשקיבלת מכתב על מצב העיר,"
  },
  {
   "start": 2069.96,
   "end": 2072.04,
   "text": "ויעצתי לך להישאר וללמוד,"
  },
  {
   "start": 2072.76,
   "end": 2076.96,
   "text": "ידעתי שאם תצא לסייע לבני העיר, תפסיד,"
  },
  {
   "start": 2077.4,
   "end": 2078.1,
   "text": "תפסיד הרבה,"
  },
  {
   "start": 2078.6,
   "end": 2079.44,
   "text": "אולי גם לא תחזור."
  },
  {
   "start": 2080.42,
   "end": 2083.48,
   "text": "ולכן גם כשקיבלת מכתב על אבא שחולה,"
  },
  {
   "start": 2084.5,
   "end": 2087.8,
   "text": "גם כן, למרות שהצטערתי עמוקות,"
  },
  {
   "start": 2088.26,
   "end": 2093.46,
   "text": "אבל הייתי חייב לשמור אותך מפני יצר הרע שניסה לשאוב אותך,"
  },
  {
   "start": 2093.92,
   "end": 2096.56,
   "text": "לקח אותך החוצה בכל מיני טוענות."
  },
  {
   "start": 2097.96,
   "end": 2098.48,
   "text": "וגם,"
  },
  {
   "start": 2099.36,
   "end": 2100.8,
   "text": "גם כשאיבדת את אבא שלך,"
  },
  {
   "start": 2101.98,
   "end": 2103.46,
   "text": "גם כשאביך נפטר,"
  },
  {
   "start": 2104.14,
   "end": 2105.4,
   "text": "נלקח לבית עולמו."
  },
  {
   "start": 2106.14,
   "end": 2106.9,
   "text": "ביקשתי ממך,"
  },
  {
   "start": 2107.56,
   "end": 2109.16,
   "text": "אחרי האבל תחזור מיד,"
  },
  {
   "start": 2110.0,
   "end": 2114.04,
   "text": "כי ידעתי שהיצר הרע יילחם עד הרגע האחרון,"
  },
  {
   "start": 2114.8,
   "end": 2117.24,
   "text": "ואת זה כל אחד, כל יהודי, צריך לדעת."
  },
  {
   "start": 2118.68,
   "end": 2120.4,
   "text": "כל יהודי שלומד תורה,"
  },
  {
   "start": 2120.76,
   "end": 2122.26,
   "text": "כל יהודי שמתקרב לשם,"
  },
  {
   "start": 2122.66,
   "end": 2127.48,
   "text": "כל יהודי שנמצא בתלמוד תורה, בישיבה קטנה, בישיבה גדולה,"
  },
  {
   "start": 2127.8,
   "end": 2132.32,
   "text": "בכל מקום שהוא נמצא והוא רוצה להידבק אל התורה הקדושה,"
  },
  {
   "start": 2132.86,
   "end": 2137.92,
   "text": "בכל מקום שהוא רוצה להידבק אל התורה הקדושה, אל הקדוש ברוך הוא,"
  },
  {
   "start": 2138.24,
   "end": 2141.02,
   "text": "צריך לדעת שהיצר רע יילחם עד הרגע האחרון."
  },
  {
   "start": 2141.48,
   "end": 2146.4,
   "text": "והיצר רע מסוגל גם לפגוע בעיר שלמה על מנת"
  },
  {
   "start": 2146.56,
   "end": 2148.9,
   "text": "להוציא בחור אחד מן הישיבה,"
  },
  {
   "start": 2149.34,
   "end": 2152.2,
   "text": "להוציא בחור אחד, נשמה אחת מן התורה,"
  },
  {
   "start": 2153.2,
   "end": 2154.3,
   "text": "הוא יעשה את הכול."
  },
  {
   "start": 2155.2,
   "end": 2156.66,
   "text": "אתה יוסלה, נלחמת,"
  },
  {
   "start": 2157.44,
   "end": 2158.12,
   "text": "לא התייאשת,"
  },
  {
   "start": 2158.88,
   "end": 2162.64,
   "text": "וגם כשהיה קשה לא ויתרת וניצחת."
  },
  {
   "start": 2163.68,
   "end": 2175.02,
   "text": "וניצחת כמו עשרות ומאות של בחורים שנלחמים ומנצחים והם ינצחו והם ימשיכו את התורה הקדושה,"
  },
  {
   "start": 2175.36,
   "end": 2179.0,
   "text": "את דרך התורה הקדושה, את דרך עם ישראל הקדוש."
  },
  {
   "start": 2179.88,
   "end": 2182.48,
   "text": "ויינצחו, ויזכו בעולם הזה,"
  },
  {
   "start": 2183.02,
   "end": 2184.28,
   "text": "ויזכו בעולם הבא."
  },
  {
   "start": 2189.3,
   "end": 2190.96,
   "text": "כך אמר בהתרגשות גדולה"
  },
  {
   "start": 2191.76,
   "end": 2192.5,
   "text": "הגאון הגדול,"
  },
  {
   "start": 2193.16,
   "end": 2194.46,
   "text": "רבי חיים מפולוז'ין,"
  },
  {
   "start": 2196.32,
   "end": 2198.12,
   "text": "בפני בחורי הישיבה."
  },
  {
   "start": 2200.34,
   "end": 2203.34,
   "text": "ורבי יוסף מסלוצק יצא אל דרכו,"
  },
  {
   "start": 2203.96,
   "end": 2205.14,
   "text": "אל דרכו החדשה,"
  },
  {
   "start": 2205.76,
   "end": 2206.62,
   "text": "דרך של תורה,"
  },
  {
   "start": 2207.2,
   "end": 2210.16,
   "text": "דרך של קדושה, דרך של הצלחה."
  },
  {
   "start": 2212.0,
   "end": 2212.98,
   "text": "כשהוא סולל,"
  },
  {
   "start": 2213.7,
   "end": 2216.24,
   "text": "כשהוא סולל דרך לכל,"
  },
  {
   "start": 2217.18,
   "end": 2220.54,
   "text": "לכל ילדי ישראל, לכל בני ישראל,"
  },
  {
   "start": 2221.08,
   "end": 2222.76,
   "text": "דרך של הצלחה."
  }
 ]
