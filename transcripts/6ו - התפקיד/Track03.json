{
 "disc": "6ו - התפקיד",
 "track": "Track03",
 "duration": 1111.152,
 "segments": [
  {
   "start": 0.3,
   "end": 3.56,
   "text": "חגיגת האירוסים נחגגה בעיר וילנה"
  },
  {
   "start": 5.42,
   "end": 6.84,
   "text": "ברוב באר והדר."
  },
  {
   "start": 8.06,
   "end": 11.1,
   "text": "האולם היה מלא מפה לפה, איזו שמחה."
  },
  {
   "start": 12.18,
   "end": 16.92,
   "text": "היית יכול לראות את השמחה שורה על פני כולם, גברים, נשים."
  },
  {
   "start": 21.63,
   "end": 24.17,
   "text": "לא היה נראה שמשהו יכול להשבית את השמחה."
  },
  {
   "start": 54.13,
   "end": 54.41,
   "text": "לפתע"
  },
  {
   "start": 55.15,
   "end": 56.39,
   "text": "נשמע קולה של גיטה,"
  },
  {
   "start": 57.23,
   "end": 58.81,
   "text": "גיטה אשת השוחט של וילנה."
  },
  {
   "start": 61.32,
   "end": 64.38,
   "text": "היא פנתה לשתי נשים שהצטופפו להם שמה בפינה,"
  },
  {
   "start": 65.4,
   "end": 66.02,
   "text": "מה קרה?"
  },
  {
   "start": 67.34,
   "end": 68.14,
   "text": "ביום כזה,"
  },
  {
   "start": 68.72,
   "end": 70.32,
   "text": "בשמחה כזו בוכים?"
  },
  {
   "start": 73.03,
   "end": 73.93,
   "text": "מה אתם בוכות?"
  },
  {
   "start": 77.23,
   "end": 87.21,
   "text": "ועיני כל הנשים הופנן לאותן נשים שישבו ונראו כבתוך סעודת אבל ולא סעודת שמחה."
  },
  {
   "start": 91.39,
   "end": 93.11,
   "text": "אנשים קמו והחלו לעודד את האומללות,"
  },
  {
   "start": 94.29,
   "end": 99.17,
   "text": "וכך נוצרה התקהלות שכל אחת מעודדת במילה טובה, חיזוק קטן."
  },
  {
   "start": 100.89,
   "end": 101.49,
   "text": "ולא רק זה,"
  },
  {
   "start": 102.19,
   "end": 103.51,
   "text": "אלא אפילו אימא של הכלה."
  },
  {
   "start": 104.13,
   "end": 105.19,
   "text": "האימא של הכלה הופיעה."
  },
  {
   "start": 106.83,
   "end": 107.31,
   "text": "מה קרה?"
  },
  {
   "start": 111.4,
   "end": 112.64,
   "text": "הנשים האלה בוכות."
  },
  {
   "start": 113.38,
   "end": 114.18,
   "text": "לא מבינים למה."
  },
  {
   "start": 116.52,
   "end": 118.76,
   "text": "ואז היא פנתה אליהם ואמרה להם, נשים יקרות,"
  },
  {
   "start": 119.5,
   "end": 120.9,
   "text": "באתם להשתתף פה בשמחה"
  },
  {
   "start": 122.32,
   "end": 123.6,
   "text": "של אירוסי הבת שלי."
  },
  {
   "start": 143.62,
   "end": 144.76,
   "text": "מה אני יכולה לעזור לכם?"
  },
  {
   "start": 145.76,
   "end": 147.92,
   "text": "באתם להשתתף בשמחה של הבת שלי, אני רוצה שתשמחו."
  },
  {
   "start": 148.4,
   "end": 149.76,
   "text": "מה אני יכולה לעזור לכם?"
  },
  {
   "start": 151.5,
   "end": 152.7,
   "text": "ואז לפתע פרצה בבכי,"
  },
  {
   "start": 153.6,
   "end": 154.0,
   "text": "האחת,"
  },
  {
   "start": 154.96,
   "end": 156.24,
   "text": "זו המבוגרת יותר."
  },
  {
   "start": 157.14,
   "end": 157.54,
   "text": "את לא יכולה."
  },
  {
   "start": 158.44,
   "end": 158.9,
   "text": "את לא יכולה."
  },
  {
   "start": 160.58,
   "end": 161.46,
   "text": "אולי בכל אופן."
  },
  {
   "start": 161.88,
   "end": 163.16,
   "text": "תגידי לי אולי בכל אופן."
  },
  {
   "start": 168.92,
   "end": 169.14,
   "text": "ואז"
  },
  {
   "start": 170.0,
   "end": 171.02,
   "text": "היא הרימה את עיניה."
  },
  {
   "start": 171.68,
   "end": 174.06,
   "text": "ניכר היה שהיא חוששת לומר את מה שבליבה,"
  },
  {
   "start": 174.68,
   "end": 174.8,
   "text": "אבל,"
  },
  {
   "start": 175.4,
   "end": 176.34,
   "text": "אבל היא עזרה עוז."
  },
  {
   "start": 177.04,
   "end": 178.24,
   "text": "אבל היא עזרה עוז ואמרה,"
  },
  {
   "start": 186.88,
   "end": 187.92,
   "text": "איך הבת שלי,"
  },
  {
   "start": 188.52,
   "end": 192.5,
   "text": "איך הבת שלי לא תבכה כשהיא רואה את החתן שלה"
  },
  {
   "start": 193.36,
   "end": 194.98,
   "text": "מתארס עם מישהי אחרת?"
  },
  {
   "start": 194.98,
   "end": 199.92,
   "text": "איך היא לא תבקה כשהיא רואה את החתן שלה מתארס עם מישהי אחרת?"
  },
  {
   "start": 202.92,
   "end": 203.9,
   "text": "והאימא של הכלה"
  },
  {
   "start": 205.62,
   "end": 206.38,
   "text": "מתעלפה"
  },
  {
   "start": 225.5,
   "end": 226.32,
   "text": "וזה היה אות"
  },
  {
   "start": 226.84,
   "end": 227.76,
   "text": "פרצה מהומה"
  },
  {
   "start": 271.72,
   "end": 273.18,
   "text": "כל האנשים הצטופפו סביבם"
  },
  {
   "start": 274.4,
   "end": 275.42,
   "text": "אנחנו מזהות אותו"
  },
  {
   "start": 276.96,
   "end": 278.1,
   "text": "זהו ברוך בנדט"
  },
  {
   "start": 280.38,
   "end": 281.74,
   "text": "הוא החתן של הבת שלי"
  },
  {
   "start": 283.18,
   "end": 284.2,
   "text": "כן, היינו"
  },
  {
   "start": 285.44,
   "end": 286.2,
   "text": "היינו בלבוב"
  },
  {
   "start": 287.02,
   "end": 287.62,
   "text": "הוא היה איתנו"
  },
  {
   "start": 288.56,
   "end": 290.94,
   "text": "כשהקוזאקים התנפלו ואנחנו נותרנו ניצולות,"
  },
  {
   "start": 291.54,
   "end": 293.58,
   "text": "כולם חשבו שאנחנו נהרגנו,"
  },
  {
   "start": 294.64,
   "end": 296.9,
   "text": "אבא שלה נהרג, בעלי נהרג,"
  },
  {
   "start": 297.6,
   "end": 299.88,
   "text": "היא יתומה ואני אלמנה מסתובבות,"
  },
  {
   "start": 302.56,
   "end": 305.1,
   "text": "מחפשות את החתן האבוד,"
  },
  {
   "start": 305.62,
   "end": 307.24,
   "text": "ובאנו ואנחנו רואים פה את החגיגות,"
  },
  {
   "start": 308.22,
   "end": 312.48,
   "text": "זה החתן של הבת שלי."
  },
  {
   "start": 312.88,
   "end": 313.86,
   "text": "האירוסים הופסקו,"
  },
  {
   "start": 317.17,
   "end": 320.89,
   "text": "ושעה אחר כך סיפרו שתי אנשים את מה שקרה בלב אווי מדויק."
  },
  {
   "start": 324.89,
   "end": 325.43,
   "text": "הם ניצלו,"
  },
  {
   "start": 326.37,
   "end": 327.59,
   "text": "הם איבדו את הכל, את האבא,"
  },
  {
   "start": 328.43,
   "end": 329.45,
   "text": "את כל הרכוש שלהם,"
  },
  {
   "start": 331.11,
   "end": 331.97,
   "text": "את החתן!"
  },
  {
   "start": 335.31,
   "end": 340.15,
   "text": "ועכשיו הן באות לכאן ומזהות למרות הצלקת בבירור, זהו ברוך בנדט."
  },
  {
   "start": 342.27,
   "end": 343.27,
   "text": "ולפתע מסתכלים,"
  },
  {
   "start": 343.83,
   "end": 345.51,
   "text": "כולם על החתן, על ברוך,"
  },
  {
   "start": 346.03,
   "end": 347.23,
   "text": "ברוך נתיישב לו באחת,"
  },
  {
   "start": 347.85,
   "end": 348.61,
   "text": "תופס את ראשו ונאנח,"
  },
  {
   "start": 350.25,
   "end": 351.31,
   "text": "כאילו משהו בראש שלו,"
  },
  {
   "start": 351.81,
   "end": 352.61,
   "text": "מתרחש,"
  },
  {
   "start": 354.61,
   "end": 355.23,
   "text": "כי מהם"
  },
  {
   "start": 356.21,
   "end": 357.49,
   "text": "מסע בערפל."
  },
  {
   "start": 357.49,
   "end": 363.69,
   "text": "החל מוחו של ברוך פרסה משחזר את מהלך חייו."
  },
  {
   "start": 365.77,
   "end": 368.57,
   "text": "זיכרונו של ברוך פרסה חזר אליו."
  },
  {
   "start": 370.95,
   "end": 371.57,
   "text": "אני ברוך בנדט."
  },
  {
   "start": 378.57,
   "end": 379.69,
   "text": "אני נולדתי בעיירה בוז'ד,"
  },
  {
   "start": 380.39,
   "end": 380.89,
   "text": "בליטא."
  },
  {
   "start": 381.57,
   "end": 383.35,
   "text": "הכל חזר, הכל חוזר אליו."
  },
  {
   "start": 387.16,
   "end": 388.04,
   "text": "הזיכרון חזר,"
  },
  {
   "start": 391.16,
   "end": 392.4,
   "text": "והאירוסים נעצרו."
  },
  {
   "start": 393.2,
   "end": 393.86,
   "text": "האירוסים הופסקו."
  },
  {
   "start": 395.3,
   "end": 396.36,
   "text": "בית הדין של וילנה"
  },
  {
   "start": 397.86,
   "end": 399.54,
   "text": "עמד בפני הכרעה חשובה."
  },
  {
   "start": 400.32,
   "end": 401.32,
   "text": "מה יעשה ברוך?"
  },
  {
   "start": 402.18,
   "end": 403.12,
   "text": "האם הוא מחויב"
  },
  {
   "start": 404.96,
   "end": 406.32,
   "text": "לכלה הראשונה שלו"
  },
  {
   "start": 406.96,
   "end": 407.94,
   "text": "או לכלה השנייה?"
  },
  {
   "start": 410.52,
   "end": 412.42,
   "text": "מקץ זמן ארוך של דיונים."
  },
  {
   "start": 415.12,
   "end": 415.98,
   "text": "החלטת בית הדין,"
  },
  {
   "start": 416.84,
   "end": 418.82,
   "text": "מאחר ותנאי השידוך הקודם,"
  },
  {
   "start": 422.07,
   "end": 423.07,
   "text": "השידוך הראשון,"
  },
  {
   "start": 423.65,
   "end": 426.03,
   "text": "אי אפשר שיתקיימו, אין להם כבר רכוש,"
  },
  {
   "start": 426.59,
   "end": 427.49,
   "text": "החותן נהרג,"
  },
  {
   "start": 428.05,
   "end": 428.71,
   "text": "אין כלום,"
  },
  {
   "start": 430.25,
   "end": 432.21,
   "text": "אז תמחו לו אותה כלה ראשונה"
  },
  {
   "start": 433.19,
   "end": 436.05,
   "text": "והוא יוכל להינשא עם הבת של העשיר, בת הגביר."
  },
  {
   "start": 437.29,
   "end": 442.11,
   "text": "אבל על מנת לפצות את האם ולפצות את הבת, שהיא תוכל להקים משפחה חדשה,"
  },
  {
   "start": 442.55,
   "end": 443.41,
   "text": "עתיד חדש,"
  },
  {
   "start": 443.93,
   "end": 446.17,
   "text": "ייתנו להם הזוג הצעיר,"
  },
  {
   "start": 447.61,
   "end": 449.11,
   "text": "ברוך ובת העשיר,"
  },
  {
   "start": 452.26,
   "end": 453.98,
   "text": "אותה בת עשיר שקראו לה לאה,"
  },
  {
   "start": 455.88,
   "end": 457.44,
   "text": "ייתנו להם נדוניה נכבדה."
  },
  {
   "start": 469.31,
   "end": 469.95,
   "text": "ובית הדין סיים."
  },
  {
   "start": 472.29,
   "end": 474.71,
   "text": "קהל המונים שבא והצטופף, רצו כולם לדעת"
  },
  {
   "start": 475.41,
   "end": 476.27,
   "text": "מה יהיה הפסיקה?"
  },
  {
   "start": 477.15,
   "end": 477.63,
   "text": "מה יהיה?"
  },
  {
   "start": 478.29,
   "end": 480.17,
   "text": "זה הסעיר את כל, את כל וילנה."
  },
  {
   "start": 481.23,
   "end": 482.65,
   "text": "כולם קמו,"
  },
  {
   "start": 484.85,
   "end": 489.44,
   "text": "אבל אז קם ברוך וביקש מכולם לשבת."
  },
  {
   "start": 492.44,
   "end": 492.96,
   "text": "והוא עמד,"
  },
  {
   "start": 494.62,
   "end": 495.66,
   "text": "וכולם ראו איך עיניו"
  },
  {
   "start": 496.72,
   "end": 497.54,
   "text": "מלאו דמעות."
  },
  {
   "start": 500.05,
   "end": 502.41,
   "text": "ואז הוא פנה ואמר, אני מבקש,"
  },
  {
   "start": 503.35,
   "end": 505.57,
   "text": "אני מבקש שכולם יבינו את רחשי ליבי."
  },
  {
   "start": 511.14,
   "end": 512.4,
   "text": "אומנם קל יותר,"
  },
  {
   "start": 513.28,
   "end": 514.28,
   "text": "ואולי נכון יותר,"
  },
  {
   "start": 514.94,
   "end": 517.52,
   "text": "להינשא ללאה, לבת הפרנס,"
  },
  {
   "start": 518.9,
   "end": 520.26,
   "text": "בת הגביר של וילנה."
  },
  {
   "start": 522.24,
   "end": 524.2,
   "text": "את צדקת, את צדקת."
  },
  {
   "start": 525.1,
   "end": 526.32,
   "text": "ואני לא יודע אם אני ראוי בשבילך."
  },
  {
   "start": 530.23,
   "end": 532.69,
   "text": "וזה קל יותר לי לבחור באמת"
  },
  {
   "start": 533.47,
   "end": 536.41,
   "text": "כמו החלטת בית הדין שאפשרו לי להינשא לך."
  },
  {
   "start": 538.75,
   "end": 539.85,
   "text": "אבל הכלה הראשונה"
  },
  {
   "start": 542.61,
   "end": 543.35,
   "text": "היא יתומה"
  },
  {
   "start": 545.11,
   "end": 545.97,
   "text": "וענייה."
  },
  {
   "start": 547.05,
   "end": 548.25,
   "text": "איבדה את אבא."
  },
  {
   "start": 548.91,
   "end": 550.33,
   "text": "איבדה את כל הרכוש שלה."
  },
  {
   "start": 551.01,
   "end": 552.19,
   "text": "אין לה כלום בעולם."
  },
  {
   "start": 553.37,
   "end": 554.37,
   "text": "כל כך סבלה,"
  },
  {
   "start": 555.15,
   "end": 557.27,
   "text": "וגם עכשיו היא סובלת."
  },
  {
   "start": 558.59,
   "end": 560.25,
   "text": "עד לכך שהיא באה,"
  },
  {
   "start": 560.77,
   "end": 563.77,
   "text": "באה לחגיגת ההרבוסין שלי ובוכה שם."
  },
  {
   "start": 564.99,
   "end": 569.67,
   "text": "וכי אני אבוא, ואני אוסיף לה עוד שער."
  },
  {
   "start": 572.19,
   "end": 575.59,
   "text": "אני אוסיף עוד שער לשכינה הקדושה."
  },
  {
   "start": 578.14,
   "end": 579.04,
   "text": "אני מבקש,"
  },
  {
   "start": 580.24,
   "end": 582.64,
   "text": "אני מבקש מלאה, מבת הפרנס,"
  },
  {
   "start": 583.3,
   "end": 584.0,
   "text": "תשנחי לי,"
  },
  {
   "start": 587.45,
   "end": 588.43,
   "text": "אני לא יכול ללכת"
  },
  {
   "start": 589.71,
   "end": 590.75,
   "text": "היכן שקל לי."
  },
  {
   "start": 591.51,
   "end": 595.13,
   "text": "אני צריך ללכת היכן שהקדוש ברוך הוא רוצה שאני אלך."
  },
  {
   "start": 596.55,
   "end": 598.23,
   "text": "אני לא יכול לצייר את היתומה."
  },
  {
   "start": 599.55,
   "end": 600.27,
   "text": "תביני אותי."
  },
  {
   "start": 612.51,
   "end": 613.55,
   "text": "דממה השתררה באולם."
  },
  {
   "start": 615.37,
   "end": 625.74,
   "text": "אנוכים התקשו לעכל את גודל קידוש השם שברוך בנדט מוכן לוותר על הכל."
  },
  {
   "start": 627.9,
   "end": 628.9,
   "text": "אבל אז לאה קמה."
  },
  {
   "start": 629.66,
   "end": 630.68,
   "text": "בת הפרנס קמה."
  },
  {
   "start": 631.5,
   "end": 635.22,
   "text": "וקראה, אני לא מוחלת לברוך,"
  },
  {
   "start": 635.68,
   "end": 638.12,
   "text": "אני לא מוחלת לחתן שלי, קראה,"
  },
  {
   "start": 641.12,
   "end": 642.3,
   "text": "אני לא מוחלת לך,"
  },
  {
   "start": 643.28,
   "end": 644.3,
   "text": "אלא בתנאי אחד,"
  },
  {
   "start": 645.88,
   "end": 646.9,
   "text": "שתאפשר"
  },
  {
   "start": 647.68,
   "end": 651.04,
   "text": "לי לתת את כל הנדוניה שלי"
  },
  {
   "start": 653.02,
   "end": 655.76,
   "text": "לך ולאותה יתומה,"
  },
  {
   "start": 656.48,
   "end": 659.82,
   "text": "כדי שתוכלו לפתוח דף חדש, דף מוצלח,"
  },
  {
   "start": 663.25,
   "end": 664.45,
   "text": "והיא פרצה בבכי."
  },
  {
   "start": 667.11,
   "end": 670.19,
   "text": "את הנתוניה שלי אני נותנת לכם."
  },
  {
   "start": 720.85,
   "end": 721.97,
   "text": "יהודי ויהודייה"
  },
  {
   "start": 723.19,
   "end": 728.21,
   "text": "שנותנים את כל העתיד שלהם לכבוד השם יתברך."
  },
  {
   "start": 729.99,
   "end": 731.99,
   "text": "יהודים ויהודייה פשוטים."
  },
  {
   "start": 732.57,
   "end": 740.17,
   "text": "יהודים ויהודייה פשוטים שבמקום שהם נמצאים קידשו שם שמיים כשהם חיים."
  },
  {
   "start": 746.55,
   "end": 752.91,
   "text": "אני לא מוחלת לחתן שלי, אלא אם הוא ייקח את הנתוניה שלי כמתנה."
  },
  {
   "start": 755.62,
   "end": 756.26,
   "text": "ובבית הדין,"
  },
  {
   "start": 759.77,
   "end": 760.53,
   "text": "חוט של התרגשות."
  },
  {
   "start": 762.01,
   "end": 764.11,
   "text": "קהל הנוכחים עמד על הרגליים שלו,"
  },
  {
   "start": 768.64,
   "end": 768.92,
   "text": "ואז"
  },
  {
   "start": 769.68,
   "end": 770.58,
   "text": "אני לא יודע מי התחיל,"
  },
  {
   "start": 771.16,
   "end": 771.96,
   "text": "אבל מישהו התחיל"
  },
  {
   "start": 772.62,
   "end": 773.74,
   "text": "בתנועות קצובות"
  },
  {
   "start": 774.7,
   "end": 775.84,
   "text": "למחוא כפיים,"
  },
  {
   "start": 778.2,
   "end": 783.84,
   "text": "וכל הקהל החלו בתנועות קצובות מוחאים כפיים."
  },
  {
   "start": 785.22,
   "end": 791.56,
   "text": "כמחווה של הערכה אל גדלות הרוח שנחשפה לעיניהם."
  },
  {
   "start": 794.62,
   "end": 805.01,
   "text": "מחיאות כפיים והפרנס אבא של לאה הנהן בראשו."
  },
  {
   "start": 806.23,
   "end": 807.13,
   "text": "אני מסכים,"
  },
  {
   "start": 807.71,
   "end": 808.57,
   "text": "אני מצטרף"
  },
  {
   "start": 809.23,
   "end": 810.45,
   "text": "אל בתי הצדקת."
  },
  {
   "start": 812.96,
   "end": 814.6,
   "text": "ומי שהיה מתבונן טוב יכל לראות"
  },
  {
   "start": 816.68,
   "end": 819.96,
   "text": "שמעיניו של האב בית דין דה וילנה"
  },
  {
   "start": 822.8,
   "end": 823.92,
   "text": "זלגה לדמעה הקטנה."
  },
  {
   "start": 833.66,
   "end": 834.26,
   "text": "הוא היה גאה"
  },
  {
   "start": 838.38,
   "end": 841.54,
   "text": "בבן בנו של מלך מלכי המלכים הקדוש ברוך הוא,"
  },
  {
   "start": 842.32,
   "end": 842.66,
   "text": "בבת"
  },
  {
   "start": 843.58,
   "end": 845.32,
   "text": "בתו של מלך מלכי המלכים הקדוש ברוך הוא."
  },
  {
   "start": 847.82,
   "end": 896.73,
   "text": "היה גאה שהוא יהודי בעיירה קטנה בליטא."
  },
  {
   "start": 898.71,
   "end": 900.61,
   "text": "בשם בוז'ד, עיירה בשם בוז'ד,"
  },
  {
   "start": 901.43,
   "end": 903.29,
   "text": "חיו להם ברוך בנדט,"
  },
  {
   "start": 904.25,
   "end": 908.53,
   "text": "ברוך פרסה ורעייתו חיים יהודים שמחים,"
  },
  {
   "start": 909.43,
   "end": 910.89,
   "text": "חיים יהודים שלמים,"
  },
  {
   "start": 912.17,
   "end": 913.43,
   "text": "הם זכו לבנים ובנות,"
  },
  {
   "start": 914.41,
   "end": 915.15,
   "text": "וכך היו להם"
  },
  {
   "start": 915.83,
   "end": 916.65,
   "text": "עד יום מותם."
  },
  {
   "start": 918.61,
   "end": 919.77,
   "text": "וגם לאה, בת הפרנס"
  },
  {
   "start": 920.71,
   "end": 921.37,
   "text": "של וילנה,"
  },
  {
   "start": 921.95,
   "end": 923.09,
   "text": "זכתה להינשא לתלמיד חכם,"
  },
  {
   "start": 924.11,
   "end": 925.97,
   "text": "להקים משפחה, בנים ובנות,"
  },
  {
   "start": 926.89,
   "end": 927.79,
   "text": "תלמידי חכמים,"
  },
  {
   "start": 928.97,
   "end": 931.93,
   "text": "וכל ימי חיים לא עזבה טורף וגדולה את שולחנם."
  },
  {
   "start": 933.91,
   "end": 934.33,
   "text": "בבוז'ד,"
  },
  {
   "start": 934.97,
   "end": 938.15,
   "text": "שנים רבות אחר מותו של ברוך פרסה,"
  },
  {
   "start": 938.85,
   "end": 943.75,
   "text": "עוד היו נוהגים תושבי בוז'ד לעלות אל קברו של רבי ברוך פרסה,"
  },
  {
   "start": 944.81,
   "end": 951.13,
   "text": "לומר תהילים ולבקש שנשמתו הטהורה תלמד סנגוריה על עם ישראל,"
  },
  {
   "start": 952.69,
   "end": 953.39,
   "text": "על כולנו."
  },
  {
   "start": 955.59,
   "end": 959.39,
   "text": "יהי זכרו ברוך של ברוך פרסה,"
  },
  {
   "start": 963.07,
   "end": 964.55,
   "text": "יהודי שקידש שם שמיים,"
  },
  {
   "start": 965.25,
   "end": 965.89,
   "text": "כשקשה,"
  },
  {
   "start": 966.75,
   "end": 967.69,
   "text": "כשחשוך,"
  },
  {
   "start": 968.71,
   "end": 970.31,
   "text": "של לאה בת הפרנס,"
  },
  {
   "start": 970.93,
   "end": 977.19,
   "text": "יהודייה שקידשה שם שמיים, שהסתכלה על רצון השם דווקא כשקשה,"
  },
  {
   "start": 977.63,
   "end": 978.67,
   "text": "דווקא כשחשוך,"
  },
  {
   "start": 979.13,
   "end": 981.75,
   "text": "דווקא כשנראה כאילו זה לא לטובתי,"
  },
  {
   "start": 982.29,
   "end": 984.03,
   "text": "היא הסתכלה על טובת השם,"
  },
  {
   "start": 984.49,
   "end": 992.75,
   "text": "יהודי ויהודייה קטנים שזכו להגיע לעירום השמיים,"
  },
  {
   "start": 993.29,
   "end": 997.14,
   "text": "לפסגות שכולנו,"
  },
  {
   "start": 997.56,
   "end": 1000.22,
   "text": "כולנו שואפים וכולנו יכולים להגיע אליהם."
  },
  {
   "start": 1000.22,
   "end": 1034.81,
   "text": "אם אנחנו ניקח את הדברים מעבר למקרה, מעבר לסיפור, מעבר לברוך, פרסה"
  },
  {
   "start": 1035.49,
   "end": 1037.73,
   "text": "ולרעייתו, מעבר לכולם, אלינו, אנחנו."
  },
  {
   "start": 1038.77,
   "end": 1039.89,
   "text": "אנחנו, תדעו לכם, אנחנו."
  },
  {
   "start": 1040.65,
   "end": 1041.57,
   "text": "אנחנו יכולים לקבוע."
  },
  {
   "start": 1042.55,
   "end": 1043.13,
   "text": "הרי כולנו,"
  },
  {
   "start": 1043.91,
   "end": 1044.91,
   "text": "כולנו,"
  },
  {
   "start": 1045.59,
   "end": 1047.33,
   "text": "אם לא יבוא משיח במהרה,"
  },
  {
   "start": 1048.49,
   "end": 1051.35,
   "text": "נגיע כולנו לבית הקברות. כולם."
  },
  {
   "start": 1053.37,
   "end": 1055.63,
   "text": "יש לנו אפשרות שאנחנו חיים עכשיו,"
  },
  {
   "start": 1056.27,
   "end": 1057.71,
   "text": "כשאנחנו חיים עכשיו,"
  },
  {
   "start": 1057.71,
   "end": 1060.37,
   "text": "להפוך את המסכת חיים שלנו לקודש קודשים."
  },
  {
   "start": 1060.97,
   "end": 1062.19,
   "text": "בידיים שלנו!"
  },
  {
   "start": 1064.21,
   "end": 1065.49,
   "text": "תדעו לכם, הזמן מוגבל."
  },
  {
   "start": 1066.19,
   "end": 1068.47,
   "text": "ברו העולם נותן לנו. בוא, אחותי אחי."
  },
  {
   "start": 1069.43,
   "end": 1070.89,
   "text": "יש לכם ניצוץ אלוקי."
  },
  {
   "start": 1071.35,
   "end": 1072.73,
   "text": "בואו תאירו את העולם."
  },
  {
   "start": 1073.21,
   "end": 1074.49,
   "text": "אל תבזבזו אותו."
  },
  {
   "start": 1075.25,
   "end": 1081.25,
   "text": "אל תבזבזו את האור האלוקי שיש לנו, לא נבזבז! ככה ברו העולם צועק לנו."
  },
  {
   "start": 1081.67,
   "end": 1084.47,
   "text": "בניי, בנותיי, בואו לא נבזבז אותו."
  },
  {
   "start": 1085.01,
   "end": 1086.79,
   "text": "ואני מחויב לא לבזבז,"
  },
  {
   "start": 1087.13,
   "end": 1090.99,
   "text": "ואתה מחויב לא לבזבז, ואת מחויבת לא לבזבז אותו."
  },
  {
   "start": 1092.71,
   "end": 1096.27,
   "text": "כי בחושך של היום אפילו פנס קטן,"
  },
  {
   "start": 1096.65,
   "end": 1097.79,
   "text": "אפילו נר קטן,"
  },
  {
   "start": 1098.15,
   "end": 1102.27,
   "text": "ארשם נשמת אדם מאיר באפלה הזאת,"
  },
  {
   "start": 1102.69,
   "end": 1106.93,
   "text": "מאיר את העולם כולו באור יקרות, אור נגוהות."
  }
 ]
}