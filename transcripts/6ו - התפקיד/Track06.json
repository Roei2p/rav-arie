{
 "disc": "6ו - התפקיד",
 "track": "Track06",
 "duration": 308.16,
 "segments": [
  {
   "start": 0.54,
   "end": 2.22,
   "text": "תגידו לי, יש לי שאלה אלינו, כולנו."
  },
  {
   "start": 3.16,
   "end": 5.08,
   "text": "היה דורות קודמים קדושי עליון."
  },
  {
   "start": 5.88,
   "end": 8.1,
   "text": "הדור של הארי הקדוש, אתם יודעים מה זה הדור של הארי הקדוש?"
  },
  {
   "start": 9.16,
   "end": 10.58,
   "text": "צפת, מה זה צפת של אז?"
  },
  {
   "start": 11.64,
   "end": 12.74,
   "text": "למה לא אז בא משיח?"
  },
  {
   "start": 14.08,
   "end": 17.68,
   "text": "למה אומרים, בדור שלנו, הדור החשוך, יבוא משיח?"
  },
  {
   "start": 18.48,
   "end": 19.82,
   "text": "אתם יודעים מה היה בדור של צפת?"
  },
  {
   "start": 20.16,
   "end": 22.04,
   "text": "פילעק פלאות, איך לא בא שם משיח?"
  },
  {
   "start": 23.22,
   "end": 25.02,
   "text": "רב העיר היה שולחן ערוך,"
  },
  {
   "start": 26.16,
   "end": 26.94,
   "text": "רבי יוסף קארו."
  },
  {
   "start": 28.08,
   "end": 29.24,
   "text": "הדרשן של העיר,"
  },
  {
   "start": 30.0,
   "end": 31.92,
   "text": "האלשיך הקדוש, רבי משה אלשיך,"
  },
  {
   "start": 32.76,
   "end": 35.24,
   "text": "המקובל של העיר הארי הקדוש."
  },
  {
   "start": 36.58,
   "end": 37.86,
   "text": "הפייטנים של העיר,"
  },
  {
   "start": 38.6,
   "end": 40.88,
   "text": "הרב אלקבץ, בעל הלכה דודי,"
  },
  {
   "start": 41.54,
   "end": 42.18,
   "text": "הרב נג'רה."
  },
  {
   "start": 42.64,
   "end": 47.98,
   "text": "אתם מבינים על מה מדובר? איך, איך בדורות כאלה דור כזה לא בא משיח?"
  },
  {
   "start": 48.86,
   "end": 51.52,
   "text": "היו ראויים הכול, לא בא משיח, לא הצליחו,"
  },
  {
   "start": 51.94,
   "end": 55.12,
   "text": "ואנחנו על הדור שלנו, דור כזה חשוך,"
  },
  {
   "start": 55.84,
   "end": 56.86,
   "text": "איפה נביא משיח?"
  },
  {
   "start": 57.94,
   "end": 58.78,
   "text": "איך אפשר?"
  },
  {
   "start": 59.84,
   "end": 61.04,
   "text": "אבל תדעו לכם אותו דבר,"
  },
  {
   "start": 62.48,
   "end": 65.52,
   "text": "הם השיגו דברים נוראים וגדולים,"
  },
  {
   "start": 66.66,
   "end": 69.36,
   "text": "אבל לא יכלו, לא יכולים לרדת לתהומות,"
  },
  {
   "start": 69.84,
   "end": 71.2,
   "text": "לאיפה שאנחנו נמצאים,"
  },
  {
   "start": 71.56,
   "end": 73.02,
   "text": "לחושך שאנחנו נמצאים,"
  },
  {
   "start": 73.36,
   "end": 77.4,
   "text": "ושם לנקות ולהבריא את הכתר של המלך, של המשיח."
  },
  {
   "start": 78.64,
   "end": 79.96,
   "text": "ואנחנו כן יכולים,"
  },
  {
   "start": 80.78,
   "end": 85.86,
   "text": "עם הלוחמה שלנו, עם מסירות הנפש שלנו, עם החוסר ייאוש שלנו, לא להתייאש,"
  },
  {
   "start": 86.16,
   "end": 89.1,
   "text": "להמשיך על כל דבר קטן, להיאבק על כל מצווה קטנה,"
  },
  {
   "start": 89.46,
   "end": 91.0,
   "text": "על כל קידוש שם שמיים קטן,"
  },
  {
   "start": 91.34,
   "end": 93.16,
   "text": "על כל מיליגרם של צניעות,"
  },
  {
   "start": 93.48,
   "end": 94.98,
   "text": "על כל מיליגרם של טהרה,"
  },
  {
   "start": 95.34,
   "end": 96.9,
   "text": "על כל מיליגרם של מצווה,"
  },
  {
   "start": 97.22,
   "end": 97.84,
   "text": "של תפילין."
  },
  {
   "start": 98.22,
   "end": 103.64,
   "text": "לא לוותר, כי כל דבר שלנו בחושך של היום זה קידוש שם שמיים."
  },
  {
   "start": 104.0,
   "end": 106.84,
   "text": "כשיהודי מניח תפילין, הוא לא רק מניח תפילין,"
  },
  {
   "start": 107.3,
   "end": 108.88,
   "text": "הוא שם את השם של השם עליו,"
  },
  {
   "start": 109.16,
   "end": 110.44,
   "text": "הוא מקדש שם שמיים."
  },
  {
   "start": 110.78,
   "end": 113.98,
   "text": "כשיהודייה, כשיהודייה שומרת על הצניעות שלה,"
  },
  {
   "start": 114.46,
   "end": 116.54,
   "text": "היא מקדשת שם שמיים."
  },
  {
   "start": 116.88,
   "end": 120.84,
   "text": "זאת הבת של השם יתברך שעוברת ברחוב, כולם יודעים את זה."
  },
  {
   "start": 121.2,
   "end": 122.92,
   "text": "בלב בפנים כולם יודעים את זה."
  },
  {
   "start": 123.24,
   "end": 126.86,
   "text": "זה משהו אחר, זה יהלום, זה יהלום של השם יתברך."
  },
  {
   "start": 127.72,
   "end": 129.18,
   "text": "עם מסירות נפש,"
  },
  {
   "start": 129.82,
   "end": 130.64,
   "text": "עם טוהר."
  },
  {
   "start": 131.52,
   "end": 136.76,
   "text": "ככה הדורות הקודמים עם כל הגדולה וכל הקדושה לא השיגו את מה שפה אפשר להשיג."
  },
  {
   "start": 137.74,
   "end": 139.28,
   "text": "פה, בו, בחושך של היום."
  },
  {
   "start": 140.42,
   "end": 143.46,
   "text": "נסיכה עברה לה ביער, מלווה בשומרים,"
  },
  {
   "start": 143.94,
   "end": 145.2,
   "text": "שומרי ראש, בשרים."
  },
  {
   "start": 145.74,
   "end": 149.62,
   "text": "פתאום ירד גשם, צלעפות, בוץ, לכלוך."
  },
  {
   "start": 150.24,
   "end": 152.24,
   "text": "כל השרים פחדו על החליפות, התרחקו!"
  },
  {
   "start": 152.68,
   "end": 153.24,
   "text": "הלכו לתפוס מחסה."
  },
  {
   "start": 154.22,
   "end": 156.6,
   "text": "נותרה אותה נסיכה בודדה, אומללה."
  },
  {
   "start": 157.36,
   "end": 159.26,
   "text": "בא איזה איש פשוט, כפרי."
  },
  {
   "start": 160.08,
   "end": 161.88,
   "text": "מה מעניין אותו הגשם, בוץ?"
  },
  {
   "start": 163.2,
   "end": 165.34,
   "text": "הוא הולך, פתאום הוא רואה נסיכה."
  },
  {
   "start": 166.3,
   "end": 167.32,
   "text": "מה הבעיה? מה קרה?"
  },
  {
   "start": 167.9,
   "end": 169.8,
   "text": "בוכה אומר, אני, כולם עזבו אותי."
  },
  {
   "start": 170.52,
   "end": 171.76,
   "text": "איך אני אצא פה מהיער?"
  },
  {
   "start": 172.78,
   "end": 174.92,
   "text": "ברגע שהתחיל הרטיבות והלכלוך הם..."
  },
  {
   "start": 175.26,
   "end": 178.22,
   "text": "לא יכלו לסבול, נשארתי לבד, מי יוציא אותי?"
  },
  {
   "start": 178.86,
   "end": 180.1,
   "text": "אמר לה, אני אוציא אותך."
  },
  {
   "start": 181.28,
   "end": 183.08,
   "text": "לקח והוציא אותה מהיער,"
  },
  {
   "start": 183.82,
   "end": 185.5,
   "text": "מהלכלוך, מהזוהמה,"
  },
  {
   "start": 185.98,
   "end": 187.66,
   "text": "והחזיר אותה להיות נסיכה."
  },
  {
   "start": 188.32,
   "end": 190.54,
   "text": "ככה הנסיכה זו השכינה הקדושה,"
  },
  {
   "start": 191.26,
   "end": 196.84,
   "text": "ואנחנו אותם אנשים שיכולים ללכת עם כל היום, עם כל הקשיים של היום,"
  },
  {
   "start": 197.2,
   "end": 199.8,
   "text": "ולהוציא את השכינה, להקים את השכינה מהעפר שלה."
  },
  {
   "start": 200.4,
   "end": 201.62,
   "text": "כי מה שנשאר היום,"
  },
  {
   "start": 202.1,
   "end": 204.64,
   "text": "אחרי שכל גדולי עולם במשך שנים תקנו,"
  },
  {
   "start": 205.74,
   "end": 209.7,
   "text": "והשיגו ידע, והשיגו תורה, והשיגו קדושה, והשיגו קבלה."
  },
  {
   "start": 210.32,
   "end": 215.1,
   "text": "לנו נשאר לתקן את הקידוש שם שמיים שלנו בחושך של היום,"
  },
  {
   "start": 215.56,
   "end": 220.44,
   "text": "להעלות את הניצוצות האלה, לגלות את הניצוצות האלוקים בכל מקום שכף רגלנו דורכים שם."
  },
  {
   "start": 221.52,
   "end": 222.22,
   "text": "בכל מקום."
  },
  {
   "start": 222.9,
   "end": 226.4,
   "text": "לא לוותר, לא להתייאש. לדעת שכל דבר שלנו,"
  },
  {
   "start": 226.76,
   "end": 227.9,
   "text": "אם זה חינוך ילדים,"
  },
  {
   "start": 228.4,
   "end": 229.0,
   "text": "אם זה בריאות,"
  },
  {
   "start": 229.76,
   "end": 230.26,
   "text": "אם זה חסד,"
  },
  {
   "start": 231.02,
   "end": 231.74,
   "text": "אם זה תורה,"
  },
  {
   "start": 232.32,
   "end": 237.52,
   "text": "אם זה כל דבר שאנחנו עושים לכבוד השם יתברך"
  },
  {
   "start": 238.44,
   "end": 239.5,
   "text": "בדור הזה,"
  },
  {
   "start": 240.54,
   "end": 241.46,
   "text": "בדור שלנו,"
  },
  {
   "start": 242.18,
   "end": 243.66,
   "text": "זה משהו עצום."
  },
  {
   "start": 244.26,
   "end": 245.34,
   "text": "זה משהו עצום."
  },
  {
   "start": 246.1,
   "end": 248.12,
   "text": "ואנחנו צריכים לדעת לא להתאפס לייאוש."
  },
  {
   "start": 248.8,
   "end": 250.28,
   "text": "הרבה פעמים הייאוש הזה עופף אותך."
  },
  {
   "start": 250.94,
   "end": 254.02,
   "text": "לא נותן לך לזוז, לא נותן לך להתעורר, לא נותן לך להסתכל על עצמך,"
  },
  {
   "start": 254.34,
   "end": 260.06,
   "text": "להגיד בואנה תראה מה אני עושה לכבוד השם יתברך! תראה מה אני עושה לכבוד השם יתברך! אנשים לפעמים בצינוק מחשבתי,"
  },
  {
   "start": 260.76,
   "end": 264.76,
   "text": "תופסים את עצמם, נכנסים לאיזה בועקן, אבל אני כזה, אני ככה ו..."
  },
  {
   "start": 265.38,
   "end": 269.82,
   "text": "תסתכל על הנקודות הטובות שלך, איזה נפלא, מה אנחנו מדברים בכלל?"
  },
  {
   "start": 270.22,
   "end": 273.9,
   "text": "כמה יש היום יצורים בעולם? כמה יש בני אדם? מיליארדים!"
  },
  {
   "start": 274.88,
   "end": 280.02,
   "text": "כמה יש בתוכם באמת יהודים? כמה? מעט מיליונים."
  },
  {
   "start": 280.94,
   "end": 286.18,
   "text": "כמה יש בין היהודים בכלל? אנשים שהתקרבו לשם, נשים שהתקרבו לשם,"
  },
  {
   "start": 287.1,
   "end": 289.24,
   "text": "בנות צדיקות שהתקרבו לשם,"
  },
  {
   "start": 289.34,
   "end": 291.74,
   "text": "כמה יש לכל העולם?"
  },
  {
   "start": 292.12,
   "end": 293.9,
   "text": "מיליארדים, כמה אנחנו?"
  },
  {
   "start": 294.68,
   "end": 299.5,
   "text": "זה כמו איזה כיתה גדולה ואתם המצטיינים ואנחנו המצטיינים וכולנו!"
  },
  {
   "start": 300.02,
   "end": 301.58,
   "text": "לא העוגה, לא הקצפת,"
  },
  {
   "start": 301.94,
   "end": 304.52,
   "text": "הדובדבן שבקצפת של השם יתברך, אנחנו."
  }
 ]
}