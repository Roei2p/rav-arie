{
 "disc": "6ו - התפקיד",
 "track": "Track02",
 "duration": 1071.216,
 "segments": [
  {
   "start": 0.54,
   "end": 4.42,
   "text": "היום בחסדי השם יתברך נשמע מקרה שיחזק אותנו,"
  },
  {
   "start": 4.86,
   "end": 8.24,
   "text": "שייתן לנו קצת הסתכלות על הערך של קידוש שם שמיים,"
  },
  {
   "start": 8.7,
   "end": 10.86,
   "text": "של יהודי שבתוך החושך, דווקא כשקשה,"
  },
  {
   "start": 11.3,
   "end": 13.8,
   "text": "מגלה אז את היופי של הנשמה שלו."
  },
  {
   "start": 14.3,
   "end": 16.86,
   "text": "אז בואו בעזרת השם, בואו נרשה לעצמנו קצת רגעים,"
  },
  {
   "start": 17.26,
   "end": 18.26,
   "text": "רגעים של אמונה,"
  },
  {
   "start": 18.68,
   "end": 19.7,
   "text": "רגעים של חוויה."
  },
  {
   "start": 27.72,
   "end": 28.22,
   "text": "ליטא,"
  },
  {
   "start": 29.42,
   "end": 30.86,
   "text": "עיירה קטנה בשם בוז'ד."
  },
  {
   "start": 32.48,
   "end": 32.96,
   "text": "שם בליטא,"
  },
  {
   "start": 34.3,
   "end": 35.92,
   "text": "בבוז'ד, נולד,"
  },
  {
   "start": 36.68,
   "end": 37.68,
   "text": "נולד ברוך בנדט."
  },
  {
   "start": 39.22,
   "end": 40.34,
   "text": "ילד פיקח ומבריק."
  },
  {
   "start": 42.38,
   "end": 43.14,
   "text": "ברוך כישרונות."
  },
  {
   "start": 44.04,
   "end": 44.88,
   "text": "לומד בישיבה,"
  },
  {
   "start": 45.74,
   "end": 48.92,
   "text": "ישיבה של מצטיינים ומסיים גם בהצטיינות."
  },
  {
   "start": 51.92,
   "end": 54.58,
   "text": "יום אחד לישיבה מגיע סוחר עשיר מלבוב."
  },
  {
   "start": 57.14,
   "end": 58.14,
   "text": "סוחר עשיר אוהב תורה."
  },
  {
   "start": 61.63,
   "end": 63.39,
   "text": "הוא הגיע לישיבה בעקבות"
  },
  {
   "start": 65.65,
   "end": 68.31,
   "text": "החיפוש הממושך שלו אחרי חתן מתאים לבת שלו."
  },
  {
   "start": 69.13,
   "end": 71.41,
   "text": "וראשי הישיבה המליצו לו,"
  },
  {
   "start": 72.35,
   "end": 72.91,
   "text": "ברוך בנדט."
  },
  {
   "start": 80.18,
   "end": 81.28,
   "text": "זמן קצר אחר כך,"
  },
  {
   "start": 83.16,
   "end": 84.68,
   "text": "השידוך החל יוצא לפועל."
  },
  {
   "start": 85.66,
   "end": 86.72,
   "text": "הכלה הייתה מאושרת,"
  },
  {
   "start": 88.14,
   "end": 88.46,
   "text": "ברוך"
  },
  {
   "start": 89.18,
   "end": 89.92,
   "text": "היה שמח,"
  },
  {
   "start": 91.58,
   "end": 95.1,
   "text": "וביום ל״ג בעומר נחתמו להם התנאים."
  },
  {
   "start": 97.32,
   "end": 98.84,
   "text": "וכך ברוך יושב לו בישיבה,"
  },
  {
   "start": 99.68,
   "end": 101.7,
   "text": "ולקראת חג השברות, הממשמש הוא בא,"
  },
  {
   "start": 102.12,
   "end": 103.18,
   "text": "הוא מקבל הזמנה,"
  },
  {
   "start": 104.02,
   "end": 105.2,
   "text": "הזמנה לבית הורי הכלה,"
  },
  {
   "start": 105.9,
   "end": 106.34,
   "text": "ללבוב."
  },
  {
   "start": 107.56,
   "end": 110.14,
   "text": "לבוא לחגוג עמם את חג מתן תורה."
  },
  {
   "start": 113.02,
   "end": 113.88,
   "text": "ברוך היה נרגש."
  },
  {
   "start": 115.22,
   "end": 116.44,
   "text": "מעולם הוא לא יצא מבוז'ד"
  },
  {
   "start": 117.22,
   "end": 118.68,
   "text": "להגיע ללבוב העיר הגדולה,"
  },
  {
   "start": 122.83,
   "end": 123.21,
   "text": "וככה"
  },
  {
   "start": 124.47,
   "end": 143.51,
   "text": "הוא מגיע ללבוב לחגוג את חג השבועות שנת 1648. חג שבועות 1648. שעת ערב בלבוב."
  },
  {
   "start": 144.45,
   "end": 145.17,
   "text": "ברוך בנדט"
  },
  {
   "start": 146.37,
   "end": 147.91,
   "text": "עושה את השעות הראשונות בבית"
  },
  {
   "start": 149.17,
   "end": 150.11,
   "text": "חמיב לעתיד,"
  },
  {
   "start": 151.59,
   "end": 152.63,
   "text": "אבי המשודכת שלו."
  },
  {
   "start": 164.94,
   "end": 166.48,
   "text": "הרמוניה, שמחה, שלווה,"
  },
  {
   "start": 166.86,
   "end": 167.78,
   "text": "אופפת את המקום."
  },
  {
   "start": 168.16,
   "end": 169.6,
   "text": "נראה שאין מה שיפריע,"
  },
  {
   "start": 170.04,
   "end": 172.5,
   "text": "אין מה שיכול להעיב על שמחת החג."
  },
  {
   "start": 173.98,
   "end": 174.6,
   "text": "כך זה נראה."
  },
  {
   "start": 176.48,
   "end": 179.5,
   "text": "אבל הרבה פעמים דברים נראים,"
  },
  {
   "start": 181.22,
   "end": 182.82,
   "text": "ולבסוף מתחוורים לנו ההפך."
  },
  {
   "start": 184.36,
   "end": 185.94,
   "text": "שעות מספר אחר כך זה הגיע."
  },
  {
   "start": 185.94,
   "end": 189.62,
   "text": "את מקום השמחה והאושר"
  },
  {
   "start": 190.6,
   "end": 191.0,
   "text": "תפס לו"
  },
  {
   "start": 192.74,
   "end": 193.02,
   "text": "המוות,"
  },
  {
   "start": 194.42,
   "end": 196.72,
   "text": "ההרס והחידלון."
  },
  {
   "start": 198.8,
   "end": 199.68,
   "text": "בוגדן חמלניצקי,"
  },
  {
   "start": 201.68,
   "end": 202.34,
   "text": "עם אח שמו,"
  },
  {
   "start": 203.08,
   "end": 204.46,
   "text": "עם גדודי הקוזאקים שלו,"
  },
  {
   "start": 205.1,
   "end": 207.72,
   "text": "פשטו ושטפו את כל האזור כולו"
  },
  {
   "start": 208.88,
   "end": 209.64,
   "text": "באכזריות רצחנית."
  },
  {
   "start": 220.18,
   "end": 221.64,
   "text": "הצרחות מילאו את הרחוב,"
  },
  {
   "start": 224.3,
   "end": 226.38,
   "text": "אימה ופחד ברחובות,"
  },
  {
   "start": 227.58,
   "end": 228.66,
   "text": "כנופיות קוזאקים,"
  },
  {
   "start": 229.02,
   "end": 230.06,
   "text": "רחובות על סוסים,"
  },
  {
   "start": 230.34,
   "end": 231.36,
   "text": "דהרו להם ברחובות,"
  },
  {
   "start": 231.98,
   "end": 232.92,
   "text": "ברחובות לבוב,"
  },
  {
   "start": 233.46,
   "end": 235.36,
   "text": "שוברים את השלווה,"
  },
  {
   "start": 235.92,
   "end": 237.6,
   "text": "הורסים את העתיד."
  },
  {
   "start": 238.78,
   "end": 239.12,
   "text": "הם פשטו,"
  },
  {
   "start": 239.94,
   "end": 245.12,
   "text": "שדדו ורצחו כאוות נפשם ברחובות היהודים ואין מי שיעמוד"
  },
  {
   "start": 246.5,
   "end": 247.62,
   "text": "ליהודים למגן."
  },
  {
   "start": 250.23,
   "end": 251.73,
   "text": "ברוך החל מחפש את כלתו."
  },
  {
   "start": 252.65,
   "end": 252.95,
   "text": "איפה היא?"
  },
  {
   "start": 254.11,
   "end": 257.13,
   "text": "בלב כל המהומה, בלב כל הפחד, בלב כל ההרס."
  },
  {
   "start": 258.57,
   "end": 261.21,
   "text": "ואז הוא רואה, מבעד לזכוכיות מנופצות,"
  },
  {
   "start": 261.95,
   "end": 262.35,
   "text": "הוא רואה,"
  },
  {
   "start": 263.65,
   "end": 264.63,
   "text": "הוא רואה את הגופה."
  },
  {
   "start": 266.84,
   "end": 267.56,
   "text": "גופתו של"
  },
  {
   "start": 269.18,
   "end": 272.88,
   "text": "חותנו שנרצח באכזריות."
  },
  {
   "start": 275.4,
   "end": 276.02,
   "text": "ברוך הבין."
  },
  {
   "start": 277.96,
   "end": 283.19,
   "text": "ברוך הבין שאף משפחת כלתו נפגעה."
  },
  {
   "start": 288.12,
   "end": 289.14,
   "text": "על מה המחשבה במוחו?"
  },
  {
   "start": 289.64,
   "end": 290.02,
   "text": "אני לבד."
  },
  {
   "start": 290.7,
   "end": 291.96,
   "text": "אני חייב להימלט, חייב לברוח."
  },
  {
   "start": 293.48,
   "end": 294.2,
   "text": "והוא החל לנסות."
  },
  {
   "start": 296.1,
   "end": 296.66,
   "text": "להימלט."
  },
  {
   "start": 297.28,
   "end": 298.34,
   "text": "לברוח על נפשו."
  },
  {
   "start": 327.98,
   "end": 329.36,
   "text": "ברוך, ברוך בנדט"
  },
  {
   "start": 330.64,
   "end": 332.1,
   "text": "רץ נעס על נפשו."
  },
  {
   "start": 332.52,
   "end": 332.98,
   "text": "זה לא קל,"
  },
  {
   "start": 334.4,
   "end": 336.8,
   "text": "כי כמה קוזאקים ראו אותו."
  },
  {
   "start": 337.18,
   "end": 338.02,
   "text": "החל מרדף אחריו."
  },
  {
   "start": 338.36,
   "end": 339.56,
   "text": "הם רודפים עליו עם סוסים."
  },
  {
   "start": 339.9,
   "end": 341.2,
   "text": "והוא רץ רגלי."
  },
  {
   "start": 341.54,
   "end": 343.74,
   "text": "רץ. רץ על החיים שלו. רץ ככל..."
  },
  {
   "start": 344.26,
   "end": 346.26,
   "text": "אבל מה הוא יכול לעשות מול סוס?"
  },
  {
   "start": 346.64,
   "end": 347.78,
   "text": "הסוס רודף אחריו"
  },
  {
   "start": 348.68,
   "end": 349.42,
   "text": "ומשיג אותו."
  },
  {
   "start": 352.1,
   "end": 352.62,
   "text": "הסוס ירים את"
  },
  {
   "start": 353.18,
   "end": 353.68,
   "text": "רגליו."
  },
  {
   "start": 354.96,
   "end": 355.2,
   "text": "מכה."
  },
  {
   "start": 357.58,
   "end": 358.74,
   "text": "וברוך בנדט נפל."
  },
  {
   "start": 359.72,
   "end": 362.6,
   "text": "ואז הסוס נעצר, הקוזק כיוון את הסוס,"
  },
  {
   "start": 363.18,
   "end": 365.52,
   "text": "והסוס דרך על גופו"
  },
  {
   "start": 366.42,
   "end": 367.74,
   "text": "של ברוך, על פניו,"
  },
  {
   "start": 370.99,
   "end": 373.05,
   "text": "עוד דריכה, ועוד דריכה על הפנים."
  },
  {
   "start": 384.84,
   "end": 387.0,
   "text": "גופתו של ברוך בנדט נותרה מוטלת,"
  },
  {
   "start": 388.22,
   "end": 390.52,
   "text": "מת מלמלו הקוזקים בשמחה,"
  },
  {
   "start": 391.1,
   "end": 392.28,
   "text": "והמשיך בדרכם הלאה."
  },
  {
   "start": 395.54,
   "end": 395.96,
   "text": "משאירים את"
  },
  {
   "start": 397.14,
   "end": 399.54,
   "text": "פניו המרוטשים של ברוך בנדט,"
  },
  {
   "start": 400.66,
   "end": 402.72,
   "text": "וגופתו שרועה לה על אם הדרך."
  },
  {
   "start": 408.15,
   "end": 409.53,
   "text": "שעות רבות אחר כך"
  },
  {
   "start": 411.61,
   "end": 413.65,
   "text": "ברוך פתח את עיניו."
  },
  {
   "start": 417.92,
   "end": 419.82,
   "text": "איזה כוח פנימי גרם לו לזחול."
  },
  {
   "start": 420.46,
   "end": 421.24,
   "text": "הוא החל זוחל"
  },
  {
   "start": 422.22,
   "end": 422.78,
   "text": "וזוחל"
  },
  {
   "start": 426.45,
   "end": 427.09,
   "text": "עד שהוא הגיע"
  },
  {
   "start": 427.91,
   "end": 429.15,
   "text": "אל שפת מעיין קטן"
  },
  {
   "start": 431.64,
   "end": 432.86,
   "text": "שהיה בקרבת מקום."
  },
  {
   "start": 433.88,
   "end": 434.38,
   "text": "שם הוא התחיל"
  },
  {
   "start": 435.36,
   "end": 436.54,
   "text": "לטפל בפצעים שלו,"
  },
  {
   "start": 437.76,
   "end": 438.48,
   "text": "לשטוף את עצמו."
  },
  {
   "start": 444.86,
   "end": 445.7,
   "text": "שם במעיין,"
  },
  {
   "start": 446.82,
   "end": 447.98,
   "text": "אחרי שהוא שטף את עצמו,"
  },
  {
   "start": 451.64,
   "end": 452.02,
   "text": "הוא הביט,"
  },
  {
   "start": 454.55,
   "end": 456.05,
   "text": "הביט בפניו שהשתקפו לו,"
  },
  {
   "start": 457.19,
   "end": 464.68,
   "text": "ומבעד למים הצלולים הפנים היו פצועות"
  },
  {
   "start": 467.6,
   "end": 471.56,
   "text": "ושם במצח ניכר היה סימן צלקת"
  },
  {
   "start": 474.21,
   "end": 475.51,
   "text": "בצורה של פרסה,"
  },
  {
   "start": 477.9,
   "end": 478.88,
   "text": "הפרסה של הסוס."
  },
  {
   "start": 483.99,
   "end": 485.21,
   "text": "אבל חוץ מהצלקת"
  },
  {
   "start": 485.79,
   "end": 492.87,
   "text": "שם במצח והגוף הכואב ומספר צלעות סדוקות"
  },
  {
   "start": 494.47,
   "end": 495.99,
   "text": "ברוך היה לו צלקת"
  },
  {
   "start": 497.89,
   "end": 498.55,
   "text": "גם במוח."
  },
  {
   "start": 500.03,
   "end": 502.13,
   "text": "ברוך איבד את הזיכרון שלו."
  },
  {
   "start": 503.45,
   "end": 503.75,
   "text": "מי הוא?"
  },
  {
   "start": 504.41,
   "end": 504.77,
   "text": "מה הוא?"
  },
  {
   "start": 505.21,
   "end": 506.17,
   "text": "הוא לא זכר כלום."
  },
  {
   "start": 507.13,
   "end": 507.83,
   "text": "הכל נמחק."
  },
  {
   "start": 509.09,
   "end": 509.39,
   "text": "הכל"
  },
  {
   "start": 510.11,
   "end": 511.11,
   "text": "חוץ מדבר אחד,"
  },
  {
   "start": 511.73,
   "end": 512.33,
   "text": "השם שלו,"
  },
  {
   "start": 513.17,
   "end": 513.57,
   "text": "ברוך."
  },
  {
   "start": 514.19,
   "end": 514.51,
   "text": "ברוך."
  },
  {
   "start": 515.05,
   "end": 515.61,
   "text": "את זה הוא זכר."
  },
  {
   "start": 516.83,
   "end": 517.59,
   "text": "כל הלימוד שלו,"
  },
  {
   "start": 518.45,
   "end": 520.65,
   "text": "כל השנים, הכל נמחק, כלום."
  },
  {
   "start": 521.41,
   "end": 523.41,
   "text": "הוא ידע רק דבר אחד, ברוך."
  },
  {
   "start": 524.49,
   "end": 526.83,
   "text": "מעבר לזה, חלל שחור."
  },
  {
   "start": 538.79,
   "end": 539.21,
   "text": "החל"
  },
  {
   "start": 539.21,
   "end": 543.25,
   "text": "החלו חיי הנדודים, ברוך מצא את עצמו"
  },
  {
   "start": 544.33,
   "end": 545.23,
   "text": "מצטרף"
  },
  {
   "start": 545.81,
   "end": 547.07,
   "text": "לעוד עשרות ומאות"
  },
  {
   "start": 547.75,
   "end": 554.15,
   "text": "קבוצות של יהודים אומללים שנעים ונדים ברחבי אירופה, ברחבי פולין,"
  },
  {
   "start": 555.81,
   "end": 558.03,
   "text": "מחפשים קצת אוכל,"
  },
  {
   "start": 558.89,
   "end": 559.79,
   "text": "קצת שלווה."
  },
  {
   "start": 561.27,
   "end": 565.08,
   "text": "איי, איי, איי."
  },
  {
   "start": 565.5,
   "end": 566.4,
   "text": "מקץ זמן מה,"
  },
  {
   "start": 567.96,
   "end": 569.08,
   "text": "ברוך מגיע לווילנה,"
  },
  {
   "start": 571.34,
   "end": 571.54,
   "text": "ברוך,"
  },
  {
   "start": 572.12,
   "end": 576.98,
   "text": "שבקרב היהודים הנודדים הוא נקרא ברוך פרסה"
  },
  {
   "start": 577.68,
   "end": 579.76,
   "text": "על שם הצלקת שעיטרה את מצחו."
  },
  {
   "start": 580.4,
   "end": 582.52,
   "text": "צלקת בצורת פרסה של סוס."
  },
  {
   "start": 583.86,
   "end": 584.42,
   "text": "ובווילנה"
  },
  {
   "start": 585.88,
   "end": 587.46,
   "text": "הוא מתאכסן לו בחצר הישיבה,"
  },
  {
   "start": 588.1,
   "end": 589.76,
   "text": "שם הוא מבין שהוא יכול לקבל אוכל."
  },
  {
   "start": 590.66,
   "end": 592.98,
   "text": "שם הוא מאזין לצלילים."
  },
  {
   "start": 593.96,
   "end": 595.2,
   "text": "צלילים שגרמו לו ככה"
  },
  {
   "start": 596.46,
   "end": 597.58,
   "text": "ללב שלו לרטוט,"
  },
  {
   "start": 598.42,
   "end": 599.04,
   "text": "לדמרות,"
  },
  {
   "start": 599.72,
   "end": 603.34,
   "text": "לצאת מעליהם, לזלוג בלעל מעליהם, מעיניו."
  },
  {
   "start": 603.7,
   "end": 604.16,
   "text": "הוא לא בכה."
  },
  {
   "start": 606.81,
   "end": 608.47,
   "text": "למרות כל מה שעבר הוא לא בכה."
  },
  {
   "start": 609.37,
   "end": 610.39,
   "text": "אבל כשהוא היה שומע את הניגון,"
  },
  {
   "start": 611.23,
   "end": 613.25,
   "text": "את צלילי הלימוד מהישיבה,"
  },
  {
   "start": 614.57,
   "end": 616.03,
   "text": "את הניגון מהישיבה,"
  },
  {
   "start": 616.95,
   "end": 618.05,
   "text": "זה הזכיר לו משהו."
  },
  {
   "start": 618.97,
   "end": 619.89,
   "text": "משהו במעומעם."
  },
  {
   "start": 620.47,
   "end": 621.05,
   "text": "משהו טוב."
  },
  {
   "start": 621.55,
   "end": 622.43,
   "text": "געגועים."
  },
  {
   "start": 623.29,
   "end": 623.89,
   "text": "למשהו."
  },
  {
   "start": 626.39,
   "end": 629.21,
   "text": "זה הגורם לו פשוט להוריד דמעות"
  },
  {
   "start": 630.09,
   "end": 630.93,
   "text": "בלי להבין."
  },
  {
   "start": 631.77,
   "end": 633.97,
   "text": "לבכות בלי להבין."
  },
  {
   "start": 641.14,
   "end": 643.46,
   "text": "האברכים בישיבה כשראו אותה, אני המסכן."
  },
  {
   "start": 646.61,
   "end": 647.55,
   "text": "את ברוך פרסה"
  },
  {
   "start": 649.45,
   "end": 652.31,
   "text": "בוכה כל פעם שהוא יושב, המביט בלימוד שלהם."
  },
  {
   "start": 652.97,
   "end": 654.25,
   "text": "שרפו אותו, ניסו ללמד אותו,"
  },
  {
   "start": 656.96,
   "end": 657.88,
   "text": "והוא רצה ללמוד."
  },
  {
   "start": 659.58,
   "end": 663.56,
   "text": "ברוך פרסה התחיל ללמוד הכל מא'-ב'."
  },
  {
   "start": 664.28,
   "end": 666.7,
   "text": "איזה כוח צריך בשביל זה?"
  },
  {
   "start": 667.12,
   "end": 668.34,
   "text": "לבוא וללמוד!"
  },
  {
   "start": 669.64,
   "end": 671.0,
   "text": "כשאתה כבר בחור!"
  },
  {
   "start": 671.2,
   "end": 675.96,
   "text": "ואתה לא יודע אפילו א'-ב' להתחיל את הכל,"
  },
  {
   "start": 676.9,
   "end": 678.38,
   "text": "אבל ברוך רצה,"
  },
  {
   "start": 678.92,
   "end": 684.0,
   "text": "וכשביהודי רוצה, כשיהודייה רוצים, הם משיגים, הם מצליחים."
  },
  {
   "start": 684.84,
   "end": 691.62,
   "text": "למרות הנפילות, למרות הנסיגות, למרות ההפסדים, נראה העיכובים המניעות, הם מנצחים, הם מצליחים."
  },
  {
   "start": 692.82,
   "end": 694.2,
   "text": "וברוך יותר מכל,"
  },
  {
   "start": 694.86,
   "end": 695.96,
   "text": "יותר מכל הוא רצה."
  },
  {
   "start": 696.7,
   "end": 697.38,
   "text": "הוא רצה."
  },
  {
   "start": 700.77,
   "end": 702.03,
   "text": "אז הוא ישב לאט-לאט,"
  },
  {
   "start": 704.13,
   "end": 707.07,
   "text": "לומד בצורה קשה, בצורה מייסרת, אבל לומד."
  },
  {
   "start": 709.15,
   "end": 713.65,
   "text": "אין ייאוש בעולם, אני חייב עוד דף ועוד שורה ועוד שורה."
  },
  {
   "start": 715.75,
   "end": 718.69,
   "text": "ובשמיים כנראה ראו את המאמץ שלו,"
  },
  {
   "start": 719.55,
   "end": 721.23,
   "text": "ראו את הזיעה האמיתית שלו,"
  },
  {
   "start": 721.71,
   "end": 724.17,
   "text": "ראו את האכפתיות שלו, את הרצון שלו."
  },
  {
   "start": 725.65,
   "end": 728.75,
   "text": "לא מיד בהתחלה כשיש את ההתלהבות, לאורך זמן,"
  },
  {
   "start": 729.83,
   "end": 730.65,
   "text": "ונפתחו לו"
  },
  {
   "start": 731.21,
   "end": 732.13,
   "text": "שערי השמיים."
  },
  {
   "start": 734.25,
   "end": 737.79,
   "text": "ופתח בחוסר זיכרון שלו, באמנסיה שלו, נפתח."
  },
  {
   "start": 738.69,
   "end": 740.79,
   "text": "הוא החל לזכור את הלימוד שלו."
  },
  {
   "start": 741.81,
   "end": 744.65,
   "text": "זיכרון הלימודים שלו החל חוזר ומפעפע בו,"
  },
  {
   "start": 745.47,
   "end": 746.09,
   "text": "עולה שוב."
  },
  {
   "start": 753.02,
   "end": 756.1,
   "text": "זה לקח מספר לא מבוטל של חודשים,"
  },
  {
   "start": 756.92,
   "end": 758.18,
   "text": "אבל פרוך פרסה."
  },
  {
   "start": 759.2,
   "end": 760.18,
   "text": "לא זוכר מי הוא,"
  },
  {
   "start": 761.14,
   "end": 762.12,
   "text": "לא זוכר מה הוא,"
  },
  {
   "start": 762.76,
   "end": 763.86,
   "text": "אבל זוכר את"
  },
  {
   "start": 764.5,
   "end": 767.18,
   "text": "דפי הגמרא, את התורה הקדושה,"
  },
  {
   "start": 767.84,
   "end": 769.5,
   "text": "והאור חוזר לעיניים."
  },
  {
   "start": 772.62,
   "end": 773.6,
   "text": "בלב יש קצת עוגה."
  },
  {
   "start": 774.32,
   "end": 777.1,
   "text": "הוא רואה את החברים שלו מתחתנים, הוא יודע מי תסכים להתחתן איתו,"
  },
  {
   "start": 777.6,
   "end": 778.66,
   "text": "עם ברוך פרסה,"
  },
  {
   "start": 779.2,
   "end": 780.28,
   "text": "עם צלקת כזו,"
  },
  {
   "start": 781.8,
   "end": 783.32,
   "text": "שמעטרת לו את הפנים,"
  },
  {
   "start": 783.9,
   "end": 785.22,
   "text": "עם עבר נשכח."
  },
  {
   "start": 787.06,
   "end": 788.46,
   "text": "הוא לא יודע מי הוא ומה הוא,"
  },
  {
   "start": 789.3,
   "end": 790.68,
   "text": "אבל ברוך פרסה"
  },
  {
   "start": 791.4,
   "end": 794.92,
   "text": "היה לו דבר אחד שבו הוא החזיק חזק."
  },
  {
   "start": 795.64,
   "end": 798.32,
   "text": "ביטחון במי שאמר והיה העולם,"
  },
  {
   "start": 799.04,
   "end": 800.44,
   "text": "מי שדאג לי עד עכשיו,"
  },
  {
   "start": 800.98,
   "end": 805.0,
   "text": "מי שהשאיר אותי בחיים עם כל הקשיים,"
  },
  {
   "start": 805.32,
   "end": 806.32,
   "text": "הוא ידאג לי לכל."
  },
  {
   "start": 830.64,
   "end": 833.1,
   "text": "ובורא עולם יושב בשמיים."
  },
  {
   "start": 834.9,
   "end": 839.46,
   "text": "כשהוא רואה את היהודי, רואה אותנו, את היהודייה, מתאמצים לכבודו."
  },
  {
   "start": 839.98,
   "end": 844.12,
   "text": "בלי לצפות לכלום, לא לסוף תום ולא לפרס ולא לכלום. פשוט עושים."
  },
  {
   "start": 844.88,
   "end": 846.84,
   "text": "העולם מתחיל להזיז את החוטים להפעיל אותם."
  },
  {
   "start": 847.54,
   "end": 848.94,
   "text": "וכשהוא מזיז,"
  },
  {
   "start": 848.94,
   "end": 859.84,
   "text": "קורא הבלתי צפוי ולברוך פרסה קרא בלתי צפוי לא פחות ולא יותר מאשר פרנס הישיבה"
  },
  {
   "start": 860.52,
   "end": 866.62,
   "text": "הגביר העשיר שמימן ומממן את כל הישיבה שם עין על ברוך פרסה, על המתמיד הזה,"
  },
  {
   "start": 867.26,
   "end": 868.06,
   "text": "על העילוי הזה"
  },
  {
   "start": 869.28,
   "end": 870.02,
   "text": "והייתה לו בת"
  },
  {
   "start": 871.64,
   "end": 873.82,
   "text": "הייתה לו בת שהרבה רצו להתחתן איתה"
  },
  {
   "start": 874.5,
   "end": 875.6,
   "text": "אבל הגביר הזה"
  },
  {
   "start": 876.9,
   "end": 877.96,
   "text": "לא רצה יופי"
  },
  {
   "start": 878.8,
   "end": 880.58,
   "text": "רצה עוצמה של לימוד,"
  },
  {
   "start": 881.08,
   "end": 883.04,
   "text": "ואת זה הוא מצא בברוך פרסה."
  },
  {
   "start": 883.7,
   "end": 886.0,
   "text": "הוא פנה לבת שלו ואמר לה, תראי, ביתי,"
  },
  {
   "start": 886.8,
   "end": 888.7,
   "text": "יש לי מישהו בשבילך,"
  },
  {
   "start": 890.12,
   "end": 891.44,
   "text": "להציע לך לנסות להכיר אותו,"
  },
  {
   "start": 892.32,
   "end": 894.6,
   "text": "אבל יש משהו שאני חייב להגיד לך לפני כן."
  },
  {
   "start": 896.87,
   "end": 899.27,
   "text": "את אולי מכירה אותו, את ברוך פרסה?"
  },
  {
   "start": 900.91,
   "end": 902.11,
   "text": "והבת הנהנה, כן."
  },
  {
   "start": 903.29,
   "end": 904.63,
   "text": "ראיתי אותו מספר פעמים."
  },
  {
   "start": 906.45,
   "end": 908.83,
   "text": "הצלקת שיש לו בפנים, ביתי,"
  },
  {
   "start": 909.61,
   "end": 911.19,
   "text": "בתי, אני שואל אותך, תגידי את האמת."
  },
  {
   "start": 911.97,
   "end": 914.23,
   "text": "הצלקת שיש לו בפנים לא מפריעה לך?"
  },
  {
   "start": 917.99,
   "end": 918.21,
   "text": "הבת"
  },
  {
   "start": 919.17,
   "end": 920.03,
   "text": "הצדקת"
  },
  {
   "start": 921.21,
   "end": 923.23,
   "text": "של הגביר אמרה לו, אבא,"
  },
  {
   "start": 924.05,
   "end": 925.87,
   "text": "עדיף צלקת בגוף,"
  },
  {
   "start": 926.71,
   "end": 930.55,
   "text": "עדיפה צלקת בפנים מצלקת בנשמה."
  },
  {
   "start": 931.79,
   "end": 932.95,
   "text": "עדיף צלקת"
  },
  {
   "start": 934.21,
   "end": 936.69,
   "text": "בפנים שכולם רואים אותה,"
  },
  {
   "start": 937.35,
   "end": 939.05,
   "text": "מאשר צלקת בנשמה."
  },
  {
   "start": 939.97,
   "end": 941.97,
   "text": "אני מוכנה ללכת ולנסות להכיר אותו,"
  },
  {
   "start": 942.67,
   "end": 945.03,
   "text": "ואם הוא יתגלה באמת כאדם טוב,"
  },
  {
   "start": 947.85,
   "end": 949.47,
   "text": "אני אראה את היופי הפנימי שלו,"
  },
  {
   "start": 950.01,
   "end": 950.57,
   "text": "אני מוכנה"
  },
  {
   "start": 951.93,
   "end": 952.73,
   "text": "להינשא לו."
  },
  {
   "start": 957.62,
   "end": 959.78,
   "text": "וברוך פרסה בה בקשריקי שיתוכים"
  },
  {
   "start": 961.22,
   "end": 961.78,
   "text": "עם הבת"
  },
  {
   "start": 962.86,
   "end": 963.52,
   "text": "של העשיר,"
  },
  {
   "start": 966.07,
   "end": 966.91,
   "text": "העשיר בווילנה,"
  },
  {
   "start": 969.47,
   "end": 970.37,
   "text": "העשיר בווילנה."
  },
  {
   "start": 976.51,
   "end": 978.07,
   "text": "ברוך פרסה שמח כל כך,"
  },
  {
   "start": 978.93,
   "end": 980.01,
   "text": "מקץ שנים,"
  },
  {
   "start": 980.65,
   "end": 982.77,
   "text": "מקץ שנות נדודים ובדידות,"
  },
  {
   "start": 983.51,
   "end": 986.67,
   "text": "סוף סוף הוא יכול לשקם את הריסות החיים שלו."
  },
  {
   "start": 989.16,
   "end": 991.42,
   "text": "ובאמת, השידוך הזה עולה יפה."
  },
  {
   "start": 992.36,
   "end": 994.76,
   "text": "החותן מבטיח לו, ברוך, אני אדאג לכם,"
  },
  {
   "start": 995.32,
   "end": 997.38,
   "text": "לכל הצרכים שלכם הכלכליים."
  },
  {
   "start": 999.8,
   "end": 1000.3,
   "text": "אתה תשב."
  },
  {
   "start": 1001.72,
   "end": 1005.0,
   "text": "אולי אתה לא זוכר את העבר שלך, אבל אני רואה עליך שעברת הרבה בחיים."
  },
  {
   "start": 1005.78,
   "end": 1007.34,
   "text": "אתה תקבל פיצוי על העבר שלך."
  },
  {
   "start": 1008.12,
   "end": 1010.16,
   "text": "אתה תוכל לשבת וללמוד תורה, בנחת."
  },
  {
   "start": 1013.32,
   "end": 1014.06,
   "text": "וברוך יהיה."
  },
  {
   "start": 1015.56,
   "end": 1020.84,
   "text": "סוף-סוף חלומו של ברוך פרסה החל קורם עור וגידים."
  },
  {
   "start": 1022.62,
   "end": 1023.72,
   "text": "פלאי פלאות."
  },
  {
   "start": 1026.94,
   "end": 1027.98,
   "text": "מי יכול להבין?"
  },
  {
   "start": 1030.55,
   "end": 1033.83,
   "text": "מי יכול להבין צעדים של מעלה?"
  },
  {
   "start": 1034.99,
   "end": 1041.64,
   "text": "מי יכול להבין בקשרי שידוכים מי מתאים למי?"
  },
  {
   "start": 1043.16,
   "end": 1044.04,
   "text": "למה? איך?"
  },
  {
   "start": 1045.36,
   "end": 1046.52,
