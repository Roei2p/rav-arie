{
 "disc": "6ו - התפקיד",
 "track": "Track07",
 "duration": 128.16,
 "segments": [
  {
   "start": 10.11,
   "end": 10.61,
   "text": "עם ישראל קדוש,"
  },
  {
   "start": 14.26,
   "end": 15.26,
   "text": "לכן אסור לנו להתייאש."
  },
  {
   "start": 15.98,
   "end": 16.52,
   "text": "צריכים לדעת,"
  },
  {
   "start": 17.38,
   "end": 19.22,
   "text": "לזכור את אפקט עץ התאנה."
  },
  {
   "start": 19.92,
   "end": 20.88,
   "text": "עץ התאנה!"
  },
  {
   "start": 21.66,
   "end": 24.26,
   "text": "אתה רואה פרי בעץ הזה, פרי אחד בשל,"
  },
  {
   "start": 24.66,
   "end": 27.22,
   "text": "וסנטימטר לידו פרי לא בשל."
  },
  {
   "start": 28.2,
   "end": 30.54,
   "text": "אבל אתה אומר, בוא'נה, ריבונו של עולם, זה אותו עץ!"
  },
  {
   "start": 33.02,
   "end": 35.92,
   "text": "זה בשל וזה לא בשל. מה בורא עולם? מה זה?"
  },
  {
   "start": 36.8,
   "end": 42.94,
   "text": "אתם יודעים מה זה? בורא עולם צועק לנו היהודים, בורא עולם אומר לנו, בניי היקרים, בניי!"
  },
  {
   "start": 43.6,
   "end": 48.34,
   "text": "תשימו לב, אתם רואים, עץ, אותו עץ, פריליאטרי, זה בשל,"
  },
  {
   "start": 49.0,
   "end": 53.74,
   "text": "וזה סנטים לידו, לא בשל, כדי להגיד לך, להגיד לך,"
  },
  {
   "start": 54.36,
   "end": 56.2,
   "text": "פניי, תמשיכו לעבוד אותי,"
  },
  {
   "start": 56.96,
   "end": 62.46,
   "text": "תמשיכו להאמין, תמשיכו להתחזק, לא להתייאש, גם שנראה שלא הולך!"
  },
  {
   "start": 63.34,
   "end": 71.4,
   "text": "כי יהודי פה הולך לו, ויהודי השני לידו עדיין נראה לא הולך, אבל יגיע זמן הבישול שלו,"
  },
  {
   "start": 71.7,
   "end": 73.36,
   "text": "יגיע זמן שהכל ייפתח,"
  },
  {
   "start": 73.98,
   "end": 75.06,
   "text": "שערי הרחמים,"
  },
  {
   "start": 75.44,
   "end": 80.9,
   "text": "שערי התפילות, שערי האושר, שערי השמחה, שערי הגאולה."
  },
  {
   "start": 81.36,
   "end": 85.88,
   "text": "רק אנחנו צריכים לעמוד ליד הפתח ולא להתרחק,"
  },
  {
   "start": 86.62,
   "end": 88.0,
   "text": "ולא להתייאש,"
  },
  {
   "start": 88.58,
   "end": 89.74,
   "text": "ולא להתייאש."
  },
  {
   "start": 90.98,
   "end": 95.8,
   "text": "רק לשמוח יש ולקדש את שמו של השם להתברך."
  },
  {
   "start": 96.24,
   "end": 99.4,
   "text": "יהי רצון לפני השם להתברך שישמע את תפילותינו."
  },
  {
   "start": 99.84,
   "end": 101.26,
   "text": "אוהבים אתכם, עם ישראל."
  },
  {
   "start": 102.32,
   "end": 103.32,
   "text": "אוהבים אתכם."
  }
 ]
}