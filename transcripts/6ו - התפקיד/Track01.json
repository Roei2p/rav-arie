{
 "disc": "6ו - התפקיד",
 "track": "Track01",
 "duration": 826.2,
 "segments": [
  {
   "start": 2.33,
   "end": 7.26,
   "text": "בגרמניה,"
  },
  {
   "start": 8.74,
   "end": 8.82,
   "text": "אבא,"
  },
  {
   "start": 9.8,
   "end": 10.94,
   "text": "אבא לחמישה בנים,"
  },
  {
   "start": 15.47,
   "end": 17.77,
   "text": "שלח את הילדים שלו ללמוד תורה."
  },
  {
   "start": 19.47,
   "end": 20.33,
   "text": "הוא אמר להם, תלכו,"
  },
  {
   "start": 21.67,
   "end": 22.93,
   "text": "לכו אל מעבר לים,"
  },
  {
   "start": 24.29,
   "end": 27.79,
   "text": "לכו אל העולם הרחב, אל קהילות יהודיות."
  },
  {
   "start": 29.01,
   "end": 30.85,
   "text": "תמצאו לכם ישיבות ללמוד תורה,"
  },
  {
   "start": 31.37,
   "end": 32.79,
   "text": "להתפתח מבחינה רוחנית."
  },
  {
   "start": 34.21,
   "end": 36.31,
   "text": "אני מאפשר לכם את זה, כי אני סומך עליכם,"
  },
  {
   "start": 37.19,
   "end": 39.11,
   "text": "אבל, אבל בקשה אחת יש לי,"
  },
  {
   "start": 39.79,
   "end": 41.61,
   "text": "אבל תנאי אחד יש לי מכם."
  },
  {
   "start": 53.18,
   "end": 54.1,
   "text": "חמש שנים."
  },
  {
   "start": 54.94,
   "end": 56.48,
   "text": "חמש שנים אתם תהיו שם."
  },
  {
   "start": 57.06,
   "end": 60.32,
   "text": "תלמדו, תגדלו, תעלו במעלות התורה."
  },
  {
   "start": 61.0,
   "end": 63.32,
   "text": "אבל אחר כך אתם חוזרים אליי."
  },
  {
   "start": 64.32,
   "end": 68.56,
   "text": "אני רוצה לראות אתכם עוד חמש שנים בתאריך הזה."
  },
  {
   "start": 70.48,
   "end": 71.18,
   "text": "אנחנו נפגשים."
  },
  {
   "start": 73.66,
   "end": 74.58,
   "text": "חודש אלול."
  },
  {
   "start": 75.14,
   "end": 78.18,
   "text": "חודש התשובה אתם שבים אליי. נפגשים."
  },
  {
   "start": 79.6,
   "end": 81.2,
   "text": "אני רוצה לראות את הילדים שלי"
  },
  {
   "start": 82.2,
   "end": 84.58,
   "text": "צאו לשלום, והשם יהיה עמכם."
  },
  {
   "start": 87.64,
   "end": 88.62,
   "text": "והם יצאו לדרכם"
  },
  {
   "start": 89.28,
   "end": 91.82,
   "text": "איש-איש בעקבות גורלו."
  },
  {
   "start": 94.86,
   "end": 95.54,
   "text": "אחד מהבנים,"
  },
  {
   "start": 96.58,
   "end": 97.64,
   "text": "הקטן שבהם,"
  },
  {
   "start": 98.16,
   "end": 99.76,
   "text": "קראו לו יחיאל מיכל."
  },
  {
   "start": 100.56,
   "end": 101.64,
   "text": "יחיאל מיכל,"
  },
  {
   "start": 103.28,
   "end": 104.1,
   "text": "בתור מסע,"
  },
  {
   "start": 106.6,
   "end": 109.1,
   "text": "לא כל כך ארוך, אבל די מפרך,"
  },
  {
   "start": 110.0,
   "end": 111.26,
   "text": "הגיע למזיבוש,"
  },
  {
   "start": 112.28,
   "end": 113.24,
   "text": "אלא בעל שם טוב."
  },
  {
   "start": 115.04,
   "end": 115.5,
   "text": "ושם,"
  },
  {
   "start": 119.51,
   "end": 121.07,
   "text": "בבית המדרש של הבעל שם טוב,"
  },
  {
   "start": 122.85,
   "end": 123.67,
   "text": "הוא ישב ולמד."
  },
  {
   "start": 124.55,
   "end": 125.23,
   "text": "היה בין המתמידים,"
  },
  {
   "start": 125.55,
   "end": 128.79,
   "text": "בין המצטיינים בתלמידיו של הבעל שם טוב."
  },
  {
   "start": 131.55,
   "end": 132.83,
   "text": "כך במשך חמש שנים,"
  },
  {
   "start": 133.81,
   "end": 135.33,
   "text": "בתום התקופה,"
  },
  {
   "start": 135.95,
   "end": 138.35,
   "text": "הוא פנה לרב וביקש ממנו. אמר לו, אני הבטחתי לאבא."
  },
  {
   "start": 139.41,
   "end": 141.29,
   "text": "כמו שאר הילדים, שאר האחים שלי,"
  },
  {
   "start": 141.83,
   "end": 142.89,
   "text": "אני צריך לחזור לאבא שלי."
  },
  {
   "start": 144.79,
   "end": 145.85,
   "text": "והבעל שם טוב בירך אותו."
  },
  {
   "start": 146.69,
   "end": 152.73,
   "text": "ואז הוא אמר, הרב, אני מבקש שתברך אותי גם שאני אצליח להגיע לראש השנה לחזור אל הרב,"
  },
  {
   "start": 154.11,
   "end": 156.55,
   "text": "כדי להתפלל את תפילת הימים הנוראים אצל הרב."
  },
  {
   "start": 157.69,
   "end": 163.39,
   "text": "והבעל שם טוב הביט פה במבט מוזר, חייך ולא אמר כלום."
  },
  {
   "start": 167.4,
   "end": 168.64,
   "text": "יחיאל מיכל יצא לדרך,"
  },
  {
   "start": 171.85,
   "end": 172.55,
   "text": "אל גרמניה,"
  },
  {
   "start": 173.17,
   "end": 173.63,
   "text": "אל אבא,"
  },
  {
   "start": 174.39,
   "end": 175.81,
   "text": "שמחכה לילדים שלו."
  },
  {
   "start": 177.09,
   "end": 177.61,
   "text": "הוא חזר,"
  },
  {
   "start": 177.61,
   "end": 183.09,
   "text": "וכל אחיו חזרו גם הם והם נפגשים."
  },
  {
   "start": 183.65,
   "end": 185.51,
   "text": "איזה שבת נפלאה, איזה שמחה."
  },
  {
   "start": 187.21,
   "end": 188.71,
   "text": "והאב, האבא מאושר,"
  },
  {
   "start": 189.43,
   "end": 191.93,
   "text": "רואה את הילדים שלו שגדלו, גדלו לתפארת."
  },
  {
   "start": 192.77,
   "end": 194.11,
   "text": "תלמידי חכמים של ממש."
  },
  {
   "start": 195.81,
   "end": 196.47,
   "text": "ערב שבת,"
  },
  {
   "start": 197.15,
   "end": 199.91,
   "text": "הבן הראשון קם, אומר דברי תורה מהנגים."
  },
  {
   "start": 200.23,
   "end": 204.53,
   "text": "הבן השני, הבן השלישי, שבת בבוקר, כל הילדים אומרים,"
  },
  {
   "start": 204.99,
   "end": 205.87,
   "text": "חוץ מבן אחד,"
  },
  {
   "start": 206.75,
   "end": 209.09,
   "text": "בן אחד יושב בשקט ולא אומר מילה."
  },
  {
   "start": 210.23,
   "end": 211.15,
   "text": "מי זה יחיאל מיכל?"
  },
  {
   "start": 211.87,
   "end": 214.31,
   "text": "אבא פונה אליו, הוא אמר לו, תגיד לי, בני היקר, בני הקטן,"
  },
  {
   "start": 215.49,
   "end": 216.53,
   "text": "לא למדת כלום."
  },
  {
   "start": 217.39,
   "end": 218.15,
   "text": "אני כל כך בצער."
  },
  {
   "start": 219.93,
   "end": 221.89,
   "text": "ישבת חמש שנים ולא למדת כלום."
  },
  {
   "start": 222.81,
   "end": 223.71,
   "text": "אמר לו כבוד אבא,"
  },
  {
   "start": 224.67,
   "end": 224.83,
   "text": "אבא,"
  },
  {
   "start": 225.59,
   "end": 230.28,
   "text": "אני פשוט מכבד את האחים הגדולים שלי, אבא."
  },
  {
   "start": 230.66,
   "end": 231.9,
   "text": "מי אני כזה קטן?"
  },
  {
   "start": 232.7,
   "end": 236.44,
   "text": "ידבר לפני האחים שלי הגדולים, זה אחד מהדברים שלמדתי אצל רבי ומורי."
  },
  {
   "start": 237.6,
   "end": 240.58,
   "text": "ואבא מחייך ואומר לו, טוב, בני, בסעודה שלישית"
  },
  {
   "start": 241.18,
   "end": 241.9,
   "text": "אני מבקש שאתה."
  },
  {
   "start": 243.06,
   "end": 244.08,
   "text": "מול בקשה של אבא,"
  },
  {
   "start": 244.94,
   "end": 246.74,
   "text": "גם הרב שלך לימד אותך לא לסרב."
  },
  {
   "start": 248.9,
   "end": 250.96,
   "text": "בסעודה שלישית יחיאל מיכל"
  },
  {
   "start": 251.88,
   "end": 253.44,
   "text": "התחיל לומר דברי תורה."
  },
  {
   "start": 254.56,
   "end": 257.5,
   "text": "והדברים האירו קנטינתם בסיני."
  },
  {
   "start": 258.2,
   "end": 259.96,
   "text": "איזה דברי תורה, איזה עונג."
  },
  {
   "start": 260.98,
   "end": 261.98,
   "text": "פלאי פלאות."
  },
  {
   "start": 263.36,
   "end": 264.38,
   "text": "והאבא מאושר."
  },
  {
   "start": 264.38,
   "end": 268.12,
   "text": "יחיאל מיכל עלה על כולם."
  },
  {
   "start": 273.28,
   "end": 273.52,
   "text": "כך"
  },
  {
   "start": 274.68,
   "end": 275.38,
   "text": "נמשך"
  },
  {
   "start": 276.32,
   "end": 278.86,
   "text": "וכך הסתיים לו הביקור אצל בית אבא."
  },
  {
   "start": 279.5,
   "end": 281.14,
   "text": "ויחיאל מיכל עושה את כל הדרך חזרה."
  },
  {
   "start": 281.56,
   "end": 285.38,
   "text": "הוא רוצה להספיק להגיע אל ראש השנה, לפני ראש השנה,"
  },
  {
   "start": 286.82,
   "end": 290.12,
   "text": "אל בית המדרש של הבעל שם טוב, להתפלל עם כל החברים שלו, כל התלמידים,"
  },
  {
   "start": 290.5,
   "end": 291.44,
   "text": "עם הרב הקדוש."
  },
  {
   "start": 293.04,
   "end": 294.4,
   "text": "וכך הוא מוצא את עצמו בדרך חזרה"
  },
  {
   "start": 295.84,
   "end": 296.46,
   "text": "באונייה"
  },
  {
   "start": 296.46,
   "end": 304.56,
   "text": "ששתה לבלב ים כולו תפילה רוצה להגיע אל מזבוש"
  },
  {
   "start": 306.82,
   "end": 314.37,
   "text": "אבל אז, אז הים התחיל להשתולל"
  },
  {
   "start": 315.01,
   "end": 322.13,
   "text": "אז הים התחיל לומר את דברו שערה בלב ים והאונייה מטלטלת לה מכאן לשם,"
  },
  {
   "start": 322.91,
   "end": 323.59,
   "text": "משם לכאן"
  },
  {
   "start": 324.73,
   "end": 326.09,
   "text": "והאונייה נאלצת"
  },
  {
   "start": 326.67,
   "end": 328.71,
   "text": "אין ברירה פשוט לעגון באי נידח"
  },
  {
   "start": 330.43,
   "end": 331.09,
   "text": "שם בדרך"
  },
  {
   "start": 335.73,
   "end": 341.63,
   "text": "כולם מקווים שהם נחתו באי עד שהסערה תעבור באי לפחות,"
  },
  {
   "start": 342.61,
   "end": 345.81,
   "text": "שהוא ללא ילידים פראיים מסוכנים."
  },
  {
   "start": 346.75,
   "end": 349.51,
   "text": "וכולם נושמים לרווחה כשרואים באמת שיש שם ילידים,"
  },
  {
   "start": 350.37,
   "end": 352.53,
   "text": "אנשי האי, מאוד ידידותיים."
  },
  {
   "start": 353.81,
   "end": 355.69,
   "text": "אבל יחיאל מיכאל טרוד מדבר אחד,"
  },
  {
   "start": 356.55,
   "end": 357.15,
   "text": "ראש השנה."
  },
  {
   "start": 357.69,
   "end": 359.27,
   "text": "הוא רוצה להתפלל אצל הבעל שם טוב."
  },
  {
   "start": 361.47,
   "end": 362.23,
   "text": "וכבר היום,"
  },
  {
   "start": 362.73,
   "end": 363.31,
   "text": "עם כל הטרדות,"
  },
  {
   "start": 364.01,
   "end": 365.19,
   "text": "עם כל הסערה הזאת."
  },
  {
   "start": 365.87,
   "end": 367.27,
   "text": "היום זה ערב ראש השנה,"
  },
  {
   "start": 367.85,
   "end": 370.23,
   "text": "והוא נמצא באי נידח ולבד, מה הוא יעשה?"
  },
  {
   "start": 372.03,
   "end": 372.51,
   "text": "במבט"
  },
  {
   "start": 374.23,
   "end": 375.13,
   "text": "חדור אמונה,"
  },
  {
   "start": 376.09,
   "end": 377.03,
   "text": "אבל קצת עם צער,"
  },
  {
   "start": 377.91,
   "end": 380.43,
   "text": "הוא פותח את התיק שאיתו, מוציא מחזור,"
  },
  {
   "start": 381.05,
   "end": 381.69,
   "text": "מוציא גם טלית,"
  },
  {
   "start": 384.15,
   "end": 385.37,
   "text": "ושם בצד מוציא גם שופר."
  },
  {
   "start": 388.49,
   "end": 389.31,
   "text": "הוא לבד, הוא רחוק,"
  },
  {
   "start": 389.99,
   "end": 392.41,
   "text": "רחוק ממערב, רחוק מבית אבא."
  },
  {
   "start": 392.93,
   "end": 393.47,
   "text": "זה קשה,"
  },
  {
   "start": 394.27,
   "end": 395.71,
   "text": "אבל חייבים להתגבר. יהודי,"
  },
  {
   "start": 396.29,
   "end": 397.97,
   "text": "יהודי חייב להיות תמיד,"
  },
  {
   "start": 398.45,
   "end": 400.07,
   "text": "תמיד חזק,"
  },
  {
   "start": 400.53,
   "end": 402.45,
   "text": "שמח, מאמין."
  },
  {
   "start": 408.46,
   "end": 408.98,
   "text": "ראש השנה,"
  },
  {
   "start": 411.37,
   "end": 412.73,
   "text": "יום הדין הגדול והנורא."
  },
  {
   "start": 414.33,
   "end": 419.0,
   "text": "רבי יחיאל מיכל יורד לחוף, עטוף בטלית,"
  },
  {
   "start": 419.76,
   "end": 420.4,
   "text": "מחזור,"
  },
  {
   "start": 421.18,
   "end": 421.76,
   "text": "מתפלל בדבקות."
  },
  {
   "start": 425.3,
   "end": 430.42,
   "text": "נושאי האונייה סביבו עומדים וכולם חדורי התפעלות,"
  },
  {
   "start": 431.38,
   "end": 433.58,
   "text": "מתבוננים כלא מאמינים,"
  },
  {
   "start": 434.76,
   "end": 435.92,
   "text": "אבל מתבוננים בדומייה."
  },
  {
   "start": 436.8,
   "end": 438.64,
   "text": "איך היהודי מתפלל? באיזה דבקות?"
  },
  {
   "start": 439.44,
   "end": 440.74,
   "text": "איך הוא אחוז בבוראו?"
  },
  {
   "start": 442.66,
   "end": 445.3,
   "text": "מתנדד לו בקצב אחיד."
  },
  {
   "start": 446.18,
   "end": 447.9,
   "text": "הקול שלו עולה ומשתפך."
  },
  {
   "start": 448.84,
   "end": 450.5,
   "text": "יחיאל מיכל התנתק מן הקרקע."
  },
  {
   "start": 452.58,
   "end": 452.8,
   "text": "כך,"
  },
  {
   "start": 453.42,
   "end": 454.0,
   "text": "באי הזה,"
  },
  {
   "start": 455.14,
   "end": 456.92,
   "text": "הוא מרגיש מחופר אל השם יתברך."
  },
  {
   "start": 458.52,
   "end": 458.94,
   "text": "יהודי,"
  },
  {
   "start": 459.64,
   "end": 462.32,
   "text": "הנשמה שלו ובורא עולם."
  },
  {
   "start": 465.18,
   "end": 466.22,
   "text": "למחרת בבוקר,"
  },
  {
   "start": 469.03,
   "end": 471.07,
   "text": "שוב יחיאל מיכל מתחיל בתפילות,"
  },
  {
   "start": 471.65,
   "end": 472.93,
   "text": "בבכיות לשם,"
  },
  {
   "start": 473.75,
   "end": 475.51,
   "text": "בכיות לבורא עולם."
  },
  {
   "start": 478.18,
   "end": 479.58,
   "text": "ובתום תפילת שחרית,"
  },
  {
   "start": 480.48,
   "end": 483.34,
   "text": "הוא מוציא מהתרמיל שלו את השופר."
  },
  {
   "start": 486.12,
   "end": 487.22,
   "text": "הוא מתחיל לתקוע."
  },
  {
   "start": 488.42,
   "end": 489.28,
   "text": "תקיעה!"
  },
  {
   "start": 490.34,
   "end": 491.72,
   "text": "שברים!"
  },
  {
   "start": 493.1,
   "end": 494.64,
   "text": "תרועה!"
  },
  {
   "start": 495.26,
   "end": 498.32,
   "text": "והכל עולה ומסתלסל לו."
  },
  {
   "start": 503.05,
   "end": 504.79,
   "text": "ומבין סבך העצים,"
  },
  {
   "start": 506.49,
   "end": 510.43,
   "text": "מבין סבך העצים באי יוצאים המוני ילידים,"
  },
  {
   "start": 510.81,
   "end": 511.51,
   "text": "תושבי האי,"
  },
  {
   "start": 512.19,
   "end": 514.05,
   "text": "מתאספים בהתרגשות סביבו."
  },
  {
   "start": 515.49,
   "end": 517.15,
   "text": "מעולם לא ראו דבר כזה."
  },
  {
   "start": 518.81,
   "end": 523.01,
   "text": "מעולם לא ראו אדם רוחני כל כך."
  },
  {
   "start": 524.61,
   "end": 526.23,
   "text": "וכולם מסתכלים, כולם מביטים,"
  },
  {
   "start": 527.97,
   "end": 528.89,
   "text": "איך המילים,"
  },
  {
   "start": 529.67,
   "end": 535.01,
   "text": "הניגון מתחבר לו עם האוויר הצלול ועולה לו מעלה-מעלה."
  },
  {
   "start": 538.26,
   "end": 540.48,
   "text": "הידיעה על האדם המיוחד הזה,"
  },
  {
   "start": 541.14,
   "end": 543.92,
   "text": "הרוחני הזה, עם השופר והתפילה,"
  },
  {
   "start": 544.46,
   "end": 545.56,
   "text": "הגיע עד לאוזני מלך ההיא,"
  },
  {
   "start": 550.15,
   "end": 550.85,
   "text": "והמלך"
  },
  {
   "start": 552.13,
   "end": 553.81,
   "text": "שלח לקרוא לו."
  },
  {
   "start": 554.53,
   "end": 555.95,
   "text": "הוא רוצה לדבר עם היהודי,"
  },
  {
   "start": 558.75,
   "end": 562.47,
   "text": "והמלך התחיל לנהל איתו שיחות באמצעות מתורגמן מטעם האונייה,"
  },
  {
   "start": 564.91,
   "end": 566.21,
   "text": "והמלך מתפעל,"
  },
  {
   "start": 566.75,
   "end": 568.73,
   "text": "מתפעל מהיהודים, מתפעל מהאמונה שלו,"
  },
  {
   "start": 569.71,
   "end": 570.81,
   "text": "מתפעל מהתפילה שלו."
  },
  {
   "start": 572.41,
   "end": 574.37,
   "text": "הוא כל כך התרשם, אומר לו, תשמע, יהודי,"
  },
  {
   "start": 574.75,
   "end": 575.73,
   "text": "אני מבקש ממך,"
  },
  {
   "start": 576.19,
   "end": 578.65,
   "text": "תישאר פה, תהיה היועץ האישי שלי,"
  },
  {
   "start": 578.97,
   "end": 580.11,
   "text": "תהיה הסגן שלי."
  },
  {
   "start": 581.79,
   "end": 583.65,
   "text": "אמר לו יחיאל, מיכל, אני לא יכול."
  },
  {
   "start": 585.09,
   "end": 585.73,
   "text": "אי אפשר."
  },
  {
   "start": 587.19,
   "end": 588.39,
   "text": "אני שייך למקום אחר."
  },
  {
   "start": 590.29,
   "end": 590.97,
   "text": "אז לפחות,"
  },
  {
   "start": 591.95,
   "end": 593.53,
   "text": "לפחות תשלח לי אנשים כמוך."
  },
  {
   "start": 594.31,
   "end": 596.01,
   "text": "תשלח לי יהודים."
  },
  {
   "start": 596.55,
   "end": 598.21,
   "text": "מבני העם היהודי שיהיו פה."
  },
  {
   "start": 603.53,
   "end": 604.91,
   "text": "אמר לו יחיאל למיכל,"
  },
  {
   "start": 605.53,
   "end": 606.89,
   "text": "תראה אדוני מלך ההיא,"
  },
  {
   "start": 607.51,
   "end": 614.75,
   "text": "אם הקדוש ברוך הוא היה רוצה שיהיו פה יהודים, היו מגיעים לכאן יהודים בעל כורחם."
  },
  {
   "start": 615.53,
   "end": 616.53,
   "text": "אבל אדוני המלך,"
  },
  {
   "start": 617.01,
   "end": 619.35,
   "text": "יש מלך בעולם, יש מלך לעולם."
  },
  {
   "start": 619.93,
   "end": 623.09,
   "text": "אם אין כאן יהודים ולא היו כאן יהודים,"
  },
  {
   "start": 623.53,
   "end": 625.59,
   "text": "כנראה אין צורך שיהיו כאן יהודים."
  },
  {
   "start": 626.63,
   "end": 627.47,
   "text": "והמלך,"
  },
  {
   "start": 628.35,
   "end": 630.17,
   "text": "המלך שלא התפעל כל כך,"
  },
  {
   "start": 633.49,
   "end": 637.51,
   "text": "כל כך כיבד את היהודי ושלח אותו לשלום."
  },
  {
   "start": 638.79,
   "end": 640.07,
   "text": "מספר ימים אחר כך"
  },
  {
   "start": 641.05,
   "end": 641.97,
   "text": "הפליגה לה האונייה."
  },
  {
   "start": 646.04,
   "end": 650.82,
   "text": "זמן קצר אחר כך, יחיאל מיכל היה בבית המדרש של הבעל שם טוב,"
  },
  {
   "start": 651.64,
   "end": 655.16,
   "text": "נכנס אל הקודש פנימה, אל הבעל שם טוב."
  },
  {
   "start": 655.92,
   "end": 658.34,
   "text": "הבעל שם טוב, איך שיחיאל מיכל נכנס,"
  },
  {
   "start": 658.92,
   "end": 659.76,
   "text": "קם ואמר לו,"
  },
  {
   "start": 660.38,
   "end": 662.16,
   "text": "רבי יחיאל מיכל, יקירי,"
  },
  {
   "start": 663.02,
   "end": 664.78,
   "text": "אתה יודע באי הזה שהיית,"
  },
  {
   "start": 665.78,
   "end": 668.02,
   "text": "לא היו יהודים מעולם."
  },
  {
   "start": 669.28,
   "end": 671.2,
   "text": "ואם אתה לא היית מגיע,"
  },
  {
   "start": 672.58,
   "end": 674.62,
   "text": "אם אתה לא היית מגיע לאי הזה,"
  },
  {
   "start": 675.84,
   "end": 676.58,
   "text": "עם שופר,"
  },
  {
   "start": 677.4,
   "end": 681.44,
   "text": "עם תפילה, מקדש שם שמיים במקום הזה,"
  },
  {
   "start": 686.23,
   "end": 697.21,
   "text": "היו יהודים אחרים נאלצים לגלות לשם על מנת לגאול את הניצוצות האלוקיים הטמונים שם."
  },
  {
   "start": 698.21,
   "end": 706.99,
   "text": "תדע לך, בכל מקום בעולם יש ניצוצות אלוקיים ועל היהודי לבוא ולגאול אותם ולהוציא אותם ולהעלות אותם."
  },
  {
   "start": 707.91,
   "end": 709.15,
   "text": "זה התפקיד של היהודי."
  },
  {
   "start": 710.65,
   "end": 714.11,
   "text": "באי הזה לא היה מעולם יהודי."
  },
  {
   "start": 714.57,
   "end": 718.09,
   "text": "לא הגיע יהודי למקום הזה לגאול את הניצוצות הקדושים האלה,"
  },
  {
   "start": 718.77,
   "end": 720.05,
   "text": "את הניצוצות האלוקיים האלה."
  },
  {
   "start": 720.79,
   "end": 721.89,
   "text": "ועכשיו שאתה היית שם,"
  },
  {
   "start": 722.47,
   "end": 726.47,
   "text": "ועכשיו שהעלית קידוש שם שמיים נפלא כמו שעשית,"
  },
  {
   "start": 726.69,
   "end": 728.75,
   "text": "העלית שם ניצוצות אלוקיים נפלאים,"
  },
  {
   "start": 729.33,
   "end": 731.23,
   "text": "כבר לא יצטרכו להיות שם יהודים."
  },
  {
   "start": 732.35,
   "end": 735.51,
   "text": "לא יצטרכו לסבול יהודים גלות עד לשם."
  },
  {
   "start": 737.07,
   "end": 741.05,
   "text": "כמו שהתפזרו בכל העולם על מנת לגאול לשם את הניצוצות האלוקיים."
  },
  {
   "start": 743.03,
   "end": 743.91,
   "text": "אמר הבעל שם טוב,"
  },
  {
   "start": 748.09,
   "end": 751.19,
   "text": "ואנחנו צריכים לדעת, אנחנו פה בעולם, פה בארץ."
  },
  {
   "start": 752.13,
   "end": 754.03,
   "text": "כל אחד במקום שהוא נמצא."
  },
  {
   "start": 755.11,
   "end": 758.55,
   "text": "צריכים לדעת, במקום שלנו יש ניצוצות אלוקיים,"
  },
  {
   "start": 759.11,
   "end": 760.35,
   "text": "שמחכים לי,"
  },
  {
   "start": 760.93,
   "end": 761.79,
   "text": "מחכים לך,"
  },
  {
   "start": 762.31,
   "end": 763.15,
   "text": "מחכים לך,"
  },
  {
   "start": 763.71,
   "end": 764.77,
   "text": "שנבוא ונגאל אותם,"
  },
  {
   "start": 765.39,
   "end": 768.45,
   "text": "שנקדש שם שמיים בכל מקום שאנחנו נמצאים,"
  },
  {
   "start": 768.83,
   "end": 772.61,
   "text": "שנעשה קידוש בכל מקום שאנחנו נמצאים."
  },
  {
   "start": 773.41,
   "end": 774.97,
   "text": "כי אם אנחנו לא נעשה קידוש,"
  },
  {
   "start": 776.25,
   "end": 777.73,
   "text": "הגויים יעשו לנו הבדלה."
  },
  {
   "start": 779.09,
   "end": 782.09,
   "text": "כי בכל מקום שעם ישראל לא עשה קידוש שם שמיים,"
  },
  {
   "start": 782.61,
   "end": 783.73,
   "text": "לא עשה קידוש,"
  },
  {
   "start": 784.09,
   "end": 786.89,
   "text": "באו הגויים רחמנא ליצלן ועשו להם הבדלה."
  },
  {
   "start": 787.61,
   "end": 789.61,
   "text": "אבל אנחנו בכל מקום שנימצא,"
  },
  {
   "start": 789.99,
   "end": 790.87,
   "text": "בכל פינה,"
  },
  {
   "start": 791.21,
   "end": 792.05,
   "text": "בכל חושך,"
  },
  {
   "start": 792.43,
   "end": 798.83,
   "text": "איפה שלא נהיה, דתי, חילוני, לא יודע מה, מסורתי, מה שנקרא לזה, יהודי!"
  },
  {
   "start": 799.33,
   "end": 802.01,
   "text": "תקדש שם שמיים, תקדשי שם שמיים."
  },
  {
   "start": 811.21,
   "end": 812.21,
   "text": "אז בואו בעזרת השם,"
  },
  {
   "start": 813.01,
   "end": 813.61,
   "text": "בואו,"
  },
  {
   "start": 814.25,
   "end": 815.57,
   "text": "בואו נבין את הערך שלנו,"
  },
  {
   "start": 816.09,
   "end": 817.07,
   "text": "את הערך של היהודי,"
  },
  {
   "start": 817.61,
   "end": 818.51,
   "text": "ערך של היהודייה."
  }
 ]
}