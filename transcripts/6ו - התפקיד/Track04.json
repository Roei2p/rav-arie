{
 "disc": "6ו - התפקיד",
 "track": "Track04",
 "duration": 694.08,
 "segments": [
  {
   "start": 2.41,
   "end": 3.05,
   "text": "אומרת הגמרא,"
  },
  {
   "start": 4.39,
   "end": 9.09,
   "text": "שהיה מפגש בתקופת בית שני,"
  },
  {
   "start": 10.27,
   "end": 11.13,
   "text": "אחרי החורבן,"
  },
  {
   "start": 11.77,
   "end": 13.57,
   "text": "כשהרומאים שלטו פה בארץ,"
  },
  {
   "start": 14.71,
   "end": 15.35,
   "text": "מפגש"
  },
  {
   "start": 16.83,
   "end": 17.13,
   "text": "בין"
  },
  {
   "start": 18.43,
   "end": 19.91,
   "text": "רבי יהודה בר אלאי,"
  },
  {
   "start": 20.59,
   "end": 21.27,
   "text": "רבי יוסה"
  },
  {
   "start": 22.33,
   "end": 23.69,
   "text": "ורבי שמעון בר יוחאי."
  },
  {
   "start": 26.8,
   "end": 28.14,
   "text": "רבי יהודה בר אלאי אמר,"
  },
  {
   "start": 28.92,
   "end": 29.5,
   "text": "הרומאים,"
  },
  {
   "start": 30.02,
   "end": 31.82,
   "text": "כמה נעים מעשיה של אומה זו."
  },
  {
   "start": 32.36,
   "end": 33.8,
   "text": "הרומאים עשו גם דברים טובים פה."
  },
  {
   "start": 34.46,
   "end": 36.06,
   "text": "שמו, תיקנו מרחצאות,"
  },
  {
   "start": 36.74,
   "end": 40.56,
   "text": "עשו כבישים, סללו כבישים, איזה יופי, פיתחו את הארץ, בכל אופן, יש משהו טוב."
  },
  {
   "start": 41.62,
   "end": 44.7,
   "text": "כי רבי יהודה רצה ללמד אותנו שבכל דבר צריך להסתכל על הטוב"
  },
  {
   "start": 46.0,
   "end": 47.08,
   "text": "שהשם מרעיף עלינו."
  },
  {
   "start": 49.14,
   "end": 50.24,
   "text": "רבי יוסף שתק,"
  },
  {
   "start": 51.7,
   "end": 53.02,
   "text": "ורבי שמעון בר יוחאי"
  },
  {
   "start": 54.62,
   "end": 54.86,
   "text": "פתח ואמר,"
  },
  {
   "start": 57.36,
   "end": 60.28,
   "text": "כל מה שמעשו הרומאים עשו את זה לטובת עצמם."
  },
  {
   "start": 61.3,
   "end": 62.66,
   "text": "אנחנו צריכים את הפיתוח שלהם,"
  },
  {
   "start": 63.16,
   "end": 65.94,
   "text": "אנחנו צריכים את הכבישים שלהם, הכל הם עשו בשבילהם. למי יש עגלות?"
  },
  {
   "start": 66.44,
   "end": 68.7,
   "text": "למי יש מרכבות גדולות? להם, הם עשו את זה בשביל עצמם."
  },
  {
   "start": 69.2,
   "end": 70.18,
   "text": "לא צריך להתייחס לזה."
  },
  {
   "start": 71.82,
   "end": 73.14,
   "text": "לא צריך לשבח את זה."
  },
  {
   "start": 76.1,
   "end": 79.02,
   "text": "מה שקרה אחרי המפגש הזה, המפגש ההיסטורי הזה,"
  },
  {
   "start": 82.01,
   "end": 82.95,
   "text": "הדברים התפרסמו"
  },
  {
   "start": 83.79,
   "end": 84.35,
   "text": "והגיעו עד רומי."
  },
  {
   "start": 86.83,
   "end": 91.41,
   "text": "וברומי שמעו את מה שאמר רבי יהודה בר אלי, את שרבי יוסף שתק"
  },
  {
   "start": 92.11,
   "end": 93.95,
   "text": "ואת שרבי שמעון בר יוחאי גינה אותם."
  },
  {
   "start": 95.71,
   "end": 96.79,
   "text": "והם החליטו הרומאים."
  },
  {
   "start": 99.67,
   "end": 103.41,
   "text": "רבי יהודה בר אל-אי ששיבח אותנו נהיה ראש הדוברים בכל מקום."
  },
  {
   "start": 105.45,
   "end": 107.89,
   "text": "רבי יוסף, אתה שתקת, אתה תגלה."
  },
  {
   "start": 109.01,
   "end": 109.89,
   "text": "תגלה לציפורי."
  },
  {
   "start": 111.57,
   "end": 113.03,
   "text": "ורבי שמעון בר יוחאי,"
  },
  {
   "start": 113.89,
   "end": 115.41,
   "text": "אתה גינת אותנו."
  },
  {
   "start": 116.29,
   "end": 117.43,
   "text": "אתה תשלם בחייך."
  },
  {
   "start": 119.71,
   "end": 120.61,
   "text": "פסק דין מוות"
  },
  {
   "start": 121.23,
   "end": 123.07,
   "text": "ריחף מעל ראשו של רבי שמעון בר יוחאי."
  },
  {
   "start": 125.11,
   "end": 128.31,
   "text": "וכשרבי שמעון בר יוחאי שמע את זה, הוא ברח הוא והבן שלו לבית המדרש."
  },
  {
   "start": 128.31,
   "end": 130.79,
   "text": "וישבו בבית המדרש"
  },
  {
   "start": 132.83,
   "end": 133.87,
   "text": "אבל אחרי כמה זמן"
  },
  {
   "start": 134.93,
   "end": 137.81,
   "text": "בא רבי שמעון בר יוחאי נפגש עם רעייתו ואמר לה תדעי לך"
  },
  {
   "start": 138.41,
   "end": 140.77,
   "text": "אני יודע שאת עדינה, אני יודע שאת צדקת"
  },
  {
   "start": 142.45,
   "end": 143.23,
   "text": "אבל את עדינה"
  },
  {
   "start": 143.91,
   "end": 145.25,
   "text": "ואני מפחד שהרומאים יבואו"
  },
  {
   "start": 146.41,
   "end": 147.35,
   "text": "ויענו אותך"
  },
  {
   "start": 149.62,
   "end": 152.16,
   "text": "אז אני מעדיף לברוח למקום שבאמת לא תדעי"
  },
  {
   "start": 153.1,
   "end": 155.88,
   "text": "ברגע שהם ישמעו אותך הם ידעו שאת דוברת אמת ולא יענו אותך"
  },
  {
   "start": 156.56,
   "end": 159.1,
   "text": "כי ניכר בקולו של אדם אם הוא דובר אמת או לא"
  },
  {
   "start": 161.42,
   "end": 161.94,
   "text": "והוא ברח,"
  },
  {
   "start": 162.98,
   "end": 163.98,
   "text": "ברח מבית המדרש."
  },
  {
   "start": 165.24,
   "end": 166.86,
   "text": "יותר נכון, יצא מבית המדרש, לא ברח."
  },
  {
   "start": 167.18,
   "end": 169.18,
   "text": "רבי שמעון בר יוחאי, מהעולם לא ברח מבית המדרש."
  },
  {
   "start": 169.86,
   "end": 170.98,
   "text": "יצא מבית המדרש,"
  },
  {
   "start": 172.5,
   "end": 174.1,
   "text": "והתחבא במערה הוא והבן שלו."
  },
  {
   "start": 178.04,
   "end": 179.04,
   "text": "13 שנה"
  },
  {
   "start": 180.46,
   "end": 181.14,
   "text": "הם יושבים."
  },
  {
   "start": 182.68,
   "end": 185.3,
   "text": "כל ימות החול הם מכוסים בחול."
  },
  {
   "start": 187.06,
   "end": 189.02,
   "text": "ורק בשבת הם לובשים את הבגדים."
  },
  {
   "start": 189.02,
   "end": 194.18,
   "text": "אתם יודעים מה זה 24 שעות ביממה, יום אחרי יום"
  },
  {
   "start": 195.66,
   "end": 197.12,
   "text": "להיות מכוסה בחול?"
  },
  {
   "start": 203.78,
   "end": 204.66,
   "text": "איזה קושי זה,"
  },
  {
   "start": 205.44,
   "end": 206.08,
   "text": "איזה סבל."
  },
  {
   "start": 206.74,
   "end": 208.74,
   "text": "אתם יכולים להבין את זה, יום, דקה להיות."
  },
  {
   "start": 209.46,
   "end": 210.2,
   "text": "אתם חושבים מה זה שעה?"
  },
  {
   "start": 211.06,
   "end": 212.68,
   "text": "מה זה יום שלם ככה?"
  },
  {
   "start": 213.46,
   "end": 214.4,
   "text": "טוב, אולי נגיד יום."
  },
  {
   "start": 215.3,
   "end": 218.38,
   "text": "יומיים, שלושה, שבוע ככה."
  },
  {
   "start": 219.12,
   "end": 221.52,
   "text": "שבועיים, שנה,"
  },
  {
   "start": 222.5,
   "end": 223.66,
   "text": "שנה שלמה."
  },
  {
   "start": 224.66,
   "end": 229.06,
   "text": "אחרי איזה עוד שנה ילד נכנס בכיתה א',"
  },
  {
   "start": 229.88,
   "end": 238.68,
   "text": "אחרי 12 שנה הוא גומר כבר בגיל 18. ואיזה 12 שנה, עוד לא את ה-13 שנה."
  },
  {
   "start": 239.78,
   "end": 243.86,
   "text": "ורבי שמעון בר יוחאי, שנה אחרי שנה, איזה סבל!"
  },
  {
   "start": 245.72,
   "end": 247.06,
   "text": "אה, פתאום 13 שנה"
  },
  {
   "start": 248.32,
   "end": 249.28,
   "text": "אחרי מות הקיסר"
  },
  {
   "start": 250.16,
   "end": 251.94,
   "text": "מתבטלת לה הגזירה והוא יוצא."
  },
  {
   "start": 252.6,
   "end": 255.38,
   "text": "הקיסר הרומי מת ומתבטלת לה הגזירה והוא יוצא."
  },
  {
   "start": 256.76,
   "end": 257.32,
   "text": "והוא בא הביתה,"
  },
  {
   "start": 257.98,
   "end": 260.5,
   "text": "מקבל אותו רבי פנחס בן יאיר החותן שלו,"
  },
  {
   "start": 268.84,
   "end": 269.5,
   "text": "ומקבל את פניו."
  },
  {
   "start": 271.64,
   "end": 272.98,
   "text": "ורבי שמעון בר יוחאי"
  },
  {
   "start": 274.06,
   "end": 274.7,
   "text": "הולך למקווה,"
  },
  {
   "start": 275.94,
   "end": 278.18,
   "text": "ורבי פנחס בן יאיר הולך בעקבותיו,"
  },
  {
   "start": 279.64,
   "end": 280.44,
   "text": "ומגיעים למקווה,"
  },
  {
   "start": 281.72,
   "end": 285.94,
   "text": "ורבי שמעון בר יוחאי מוריד את הגלימה שלו,"
  },
  {
   "start": 287.76,
   "end": 288.64,
   "text": "וטובל במקווה."
  },
  {
   "start": 289.04,
   "end": 295.02,
   "text": "ורבי פנחס בן יאיר רואה את הגב של החתן הקדוש שלו,"
  },
  {
   "start": 295.66,
   "end": 297.32,
   "text": "של רבי שמעון בר יוחאי,"
  },
  {
   "start": 298.0,
   "end": 300.34,
   "text": "והגב כולו בקוע,"
  },
  {
   "start": 301.7,
   "end": 303.8,
   "text": "כולו קרעים קרעים,"
  },
  {
   "start": 305.26,
   "end": 309.5,
   "text": "בקעים בקעים מהחול, איום ונורא, מראה איום ונורא."
  },
  {
   "start": 310.34,
   "end": 312.02,
   "text": "ורבי פנחס בן יאיר,"
  },
  {
   "start": 312.86,
   "end": 317.92,
   "text": "תן הקדוש, לא יכול להחזיק מעמד, פשוט הוא התחיל לבכות,"
  },
  {
   "start": 318.84,
   "end": 319.4,
   "text": "ובוכה"
  },
  {
   "start": 320.18,
   "end": 320.76,
   "text": "ובוכה"
  },
  {
   "start": 321.56,
   "end": 326.64,
   "text": "ורבי שמעון בר יוחאי בתוך המים לפתע טיפה"
  },
  {
   "start": 328.6,
   "end": 339.64,
   "text": "דמעה מלוכה נשרה מעיניו של רבי פנחס בן יאיר החותן של רבי שמעון בר יוחאי דמעה מלוכה נשרה מעיניו"
  },
  {
   "start": 340.2,
   "end": 340.96,
   "text": "ונחתה"
  },
  {
   "start": 342.2,
   "end": 344.42,
   "text": "על גבו של רבי שמעון בר יוחאי"
  },
  {
   "start": 345.54,
   "end": 346.6,
   "text": "בין הבקעים"
  },
  {
   "start": 347.54,
   "end": 349.72,
   "text": "רבי שמעון בר יוחאי סחש בצריבה,"
  },
  {
   "start": 350.28,
   "end": 351.2,
   "text": "הרים את עיניו"
  },
  {
   "start": 352.08,
   "end": 356.72,
   "text": "ורואה את החותן שלו, את החותן הגדול שלו בוכה."
  },
  {
   "start": 360.43,
   "end": 362.25,
   "text": "אמר לו רבי שמעון בר יוחאי,"
  },
  {
   "start": 363.43,
   "end": 364.55,
   "text": "למה אתה בוכה?"
  },
  {
   "start": 366.13,
   "end": 371.03,
   "text": "אמר לו, אוי לי שראיתיך בכך,"
  },
  {
   "start": 371.95,
   "end": 375.09,
   "text": "אוי לי שאני רואה אותך כך, איך סבלת."
  },
  {
   "start": 377.67,
   "end": 379.71,
   "text": "אמר לו רבי שמעון בר יוחאי,"
  },
  {
   "start": 380.21,
   "end": 382.85,
   "text": "אל תבכה, אל תבכה."
  },
  {
   "start": 383.63,
   "end": 386.91,
   "text": "אוי לי, אם לא ראיתני בכך,"
  },
  {
   "start": 387.67,
   "end": 390.07,
   "text": "כי אילולא ראיתני בכך,"
  },
  {
   "start": 390.77,
   "end": 392.21,
   "text": "לא הייתי כך."
  },
  {
   "start": 392.95,
   "end": 396.65,
   "text": "אמר לו רבי שמעון בר יוחאי, אוי לי,"
  },
  {
   "start": 397.37,
   "end": 398.95,
   "text": "אם לא ראיתני בכך,"
  },
  {
   "start": 399.63,
   "end": 401.55,
   "text": "כי אילולא ראיתני בכך,"
  },
  {
   "start": 402.15,
   "end": 403.31,
   "text": "לא הייתי כך."
  },
  {
   "start": 404.31,
   "end": 409.49,
   "text": "אמר לו רבי שמעון בר יוחאי, אוי ואבוי לי,"
  },
  {
   "start": 409.77,
   "end": 411.57,
   "text": "אם לא ראית אותי כך."
  },
  {
   "start": 412.27,
   "end": 417.27,
   "text": "כי אם לא היית רואה שהגעתי למצב כזה, זה שאתה רואה ואתה מצטער,"
  },
  {
   "start": 417.83,
   "end": 420.73,
   "text": "זה המזל שהעלה אותי כל כך."
  },
  {
   "start": 421.53,
   "end": 425.59,
   "text": "זה הקושי שגרם לי להתעלות ולהתקדש כל כך."
  },
  {
   "start": 426.57,
   "end": 433.07,
   "text": "כי אילולא ראיתי ראיתני בכך, לא הייתי כך, לא הייתי רבי שמעון בר יוחאי."
  },
  {
   "start": 433.55,
   "end": 434.93,
   "text": "דווקא הקשיים,"
  },
  {
   "start": 435.37,
   "end": 436.73,
   "text": "דווקא הייסורים,"
  },
  {
   "start": 437.21,
   "end": 438.67,
   "text": "דווקא הכאב,"
  },
  {
   "start": 438.83,
   "end": 441.89,
   "text": "דווקא מה שאתה רואה ונראה בוכה, אתה בוכה, אתה אומר, איזה צער."
  },
  {
   "start": 442.81,
   "end": 447.57,
   "text": "דווקא זה בנה אותי, בנה את היהדות שלי, בנה את הנשמה שלי."
  },
  {
   "start": 450.36,
   "end": 450.82,
   "text": "אתם יודעים,"
  },
  {
   "start": 451.7,
   "end": 457.4,
   "text": "לפני שרבי שמעון בר יוחאי נכנס למערה ויושב עם חותנו,"
  },
  {
   "start": 457.92,
   "end": 459.24,
   "text": "עם רבי פנחס בן יאיר,"
  },
  {
   "start": 459.82,
   "end": 463.62,
   "text": "ועל כל קושייה וקושייה של רבי שמעון בר יוחאי,"
  },
  {
   "start": 464.46,
   "end": 466.64,
   "text": "היה עונה רבי פנחס בן יאיר"
  },
  {
   "start": 467.94,
   "end": 469.6,
   "text": "בכ-12 תירוצים."
  },
  {
   "start": 471.38,
   "end": 478.32,
   "text": "יב תירוצים היה עונה רבי פנחס בן יאיר על כל קושייה וקושייה של רבי שמעון בר יוחאי."
  },
  {
   "start": 479.5,
   "end": 481.58,
   "text": "וכשיצא רבי שמעון בר יוחאי"
  },
  {
   "start": 482.94,
   "end": 487.12,
   "text": "על כל קושייה וקושייה של רבי פנחס בן יאיר,"
  },
  {
   "start": 487.92,
   "end": 491.52,
   "text": "היה עונה לו רבי שמעון בר יוחאי ב-24 תירוצים."
  },
  {
   "start": 495.78,
   "end": 496.68,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 498.38,
   "end": 500.82,
   "text": "אוי לי אם לא ראיתני בכך."
  },
  {
   "start": 502.2,
   "end": 506.82,
   "text": "כי אילולא ראיתני בכך, לא הייתי כך!"
  },
  {
   "start": 507.72,
   "end": 509.68,
   "text": "אומר רבי שמעון בר יוחאי."
  },
  {
   "start": 511.58,
   "end": 517.94,
   "text": "אתם יודעים איך נהייתי רבי שמעון בר יוחאי? אומר לנו לכולנו רבי שמעון בר יוחאי."
  },
  {
   "start": 518.4,
   "end": 520.66,
   "text": "איך אני כתבתי את הזוהר הקדוש?"
  },
  {
   "start": 521.3,
   "end": 528.34,
   "text": "איך הפצתי את כל תורת הקבלה בעולם? איך אני רבי שמעון בר יוחאי? נהייתי רבי שמעון בר יוחאי."
  },
  {
   "start": 529.22,
   "end": 532.82,
   "text": "אילולי ראיתני בכך,"
  },
  {
   "start": 533.54,
   "end": 540.5,
   "text": "לא הייתי אם לא סבלתי שלוש עשרה שנה בחול."
  },
  {
   "start": 541.16,
   "end": 545.26,
   "text": "העור שלי נפגע, לא הייתי רבי שמעון בר יוחאי."
  },
  {
   "start": 547.46,
   "end": 550.86,
   "text": "ככה אנחנו צריכים לדעת, כל אחד ואחת."
  },
  {
   "start": 552.7,
   "end": 554.78,
   "text": "צריך להסתכל על עצמו, לומר לעצמו,"
  },
  {
   "start": 555.14,
   "end": 555.66,
   "text": "אם לא הקשיים,"
  },
  {
   "start": 556.74,
   "end": 557.3,
   "text": "אם לא הייסורים,"
  },
  {
   "start": 558.18,
   "end": 558.88,
   "text": "אם לא הירידות,"
  },
  {
   "start": 559.22,
   "end": 560.6,
   "text": "לא הייתי אני!"
  },
  {
   "start": 562.4,
   "end": 563.66,
   "text": "לא הייתי עולה, כן,"
  },
  {
   "start": 564.18,
   "end": 565.48,
   "text": "ומי שלא יגיד את זה עכשיו,"
  },
  {
   "start": 566.06,
   "end": 567.78,
   "text": "מי שעדיין לא יודע ולא מאמין,"
  },
  {
   "start": 568.18,
   "end": 569.6,
   "text": "עוד יגיע זמן הגאולה,"
  },
  {
   "start": 570.6,
   "end": 575.84,
   "text": "שמשה רבנו וכל הנביאים וכל הקדושים יראו לו את זה פנים בפנים,"
  },
  {
   "start": 576.24,
   "end": 577.94,
   "text": "יראו לך פנים בפנים,"
  },
  {
   "start": 578.28,
   "end": 579.46,
   "text": "תראי מה היית שווה."
  },
  {
   "start": 582.11,
   "end": 585.25,
   "text": "כי אילולא ראיתני בכך לא הייתי כך,"
  },
  {
   "start": 586.43,
   "end": 589.27,
   "text": "אילולא הקשיים לא הייתי מגיע למה שאני הגעתי."
  },
  {
   "start": 591.57,
   "end": 593.77,
   "text": "אתם יודעים, אומר הפסיקתא רבתי,"
  },
  {
   "start": 594.49,
   "end": 601.94,
   "text": "פרשה מ... מ... מ... מ... היה איזה בן מלך שהתרחק מאבא שלו."
  },
  {
   "start": 603.02,
   "end": 604.96,
   "text": "התרחק, ויום אחד הוא רצה לחזור."
  },
  {
   "start": 606.74,
   "end": 609.38,
   "text": "באו היעצים של המלך, רואים אותו, רוצה לחזור, אומרים לו, בוא!"
  },
  {
   "start": 610.4,
   "end": 611.62,
   "text": "בוא לאבא, בוא למלך!"
  },
  {
   "start": 612.5,
   "end": 615.5,
   "text": "אמר להם, קשה לי, אני רחוק, קשה לי!"
  },
  {
   "start": 617.08,
   "end": 619.42,
   "text": "אני לא יכול, אני רוצה, אבל לא יכול."
  },
  {
   "start": 621.04,
   "end": 621.9,
   "text": "אמרו את זה למלך."
  },
  {
   "start": 622.86,
   "end": 627.1,
   "text": "שלח לו המלך הודה, אמר לו, תדע לך, בני היקר, אתה הבן שלי."
  },
  {
   "start": 627.98,
   "end": 629.04,
   "text": "גם כשהתרחקת,"
  },
  {
   "start": 630.88,
   "end": 631.78,
   "text": "גם כשקשה,"
  },
  {
   "start": 632.5,
   "end": 634.08,
   "text": "גם כשנדבר לך שאתה לא יכול,"
  },
  {
   "start": 634.96,
   "end": 636.62,
   "text": "תלך לפי הכוח שלך."
  },
  {
   "start": 637.66,
   "end": 642.4,
   "text": "כמה שאתה יכול, תעשה את כל המאמצים. כמה שאת יכולת, תעשי את כל המאמצים."
  },
  {
   "start": 643.42,
   "end": 645.8,
   "text": "אתה תבוא אליי, תלך אליי."
  },
  {
   "start": 646.38,
   "end": 649.26,
   "text": "ואני כבר אבוא אליך, אני אשלים את הדרך."
  },
  {
   "start": 649.88,
   "end": 651.22,
   "text": "שובו אליי!"
  },
  {
   "start": 651.8,
   "end": 653.24,
   "text": "ואשובה עליכם."
  },
  {
   "start": 655.24,
   "end": 660.36,
   "text": "ואם אנחנו מרגישים שעדיין זה לא קורה, כאילו עשינו את המאמצים שלנו, באמת!"
  },
  {
   "start": 660.98,
   "end": 664.56,
   "text": "ללכת לכבוד השם יתברך, ללכת אל השם יתברך,"
  },
  {
   "start": 664.98,
   "end": 666.28,
   "text": "לעזוב את הכל,"
  },
  {
   "start": 666.68,
   "end": 667.56,
   "text": "את הכל,"
  },
  {
   "start": 668.14,
   "end": 671.74,
   "text": "את כל העולם הזה, וללכת אל השם יתברך."
  },
  {
   "start": 673.2,
   "end": 673.72,
   "text": "עד הסוף,"
  },
  {
   "start": 674.68,
   "end": 675.56,
   "text": "עד הסוף הטוב,"
  },
  {
   "start": 678.72,
   "end": 679.56,
   "text": "שובו אליי,"
  },
  {
   "start": 680.58,
   "end": 681.94,
   "text": "ואשובה עליכם."
  }
 ]
}