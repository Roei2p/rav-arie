{
 "disc": "12יב- ליבו של רשי",
 "track": "Track06",
 "duration": 1090.2,
 "segments": [
  {
   "start": 5.66,
   "end": 5.9,
   "text": "ווינה."
  },
  {
   "start": 7.74,
   "end": 10.22,
   "text": "בווינה שבאוסטריה,"
  },
  {
   "start": 13.87,
   "end": 16.13,
   "text": "שם בארמון המלכות יושב בבטחה,"
  },
  {
   "start": 16.95,
   "end": 21.27,
   "text": "הנסיך גוטפריד דה בויון מארגן מסע,"
  },
  {
   "start": 22.09,
   "end": 23.57,
   "text": "מסע לכיבוש ירושלים."
  },
  {
   "start": 25.76,
   "end": 29.46,
   "text": "הנסיך דה בויון ארגן כמות נכבדה של לוחמים,"
  },
  {
   "start": 30.22,
   "end": 32.64,
   "text": "בנה אסטרטגית שיטת לוחמה,"
  },
  {
   "start": 33.72,
   "end": 37.66,
   "text": "קיבל תמיכה מצוות היועצים שלו וסיכויי"
  },
  {
   "start": 37.66,
   "end": 40.18,
   "text": "וההצלחה הם רבים, רבים מאוד."
  },
  {
   "start": 42.38,
   "end": 42.48,
   "text": "אבל,"
  },
  {
   "start": 43.56,
   "end": 44.46,
   "text": "אבל אז בלילה"
  },
  {
   "start": 46.61,
   "end": 48.17,
   "text": "הוא חש איש שקט,"
  },
  {
   "start": 49.59,
   "end": 50.77,
   "text": "פחד שמלווה אותו"
  },
  {
   "start": 52.25,
   "end": 53.35,
   "text": "בלילות האחרונים."
  },
  {
   "start": 56.52,
   "end": 57.06,
   "text": "ואז הוא פונה,"
  },
  {
   "start": 57.9,
   "end": 62.28,
   "text": "הנסיר גודפריד דה ביון פונה ומבקש מיועצו הקרוב,"
  },
  {
   "start": 62.92,
   "end": 63.8,
   "text": "תמצא לי אדם,"
  },
  {
   "start": 66.61,
   "end": 67.49,
   "text": "אדם נעלה,"
  },
  {
   "start": 68.09,
   "end": 70.69,
   "text": "קדוש וחכם,"
  },
  {
   "start": 70.69,
   "end": 73.47,
   "text": "שינבא לי את תוצאות המלחמה,"
  },
  {
   "start": 74.35,
   "end": 76.05,
   "text": "תחפש מצדי בכל העולם,"
  },
  {
   "start": 76.47,
   "end": 82.79,
   "text": "תמצא לי אדם שיכול לחזק את הביטחון שלי בניצחון הכמעט-ודאי."
  },
  {
   "start": 85.6,
   "end": 86.02,
   "text": "והיועץ,"
  },
  {
   "start": 87.46,
   "end": 91.26,
   "text": "היועץ ממלמל מתחת לשפתיו,"
  },
  {
   "start": 91.9,
   "end": 92.66,
   "text": "אדוני הנסיך."
  },
  {
   "start": 93.58,
   "end": 94.14,
   "text": "יש אדם כזה,"
  },
  {
   "start": 95.76,
   "end": 99.38,
   "text": "בעיר טרויש שבמחוז שמפניה."
  },
  {
   "start": 99.38,
   "end": 102.32,
   "text": "יש יהודי,"
  },
  {
   "start": 103.18,
   "end": 104.18,
   "text": "חכם יהודי,"
  },
  {
   "start": 104.98,
   "end": 108.42,
   "text": "שיודע את התורה, התורה הקדושה של היהודים."
  },
  {
   "start": 109.44,
   "end": 112.36,
   "text": "אנחנו מכנים אותו סלומון דלונאל."
  },
  {
   "start": 114.94,
   "end": 118.68,
   "text": "אצל היהודים הוא נקרא רבי שלמה יצחקי."
  },
  {
   "start": 120.68,
   "end": 121.74,
   "text": "הם מכנים אותו רשי,"
  },
  {
   "start": 127.6,
   "end": 129.16,
   "text": "הוא האדם שאתה מחפש."
  },
  {
   "start": 130.54,
   "end": 131.12,
   "text": "והנסיך"
  },
  {
   "start": 131.74,
   "end": 132.56,
   "text": "לא מתמהמה,"
  },
  {
   "start": 133.36,
   "end": 135.14,
   "text": "הוא שולח פרש."
  },
  {
   "start": 136.76,
   "end": 149.76,
   "text": "פרש שאמור תוך יומיים להתייצב אצל היהודי הקדוש רשי,"
  },
  {
   "start": 150.58,
   "end": 151.28,
   "text": "איש התורה,"
  },
  {
   "start": 154.24,
   "end": 155.74,
   "text": "ולחזור חזרה עם תוצאות,"
  },
  {
   "start": 156.56,
   "end": 157.68,
   "text": "עם תשובות מדויקות."
  },
  {
   "start": 159.0,
   "end": 162.02,
   "text": "והפרש יוצא לדרך במהירות."
  },
  {
   "start": 166.71,
   "end": 169.63,
   "text": "מספר ימים אחר כך הוא חוזר."
  },
  {
   "start": 170.99,
   "end": 172.05,
   "text": "אדוני הנסיך,"
  },
  {
   "start": 172.73,
   "end": 175.55,
   "text": "הרב מסרב לענות."
  },
  {
   "start": 177.73,
   "end": 180.65,
   "text": "גוטפריד דה בויון היה רגיל להרבה דברים,"
  },
  {
   "start": 181.85,
   "end": 187.46,
   "text": "אבל למישהו שיסרב לדברים שלו,"
  },
  {
   "start": 187.96,
   "end": 188.88,
   "text": "את זה הוא לא היה רגיל,"
  },
  {
   "start": 189.96,
   "end": 190.7,
   "text": "את זה הוא לא יכל לספוג."
  },
  {
   "start": 193.14,
   "end": 193.82,
   "text": "וגוטפריד,"
  },
  {
   "start": 194.68,
   "end": 197.2,
   "text": "הנסיר גוטפריד מגיע, זועם כולו,"
  },
  {
   "start": 197.7,
   "end": 200.58,
   "text": "מגיע לטרויש עם קבוצת חיילים."
  },
  {
   "start": 204.42,
   "end": 205.6,
   "text": "הוא מגיע לביתו של רשי,"
  },
  {
   "start": 206.68,
   "end": 207.64,
   "text": "פותח את הדלת"
  },
  {
   "start": 210.41,
   "end": 212.31,
   "text": "אחר מספר דפיקות נזעמות,"
  },
  {
   "start": 215.74,
   "end": 216.24,
   "text": "והבית,"
  },
  {
   "start": 217.56,
   "end": 219.54,
   "text": "הבית שנגלה אל החיילים,"
  },
  {
   "start": 220.48,
   "end": 221.14,
   "text": "ריק,"
  },
  {
   "start": 221.74,
   "end": 222.34,
   "text": "ריק מאדם."
  },
  {
   "start": 223.06,
   "end": 223.44,
   "text": "הם לא מבינים,"
  },
  {
   "start": 224.2,
   "end": 225.52,
   "text": "לפי העדויות שבידיהם."
  },
  {
   "start": 226.32,
   "end": 227.58,
   "text": "רשי היה צריך להיות שם."
  },
  {
   "start": 228.42,
   "end": 230.52,
   "text": "החכם היהודי היה צריך להיות שם."
  },
  {
   "start": 234.71,
   "end": 234.91,
   "text": "ואז"
  },
  {
   "start": 235.45,
   "end": 236.61,
   "text": "גורדפילד דה-ביון מרגיש,"
  },
  {
   "start": 237.17,
   "end": 239.39,
   "text": "מרגיש, באיזה תנועה כמעט בלתי נראית,"
  },
  {
   "start": 239.95,
   "end": 240.79,
   "text": "מסתכל ימינה,"
  },
  {
   "start": 243.42,
   "end": 245.88,
   "text": "בכיסא שהיה לפני שנייה ריק,"
  },
  {
   "start": 249.02,
   "end": 249.88,
   "text": "ריק מאדם,"
  },
  {
   "start": 250.88,
   "end": 254.66,
   "text": "יושב לא פחות ולא יותר הרב הגדול,"
  },
  {
   "start": 255.7,
   "end": 258.32,
   "text": "האיש שכך אמר לו היועץ,"
  },
  {
   "start": 258.78,
   "end": 260.6,
   "text": "כך אמר לו היועץ המסור שלו,"
  },
  {
   "start": 262.48,
   "end": 268.68,
   "text": "יכול לגלות לו, לומר לו את מה שהוא כל כך רוצה לדעת,"
  },
  {
   "start": 268.98,
   "end": 271.82,
   "text": "את מה שרק אדם ששקוע בתורה הקדושה,"
  },
  {
   "start": 272.34,
   "end": 278.8,
   "text": "בתורה האלוקית שניתנה במעמד הר סיני, באותו מעמד המופלא לעם מופלא,"
  },
  {
   "start": 280.6,
   "end": 283.02,
   "text": "רק אצלו אפשר למצוא את התשובה."
  },
  {
   "start": 284.38,
   "end": 285.34,
   "text": "והוא פונה אליו ואומר לו,"
  },
  {
   "start": 286.62,
   "end": 287.36,
   "text": "אני רוצה לדעת."
  },
  {
   "start": 288.72,
   "end": 292.16,
   "text": "אני יוצא למסע, מסע של מלחמה אל עיר הקודש ירושלים."
  },
  {
   "start": 293.26,
   "end": 293.96,
   "text": "אני רוצה לדעת"
  },
  {
   "start": 295.28,
   "end": 296.38,
   "text": "מה תהיינה התוצאות."
  },
  {
   "start": 299.45,
   "end": 300.93,
   "text": "ושמעתי שאתה מסרב לענות לי."
  },
  {
   "start": 303.3,
   "end": 305.76,
   "text": "סירבתי כי אני יודע שלא תוכל לשמוע לי."
  },
  {
   "start": 320.28,
   "end": 321.5,
   "text": "מדוע סירבת לענות לי?"
  },
  {
   "start": 325.06,
   "end": 325.5,
   "text": "הנסיך,"
  },
  {
   "start": 326.26,
   "end": 326.94,
   "text": "לא כדאי לך."
  },
  {
   "start": 327.56,
   "end": 330.16,
   "text": "לא כדאי לך לצאת,"
  },
  {
   "start": 333.1,
   "end": 333.88,
   "text": "עונה לו רשי"
  },
  {
   "start": 335.3,
   "end": 335.74,
   "text": "ברוך"
  },
  {
   "start": 336.54,
   "end": 337.08,
   "text": "ובעדינות,"
  },
  {
   "start": 338.56,
   "end": 340.72,
   "text": "כאילו שוקל כל מילה ומילה."
  },
  {
   "start": 342.26,
   "end": 342.98,
   "text": "והנסיך?"
  },
  {
   "start": 347.31,
   "end": 347.95,
   "text": "הנסיך."
  },
  {
   "start": 350.23,
   "end": 350.79,
   "text": "כלומר,"
  },
  {
   "start": 351.81,
   "end": 354.83,
   "text": "כלומר אני אפסיד, כלומר אתה אומר שאני אפסיד."
  },
  {
   "start": 359.21,
   "end": 359.57,
   "text": "ורשי,"
  },
  {
   "start": 360.95,
   "end": 361.59,
   "text": "רשי אומר,"
  },
  {
   "start": 363.23,
   "end": 366.53,
   "text": "לא, דווקא אתה תנצח."
  },
  {
   "start": 367.57,
   "end": 367.77,
   "text": "אבל,"
  },
  {
   "start": 368.41,
   "end": 369.53,
   "text": "אבל רק בהתחלה."
  },
  {
   "start": 371.11,
   "end": 372.21,
   "text": "אתה תגיע לירושלים,"
  },
  {
   "start": 373.25,
   "end": 376.91,
   "text": "אתה תנצח, אתה תהיה למלך ירושלים."
  },
  {
   "start": 377.81,
   "end": 378.45,
   "text": "אבל לבסוף,"
  },
  {
   "start": 379.37,
   "end": 381.43,
   "text": "לבסוף יתגברו עליכם המוסלמים,"
  },
  {
   "start": 382.65,
   "end": 384.97,
   "text": "ואתה תיאלץ לחזור הביתה,"
  },
  {
   "start": 386.03,
   "end": 387.69,
   "text": "לחזור מובס לביתך."
  },
  {
   "start": 390.11,
   "end": 391.01,
   "text": "והנסיך,"
  },
  {
   "start": 391.61,
   "end": 395.75,
   "text": "הנסיך שמע את זה, והוא זעם, ועיניו ברקו."
  },
  {
   "start": 396.59,
   "end": 398.51,
   "text": "חכם יהודי,"
  },
  {
   "start": 399.25,
   "end": 400.61,
   "text": "מה יהיה מצב החיילים?"
  },
  {
   "start": 401.35,
   "end": 404.51,
   "text": "מה יהיה מצב הצבא שלי, אתה אומר?"
  },
  {
   "start": 407.26,
   "end": 407.56,
   "text": "רשי,"
  },
  {
   "start": 408.6,
   "end": 409.28,
   "text": "רשי ענה לו,"
  },
  {
   "start": 410.5,
   "end": 410.96,
   "text": "לא טוב."
  },
  {
   "start": 412.52,
   "end": 413.34,
   "text": "המצב יהיה לא טוב."
  },
  {
   "start": 414.14,
   "end": 415.24,
   "text": "לעיר הזו אתה תגיע."
  },
  {
   "start": 416.0,
   "end": 417.06,
   "text": "לעיר טרויש."
  },
  {
   "start": 417.48,
   "end": 419.8,
   "text": "אתה תגיע, אחרי כל המסע שלך,"
  },
  {
   "start": 420.4,
   "end": 424.98,
   "text": "תגיע בסך הכל עם שלושה פרשים."
  },
  {
   "start": 425.84,
   "end": 426.38,
   "text": "לא פחות"
  },
  {
   "start": 427.14,
   "end": 427.6,
   "text": "ולא יותר."
  },
  {
   "start": 428.38,
   "end": 431.62,
   "text": "שלושה פרשים בלבד מכל הצבא המהולל שלך."
  },
  {
   "start": 434.81,
   "end": 435.13,
   "text": "והנסיך,"
  },
  {
   "start": 436.09,
   "end": 438.39,
   "text": "הנסיך שמע את זה. הוא לא היה מוכן להשלים."
  },
  {
   "start": 439.01,
   "end": 439.81,
   "text": "לא ייתכן."
  },
  {
   "start": 440.51,
   "end": 441.51,
   "text": "שקר וכזב."
  },
  {
   "start": 442.43,
   "end": 444.23,
   "text": "שקר מוחלט."
  },
  {
   "start": 446.64,
   "end": 447.18,
   "text": "אבל עכשיו,"
  },
  {
   "start": 447.9,
   "end": 448.9,
   "text": "עכשיו אני אשתוק."
  },
  {
   "start": 449.76,
   "end": 451.4,
   "text": "מילה של גולדפריד דה בויון."
  },
  {
   "start": 454.97,
   "end": 457.53,
   "text": "אמרתי שאני לא אפגע בך אם תענה לי ואני אשתוק."
  },
  {
   "start": 459.21,
   "end": 459.31,
   "text": "אבל,"
  },
  {
   "start": 460.45,
   "end": 461.83,
   "text": "אבל אדוני החכם היהודי,"
  },
  {
   "start": 462.93,
   "end": 463.69,
   "text": "כשאני אחזור"
  },
  {
   "start": 467.48,
   "end": 468.78,
   "text": "אם מה שאמרת לא מתקיים."
  },
  {
   "start": 470.42,
   "end": 472.3,
   "text": "אתה וכל היהודים"
  },
  {
   "start": 473.12,
   "end": 474.02,
   "text": "תשלמו ביוקר,"
  },
  {
   "start": 475.18,
   "end": 475.68,
   "text": "אבל ביוקר."
  },
  {
   "start": 478.63,
   "end": 486.92,
   "text": "והנסיך יצא בזהם, ושם בחדר"
  },
  {
   "start": 490.7,
   "end": 497.94,
   "text": "יושב לו רבי שלמה יצחקי מול התורה הקדושה,"
  },
  {
   "start": 498.68,
   "end": 501.02,
   "text": "ולומד בעונג בל יתואר."
  },
  {
   "start": 502.74,
   "end": 505.46,
   "text": "כאילו איש לא איים עליו,"
  },
  {
   "start": 506.06,
   "end": 506.68,
   "text": "איש לא דיבר,"
  },
  {
   "start": 507.32,
   "end": 508.28,
   "text": "שום דבר לא קרה."
  },
  {
   "start": 508.82,
   "end": 510.36,
   "text": "אשי חוזר אל התורה הקדושה,"
  },
  {
   "start": 511.44,
   "end": 513.42,
   "text": "שקוע בעולמה של תורה,"
  },
  {
   "start": 514.1,
   "end": 517.18,
   "text": "בעולם שכולו אמת וטוהר."
  },
  {
   "start": 533.06,
   "end": 533.38,
   "text": "הנסיך,"
  },
  {
   "start": 534.2,
   "end": 538.06,
   "text": "הנסיך גוטפריד דה בויון בראש חייליו יוצא למסע"
  },
  {
   "start": 539.04,
   "end": 539.9,
   "text": "אל ירושלים,"
  },
  {
   "start": 543.86,
   "end": 545.98,
   "text": "שוטף את כל האזור בסערה,"
  },
  {
   "start": 546.76,
   "end": 547.96,
   "text": "הוא כובש את ירושלים."
  },
  {
   "start": 549.54,
   "end": 552.8,
   "text": "והוא וכל החיילים נמלאים שמחה ואושר,"
  },
  {
   "start": 553.12,
   "end": 555.66,
   "text": "שדרים נשלחים לכל ארצות אירופה,"
  },
  {
   "start": 558.08,
   "end": 559.16,
   "text": "הם שכחו רק דבר אחד,"
  },
  {
   "start": 561.26,
   "end": 563.0,
   "text": "את דברי רבי שלמה יצחקי."
  },
  {
   "start": 568.22,
   "end": 570.8,
   "text": "זמן מה אחר הניצחון הסוחף"
  },
  {
   "start": 573.08,
   "end": 575.72,
   "text": "גוטפריד דה בויון נתקל בקשיים."
  },
  {
   "start": 577.74,
   "end": 578.92,
   "text": "הוא נסחף לקרבות"
  },
  {
   "start": 582.86,
   "end": 590.07,
   "text": "חוזרים ונשנים עם המוסלמים שלא מוותרים ולא מוותרים."
  },
  {
   "start": 591.05,
   "end": 592.11,
   "text": "וזה נמשך עד,"
  },
  {
   "start": 592.95,
   "end": 596.61,
   "text": "עד להפסד הצורב"
  },
  {
   "start": 597.57,
   "end": 597.99,
   "text": "והמר,"
  },
  {
   "start": 599.45,
   "end": 602.43,
   "text": "וירושלים נלקחת ממנו,"
  },
  {
   "start": 605.44,
   "end": 606.5,
   "text": "והוא אוסף את עצמו."
  },
  {
   "start": 607.34,
   "end": 609.44,
   "text": "הנסיך דביון אוסף את עצמו בשארית כוחותיו,"
  },
  {
   "start": 610.92,
   "end": 611.3,
   "text": "חוזר,"
  },
  {
   "start": 612.02,
   "end": 616.18,
   "text": "שבור ומובס אל אירופה,"
  },
  {
   "start": 617.54,
   "end": 618.38,
   "text": "אל צרפת."
  },
  {
   "start": 625.28,
   "end": 628.2,
   "text": "אל גבול צרפת הוא מגיע עם שישה חיילים."
  },
  {
   "start": 630.39,
   "end": 630.99,
   "text": "את מי הוא יאשים?"
  },
  {
   "start": 632.89,
   "end": 634.39,
   "text": "בא ההפסד האיום והנורא הזה,"
  },
  {
   "start": 635.83,
   "end": 636.57,
   "text": "בתוכרי ליבו,"
  },
  {
   "start": 637.11,
   "end": 639.27,
   "text": "הוא מאשים את היהודי,"
  },
  {
   "start": 639.83,
   "end": 642.07,
   "text": "יהודי החכם שכנראה קילל אותו,"
  },
  {
   "start": 643.91,
   "end": 645.89,
   "text": "והוא מבקש לנקום."
  },
  {
   "start": 655.78,
   "end": 658.04,
   "text": "הוא אמר שאחזור עם שלושה פרשים,"
  },
  {
   "start": 658.52,
   "end": 660.16,
   "text": "לא פחות ולא יותר,"
  },
  {
   "start": 661.18,
   "end": 662.12,
   "text": "אבל יש לי שישה."
  },
  {
   "start": 663.66,
   "end": 664.8,
   "text": "עכשיו אני אוכל להוכיח"
  },
  {
   "start": 667.36,
   "end": 667.82,
   "text": "שהוא שיקר."
  },
  {
   "start": 669.32,
   "end": 670.06,
   "text": "כך הוא מסנן בכעס,"
  },
  {
   "start": 671.36,
   "end": 676.2,
   "text": "מתעלם מכל דבריו של רשי שהתקיימו בדיוק מופלא,"
  },
  {
   "start": 679.05,
   "end": 686.24,
   "text": "והוא רוכב עם שישה פרשים לפגוע ביהודי."
  },
  {
   "start": 687.16,
   "end": 690.84,
   "text": "יהודי אחד ששקוע בעולמה של תורה,"
  },
  {
   "start": 691.54,
   "end": 692.16,
   "text": "בעולם של תואר,"
  },
  {
   "start": 697.82,
   "end": 698.4,
   "text": "בשמיים."
  },
  {
   "start": 699.48,
   "end": 700.8,
   "text": "בשמיים כנראה חשבו אחרת."
  },
  {
   "start": 705.12,
   "end": 706.06,
   "text": "בדרך לטרויש,"
  },
  {
   "start": 706.9,
   "end": 707.68,
   "text": "עירו של רשי,"
  },
  {
   "start": 710.01,
   "end": 712.95,
   "text": "דרך לא ארוכה מגבול צרפת,"
  },
  {
   "start": 715.17,
   "end": 716.23,
   "text": "מתים להם באורח"
  },
  {
   "start": 716.91,
   "end": 721.08,
   "text": "פלא שני פרשים."
  },
  {
   "start": 732.73,
   "end": 733.07,
   "text": "עדיין,"
  },
  {
   "start": 733.91,
   "end": 735.59,
   "text": "עדיין נותרו לי ארבעה,"
  },
  {
   "start": 737.07,
   "end": 739.17,
   "text": "ארבעה פרשים, לא שלושה."
  },
  {
   "start": 740.21,
   "end": 742.03,
   "text": "חשב גודפילד הבויון ודוהר קדימה,"
  },
  {
   "start": 742.65,
   "end": 744.91,
   "text": "כאילו רוצה, כאילו רוצה להספיק"
  },
  {
   "start": 745.87,
   "end": 747.49,
   "text": "לפני שיאבד עוד אחד."
  },
  {
   "start": 755.44,
   "end": 757.06,
   "text": "כשאדם רוצה להתעלם מן האמת,"
  },
  {
   "start": 757.52,
   "end": 760.46,
   "text": "כשאדם רוצה לברוח מאמת התורה הקדושה,"
  },
  {
   "start": 761.0,
   "end": 763.36,
   "text": "הוא ימצא כל סיבה שבעולם,"
  },
  {
   "start": 763.92,
   "end": 767.96,
   "text": "כל טוענה להתחמק,"
  },
  {
   "start": 771.71,
   "end": 772.37,
   "text": "ועד מהרה"
  },
  {
   "start": 773.25,
   "end": 773.83,
   "text": "ניצבים"
  },
  {
   "start": 776.57,
   "end": 781.39,
   "text": "הנסיך דבויון ופרשיו בפני חומת העיר טרויאש."
  },
  {
   "start": 784.72,
   "end": 785.94,
   "text": "והנסיך דבויון מסמן"
  },
  {
   "start": 787.0,
   "end": 788.34,
   "text": "לאחד מארבעת הפרשים,"
  },
  {
   "start": 789.64,
   "end": 790.32,
   "text": "ליועץ שלו,"
  },
  {
   "start": 793.0,
   "end": 795.22,
   "text": "לפתוח את החומה, את דלת החומה."
  },
  {
   "start": 796.72,
   "end": 797.56,
   "text": "יועץ הנסיך מתקרב,"
  },
  {
   "start": 800.02,
   "end": 803.0,
   "text": "מתקרב אל דלת החומה, לפתוח אותה."
  },
  {
   "start": 804.38,
   "end": 806.16,
   "text": "ואז הוא לא שם לב,"
  },
  {
   "start": 806.94,
   "end": 807.64,
   "text": "שם מעל הדלת"
  },
  {
   "start": 807.64,
   "end": 810.52,
   "text": "הייתה מונחת אבן,"
  },
  {
   "start": 811.6,
   "end": 812.38,
   "text": "אבן כבדה."
  },
  {
   "start": 814.77,
   "end": 817.23,
   "text": "הוא פותח את הדלת ונשמע רעש,"
  },
  {
   "start": 817.63,
   "end": 818.27,
   "text": "רעש מלמעלה."
  },
  {
   "start": 818.71,
   "end": 819.93,
   "text": "הוא מרים את העיניים למעלה,"
  },
  {
   "start": 822.43,
   "end": 823.33,
   "text": "ואבן כבדה"
  },
  {
   "start": 824.15,
   "end": 825.47,
   "text": "שהייתה מונחת על החומה"
  },
  {
   "start": 826.73,
   "end": 827.67,
   "text": "נופלת לה."
  },
  {
   "start": 829.35,
   "end": 833.19,
   "text": "יועץ הנסיך נהרג במקום."
  },
  {
   "start": 836.4,
   "end": 837.26,
   "text": "גודפריד דה בויון"
  },
  {
   "start": 838.86,
   "end": 840.52,
   "text": "חש לראשונה בחייו חסר אונים."
  },
  {
   "start": 842.24,
   "end": 844.0,
   "text": "דברי איש האלוקים התקיימו"
  },
  {
   "start": 844.16,
   "end": 845.88,
   "text": "נותרנו"
  },
  {
   "start": 847.08,
   "end": 848.26,
   "text": "עם שלושה פרשים."
  },
  {
   "start": 850.22,
   "end": 853.54,
   "text": "אני נכנס לעיר שלו עם שלושה פרשים."
  },
  {
   "start": 854.36,
   "end": 854.96,
   "text": "מלמל,"
  },
  {
   "start": 855.86,
   "end": 856.78,
   "text": "מלמל בבהלה."
  },
  {
   "start": 860.2,
   "end": 860.36,
   "text": "אתה,"
  },
  {
   "start": 861.28,
   "end": 862.18,
   "text": "כבר לא היה מה לומר,"
  },
  {
   "start": 864.72,
   "end": 865.72,
   "text": "כבר לא היה על מי לכעוס."
  },
  {
   "start": 868.18,
   "end": 868.28,
   "text": "רק,"
  },
  {
   "start": 869.86,
   "end": 870.56,
   "text": "רק על עצמי"
  },
  {
   "start": 872.34,
   "end": 873.64,
   "text": "מלמל לנסיך."
  },
  {
   "start": 874.24,
   "end": 874.8,
   "text": "למה לא שמעתי?"
  },
  {
   "start": 875.54,
   "end": 877.7,
   "text": "למה לא שמעתי לאיש האלוקים הקדוש הזה?"
  },
  {
   "start": 880.83,
   "end": 883.71,
   "text": "כוח התורה של היהודים כל כך חזק,"
  },
  {
   "start": 884.35,
   "end": 885.13,
   "text": "כל כך עצום."
  },
  {
   "start": 887.62,
   "end": 888.52,
   "text": "אני חייב לבוא אליו."
  },
  {
   "start": 889.42,
   "end": 890.52,
   "text": "אני חייב להתקרב אליו."
  },
  {
   "start": 891.34,
   "end": 892.04,
   "text": "שיברך אותי."
  },
  {
   "start": 893.74,
   "end": 894.36,
   "text": "הוא צדק."
  },
  {
   "start": 895.36,
   "end": 896.14,
   "text": "הוא צדק."
  },
  {
   "start": 897.44,
   "end": 899.28,
   "text": "מלמל הנסיך בהתפעלות,"
  },
  {
   "start": 901.29,
   "end": 901.97,
   "text": "וכך,"
  },
  {
   "start": 903.75,
   "end": 904.57,
   "text": "בדהירה איטית,"
  },
  {
   "start": 906.71,
   "end": 907.83,
   "text": "בשפלות ראש,"
  },
  {
   "start": 908.51,
   "end": 909.39,
   "text": "הנסיך דביון"
  },
  {
   "start": 910.51,
   "end": 910.83,
   "text": "מתקרב"
  },
  {
   "start": 911.59,
   "end": 912.41,
   "text": "אל עבר ביתו,"
  },
  {
   "start": 916.37,
   "end": 916.79,
   "text": "ביתו של."
  },
  {
   "start": 917.91,
   "end": 918.35,
   "text": "איש האלוקים,"
  },
  {
   "start": 919.57,
   "end": 921.89,
   "text": "המפרש הגדול של התורה הקדושה,"
  },
  {
   "start": 922.67,
   "end": 923.63,
   "text": "רבי שלמה יצחקי,"
  },
  {
   "start": 924.67,
   "end": 925.07,
   "text": "רשי הקדוש."
  },
  {
   "start": 930.73,
   "end": 931.47,
   "text": "וכשהוא מתקרב,"
  },
  {
   "start": 932.27,
   "end": 932.97,
   "text": "מתקרב אל הבית,"
  },
  {
   "start": 934.37,
   "end": 938.51,
   "text": "הוא רואה שם בתחילת הרחוב מחזה מוזר."
  },
  {
   "start": 939.59,
   "end": 940.61,
   "text": "הרחוב היה מוצף"
  },
  {
   "start": 941.59,
   "end": 942.69,
   "text": "באלפי יהודים."
  },
  {
   "start": 944.69,
   "end": 946.45,
   "text": "כשמכנה משותף מאחד את כולם,"
  },
  {
   "start": 947.97,
   "end": 951.23,
   "text": "ראשים מורכנים ודמעות,"
  },
  {
   "start": 951.23,
   "end": 951.87,
   "text": "ודמעות,"
  },
  {
   "start": 952.65,
   "end": 953.75,
   "text": "דמעות בעיניים,"
  },
  {
   "start": 954.97,
   "end": 956.69,
   "text": "וכולם נעים כאיש אחד."
  },
  {
   "start": 958.01,
   "end": 958.57,
   "text": "דבר הנסיך"
  },
  {
   "start": 960.55,
   "end": 961.39,
   "text": "שואל מה קרה?"
  },
  {
   "start": 962.13,
   "end": 963.03,
   "text": "מה כולם עושים פה?"
  },
  {
   "start": 964.73,
   "end": 965.59,
   "text": "וילד קטן,"
  },
  {
   "start": 966.13,
   "end": 968.91,
   "text": "ילד יהודי קטן עם עיניים טהורות ובורקות,"
  },
  {
   "start": 969.49,
   "end": 970.01,
   "text": "אומר לו,"
  },
  {
   "start": 970.59,
   "end": 970.81,
   "text": "הרב,"
  },
  {
   "start": 972.15,
   "end": 972.39,
   "text": "הרב,"
  },
  {
   "start": 973.17,
   "end": 975.19,
   "text": "הרבי שלמה יצחקי,"
  },
  {
   "start": 976.31,
   "end": 979.21,
   "text": "נפטר, מת לנו, איבדנו אותו,"
  },
  {
   "start": 982.34,
   "end": 983.36,
   "text": "רשי איננו,"
  },
  {
   "start": 992.8,
   "end": 999.24,
   "text": "גוש של צהר עולה במעלה גרונו של גוטפריד דה בויון."
  },
  {
   "start": 1001.06,
   "end": 1001.98,
   "text": "הוא יורד מסוסו,"
  },
  {
   "start": 1003.1,
   "end": 1016.57,
   "text": "מרכין את ראשו ומצטרף למסע ההלוויה הגדול של הרב היהודי,"
  },
  {
   "start": 1017.69,
   "end": 1023.51,
   "text": "של עמוד התורה רבי שלמה יצחקי, רשי הקדוש."
  },
  {
   "start": 1024.17,
   "end": 1030.72,
   "text": "גוטפריד דה בויון מלווה את רשי בדרכו האחרונה,"
  },
  {
   "start": 1032.96,
   "end": 1034.12,
   "text": "כשהסתיים מסע ההלוויה,"
  },
  {
   "start": 1035.18,
   "end": 1036.2,
   "text": "כשהנסיך חזר"
  },
  {
   "start": 1037.52,
   "end": 1037.98,
   "text": "אל וינה"
  },
  {
   "start": 1040.65,
   "end": 1041.21,
   "text": "את הלקח,"
  },
  {
   "start": 1041.87,
   "end": 1042.91,
   "text": "את העוצמה האדירה"
  },
  {
   "start": 1043.51,
   "end": 1047.85,
   "text": "שהוא שאב במפגש הקצר שהיה לו עם רשי,"
  },
  {
   "start": 1048.85,
   "end": 1049.25,
   "text": "הוא לא שכח."
  },
  {
   "start": 1050.37,
   "end": 1054.51,
   "text": "כל ימיו הוא כיבד ודאג ליהודים,"
  },
  {
   "start": 1056.82,
   "end": 1057.22,
   "text": "כי גם,"
  },
  {
   "start": 1057.9,
   "end": 1061.16,
   "text": "גם נסיך גוי יודע להתבטל,"
  },
  {
   "start": 1061.64,
   "end": 1064.24,
   "text": "יודע להרכין ראש בפני העוצמה,"
  },
  {
   "start": 1064.24,
   "end": 1069.2,
   "text": "עוצמה רוחנית של התורה הקדושה ולא מתנהלת."
  }
 ]
}