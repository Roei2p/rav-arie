{
 "disc": "12יב- ליבו של רשי",
 "track": "Track04",
 "duration": 559.152,
 "segments": [
  {
   "start": 5.46,
   "end": 6.38,
   "text": "גרמניה,"
  },
  {
   "start": 7.78,
   "end": 9.18,
   "text": "בית המדרש הגדול בברלין,"
  },
  {
   "start": 10.02,
   "end": 10.76,
   "text": "המה מלומדים."
  },
  {
   "start": 14.14,
   "end": 17.08,
   "text": "הרב מאווירשי הוא בגמרא למאות תלמידים."
  },
  {
   "start": 20.47,
   "end": 20.83,
   "text": "אותו יום,"
  },
  {
   "start": 21.81,
   "end": 23.09,
   "text": "דף הגמרא שלמדו"
  },
  {
   "start": 23.91,
   "end": 26.21,
   "text": "היה דף שקשה ללימוד והבנה."
  },
  {
   "start": 28.57,
   "end": 30.53,
   "text": "הסוגיות שם היו מורכבות מאוד,"
  },
  {
   "start": 31.77,
   "end": 34.37,
   "text": "ולכולם, לכולם היה קשה להבין."
  },
  {
   "start": 36.13,
   "end": 37.33,
   "text": "וגם ראש הישיבה,"
  },
  {
   "start": 38.13,
   "end": 40.09,
   "text": "הרב הגאון התפתל בכיסאו,"
  },
  {
   "start": 40.81,
   "end": 41.65,
   "text": "בחוסר נוחות."
  },
  {
   "start": 44.24,
   "end": 46.9,
   "text": "ואז הוא פנה לתלמידיו ואמר להם."
  },
  {
   "start": 50.71,
   "end": 52.83,
   "text": "ניסינו להתעמק בסוגיה."
  },
  {
   "start": 54.33,
   "end": 55.13,
   "text": "ניסינו להבין"
  },
  {
   "start": 57.25,
   "end": 59.03,
   "text": "את הסוגיה כמו שצריך."
  },
  {
   "start": 62.46,
   "end": 64.48,
   "text": "בלימוד התורה אנחנו חותרים אל האמת."
  },
  {
   "start": 66.02,
   "end": 66.82,
   "text": "אל האמת."
  },
  {
   "start": 69.19,
   "end": 70.59,
   "text": "אנחנו רוצים לדעת בדיוק,"
  },
  {
   "start": 73.58,
   "end": 76.62,
   "text": "בדיוק מה בורא עולם, איך בורא עולם רוצה מאיתנו שנתנהג."
  },
  {
   "start": 80.77,
   "end": 83.89,
   "text": "לכן במקרה זה למדנו, ניסינו להבין עד כמה שאפשר."
  },
  {
   "start": 84.67,
   "end": 85.15,
   "text": "יותר מזה,"
  },
  {
   "start": 85.83,
   "end": 86.45,
   "text": "אנחנו לא יודעים."
  },
  {
   "start": 87.49,
   "end": 87.95,
   "text": "מי יודע?"
  },
  {
   "start": 88.53,
   "end": 89.59,
   "text": "אולי ריבונו של עולם,"
  },
  {
   "start": 89.99,
   "end": 93.29,
   "text": "אולי הקדוש ברוך הוא, מלך מלכי המלכים, הקדוש ברוך הוא,"
  },
  {
   "start": 93.59,
   "end": 95.11,
   "text": "יראה את המאמצים שלנו,"
  },
  {
   "start": 95.77,
   "end": 97.11,
   "text": "וישלח לנו אולי מלאך"
  },
  {
   "start": 97.75,
   "end": 98.63,
   "text": "שיגלה לנו,"
  },
  {
   "start": 99.53,
   "end": 101.35,
   "text": "ויבאר לנו את הדף הקדוש הזה."
  },
  {
   "start": 108.5,
   "end": 109.42,
   "text": "בואו נמשיך ללמוד."
  },
  {
   "start": 110.22,
   "end": 111.36,
   "text": "בואו נמשיך ללמוד הלאה,"
  },
  {
   "start": 111.96,
   "end": 112.6,
   "text": "אל הדף הבא."
  },
  {
   "start": 113.66,
   "end": 114.62,
   "text": "והם המשיכו ללמוד,"
  },
  {
   "start": 115.38,
   "end": 115.88,
   "text": "וללמוד,"
  },
  {
   "start": 116.78,
   "end": 117.26,
   "text": "וללמוד"
  },
  {
   "start": 126.75,
   "end": 127.65,
   "text": "שעת לילה מאוחרת."
  },
  {
   "start": 128.85,
   "end": 129.63,
   "text": "בית המדרש,"
  },
  {
   "start": 130.33,
   "end": 130.75,
   "text": "שומם,"
  },
  {
   "start": 131.75,
   "end": 132.55,
   "text": "שומם מהאדם."
  },
  {
   "start": 133.11,
   "end": 135.49,
   "text": "אל בית המדרש מגיחה לה"
  },
  {
   "start": 136.67,
   "end": 137.93,
   "text": "דמות מיסטורית,"
  },
  {
   "start": 140.95,
   "end": 141.31,
   "text": "והדמות"
  },
  {
   "start": 142.07,
   "end": 148.77,
   "text": "נכנסת אל בית המדרש ושמה את פעמיה אל מקום ישיבתו של ראש בית המדרש,"
  },
  {
   "start": 149.17,
   "end": 150.05,
   "text": "אל הסטנדר שלו,"
  },
  {
   "start": 151.01,
   "end": 152.03,
   "text": "אל השולחן בו הוא למד."
  },
  {
   "start": 155.74,
   "end": 157.72,
   "text": "היא מתעכבת שם לשניות ספורות,"
  },
  {
   "start": 158.42,
   "end": 158.98,
   "text": "ואחר כך"
  },
  {
   "start": 160.56,
   "end": 167.31,
   "text": "חומקת לה בחסות החשבת."
  },
  {
   "start": 167.31,
   "end": 169.83,
   "text": "למחרת בבוקר, עם התחלת השיעור,"
  },
  {
   "start": 174.23,
   "end": 176.45,
   "text": "ראש הישיבה פותח את הגמרא שלפניו,"
  },
  {
   "start": 178.9,
   "end": 179.54,
   "text": "לפני כל הלומדים,"
  },
  {
   "start": 180.92,
   "end": 182.46,
   "text": "ולפתע מתוך הגמרא נופל לו פתק,"
  },
  {
   "start": 183.58,
   "end": 184.94,
   "text": "הרב מרים וקורא,"
  },
  {
   "start": 186.48,
   "end": 190.26,
   "text": "ואז קריאת התפעלות נפלטת לה מגרונו, בפתק."
  },
  {
   "start": 191.18,
   "end": 193.8,
   "text": "בפתק הייתה רשומה התשובה לכל מה שהם לא ידעו,"
  },
  {
   "start": 194.26,
   "end": 195.48,
   "text": "לכל מה שהיה קשה להם."
  },
  {
   "start": 197.86,
   "end": 198.66,
   "text": "ראש הישיבה קם."
  },
  {
   "start": 199.26,
   "end": 200.06,
   "text": "מי כתב את הפתק?"
  },
  {
   "start": 200.82,
   "end": 201.46,
   "text": "מי כתב?"
  },
  {
   "start": 204.29,
   "end": 204.51,
   "text": "לא ענה."
  },
  {
   "start": 212.48,
   "end": 216.72,
   "text": "יומיים אחר כך, שוב, שוב שאלה,"
  },
  {
   "start": 217.74,
   "end": 220.44,
   "text": "שוב שאלה שמטרידה את הישיבה,"
  },
  {
   "start": 220.94,
   "end": 223.64,
   "text": "שוב שאלה שאיש לא יודע את התשובה."
  },
  {
   "start": 236.91,
   "end": 242.27,
   "text": "אבל איש גם לא יודע, איש לא תיאר לעצמו שראש הישיבה בכבודו ובעצמו החליט הפעם."
  },
  {
   "start": 242.95,
   "end": 248.73,
   "text": "הפעם לארוב, הפעם להמתין כל הלילה כדי לגלות מי זה?"
  },
  {
   "start": 249.17,
   "end": 249.97,
   "text": "מי זה פאבה לילה?"
  },
  {
   "start": 250.45,
   "end": 253.25,
   "text": "מי הגאון הגדול שעונה על כל השאלות?"
  },
  {
   "start": 258.22,
   "end": 262.49,
   "text": "בת לילה מאוחרת אל בית המדרש השומם"
  },
  {
   "start": 263.11,
   "end": 264.97,
   "text": "או אולי לא כל כך שומם"
  },
  {
   "start": 265.83,
   "end": 266.81,
   "text": "מתגנבת לה,"
  },
  {
   "start": 268.84,
   "end": 272.38,
   "text": "חומקת לה דמות ונכנסת בחסות החשיכה אל בית המדרש."
  },
  {
   "start": 274.22,
   "end": 276.98,
   "text": "והרב, ראש הישיבה שמסתתר בסמוך,"
  },
  {
   "start": 277.34,
   "end": 278.0,
   "text": "מנסה להתבונן,"
  },
  {
   "start": 278.38,
   "end": 280.38,
   "text": "מנסה לגלות מי זו הדמות,"
  },
  {
   "start": 281.14,
   "end": 282.14,
   "text": "מי מהתלמידים שלו,"
  },
  {
   "start": 282.48,
   "end": 283.88,
   "text": "מי מהרבנים שהוא מכיר,"
  },
  {
   "start": 284.34,
   "end": 285.46,
   "text": "הוא-הוא הגאון הגדול."
  },
  {
   "start": 287.72,
   "end": 289.6,
   "text": "ואז הדמות עוברת לה ליד,"
  },
  {
   "start": 291.86,
   "end": 300.09,
   "text": "ליד שובל של אור שמגיע מבחוץ, מבעד לחלון."
  },
  {
   "start": 303.97,
   "end": 305.13,
   "text": "ראש הישיבה נדהם."
  },
  {
   "start": 305.79,
   "end": 306.71,
   "text": "הייתה זו דמותו,"
  },
  {
   "start": 307.35,
   "end": 308.75,
   "text": "דמותו של אותו הלך,"
  },
  {
   "start": 309.09,
   "end": 313.43,
   "text": "הלך נווד שבשבועות האחרונים מצא לו מקום מנוחד בבית המדרש."
  },
  {
   "start": 314.83,
   "end": 318.27,
   "text": "אותו עובר דרכים שאיש לא שם לב אליו,"
  },
  {
   "start": 318.59,
   "end": 319.81,
   "text": "שישב שם בפינה,"
  },
  {
   "start": 320.11,
   "end": 321.23,
   "text": "בפינת בית המדרש,"
  },
  {
   "start": 321.79,
   "end": 323.93,
   "text": "ודומה היה שאינו מבין מאומה."
  },
  {
   "start": 326.0,
   "end": 327.04,
   "text": "הוא הגאון הגדול."
  },
  {
   "start": 327.76,
   "end": 331.14,
   "text": "הוא הגאון הגדול שיודע את כל התשובות הנפלאות האלה."
  },
  {
   "start": 331.88,
   "end": 335.26,
   "text": "הוא הגאון שכפי הנראה כל התורה פרוסה לפניו."
  },
  {
   "start": 342.23,
   "end": 343.29,
   "text": "למחרת בבוקר"
  },
  {
   "start": 344.63,
   "end": 345.83,
   "text": "נכנס אותו נבן"
  },
  {
   "start": 346.41,
   "end": 347.93,
   "text": "צנוע אל בית המדרש,"
  },
  {
   "start": 350.2,
   "end": 354.42,
   "text": "וכשהוא נכנס קם ראש הישיבה במקומו."
  },
  {
   "start": 355.4,
   "end": 360.58,
   "text": "מיד קמו כל תלמידי בית המדרש וכל הישיבה קמה על רגליה."
  },
  {
   "start": 360.58,
   "end": 364.38,
   "text": "והנבד מביט, בפני מי הם עומדים?"
  },
  {
   "start": 365.82,
   "end": 367.64,
   "text": "ואז ראש הישיבה פונה אליו ואומר לו,"
  },
  {
   "start": 368.28,
   "end": 369.84,
   "text": "שלום לכבוד הרב הגאון,"
  },
  {
   "start": 370.88,
   "end": 374.3,
   "text": "ידוע לי שאתה, אתה זה שעונה על התשובות,"
  },
  {
   "start": 374.92,
   "end": 375.72,
   "text": "אל תסתתר עוד."
  },
  {
   "start": 376.64,
   "end": 380.64,
   "text": "אני מבקש ממך, בשמי ובשם כל הישיבה, בשם התורה הקדושה,"
  },
  {
   "start": 380.98,
   "end": 382.3,
   "text": "בוא, בוא תלמד אותנו,"
  },
  {
   "start": 383.22,
   "end": 386.12,
   "text": "בוא תדריך אותנו, אמר הרב בהערצה."
  },
  {
   "start": 387.38,
   "end": 387.84,
   "text": "והנבד,"
  },
  {
   "start": 388.6,
   "end": 391.28,
   "text": "ענווד שהיה לא פחות ולא יותר מאשר"
  },
  {
   "start": 391.94,
   "end": 393.6,
   "text": "רבי שלמה יצחקי,"
  },
  {
   "start": 394.3,
   "end": 395.48,
   "text": "רשי הקדוש,"
  },
  {
   "start": 398.22,
   "end": 408.23,
   "text": "שהענווה שלו נתנה לו את הכוח ללכת ולנדוד בעיירות,"
  },
  {
   "start": 408.93,
   "end": 413.95,
   "text": "מסתיר את הזהות שלו מפי האורים ושבים."
  },
  {
   "start": 415.63,
   "end": 416.77,
   "text": "לרשי לא הייתה ברירה,"
  },
  {
   "start": 417.39,
   "end": 419.55,
   "text": "תורה היא, ותורה צריך ללמד."
  },
  {
   "start": 419.99,
   "end": 420.61,
   "text": "הוא ישב ולימד,"
  },
  {
   "start": 422.09,
   "end": 428.89,
   "text": "ולימד מספר שיעורים, שאותם כל חובשי בית המדרש,"
  },
  {
   "start": 429.63,
   "end": 431.93,
   "text": "כל מי שהיה שם,"
  },
  {
   "start": 434.32,
   "end": 436.24,
   "text": "לא שכחו כל ימי חייהם."
  },
  {
   "start": 440.1,
   "end": 444.72,
   "text": "זמן מה אחר כך נוטל רשי את מקל הנדודים וממשיך הלאה,"
  },
  {
   "start": 445.36,
   "end": 449.94,
   "text": "הלאה בדרכו למסע של גלות של נדודים ברחבי אירופה."
  },
  {
   "start": 450.78,
   "end": 452.1,
   "text": "אם תשאלו למה,"
  },
  {
   "start": 453.04,
   "end": 453.56,
   "text": "כי רשי,"
  },
  {
   "start": 454.18,
   "end": 456.52,
   "text": "רשי אהב כל כך את עם ישראל,"
  },
  {
   "start": 457.18,
   "end": 460.92,
   "text": "וכמו שהנביא שמואל היה מסובב בערי ישראל,"
  },
  {
   "start": 461.42,
   "end": 465.18,
   "text": "במקום שיבואו אליו היה הולך מעיר לעיר לשפוט,"
  },
  {
   "start": 465.66,
   "end": 467.24,
   "text": "לעזור, לסייע, ללמד,"
  },
  {
   "start": 467.72,
   "end": 469.9,
   "text": "ככה רשי מסתובב בכל קהילות ישראל,"
  },
  {
   "start": 471.14,
   "end": 472.62,
   "text": "עוזר, מסייע, תומך,"
  },
  {
   "start": 472.98,
   "end": 478.36,
   "text": "דואג שהפירוש שלו יגיע לכל המקומות וישפוך אור על דברי התורה הקדושים."
  },
  {
   "start": 484.23,
   "end": 484.87,
   "text": "ולא רק זאת,"
  },
  {
   "start": 485.53,
   "end": 488.07,
   "text": "הלב, הלב של רשי לא היה שלם."
  },
  {
   "start": 488.69,
   "end": 491.85,
   "text": "הוא חש כל החיים מרגשי אשמה על ש..."
  },
  {
   "start": 492.65,
   "end": 495.43,
   "text": "על שעל מנת שאבא שלו יזכה בבן,"
  },
  {
   "start": 496.05,
   "end": 496.81,
   "text": "בן כמוהו,"
  },
  {
   "start": 497.49,
   "end": 500.73,
   "text": "היה צריך לוותר על אוצר כל כך גדול כמו היהלום."
  },
  {
   "start": 502.23,
   "end": 503.47,
   "text": "אז הוא יצא לתקן."
  },
  {
   "start": 504.53,
   "end": 508.35,
   "text": "לתקן ולכפר על אולי המעצר שנגרם לאפה."
  },
  {
   "start": 512.54,
   "end": 514.86,
   "text": "על צער שנגרם עוד לפני שנולד."
  },
  {
   "start": 517.58,
   "end": 518.12,
   "text": "לרשי,"
  },
  {
   "start": 518.76,
   "end": 520.62,
   "text": "לא היה אכפת, הוא היה עושה הכל,"
  },
  {
   "start": 521.0,
   "end": 523.5,
   "text": "יעשה הכל כדי למנוע צער מיהודי."
  },
  {
   "start": 524.94,
   "end": 528.04,
   "text": "עד כמה הייתה אהבת האדם, אהבת ישראל,"
  },
  {
   "start": 529.02,
   "end": 529.96,
   "text": "בעיני רשי."
  },
  {
   "start": 531.68,
   "end": 533.46,
   "text": "קצרה היא ראיה מלפרט,"
  },
  {
   "start": 534.34,
   "end": 535.34,
   "text": "רשי הקדוש."
  },
  {
   "start": 536.02,
