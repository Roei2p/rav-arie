{
 "disc": "12יב- ליבו של רשי",
 "track": "Track03",
 "duration": 733.176,
 "segments": [
  {
   "start": 4.48,
   "end": 4.96,
   "text": "הוריו,"
  },
  {
   "start": 5.56,
   "end": 7.06,
   "text": "הוריו של שלמה הקטן,"
  },
  {
   "start": 8.02,
   "end": 9.68,
   "text": "עשו את כל שביכולתם"
  },
  {
   "start": 10.58,
   "end": 11.78,
   "text": "כדי ששלמה שלהם"
  },
  {
   "start": 12.5,
   "end": 13.22,
   "text": "ילמד תורה."
  },
  {
   "start": 15.54,
   "end": 17.44,
   "text": "כל סידור שהיה מונח בידיהם"
  },
  {
   "start": 18.1,
   "end": 22.72,
   "text": "היה מתמלא בלחות מהדמעות ששטפו,"
  },
  {
   "start": 23.52,
   "end": 26.3,
   "text": "שטפו אותו כשהם היו שופכים לפני ריבונו של עולם."
  },
  {
   "start": 26.88,
   "end": 30.58,
   "text": "תפילות ששלמה שלהם, ששלמה שלהם יהיה בן תורה."
  },
  {
   "start": 34.32,
   "end": 35.2,
   "text": "ושלמה הילד,"
  },
  {
   "start": 35.96,
   "end": 37.42,
   "text": "הוא נתן את ליבו אל הקדוש ברוך הוא."
  },
  {
   "start": 38.76,
   "end": 42.74,
   "text": "כל מה שלימדו בקדושה ובתורה היה שומר בתוכו,"
  },
  {
   "start": 43.28,
   "end": 46.06,
   "text": "כי יהלום נוצץ ועיקר ערך."
  },
  {
   "start": 47.08,
   "end": 49.04,
   "text": "לב טהור ברה לי אלוקים,"
  },
  {
   "start": 50.18,
   "end": 52.2,
   "text": "לב טהור ברה לי אלוקים,"
  },
  {
   "start": 53.62,
   "end": 54.98,
   "text": "ורוח נכון חדש בקרבי."
  },
  {
   "start": 56.38,
   "end": 58.14,
   "text": "לב טהור ברה לי אלוקים,"
  },
  {
   "start": 59.22,
   "end": 61.28,
   "text": "ורוח נכון חדש בקרבי."
  },
  {
   "start": 62.58,
   "end": 65.08,
   "text": "כך היה שלמה הקטן עושה תפילה חרישית,"
  },
  {
   "start": 66.26,
   "end": 68.04,
   "text": "והאבא הרחול שבשמיים,"
  },
  {
   "start": 68.84,
   "end": 71.9,
   "text": "הוריד שפע רוחני לילד הקדוש הזה,"
  },
  {
   "start": 72.84,
   "end": 79.1,
   "text": "בעל הלב הטהור שהאיר את העיר טרויה שבמחוז שמפניה שבצרפת."
  },
  {
   "start": 84.46,
   "end": 84.58,
   "text": "גם,"
  },
  {
   "start": 85.18,
   "end": 86.88,
   "text": "גם כשחבריו שיחקו בחוץ,"
  },
  {
   "start": 87.46,
   "end": 89.86,
   "text": "שלמה היה מדי פעם מבלי לפגוע בהם,"
  },
  {
   "start": 90.34,
   "end": 91.56,
   "text": "כדי לא לעורר קנאה,"
  },
  {
   "start": 92.02,
   "end": 96.1,
   "text": "היה חומק פנימה אל בית המדרש ומרוויח עוד דקה של תורה,"
  },
  {
   "start": 96.46,
   "end": 98.0,
   "text": "עוד דקה של יראת שמיים,"
  },
  {
   "start": 98.4,
   "end": 99.86,
   "text": "עוד דקה של קדושה,"
  },
  {
   "start": 100.44,
   "end": 102.72,
   "text": "עוד דקה של צמיחה רוחנית."
  },
  {
   "start": 104.04,
   "end": 106.2,
   "text": "לב טהור ברא לי אלוקים."
  },
  {
   "start": 107.32,
   "end": 109.44,
   "text": "לב טהור ברא לי אלוקים."
  },
  {
   "start": 109.98,
   "end": 112.08,
   "text": "ורוח נכון חדש בקרבי."
  },
  {
   "start": 113.0,
   "end": 115.32,
   "text": "ורוח נכון חדש בקרבי."
  },
  {
   "start": 116.4,
   "end": 117.48,
   "text": "היה קולו נישא."
  },
  {
   "start": 121.91,
   "end": 122.65,
   "text": "ולבו של רשי."
  },
  {
   "start": 124.95,
   "end": 126.55,
   "text": "ולבו של הילד שלמה,"
  },
  {
   "start": 127.13,
   "end": 128.75,
   "text": "שהיה פתוח כאולם,"
  },
  {
   "start": 129.33,
   "end": 132.61,
   "text": "ספג את התורה הקדושה אליו באהבה,"
  },
  {
   "start": 133.43,
   "end": 134.15,
   "text": "בשמחה."
  },
  {
   "start": 135.33,
   "end": 141.11,
   "text": "כך שעד מהרה גם העיר טרויש הייתה צרה עבורו."
  },
  {
   "start": 145.55,
   "end": 146.31,
   "text": "שלמה יקירי"
  },
  {
   "start": 148.38,
   "end": 149.9,
   "text": "אמרה לו אמו ברגש,"
  },
  {
   "start": 153.02,
   "end": 154.68,
   "text": "כל כך קשה לי להיפרד ממך."
  },
  {
   "start": 156.62,
   "end": 157.28,
   "text": "אבל אני יודעת,"
  },
  {
   "start": 158.2,
   "end": 160.02,
   "text": "אני יודעת שאתה אוצר נפלא,"
  },
  {
   "start": 160.72,
   "end": 163.02,
   "text": "שהפקיד הקדוש ברוך הוא בידיים שלי."
  },
  {
   "start": 163.5,
   "end": 167.34,
   "text": "אני יודעת שהטוב ביותר עבור הנשמה הטהורה שלך זה תורה."
  },
  {
   "start": 167.34,
   "end": 172.96,
   "text": "ותורה ותורה ותורה."
  },
  {
   "start": 174.1,
   "end": 175.7,
   "text": "אז נאמרת שאני כבר, מה אני מרגישה?"
  },
  {
   "start": 176.64,
   "end": 177.76,
   "text": "חשוב שלך יהיה טוב."
  },
  {
   "start": 178.96,
   "end": 181.62,
   "text": "חשוב שהנשמה שלך תהיה מלאה."
  },
  {
   "start": 182.9,
   "end": 183.72,
   "text": "לכן אני מסכימה."
  },
  {
   "start": 184.5,
   "end": 185.84,
   "text": "אני מסכימה לבקשה שלך."
  },
  {
   "start": 186.64,
   "end": 190.64,
   "text": "אתה מבקש ללמוד תורה בוורמייזה,"
  },
  {
   "start": 192.36,
   "end": 193.28,
   "text": "בעיר הגדולה"
  },
  {
   "start": 194.08,
   "end": 194.92,
   "text": "וורמייזה."
  },
  {
   "start": 195.78,
   "end": 196.46,
   "text": "אני מסכימה."
  },
  {
   "start": 197.34,
   "end": 201.52,
   "text": "שם באמת תוכל לגדול הרבה יותר בתורה אווירת שמיים."
  },
  {
   "start": 203.08,
   "end": 204.08,
   "text": "ואימא של רשי,"
  },
  {
   "start": 206.27,
   "end": 207.19,
   "text": "ואימא של הילד שלמה,"
  },
  {
   "start": 209.81,
   "end": 211.53,
   "text": "לא יכלה לסיים את דבריה."
  },
  {
   "start": 212.89,
   "end": 214.65,
   "text": "בכי חנוכה עלה במעלה גרונה."
  },
  {
   "start": 215.83,
   "end": 217.73,
   "text": "הילד המופלא הזה שלה."
  },
  {
   "start": 218.87,
   "end": 223.77,
   "text": "הילד המופלא שלה רוצה לגדול בתורה,"
  },
  {
   "start": 224.73,
   "end": 225.33,
   "text": "ואסור."
  },
  {
   "start": 225.99,
   "end": 227.23,
   "text": "אסור לעצור אותו."
  },
  {
   "start": 231.72,
   "end": 232.66,
   "text": "שלמה יצא לדרך."
  },
  {
   "start": 234.34,
   "end": 237.62,
   "text": "פוסע לו ברגל, כסף לא היה לנסיעה,"
  },
  {
   "start": 238.72,
   "end": 240.68,
   "text": "אוכל בקושי."
  },
  {
   "start": 242.58,
   "end": 243.84,
   "text": "המצב היה מאוד קשה בבית."
  },
  {
   "start": 245.48,
   "end": 248.12,
   "text": "אז שלמה יצא עם תיק קטן מעד חפצים,"
  },
  {
   "start": 249.5,
   "end": 250.82,
   "text": "אבל עם הרבה הרבה תפילות,"
  },
  {
   "start": 251.8,
   "end": 252.82,
   "text": "הרבה הרבה ברכות"
  },
  {
   "start": 253.8,
   "end": 256.42,
   "text": "של אבא ואימא שעטפו אותו,"
  },
  {
   "start": 256.84,
   "end": 259.46,
   "text": "שנסחו בגופו העדין הרבה כוחות רוחניים,"
  },
  {
   "start": 259.46,
   "end": 264.94,
   "text": "הרבה כוחות רוחניים להתמודד עם תלאות הדרך."
  },
  {
   "start": 269.18,
   "end": 271.22,
   "text": "וכך בדרך פרוסה אלונאר יהודי."
  },
  {
   "start": 274.33,
   "end": 275.77,
   "text": "הוא ניסע אל מחוזות אחרים,"
  },
  {
   "start": 278.14,
   "end": 279.16,
   "text": "אל אביי ורבא,"
  },
  {
   "start": 281.57,
   "end": 282.93,
   "text": "אל רב הונה ורב חיסטה,"
  },
  {
   "start": 285.58,
   "end": 287.44,
   "text": "אל בית הילל ובית שמאי,"
  },
  {
   "start": 288.32,
   "end": 289.28,
   "text": "אל התורה הקדושה."
  },
  {
   "start": 296.43,
   "end": 297.25,
   "text": "שבוע אחר כך"
  },
  {
   "start": 297.97,
   "end": 299.23,
   "text": "מוצא את עצמו שלמה"
  },
  {
   "start": 300.89,
   "end": 302.89,
   "text": "בשערי העיר ורמיזה."
  },
  {
   "start": 305.58,
   "end": 308.16,
   "text": "העיר הייתה מאותרת בתלמידי חכמים גדולים ועצומים,"
  },
  {
   "start": 308.56,
   "end": 311.7,
   "text": "ובראשם תלמידיו הגדולים של רבנו גרשום מאור הגולה."
  },
  {
   "start": 313.58,
   "end": 319.36,
   "text": "כך שכל מי שהיה מגיע לעיר היה נפתח בפניו עולם של תורה במלוא הדרו."
  },
  {
   "start": 322.41,
   "end": 323.93,
   "text": "בבית המדרש בוורמיזה,"
  },
  {
   "start": 324.67,
   "end": 326.05,
   "text": "איש לא שם לב אליו,"
  },
  {
   "start": 326.81,
   "end": 330.63,
   "text": "אל הנער החדש שישב לו בפינה נחבא,"
  },
  {
   "start": 331.35,
   "end": 333.09,
   "text": "נחבא מאחורי קיר של ספרים,"
  },
  {
   "start": 333.67,
   "end": 336.49,
   "text": "שוקע בלימוד,"
  },
  {
   "start": 337.25,
   "end": 339.83,
   "text": "מאזין בשקט אל השיעורים המתנהלים,"
  },
  {
   "start": 340.33,
   "end": 347.01,
   "text": "שומע, מבין, וחוזר, וחוזר, וחוזר על השיעור הנלמד."
  },
  {
   "start": 352.92,
   "end": 353.58,
   "text": "בעיקר,"
  },
  {
   "start": 354.38,
   "end": 359.28,
   "text": "משתדל להצניע את עצמו ככל האפשר."
  },
  {
   "start": 366.18,
   "end": 367.96,
   "text": "שלום רב, נשמע הכול."
  },
  {
   "start": 369.62,
   "end": 372.38,
   "text": "והילד שלמה מרים את העיניים לראות מי מדבר אליו."
  },
  {
   "start": 373.02,
   "end": 376.8,
   "text": "היה זה לא פחות ולא יותר ראש הישיבה בכבודו ובעצמו,"
  },
  {
   "start": 377.76,
   "end": 381.56,
   "text": "הרב הגאון רבי יעקב בר יקר."
  },
  {
   "start": 384.13,
   "end": 389.43,
   "text": "ראש הישיבה החל מתעניין בנער החדש שהצטרף לו בשקט כמעט בחשאי אל הישיבה."
  },
  {
   "start": 392.83,
   "end": 395.11,
   "text": "הוא בחן את ידיעותיו ונדהם."
  },
  {
   "start": 396.61,
   "end": 397.43,
   "text": "הוא ידע לזהות."
  },
  {
   "start": 398.23,
   "end": 400.55,
   "text": "ראש הישיבה ידע לזהות בחורים בעלי כישרונות."
  },
  {
   "start": 401.65,
   "end": 403.67,
   "text": "אבל נער מיוחד כל כך,"
  },
  {
   "start": 404.13,
   "end": 415.78,
   "text": "נער עניו כל כך ועם כושר תפיסה והבנה כל כך עצומים עדיין לא נתקל."
  },
  {
   "start": 416.18,
   "end": 419.8,
   "text": "עוד באותו יום הנער שלמה מצטרף אל סדרי הישיבה,"
  },
  {
   "start": 422.36,
   "end": 429.14,
   "text": "כשראש הישיבה רבי יעקב בר יקר ולאחוריו הגאון רבי יצחק הלוי משמשים כרבותיו."
  },
  {
   "start": 432.15,
   "end": 433.83,
   "text": "והוא הילד, הנער,"
  },
  {
   "start": 434.97,
   "end": 441.01,
   "text": "משלב רצון, עוצמה וגאונות וכך הוא גדל,"
  },
  {
   "start": 443.08,
   "end": 445.22,
   "text": "גדל בלא מעט קשיים,"
  },
  {
   "start": 446.2,
   "end": 447.18,
   "text": "רחוק מההורים,"
  },
  {
   "start": 447.64,
   "end": 450.94,
   "text": "רחוק מהבית, רחוק מהסביבה בה גדל,"
  },
  {
   "start": 451.4,
   "end": 457.6,
   "text": "חסר כל האמצעים, ללא שום אדם קרוב שידאג לצרכים שלו."
  },
  {
   "start": 460.66,
   "end": 461.08,
   "text": "אבל הוא ידע,"
  },
  {
   "start": 461.7,
   "end": 464.12,
   "text": "הוא ידע איך להתמודד עם המציאות הקשה של חייו."
  },
  {
   "start": 465.26,
   "end": 465.96,
   "text": "אתם יודעים איך?"
  },
  {
   "start": 467.12,
   "end": 467.5,
   "text": "פשוט"
  },
  {
   "start": 468.2,
   "end": 472.04,
   "text": "כל-כולו היה שקוע בעולמה של תורה."
  },
  {
   "start": 473.44,
   "end": 478.68,
   "text": "ואז כל השאר היה בבחינתו כענן חולף."
  },
  {
   "start": 486.98,
   "end": 489.98,
   "text": "את לימוד התורה הקדושה בישיבה למדו בעיקר בעל פה."
  },
  {
   "start": 494.96,
   "end": 497.38,
   "text": "אז מה ניתן לעשות היה כדי לשמר את הלימוד,"
  },
  {
   "start": 497.98,
   "end": 501.24,
   "text": "את חידושי התורה שכתבת, את הלימוד שהבנת?"
  },
  {
   "start": 502.54,
   "end": 504.32,
   "text": "היו אז כותבים קונטרסים."
  },
  {
   "start": 506.74,
   "end": 508.44,
   "text": "קונטרס הייתה חוברת חידושים,"
  },
  {
   "start": 509.2,
   "end": 511.08,
   "text": "בה היו התלמידים רושמים את הלימוד שלהם,"
  },
  {
   "start": 511.5,
   "end": 512.36,
   "text": "את החידוש שלהם."
  },
  {
   "start": 515.6,
   "end": 517.7,
   "text": "כלי הכתיבה לא היו זולים כלל ועיקר."
  },
  {
   "start": 519.48,
   "end": 520.88,
   "text": "כך שבעוד כל הבחורים,"
  },
  {
   "start": 521.34,
   "end": 523.74,
   "text": "עם הזמן היו משאירים את הקונטרס שלהם מאחור,"
  },
  {
   "start": 525.78,
   "end": 527.12,
   "text": "או שלא היו משלימים אותו."
  },
  {
   "start": 527.48,
   "end": 534.44,
   "text": "היי, ילד אחד קראו לו שלמה יצחקי שהתפלל לפני הקדוש ברוך הוא על כל דבר ודבר"
  },
  {
   "start": 535.22,
   "end": 546.08,
   "text": "גם על מכשירי הכתיבה שהקדוש ברוך הוא יספק לו מכשירי כתיבה שהם לא ייגמרו כל כך מהר שהמחק עמך כמו שצריך והעת יכתוב כמו שצריך"
  },
  {
   "start": 550.35,
   "end": 556.89,
   "text": "אצלו הקונטרס היה יקר במיוחד כל מילה שנכתבה הייתה שקולה"
  },
  {
   "start": 557.71,
   "end": 562.29,
   "text": "כל פירוש או הבנה שרשם היה עובר מספר הגהות,"
  },
  {
   "start": 564.84,
   "end": 596.16,
   "text": "כך שמבין דפי הקונטרס שלו עד מהרה החל צץ ועולה פירוש נפלא ומיוחד במינו של גאון יהודי עם לב טהור רבי שלמה יצחקי רשי הקדוש לב טהור ברא לאלוקים"
  },
  {
   "start": 598.7,
   "end": 628.24,
   "text": "רשי הקדוש ששילב רצון עוצמה וגאונות עם הרבה הרבה יראת שמיים לא הוציא את פירושו האדיר רק על סמך הגאונות שלו רק על סמך השקטנות הבלתי ללאית שהייתה לו רשי ידע את מה שאסור לנו לשכוח ללא סייעתא דשמיא ללא עזרה מהקדוש ברוך הוא אי אפשר לעשות כלום רק עם תפילות רק עם דבקות בקדוש ברוך הוא"
  },
  {
   "start": 628.64,
   "end": 632.04,
   "text": "רק אם אני מבין שהקדוש ברוך הוא איתי בכל תנועה,"
  },
  {
   "start": 632.42,
   "end": 633.36,
   "text": "בכל מילה,"
  },
  {
   "start": 633.72,
   "end": 634.82,
   "text": "בכל אות."
  },
  {
   "start": 635.46,
   "end": 639.1,
   "text": "אז זוכים לאוצרות של שפע, של ברכה,"
  },
  {
   "start": 639.72,
   "end": 641.2,
   "text": "של חוכמה."
  },
  {
   "start": 642.22,
   "end": 644.8,
   "text": "ורשי כל כולו היה לקדוש ברוך הוא."
  },
  {
   "start": 645.76,
   "end": 656.18,
   "text": "הוא אפילו צם, הוא צם ימים שלמים בתפילה שהקדוש ברוך הוא ייתן בליבו, תן בליבי את הפירוש האמיתי שלא תצא דבר תקלה מתחת ידי,"
  },
  {
   "start": 656.42,
   "end": 662.62,
   "text": "שאני אוכל להבין בדיוק מה אתה אמרת למשה רבנו שם בהר סיני."
  },
  {
   "start": 665.04,
   "end": 667.74,
   "text": "ורשי צם,"
  },
  {
   "start": 668.26,
   "end": 673.98,
   "text": "צם שש מאות ושלוש עשרה יום ללא שבתות וימים טובים."
  },
  {
   "start": 674.9,
   "end": 685.84,
   "text": "תרייג יום כנגד תרייג המצוות רשי צם כדי שהפירוש שלו יהיה פירוש על פי רוח הקודש,"
  },
  {
   "start": 686.12,
   "end": 696.45,
   "text": "על פי האמת הצרופה ושם בשמיים שם בשמיים בכל העולמות בכל היכלות ישנה קורת רוח"
  },
  {
   "start": 696.97,
   "end": 714.23,
   "text": "מאין כמותה מהגאון הצעיר שמקדיש את כל כולו לביאור התורה לכלל עם ישראל כל פמלייה של מעלה נרעדים להם כשרש״י כותב את הפירוש שלו"
  }
 ]
}