{
 "disc": "12יב- ליבו של רשי",
 "track": "Track02",
 "duration": 481.176,
 "segments": [
  {
   "start": 8.03,
   "end": 9.65,
   "text": "חודשים מספר אחר כך"
  },
  {
   "start": 12.92,
   "end": 13.82,
   "text": "בעיר ורמייזה"
  },
  {
   "start": 14.46,
   "end": 15.66,
   "text": "עוברת אישה יהודייה,"
  },
  {
   "start": 17.3,
   "end": 18.2,
   "text": "אישה בהיריון,"
  },
  {
   "start": 19.06,
   "end": 20.78,
   "text": "אשתו של רבי יצחק,"
  },
  {
   "start": 21.94,
   "end": 24.04,
   "text": "שאחרי כל כך הרבה שנים,"
  },
  {
   "start": 24.6,
   "end": 26.3,
   "text": "אחרי כל כך הרבה תפילות,"
  },
  {
   "start": 28.42,
   "end": 29.02,
   "text": "אבל עם אמונה,"
  },
  {
   "start": 29.68,
   "end": 32.04,
   "text": "אמונה חזקה בלתי ניתנת להיראור,"
  },
  {
   "start": 33.94,
   "end": 34.6,
   "text": "הם זוכים,"
  },
  {
   "start": 35.66,
   "end": 37.68,
   "text": "זוכים לפרי בטן."
  },
  {
   "start": 38.52,
   "end": 42.68,
   "text": "והיא פוסעת לה בעיר פרמייזה,"
  },
  {
   "start": 44.56,
   "end": 48.18,
   "text": "מעורהרת, נזכרת, איך בעלה בא ובישר לה,"
  },
  {
   "start": 49.02,
   "end": 52.24,
   "text": "בא ומבשר לה על אותו שליח מן שמיים,"
  },
  {
   "start": 54.51,
   "end": 56.13,
   "text": "על אליהו הנביא שבא,"
  },
  {
   "start": 57.13,
   "end": 60.37,
   "text": "בא במיוחד לספר להם שבעקבות ההקרבה שלהם"
  },
  {
   "start": 63.5,
   "end": 64.32,
   "text": "עם היהלום,"
  },
  {
   "start": 69.35,
   "end": 74.21,
   "text": "בזכות המקרה עם היהלום, בזכות השנים של האמונה הבלתי מעורערת,"
  },
  {
   "start": 77.94,
   "end": 81.58,
   "text": "הם יזכו לפרי בטן קדוש."
  },
  {
   "start": 84.23,
   "end": 87.03,
   "text": "והיא נזככת כך, והיא פוסעת לה כך,"
  },
  {
   "start": 87.85,
   "end": 88.95,
   "text": "נרגשת כולה,"
  },
  {
   "start": 90.07,
   "end": 92.47,
   "text": "שמחה כולה, שפתיה נאות,"
  },
  {
   "start": 93.53,
   "end": 97.19,
   "text": "בלי קול, בתפילה חרישית לבורא עולם,"
  },
  {
   "start": 97.63,
   "end": 98.77,
   "text": "לריבונו של עולם."
  },
  {
   "start": 101.0,
   "end": 103.64,
   "text": "היא לא בזבזה ולו דקה אחת."
  },
  {
   "start": 104.78,
   "end": 105.26,
   "text": "כל הזמן"
  },
  {
   "start": 106.44,
   "end": 108.76,
   "text": "הייתה עסוקה בתפילה, תפילה שהבן שלה,"
  },
  {
   "start": 109.28,
   "end": 110.92,
   "text": "שהבן שלה יהיה עבד השם,"
  },
  {
   "start": 111.38,
   "end": 113.1,
   "text": "שהבן שלה יהיה תלמיד חכם,"
  },
  {
   "start": 113.64,
   "end": 116.72,
   "text": "שהבן שלה יאיר את העולם."
  },
  {
   "start": 119.63,
   "end": 120.01,
   "text": "וכך"
  },
  {
   "start": 121.15,
   "end": 124.37,
   "text": "היא פוסעת ונכנסת לה חרישית"
  },
  {
   "start": 125.07,
   "end": 126.19,
   "text": "אל תוך הסמטה,"
  },
  {
   "start": 126.83,
   "end": 127.57,
   "text": "שם באיבר המעיזה."
  },
  {
   "start": 137.22,
   "end": 138.1,
   "text": "היא נכנסה לסמטה,"
  },
  {
   "start": 142.05,
   "end": 142.95,
   "text": "אחוזת מחשבות."
  },
  {
   "start": 144.37,
   "end": 145.37,
   "text": "כשהיא לא שמה לב"
  },
  {
   "start": 146.05,
   "end": 146.91,
   "text": "שמסביבה"
  },
  {
   "start": 147.89,
   "end": 150.29,
   "text": "הרחוב הסמטה מתרוקנת לה."
  },
  {
   "start": 150.69,
   "end": 151.45,
   "text": "אנשים ממהרים,"
  },
  {
   "start": 152.57,
   "end": 154.71,
   "text": "לברוח לצדדים לכל מקום שאפשר."
  },
  {
   "start": 156.45,
   "end": 157.25,
   "text": "סכנה קרבה,"
  },
  {
   "start": 159.54,
   "end": 160.3,
   "text": "והיא לא שמה לב,"
  },
  {
   "start": 161.24,
   "end": 162.32,
   "text": "היא שקועה לה במחשבות."
  },
  {
   "start": 165.26,
   "end": 166.06,
   "text": "עד שלפתע"
  },
  {
   "start": 168.86,
   "end": 170.0,
   "text": "היא חשה אולי משהו,"
  },
  {
   "start": 170.6,
   "end": 171.86,
   "text": "משהו מדגדג את עורפה,"
  },
  {
   "start": 172.38,
   "end": 174.26,
   "text": "משהו גרם לה להסתובב."
  },
  {
   "start": 177.39,
   "end": 178.45,
   "text": "וכשהיא הסתובבה,"
  },
  {
   "start": 179.29,
   "end": 186.14,
   "text": "היא נחרדה לנגד עיניה,"
  },
  {
   "start": 186.68,
   "end": 187.64,
   "text": "התגלה מחזה,"
  },
  {
   "start": 188.28,
   "end": 188.86,
   "text": "מחריד."
  },
  {
   "start": 189.88,
   "end": 193.22,
   "text": "מרכבה, מרכבה שועטת קדימה, נכנסה."
  },
  {
   "start": 193.98,
   "end": 197.48,
   "text": "אל הסמטה ממלאת את כל חלל הסמטה, אין לאן לברוח,"
  },
  {
   "start": 197.94,
   "end": 198.84,
   "text": "אין להימלט."
  },
  {
   "start": 201.29,
   "end": 204.99,
   "text": "והמרכבה ממשיכה שועטת קדימה, אין להם כוונה לעצור."
  },
  {
   "start": 205.31,
   "end": 215.37,
   "text": "לרוכבים האכזריים שם לא הייתה כוונה לעצור, לא היה אכפת להם לדרוס לרמוס את אותה אישה יהודייה בהיריון עם אוצר כזה גדול,"
  },
  {
   "start": 215.75,
   "end": 217.17,
   "text": "עם אוצר נפלא בבטן."
  },
  {
   "start": 220.02,
   "end": 220.74,
   "text": "היא נאחזה,"
  },
  {
   "start": 221.36,
   "end": 223.84,
   "text": "נצמדת לה אל הקיר, אל קיר הסמטה,"
  },
  {
   "start": 224.3,
   "end": 225.08,
   "text": "נצמדת,"
  },
  {
   "start": 225.74,
   "end": 227.7,
   "text": "זועקת שמע ישראל,"
  },
  {
   "start": 228.56,
   "end": 231.5,
   "text": "השם אלוקינו, השם אחד, כולה תפילה."
  },
  {
   "start": 232.12,
   "end": 233.58,
   "text": "כולה תפילה, מה היא תעשה?"
  },
  {
   "start": 234.84,
   "end": 235.56,
   "text": "אין סיכוי."
  },
  {
   "start": 235.88,
   "end": 239.76,
   "text": "והמרכבה מתקרבת לה, ומתקרבת ומתקרבת,"
  },
  {
   "start": 243.9,
   "end": 244.58,
   "text": "והיא נצמדת."
  },
  {
   "start": 245.02,
   "end": 251.28,
   "text": "היא נצמדת אל הקיר, נאחזת, והמרכבה מתקרבת, ומתקרבת, ומתקרבת, והיא מתפללת אל השם."
  },
  {
   "start": 251.78,
   "end": 254.72,
   "text": "ואז, לפתע הקיר, כאילו נבקר,"
  },
  {
   "start": 255.12,
   "end": 258.38,
   "text": "והיא נכנסת כולה אל הקיר, והמרכבה עוברת, היא עוברת!"
  },
  {
   "start": 259.36,
   "end": 260.6,
   "text": "חולפת בי אב,"
  },
  {
   "start": 261.14,
   "end": 264.04,
   "text": "מבלי ששרה אחת לא תיפול."
  },
  {
   "start": 265.1,
   "end": 265.42,
   "text": "הקיר,"
  },
  {
   "start": 266.38,
   "end": 269.44,
   "text": "הקיר פשוט בלה אל תוכו את האישה."
  },
  {
   "start": 273.05,
   "end": 274.03,
   "text": "את דממת המוות"
  },
  {
   "start": 276.13,
   "end": 277.43,
   "text": "שהייתה בחלל הסיוטה."
  },
  {
   "start": 280.03,
   "end": 280.75,
   "text": "קטעו קולות,"
  },
  {
   "start": 283.15,
   "end": 284.15,
   "text": "קולות של בני אדם."
  },
  {
   "start": 286.19,
   "end": 290.97,
   "text": "קולות של אנשים שהציצו מבעד לחרחי החלונות"
  },
  {
   "start": 294.82,
   "end": 298.18,
   "text": "ונדהמו, נדהמו לנס שהתרחש לנגד עיניהם"
  },
  {
   "start": 298.76,
   "end": 300.34,
   "text": "כשאותה מרכבה נכנסת"
  },
  {
   "start": 300.92,
   "end": 310.46,
   "text": "מאיימת לדרוס את אותה אישה יהודייה מופלאה והאישה נדבקת אל הקיר ולפתע נס אין הסבר אחר."
  },
  {
   "start": 311.2,
   "end": 314.02,
   "text": "הקיר פשוט נע לו וזע לו חליפות."
  },
  {
   "start": 314.86,
   "end": 320.22,
   "text": "מעין בו לאמן מקבל אל תוכו את האישה."
  },
  {
   "start": 321.02,
   "end": 321.98,
   "text": "נוצר שקע"
  },
  {
   "start": 322.68,
   "end": 325.88,
   "text": "בתוך הקיר שהאישה נכנסת אל תוכו"
  },
  {
   "start": 325.88,
   "end": 329.32,
   "text": "והמרכבה ממשיך הלאה."
  },
  {
   "start": 330.98,
   "end": 334.24,
   "text": "בורא עולם שולח יד ממרומים ומציל."
  },
  {
   "start": 337.12,
   "end": 338.76,
   "text": "מסייע לאותה אישה אומללה."
  },
  {
   "start": 340.42,
   "end": 341.9,
   "text": "מציל אותה ממוות ודאי."
  },
  {
   "start": 345.8,
   "end": 348.14,
   "text": "עשרות אנשים יוצאים לרחוב,"
  },
  {
   "start": 348.88,
   "end": 351.26,
   "text": "מתבוננים אחוזי התפעלות בשקע."
  },
  {
   "start": 351.9,
   "end": 355.26,
   "text": "בשקע שנוצר, בשקע שנשאר עדות לנס."
  },
  {
   "start": 356.92,
   "end": 358.62,
   "text": "נס היסטורי, נס נפלא."
  },
  {
   "start": 360.88,
   "end": 365.7,
   "text": "שחותם עוד חותם של אהבה בין הקדוש ברוך הוא לעם ישראל."
  },
  {
   "start": 367.28,
   "end": 368.14,
   "text": "ואת אותה אישה צדקת,"
  },
  {
   "start": 370.3,
   "end": 371.42,
   "text": "אשתו של רבי יצחק."
  },
  {
   "start": 372.72,
   "end": 373.96,
   "text": "היא ממשיכה לה בדרכה,"
  },
  {
   "start": 374.54,
   "end": 377.1,
   "text": "נושאת בקרבה תינוק קדוש,"
  },
  {
   "start": 377.62,
   "end": 381.24,
   "text": "תינוק שבעבורו כדאי לעשות הכל."
  },
  {
   "start": 383.78,
   "end": 387.18,
   "text": "כדאי אף לשנות סדרי בראשית."
  },
  {
   "start": 405.98,
   "end": 409.44,
   "text": "הנס התפרסם בכל צרפת ובכל העולם היהודי."
  },
  {
   "start": 415.21,
   "end": 416.41,
   "text": "מספר שבועות אחר כך,"
  },
  {
   "start": 417.23,
   "end": 420.43,
   "text": "בעיר טרויאש שבמחוז שמפניה שבצרפת,"
  },
  {
   "start": 421.15,
   "end": 423.53,
   "text": "בשנת 4800 לבריאת העולם,"
  },
  {
   "start": 424.21,
   "end": 426.35,
   "text": "לפני כ-965 שנה,"
  },
  {
   "start": 427.93,
   "end": 429.69,
   "text": "נולד התינוק שכל כך ציפו לו."
  },
  {
   "start": 431.9,
   "end": 436.38,
   "text": "נולד התינוק שבשבילו השתנו סדרי בראשית."
  },
  {
   "start": 438.96,
   "end": 439.6,
   "text": "קראו לו שלמה."
  },
  {
   "start": 444.04,
   "end": 444.92,
   "text": "הוא נקרא שלמה,"
  },
  {
   "start": 445.62,
   "end": 446.36,
   "text": "שלמה יצחקי."
  },
  {
   "start": 447.2,
   "end": 449.84,
   "text": "לימים רבי שלמה יצחקי,"
  },
  {
   "start": 451.1,
   "end": 452.32,
   "text": "רשי הקדוש,"
  },
  {
   "start": 453.06,
   "end": 454.88,
   "text": "שהתפרסם בכל העולם היהודי"
  },
  {
   "start": 455.72,
   "end": 459.38,
   "text": "כיהלום הנפלא שנקרא רשי הקדוש,"
  },
  {
   "start": 460.08,
   "end": 463.78,
   "text": "שהאיר לכל בית ישראל את התורה הקדושה."
  },
  {
   "start": 465.62,
   "end": 466.9,
   "text": "יהלום של ממש,"
  },
  {
   "start": 468.42,
   "end": 470.3,
   "text": "בכתר של ריבונו של עולם,"
  },
  {
   "start": 471.12,
   "end": 475.72,
   "text": "של מלך מלכי המלכים הקדוש ברוך הוא."
  }
 ]
}