{
 "disc": "12יב- ליבו של רשי",
 "track": "Track01",
 "duration": 1097.184,
 "segments": [
  {
   "start": 8.86,
   "end": 12.5,
   "text": "העיר טרויאש שבמחוז שמפניה שבצרפת."
  },
  {
   "start": 14.02,
   "end": 14.8,
   "text": "בעיר טרויאש"
  },
  {
   "start": 15.72,
   "end": 16.38,
   "text": "היו עניים,"
  },
  {
   "start": 18.2,
   "end": 20.84,
   "text": "אבל היו עניים מיוחדים."
  },
  {
   "start": 22.24,
   "end": 23.58,
   "text": "עניים שהדלות"
  },
  {
   "start": 25.32,
   "end": 29.36,
   "text": "לא העיבה על שמחת החיים שלהם, על האמונה הקדושה שלהם."
  },
  {
   "start": 35.96,
   "end": 36.54,
   "text": "רבי יצחק"
  },
  {
   "start": 37.62,
   "end": 42.36,
   "text": "ורעייתו היו מהזן הזה של העניים."
  },
  {
   "start": 45.32,
   "end": 46.44,
   "text": "הם ידעו שהאמונה"
  },
  {
   "start": 48.34,
   "end": 49.54,
   "text": "היא זו שתחזיק אותם."
  },
  {
   "start": 50.88,
   "end": 53.24,
   "text": "כל זמן כשהם קשורים לריבונו של עולם,"
  },
  {
   "start": 53.9,
   "end": 56.12,
   "text": "שום כוח שבעולם לא יכול להם."
  },
  {
   "start": 59.55,
   "end": 61.05,
   "text": "למרות שהיו להם חיים קשים."
  },
  {
   "start": 61.75,
   "end": 65.61,
   "text": "למרות שלא רק הדלות אפיינה את חייהם,"
  },
  {
   "start": 66.71,
   "end": 67.79,
   "text": "אלא השקט,"
  },
  {
   "start": 68.51,
   "end": 70.51,
   "text": "השקט שליווה את ביתם."
  },
  {
   "start": 71.55,
   "end": 76.01,
   "text": "השקט ללא, לא צווחות, ללא שמחה של ילדים."
  },
  {
   "start": 76.85,
   "end": 77.85,
   "text": "לבני הזוג,"
  },
  {
   "start": 79.03,
   "end": 80.85,
   "text": "לבני הזוג הללו לא היו ילדים."
  },
  {
   "start": 82.67,
   "end": 83.47,
   "text": "אבל הם לא נשברו."
  },
  {
   "start": 84.77,
   "end": 86.37,
   "text": "הם היו צאצאים לבית דוד."
  },
  {
   "start": 89.22,
   "end": 93.84,
   "text": "הם החזיקו כל ימי חייהם באמונה קדושה וטהורה בריבונו של עולם."
  },
  {
   "start": 99.76,
   "end": 100.68,
   "text": "ונראה שיום אחד,"
  },
  {
   "start": 101.5,
   "end": 102.0,
   "text": "סוף סוף,"
  },
  {
   "start": 102.64,
   "end": 107.4,
   "text": "באה קץ לסבל המתמשך שלהם כתוצאה מעוני."
  },
  {
   "start": 108.86,
   "end": 114.64,
   "text": "זה היה כשרבי יצחק יצא אל חוף הים,"
  },
  {
   "start": 115.0,
   "end": 116.28,
   "text": "למצוא שם אולי עבודה,"
  },
  {
   "start": 117.44,
   "end": 118.74,
   "text": "אולי איזו ספינה שהוגנת."
  },
  {
   "start": 120.52,
   "end": 120.8,
   "text": "שם,"
  },
  {
   "start": 121.86,
   "end": 125.84,
   "text": "שם הוא יוכל אולי למצוא איזו עבודה בפריקת סחורות או משהו בדומה לזה."
  },
  {
   "start": 130.78,
   "end": 131.42,
   "text": "ואז שם,"
  },
  {
   "start": 132.18,
   "end": 132.94,
   "text": "בחוף הים,"
  },
  {
   "start": 134.5,
   "end": 135.86,
   "text": "משהו משך את עינו."
  },
  {
   "start": 138.5,
   "end": 141.52,
   "text": "צרור קטן, שקית קטנה, שנפלטה מהים,"
  },
  {
   "start": 144.69,
   "end": 145.91,
   "text": "והגיע עד לרגליו."
  },
  {
   "start": 146.57,
   "end": 147.09,
   "text": "הוא הרים,"
  },
  {
   "start": 147.77,
   "end": 148.75,
   "text": "הוא הרים את אותה"
  },
  {
   "start": 149.47,
   "end": 150.75,
   "text": "מעין מתת שמיים."
  },
  {
   "start": 150.75,
   "end": 153.89,
   "text": "את אותה מתת שמיים פותח,"
  },
  {
   "start": 154.45,
   "end": 160.17,
   "text": "פותח את השקית שנפלטה לה מן הים ומוצא בתוכה לא פחות ולא יותר."
  },
  {
   "start": 161.35,
   "end": 161.95,
   "text": "יהלום,"
  },
  {
   "start": 163.15,
   "end": 163.67,
   "text": "יהלום גדול,"
  },
  {
   "start": 165.65,
   "end": 166.57,
   "text": "יהלום עצום,"
  },
  {
   "start": 167.83,
   "end": 175.91,
   "text": "יהלום שלא נראה זה הרבה שנים בצרפת כולה."
  },
  {
   "start": 179.72,
   "end": 181.98,
   "text": "והיהלום הזה נפלט היישר לרגליו,"
  },
  {
   "start": 182.88,
   "end": 183.52,
   "text": "מתנה."
  },
  {
   "start": 183.52,
   "end": 189.66,
   "text": "מתנה שהופכת למעשה את אותו רבי יצחק עני לעשיר בן רגע אחד"
  },
  {
   "start": 192.51,
   "end": 193.63,
   "text": "והוא חוזר הביתה"
  },
  {
   "start": 194.87,
   "end": 203.4,
   "text": "והשמחה פורצת לה והעיר טרויה שקולה רעשה"
  },
  {
   "start": 204.26,
   "end": 207.9,
   "text": "מדלות מעוני לאושר עצום."
  },
  {
   "start": 209.24,
   "end": 212.68,
   "text": "כל הקהילה היהודית שם שמחים בשמחתם של הזוג,"
  },
  {
   "start": 213.12,
   "end": 216.76,
   "text": "הזוג הנפלא הזה, הזוג בעל האמונה שזכה."
  },
  {
   "start": 218.16,
   "end": 225.58,
   "text": "בני הזוג שמחו שמחה שמעולה מעולה בעצב כי ילדים אין להם."
  },
  {
   "start": 232.64,
   "end": 234.5,
   "text": "בארמון הקיסר של צרפת"
  },
  {
   "start": 235.58,
   "end": 237.54,
   "text": "הייתה רבה הנאומה."
  },
  {
   "start": 238.76,
   "end": 240.14,
   "text": "הקיסר הצרפתי זועם,"
  },
  {
   "start": 240.78,
   "end": 242.8,
   "text": "הקיסר הצרפתי כועס."
  },
  {
   "start": 244.86,
   "end": 245.08,
   "text": "שנים,"
  },
  {
   "start": 245.78,
   "end": 248.12,
   "text": "שנים בונים לו פסל מלכותי."
  },
  {
   "start": 248.68,
   "end": 252.34,
   "text": "פסל שכל באי הארמון יצטרכו להשתחוות אליו."
  },
  {
   "start": 255.06,
   "end": 257.22,
   "text": "והחודש הפסל היה אמור להיות גמור."
  },
  {
   "start": 258.28,
   "end": 260.0,
   "text": "ועכשיו באים ומבשרים לקיסר,"
  },
  {
   "start": 261.14,
   "end": 263.36,
   "text": "להוד רוממותו, הקיסר הצרפתי,"
  },
  {
   "start": 265.4,
   "end": 270.58,
   "text": "שיותר מכל לא אהב לשמוע שלא מספקים את הדרישות שלו."
  },
  {
   "start": 273.18,
   "end": 275.68,
   "text": "מודיעים לו שהפסל לא יהיה גמור,"
  },
  {
   "start": 276.54,
   "end": 279.1,
   "text": "כי חסר עדיין יהלום, יהלום גדול,"
  },
  {
   "start": 279.7,
   "end": 281.96,
   "text": "גדול יותר משאפשר למצוא בכל צרפת,"
  },
  {
   "start": 282.68,
   "end": 286.4,
   "text": "שיוכל להתאים לעין הימנית של הפסל."
  },
  {
   "start": 287.6,
   "end": 289.84,
   "text": "והקיסר זועם, הוא לא רגיל,"
  },
  {
   "start": 290.44,
   "end": 295.6,
   "text": "הוא לא רגיל לא למצוא את מה שהוא רוצה, לא להשיג את מה שהוא רוצה."
  },
  {
   "start": 297.5,
   "end": 300.2,
   "text": "לא אכפת לו חיי אדם, לא אכפת לו כלום."
  },
  {
   "start": 302.7,
   "end": 303.28,
   "text": "הוא זועם"
  },
  {
   "start": 305.44,
   "end": 306.06,
   "text": "ושולח,"
  },
  {
   "start": 309.28,
   "end": 311.2,
   "text": "שולח בפקודה מפורשת שוטרים,"
  },
  {
   "start": 311.66,
   "end": 312.48,
   "text": "צבא של שוטרים,"
  },
  {
   "start": 312.86,
   "end": 315.22,
   "text": "לחפש אחרי יהלום מתאים בכל צרפת."
  },
  {
   "start": 315.52,
   "end": 318.18,
   "text": "אל תחזרו, אל תחזרו בליהלום."
  },
  {
   "start": 322.36,
   "end": 323.48,
   "text": "וכולם יוצאים רצים."
  },
  {
   "start": 336.08,
   "end": 337.3,
   "text": "הדפיקות בדלת היו רמות."
  },
  {
   "start": 337.3,
   "end": 340.76,
   "text": "דפיקות בדלת של רבי יצחק."
  },
  {
   "start": 342.12,
   "end": 343.38,
   "text": "הוא ניגש לפתוח את הדלת"
  },
  {
   "start": 344.04,
   "end": 345.32,
   "text": "והוא נהפך עיוור כולו."
  },
  {
   "start": 348.65,
   "end": 351.99,
   "text": "מולו עומדת קבוצת שוטרים מאיימת."
  },
  {
   "start": 353.29,
   "end": 353.49,
   "text": "שלום,"
  },
  {
   "start": 354.33,
   "end": 356.05,
   "text": "אנחנו נציגים של קיסר צרפת."
  },
  {
   "start": 357.57,
   "end": 359.35,
   "text": "שמענו יהודי שיש בידך יהלום,"
  },
  {
   "start": 359.97,
   "end": 360.45,
   "text": "יהלום יקר,"
  },
  {
   "start": 361.25,
   "end": 364.11,
   "text": "יהלום גדול, באנו לבשר לך שזכית."
  },
  {
   "start": 365.27,
   "end": 366.05,
   "text": "כפי הנראה זכית,"
  },
  {
   "start": 366.19,
   "end": 369.95,
   "text": "אולי אתה תהיה זה שתשלים את הפסל הגדול של המלך,"
  },
  {
   "start": 370.85,
   "end": 373.75,
   "text": "שאליו כל באי הארמון יצטרכו להשתחוות."
  },
  {
   "start": 376.11,
   "end": 376.65,
   "text": "כך הם אמרו,"
  },
  {
   "start": 377.45,
   "end": 378.27,
   "text": "והם לא שמים לב"
  },
  {
   "start": 379.99,
   "end": 381.07,
   "text": "איך בעל היהלום,"
  },
  {
   "start": 382.05,
   "end": 383.45,
   "text": "איך היהודי רבי יצחק"
  },
  {
   "start": 384.23,
   "end": 385.03,
   "text": "נהיה חיוור"
  },
  {
   "start": 385.85,
   "end": 386.55,
   "text": "וחיוור"
  },
  {
   "start": 387.15,
   "end": 387.83,
   "text": "וחיוור."
  },
  {
   "start": 389.79,
   "end": 391.27,
   "text": "המילים הדהדו ברקותיו."
  },
  {
   "start": 392.99,
   "end": 394.43,
   "text": "אני אתן יהלום, כך הוא חשב,"
  },
  {
   "start": 394.43,
   "end": 399.07,
   "text": "שישמש לפסל לעבודה זרה."
  },
  {
   "start": 401.47,
   "end": 403.95,
   "text": "זה יצער את השם, לא שייך, זה אסור."
  },
  {
   "start": 405.95,
   "end": 406.55,
   "text": "אני יהודי."
  },
  {
   "start": 408.29,
   "end": 410.35,
   "text": "כך הוא זעק מבפנים ללא קול,"
  },
  {
   "start": 412.48,
   "end": 414.74,
   "text": "בלי שהשוטרים ישימו לב."
  },
  {
   "start": 417.21,
   "end": 417.87,
   "text": "אז הוא אמר לשוטרים,"
  },
  {
   "start": 418.85,
   "end": 420.43,
   "text": "בקול הוא פנה לשוטרים ואמר להם,"
  },
  {
   "start": 421.27,
   "end": 424.63,
   "text": "תודה רבה, אבל אני מעדיף לשמור את היהלום הזה בשבילי."
  },
  {
   "start": 426.67,
   "end": 427.23,
   "text": "אבל השוטר,"
  },
  {
   "start": 428.07,
   "end": 431.03,
   "text": "זה שאני רק כמפקד השוטרים התקרב אליו."
  },
  {
   "start": 433.92,
   "end": 435.76,
   "text": "אחז בחולצתו ואמר לו,"
  },
  {
   "start": 437.14,
   "end": 438.64,
   "text": "כנראה יהודי אתה לא מבין,"
  },
  {
   "start": 439.68,
   "end": 441.12,
   "text": "יהודי יקר אתה לא מבין."
  },
  {
   "start": 444.98,
   "end": 445.56,
   "text": "זו לא הצעה."
  },
  {
   "start": 447.2,
   "end": 448.4,
   "text": "זו לא הצעה, זה איום."
  },
  {
   "start": 451.11,
   "end": 452.41,
   "text": "אם אתה לא תביא את היהלום,"
  },
  {
   "start": 453.87,
   "end": 456.59,
   "text": "הקיסר ידאג שיקחו אותו ממך."
  },
  {
   "start": 462.52,
   "end": 463.6,
   "text": "ורבי יצחק נרעד."
  },
  {
   "start": 465.72,
   "end": 466.92,
   "text": "הוא ידע שאין לו ברירה."
  },
  {
   "start": 469.83,
   "end": 471.45,
   "text": "הוא ידע שהם לא ישאירו לו ברירה."
  },
  {
   "start": 473.41,
   "end": 477.15,
   "text": "אז הוא הביט אחורה אל אשתו שעמדה שם בפינה."
  },
  {
   "start": 479.25,
   "end": 479.71,
   "text": "מביט בה,"
  },
  {
   "start": 481.67,
   "end": 487.83,
   "text": "ולרגע, לשנייה, נראה כאין מבט של הסכמה בעיניהם. כאילו הם יודעים בדיוק מה לעשות."
  },
  {
   "start": 489.13,
   "end": 490.07,
   "text": "ואז הוא הסתובב ואמר,"
  },
  {
   "start": 491.29,
   "end": 491.85,
   "text": "אני מוכן,"
  },
  {
   "start": 492.59,
   "end": 493.13,
   "text": "בוודאי,"
  },
  {
   "start": 493.83,
   "end": 496.71,
   "text": "אני מוכן בוודאי לתת את היהלום לקיסר צרפת,"
  },
  {
   "start": 497.69,
   "end": 501.19,
   "text": "אבל רק תנאי אחד יש לי, אני רוצה להביא אותו."
  },
  {
   "start": 502.45,
   "end": 503.77,
   "text": "אני רוצה להצטרף אליכם."
  },
  {
   "start": 507.68,
   "end": 508.9,
   "text": "הם לא ראו בכך שום בעיה,"
  },
  {
   "start": 510.1,
   "end": 511.44,
   "text": "והוא הצטרף אליהם."
  },
  {
   "start": 520.9,
   "end": 521.7,
   "text": "הספינה שטה לה,"
  },
  {
   "start": 522.32,
   "end": 522.86,
   "text": "בלב הים."
  },
  {
   "start": 524.24,
   "end": 526.72,
   "text": "הכיוון ארמון קיסר צרפת."
  },
  {
   "start": 527.92,
   "end": 528.66,
   "text": "הנוסעים שם"
  },
  {
   "start": 530.18,
   "end": 531.54,
   "text": "היו להם חבורה לא שגרתית,"
  },
  {
   "start": 532.2,
   "end": 533.6,
   "text": "קבוצת שוטרים גדולה,"
  },
  {
   "start": 534.72,
   "end": 535.54,
   "text": "יהודי אחד,"
  },
  {
   "start": 535.54,
   "end": 539.58,
   "text": "הדור מראה עם עיניים תמימות, עיניים בורקות."
  },
  {
   "start": 540.58,
   "end": 540.86,
   "text": "מחזיק,"
  },
  {
   "start": 541.56,
   "end": 542.18,
   "text": "מחזיק בידיו"
  },
  {
   "start": 543.0,
   "end": 543.68,
   "text": "אוצר,"
  },
  {
   "start": 544.32,
   "end": 545.24,
   "text": "אוצר נפלא."
  },
  {
   "start": 549.1,
   "end": 554.04,
   "text": "וקצת נוסעים שהצטרפו אל אותה ספינה, נוסעים כנראה ידועים,"
  },
  {
   "start": 555.12,
   "end": 557.32,
   "text": "אנשים עשירים מפורסמים בצרפת."
  },
  {
   "start": 563.41,
   "end": 570.87,
   "text": "והיהודי יושב וכולו אחוז, אחוז מחשבות מהרהר"
  },
  {
   "start": 570.87,
   "end": 574.85,
   "text": "על ההזדמנות הנפלאה שנפלה בחלקו."
  },
  {
   "start": 577.18,
   "end": 580.04,
   "text": "כך הוא חושב מצד אחד, חשבתי בהתחלה שזכיתי,"
  },
  {
   "start": 580.82,
   "end": 582.36,
   "text": "שזכיתי שנהייתי עשיר."
  },
  {
   "start": 583.22,
   "end": 585.92,
   "text": "עכשיו אני רואה שהקדוש ברוך הוא, אתה ריבונו של עולם,"
  },
  {
   "start": 586.44,
   "end": 587.24,
   "text": "מזכה אותי"
  },
  {
   "start": 587.8,
   "end": 588.88,
   "text": "הרבה יותר מכך."
  },
  {
   "start": 589.78,
   "end": 593.06,
   "text": "לא להיות עשיר, להיות עשיר במצוות,"
  },
  {
   "start": 594.0,
   "end": 595.92,
   "text": "להיות מקדש שם שמיים."
  },
  {
   "start": 596.46,
   "end": 598.02,
   "text": "תודה לך ריבונו של עולם."
  },
  {
   "start": 603.53,
   "end": 603.77,
   "text": "וכך,"
  },
  {
   "start": 604.73,
   "end": 607.41,
   "text": "לפתע נחוש בהחלטתו הוא קם."
  },
  {
   "start": 608.99,
   "end": 610.53,
   "text": "ניגש אל אחד הנוסעים שעמד שם"
  },
  {
   "start": 611.37,
   "end": 614.87,
   "text": "על הסיפון ואמר לו, אתה יודע מה יש לי ביד?"
  },
  {
   "start": 615.69,
   "end": 618.21,
   "text": "יש לי ביד את היהלום הגדול ביותר בצרפת,"
  },
  {
   "start": 619.17,
   "end": 622.51,
   "text": "שאני הולך להעניק אותו מתנה לקיסר צרפת."
  },
  {
   "start": 623.81,
   "end": 624.37,
   "text": "והנוסע,"
  },
  {
   "start": 625.71,
   "end": 626.51,
   "text": "הנוסע הגוי,"
  },
  {
   "start": 627.49,
   "end": 629.09,
   "text": "התעניין, השתכרן."
  },
  {
   "start": 630.15,
   "end": 630.77,
   "text": "אולי תראה לי,"
  },
  {
   "start": 631.59,
   "end": 632.87,
   "text": "תראה לי פעם את היהלום הזה."
  },
  {
   "start": 633.77,
   "end": 634.49,
   "text": "תראה לי את היהלום."
  },
  {
   "start": 635.83,
   "end": 637.29,
   "text": "והיהודי אומר לו, תראה, אני לא יודע אם"
  },
  {
   "start": 637.95,
   "end": 640.73,
   "text": "כדאי לי להראות, אני חושש שיקרה לו משהו."
  },
  {
   "start": 641.13,
   "end": 641.69,
   "text": "מה אתה דואג?"
  },
  {
   "start": 642.77,
   "end": 644.09,
   "text": "במקרה אני יהלומן,"
  },
  {
   "start": 645.21,
   "end": 648.57,
   "text": "במקרה אני יהלומן, אני יודע, אני איש מקצועתנו לראות את היהלום."
  },
  {
   "start": 649.45,
   "end": 651.19,
   "text": "אני מאוד רוצה לדעת, מאוד רוצה"
  },
  {
   "start": 652.03,
   "end": 657.85,
   "text": "לראות את היהלום הנפלא הזה שכל כך דיברת עליו."
  },
  {
   "start": 658.79,
   "end": 660.19,
   "text": "ורבי יצחק בידיים רועדות,"
  },
  {
   "start": 661.07,
   "end": 662.17,
   "text": "פותח את הצרור ומגלה,"
  },
  {
   "start": 664.13,
   "end": 669.97,
   "text": "את היהלום היפה ביותר, הגדול ביותר, שאותו יהלומן ראה מימיו."
  },
  {
   "start": 672.59,
   "end": 673.35,
   "text": "ויהלומן,"
  },
  {
   "start": 673.97,
   "end": 680.21,
   "text": "ויהלומן איש היהלומים הצרפתי פער את פיו בתדהמה אחוז התרגשות."
  },
  {
   "start": 682.15,
   "end": 683.29,
   "text": "הוא נגע קצת ביהלום,"
  },
  {
   "start": 683.91,
   "end": 688.41,
   "text": "פשוט לראות כאילו הוא רוצה לבדוק שהוא מציאותי, שהוא אמיתי."
  },
  {
   "start": 691.01,
   "end": 694.15,
   "text": "איש לא ידע להסביר אחר כך"
  },
  {
   "start": 694.71,
   "end": 695.51,
   "text": "איך זה קרה?"
  },
  {
   "start": 696.45,
   "end": 697.03,
   "text": "איש לא הבין."
  },
  {
   "start": 697.89,
   "end": 698.61,
   "text": "אבל משהו קרה."
  },
  {
   "start": 700.88,
   "end": 704.04,
   "text": "מה שקרה בזמן שהם התבוננו ביהלום."
  },
  {
   "start": 705.42,
   "end": 708.62,
   "text": "בזמן שאותו יהלומן צרפתי הביט ביהלום מוקסם,"
  },
  {
   "start": 709.32,
   "end": 711.22,
   "text": "כשהיהלום התנוצץ לו לאור השמש."
  },
  {
   "start": 712.3,
   "end": 712.92,
   "text": "משהו קרה."
  },
  {
   "start": 713.7,
   "end": 714.12,
   "text": "תנועה."
  },
  {
   "start": 714.86,
   "end": 715.6,
   "text": "משהו לא מובן."
  },
  {
   "start": 716.24,
   "end": 716.86,
   "text": "ואז"
  },
  {
   "start": 722.06,
   "end": 723.02,
   "text": "היהלום נפל."
  },
  {
   "start": 723.76,
   "end": 724.96,
   "text": "היום נפל אל תוך המים."
  },
  {
   "start": 725.66,
   "end": 726.26,
   "text": "נבלע לו."
  },
  {
   "start": 727.1,
   "end": 727.7,
   "text": "לנצח."
  },
  {
   "start": 732.34,
   "end": 733.2,
   "text": "השוטרים ירו."
  },
  {
   "start": 734.34,
   "end": 735.24,
   "text": "אבל כבר היה מאוחר."
  },
  {
   "start": 736.12,
   "end": 737.02,
   "text": "לכולם היה מאוחר."
  },
  {
   "start": 737.56,
   "end": 740.08,
   "text": "כולם מביטים ביהודי האומלל שאיבד,"
  },
  {
   "start": 740.72,
   "end": 743.0,
   "text": "שאיבד את ההון העצום שהוא מצא,"
  },
  {
   "start": 743.46,
   "end": 746.1,
   "text": "את ההון העצום, את העושר האגדי שהיה לו,"
  },
  {
   "start": 746.62,
   "end": 747.54,
   "text": "איבד באחת."
  },
  {
   "start": 749.2,
   "end": 749.6,
   "text": "ויהודי"
  },
  {
   "start": 750.58,
   "end": 751.92,
   "text": "תפס את ראשו ובשקט"
  },
  {
   "start": 752.44,
   "end": 754.02,
   "text": "חזר לפינתו, מתמודד,"
  },
  {
   "start": 754.54,
   "end": 756.86,
   "text": "מתמודד עם הכאב, הכאב הפנימי,"
  },
  {
   "start": 758.2,
   "end": 759.96,
   "text": "כשכולם מסביב לא מאמינים."
  },
  {
   "start": 760.92,
   "end": 761.94,
   "text": "ההמולה הייתה גדולה."
  },
  {
   "start": 764.36,
   "end": 765.44,
   "text": "ההמולה הייתה גדולה,"
  },
  {
   "start": 766.02,
   "end": 767.92,
   "text": "אבל כבר אי אפשר היה לעשות כלום."
  },
  {
   "start": 768.44,
   "end": 770.04,
   "text": "אי אפשר היה להציל דבר."
  },
  {
   "start": 770.66,
   "end": 776.94,
   "text": "אין אותה רק ללוות במבט, במבט מרחם על רבי יצחק שהצטנף לו בפינתו."
  },
  {
   "start": 781.5,
   "end": 782.6,
   "text": "הם פחדו לנחם אותו."
  },
  {
   "start": 783.06,
   "end": 784.16,
   "text": "הם לא ידעו מה להגיד לו."
  },
  {
   "start": 786.2,
   "end": 786.68,
   "text": "הם לא ידעו,"
  },
  {
   "start": 789.44,
   "end": 793.14,
   "text": "הם לא ידעו שלא היה צריך הרבה לנחם אותו."
  },
  {
   "start": 794.78,
   "end": 795.44,
   "text": "כי רבי יצחק,"
  },
  {
   "start": 797.48,
   "end": 797.86,
   "text": "שם"
  },
  {
   "start": 799.42,
   "end": 800.18,
   "text": "בתוך פינתו"
  },
  {
   "start": 800.88,
   "end": 802.16,
   "text": "בפינה בה הצטנף לו."
  },
  {
   "start": 803.94,
   "end": 804.92,
   "text": "כלפי חוץ נראה"
  },
  {
   "start": 805.94,
   "end": 806.48,
   "text": "עצוב מאוד,"
  },
  {
   "start": 807.02,
   "end": 808.18,
   "text": "אבל בפנים הוא היה שמח."
  },
  {
   "start": 809.2,
   "end": 811.42,
   "text": "שמח מאוד על כך"
  },
  {
   "start": 812.16,
   "end": 814.98,
   "text": "שהוא העדיף להשליך את היהלום היקר,"
  },
  {
   "start": 815.7,
   "end": 817.5,
   "text": "את היהלום שניתן לו,"
  },
  {
   "start": 818.24,
   "end": 819.72,
   "text": "את היהלום שהוא מצא,"
  },
  {
   "start": 820.48,
   "end": 822.92,
   "text": "את פסגת העושר בעולם הזה."
  },
  {
   "start": 823.38,
   "end": 831.53,
   "text": "הוא העדיף להשליך אותה לים ולא לצער את ריבונו של עולם,"
  },
  {
   "start": 831.53,
   "end": 836.55,
   "text": "ולא שתשמש כחלק מהעבודה זרה."
  },
  {
   "start": 846.47,
   "end": 849.93,
   "text": "אם מישהו יבחין בדמעות שנקבו בעיניו,"
  },
  {
   "start": 851.13,
   "end": 852.83,
   "text": "אם היה מתבונן יותר טוב,"
  },
  {
   "start": 855.03,
   "end": 856.41,
   "text": "אם היה מתבונן טוב,"
  },
  {
   "start": 857.27,
   "end": 859.51,
   "text": "היה מבחין שאלו יהיו דמעות של אושר,"
  },
  {
   "start": 861.25,
   "end": 862.39,
   "text": "דמעות של גיל,"
  },
  {
   "start": 863.47,
   "end": 864.71,
   "text": "של אושר פנימי,"
  },
  {
   "start": 865.77,
   "end": 866.37,
   "text": "של אמונה."
  },
  {
   "start": 875.63,
   "end": 876.99,
   "text": "הדרך הזרה לטרויש."
  },
  {
   "start": 876.99,
   "end": 883.39,
   "text": "רבי יצחק עושה את כל הדרך חזרה אל הבית שלו,"
  },
  {
   "start": 883.97,
   "end": 884.91,
   "text": "אל הצריף שלו,"
  },
  {
   "start": 886.33,
   "end": 886.81,
   "text": "חוזר"
  },
  {
   "start": 888.13,
   "end": 889.29,
   "text": "כלעומת שבה."
  },
  {
   "start": 897.55,
   "end": 900.49,
   "text": "בדרך הוא נעצר לנוח מעמה לדרך."
  },
  {
   "start": 901.95,
   "end": 903.73,
   "text": "לא היה לו כסף לשכור עגלה."
  },
  {
   "start": 905.07,
   "end": 906.89,
   "text": "הרי הוא חזר להיות עני כמקודם."
  },
  {
   "start": 909.8,
   "end": 911.6,
   "text": "אז הדרך כל כך הייתה מעייפת."
  },
  {
   "start": 912.12,
   "end": 912.66,
   "text": "הונח לו."
  },
  {
   "start": 913.58,
   "end": 914.1,
   "text": "הונח לו,"
  },
  {
   "start": 916.81,
   "end": 918.91,
   "text": "אבל משהו גרם לו לפתע להרים את ראשו."
  },
  {
   "start": 920.19,
   "end": 922.17,
   "text": "והוא ראה דמות של יהודי,"
  },
  {
   "start": 924.11,
   "end": 925.53,
   "text": "דמות הדורת מראה"
  },
  {
   "start": 926.29,
   "end": 927.27,
   "text": "ניצבת אל מולו,"
  },
  {
   "start": 931.85,
   "end": 932.63,
   "text": "ובאה על הדמות,"
  },
  {
   "start": 933.81,
   "end": 935.21,
   "text": "אותו יהודי בעל צורה,"
  },
  {
   "start": 936.85,
   "end": 938.69,
   "text": "עם עיניים כל כך מיוחדות,"
  },
  {
   "start": 939.63,
   "end": 942.87,
   "text": "עם עיניים כל כך מלטפות, כל כך אוהבות."
  },
  {
   "start": 945.21,
   "end": 947.67,
   "text": "אמר לו רבי יצחק היקר,"
  },
  {
   "start": 948.67,
   "end": 952.79,
   "text": "רבי יצחק היקר תדע לך בשמיים כל פמליה של מעלה"
  },
  {
   "start": 953.11,
   "end": 956.35,
   "text": "נרעשה לנוכח מעשה ההקרבה שלך"
  },
  {
   "start": 956.91,
   "end": 960.01,
   "text": "שלקחת את כל הכסף למעשה"
  },
  {
   "start": 961.63,
   "end": 963.27,
   "text": "את הנכס הנפלא הזה"
  },
  {
   "start": 964.71,
   "end": 971.81,
   "text": "לקחת את הנכס הנפלא שקיבלת את הנכס הנפלא שמצאת והעדפת להשליך אותו אל הים"
  },
  {
   "start": 972.99,
   "end": 976.51,
   "text": "לאבד את הכל את כל העולם הזה"
  },
  {
   "start": 978.57,
   "end": 984.03,
   "text": "ולא לקחת חלק ולו חלק מזערי קטן בעבודה זרה,"
  },
  {
   "start": 984.55,
   "end": 986.01,
   "text": "במשהו שמצייר את השם."
  },
  {
   "start": 988.14,
   "end": 988.76,
   "text": "תדע לך,"
  },
  {
   "start": 989.76,
   "end": 992.14,
   "text": "כך הוחלט בשמיים."
  },
  {
   "start": 993.66,
   "end": 994.34,
   "text": "אתה תזכה."
  },
  {
   "start": 996.67,
   "end": 998.13,
   "text": "אתה ויתרת על יהלום."
  },
  {
   "start": 1000.11,
   "end": 1001.71,
   "text": "לכבודו של השם יתברך,"
  },
  {
   "start": 1003.09,
   "end": 1005.21,
   "text": "בו העולם יזכה אותך ביהלום."
  },
  {
   "start": 1007.59,
   "end": 1009.11,
   "text": "יהלום כל כך יקר,"
  },
  {
   "start": 1010.09,
   "end": 1014.13,
   "text": "שיאיר לכל עם ישראל את התורה הקדושה."
  },
  {
   "start": 1020.9,
   "end": 1021.66,
   "text": "ויש לי בקשה."
  },
  {
   "start": 1026.93,
   "end": 1030.79,
   "text": "בו העולם מזכה אותך ליהלום, לילד,"
  },
  {
   "start": 1031.29,
   "end": 1035.61,
   "text": "לילד יהודי. תזכו לילד אתה ורעייתך שמחכים כל כך הרבה שנים."
  },
  {
   "start": 1035.99,
   "end": 1042.17,
   "text": "ילד קדוש, ילד נפלא, ילד טהור, ילד שאיר את כל העולם."
  },
  {
   "start": 1043.49,
   "end": 1044.83,
   "text": "יהלום של ממש."
  },
  {
   "start": 1045.45,
   "end": 1048.23,
   "text": "רק יש לי בקשה קטנה בברית שלו."
  },
  {
   "start": 1049.41,
   "end": 1050.57,
   "text": "אל תתחיל עד שאני אגיע,"
  },
  {
   "start": 1051.89,
   "end": 1053.07,
   "text": "אני רוצה להיות הסנדק."
  },
  {
   "start": 1056.92,
   "end": 1058.3,
   "text": "ואותו אדם,"
  },
  {
   "start": 1059.54,
