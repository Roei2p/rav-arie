 "segments": [
  {
   "start": 6.54,
   "end": 6.92,
   "text": "כט,"
  },
  {
   "start": 8.92,
   "end": 9.64,
   "text": "כט תמוז,"
  },
  {
   "start": 10.92,
   "end": 11.14,
   "text": "שנת"
  },
  {
   "start": 12.9,
   "end": 16.1,
   "text": "4,865 לבריאת העולם."
  },
  {
   "start": 17.26,
   "end": 18.48,
   "text": "לפני כ-900 שנה"
  },
  {
   "start": 19.7,
   "end": 21.08,
   "text": "חשך לו העולם."
  },
  {
   "start": 22.82,
   "end": 23.06,
   "text": "רשי,"
  },
  {
   "start": 24.0,
   "end": 28.22,
   "text": "רשי בגיל 65 ממשיך בכוחות אחרונים"
  },
  {
   "start": 28.96,
   "end": 30.36,
   "text": "את פירושו על הגמרא."
  },
  {
   "start": 31.68,
   "end": 33.28,
   "text": "הוא אוחז במסכת מכות."
  },
  {
   "start": 34.7,
   "end": 35.24,
   "text": "הוא חש,"
  },
  {
   "start": 36.02,
   "end": 37.4,
   "text": "חש שזמנו אוזל,"
  },
  {
   "start": 38.22,
   "end": 40.26,
   "text": "אז הוא מנסה להספיק כמה שיותר,"
  },
  {
   "start": 42.12,
   "end": 42.94,
   "text": "כמה שאפשר."
  },
  {
   "start": 45.63,
   "end": 45.89,
   "text": "כך,"
  },
  {
   "start": 46.59,
   "end": 47.09,
   "text": "כך הוא ממשיך,"
  },
  {
   "start": 48.65,
   "end": 51.13,
   "text": "במסירות נפש, בכוחות אחרונים."
  },
  {
   "start": 52.09,
   "end": 53.61,
   "text": "עוד עמוד, עוד דף,"
  },
  {
   "start": 54.83,
   "end": 55.69,
   "text": "עד דף יט,"
  },
  {
   "start": 57.09,
   "end": 57.61,
   "text": "בדיוק"
  },
  {
   "start": 58.21,
   "end": 59.63,
   "text": "במילה טהור."
  },
  {
   "start": 61.03,
   "end": 68.15,
   "text": "בדיוק במילה טהור יוצאת נשמתו הטהורה של"
  },
  {
   "start": 68.15,
   "end": 76.13,
   "text": "בעל הלב הטהור רבי שלמה יצחקי רש״י הקדוש והטהור אל מקומה"
  },
  {
   "start": 76.65,
   "end": 86.39,
   "text": "יוצאת נשמתו הטהורה של בעל הלב הטהור אל מקומה בגין זמר הומי ואז לפתע נשמעת לה בת קול"
  },
  {
   "start": 87.31,
   "end": 95.83,
   "text": "עתידין עתידין כל ישראל להיות בניך כולם ילמדו את פירושך הנפלא"
  },
  {
   "start": 95.83,
   "end": 122.88,
   "text": "את מסכת החיים שטווית וכתבת בעת ברזל בציפורן שווה ואת פניו שם בעולם הבא מקבל לא פחות ולא יותר מאשר משה רבנו משה רבנו עליו השלום שמאיר ואומר כלפיו רשי בני"
  },
  {
   "start": 123.72,
   "end": 127.56,
   "text": "הוי בני, כפי שבארת את התורה הקדושה,"
  },
  {
   "start": 128.46,
   "end": 129.76,
   "text": "כך קיבלתי,"
  },
  {
   "start": 130.26,
   "end": 133.88,
   "text": "כך קיבלתי מפי הגבורה בהר סיני,"
  },
  {
   "start": 134.56,
   "end": 139.96,
   "text": "בהר חורב, אשריך רשי, אשריך בני."
  },
  {
   "start": 142.2,
   "end": 153.12,
   "text": "כך מסתיימת לה מסכת חיים מופלאה שמשאירה את החותם הקדוש שלה בלב כל יהודי ויהודי מעם ישראל."
  },
  {
   "start": 153.12,
   "end": 158.31,
   "text": "כך סוללו רשי דרך מופלאה מראה לכולנו עד היכן יכולה להגיע נשמת נשמתו המופלאה של יהודי אשריך רשי שגופך טהור ליבך טהור יצתה נשמתך בטהור"
  }
 ]
}