{
 "disc": "12יב- ליבו של רשי",
 "track": "Track05",
 "duration": 536.16,
 "segments": [
  {
   "start": 10.25,
   "end": 12.09,
   "text": "לרשי, לרשי היו בנות."
  },
  {
   "start": 13.99,
   "end": 14.71,
   "text": "הבת שלו הגדולה,"
  },
  {
   "start": 15.45,
   "end": 17.23,
   "text": "מרים, הייתה חכמה מאוד."
  },
  {
   "start": 18.35,
   "end": 19.69,
   "text": "בעלת ידע נרחב,"
  },
  {
   "start": 20.97,
   "end": 24.33,
   "text": "עד לכך שקצת אולי הידע הזה היווה בעיה,"
  },
  {
   "start": 25.03,
   "end": 26.81,
   "text": "כי כשהיא רצתה הגיע הזמן להתחתן,"
  },
  {
   "start": 28.09,
   "end": 29.63,
   "text": "כל מי שהוצע בפניה נדחה."
  },
  {
   "start": 30.75,
   "end": 31.37,
   "text": "את זה היא לא רוצה."
  },
  {
   "start": 31.95,
   "end": 33.89,
   "text": "זה לא מספיק חכם, זה לא מספיק מבין."
  },
  {
   "start": 35.31,
   "end": 37.87,
   "text": "ואשתו של רשי הייתה אובדת עצות."
  },
  {
   "start": 38.57,
   "end": 40.79,
   "text": "ורשי כבר לא ידע מה לעשות."
  },
  {
   "start": 41.93,
   "end": 42.67,
   "text": "ואז יום אחד"
  },
  {
   "start": 43.61,
   "end": 45.55,
   "text": "קרא רשי לבתו מרים ואמר לה,"
  },
  {
   "start": 46.51,
   "end": 47.05,
   "text": "תראי ביתי,"
  },
  {
   "start": 47.67,
   "end": 48.87,
   "text": "המתנו כל כך הרבה,"
  },
  {
   "start": 49.55,
   "end": 52.07,
   "text": "כל כך הרבה זמן שתיאותי להינשא למישהו,"
  },
  {
   "start": 54.88,
   "end": 56.02,
   "text": "למישהו כלבבך,"
  },
  {
   "start": 56.84,
   "end": 57.54,
   "text": "ואין."
  },
  {
   "start": 59.04,
   "end": 62.36,
   "text": "וכל אדם הדוחה, כמה תלמידי חכמים הבאנו,"
  },
  {
   "start": 63.14,
   "end": 65.58,
   "text": "כמה אנשים בני עלייה,"
  },
  {
   "start": 65.58,
   "end": 70.08,
   "text": "ושום דבר, שום אחד לא מתאים,"
  },
  {
   "start": 71.34,
   "end": 71.8,
   "text": "היא לכך."
  },
  {
   "start": 73.54,
   "end": 74.4,
   "text": "אני כאבא שלך"
  },
  {
   "start": 74.96,
   "end": 76.04,
   "text": "מחליט ואומר,"
  },
  {
   "start": 76.68,
   "end": 79.54,
   "text": "האדם הראשון שייכנס אל הבית הזה,"
  },
  {
   "start": 80.72,
   "end": 81.58,
   "text": "הוא יהיה החתן שלך."
  },
  {
   "start": 83.44,
   "end": 84.2,
   "text": "הוא יהיה החתן שלך,"
  },
  {
   "start": 84.8,
   "end": 87.08,
   "text": "האדם הראשון שייכנס דרך הדלת הזאת."
  },
  {
   "start": 88.44,
   "end": 90.12,
   "text": "והבת נרים כמעט ונתעלפה."
  },
  {
   "start": 91.42,
   "end": 91.72,
   "text": "אבל אז,"
  },
  {
   "start": 92.88,
   "end": 95.02,
   "text": "יד תופסת את כתפה,"
  },
  {
   "start": 97.68,
   "end": 97.88,
   "text": "אמא,"
  },
  {
   "start": 98.6,
   "end": 99.82,
   "text": "אמא אומרת למרים,"
  },
  {
   "start": 100.44,
   "end": 102.66,
   "text": "אם אבא אמר זה רצון השם,"
  },
  {
   "start": 103.4,
   "end": 107.88,
   "text": "מצדיק וקדוש כמו אבא לא תצא תקלה."
  },
  {
   "start": 111.35,
   "end": 111.77,
   "text": "מי יודע,"
  },
  {
   "start": 112.57,
   "end": 120.31,
   "text": "מי יודע מי האדם שייכנס ראשון כבר מחר לביתו של רשי."
  },
  {
   "start": 122.95,
   "end": 124.27,
   "text": "הבת מרים חששה מאוד."
  },
  {
   "start": 130.31,
   "end": 130.75,
   "text": "כל הבית"
  },
  {
   "start": 131.89,
   "end": 132.95,
   "text": "היה במתח."
  },
  {
   "start": 136.87,
   "end": 137.79,
   "text": "למחרת בבוקר,"
  },
  {
   "start": 139.53,
   "end": 140.13,
   "text": "דפיקות בדלת."
  },
  {
   "start": 140.33,
   "end": 142.03,
   "text": "האימא,"
  },
  {
   "start": 143.19,
   "end": 144.03,
   "text": "אשתו של רשי,"
  },
  {
   "start": 144.93,
   "end": 145.45,
   "text": "ניגשת"
  },
  {
   "start": 146.19,
   "end": 147.03,
   "text": "אל הדלת"
  },
  {
   "start": 149.26,
   "end": 152.94,
   "text": "כי מרים, הבת קפאה על מקומה בפחד איום."
  },
  {
   "start": 155.1,
   "end": 157.64,
   "text": "והאימא ניגשת לפתוח את הדלת"
  },
  {
   "start": 158.3,
   "end": 159.32,
   "text": "בחשש עצום."
  },
  {
   "start": 160.44,
   "end": 161.56,
   "text": "היא פותחת את הדלת"
  },
  {
   "start": 163.65,
   "end": 165.31,
   "text": "ואז היא מחבירה כולה."
  },
  {
   "start": 167.11,
   "end": 169.61,
   "text": "שם בפתח עמד לו הלך,"
  },
  {
   "start": 170.23,
   "end": 170.69,
   "text": "עני,"
  },
  {
   "start": 171.39,
   "end": 172.43,
   "text": "חסר קול."
  },
  {
   "start": 176.12,
   "end": 178.58,
   "text": "רשי הקדוש קם ממקום תורתו."
  },
  {
   "start": 180.12,
   "end": 186.46,
   "text": "מהמקום בו הוא למד את התורה הקדושה הוא מקבל את ההלך ומדבר עמו בדברי תורה."
  },
  {
   "start": 195.84,
   "end": 196.12,
   "text": "רשי"
  },
  {
   "start": 197.5,
   "end": 199.14,
   "text": "מדבר עם ההלך דברי תורה,"
  },
  {
   "start": 200.5,
   "end": 201.22,
   "text": "וההלך"
  },
  {
   "start": 202.18,
   "end": 206.46,
   "text": "המוזר מתגלה כעם הארץ מוחלט."
  },
  {
   "start": 207.36,
   "end": 208.16,
   "text": "הוא פשוט שותק"
  },
  {
   "start": 208.86,
   "end": 210.04,
   "text": "פנים חסרות טבעה."
  },
  {
   "start": 210.96,
   "end": 214.8,
   "text": "אינו מבין על מה מדובר ומי מדבר עמו."
  },
  {
   "start": 217.38,
   "end": 218.2,
   "text": "אבל רשי לא התייאש,"
  },
  {
   "start": 219.06,
   "end": 219.96,
   "text": "הוא ניסה ללמד,"
  },
  {
   "start": 220.76,
   "end": 221.64,
   "text": "ללמד את ההלך הזה,"
  },
  {
   "start": 222.24,
   "end": 223.4,
   "text": "ללמד את העני הזה,"
  },
  {
   "start": 224.32,
   "end": 224.74,
   "text": "אבל ללא הצלחה."
  },
  {
   "start": 227.59,
   "end": 228.01,
   "text": "בלילות"
  },
  {
   "start": 229.55,
   "end": 232.17,
   "text": "מחדר הבנות נשמעות התייפכויות בכי"
  },
  {
   "start": 234.17,
   "end": 234.77,
   "text": "של מרים."
  },
  {
   "start": 238.55,
   "end": 240.21,
   "text": "כל כך קשה היה לנחם אותה."
  },
  {
   "start": 241.17,
   "end": 242.31,
   "text": "כל הבית היה כמרקחה,"
  },
  {
   "start": 243.55,
   "end": 244.65,
   "text": "חוץ מאדם אחד,"
  },
  {
   "start": 245.37,
   "end": 246.83,
   "text": "חוץ מסמל של אמונה."
  },
  {
   "start": 248.27,
   "end": 248.49,
   "text": "רשי,"
  },
  {
   "start": 249.47,
   "end": 250.61,
   "text": "הוא היה רגוע ושליו,"
  },
  {
   "start": 256.19,
   "end": 257.47,
   "text": "וכך הימים חולפים."
  },
  {
   "start": 258.95,
   "end": 260.73,
   "text": "והצער והמתח גואים,"
  },
  {
   "start": 261.63,
   "end": 262.95,
   "text": "מועד החתונה קרב,"
  },
  {
   "start": 265.16,
   "end": 266.18,
   "text": "ההלך הנווד,"
  },
  {
   "start": 268.83,
   "end": 270.25,
   "text": "אינו מראה סימני הבנה,"
  },
  {
   "start": 271.47,
   "end": 273.93,
   "text": "והקלה אינה מראה סימני התאוששות."
  },
  {
   "start": 276.11,
   "end": 276.61,
   "text": "ורשי?"
  },
  {
   "start": 277.55,
   "end": 279.49,
   "text": "רשי הוא שקוע בעולמה של תורה,"
  },
  {
   "start": 280.27,
   "end": 283.97,
   "text": "מקרין סביבו אור של ביטחון, של שלווה,"
  },
  {
   "start": 285.49,
   "end": 286.29,
   "text": "של אמונה."
  },
  {
   "start": 291.41,
   "end": 291.89,
   "text": "זה היה,"
  },
  {
   "start": 292.75,
   "end": 293.71,
   "text": "זה היה ביום אביבי,"
  },
  {
   "start": 294.77,
   "end": 297.31,
   "text": "כשרשי אחרי לילה של מאמץ כביר,"
  },
  {
   "start": 297.63,
   "end": 301.73,
   "text": "בניסיון לפתור בעיה סמוכה שהוא לא מצא לה פתרון כל הלילה,"
  },
  {
   "start": 302.51,
   "end": 305.87,
   "text": "וגם במשך היום הוא המשיך והתייגע והתייגע ולא מצא."
  },
  {
   "start": 307.79,
   "end": 309.61,
   "text": "אז כשזמן המנחה סוף סוף הגיע,"
  },
  {
   "start": 310.31,
   "end": 311.91,
   "text": "קם רשי, התמתח,"
  },
  {
   "start": 312.89,
   "end": 314.43,
   "text": "וניגש לו אל בית הכנסת להתפלל."
  },
  {
   "start": 316.09,
   "end": 318.69,
   "text": "כשחזר לביתו, אל הקונטרסט שלפניו,"
  },
  {
   "start": 320.37,
   "end": 320.97,
   "text": "והנה הוא רואה"
  },
  {
   "start": 321.71,
   "end": 322.45,
   "text": "בכתב יד חדש,"
  },
  {
   "start": 323.81,
   "end": 324.83,
   "text": "כתב יד לא שלו,"
  },
  {
   "start": 325.53,
   "end": 327.23,
   "text": "את התשובה המדויקת,"
  },
  {
   "start": 328.87,
   "end": 333.31,
   "text": "הנכונה, ברורה ונפלאה לאותה בעיה שהוא לא יכל לפתור."
  },
  {
   "start": 334.45,
   "end": 334.81,
   "text": "מי היה כאן?"
  },
  {
   "start": 335.55,
   "end": 337.79,
   "text": "מי פתר את הבעיה שאני לא פתרתי?"
  },
  {
   "start": 338.47,
   "end": 339.53,
   "text": "מי הוא אותו גאון?"
  },
  {
   "start": 339.53,
   "end": 344.21,
   "text": "בירור קצר ואיש לא היה."
  },
  {
   "start": 345.75,
   "end": 347.41,
   "text": "איש לא היה, או יותר נכון,"
  },
  {
   "start": 348.23,
   "end": 350.49,
   "text": "היה מישהו, היה אותו הלך עני,"
  },
  {
   "start": 351.15,
   "end": 354.05,
   "text": "אבל חוץ ממנו לא היה אדם."
  },
  {
   "start": 355.41,
   "end": 355.69,
   "text": "ורשי,"
  },
  {
   "start": 356.85,
   "end": 360.91,
   "text": "רשי פנה אל אותו הלך שמיועד להיות החתן שלו,"
  },
  {
   "start": 361.21,
   "end": 361.93,
   "text": "אל אותו עם הארץ,"
  },
  {
   "start": 362.95,
   "end": 363.97,
   "text": "והחל מתחקר אותו,"
  },
  {
   "start": 364.75,
   "end": 366.41,
   "text": "והחל מכריח אותו לדבר."
  },
  {
   "start": 366.41,
   "end": 369.69,
   "text": "וההלך מנסה להתחמק מכאן,"
  },
  {
   "start": 370.55,
   "end": 372.27,
   "text": "מנסה להתחמק לשם,"
  },
  {
   "start": 373.29,
   "end": 374.33,
   "text": "אבל רשי לא מוותר,"
  },
  {
   "start": 375.37,
   "end": 376.29,
   "text": "ומקץ שעה"
  },
  {
   "start": 379.05,
   "end": 381.63,
   "text": "ההלך החל מדבר ומדבר,"
  },
  {
   "start": 382.47,
   "end": 383.55,
   "text": "וכשהוא דיבר,"
  },
  {
   "start": 387.08,
   "end": 388.16,
   "text": "וכשהוא דיבר,"
  },
  {
   "start": 390.12,
   "end": 394.38,
   "text": "יצאו מפיו דברי תורה נפלאים שלימדו,"
  },
  {
   "start": 394.96,
   "end": 398.22,
   "text": "שחשפו אדם גדול, גדול בתורה,"
  },
  {
   "start": 398.84,
   "end": 404.68,
   "text": "שהסתתר מאחרי חזות של הלך נווד בעם הארץ גמור."
  },
  {
   "start": 407.44,
   "end": 409.14,
   "text": "וכבר לא היה מה להסתיר,"
  },
  {
   "start": 414.43,
   "end": 415.97,
   "text": "וכבר לא היה מה להסתיר."
  },
  {
   "start": 416.95,
   "end": 419.93,
   "text": "ההלך התגלה כגאון, כגאון גדול."
  },
  {
   "start": 420.77,
   "end": 425.93,
   "text": "שמו של ההלך היה הגאון רבי מאיר ברבי שמואל מרומרום."
  },
  {
   "start": 436.75,
   "end": 440.75,
   "text": "את השמחה בחתונת בתו של רשי עם הגאון הצעיר"
  },
  {
   "start": 440.75,
   "end": 444.97,
   "text": "אי אפשר לתאר במילים."
  },
  {
   "start": 449.02,
   "end": 454.38,
   "text": "רק עתה הוברר כמה קדושה ומופלאה הייתה ראיית האבא הגדול רשי,"
  },
  {
   "start": 460.12,
   "end": 461.72,
   "text": "ומהשידוך המופלא הזה,"
  },
  {
   "start": 462.42,
   "end": 464.06,
   "text": "מהשידוך המופלא הזה,"
  },
  {
   "start": 464.5,
   "end": 465.52,
   "text": "עולם התורה,"
  },
  {
   "start": 465.96,
   "end": 467.1,
   "text": "עם ישראל,"
  },
  {
   "start": 467.5,
   "end": 469.16,
   "text": "הרוויח שלושה נכסים,"
  },
  {
   "start": 470.02,
   "end": 471.28,
   "text": "כמו הרשב״ם,"
  },
  {
   "start": 472.28,
   "end": 475.64,
   "text": "רבי שמואל ברבי מאיר, הבן של אותו רבי מאיר,"
  },
  {
   "start": 477.04,
   "end": 478.28,
   "text": "עם רעייתו מרים,"
  },
  {
   "start": 478.66,
   "end": 494.38,
   "text": "הרשב״ם ולא רק זה אלא גם רבנו תם ולא רק זה אלא רבנו יצחק רי הזקן שלושתם מגדולי בעלי התוספות"
  },
  {
   "start": 499.49,
   "end": 499.93,
   "text": "וכך"
  },
  {
   "start": 500.77,
   "end": 510.17,
   "text": "בתו השנייה יוכבד בתו השנייה של רש״י נישאת לרבי יהודה בר נתן הריבן שהוא גם זכה להמשיך את פירוש רש״י היכן שעדיין"
  },
  {
   "start": 510.83,
   "end": 512.09,
   "text": "לא הספיק רש״י"
  },
  {
   "start": 512.09,
   "end": 520.17,
   "text": "וכך רשי זוכה להמשיך עם חתנים קדושים את עולם התורה,"
  },
  {
   "start": 520.43,
   "end": 526.29,
   "text": "להמשיך להאיר את עולם התורה בקדושה וטהרה ובשמחה."
  }
 ]
}