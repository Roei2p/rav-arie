{
 "disc": "33ש- בין המצרים א",
 "track": "Track01",
 "duration": 1555.152,
 "segments": [
  {
   "start": 3.08,
   "end": 3.58,
   "text": "תקופת"
  },
  {
   "start": 4.66,
   "end": 5.46,
   "text": "בין המצרים."
  },
  {
   "start": 7.24,
   "end": 7.88,
   "text": "התקופה הזו,"
  },
  {
   "start": 9.82,
   "end": 11.56,
   "text": "לפני כמעט אלפיים שנה,"
  },
  {
   "start": 14.93,
   "end": 17.03,
   "text": "הייתה תקופה שקדמה לחורבן בית המקדש השני."
  },
  {
   "start": 18.49,
   "end": 22.91,
   "text": "תקופה שבעם ישראל הייתה שנאת חינם לצערנו הרב."
  },
  {
   "start": 23.53,
   "end": 25.59,
   "text": "הייתה התפצלות לקבוצות."
  },
  {
   "start": 26.91,
   "end": 28.33,
   "text": "עם ישראל היה המפולג ביותר,"
  },
  {
   "start": 29.27,
   "end": 31.03,
   "text": "והרבה מעם ישראל התרחקו,"
  },
  {
   "start": 32.49,
   "end": 34.83,
   "text": "התרחקו מהתורה הקדושה, מדעת תורה."
  },
  {
   "start": 35.57,
   "end": 36.91,
   "text": "היו בעם ישראל צדוקים."
  },
  {
   "start": 39.03,
   "end": 40.23,
   "text": "הם פשוט"
  },
  {
   "start": 41.87,
   "end": 44.47,
   "text": "המציאו תורה חדשה, תורה שבכתב, זה הכול."
  },
  {
   "start": 46.33,
   "end": 48.89,
   "text": "אין תורה שבעל פה, אין דעת תורה,"
  },
  {
   "start": 49.83,
   "end": 51.61,
   "text": "אין חכמים, אין כלום לגביהם."
  },
  {
   "start": 53.31,
   "end": 53.99,
   "text": "והיו עוד כת,"
  },
  {
   "start": 54.49,
   "end": 55.81,
   "text": "קראו להם באיתוסים, גם הם ככה."
  },
  {
   "start": 58.65,
   "end": 60.47,
   "text": "פשוט התרחקו מהצינור המוביל הזה,"
  },
  {
   "start": 61.05,
   "end": 63.19,
   "text": "ממשה רבנו אל חכמי ישראל,"
  },
  {
   "start": 63.85,
   "end": 64.65,
   "text": "דור אחרי דור."
  },
  {
   "start": 65.45,
   "end": 69.03,
   "text": "תורה שנמסרה מפה לפה, מאב לבן."
  },
  {
   "start": 71.27,
   "end": 72.91,
   "text": "והיו גם עוד כת איסיים."
  },
  {
   "start": 73.51,
   "end": 74.91,
   "text": "האיסיים הם התרחקו מעם."
  },
  {
   "start": 75.61,
   "end": 77.19,
   "text": "הם היו, החליטו שהם חסידים."
  },
  {
   "start": 77.71,
   "end": 82.37,
   "text": "הרבה הסתגפויות, הרבה טבילות, הרבה ריחוק מעם ישראל."
  },
  {
   "start": 82.89,
   "end": 84.13,
   "text": "ובורא עולם לא רוצה"
  },
  {
   "start": 84.69,
   "end": 86.83,
   "text": "חסידים רחוקים מעם ישראל."
  },
  {
   "start": 88.55,
   "end": 89.91,
   "text": "לא רוצה יותר מדי פרישות."
  },
  {
   "start": 95.52,
   "end": 96.4,
   "text": "ועם ישראל,"
  },
  {
   "start": 97.32,
   "end": 99.28,
   "text": "הגרעין נשאר מעט."
  },
  {
   "start": 102.27,
   "end": 102.93,
   "text": "ולא רק זה,"
  },
  {
   "start": 103.59,
   "end": 105.05,
   "text": "אלא היו גם אז קבוצות"
  },
  {
   "start": 105.93,
   "end": 108.43,
   "text": "של בריונים שנקראו סיכריקים."
  },
  {
   "start": 109.97,
   "end": 110.77,
   "text": "הסיכריקים,"
  },
  {
   "start": 111.87,
   "end": 112.59,
   "text": "אתם יודעים מה זה?"
  },
  {
   "start": 113.29,
   "end": 114.89,
   "text": "זה התחיל מפלוגות רומאים,"
  },
  {
   "start": 115.79,
   "end": 117.73,
   "text": "גויים שהצטרפו אליהם יהודים."
  },
  {
   "start": 118.41,
   "end": 119.17,
   "text": "אתם יודעים מה זה סיכריקים?"
  },
  {
   "start": 120.07,
   "end": 120.47,
   "text": "סיכה,"
  },
  {
   "start": 121.45,
   "end": 122.87,
   "text": "סיכה זו סכין קצרה."
  },
  {
   "start": 124.17,
   "end": 126.71,
   "text": "סיכריק זה רוצח חשאי,"
  },
  {
   "start": 129.09,
   "end": 130.01,
   "text": "רוצח בסכין."
  },
  {
   "start": 131.05,
   "end": 131.71,
   "text": "אותם קבוצה,"
  },
  {
   "start": 132.13,
   "end": 132.87,
   "text": "קבוצת בריונים,"
  },
  {
   "start": 133.15,
   "end": 135.93,
   "text": "היו מסתובבים עם סכין קטנה מתחת לבגדים שלהם."
  },
  {
   "start": 138.4,
   "end": 141.94,
   "text": "וכאשר היה איזה יריב פוליטי או מישהו שעומד בדרכם,"
  },
  {
   "start": 143.22,
   "end": 146.54,
   "text": "הם היו רוצחים אותו במקצועיות עם הסכין שלהם."
  },
  {
   "start": 147.86,
   "end": 151.76,
   "text": "הם היו נטמעים בין לב ההמון ולפתע היית רואה מישהו נופל,"
  },
  {
   "start": 152.78,
   "end": 153.68,
   "text": "קורבן נוסף"
  },
  {
   "start": 154.8,
   "end": 158.08,
   "text": "במסכת הקורבנות העקובה מדם של הסיכריקים."
  },
  {
   "start": 159.3,
   "end": 160.38,
   "text": "אבל זה לא נגמר בכך."
  },
  {
   "start": 161.08,
   "end": 162.98,
   "text": "הם הפכו את אותה תקופה לתקופת אמין."
  },
  {
   "start": 163.8,
   "end": 167.18,
   "text": "הם היו באים לאנשים תמימים והיו לוקחים להם את הקרקעות."
  },
  {
   "start": 167.6,
   "end": 170.64,
   "text": "ואם לא היית נותן את הקרקע, אם לא היית נותן את הקרקע,"
  },
  {
   "start": 171.78,
   "end": 173.74,
   "text": "האדם הזה היה משלם בחייו."
  },
  {
   "start": 176.94,
   "end": 178.78,
   "text": "לא היה שום דבר שיעמוד בדרכם."
  },
  {
   "start": 182.18,
   "end": 184.86,
   "text": "וכך בעם ישראל, תקופה של התפלגות,"
  },
  {
   "start": 185.54,
   "end": 186.38,
   "text": "תקופה של קשיים,"
  },
  {
   "start": 186.84,
   "end": 188.6,
   "text": "של פחד וטרור מצד אחד,"
  },
  {
   "start": 189.12,
   "end": 191.12,
   "text": "של חסידות יותר מדי מהצד השני,"
  },
  {
   "start": 192.06,
   "end": 197.3,
   "text": "של כפירה בתורה שבעל פה לב האומה הישראלית, האומה העברית."
  },
  {
   "start": 199.19,
   "end": 200.39,
   "text": "ככה עם ישראל נראה"
  },
  {
   "start": 201.63,
   "end": 202.47,
   "text": "לפני החורבן."
  },
  {
   "start": 203.25,
   "end": 204.53,
   "text": "למעשה כבר היה חורבן"
  },
  {
   "start": 205.27,
   "end": 206.07,
   "text": "בעם ישראל."
  },
  {
   "start": 209.25,
   "end": 211.97,
   "text": "למה אנחנו מדברים על זה? אנחנו מזכירים את זה. אתם יודעים למה?"
  },
  {
   "start": 214.71,
   "end": 217.91,
   "text": "אני אספר לכם מקרה, מקרה מפורסם מאוד בהיסטוריה."
  },
  {
   "start": 218.77,
   "end": 222.75,
   "text": "היה קיסר, קיסר צרפתי, קראו לו נפוליאון בונפרטה."
  },
  {
   "start": 223.55,
   "end": 227.01,
   "text": "נפוליאון בונפרטה כבש כמעט את רוב העולם."
  },
  {
   "start": 228.29,
   "end": 230.35,
   "text": "ויום אחד באחד ממסעות הכיבוש שלו,"
  },
  {
   "start": 230.97,
   "end": 232.03,
   "text": "בקרבת פולין,"
  },
  {
   "start": 233.13,
   "end": 234.91,
   "text": "הוא מגיע לאיזה עיר קטנה,"
  },
  {
   "start": 236.45,
   "end": 239.21,
   "text": "ושם הוא שומע מאיזה בית אחד"
  },
  {
   "start": 240.15,
   "end": 241.05,
   "text": "קולות של בכי,"
  },
  {
   "start": 242.89,
   "end": 244.03,
   "text": "קולות של שבר."
  },
  {
   "start": 245.21,
   "end": 245.85,
   "text": "הוא לא ידע מה זה."
  },
  {
   "start": 247.37,
   "end": 250.43,
   "text": "הולך נפוליאון ושלח את השליחים שלו, את הסוכנים שלו,"
  },
  {
   "start": 250.71,
   "end": 252.11,
   "text": "תגידו לי, מה זה? מה יהיה שם?"
  },
  {
   "start": 253.53,
   "end": 255.93,
   "text": "הסוכנים שלו מבארים, התברר שהם הגיעו לבית כנסת."
  },
  {
   "start": 257.77,
   "end": 259.17,
   "text": "איזה יום תשעה באב,"
  },
  {
   "start": 259.95,
   "end": 262.19,
   "text": "יום חורבן בית המקדש הראשון,"
  },
  {
   "start": 262.51,
   "end": 264.15,
   "text": "יום חורבן בית המקדש השני,"
  },
  {
   "start": 264.53,
   "end": 268.59,
   "text": "יום האבל העולמי הנצחי של עם ישראל מאז חורבן בית המקדש."
  },
  {
   "start": 271.42,
   "end": 272.66,
   "text": "אומרים לו, תשמע, הם אבלים."
  },
  {
   "start": 273.62,
   "end": 274.1,
   "text": "בוא תראה."
  },
  {
   "start": 275.14,
   "end": 276.04,
   "text": "נפוליאון בא לשם,"
  },
  {
   "start": 276.74,
   "end": 281.62,
   "text": "הוא רואה את עם ישראל שם היהודים יושבים אבלים על הרצפה, קינות,"
  },
  {
   "start": 282.3,
   "end": 284.0,
   "text": "מבכים את חורבן בית המקדש."
  },
  {
   "start": 284.64,
   "end": 287.68,
   "text": "נפוליאון היה סקרן, אומר להם, תגידו לי, על מה אתם בוכים? מה קרה?"
  },
  {
   "start": 288.44,
   "end": 290.82,
   "text": "אמרו לו, אתה לא יודע, החריבו לנו את בית המקדש."
  },
  {
   "start": 291.66,
   "end": 294.42,
   "text": "כבשו לנו את ירושלים. איזה חורבן, איזה איום,"
  },
  {
   "start": 295.22,
   "end": 295.9,
   "text": "איזה נורא,"
  },
  {
   "start": 297.12,
   "end": 297.88,
   "text": "איזו צרה."
  },
  {
   "start": 300.68,
   "end": 302.86,
   "text": "חייך נפוליאון ואמר להם, תקשיבו, אתם לא מכירים,"
  },
  {
   "start": 303.22,
   "end": 305.2,
   "text": "אני קצת מעודכן מה שקורה בעולם הרחב."
  },
  {
   "start": 306.22,
   "end": 308.26,
   "text": "יש לי מרגלים בכל העולם הרחב."
  },
  {
   "start": 308.7,
   "end": 310.82,
   "text": "יש לי סוכנות ידיעות פרטית שלי."
  },
  {
   "start": 311.1,
   "end": 311.68,
   "text": "תאמינו לי,"
  },
  {
   "start": 312.22,
   "end": 314.8,
   "text": "אם היה משהו קורה בירושלים, היו אומרים לי."
  },
  {
   "start": 315.1,
   "end": 316.28,
   "text": "שום דבר לא קרה בירושלים,"
  },
  {
   "start": 317.24,
   "end": 319.52,
   "text": "לא נחרב שום דבר, אל תדאגו, אין שם מלחמה בכלל."
  },
  {
   "start": 320.5,
   "end": 322.04,
   "text": "הכל בסדר, הייתי יודע ראשון,"
  },
  {
   "start": 322.58,
   "end": 323.48,
   "text": "אם היה קורה שם משהו,"
  },
  {
   "start": 324.24,
   "end": 324.74,
   "text": "אתם יכולים לקום."
  },
  {
   "start": 325.88,
   "end": 326.54,
   "text": "אמרו לו,"
  },
  {
   "start": 327.76,
   "end": 330.6,
   "text": "אמרו לו זקני היהודים, נפוליאון, נפוליאון,"
  },
  {
   "start": 331.18,
   "end": 332.34,
   "text": "לא מדובר על היום,"
  },
  {
   "start": 332.96,
   "end": 336.26,
   "text": "מדובר על בית מקדש שהיה לפני 1,600 שנה."
  },
  {
   "start": 337.04,
   "end": 338.56,
   "text": "אז החריבו אותו הרומאים,"
  },
  {
   "start": 338.92,
   "end": 341.94,
   "text": "ולפני כן החריבו אותו נבוכדנצר הבבלי."
  },
  {
   "start": 342.32,
   "end": 343.74,
   "text": "על זה אנחנו בוכים,"
  },
  {
   "start": 343.92,
   "end": 345.5,
   "text": "על זה אנחנו מבכים."
  },
  {
   "start": 346.7,
   "end": 348.44,
   "text": "עמד נפוליאון המום."
  },
  {
   "start": 349.14,
   "end": 356.76,
   "text": "אמר נפוליאון, אם יש עם כזה שבוכה על חורבן בית המקדש שלו,"
  },
  {
   "start": 357.4,
   "end": 360.84,
   "text": "על חורבן הבית שלו,"
  },
  {
   "start": 361.48,
   "end": 364.42,
   "text": "על חורבן הבית שלו שהתרחש לפני אלף שש מאות שנה,"
  },
  {
   "start": 365.34,
   "end": 368.06,
   "text": "עדיין הם בוכים, עדיין הם מחוברים."
  },
  {
   "start": 368.62,
   "end": 371.04,
   "text": "העם הזה זה עם נצחור לירושלים."
  },
  {
   "start": 371.62,
   "end": 374.34,
   "text": "העם הזה עוד יראה את בניין בית המקדש הזה."
  },
  {
   "start": 374.8,
   "end": 378.62,
   "text": "כי אם יש עם שאחרי 1,600 שנה כואב לו,"
  },
  {
   "start": 379.2,
   "end": 380.2,
   "text": "אחרי 1,700 שנה,"
  },
  {
   "start": 380.62,
   "end": 383.04,
   "text": "אחרי 1,800, אחרי 1,900,"
  },
  {
   "start": 383.44,
   "end": 388.86,
   "text": "אחרי 1,934 שנה עדיין כואב לו, ל-935 שנה עדיין כואב לו,"
  },
  {
   "start": 389.5,
   "end": 397.12,
   "text": "הוא יזכה לראות את בניין בית המקדש, העם הזה. העם הזה ינצח את כולם, העם הזה יעבור את כולם."
  },
  {
   "start": 398.14,
   "end": 400.52,
   "text": "כי עם שמחובר להיסטוריה שלו,"
  },
  {
   "start": 401.04,
   "end": 401.88,
   "text": "מהעבר שלו?"
  },
  {
   "start": 402.74,
   "end": 403.82,
   "text": "אז ההווה שלו זה הווה,"
  },
  {
   "start": 404.48,
   "end": 405.98,
   "text": "והעתיד שלו זה עתיד."
  },
  {
   "start": 409.81,
   "end": 411.95,
   "text": "ולכן צריך לדעת, אומר הרב דסלר,"
  },
  {
   "start": 412.79,
   "end": 414.03,
   "text": "ועל המכתב מאליהו,"
  },
  {
   "start": 415.17,
   "end": 417.05,
   "text": "במאמרו על הגלות וחודש אב,"
  },
  {
   "start": 417.83,
   "end": 422.77,
   "text": "אומר צריך לדעת מי שלא מרגיש ולא מצטער על חורבן בית המקדש,"
  },
  {
   "start": 425.49,
   "end": 427.65,
   "text": "אז סימן שהוא משלים עם הגלות,"
  },
  {
   "start": 428.19,
   "end": 432.25,
   "text": "משלים עם זה שהוא במצב שהוא נמצא, מצב החורבן שנמצא, זה המצב."
  },
  {
   "start": 432.95,
   "end": 435.69,
   "text": "ואם הוא היה שם בבית המקדש, כך אומר הרב דסלר,"
  },
  {
   "start": 436.31,
   "end": 439.05,
   "text": "בגללו ובגלל שכמותו נגרם החורבן."
  },
  {
   "start": 440.43,
   "end": 442.51,
   "text": "אבל מי שמרגיש את הצער של בורא עולם,"
  },
  {
   "start": 443.49,
   "end": 444.99,
   "text": "זה צער של השם יתברך."
  },
  {
   "start": 445.89,
   "end": 448.59,
   "text": "אתם יודעים, חודש אב נקרא מנחם אב. אתם יודעים למה?"
  },
  {
   "start": 449.57,
   "end": 455.27,
   "text": "כי בבורא העולם אומר מנחם אב. אתם יודעים מי עצוב על חורבן בית המקדש שהתרחש בחודש אב?"
  },
  {
   "start": 455.67,
   "end": 458.99,
   "text": "אתם יודעים מי עצוב על כל החורבן, כל הגלויות של עם ישראל?"
  },
  {
   "start": 459.93,
   "end": 460.23,
   "text": "אני,"
  },
  {
   "start": 460.81,
   "end": 462.47,
   "text": "האבא שלכם, יותר מכם."
  },
  {
   "start": 463.21,
   "end": 464.75,
   "text": "שנבין, מה זה חורבן בית המקדש?"
  },
  {
   "start": 465.29,
   "end": 466.03,
   "text": "זה לא רק בית המקדש,"
  },
  {
   "start": 466.13,
   "end": 469.65,
   "text": "לפני 1935 שנה או 34 שנה, לא, לא."
  },
  {
   "start": 471.73,
   "end": 472.69,
   "text": "כל האסונות"
  },
  {
   "start": 473.77,
   "end": 476.33,
   "text": "שקרו מאז ועד היום, זו הגלות."
  },
  {
   "start": 477.35,
   "end": 477.69,
   "text": "השואה"
  },
  {
   "start": 478.85,
   "end": 480.23,
   "text": "לא הייתה קורית אם היה לנו בית מקדש."
  },
  {
   "start": 481.65,
   "end": 487.37,
   "text": "פיגועים לא היו קורים, לא הייתה לנו בעיה, לא עם ערפאת ולא עם אמו מאזן ולא עם סדאם, ולא עם אף אחד."
  },
  {
   "start": 489.41,
   "end": 494.23,
   "text": "לא תאונות דרכים ולא מחלות ולא כלום ולא בעיות של עוני אם היה בית מקדש."
  },
  {
   "start": 494.69,
   "end": 496.61,
   "text": "כי בית מקדש זה שלמות של עם ישראל."
  },
  {
   "start": 497.07,
   "end": 501.01,
   "text": "כשעם ישראל בגלות יש עוני, צרות, טרור, הכל, פחד, פוגרומים,"
  },
  {
   "start": 501.59,
   "end": 502.33,
   "text": "מלחמות,"
  },
  {
   "start": 502.91,
   "end": 503.45,
   "text": "קשיים,"
  },
  {
   "start": 504.79,
   "end": 505.67,
   "text": "צער,"
  },
  {
   "start": 506.27,
   "end": 507.63,
   "text": "אסונות פרטיים, אסונות כלליים."
  },
  {
   "start": 520.38,
   "end": 521.84,
   "text": "לכן אדם שמצטער"
  },
  {
   "start": 522.4,
   "end": 523.94,
   "text": "על חורבן בית המקדש,"
  },
  {
   "start": 524.62,
   "end": 525.76,
   "text": "הוא מצטער על הכל,"
  },
  {
   "start": 526.32,
   "end": 529.1,
   "text": "על פיגוע שקרה פה, על הכאב שיש לאחותו שמה,"
  },
  {
   "start": 529.66,
   "end": 530.78,
   "text": "על הכאב שיש לך,"
  },
  {
   "start": 531.16,
   "end": 534.4,
   "text": "הכאב שיש לך, הצרה שיש לך, לא משנה, בפרנסה,"
  },
  {
   "start": 534.64,
   "end": 536.2,
   "text": "נשארת בודד, נשארת,"
  },
  {
   "start": 536.76,
   "end": 538.42,
   "text": "אני לא יודע מה, עם כאב מסוים."
  },
  {
   "start": 539.36,
   "end": 544.98,
   "text": "אחת איבדה אימא איבדה את הילד שלה, אנחנו משתתפים בכאב שלה, כי הכאב שלה זה הכאב של הגלות."
  },
  {
   "start": 545.62,
   "end": 546.5,
   "text": "אז בואו בעזרת השם,"
  },
  {
   "start": 546.98,
   "end": 549.34,
   "text": "בואו בעזרת השם נושיט יד לעם ישראל,"
  },
  {
   "start": 549.78,
   "end": 551.26,
   "text": "נחזיק חזק ביחד,"
  },
  {
   "start": 551.72,
   "end": 553.12,
   "text": "עם ישראל, עם אחד,"
  },
  {
   "start": 553.58,
   "end": 554.04,
   "text": "עם הנצח,"
  },
  {
   "start": 554.56,
   "end": 560.1,
   "text": "בואו נחזור חזרה, נזכור, נחבר את העבר להווה שלנו ונבנה עתיד."
  },
  {
   "start": 560.88,
   "end": 562.18,
   "text": "לשם כך התכנסנו כאן."
  },
  {
   "start": 562.18,
   "end": 564.96,
   "text": "בואו נתחיל בעזרת השם."
  },
  {
   "start": 588.53,
   "end": 589.21,
   "text": "אומרת הגמרא,"
  },
  {
   "start": 592.2,
   "end": 592.96,
   "text": "מסכת גיטין,"
  },
  {
   "start": 594.12,
   "end": 595.06,
   "text": "דף נה עמוד ב',"
  },
  {
   "start": 596.2,
   "end": 597.34,
   "text": "אמר רבי יוחנן,"
  },
  {
   "start": 598.6,
   "end": 599.42,
   "text": "מהו שכתוב"
  },
  {
   "start": 599.94,
   "end": 601.66,
   "text": "אשרי אדם מפחד תמיד"
  },
  {
   "start": 602.36,
   "end": 604.26,
   "text": "ומקשה ליבו ייפול ברעם?"
  },
  {
   "start": 605.44,
   "end": 608.12,
   "text": "מה זה אשרי אדם מפחד תמיד?"
  },
  {
   "start": 609.56,
   "end": 611.18,
   "text": "צריך לדעת, אומר רבי יוחנן,"
  },
  {
   "start": 611.78,
   "end": 614.38,
   "text": "שאדם צריך לשקול את הצעדים שלו."
  },
  {
   "start": 615.02,
   "end": 618.06,
   "text": "כל מה שהוא עושה, צריך לדעת מה ההשפעה של זה לטווח ארוך."
  },
  {
   "start": 619.04,
   "end": 620.0,
   "text": "היום עשית צעד,"
  },
  {
   "start": 620.72,
   "end": 623.2,
   "text": "היום עשית צעד מהטווח הארוך."
  },
  {
   "start": 623.46,
   "end": 624.6,
   "text": "היא יכולה לקום אימא,"
  },
  {
   "start": 625.3,
   "end": 626.42,
   "text": "אימא יכולה לקום,"
  },
  {
   "start": 626.74,
   "end": 629.84,
   "text": "אימא צעירה או אימא מבוגרת, ולעשות צעד בחיים שלה."
  },
  {
   "start": 630.3,
   "end": 631.68,
   "text": "והיא חושבת רק עכשיו על הנוחות שלה."
  },
  {
   "start": 632.34,
   "end": 636.18,
   "text": "היא לא יודעת אבל איזה השלכות היא צריכה לחשוב על כל ההשלכות של הילדים שלה."
  },
  {
   "start": 636.86,
   "end": 638.12,
   "text": "מה זה ישפיע על הילד שלה?"
  },
  {
   "start": 638.84,
   "end": 640.26,
   "text": "איך ישפיע על הילדה שלה?"
  },
  {
   "start": 640.6,
   "end": 642.74,
   "text": "איך ישפיע על החיים שלה בעוד עשר שנים?"
  },
  {
   "start": 643.1,
   "end": 644.62,
   "text": "איך ישפיע על כל עם ישראל."
  },
  {
   "start": 645.12,
   "end": 646.82,
   "text": "אשרי אדם מפחד תמיד."
  },
  {
   "start": 651.69,
   "end": 656.15,
   "text": "גם בחורבן בית המקדש באה הגמרא ואומרת לנו, בואו תראו מקרה,"
  },
  {
   "start": 656.79,
   "end": 657.87,
   "text": "אחד או שניים."
  },
  {
   "start": 658.37,
   "end": 659.69,
   "text": "מכאן תבינו על הכל."
  },
  {
   "start": 660.49,
   "end": 663.09,
   "text": "זה מקרים שמסמלים את הכל את המצב, תבינו למה."
  },
  {
   "start": 663.59,
   "end": 666.27,
   "text": "תבינו במה צריך להיזהר כדי שלא יהיה עוד פעם חורבן."
  },
  {
   "start": 667.15,
   "end": 670.31,
   "text": "צריך לדעת במה להיזהר כדי שיהיה לנו גאולה ותקומה."
  },
  {
   "start": 674.08,
   "end": 675.0,
   "text": "אומר החפץ חיים,"
  },
  {
   "start": 676.66,
   "end": 677.84,
   "text": "סיפר החפץ חיים,"
  },
  {
   "start": 685.34,
   "end": 686.38,
   "text": "אומר החפץ חיים,"
  },
  {
   "start": 688.18,
   "end": 689.24,
   "text": "באיזה עיירה אחת,"
  },
  {
   "start": 690.1,
   "end": 691.18,
   "text": "באיזה עיירה אחת"
  },
  {
   "start": 692.78,
   "end": 693.92,
   "text": "הגיע הצבא הצרפתי."
  },
  {
   "start": 695.7,
   "end": 698.4,
   "text": "והצבא הצרפתי חנה בין העיירה לבית קברות."
  },
  {
   "start": 699.14,
   "end": 701.04,
   "text": "ואי אפשר היה ללכת, על לא הגישה להגיע לבית קברות."
  },
  {
   "start": 702.78,
   "end": 705.98,
   "text": "ואנשים היו רוצים, היהודים רוצים לקבור את המתים שלהם, ואי אפשר."
  },
  {
   "start": 706.56,
   "end": 709.58,
   "text": "אז באו שמה לחיילים, אמרו להם, תעשו טובה, אנחנו צריכים לעבור לבית הקברות."
  },
  {
   "start": 710.08,
   "end": 712.02,
   "text": "זה מעבר למחנה שלכם, ואתם חוסמים לנו את הדרך."
  },
  {
   "start": 712.56,
   "end": 713.26,
   "text": "תנו לנו לעבור."
  },
  {
   "start": 714.1,
   "end": 719.14,
   "text": "אמרו להם, טוב, למתים בסדר, נו, אבל אסור לכם להעביר דברים אחרים. אמרו, ודאי שלא, רק מתים."
  },
  {
   "start": 720.12,
   "end": 722.78,
   "text": "טוב, אז התחילו למות אנשים ועשו להם מסעות הלוויה."
  },
  {
   "start": 723.84,
   "end": 724.82,
   "text": "יום אחד עלה איזה,"
  },
  {
   "start": 725.36,
   "end": 726.94,
   "text": "בראשו של איזה יהודי, רעיון מבריק."
  },
  {
   "start": 728.26,
   "end": 730.84,
   "text": "אני אמלא את הארון מתים סחורה,"
  },
  {
   "start": 731.24,
   "end": 734.48,
   "text": "ואני אעביר סחורה לצד השני, שם יש מצור, נצורים בגלל הצבא."
  },
  {
   "start": 734.94,
   "end": 736.98,
   "text": "אני אעביר להם סחורה ואני אעשה כסף ככה."
  },
  {
   "start": 737.46,
   "end": 739.54,
   "text": "אז הוא לקח את המשפחה שלו, עשה כאילו מסע הלוויה,"
  },
  {
   "start": 739.98,
   "end": 743.28,
   "text": "העבירו את זה, בית הקברות שם חיכו להם אנשים, העבירו סחורה."
  },
  {
   "start": 744.02,
   "end": 745.82,
   "text": "זו הייתה הצלחה כלכלית מסחררת."
  },
  {
   "start": 747.1,
   "end": 750.62,
   "text": "בעקבותיה, התחיל לעשות עוד פעם, במשפחה שלו היה פעמיים בחודש הלוויה."
  },
  {
   "start": 751.72,
   "end": 752.86,
   "text": "ככה הוא היה מעביר כל פעם סחורה."
  },
  {
   "start": 753.62,
   "end": 754.94,
   "text": "ראו את זה השכנים, גם הם התחילו."
  },
  {
   "start": 756.12,
   "end": 759.92,
   "text": "והתחילו את הלוויות על הלוויות, כל יום שלוש פעמים ביום הלוויה בעיירה הזאת."
  },
  {
   "start": 760.66,
   "end": 763.26,
   "text": "יום אחד יוצא המפקד שמה של הצבא, מסתכל,"
  },
  {
   "start": 764.08,
   "end": 765.02,
   "text": "הוא רואה מסעות הלוויה."
  },
  {
   "start": 766.42,
   "end": 767.18,
   "text": "אז הוא אמר, מילא,"
  },
  {
   "start": 767.4,
   "end": 769.6,
   "text": "בעיירה הזאת יש אולי 50 יהודים,"
  },
  {
   "start": 770.08,
   "end": 771.24,
   "text": "יש כבר 200 הלוויות,"
  },
  {
   "start": 771.82,
   "end": 772.28,
   "text": "זה ניחא."
  },
  {
   "start": 773.16,
   "end": 774.64,
   "text": "אבל הלוויה, אני יודע שהעצובים."
  },
  {
   "start": 775.56,
   "end": 776.96,
   "text": "פה אני רואה אנשים שמחים."
  },
  {
   "start": 777.48,
   "end": 778.22,
   "text": "אמר, תעצרו, תעצרו."
  },
  {
   "start": 779.28,
   "end": 780.9,
   "text": "תפתחו את הארונות, בבקשה."
  },
  {
   "start": 781.64,
   "end": 782.72,
   "text": "התחילו לצעוק לו, לא,"
  },
  {
   "start": 783.14,
   "end": 788.34,
   "text": "לא, חילול המת, אסור, מבקשים ממך. תפתחו, בבקשה, את ארונות המתים."
  },
  {
   "start": 789.12,
   "end": 789.86,
   "text": "פתחו את ארונות המתים,"
  },
  {
   "start": 791.18,
   "end": 792.24,
   "text": "מצאו שם כל טוב מצרים."
  },
  {
   "start": 794.34,
   "end": 796.72,
   "text": "אוצרות על אוצרות של סחורה."
  },
  {
   "start": 799.72,
   "end": 801.68,
   "text": "אמר להם, עכשיו אני אוסר עליכם"
  },
  {
   "start": 803.28,
   "end": 804.62,
   "text": "להעביר שום דבר, גם לא מתים."
  },
  {
   "start": 806.04,
   "end": 807.6,
   "text": "וחזרו הביתה."
  },
  {
   "start": 808.6,
   "end": 812.64,
   "text": "חודש אחרי זה מת מישהו בעיירה, אחד ממכובדי העיירה."
  },
  {
   "start": 813.22,
   "end": 815.2,
   "text": "הולכים ללוות אותו, הפעם זה מת אמיתי."
  },
  {
   "start": 815.82,
   "end": 817.28,
   "text": "באים לשם וחוסמים להם את הדרך."
  },
  {
   "start": 818.3,
   "end": 819.76,
   "text": "באים היהודים ומתחילים לבכות."
  },
  {
   "start": 820.36,
   "end": 821.16,
   "text": "מה קורה פה?"
  },
  {
   "start": 821.56,
   "end": 823.32,
   "text": "בוכים לפני מפקד הצבא."
  },
  {
   "start": 824.18,
   "end": 825.94,
   "text": "אמר להם מפקד הצבא, תדעו לכם,"
  },
  {
   "start": 826.62,
   "end": 827.92,
   "text": "תדעו לכם, יהודים יקרים,"
  },
  {
   "start": 828.42,
   "end": 830.72,
   "text": "אתם יודעים, אני הסתכלתי, ראיתי כל כך הרבה הלוויות,"
  },
  {
   "start": 831.32,
   "end": 833.18,
   "text": "יותר מהאנשים שיש בעיירה, אבל שתקתי."
  },
  {
   "start": 834.28,
   "end": 836.7,
   "text": "אתם יודעים אבל מתי התעוררתי? כשראיתי"
  },
  {
   "start": 837.54,
   "end": 838.86,
   "text": "שבמקום לבכות"
  },
  {
   "start": 839.72,
   "end": 840.7,
   "text": "אתם שמחים,"
  },
  {
   "start": 841.82,
   "end": 843.04,
   "text": "שמחים במקום לבכות."
  },
  {
   "start": 844.3,
   "end": 845.92,
   "text": "אז אם אתם שמחים במקום לבכות,"
  },
  {
   "start": 846.94,
   "end": 851.66,
   "text": "לא ייתכן שזה מסע הלוויה. חשדתי בכם, ואז תפסתי אתכם,"
  },
  {
   "start": 852.26,
   "end": 853.24,
   "text": "ועכשיו אני כבר לא נותן לכם."
  },
  {
   "start": 853.84,
   "end": 854.56,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 855.46,
   "end": 858.34,
   "text": "כי אדם צריך לדעת מתי לבכות."
  },
  {
   "start": 858.96,
   "end": 863.5,
   "text": "אם הייתם בוכים אז שהעברתם את מסעות ההלוויה המדומות שלכם עם הסחורה,"
  },
  {
   "start": 864.06,
   "end": 865.46,
   "text": "לא הייתי חושד בכם היום."
  },
  {
   "start": 866.28,
   "end": 868.42,
   "text": "אדם צריך לדעת מתי לבכות."
  },
  {
   "start": 868.78,
   "end": 871.0,
   "text": "לא בכיתם אז, אז אתם דבקו עכשיו."
  },
  {
   "start": 872.2,
   "end": 875.48,
   "text": "באים חזל הקדושים, אמר רבי יוחנן, אשרי אדם מפחד תמיד,"
  },
  {
   "start": 875.96,
   "end": 878.42,
   "text": "צריך כדאי לדעת על מה לבכות,"
  },
  {
   "start": 878.78,
   "end": 881.2,
   "text": "כדי שאחרי זה לא נבכה כשיהיה מאוחר מדי."
  },
  {
   "start": 882.94,
   "end": 883.94,
   "text": "ואז הגמרא באה,"
  },
  {
   "start": 884.72,
   "end": 885.94,
   "text": "בעקבות רבי יוחנן,"
  },
  {
   "start": 886.5,
   "end": 887.26,
   "text": "ואומרת לנו,"
  },
  {
   "start": 887.66,
   "end": 889.32,
   "text": "אתם יודעים איזה מקרה, דוגמה,"
  },
  {
   "start": 889.72,
   "end": 892.0,
   "text": "זה סמל לחורבן ירושלים, ממנו נלמד?"
  },
  {
   "start": 892.46,
   "end": 895.36,
   "text": "המקרה של קמצא ובר קמצא."
  },
  {
   "start": 898.56,
   "end": 899.4,
   "text": "מה זה המקרה הזה?"
  },
  {
   "start": 900.12,
   "end": 900.92,
   "text": "היה איזה אדם אחד,"
  },
  {
   "start": 902.24,
   "end": 904.14,
   "text": "שהיה מאוד אוהב"
  },
  {
   "start": 904.74,
   "end": 905.88,
   "text": "יהודי שקראו לו קמצא,"
  },
  {
   "start": 907.5,
   "end": 908.68,
   "text": "אבל הוא היה שונא את הבן שלו."
  },
  {
   "start": 909.72,
   "end": 911.72,
   "text": "הבן של קמצא, קראו לו בר קמצא,"
  },
  {
   "start": 912.26,
   "end": 913.08,
   "text": "כך אומר רמא הרשה."
  },
  {
   "start": 913.9,
   "end": 915.04,
   "text": "ואם הבן הוא היה מסוכסך,"
  },
  {
   "start": 916.62,
   "end": 917.34,
   "text": "בצורה איומה."
  },
  {
   "start": 917.92,
   "end": 919.68,
   "text": "יום אחד אותו אדם עשה סעודה,"
  },
  {
   "start": 920.2,
   "end": 922.6,
   "text": "הזמין לסעודה שלו, פתח שולחנות,"
  },
  {
   "start": 923.8,
   "end": 925.56,
   "text": "הזמין אולם גדול בירושלים,"
  },
  {
   "start": 926.34,
   "end": 930.92,
   "text": "ואת כל טובי העיר הוא הזמין, ואת מי הוא לא הזמין? את כל אבי מאמי. יושבים שם אנשים,"
  },
  {
   "start": 932.04,
   "end": 935.78,
   "text": "עשרות מאוד, מכובדים, כל אחד במקומו, כל אחד וכבודו."
  },
  {
   "start": 937.22,
   "end": 940.8,
   "text": "הוא אמר למשרת שלו, לך תזמין בבקשה את קמצא, את חבר שלי."
  },
  {
   "start": 941.7,
   "end": 942.3,
   "text": "המשרת הלך."
  },
  {
   "start": 943.56,
   "end": 944.12,
   "text": "תראו מה זה."
  },
  {
   "start": 944.96,
   "end": 951.8,
   "text": "אומרים חז״ל, תראו מה זה שנאת חינם. היה ביניהם ריב בינו לבין בר קמצא על כלום. למה? כי המשרת אפילו לא הבין,"
  },
  {
   "start": 952.48,
   "end": 955.78,
   "text": "לא ייחס משמעות. פגש את בר קמצא, חשב שאליו הוא מתכוון. אמר לו, תשמע,"
  },
  {
   "start": 956.6,
   "end": 958.26,
   "text": "הבעל בית שלי מזמין אותך."
  },
  {
   "start": 959.98,
   "end": 963.32,
   "text": "והוא לא שם לב שזה בר קמצא, זה הבן,"
  },
  {
   "start": 963.86,
   "end": 965.76,
   "text": "זה שבעל הבית שלו מסוכסך איתו."
  },
  {
   "start": 966.36,
   "end": 969.02,
   "text": "למה הוא לא שם לב? כי זה לא היה איזה סכסוך רציני."
  },
  {
   "start": 969.54,
   "end": 970.92,
   "text": "אם זה היה סכסוך רציני, הוא לא היה מזמין אותו."
  },
  {
   "start": 971.86,
   "end": 972.52,
   "text": "הוא לא היה טועה."
  },
  {
   "start": 972.88,
   "end": 974.6,
   "text": "אבל הוא טעה"
  },
  {
   "start": 975.9,
   "end": 976.44,
   "text": "והזמין אותו."
  },
  {
   "start": 977.58,
   "end": 979.26,
   "text": "ואותו בר קמצא, הבן,"
  },
  {
   "start": 979.84,
   "end": 981.02,
   "text": "חשב, הנה, סוף סוף, אבא,"
  },
  {
   "start": 981.44,
   "end": 990.02,
   "text": "היהודי הזה רוצה להתפייס איתי, אז בוא נעשה איתו שלום, בוא נעשה סולחה. הנה, הוא מזמין אותי לסעודה שלו, אשריו, כל הכבוד, אני אבוא. מה, אני אעליב אותו? יעמיק את הריב? לא."
  },
  {
   "start": 990.92,
   "end": 991.62,
   "text": "אז הוא בא לסעודה,"
  },
  {
   "start": 994.07,
   "end": 994.97,
   "text": "והוא מתיישב,"
  },
  {
   "start": 996.23,
   "end": 997.11,
   "text": "יושב עם כולם,"
  },
  {
   "start": 997.87,
   "end": 998.75,
   "text": "וכולם שמחים,"
  },
  {
   "start": 999.55,
   "end": 1003.29,
   "text": "והכול נפלא, והכול נראה זוהר ונוצץ ונפלא."
  },
  {
   "start": 1003.75,
   "end": 1006.89,
   "text": "נראה ששום דבר לא יכול להפריע את האווירה הנעימה."
  },
  {
   "start": 1024.65,
   "end": 1026.79,
   "text": "אז לפתע בא לסעודה,"
  },
  {
   "start": 1027.77,
   "end": 1028.29,
   "text": "אותו יהודי,"
  },
  {
   "start": 1030.7,
   "end": 1031.92,
   "text": "שם בפינה באולם,"
  },
  {
   "start": 1033.02,
   "end": 1033.92,
   "text": "את השונא שלו,"
  },
  {
   "start": 1034.68,
   "end": 1036.36,
   "text": "את זה שהוא כל כך שונא אותו, את בר קמצא."
  },
  {
   "start": 1037.76,
   "end": 1039.26,
   "text": "אמר, מה הוא יושב פה? מה הוא עושה פה?"
  },
  {
   "start": 1039.78,
   "end": 1041.1,
   "text": "מי הזמין אותו בכלל?"
  },
  {
   "start": 1043.88,
   "end": 1045.12,
   "text": "הוא לא התבייש וניגש אליו,"
  },
  {
   "start": 1046.3,
   "end": 1048.0,
   "text": "ואמר לו, תגיד לי, מה אתה עושה פה?"
  },
  {
   "start": 1049.44,
   "end": 1050.58,
   "text": "מה אתה עושה בשמחה שלי?"
  },
  {
   "start": 1052.89,
   "end": 1054.55,
   "text": "אמר לו, תראה, אתה הזמנת."
  },
  {
   "start": 1055.27,
   "end": 1056.77,
   "text": "היהודי לא הקשיב אפילו."
  },
  {
   "start": 1057.41,
   "end": 1059.55,
   "text": "מה אתה עושה בשמחה שלי? קום, צא מפה."
  },
  {
   "start": 1062.75,
   "end": 1063.51,
   "text": "ובר קמצא"
  },
  {
   "start": 1064.87,
   "end": 1066.69,
   "text": "יושב ככה, קולוניה אדום,"
  },
  {
   "start": 1067.77,
   "end": 1070.23,
   "text": "אומר לבעל השמחה, ליהודי הזה, תעשה טובה, תשמע,"
  },
  {
   "start": 1071.13,
   "end": 1072.21,
   "text": "עכשיו אני אצא לא נעים."
  },
  {
   "start": 1073.81,
   "end": 1074.93,
   "text": "תשאיר אותי פה, בבקשה."
  },
  {
   "start": 1076.37,
   "end": 1077.43,
   "text": "אומר לו, תצא מפה."
  },
  {
   "start": 1078.83,
   "end": 1080.65,
   "text": "והסתררה דממה בכל האולם,"
  },
  {
   "start": 1081.83,
   "end": 1083.01,
   "text": "וכולם נועצים עיניהם"
  },
  {
   "start": 1083.69,
   "end": 1085.07,
   "text": "בסצינה שנתרחשת לפניהם."
  },
  {
   "start": 1087.61,
   "end": 1089.25,
   "text": "אמר לו בר-קמצא אדום כולו,"
  },
  {
   "start": 1089.87,
   "end": 1092.01,
   "text": "מבויש כלו, אמר לו, תשמע, אני כבר הגעתי לכאן,"
  },
  {
   "start": 1092.47,
   "end": 1093.27,
   "text": "תעשה לי טובה."
  },
  {
   "start": 1094.67,
   "end": 1098.63,
   "text": "אני אחזיר לך, אני אשלם על מה שאני אוכל, אני אשלם לך את הארוחה שלי."
  },
  {
   "start": 1099.07,
   "end": 1102.91,
   "text": "כולם פה הוזמנו חינם, אני, מה שאני אוכל אני אשלם, רק תעשה לי טובה, אל תבייש אותי,"
  },
  {
   "start": 1103.33,
   "end": 1104.09,
   "text": "תשאיר אותי פה."
  },
  {
   "start": 1105.77,
   "end": 1107.19,
   "text": "אמר לו אותו יהודי,"
  },
  {
   "start": 1107.97,
   "end": 1108.85,
   "text": "אני לא מסכים,"
  },
  {
   "start": 1109.81,
   "end": 1110.27,
   "text": "צא מפה."
  },
  {
   "start": 1113.04,
   "end": 1114.52,
   "text": "אמר לו, אתה יודע מה, תעשה לי טובה,"
  },
  {
   "start": 1115.26,
   "end": 1115.88,
   "text": "אני מתחנן."
  },
  {
   "start": 1116.64,
   "end": 1119.08,
   "text": "אני אשלם לך חצי מהאולם אני אשלם,"
  },
  {
   "start": 1119.54,
   "end": 1121.3,
   "text": "בר קמצא היה עשיר, לא היה לו בעיה של כסף."
  },
  {
   "start": 1122.08,
   "end": 1123.58,
   "text": "מה שהפריע לו, הבושה,"
  },
  {
   "start": 1124.24,
   "end": 1125.88,
   "text": "הכבוד, תעשה לי טובה,"
  },
  {
   "start": 1126.3,
   "end": 1128.84,
   "text": "אל תבייש אותי, אני אשלם לך על חצי מהאולם."
  },
  {
   "start": 1129.94,
   "end": 1131.34,
   "text": "אמר לו אותו יהודי,"
  },
  {
   "start": 1132.12,
   "end": 1134.18,
   "text": "לא מסכים, קום וצא."
  },
  {
   "start": 1136.92,
   "end": 1138.16,
   "text": "אמר לו בר קמצא,"
  },
  {
   "start": 1138.9,
   "end": 1142.04,
   "text": "תקשיב יהודי, אני אשלם לך על כל האולם."
  },
  {
   "start": 1142.64,
   "end": 1145.64,
   "text": "כל הסעודה הזאת עליי, על חשבוני,"
  },
  {
   "start": 1146.02,
   "end": 1147.4,
   "text": "רק אל תוציא אותי לפני כולם."
  },
  {
   "start": 1148.36,
   "end": 1153.64,
   "text": "אמר לו אותו יהודי לא ולא אתה תצא"
  },
  {
   "start": 1154.52,
   "end": 1157.5,
   "text": "ולא רק שהוא אמר לו הוא לקח אותו והרים אותו"
  },
  {
   "start": 1158.1,
   "end": 1159.48,
   "text": "וגרר אותו החוצה"
  },
  {
   "start": 1160.04,
   "end": 1162.34,
   "text": "כך הוא יצא מבויש לעיני כולם"
  },
  {
   "start": 1163.64,
   "end": 1166.12,
   "text": "בר קמצא הדלת נסגרה מאחוריו"
  },
  {
   "start": 1166.86,
   "end": 1169.52,
   "text": "בר קמצא נשאר בחוץ מבויש כולו"
  },
  {
   "start": 1170.22,
   "end": 1171.84,
   "text": "אמר בר קמצא בליבו"
  },
  {
   "start": 1173.08,
   "end": 1174.68,
   "text": "מאחר וישבו שם"
  },
  {
   "start": 1175.3,
   "end": 1176.3,
   "text": "גם רבנן"
  },
  {
   "start": 1176.92,
   "end": 1180.08,
   "text": "גם תלמידי חכמים, גם מנהיגי ירושלים,"
  },
  {
   "start": 1180.74,
   "end": 1182.74,
   "text": "גם אנשים חשובים ישבו שם."
  },
  {
   "start": 1183.72,
   "end": 1185.56,
   "text": "ואף אחד לא עצר בעדו?"
  },
  {
   "start": 1186.32,
   "end": 1189.78,
   "text": "אף אחד לא היה אכפת לו שהוא מבזה אותי ככה לעיני כולם?"
  },
  {
   "start": 1190.54,
   "end": 1195.36,
   "text": "כנראה מתאים להם, כנראה נוח להם עם זה."
  },
  {
   "start": 1196.08,
   "end": 1199.22,
   "text": "הם מסכימים איתו, מרוצים ממה שהוא עשה."
  },
  {
   "start": 1200.08,
   "end": 1200.74,
   "text": "אני אנקום בהם,"
  },
  {
   "start": 1201.56,
   "end": 1202.58,
   "text": "הם ישלמו ביוקר,"
  },
  {
   "start": 1203.3,
   "end": 1205.48,
   "text": "כל ירושלים, כל עם ישראל."
  },
  {
   "start": 1206.62,
   "end": 1209.8,
   "text": "ומכאן התחילו לפעול למידות הרעות שלו,"
  },
  {
   "start": 1210.32,
   "end": 1213.16,
   "text": "לתחושת הנקם וחוסר הוויתור."
  },
  {
   "start": 1214.18,
   "end": 1215.48,
   "text": "הם התנהגו לא בסדר,"
  },
  {
   "start": 1216.0,
   "end": 1222.52,
   "text": "עכשיו בא בר קמצא ותורם את חלקו לחורבן החברתי הפנימי בעם ישראל,"
  },
  {
   "start": 1222.92,
   "end": 1224.6,
   "text": "שמוביל לחורבן בית המקדש."
  },
  {
   "start": 1225.26,
   "end": 1226.34,
   "text": "הלך בר קמצא"
  },
  {
   "start": 1229.32,
   "end": 1231.7,
   "text": "ישר לקיסר רומי,"
  },
  {
   "start": 1232.72,
   "end": 1237.04,
   "text": "להלשין, לסכסך בין רומא לבין עם ישראל."
  },
  {
   "start": 1237.92,
   "end": 1241.32,
   "text": "בין האימפריה הגדולה בעולם לבין עם ישראל."
  },
  {
   "start": 1243.58,
   "end": 1244.06,
   "text": "בר קמצא,"
  },
  {
   "start": 1244.74,
   "end": 1247.1,
   "text": "למה אתה הולך ל... מה אשמים כל עם ישראל?"
  },
  {
   "start": 1247.56,
   "end": 1251.8,
   "text": "למה אתה הולך לסבך את כל עם ישראל? מה אשמים ילדים קטנים?"
  },
  {
   "start": 1252.22,
   "end": 1254.46,
   "text": "מה אשמים ילדות קטנות, תינוקות,"
  },
  {
   "start": 1255.08,
   "end": 1258.18,
   "text": "נשים? מה אשמים זקנים? הם לא היו מעורבים."
  },
  {
   "start": 1258.62,
   "end": 1260.48,
   "text": "לא אכפת לי, אני אנקום."
  },
  {
   "start": 1260.86,
   "end": 1263.56,
   "text": "תחושת הנקם הזו מפעילה את בר קמצא והוא המשיך ללכת."
  },
  {
   "start": 1266.22,
   "end": 1269.82,
   "text": "עם ישראל, אותם יושבים באולם לא היו בסדר, זה ברור."
  },
  {
   "start": 1270.6,
   "end": 1274.34,
   "text": "זה באמת העיד על המצב הקשה של עם ישראל."
  },
  {
   "start": 1277.02,
   "end": 1278.88,
   "text": "אותו יהודי התנהג בצורה מחפירה,"
  },
  {
   "start": 1280.02,
   "end": 1284.06,
   "text": "ובר קמצא המשיך באותה רמה של התנהגות,"
  },
  {
   "start": 1285.76,
   "end": 1286.48,
   "text": "ואפילו יותר."
  },
  {
   "start": 1287.94,
   "end": 1288.36,
   "text": "והוא הולך"
  },
  {
   "start": 1289.98,
   "end": 1292.76,
   "text": "ואומר לקיסר הרומי, מרדו בך היהודים."
  },
  {
   "start": 1293.76,
   "end": 1297.68,
   "text": "להגיד מרדו בך זה דבר שמחייב ללכת ולהילחם בעם ישראל."
  },
  {
   "start": 1298.32,
   "end": 1299.46,
   "text": "זה אומר הרג ורצח."
  },
  {
   "start": 1300.22,
   "end": 1302.32,
   "text": "הקיסר הרומי אומר, תוכיח לי."
  },
  {
   "start": 1302.7,
   "end": 1304.34,
   "text": "אומר לו, בר קמצא, אני אוכיח לך."
  },
  {
   "start": 1304.72,
   "end": 1305.62,
   "text": "אתה יודע, קורבנות."
  },
  {
   "start": 1306.7,
   "end": 1309.8,
   "text": "גם הגויים יכולים להקריב, אתם הגויים יכולים להקריב בבית המקדש."
  },
  {
   "start": 1311.92,
   "end": 1312.76,
   "text": "תביא קורבן,"
  },
  {
   "start": 1313.22,
   "end": 1314.24,
   "text": "תראה, אני אלך איתו,"
  },
  {
   "start": 1315.08,
   "end": 1317.62,
   "text": "ותביא איתי גם מהחיילים שלך שיראו את זה בעצמם."
  },
  {
   "start": 1318.44,
   "end": 1321.44,
   "text": "אני אלך לבית המקדש, והם לא יקבלו את הקורבן שלך. תראה."
  },
  {
   "start": 1321.98,
   "end": 1323.76,
   "text": "ואז תבין שיש להם משהו נגדך,"
  },
  {
   "start": 1324.24,
   "end": 1326.26,
   "text": "שהם מורדים בך, הם לא מקבלים אותך בכלל."
  },
  {
   "start": 1327.76,
   "end": 1328.88,
   "text": "אמר הקיסר הרומי, בוא נראה."
  },
  {
   "start": 1329.72,
   "end": 1331.04,
   "text": "שלח איתו כבשים,"
  },
  {
   "start": 1336.76,
   "end": 1355.58,
   "text": "קורבן,"
  },
  {
   "start": 1356.46,
   "end": 1356.48,
   "text": "זה יותר נכון, המלך לא שלח איתו כבש, אלא שלח איתו עגל, עגל שלישי לבטן, העגל המובחר ביותר."
  },
  {
   "start": 1356.72,
   "end": 1361.48,
   "text": "קח את הבהמה המובחרת ביותר, העגל שלישי לבטן הוא העגל המובחר ביותר, זה הבשר הטוב ביותר."
  },
  {
   "start": 1362.22,
   "end": 1364.76,
   "text": "אני נותן את המקסימום, את הדבר הכי איכותי."
  },
  {
   "start": 1367.48,
   "end": 1369.5,
   "text": "בואו נראה אם יהיה להם טענה על זה."
  },
  {
   "start": 1371.89,
   "end": 1372.43,
   "text": "צריך לדעת,"
  },
  {
   "start": 1373.21,
   "end": 1374.43,
   "text": "בר קמצא לקח את אותו עגל,"
  },
  {
   "start": 1375.69,
   "end": 1376.13,
   "text": "שלישי לבטן."
  },
  {
   "start": 1377.13,
   "end": 1379.01,
   "text": "רק הקיסר הרומי לא ידע דבר אחד."
  },
  {
   "start": 1379.71,
   "end": 1380.41,
   "text": "יש הבדל,"
  },
  {
   "start": 1380.89,
   "end": 1381.77,
   "text": "גם הרומאים,"
  },
  {
   "start": 1382.23,
   "end": 1385.71,
   "text": "גם הגויים היו מקריבים לעבודה, זה שרש עזרה שלהם כל מיני בעלי חיים."
  },
  {
   "start": 1386.27,
   "end": 1389.39,
   "text": "רק הרומאים וכל הגויים הם מסתכלים על חיצוניות."
  },
  {
   "start": 1389.97,
   "end": 1392.39,
   "text": "בעם ישראל מסתכלים גם על פנימיות."
  },
  {
   "start": 1393.43,
   "end": 1396.15,
   "text": "לכן אצל הגויים מה זה קורבן פסול אם אין רגל?"
  },
  {
   "start": 1396.97,
   "end": 1400.97,
   "text": "אם אין ראש, אני יודע, כל מיני איברים חיצוניים."
  },
  {
   "start": 1401.67,
   "end": 1405.05,
   "text": "בעם ישראל יש תפעמים מומים שאתה כי בקושי רואה,"
  },
  {
   "start": 1405.67,
   "end": 1407.29,
   "text": "אבל זה מום, זה פסול לקורבן."
  },
  {
   "start": 1408.45,
   "end": 1409.65,
   "text": "ואת זה ידע בר קמצא."
  },
  {
   "start": 1410.51,
   "end": 1411.83,
   "text": "אתם יודעים למה אני אומר לכם?"
  },
  {
   "start": 1412.39,
   "end": 1415.29,
   "text": "כי באחד הפעמים בדרך שמה לכיוון בית המקדש,"
  },
  {
   "start": 1415.85,
   "end": 1418.13,
   "text": "קם בר קמצא, ובלי שאף אחד יראה,"
  },
  {
   "start": 1418.71,
   "end": 1420.13,
   "text": "עשה לעגל הזה מום,"
  },
  {
   "start": 1421.19,
   "end": 1421.73,
   "text": "מום קטן."
  },
  {
   "start": 1423.11,
   "end": 1426.39,
   "text": "מום בעפעפיים של העגל ובשפתיים של העגל."
  },
  {
   "start": 1426.75,
   "end": 1427.51,
   "text": "לא רואים את זה."
  },
  {
   "start": 1428.41,
   "end": 1433.97,
   "text": "רק מי שמומחה בודק את המומים רואה את זה, הוא ידע שהכהנים יראו את זה ישר, הם בודקים את המומים האלה."
  },
  {
   "start": 1434.71,
   "end": 1435.97,
   "text": "אבל הגויים לא ידעו, לא יבינו."
  },
  {
   "start": 1437.81,
   "end": 1439.61,
   "text": "כי כל הגויים חיים על חיצוניות,"
  },
  {
   "start": 1440.69,
   "end": 1441.31,
   "text": "על יופי."
  },
  {
   "start": 1442.23,
   "end": 1444.51,
   "text": "יפת אלוקים ליפת וישכון באוהלי שם."
  },
  {
   "start": 1445.19,
   "end": 1446.55,
   "text": "הגויים תמיד,"
  },
  {
   "start": 1446.87,
   "end": 1451.25,
   "text": "כל הבתי עבודה זרה שלהם מלאים ותכשיטים ויופי ופאר והדר."
  },
  {
   "start": 1451.63,
   "end": 1454.05,
   "text": "היהודים זה פשטות, היהודים עובדים על פנימיות,"
  },
  {
   "start": 1454.89,
   "end": 1457.93,
   "text": "על איכות יותר, לא על חיצוניות,"
  },
  {
   "start": 1458.37,
   "end": 1459.29,
   "text": "לא על דברים נוצצים,"
  },
  {
   "start": 1459.79,
   "end": 1460.61,
   "text": "לא על רק כסף בעולם,"
  },
  {
   "start": 1461.43,
   "end": 1462.41,
   "text": "אלא תוכן,"
  },
  {
   "start": 1463.05,
   "end": 1464.07,
   "text": "שמחה אמיתית."
  },
  {
   "start": 1465.65,
   "end": 1465.93,
   "text": "זה ההבדל."
  },
  {
   "start": 1467.07,
   "end": 1468.49,
   "text": "ואת זה בר-קמצא ידע טוב מאוד."
  },
  {
   "start": 1469.23,
   "end": 1472.51,
   "text": "וככה הם באים ומביאים לבית המקדש,"
  },
  {
   "start": 1474.93,
   "end": 1475.41,
   "text": "קורבן"
  },
  {
   "start": 1476.11,
   "end": 1477.87,
   "text": "הפסול של הרומאים."
  },
  {
   "start": 1478.83,
   "end": 1479.73,
   "text": "באים רבנן,"
  },
  {
   "start": 1480.21,
   "end": 1483.01,
   "text": "באים הכוהנים ובודקים ורואים תמום,"
  },
  {
   "start": 1483.51,
   "end": 1484.93,
   "text": "והכוהנים מבינים טוב מאוד."
  },
  {
   "start": 1485.47,
   "end": 1486.67,
   "text": "את התעלול של בר קמצא."
  },
  {
   "start": 1488.37,
   "end": 1489.91,
   "text": "מתייעצים הכוהנים מה לעשות,"
  },
  {
   "start": 1491.65,
   "end": 1492.83,
   "text": "לקבל את הקורבן."
  },
  {
   "start": 1493.33,
   "end": 1495.85,
   "text": "היה שם רבי זכריה בן אבקילס שאמר להם לא,"
  },
  {
   "start": 1496.47,
   "end": 1501.45,
   "text": "אם אנחנו נקבל קורבן בעלמום זה יהיה פתח לכולם, אסור לנו, חייבים לעמוד"
  },
  {
   "start": 1502.63,
   "end": 1503.45,
   "text": "על העקרונות שלנו."
  },
  {
   "start": 1505.03,
   "end": 1506.57,
   "text": "אמרו טוב, אולי נהרוג את בר קמצא,"
  },
  {
   "start": 1507.39,
   "end": 1508.29,
   "text": "אין ברירה, הוא מלשין,"
  },
  {
   "start": 1509.01,
   "end": 1511.07,
   "text": "כדי שלא ילך ויספר לה על הקיסר הרומאי."
  },
  {
   "start": 1512.25,
   "end": 1513.85,
   "text": "אמר להם רבי זכריה בן אבקילס,"
  },
  {
   "start": 1513.89,
   "end": 1515.29,
   "text": "אז תגידו לי, אתם יודעים מה יגידו כולם?"
  },
  {
   "start": 1515.85,
   "end": 1517.61,
   "text": "כל המטיל מום בקודשים ייהרג."
  },
  {
   "start": 1518.03,
   "end": 1519.67,
   "text": "כל מי שמטיל מום בקורבנות ייהרג."
  },
  {
   "start": 1521.65,
   "end": 1523.67,
   "text": "אתם יודעים מה רבי זכריה בן אבקילס אמר להם?"
  },
  {
   "start": 1524.17,
   "end": 1527.69,
   "text": "אמר לכהנים, אתם יודעים מה המצב בעם ישראל? אתם יודעים כמה אנחנו מסוכסכים?"
  },
  {
   "start": 1528.33,
   "end": 1529.03,
   "text": "כמה יש פילוגים?"
  },
  {
   "start": 1529.73,
   "end": 1530.45,
   "text": "כמה יש מריבות?"
  },
  {
   "start": 1531.03,
   "end": 1533.91,
   "text": "אם נהרוג את רבי זכריה, את אותו בר קמצא,"
  },
  {
   "start": 1534.41,
   "end": 1536.81,
   "text": "אם נהרוג את בר קמצא, מיד יקומו אנשים,"
  },
  {
   "start": 1537.21,
   "end": 1540.67,
   "text": "ואיזה מישהו יסתכסך עם החבר שלו, ילך יהרוג אותו. יגידו, למה הרגת?"
  },
  {
   "start": 1541.05,
   "end": 1544.17,
   "text": "אני ראיתי אותו מפיל, מטיל מום בשקט בלי שאף אחד רואה בבהמה."
  },
  {
   "start": 1544.83,
   "end": 1547.17,
   "text": "אז מותר לי להרוג אותו, הנה, הרגו את בר קמצא."
  },
  {
   "start": 1547.77,
   "end": 1549.05,
   "text": "זה יהיה סיבה לרצח!"
  },
  {
   "start": 1549.71,
   "end": 1550.71,
   "text": "אנשים ינצלו את זה!"
  },
  {
   "start": 1551.25,
   "end": 1552.39,
   "text": "זה יתפרסם בכל העם."
  },
  {
   "start": 1552.81,
   "end": 1553.93,
   "text": "אסור לנו לעשות את זה."
  }
 ]
}