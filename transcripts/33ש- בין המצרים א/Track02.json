{
 "disc": "33ש- בין המצרים א",
 "track": "Track02",
 "duration": 1064.064,
 "segments": [
  {
   "start": 0.61,
   "end": 1.19,
   "text": "אומרים חז״ל,"
  },
  {
   "start": 2.01,
   "end": 2.87,
   "text": "אמר רבי יוחנן,"
  },
  {
   "start": 3.97,
   "end": 6.79,
   "text": "סבלנותו וענוותנותו של רבי זכר בן אבקילס"
  },
  {
   "start": 7.57,
   "end": 11.71,
   "text": "היא בין היתר שנתנה סייעת העזרה להחריב את בית המקדש."
  },
  {
   "start": 12.97,
   "end": 14.69,
   "text": "כי מה שקרה שבר קמצא חזר והלשין,"
  },
  {
   "start": 16.75,
   "end": 18.49,
   "text": "חזר וסיפר לרומאים,"
  },
  {
   "start": 18.93,
   "end": 20.47,
   "text": "והרומאים החליטו לעלות על ירושלים."
  },
  {
   "start": 47.41,
   "end": 48.01,
   "text": "צריך לדעת"
  },
  {
   "start": 49.23,
   "end": 51.99,
   "text": "שהרומאים שבאים על ירושלים, או החורבן שהיה,"
  },
  {
   "start": 52.67,
   "end": 53.71,
   "text": "כל דבר השואה,"
  },
  {
   "start": 54.63,
   "end": 56.45,
   "text": "כל דבר, הפיגועים שיש,"
  },
  {
   "start": 56.99,
   "end": 59.99,
   "text": "הגויים רק משמשים כאיזה מקל שחובט בנו."
  },
  {
   "start": 61.25,
   "end": 62.37,
   "text": "הבעיה הגדולה זה אנחנו."
  },
  {
   "start": 64.19,
   "end": 67.55,
   "text": "בחורבן בית המקדש אי אפשר להסתכל, להגיד מה קורה, למה היה חורבן."
  },
  {
   "start": 67.95,
   "end": 69.71,
   "text": "צריך להגיד איפה היה היהודי."
  },
  {
   "start": 71.15,
   "end": 74.87,
   "text": "איפה היה יהודי, למה היהודי גרם לחורבן, למה אנחנו גרמנו."
  },
  {
   "start": 76.31,
   "end": 76.87,
   "text": "בהגמרא,"
  },
  {
   "start": 77.49,
   "end": 81.89,
   "text": "דף נח עמוד א' במסכת גיטין ואומרת לנו, אתם יודעים על מה נחתם גזר הדין?"
  },
  {
   "start": 82.39,
   "end": 84.39,
   "text": "בואו אני אתן לכם מקרה למה נחתם גזר הדין."
  },
  {
   "start": 85.03,
   "end": 88.03,
   "text": "ממש, זה היה קש ששבח את גב הגמל."
  },
  {
   "start": 88.41,
   "end": 90.45,
   "text": "היה כמה מקרים כאלה, נגיד אחד מהם."
  },
  {
   "start": 91.25,
   "end": 91.73,
   "text": "תראו מה זה."
  },
  {
   "start": 93.69,
   "end": 99.33,
   "text": "לפעמים יש עבירה שבידם עושה מכריע את כל העולם לכף חובה."
  },
  {
   "start": 100.39,
   "end": 106.23,
   "text": "יש מצווה שהאדם עושה מכריע את כל העולם לכף זכות, יכול להציל עולם שלם והוא לא יודע."
  },
  {
   "start": 106.73,
   "end": 108.67,
   "text": "אישה לא יודעת, קיבלה על עצמה איזה כיסוי ראש,"
  },
  {
   "start": 109.07,
   "end": 111.01,
   "text": "הצילה עולם שלם והיא לא יודעת בכלל."
  },
  {
   "start": 111.95,
   "end": 113.17,
   "text": "גבר קיבל עצמו שבת,"
  },
  {
   "start": 113.85,
   "end": 116.29,
   "text": "תפילים, ולא יודע שבכלל בזה הוא."
  },
  {
   "start": 117.87,
   "end": 118.45,
   "text": "אז היה שם,"
  },
  {
   "start": 119.41,
   "end": 120.65,
   "text": "אמר רב יהודה, אמר רב,"
  },
  {
   "start": 121.89,
   "end": 125.01,
   "text": "מהו שכתוב ועשקו גבר וביתו איש ונחלתו?"
  },
  {
   "start": 125.95,
   "end": 127.09,
   "text": "היה מקרה מזעזע,"
  },
  {
   "start": 127.77,
   "end": 128.59,
   "text": "עם אדם אחד,"
  },
  {
   "start": 129.57,
   "end": 132.53,
   "text": "אדם אחד שהיה בא, למד אצל מישהו,"
  },
  {
   "start": 132.97,
   "end": 136.37,
   "text": "הוא היה עוזר נגר, הוא למד מקצוע נגרות, שהמקצוע מכובד אז,"
  },
  {
   "start": 137.39,
   "end": 139.55,
   "text": "והוא בא ללמוד נגרות אצל נגר אחד מקצועי."
  },
  {
   "start": 139.95,
   "end": 144.43,
   "text": "ואותו תלמיד, אותו אחד שבא ללמוד נגרות,"
  },
  {
   "start": 145.41,
   "end": 146.27,
   "text": "נשא עיניו"
  },
  {
   "start": 147.19,
   "end": 148.35,
   "text": "אל האש שעש את אדוניו,"
  },
  {
   "start": 149.33,
   "end": 153.33,
   "text": "רצה להתחתן עם אשתו של הנגר, של המורה שלו."
  },
  {
   "start": 155.78,
   "end": 157.3,
   "text": "אז פעם אחת הוא חיכה לאיזו הזדמנות."
  },
  {
   "start": 157.88,
   "end": 162.72,
   "text": "פעם אחת הוא שמע שהמורה שלו, היה לו קצת חובות, הוא השקיע איזו השקעה מסוימת, וצריך קצת כסף,"
  },
  {
   "start": 163.32,
   "end": 163.94,
   "text": "קצת מזומנים."
  },
  {
   "start": 164.76,
   "end": 168.02,
   "text": "אמר לו התלמיד, שמע, יש לי כסף להביא לך בבית,"
  },
  {
   "start": 168.56,
   "end": 170.78,
   "text": "תשלח את אשתך אליי הבית השנייה, ואני אביא לה כסף,"
  },
  {
   "start": 170.78,
   "end": 171.16,
   "text": "תביא, תביא לך."
  },
  {
   "start": 173.49,
   "end": 174.39,
   "text": "המורה הזה היה תמים."
  },
  {
   "start": 175.17,
   "end": 176.03,
   "text": "הנגר היה תמים."
  },
  {
   "start": 177.01,
   "end": 177.85,
   "text": "שלח את אשתו אצלו."
  },
  {
   "start": 179.07,
   "end": 181.47,
   "text": "לא שמר לרגע על כללי הצניעות. הוא לא, לא, לא האמין."
  },
  {
   "start": 182.99,
   "end": 184.11,
   "text": "שמה הוא מתכנן לו?"
  },
  {
   "start": 187.7,
   "end": 188.8,
   "text": "שכח אותו מורה."
  },
  {
   "start": 189.46,
   "end": 191.84,
   "text": "לא נזהר כל כבודה של בת מלך פנימה."
  },
  {
   "start": 193.14,
   "end": 195.46,
   "text": "אישה צריכה כאן לשמור את עצמה."
  },
  {
   "start": 196.72,
   "end": 197.98,
   "text": "גבר זה, זה מסוכן."
  },
  {
   "start": 201.09,
   "end": 205.09,
   "text": "ואותה אישה הולכת אל אותו, אל אותו תלמיד, אל הבית שלו להביא את הכסף."
  },
  {
   "start": 207.5,
   "end": 210.98,
   "text": "והתלמיד אמר לה, תשמעי, הכסף צריך להגיע, תמתיני פה שנייה,"
  },
  {
   "start": 211.42,
   "end": 212.92,
   "text": "והשאיר אותה, ועיכב אותה."
  },
  {
   "start": 213.54,
   "end": 214.66,
   "text": "עיכב אותה לא יום אחד,"
  },
  {
   "start": 215.24,
   "end": 217.6,
   "text": "לא יומיים, שלושה ימים הוא עיכב אותה,"
  },
  {
   "start": 218.38,
   "end": 219.94,
   "text": "עד שנתן את הכסף."
  },
  {
   "start": 220.68,
   "end": 221.8,
   "text": "אבל כשהוא נתן לה את הכסף,"
  },
  {
   "start": 222.46,
   "end": 225.46,
   "text": "הוא אמר לה, הנה תכף כבר יגיע הכסף, דאג למישהו שיביא לה את הכסף עוד כמה שעות,"
  },
  {
   "start": 226.0,
   "end": 229.7,
   "text": "והוא רץ מהר לבית של אותו נגר, אותו מורה."
  },
  {
   "start": 230.72,
   "end": 233.3,
   "text": "בא אליו ואומר לו, תשמע, אני חייב להגיד לך את האמת, מצטער להגיד לך, תראה,"
  },
  {
   "start": 234.24,
   "end": 236.8,
   "text": "אתה יודע, אתה בטח שואל אותי, איפה אשתך?"
  },
  {
   "start": 237.68,
   "end": 238.52,
   "text": "אתה יודע איפה היא?"
  },
  {
   "start": 239.66,
   "end": 241.7,
   "text": "אני שלחתי אותה כבר לפני שלושה ימים."
  },
  {
   "start": 243.52,
   "end": 246.58,
   "text": "והיא מתעכבת בדרך, ואמרו לי, תשמע, היא שמה נמצאת, שמה,"
  },
  {
   "start": 246.88,
   "end": 248.4,
   "text": "תפסו את הבחורים"
  },
  {
   "start": 250.4,
   "end": 251.2,
   "text": "לא הגונים."
  },
  {
   "start": 252.5,
   "end": 253.32,
   "text": "והיא נמצאת איתם."
  },
  {
   "start": 253.92,
   "end": 254.94,
   "text": "והלכתי והזדעזעתי."
  },
  {
   "start": 255.58,
   "end": 263.1,
   "text": "וכשראיתי את זה, באתי אליך להגיד לך, תיזהר, אשתך חטאה, אשתך לא מתאימה לך, אתה חייב לגרש אותה. אוי ואבוי, מה אני אעשה?"
  },
  {
   "start": 263.76,
   "end": 267.46,
   "text": "מה אני אגיד לך? התביישתי לבוא להגיד לך, ואני חייב להגיד לך את האמת, אני דואג לך."
  },
  {
   "start": 268.62,
   "end": 273.74,
   "text": "אותו אחד אמר לו, אתה יודע מה, תודה לך, עם דבר כזה לא האמנתי, אבל אם אשתי ככה, הוא האמין לו."
  },
  {
   "start": 274.56,
   "end": 276.08,
   "text": "הוא האמין לו, מאיפה הוא צריך לדעת?"
  },
  {
   "start": 277.2,
   "end": 279.18,
   "text": "או אולי היה צריך לבדוק, אבל זה המצב."
  },
  {
   "start": 280.54,
   "end": 281.76,
   "text": "זה מה שהוא עשה, האמין לו."
  },
  {
   "start": 282.2,
   "end": 283.74,
   "text": "אמר לו, תדע לך מה, מה אני יכול לעשות?"
  },
  {
   "start": 284.22,
   "end": 285.42,
   "text": "הוא אומר לו, תאמין לי, תגרש אותה."
  },
  {
   "start": 286.26,
   "end": 291.74,
   "text": "הוא אמר לו, אבל איך אני יכול לגרש אותה? הכתובה שלה כדי לגרש אותה, אני צריך לשלם הרבה כסף, ואין לי, אני בחובות!"
  },
  {
   "start": 292.7,
   "end": 294.34,
   "text": "אמר לו, תקשיב, יש לי קצת כסף שחסכתי,"
  },
  {
   "start": 294.94,
   "end": 296.64,
   "text": "אני אעזור לך, אני אשלם לך, תגרש."
  },
  {
   "start": 297.46,
   "end": 302.28,
   "text": "אני אתן לך, מה איכפת לך? תן לכסף וזה, תשלח אותך, חבל לך להחזיק אישה כזאת, זה צרה בבית."
  },
  {
   "start": 303.56,
   "end": 305.54,
   "text": "והוא היה כל כך מבולבל לה, הבעל,"
  },
  {
   "start": 306.1,
   "end": 309.8,
   "text": "וכל כך חסר אונים, כזאת שמועה רעה, אשתו,"
  },
  {
   "start": 310.58,
   "end": 313.58,
   "text": "כל כך התנהגה ככה, והוא כל כך בצער התחיל לבכות."
  },
  {
   "start": 314.2,
   "end": 315.16,
   "text": "טוב, בסדר, היה מוכן."
  },
  {
   "start": 315.74,
   "end": 316.9,
   "text": "הלך באמת וגירש אותה."
  },
  {
   "start": 318.56,
   "end": 319.52,
   "text": "והוא נתן לו את הכסף."
  },
  {
   "start": 321.56,
   "end": 323.04,
   "text": "ואחרי שהוא גירש אותה,"
  },
  {
   "start": 323.58,
   "end": 330.84,
   "text": "הלך אותו תלמיד לאותה אישה, אמר לה, בואי תתחתני איתי, תראי איך בעלך יתנהג איתך. בואי תהיי אשתי, אני אכבד אותך. ושכנע אותה, והתחתנו."
  },
  {
   "start": 331.92,
   "end": 335.18,
   "text": "וכשהם התחתנו, הכתובה של הכסף שהוא נתן"
  },
  {
   "start": 335.88,
   "end": 339.36,
   "text": "לבעל כדי לשלם דמי גט לאישה,"
  },
  {
   "start": 339.46,
   "end": 340.7,
   "text": "עבר אליו, חזר אליו חזרה."
  },
  {
   "start": 342.3,
   "end": 346.74,
   "text": "והוא חי עם אשתו"
  },
  {
   "start": 347.5,
   "end": 349.92,
   "text": "של אותו מורה, והמורה מחזיר לו את ההלוואה"
  },
  {
   "start": 350.52,
   "end": 351.7,
   "text": "בחובות עכשיו כלפיו."
  },
  {
   "start": 353.48,
   "end": 356.74,
   "text": "הגיע הזמן ולא היה לו כסף להחזיר את ההלוואה לאותו מורה."
  },
  {
   "start": 357.82,
   "end": 358.82,
   "text": "בא אליו התלמיד הזה,"
  },
  {
   "start": 359.5,
   "end": 361.74,
   "text": "התלמיד הרשע הזה, ואומר לו, נו, מה עם הכסף שאתה חייב לי?"
  },
  {
   "start": 362.22,
   "end": 363.48,
   "text": "נתתי לך כדי לגרש את אשתך."
  },
  {
   "start": 364.64,
   "end": 367.2,
   "text": "אמר, אני, אין לי כסף להחזיר לך."
  },
  {
   "start": 367.68,
   "end": 368.56,
   "text": "אמר לו, אין לך כסף?"
  },
  {
   "start": 369.46,
   "end": 370.16,
   "text": "אני לא מוותר לך."
  },
  {
   "start": 370.94,
   "end": 372.32,
   "text": "בוא תהיה המשרת שלי,"
  },
  {
   "start": 373.32,
   "end": 376.28,
   "text": "תהיה משרת שלי בבית, ואני אוריד לך מהחוב."
  },
  {
   "start": 379.38,
   "end": 380.5,
   "text": "אומרת הגמרא,"
  },
  {
   "start": 381.14,
   "end": 384.96,
   "text": "יושבים אותו תלמיד, אותו זה שלמד נגרות,"
  },
  {
   "start": 385.8,
   "end": 388.6,
   "text": "עם אשתו החדשה, הגרושה של אותו אחד,"
  },
  {
   "start": 390.22,
   "end": 394.66,
   "text": "יושבים, אוכלים ושותים ושמחים,"
  },
  {
   "start": 395.48,
   "end": 396.84,
   "text": "והוא הבעל המסכן,"
  },
  {
   "start": 397.72,
   "end": 401.3,
   "text": "אותו אדם שרימו אותו, שלקחו את אשתו,"
  },
  {
   "start": 402.04,
   "end": 403.46,
   "text": "היה משרת אותם"
  },
  {
   "start": 404.02,
   "end": 405.32,
   "text": "ועומד ומשקה אותם."
  },
  {
   "start": 405.92,
   "end": 408.04,
   "text": "תביא לנו יין! והוא מביא להם יין."
  },
  {
   "start": 408.6,
   "end": 409.48,
   "text": "אתם יודעים מה קרה?"
  },
  {
   "start": 409.96,
   "end": 411.96,
   "text": "כשהוא הלך להביא את היין"
  },
  {
   "start": 412.5,
   "end": 413.82,
   "text": "מהצער שהיה לו,"
  },
  {
   "start": 414.26,
   "end": 415.66,
   "text": "כשהוא ראה מה עשו לו,"
  },
  {
   "start": 416.0,
   "end": 419.4,
   "text": "כשהוא ראה איך אותו אחד שמח עם אשתו שלו לשעבר,"
  },
  {
   "start": 420.56,
   "end": 422.76,
   "text": "כל כך כאב לו ישב ובכה,"
  },
  {
   "start": 423.36,
   "end": 428.28,
   "text": "והדמעות האלה נשרו לתוך הכוסות יין שהוא השקה אותן."
  },
  {
   "start": 430.88,
   "end": 433.84,
   "text": "והצער הזה סלעלה,"
  },
  {
   "start": 434.64,
   "end": 435.8,
   "text": "עלה אל על השמיים."
  },
  {
   "start": 437.0,
   "end": 438.74,
   "text": "ואותה שעה שהוא בכה,"
  },
  {
   "start": 439.58,
   "end": 441.32,
   "text": "כבר כבר אי אפשר היה להתאפק בשמיים."
  },
  {
   "start": 442.68,
   "end": 444.28,
   "text": "על מקרה כזה וכדומה,"
  },
  {
   "start": 445.22,
   "end": 448.1,
   "text": "על אותה שעה נחתם גזר הדין."
  },
  {
   "start": 448.74,
   "end": 449.96,
   "text": "נחתם גזר הדין."
  },
  {
   "start": 453.02,
   "end": 453.74,
   "text": "ואתם יודעים,"
  },
  {
   "start": 454.38,
   "end": 456.02,
   "text": "אחת הסיבות שנחתם גזר הדין,"
  },
  {
   "start": 456.64,
   "end": 458.3,
   "text": "שכל הסביבה הקרובה,"
  },
  {
   "start": 459.26,
   "end": 460.98,
   "text": "כל העיר, כולם ידעו מזה,"
  },
  {
   "start": 461.92,
   "end": 462.28,
   "text": "וכולם שתקו."
  },
  {
   "start": 463.58,
   "end": 466.7,
   "text": "כולם ראו את הדבר הנורא הזה ושתקו, זה היה נורמה."
  },
  {
   "start": 467.68,
   "end": 471.36,
   "text": "תשמע, אם אותו אחד הצליח להשיג את אשתו של השני,"
  },
  {
   "start": 474.01,
   "end": 483.45,
   "text": "וצחק עליו ולעג עליו וביזה אותו והפך אותו למשרת שלו, כל הכבוד, תשמע, יש לו ייחוש עסקים יותר טוב. הוא הצליח, הוא מצליחן, זה ווינר וזה לוזר."
  },
  {
   "start": 483.91,
   "end": 485.05,
   "text": "זה מצליחן וזה כישלון."
  },
  {
   "start": 487.17,
   "end": 488.39,
   "text": "את זה מעריצים, את זה לא."
  },
  {
   "start": 489.29,
   "end": 492.55,
   "text": "אמר בורא עולם, אי אפשר להחזיק. לא, לא, לא, לא."
  },
  {
   "start": 493.15,
   "end": 496.25,
   "text": "באותה שעה נחתם גזר אדיר."
  },
  {
   "start": 537.24,
   "end": 538.74,
   "text": "ברומאים, ברומא,"
  },
  {
   "start": 539.44,
   "end": 543.42,
   "text": "הקיסר רומי שולח את אחד מהמצביעים הגדולים שלו."
  },
  {
   "start": 544.84,
   "end": 546.1,
   "text": "קראו לו נרון קיסר."
  },
  {
   "start": 546.44,
   "end": 548.4,
   "text": "הוא היה מועמד להיות הקיסר הבא של רומי."
  },
  {
   "start": 550.58,
   "end": 552.64,
   "text": "אותו נרון קיסר היה נשמה מיוחדת."
  },
  {
   "start": 553.52,
   "end": 554.5,
   "text": "היה אדם מיוחד."
  },
  {
   "start": 555.22,
   "end": 557.62,
   "text": "הוא מגיע לסביבות ירושלים, גוי,"
  },
  {
   "start": 558.38,
   "end": 559.84,
   "text": "עובד עבודה זרה."
  },
  {
   "start": 560.78,
   "end": 561.92,
   "text": "הוא מגיע והוא יודע,"
  },
  {
   "start": 562.7,
   "end": 565.3,
   "text": "אני לא יכול לנצח את ירושלים בכוחות טבעיים."
  },
  {
   "start": 565.94,
   "end": 568.12,
   "text": "עם ישראל, מי שקובע לו זה בורר עולם."
  },
  {
   "start": 568.62,
   "end": 573.4,
   "text": "אני חייב לעשות, לבדוק אם אני יכול באמת ללכת ולהילחם בירושלים."
  },
  {
   "start": 574.08,
   "end": 574.98,
   "text": "והוא הלך ובדק."
  },
  {
   "start": 575.84,
   "end": 577.32,
   "text": "היה לו שיטה להטיל גורלות."
  },
  {
   "start": 578.72,
   "end": 579.14,
   "text": "מה הוא עשה?"
  },
  {
   "start": 579.66,
   "end": 580.62,
   "text": "הוא לקח עץ וקשת,"
  },
  {
   "start": 581.28,
   "end": 584.44,
   "text": "פנה לכיוון של ירושלים וירה חץ אחד,"
  },
  {
   "start": 585.1,
   "end": 586.5,
   "text": "ורץ אחרי החץ."
  },
  {
   "start": 586.96,
   "end": 587.9,
   "text": "כשהחץ נחת,"
  },
  {
   "start": 588.48,
   "end": 591.98,
   "text": "הוא בדק איפה הכיוון של ראש החץ היה, לאן."
  },
  {
   "start": 593.38,
   "end": 595.94,
   "text": "ברגע שהוא ראה שהוא פונה לירושלים, הוא שמח."
  },
  {
   "start": 596.26,
   "end": 597.36,
   "text": "אמר, הנה סימן ראשון,"
  },
  {
   "start": 598.14,
   "end": 599.0,
   "text": "שירושלים,"
  },
  {
   "start": 600.58,
   "end": 605.52,
   "text": "בורא עולם אלוקי היהודים, מסכים שאני אכבוש אותה."
  },
  {
   "start": 607.12,
   "end": 610.64,
   "text": "הוא הלך אחרי זה לצד שני, לצד מערב, הצד השני בכלל."
  },
  {
   "start": 612.44,
   "end": 613.38,
   "text": "הצד הנגדי בכלל."
  },
  {
   "start": 614.36,
   "end": 617.76,
   "text": "וירה חץ לצד הנגדי, ורץ אחרי החץ."
  },
  {
   "start": 618.24,
   "end": 620.14,
   "text": "הוא רץ החץ עושה את המסלול שלו,"
  },
  {
   "start": 620.46,
   "end": 627.88,
   "text": "ולפני הנחיתה החץ מסתובב והראש של החץ פונה לירושלים."
  },
  {
   "start": 628.9,
   "end": 629.4,
   "text": "אבל הנה,"
  },
  {
   "start": 630.12,
   "end": 631.1,
   "text": "זה כבר סימן נפלא."
  },
  {
   "start": 632.68,
   "end": 634.32,
   "text": "הוא פנה לצד דרום,"
  },
  {
   "start": 635.06,
   "end": 636.7,
   "text": "וירה חץ לצד דרום,"
  },
  {
   "start": 637.48,
   "end": 642.16,
   "text": "ושוב ראש החץ פונה ברגע האחרון לכיוון ירושלים."
  },
  {
   "start": 642.82,
   "end": 644.68,
   "text": "הוא ירה לצד צפון,"
  },
  {
   "start": 645.7,
   "end": 646.78,
   "text": "וגם בצד צפון,"
  },
  {
   "start": 648.24,
   "end": 649.46,
   "text": "החץ פונה לכיוון ירושלים."
  },
  {
   "start": 650.94,
   "end": 652.16,
   "text": "אמר נרון קיסר,"
  },
  {
   "start": 652.92,
   "end": 653.88,
   "text": "הנה ראיה,"
  },
  {
   "start": 654.46,
   "end": 661.08,
   "text": "הנה סימן שבאמת אני אצליח לכבוש את ירושלים,"
  },
  {
   "start": 661.86,
   "end": 663.88,
   "text": "יש לי אישור מבורא עולם."
  },
  {
   "start": 666.3,
   "end": 667.54,
   "text": "אבל הוא לא הסתפק בזה."
  },
  {
   "start": 669.0,
   "end": 670.86,
   "text": "נרון קיסר שמע שהיהודים"
  },
  {
   "start": 671.42,
   "end": 674.18,
   "text": "היו הולכים ופונים לילדים קטנים שיוצאים מהתלמוד תורה,"
  },
  {
   "start": 674.58,
   "end": 675.96,
   "text": "ואומרים להם, תגידו לי איזה פסוק."
  },
  {
   "start": 677.32,
   "end": 678.08,
   "text": "ועל פי הפסוק"
  },
  {
   "start": 681.24,
   "end": 683.28,
   "text": "הם היו יודעים בדיוק מה יהיה, מה יקרה."
  },
  {
   "start": 684.46,
   "end": 687.86,
   "text": "בפסוק היה מרומז העתיד שלהם."
  },
  {
   "start": 688.52,
   "end": 690.96,
   "text": "הלך נרון קיסר, תפס ילד יהודי קטן."
  },
  {
   "start": 691.44,
   "end": 692.38,
   "text": "אמר לו, תגיד לי איזה פסוק,"
  },
  {
   "start": 692.7,
   "end": 694.34,
   "text": "תגיד לי איזה פסוק עכשיו שעולה לך בראש."
  },
  {
   "start": 697.33,
   "end": 699.01,
   "text": "הילד אמר לו פסוק מספר יחזקאל."
  },
  {
   "start": 700.29,
   "end": 705.47,
   "text": "פרק כה, פסוק י״ד אמר לו, ונתתי את נקמתי באדום ביד עמי ישראל."
  },
  {
   "start": 706.49,
   "end": 709.99,
   "text": "כלומר, אומר הפסוק, הקדוש ברוך הוא ינקום באדום, אדום זה הרומאים."
  },
  {
   "start": 710.63,
   "end": 712.49,
   "text": "צאצאיו של עשיו האדומי,"
  },
  {
   "start": 713.19,
   "end": 714.89,
   "text": "האדומי אדום מלשון דם,"
  },
  {
   "start": 715.55,
   "end": 717.53,
   "text": "שכולם שפיכות דמים לכוח ההיסטוריה."
  },
  {
   "start": 718.51,
   "end": 722.25,
   "text": "אומר הקדוש ברוך הוא, אני אנקום את אדום, את הנקמה שלי מאדום."
  },
  {
   "start": 730.44,
   "end": 730.82,
   "text": "נרון קיסר,"
  },
  {
   "start": 731.78,
   "end": 732.34,
   "text": "תקשיבו מה אמר."
  },
  {
   "start": 733.26,
   "end": 733.62,
   "text": "אמר"
  },
  {
   "start": 734.26,
   "end": 737.36,
   "text": "קודשא בריחו בעל חרוב ובטא,"
  },
  {
   "start": 737.92,
   "end": 739.6,
   "text": "ובעל חיפור ידיה בה הוא גברה."
  },
  {
   "start": 740.88,
   "end": 743.58,
   "text": "אמר קודשא בריחו הקדוש ברוך הוא,"
  },
  {
   "start": 744.16,
   "end": 747.62,
   "text": "בעל חרוב ובטא, רוצה להחריב את הבית שלו."
  },
  {
   "start": 748.02,
   "end": 751.5,
   "text": "אני מבין שמורא העולם רוצה להחריב את בית המקדש שלו,"
  },
  {
   "start": 752.32,
   "end": 752.86,
   "text": "אבל בסוף,"
  },
  {
   "start": 753.52,
   "end": 755.06,
   "text": "במי הוא ינקה את הידיים?"
  },
  {
   "start": 755.7,
   "end": 759.08,
   "text": "על ידי מי הוא יתכפר כל העוונות? על חשבוני!"
  },
  {
   "start": 759.54,
   "end": 761.28,
   "text": "אני אהיה השליח הרע שלו."
  },
  {
   "start": 761.9,
   "end": 763.32,
   "text": "אני לא רוצה להיות שליח רע."
  },
  {
   "start": 766.42,
   "end": 768.1,
   "text": "אתם יודעים מה עשה נירון קיסר?"
  },
  {
   "start": 769.8,
   "end": 771.48,
   "text": "הוא ערק מהרומאים."
  },
  {
   "start": 773.12,
   "end": 775.26,
   "text": "הלך והתגייר."
  },
  {
   "start": 775.96,
   "end": 776.68,
   "text": "עזב את הכסף,"
  },
  {
   "start": 777.3,
   "end": 778.18,
   "text": "עזב את העוצמה."
  },
  {
   "start": 778.66,
   "end": 781.76,
   "text": "שר צבא חשוב, המועמד להיות קיסר."
  },
  {
   "start": 784.23,
   "end": 787.19,
   "text": "בספרי ההיסטוריה העתיקים על חיי מלכי רומי"
  },
  {
   "start": 787.79,
   "end": 793.05,
   "text": "כתוב שם שנרון קיסר ברח מהצבא שלו ולא ידוע מה עלה בגורלו."
  },
  {
   "start": 794.83,
   "end": 797.27,
   "text": "נרון קיסר הצטרף לעם ישראל,"
  },
  {
   "start": 797.99,
   "end": 802.89,
   "text": "ויתר על הכול כדי להצטרף כגר לעם ישראל,"
  },
  {
   "start": 803.37,
   "end": 804.87,
   "text": "העם זה שהולך להיכבש,"
  },
  {
   "start": 805.29,
   "end": 806.71,
   "text": "העם הלכאורה הבזוי."
  },
  {
   "start": 807.13,
   "end": 808.61,
   "text": "נרון קיסר ידע את האמת."
  },
  {
   "start": 809.27,
   "end": 810.47,
   "text": "נרון קיסר זכה."
  },
  {
   "start": 811.39,
   "end": 812.09,
   "text": "הנכד שלו,"
  },
  {
   "start": 812.67,
   "end": 814.69,
   "text": "הנכד של נרון קיסר היה, אתם יודעים מי?"
  },
  {
   "start": 815.21,
   "end": 816.83,
   "text": "רבי מאיר בעל הנס."
  },
  {
   "start": 817.21,
   "end": 819.57,
   "text": "רבי מאיר בעל הנס זה הנכד של נרון קיסר."
  },
  {
   "start": 821.01,
   "end": 822.27,
   "text": "נרון קיסר התגייר."
  },
  {
   "start": 833.51,
   "end": 834.29,
   "text": "רומי שמעו את זה."
  },
  {
   "start": 836.09,
   "end": 838.69,
   "text": "הם הבינו שהם איבדו את הרמטכ״ל שלהם."
  },
  {
   "start": 839.83,
   "end": 841.59,
   "text": "שלחו מפקד צבא אחר,"
  },
  {
   "start": 842.49,
   "end": 843.71,
   "text": "את אספסיאנוס."
  },
  {
   "start": 846.49,
   "end": 847.75,
   "text": "בינתיים בירושלים."
  },
  {
   "start": 848.87,
   "end": 853.13,
   "text": "בירושלים מתחיל מצור של אספסיאנוס, שלוש שנים מוצר עליה."
  },
  {
   "start": 854.13,
   "end": 857.19,
   "text": "בירושלים נמצאים שלושה עשירים."
  },
  {
   "start": 859.09,
   "end": 861.03,
   "text": "אחד קוראים לו נקדימון בן-גוריון,"
  },
  {
   "start": 871.27,
   "end": 873.17,
   "text": "אחד קראו לו כלבה סבוע,"
  },
  {
   "start": 873.99,
   "end": 876.11,
   "text": "ואחד קראו לו בן ציצית הכסת."
  },
  {
   "start": 879.95,
   "end": 882.37,
   "text": "נקדימון בן-גוריון נעשה לו נס,"
  },
  {
   "start": 882.71,
   "end": 884.77,
   "text": "ובשבילו זרחה השמש,"
  },
  {
   "start": 885.29,
   "end": 887.83,
   "text": "יצאה השמש כבר אחרי שקיעתה."
  },
  {
   "start": 889.29,
   "end": 893.21,
   "text": "בן כלבה סבוע היה דואג בעל חסד מאין כמו,"
  },
  {
   "start": 893.61,
   "end": 895.19,
   "text": "כמו היה דואג לעניי ירושלים."
  },
  {
   "start": 904.88,
   "end": 906.2,
   "text": "בן ציצית הכסת"
  },
  {
   "start": 907.26,
   "end": 908.62,
   "text": "היה עשיר גדול."
  },
  {
   "start": 909.86,
   "end": 913.4,
   "text": "למה הוא נקרא בן ציצית הכסת? כי הוא הקפיד כל כך הרבה על מצוות ציצית."
  },
  {
   "start": 914.8,
   "end": 917.54,
   "text": "הוא ידע שהמצווה הזו מציינת את החשיבות של עם ישראל,"
  },
  {
   "start": 917.92,
   "end": 921.16,
   "text": "את המעלה האלוקית שלהם, כמו שאומר המהר״ל מפראג,"
  },
  {
   "start": 922.42,
   "end": 923.54,
   "text": "והיא שקולה כנגד כל המצוות."
  },
  {
   "start": 924.64,
   "end": 926.44,
   "text": "אז הוא היה הולך עם ציצית כזאת גדולה,"
  },
  {
   "start": 927.18,
   "end": 929.7,
   "text": "שהציצית הייתה נגררת על הרצפה,"
  },
  {
   "start": 930.36,
   "end": 933.84,
   "text": "אבל לא שייך שעשיר כמו בן ציצית הכסת ילך ברחוב"
  },
  {
   "start": 934.6,
   "end": 936.18,
   "text": "כשהציציות שלו על הרצפה."
  },
  {
   "start": 936.9,
   "end": 937.46,
   "text": "אז מה הוא עשה?"
  },
  {
   "start": 938.9,
   "end": 939.9,
   "text": "המשרתים שלו"
  },
  {
   "start": 940.62,
   "end": 943.84,
   "text": "היו מפזרים שטיחים, שטיחים יקרים,"
  },
  {
   "start": 945.54,
   "end": 946.62,
   "text": "יקרים מאוד,"
  },
  {
   "start": 947.86,
   "end": 949.96,
   "text": "והציצית ככה הייתה נגררת על השטיחים,"
  },
  {
   "start": 951.2,
   "end": 953.94,
   "text": "ובן ציצית הכסת נתן הוראה למשרתים שלו,"
  },
  {
   "start": 954.54,
   "end": 957.92,
   "text": "אל תרימו את השטיחים, תשאירו אותם ככה ברחוב."
  },
  {
   "start": 958.78,
   "end": 959.54,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 960.4,
   "end": 964.22,
   "text": "כי בן ציצית הכסת רצה שעניי ירושלים"
  },
  {
   "start": 965.04,
   "end": 969.86,
   "text": "יתפרנסו מהשטיחים, ייקחו את השטיחים אליהם וככה יקבלו צדקה"
  },
  {
   "start": 970.66,
   "end": 971.92,
   "text": "בזכות"
  },
  {
   "start": 972.52,
   "end": 974.38,
   "text": "בלי לבקש, בלי להתבייש."
  },
  {
   "start": 977.48,
   "end": 979.3,
   "text": "הוא רצה שיקחו, תראו איזה צדיק."
  },
  {
   "start": 980.0,
   "end": 983.78,
   "text": "רצה שאותם עניים של ירושלים יזכו בפרנסה מן השמיים."
  },
  {
   "start": 984.52,
   "end": 987.42,
   "text": "שמע ההפקר, לא על ידי חסד, לא על ידי טובות."
  },
  {
   "start": 987.9,
   "end": 988.62,
   "text": "לא התביישו."
  },
  {
   "start": 989.08,
   "end": 991.28,
   "text": "אז הוא היה ככה דוי, כל פעם, כל שבוע כשהוא היה יוצא,"
  },
  {
   "start": 991.76,
   "end": 996.46,
   "text": "היה מרבדים של שטיחים שהעניים היו רצים, לוקחים אותם ומוכרים אותם."
  },
  {
   "start": 996.52,
   "end": 997.24,
   "text": "וככה מתפרנסים."
  },
  {
   "start": 999.04,
   "end": 1000.32,
   "text": "ואותם שלושה עשירים,"
  },
  {
   "start": 1001.72,
   "end": 1004.44,
   "text": "נקדימון, כלבא סבוע ובן ציצית הכסת,"
  },
  {
   "start": 1005.4,
   "end": 1008.94,
   "text": "התנדבו להזון את תושבי ירושלים בזמן המצור,"
  },
  {
   "start": 1009.52,
   "end": 1015.26,
   "text": "בדגן, ביין, בשמן, במלח, בעצים לבישול והסקה."
  },
  {
   "start": 1016.8,
   "end": 1017.84,
   "text": "אומרת הגמרא,"
  },
  {
   "start": 1019.5,
   "end": 1020.46,
   "text": "אומרת הגמרא,"
  },
  {
   "start": 1021.08,
   "end": 1023.82,
   "text": "הם יכלו לזון את ירושלים במצור,"
  },
  {
   "start": 1024.36,
   "end": 1030.32,
   "text": "לתת אוכל לעם ישראל בירושלים שמה למשך עשרים ואחד שנה."
  },
  {
   "start": 1032.38,
   "end": 1036.56,
   "text": "עשרים ואחד שנה יכלו עם ישראל לשבת במצור ולאכול ולחיות טוב."
  },
  {
   "start": 1047.7,
   "end": 1048.44,
   "text": "מה קרה אז?"
  }
 ]
}