{
 "disc": "20ל- רבי עקיבא",
 "track": "Track01",
 "duration": 1179.192,
 "segments": [
  {
   "start": 4.0,
   "end": 4.72,
   "text": "אי שם,"
  },
  {
   "start": 5.98,
   "end": 7.5,
   "text": "בין ההרים והגבעות,"
  },
  {
   "start": 9.92,
   "end": 11.08,
   "text": "שם הוא היה רועה את צאנו."
  },
  {
   "start": 12.34,
   "end": 13.68,
   "text": "שם הוא היה מנהיג אותם ברוך."
  },
  {
   "start": 22.0,
   "end": 25.4,
   "text": "שם הוא היה מוביל אותם באהבה וחוכמה מיוחדת."
  },
  {
   "start": 32.61,
   "end": 33.67,
   "text": "הוא היה כל כך מרוכז"
  },
  {
   "start": 35.75,
   "end": 36.65,
   "text": "בעדר שלו,"
  },
  {
   "start": 37.63,
   "end": 42.21,
   "text": "עד לכך שהוא לא שם לב לזוג עיניים שעקבו אחריו."
  },
  {
   "start": 46.34,
   "end": 49.44,
   "text": "היא עקבה אחריו בעיניה מזה תקופה ארוכה."
  },
  {
   "start": 50.86,
   "end": 52.16,
   "text": "מתבוננת בהליכותיו,"
  },
  {
   "start": 54.64,
   "end": 57.92,
   "text": "לא יכולה לעצור את התחושה שמשהו מיוחד,"
  },
  {
   "start": 58.56,
   "end": 59.8,
   "text": "משהו שאי אפשר להשיג אותו,"
  },
  {
   "start": 62.48,
   "end": 63.12,
   "text": "טמון בו,"
  },
  {
   "start": 64.22,
   "end": 65.32,
   "text": "ברואה איזה הפשוט."
  },
  {
   "start": 68.02,
   "end": 70.72,
   "text": "זה שאולי אינו יודע כרוך טוב,"
  },
  {
   "start": 74.9,
   "end": 77.48,
   "text": "שאולי כלפי חוץ נראה קצת גס,"
  },
  {
   "start": 78.52,
   "end": 79.24,
   "text": "אבל בפנים,"
  },
  {
   "start": 80.3,
   "end": 83.56,
   "text": "בפנים מתנוצץ לו אור פנימי."
  },
  {
   "start": 85.42,
   "end": 86.1,
   "text": "אבל מי יאמין לה?"
  },
  {
   "start": 86.92,
   "end": 87.52,
   "text": "לתחושות שלה."
  },
  {
   "start": 89.22,
   "end": 89.98,
   "text": "מי יאמין לה?"
  },
  {
   "start": 91.34,
   "end": 97.85,
   "text": "לאותה אישה מיוחדת. מי יאמין לרחל, הבת של כלבה סבוע,"
  },
  {
   "start": 98.97,
   "end": 105.3,
   "text": "העשיר המפורסם של אותה תקופה."
  },
  {
   "start": 108.08,
   "end": 110.62,
   "text": "השידוך המבוקש ביותר בארץ ישראל"
  },
  {
   "start": 112.02,
   "end": 113.1,
   "text": "נושא את עיניה"
  },
  {
   "start": 113.78,
   "end": 117.82,
   "text": "דווקא לרוע עני עקיבא שמו."
  },
  {
   "start": 119.74,
   "end": 120.4,
   "text": "בן גרים,"
  },
  {
   "start": 121.84,
   "end": 123.28,
   "text": "שלא פעם נשמע,"
  },
  {
   "start": 126.38,
   "end": 128.68,
   "text": "לא פעם נשמעה דעתו על תלמידי חכמים."
  },
  {
   "start": 130.32,
   "end": 130.8,
   "text": "הוא היה אומר,"
  },
  {
   "start": 132.82,
   "end": 136.72,
   "text": "הוא היה אומר, אם ייתנו לי, אני אתפוס תלמיד חכם."
  },
  {
   "start": 138.78,
   "end": 141.64,
   "text": "ואני אנשוך אותו נשיכה,"
  },
  {
   "start": 142.28,
   "end": 143.38,
   "text": "נשיכה של חמור."
  },
  {
   "start": 145.26,
   "end": 146.92,
   "text": "עד ככה הוא לא אהב תלמידי חכמים."
  },
  {
   "start": 148.18,
   "end": 149.62,
   "text": "שאלו אותו, תגיד לי, עקיבא,"
  },
  {
   "start": 150.3,
   "end": 153.46,
   "text": "למה אתה אומר נשיכה של חמור? למה לא נשיכה של כלב? כלב לא מספיק."
  },
  {
   "start": 154.42,
   "end": 157.0,
   "text": "אמר להם רבי עקיבא, אני מכיר, אני מכיר את בעלי החיים."
  },
  {
   "start": 158.72,
   "end": 159.84,
   "text": "נשיכה של חמור"
  },
  {
   "start": 160.38,
   "end": 163.42,
   "text": "המיוחד בה שהיא מרסקת עצמות."
  },
  {
   "start": 164.08,
   "end": 166.86,
   "text": "עד ככה אני רוצה פשוט לרסק את העצמות."
  },
  {
   "start": 174.36,
   "end": 179.58,
   "text": "כך שם בין ההרים והגבעות נושאת רחל תפילה לשם."
  },
  {
   "start": 181.02,
   "end": 182.06,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 182.74,
   "end": 184.06,
   "text": "אם אכן אני מטיבה לראות,"
  },
  {
   "start": 184.96,
   "end": 186.56,
   "text": "אם באמת זה הזיווג שלי,"
  },
  {
   "start": 187.56,
   "end": 196.7,
   "text": "אם מאחורי הרים של בורות מסתתרת לה נשמה מופלאה של יהודי קדוש,"
  },
  {
   "start": 197.52,
   "end": 197.82,
   "text": "בעולם,"
  },
  {
   "start": 198.68,
   "end": 199.72,
   "text": "ריבונו של העולם,"
  },
  {
   "start": 200.36,
   "end": 203.48,
   "text": "תעזור לנו לבנות בית של קדושה, בית של טהרה."
  },
  {
   "start": 209.56,
   "end": 211.2,
   "text": "והיא הולכת נחושה בדעתה."
  },
  {
   "start": 215.41,
   "end": 219.29,
   "text": "היא הולכת וקושרת את גורלה ביהודי פשוט."
  },
  {
   "start": 221.03,
   "end": 227.18,
   "text": "עם הארץ מסכנת את כל העולם הזה שלה ואולי את העולם הבא"
  },
  {
   "start": 228.06,
   "end": 230.12,
   "text": "עבור האמונה הפנימית."
  },
  {
   "start": 238.87,
   "end": 242.09,
   "text": "כשנודע שהם התחתנו, המשפחה פשוט נידתה אותה."
  },
  {
   "start": 243.19,
   "end": 243.93,
   "text": "החברות שלה"
  },
  {
   "start": 244.51,
   "end": 246.25,
   "text": "התרחקו בשאט נפש."
  },
  {
   "start": 247.87,
   "end": 250.69,
   "text": "לעזוב, לעזוב כסף, לעזוב מעמד"
  },
  {
   "start": 251.35,
   "end": 253.41,
   "text": "בשביל עם הארץ שנראה לה שהוא משהו מיוחד."
  },
  {
   "start": 254.75,
   "end": 257.01,
   "text": "לעזוב בשביל רועי צאן."
  },
  {
   "start": 262.1,
   "end": 265.3,
   "text": "אבל כל התגובות,"
  },
  {
   "start": 267.38,
   "end": 268.78,
   "text": "כל התגובות בחוץ,"
  },
  {
   "start": 269.46,
   "end": 270.88,
   "text": "כל הקרירות בחוץ,"
  },
  {
   "start": 275.67,
   "end": 277.59,
   "text": "סימני העוני, הקשיים,"
  },
  {
   "start": 278.85,
   "end": 281.47,
   "text": "הגיעו, הגיעו אליהם, אל אותו זוג,"
  },
  {
   "start": 281.87,
   "end": 282.75,
   "text": "אל אותו זוג צעיר."
  },
  {
   "start": 284.05,
   "end": 286.73,
   "text": "אבל כולם, כל הקשיים, הכל הכל,"
  },
  {
   "start": 287.25,
   "end": 289.95,
   "text": "פשוט נבלם לו בדלת של הצריף."
  },
  {
   "start": 291.29,
   "end": 292.33,
   "text": "בצריף שלהם,"
  },
  {
   "start": 293.15,
   "end": 294.09,
   "text": "שם בתוך הצריף,"
  },
  {
   "start": 295.03,
   "end": 298.61,
   "text": "על מצעי קש ישבו עקיבא ורחל,"
  },
  {
   "start": 299.25,
   "end": 302.49,
   "text": "שקועים בעולם שלהם, עולם רוחני,"
  },
  {
   "start": 304.68,
   "end": 305.72,
   "text": "עולם של אושר,"
  },
  {
   "start": 306.4,
   "end": 311.62,
   "text": "עולם שבו רחל מעולם לא התלוננה בפני בעלה על מחסור,"
  },
  {
   "start": 311.76,
   "end": 315.5,
   "text": "למרות שכל חייה הייתה רגילה לאושם."
  },
  {
   "start": 316.68,
   "end": 319.02,
   "text": "עולם שבו עקיבא לא פוצה את פיו."
  },
  {
   "start": 321.56,
   "end": 326.06,
   "text": "את אותו פה שגדל בין עמי הארצות,"
  },
  {
   "start": 326.66,
   "end": 329.42,
   "text": "את אותו פה שגדל אולי שם במרעה,"
  },
  {
   "start": 330.12,
   "end": 330.5,
   "text": "אותו פה"
  },
  {
   "start": 332.08,
   "end": 334.16,
   "text": "יותר רק להוציא מילות של עידוד,"
  },
  {
   "start": 334.76,
   "end": 335.78,
   "text": "מילות של כבוד,"
  },
  {
   "start": 336.76,
   "end": 337.56,
   "text": "מילות של אכפתיות"
  },
  {
   "start": 338.7,
   "end": 339.44,
   "text": "לרעייתו."
  },
  {
   "start": 343.34,
   "end": 345.42,
   "text": "והוא מביט בה בהערצה גדולה ואומר לה,"
  },
  {
   "start": 346.74,
   "end": 347.6,
   "text": "אומר לה עקיבא,"
  },
  {
   "start": 348.3,
   "end": 350.0,
   "text": "רחל, רחל רעייתי,"
  },
  {
   "start": 351.02,
   "end": 351.92,
   "text": "אני רואה את הסבל."
  },
  {
   "start": 353.14,
   "end": 354.26,
   "text": "תדעי לך, לו יכולתי,"
  },
  {
   "start": 355.22,
   "end": 357.38,
   "text": "הייתי מביא לך ירושלים של זהב."
  },
  {
   "start": 358.08,
   "end": 362.42,
   "text": "הייתי מביא לך תכשיט של ירושלים של זהב."
  },
  {
   "start": 362.78,
   "end": 365.88,
   "text": "כי כל ירושלים מגיעה לך."
  },
  {
   "start": 366.84,
   "end": 368.16,
   "text": "כי את בקדושה שלך,"
  },
  {
   "start": 368.7,
   "end": 372.98,
   "text": "פיירת שמיים שלך יכולה להוריד לנו את בית המקדש."
  },
  {
   "start": 373.78,
   "end": 381.12,
   "text": "אם יום אחד תהיה לי אפשרות אני אביא לך את כל ירושלים על זהב."
  },
  {
   "start": 392.48,
   "end": 392.9,
   "text": "והיא,"
  },
  {
   "start": 394.48,
   "end": 395.34,
   "text": "היא מתבוננת בו,"
  },
  {
   "start": 396.1,
   "end": 397.34,
   "text": "היא רואה את הדמעות,"
  },
  {
   "start": 398.02,
   "end": 400.56,
   "text": "היא רואה את הדמעות שניקבות בעיניו,"
  },
  {
   "start": 401.24,
   "end": 401.74,
   "text": "ויודעת,"
  },
  {
   "start": 402.7,
   "end": 403.76,
   "text": "יודעת שהוא לא מגזים."
  },
  {
   "start": 404.48,
   "end": 405.06,
   "text": "אם היה יכול,"
  },
  {
   "start": 405.9,
   "end": 407.32,
   "text": "אם היה יכול היה מביא לה."
  },
  {
   "start": 407.94,
   "end": 414.61,
   "text": "ירושלים של זהב, בשמיים,"
  },
  {
   "start": 416.89,
   "end": 418.85,
   "text": "גבוה גבוה מעליהם, בשמיים."
  },
  {
   "start": 419.57,
   "end": 423.25,
   "text": "נרעשו להם פמלייה של מעלה, מגודל,"
  },
  {
   "start": 423.81,
   "end": 424.57,
   "text": "גודל האחדות."
  },
  {
   "start": 426.41,
   "end": 428.55,
   "text": "בן הזוג הנפלא עקיבא ורחל."
  },
  {
   "start": 430.67,
   "end": 433.01,
   "text": "למחרת בצריף דפיקות."
  },
  {
   "start": 435.03,
   "end": 435.49,
   "text": "על הדלת הרעועה,"
  },
  {
   "start": 436.73,
   "end": 437.95,
   "text": "בפתח עומד יהודי."
  },
  {
   "start": 438.91,
   "end": 440.41,
   "text": "יהודי שמבקש,"
  },
  {
   "start": 441.11,
   "end": 442.87,
   "text": "יש לכם אולי קצת תבן להביא לי?"
  },
  {
   "start": 443.77,
   "end": 444.53,
   "text": "אשתי ילדה,"
  },
  {
   "start": 445.43,
   "end": 446.11,
   "text": "ואין לנו איך,"
  },
  {
   "start": 447.03,
   "end": 448.69,
   "text": "אין לנו היכן להניח את התינוק."
  },
  {
   "start": 450.03,
   "end": 454.99,
   "text": "אז קצת תבן אם יש לכם כדי שנוכל להניח את התינוק על המצע של התבן."
  },
  {
   "start": 457.35,
   "end": 461.79,
   "text": "הם רצו נרגשים אל מצוות החסד שנזדמנה להם, ונתנו לו ישר קצת תבן."
  },
  {
   "start": 464.4,
   "end": 465.5,
   "text": "וכשהדלת נסגרה,"
  },
  {
   "start": 466.52,
   "end": 472.68,
   "text": "הם התחילו למלמל דברי תודה לשם יתברך. ועקיבא אמר כמה תודה חייבים לקדוש ברוך הוא."
  },
  {
   "start": 472.68,
   "end": 476.92,
   "text": "תראי רחל, יש כאלו שאין להם אפילו תבן"
  },
  {
   "start": 477.52,
   "end": 478.96,
   "text": "ולנו יש תבן"
  },
  {
   "start": 479.68,
   "end": 483.3,
   "text": "ושניהם החלו לשיר, שיר ההודיה לה' יתברך"
  },
  {
   "start": 484.02,
   "end": 488.22,
   "text": "והצריף מתמלא לו באור ובשמחה אין קץ."
  },
  {
   "start": 499.38,
   "end": 500.24,
   "text": "איש מהם,"
  },
  {
   "start": 500.7,
   "end": 505.74,
   "text": "איש מהם לא ידע שהיהודי היה אליהו הנביא שבא לחזק אותם."
  },
  {
   "start": 517.12,
   "end": 518.16,
   "text": "במשך אלפי שנים,"
  },
  {
   "start": 519.74,
   "end": 522.18,
   "text": "במשך אלפי שנים טפטפו להם המים"
  },
  {
   "start": 522.78,
   "end": 523.58,
   "text": "מההר"
  },
  {
   "start": 524.28,
   "end": 525.9,
   "text": "אל הסלע שבתחתית ההר."
  },
  {
   "start": 527.3,
   "end": 530.62,
   "text": "מראה שכיח שהתמזג לו היטב בנוף ההררי."
  },
  {
   "start": 531.76,
   "end": 533.8,
   "text": "היה זה כל כך מוזר לראות את הבחור עומד,"
  },
  {
   "start": 536.22,
   "end": 537.82,
   "text": "עומד כמו מהופנט, מעובד,"
  },
  {
   "start": 538.76,
   "end": 547.02,
   "text": "ולוטש את עיניו לסלע ולטיפות המים המתנפצות על הסלע."
  },
  {
   "start": 549.5,
   "end": 550.88,
   "text": "אבנים שחקו המים."
  },
  {
   "start": 551.6,
   "end": 553.02,
   "text": "אבנים שחקו המים."
  },
  {
   "start": 553.52,
   "end": 554.48,
   "text": "מלמל עקיבא."
  },
  {
   "start": 555.32,
   "end": 560.76,
   "text": "כשהוא מתבונן בסלע ובטיפות המתנפצות אליו בהתרגשות הולכת וגוברת."
  },
  {
   "start": 561.9,
   "end": 562.26,
   "text": "הוא הביט,"
  },
  {
   "start": 562.96,
   "end": 564.14,
   "text": "הביט בחור הקטן,"
  },
  {
   "start": 565.1,
   "end": 567.32,
   "text": "שיצרו המים בסלע המוצק,"
  },
  {
   "start": 568.4,
   "end": 572.6,
   "text": "שדומה שאי אפשר לפצח אותו, אי אפשר לחדור אליו."
  },
  {
   "start": 573.04,
   "end": 576.54,
   "text": "רבי עקיבא מסתכל ועיניו מתנוצצות להם בהתרגשות."
  },
  {
   "start": 577.26,
   "end": 577.7,
   "text": "הוא ידע,"
  },
  {
   "start": 578.96,
   "end": 580.56,
   "text": "הוא ידע את מה שאף אחד לא ידע."
  },
  {
   "start": 581.26,
   "end": 582.22,
   "text": "כשרעייתו,"
  },
  {
   "start": 582.68,
   "end": 583.98,
   "text": "כשרעייתו רחל,"
  },
  {
   "start": 585.08,
   "end": 588.08,
   "text": "רצתה להינשא לו, היא התנתה איתו תנאי."
  },
  {
   "start": 589.12,
   "end": 591.98,
   "text": "עקיבא, יש לך כוחות נפש עצומים."
  },
  {
   "start": 592.56,
   "end": 594.88,
   "text": "אם אתה מבטיח לי שתלמד תורה,"
  },
  {
   "start": 595.42,
   "end": 598.08,
   "text": "אם אתה מבטיח לי שתיקח את כל הכוחות שלך,"
  },
  {
   "start": 598.42,
   "end": 602.32,
   "text": "תגייס את כל העוצמות הפנימיות שלך ללימוד התורה,"
  },
  {
   "start": 602.78,
   "end": 605.38,
   "text": "תקדיש את חייך לתורה הקדושה,"
  },
  {
   "start": 605.72,
   "end": 606.72,
   "text": "לבורא עולם,"
  },
  {
   "start": 607.18,
   "end": 607.78,
   "text": "אני אנשא לך."
  },
  {
   "start": 609.06,
   "end": 609.64,
   "text": "והוא הסכים."
  },
  {
   "start": 610.72,
   "end": 611.66,
   "text": "בהתחלה זה נראה קל,"
  },
  {
   "start": 612.8,
   "end": 612.92,
   "text": "אבל"
  },
  {
   "start": 616.08,
   "end": 620.94,
   "text": "הוא גילה שלעשות את הצעד הזה זה כל כך קשה."
  },
  {
   "start": 622.76,
   "end": 624.1,
   "text": "אני כבר בן 40!"
  },
  {
   "start": 625.72,
   "end": 627.12,
   "text": "אני כבר בן 40!"
  },
  {
   "start": 628.74,
   "end": 635.98,
   "text": "ועדיין איני יודע ולו מילה אחת איך אני אתחיל עכשיו ללמוד."
  },
  {
   "start": 638.51,
   "end": 638.83,
   "text": "וכך הוא"
  },
  {
   "start": 640.19,
   "end": 641.01,
   "text": "חשב לו בשקט,"
  },
  {
   "start": 644.89,
   "end": 649.61,
   "text": "כשהוא יודע שמבטה המצפה של רעייתו"
  },
  {
   "start": 650.47,
   "end": 653.47,
   "text": "שמצפה בדממה, שמצפה בהבנה,"
  },
  {
   "start": 656.18,
   "end": 656.86,
   "text": "מלווה אותו."
  },
  {
   "start": 657.72,
   "end": 658.22,
   "text": "אבל עכשיו,"
  },
  {
   "start": 658.94,
   "end": 660.08,
   "text": "עכשיו כשעקיבא עמד"
  },
  {
   "start": 660.64,
   "end": 664.06,
   "text": "מול הסלע הזה, מול המראה המופלא של סלע,"
  },
  {
   "start": 664.68,
   "end": 670.06,
   "text": "שהמים חצבו בו במשך שנים,"
  },
  {
   "start": 671.78,
   "end": 675.44,
   "text": "עד שיצרו באותו סלע שנדמה שאי אפשר לחצוב בו"
  },
  {
   "start": 676.42,
   "end": 677.18,
   "text": "חור של ממש."
  },
  {
   "start": 679.14,
   "end": 679.82,
   "text": "עקיבא הרהר,"
  },
  {
   "start": 680.36,
   "end": 684.58,
   "text": "הטיפות האלו במשך שנים יצרו להם חור בסלע הקשה."
  },
  {
   "start": 688.24,
   "end": 692.26,
   "text": "אבל בסך הכל, כל פעם נופלת טיפה אחת בסך הכל."
  },
  {
   "start": 692.72,
   "end": 695.42,
   "text": "ואחרי עוד קצת זמן, עוד טיפה."
  },
  {
   "start": 696.22,
   "end": 697.54,
   "text": "ואחרי זה, עוד טיפה."
  },
  {
   "start": 698.78,
   "end": 699.18,
   "text": "כלומר,"
  },
  {
   "start": 700.42,
   "end": 705.0,
   "text": "כל טיפה בפני עצמה עשתה חור דקיק."
  },
  {
   "start": 705.92,
   "end": 708.54,
   "text": "חור מיקרוסקופי, אבל עשתה חור."
  },
  {
   "start": 709.22,
   "end": 712.32,
   "text": "וגם השנייה, וגם השלישית, ועוד טיפה."
  },
  {
   "start": 712.38,
   "end": 713.06,
   "text": "ועוד טיפה."
  },
  {
   "start": 713.92,
   "end": 715.36,
   "text": "אחרי מאות שנים,"
  },
  {
   "start": 716.32,
   "end": 719.3,
   "text": "אחרי מאות שנים נוצר חור גדול בסלע."
  },
  {
   "start": 720.72,
   "end": 729.46,
   "text": "כלומר, אפילו שאתה לא רואה, אפילו שאני לא רואה, כל טיפה עושה רושם בסלע."
  },
  {
   "start": 730.56,
   "end": 735.26,
   "text": "כל טיפה חודרת וחוצבת בסלע, גם בסלע הקשה."
  },
  {
   "start": 736.98,
   "end": 738.94,
   "text": "בסלע האטום הזה בתחילה אולי לא רואים,"
  },
  {
   "start": 739.32,
   "end": 740.62,
   "text": "בתחילה גם לא מרגישים,"
  },
  {
   "start": 741.22,
   "end": 741.76,
   "text": "אבל עם סבלנות,"
  },
  {
   "start": 742.66,
   "end": 744.18,
   "text": "לאט-לאט, בסוף"
  },
  {
   "start": 744.82,
   "end": 745.82,
   "text": "גם הסלע נשבע."
  },
  {
   "start": 748.48,
   "end": 748.68,
   "text": "ואז,"
  },
  {
   "start": 749.86,
   "end": 751.04,
   "text": "כמעין מכת ברק,"
  },
  {
   "start": 752.18,
   "end": 753.66,
   "text": "עלמה הידיעה בעקיבא."
  },
  {
   "start": 754.68,
   "end": 755.8,
   "text": "אם כך בסלע,"
  },
  {
   "start": 757.04,
   "end": 757.54,
   "text": "אני לא."
  },
  {
   "start": 758.6,
   "end": 763.6,
   "text": "אם ככה סלע, אחרי שנים, אבל כל טיפה עשתה משהו,"
  },
  {
   "start": 764.88,
   "end": 765.18,
   "text": "אני."
  },
  {
   "start": 766.2,
   "end": 769.16,
   "text": "כל טיפה שאני אקבל, היא לא תעשה משהו?"
  },
  {
   "start": 770.14,
   "end": 773.86,
   "text": "הרי רחל מתחתנת איתי ומאמינה בי שאני אלמד תורה."
  },
  {
   "start": 774.78,
   "end": 776.86,
   "text": "ואני ניסיתי ונכנסתי לבית המדרש,"
  },
  {
   "start": 777.32,
   "end": 778.64,
   "text": "אבל לא הבנתי כלום!"
  },
  {
   "start": 779.62,
   "end": 780.04,
   "text": "אז לא חזרתי."
  },
  {
   "start": 781.64,
   "end": 783.16,
   "text": "אבל עכשיו אני יודע."
  },
  {
   "start": 783.8,
   "end": 785.6,
   "text": "עכשיו אני רואה גם אם לא הבנתי,"
  },
  {
   "start": 786.48,
   "end": 789.16,
   "text": "גם אם נראה שכלום לא משתנה לי."
  },
  {
   "start": 790.12,
   "end": 792.24,
   "text": "כלום לא משתנה בי זו טעות."
  },
  {
   "start": 793.42,
   "end": 794.64,
   "text": "משהו כן משתנה."
  },
  {
   "start": 795.48,
   "end": 795.9,
   "text": "טיפה"
  },
  {
   "start": 796.56,
   "end": 798.62,
   "text": "ועוד טיפה ועוד טיפה."
  },
  {
   "start": 799.02,
   "end": 802.26,
   "text": "כמו המים בסלע, אבנים שחקו המים."
  },
  {
   "start": 803.76,
   "end": 804.84,
   "text": "בהתחלה לא רואים,"
  },
  {
   "start": 806.06,
   "end": 807.22,
   "text": "בהתחלה לא מרגישים."
  },
  {
   "start": 808.74,
   "end": 809.32,
   "text": "אבל בסוף,"
  },
  {
   "start": 810.3,
   "end": 811.0,
   "text": "כמו הסלע,"
  },
  {
   "start": 812.04,
   "end": 812.62,
   "text": "גם אני יכול."
  },
  {
   "start": 814.16,
   "end": 816.04,
   "text": "את האבנים שחקו המים,"
  },
  {
   "start": 816.7,
   "end": 817.82,
   "text": "את עקיבא,"
  },
  {
   "start": 818.54,
   "end": 822.42,
   "text": "יכולה התורה לשנות, יכולה התורה לבנות,"
  },
  {
   "start": 823.42,
   "end": 824.72,
   "text": "בטיפה ועוד טיפה,"
  },
  {
   "start": 825.88,
   "end": 826.98,
   "text": "שתצטרף לה לדעיין."
  },
  {
   "start": 831.68,
   "end": 832.48,
   "text": "עקיבא חזרה ביתה,"
  },
  {
   "start": 833.38,
   "end": 834.2,
   "text": "כולו נרגש."
  },
  {
   "start": 836.37,
   "end": 838.93,
   "text": "מיד סיפר לרעייתו, לרחל, מה למד?"
  },
  {
   "start": 840.71,
   "end": 842.31,
   "text": "בעיניים בוערות משמחה,"
  },
  {
   "start": 843.69,
   "end": 844.47,
   "text": "אמרה רחל."
  },
  {
   "start": 845.91,
   "end": 846.53,
   "text": "אז מחר?"
  },
  {
   "start": 847.39,
   "end": 849.13,
   "text": "מחר תלך לבית המדרש ללמוד תורה?"
  },
  {
   "start": 851.51,
   "end": 852.11,
   "text": "ועקיבא,"
  },
  {
   "start": 853.31,
   "end": 855.41,
   "text": "לפתע נראה כאילו כל האוויר נסחק ממנו."
  },
  {
   "start": 856.31,
   "end": 857.01,
   "text": "אני מתבייש,"
  },
  {
   "start": 857.65,
   "end": 858.47,
   "text": "ילעגו עליי."
  },
  {
   "start": 859.09,
   "end": 861.65,
   "text": "אני בן ארבעים ועם הארץ."
  },
  {
   "start": 862.61,
   "end": 864.55,
   "text": "אני בן ארבעים ולא יודע כלום!"
  },
  {
   "start": 868.15,
   "end": 870.19,
   "text": "חכמות דשים בנתה פתא."
  },
  {
   "start": 870.83,
   "end": 871.21,
   "text": "רחל,"
  },
  {
   "start": 871.89,
   "end": 873.37,
   "text": "רחל זו הצנועה, זו הצדקת,"
  },
  {
   "start": 874.23,
   "end": 877.25,
   "text": "שוויתרה על כל העולם למען התורה."
  },
  {
   "start": 879.43,
   "end": 880.47,
   "text": "רחל החכמה,"
  },
  {
   "start": 881.17,
   "end": 882.67,
   "text": "האישה המיוחדת הזאת,"
  },
  {
   "start": 885.96,
   "end": 886.36,
   "text": "אמרה לו,"
  },
  {
   "start": 887.02,
   "end": 887.98,
   "text": "עקיבא אישי היקר,"
  },
  {
   "start": 888.96,
   "end": 889.94,
   "text": "אתה מוכן לעשות"
  },
  {
   "start": 890.54,
   "end": 891.14,
   "text": "עבורי משהו?"
  },
  {
   "start": 894.25,
   "end": 894.97,
   "text": "ענה עקיבא כן,"
  },
  {
   "start": 895.95,
   "end": 896.99,
   "text": "כן ראייתי הכל,"
  },
  {
   "start": 897.95,
   "end": 898.15,
   "text": "מה שתרצי."
  },
  {
   "start": 900.69,
   "end": 901.31,
   "text": "אמר לו עקיבא,"
  },
  {
   "start": 901.97,
   "end": 903.75,
   "text": "תעשה מה שאני אומרת ואל תשאל שאלות."
  },
  {
   "start": 905.25,
   "end": 905.73,
   "text": "יש חמור."
  },
  {
   "start": 908.0,
   "end": 908.52,
   "text": "יש חמור."
  },
  {
   "start": 909.5,
   "end": 911.0,
   "text": "החמור יש לו גב עקום."
  },
  {
   "start": 911.9,
   "end": 912.82,
   "text": "לנו אין פרנסה."
  },
  {
   "start": 913.52,
   "end": 916.72,
   "text": "אני רוצה שתמלא את הגב שלו."
  },
  {
   "start": 917.68,
   "end": 919.02,
   "text": "בבוץ, בחול,"
  },
  {
   "start": 919.66,
   "end": 922.76,
   "text": "נשים בגב שלו פרח וננסה למכור אותו בשוק."
  },
  {
   "start": 923.66,
   "end": 926.04,
   "text": "עקיבא רצה לאמר משהו, אבל היא אמרה לו,"
  },
  {
   "start": 926.66,
   "end": 928.0,
   "text": "הבטחת לי, אל תשאל."
  },
  {
   "start": 928.0,
   "end": 931.9,
   "text": "עקיבא לא רצה לאכזב אותה."
  },
  {
   "start": 933.24,
   "end": 934.28,
   "text": "הוא ידע שאולי ילעגו לו,"
  },
  {
   "start": 935.32,
   "end": 937.34,
   "text": "אבל הכל למען רחלי,"
  },
  {
   "start": 938.42,
   "end": 938.88,
   "text": "לכן הוא הסכים."
  },
  {
   "start": 940.46,
   "end": 941.96,
   "text": "אף שזה נראה לו כל כך מוזר,"
  },
  {
   "start": 943.06,
   "end": 944.0,
   "text": "כל כך לא הגיוני,"
  },
  {
   "start": 946.53,
   "end": 958.32,
   "text": "וכך עקיבא נוסע אל השוק עם חמור שבגבו מתנוסס לו עציץ,"
  },
  {
   "start": 961.1,
   "end": 962.12,
   "text": "צומח לו פרח"
  },
  {
   "start": 963.14,
   "end": 963.88,
   "text": "בגב החמור."
  },
  {
   "start": 965.95,
   "end": 967.65,
   "text": "עקיבא היה האטרקציה של השוק."
  },
  {
   "start": 970.86,
   "end": 973.86,
   "text": "עוברים ושבים נעצרו לחזות במחזה המגוחך."
  },
  {
   "start": 976.42,
   "end": 977.3,
   "text": "קולות של לעג"
  },
  {
   "start": 978.64,
   "end": 980.24,
   "text": "התחלפו להם עם פרצי צחוק,"
  },
  {
   "start": 981.32,
   "end": 982.28,
   "text": "עם עוויות גיחוך."
  },
  {
   "start": 984.16,
   "end": 986.24,
   "text": "אלו התגובות להם זכה עקיבא באותו יום בשוק."
  },
  {
   "start": 988.24,
   "end": 988.46,
   "text": "פעם,"
  },
  {
   "start": 989.3,
   "end": 990.86,
   "text": "פעם הוא לא היה עובר על כך בשתיקה אולי,"
  },
  {
   "start": 991.84,
   "end": 992.36,
   "text": "אבל עכשיו,"
  },
  {
   "start": 992.98,
   "end": 995.58,
   "text": "למען רעייתו שהקריבה כל כך הרבה למענו,"
  },
  {
   "start": 997.28,
   "end": 1000.82,
   "text": "עקיבא כלה את הר הגעש שאיים להתפוצץ בקרבו."
  },
  {
   "start": 1001.7,
   "end": 1003.12,
   "text": "הוא חייב לעבוד על מידותיו."
  },
  {
   "start": 1004.3,
   "end": 1004.82,
   "text": "למוחרת,"
  },
  {
   "start": 1005.88,
   "end": 1006.16,
   "text": "שוב,"
  },
  {
   "start": 1006.72,
   "end": 1007.46,
   "text": "שוב הוא עומד בשוק."
  },
  {
   "start": 1008.74,
   "end": 1010.16,
   "text": "וכך במשך שבוע,"
  },
  {
   "start": 1011.38,
   "end": 1012.62,
   "text": "ואחר כך עוד שבוע."
  },
  {
   "start": 1014.76,
   "end": 1016.78,
   "text": "אחרי השבוע השני כשחזר הביתה אל רחל,"
  },
  {
   "start": 1017.92,
   "end": 1019.18,
   "text": "קידמה היא לפתע את פניו."
  },
  {
   "start": 1019.94,
   "end": 1021.96,
   "text": "נו, אישי היקר, איך היה היום בשוק?"
  },
  {
   "start": 1022.38,
   "end": 1023.16,
   "text": "צחקו עליך?"
  },
  {
   "start": 1024.76,
   "end": 1025.54,
   "text": "לא, לא רעייתי."
  },
  {
   "start": 1026.24,
   "end": 1029.38,
   "text": "אין כבר מה לצחוק, כולם התרגלו אליי. נהייתי נוף קבוע בשוק."
  },
  {
   "start": 1030.14,
   "end": 1031.46,
   "text": "כולם התרגלו אליי."
  },
  {
   "start": 1035.57,
   "end": 1036.17,
   "text": "חייכה,"
  },
  {
   "start": 1036.89,
   "end": 1037.35,
   "text": "רחל,"
  },
  {
   "start": 1038.71,
   "end": 1039.59,
   "text": "עקיבא אישי היקר,"
  },
  {
   "start": 1040.23,
   "end": 1041.15,
   "text": "שמעת מה שאתה אומר?"
  },
  {
   "start": 1042.31,
   "end": 1043.03,
   "text": "התרגלו אליך."
  },
  {
   "start": 1044.95,
   "end": 1045.95,
   "text": "בסוף מתרגלים."
  },
  {
   "start": 1047.33,
   "end": 1048.69,
   "text": "אישי האהוב והחשוב,"
  },
  {
   "start": 1049.57,
   "end": 1050.79,
   "text": "לך ללמוד תורה."
  },
  {
   "start": 1051.63,
   "end": 1052.93,
   "text": "בהתחלה יצחקו עליך."
  },
  {
   "start": 1054.81,
   "end": 1056.09,
   "text": "בהתחלה ילעגול."
  },
  {
   "start": 1057.61,
   "end": 1059.27,
   "text": "אבל בסוף התרגלו."
  },
  {
   "start": 1062.32,
   "end": 1068.88,
   "text": "בהתחלה לועגים, צוחקים, אבל בסוף מתרגלים, לך ללמוד תורה."
  },
  {
   "start": 1069.54,
   "end": 1071.22,
   "text": "לך ללמוד תורה."
  },
  {
   "start": 1078.21,
   "end": 1081.97,
   "text": "המילים שיצאו מלב טהור של רחל"
  },
  {
   "start": 1084.28,
   "end": 1084.9,
   "text": "נכנסים"
  },
  {
   "start": 1086.2,
   "end": 1087.08,
   "text": "לליבו של עקיבא."
  },
  {
   "start": 1088.48,
   "end": 1089.1,
   "text": "לך, עקיבא."
  },
  {
   "start": 1089.78,
   "end": 1090.44,
   "text": "לך אישי."
  },
  {
   "start": 1090.88,
   "end": 1092.54,
   "text": "אישי החשוב. לך אל עולם התורה."
  },
  {
   "start": 1093.14,
   "end": 1097.26,
   "text": "אל תיתן לה בושה לחסום את הנשמה שלך,"
  },
  {
   "start": 1097.9,
   "end": 1099.66,
   "text": "שכל כך שואפת לרוחניות,"
  },
  {
   "start": 1100.82,
   "end": 1101.28,
   "text": "לאמת,"
  },
  {
   "start": 1102.12,
   "end": 1103.38,
   "text": "שיצחקו כולם."
  },
  {
   "start": 1104.4,
   "end": 1105.16,
   "text": "בסוף הם יתרגלו."
  },
  {
   "start": 1112.29,
   "end": 1113.55,
   "text": "אני מוכנה להמתין לך."
  },
  {
   "start": 1114.59,
   "end": 1117.17,
   "text": "אני מוכנה להמתין לך שנים."
  },
  {
   "start": 1117.75,
   "end": 1121.25,
   "text": "ובלבד שיום אחד תבוא אליי כתלמיד חכם."
  },
  {
   "start": 1123.54,
   "end": 1128.92,
   "text": "לך עקיבא, קפוץ אלי עם התורה."
  },
  {
   "start": 1133.1,
   "end": 1138.8,
   "text": "עקיבא, עושה את צעדיו הראשונים לכיוון עולם התורה."
  },
  {
   "start": 1138.8,
   "end": 1145.42,
   "text": "כששיעור המוסר שהוא קיבל מרעייתו הנבונה מלווה אותו."
  },
  {
   "start": 1148.11,
   "end": 1150.67,
   "text": "עקיבא הולך אל בית המדרש,"
  },
  {
   "start": 1151.47,
   "end": 1157.91,
   "text": "שם מאחור הרחק מאחור נותרת לה אישה קטנה גדולה,"
  },
  {
   "start": 1158.87,
   "end": 1159.99,
   "text": "אישה ושמה רחל,"
  },
  {
   "start": 1161.03,
   "end": 1165.29,
   "text": "שלא מפסיקה לבכות ולהתפלל על האיש שלה,"
  },
  {
   "start": 1166.35,
   "end": 1167.17,
   "text": "שיגדל בתורה."
  }
 ]
}