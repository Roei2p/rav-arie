{
 "disc": "20ל- רבי עקיבא",
 "track": "Track04",
 "duration": 525.168,
 "segments": [
  {
   "start": 3.62,
   "end": 4.26,
   "text": "חלפו להם"
  },
  {
   "start": 5.0,
   "end": 6.22,
   "text": "עוד תריסר שנים,"
  },
  {
   "start": 7.58,
   "end": 8.34,
   "text": "קד שנים,"
  },
  {
   "start": 9.58,
   "end": 10.56,
   "text": "צדיק בא לעיר,"
  },
  {
   "start": 11.84,
   "end": 13.68,
   "text": "והשמועה פרסה לכנפיים,"
  },
  {
   "start": 15.06,
   "end": 16.76,
   "text": "והעיר כולה לבשה לחג."
  },
  {
   "start": 19.33,
   "end": 21.59,
   "text": "אל העיר עומדים להגיע כד,"
  },
  {
   "start": 23.05,
   "end": 26.33,
   "text": "עשרים וארבע אלף תלמידי חכמים קדושים,"
  },
  {
   "start": 27.51,
   "end": 28.31,
   "text": "כשבראשם"
  },
  {
   "start": 29.51,
   "end": 31.49,
   "text": "עומד מופת הדור והדרו,"
  },
  {
   "start": 32.75,
   "end": 34.41,
   "text": "והעיר כולה נרגשת."
  },
  {
   "start": 38.12,
   "end": 42.44,
   "text": "כולם יוצאים בהמוניהם החוצה לקבל את פני גדול הדור,"
  },
  {
   "start": 46.97,
   "end": 48.05,
   "text": "תנא הקדוש."
  },
  {
   "start": 49.09,
   "end": 50.51,
   "text": "גדול התנאים של אותה תקופה."
  },
  {
   "start": 54.14,
   "end": 54.7,
   "text": "במצריף קטן,"
  },
  {
   "start": 55.8,
   "end": 56.7,
   "text": "בפאתי העיר,"
  },
  {
   "start": 57.52,
   "end": 59.38,
   "text": "יוצאת לראשונה מזה זמן,"
  },
  {
   "start": 60.48,
   "end": 60.86,
   "text": "רחל."
  },
  {
   "start": 62.82,
   "end": 63.66,
   "text": "יוצאת גם היא,"
  },
  {
   "start": 64.42,
   "end": 67.34,
   "text": "גם היא רוצה לקבל את פני הרב הגאון והקדוש."
  },
  {
   "start": 71.5,
   "end": 72.76,
   "text": "בדרך כלל היא לא יצאה מהבית."
  },
  {
   "start": 74.88,
   "end": 76.26,
   "text": "היא לא הייתה מסתובבת בחוץ."
  },
  {
   "start": 77.64,
   "end": 78.0,
   "text": "מה קרה?"
  },
  {
   "start": 79.1,
   "end": 80.02,
   "text": "מה גרם לה לצאת?"
  },
  {
   "start": 81.66,
   "end": 83.26,
   "text": "השכנים לא יכולים להתאפק."
  },
  {
   "start": 85.83,
   "end": 86.21,
   "text": "העירו לה"
  },
  {
   "start": 86.85,
   "end": 88.59,
   "text": "על הלבוש הדל שלה והפשוט."
  },
  {
   "start": 91.23,
   "end": 91.83,
   "text": "לא ראוי."
  },
  {
   "start": 93.37,
   "end": 96.83,
   "text": "רחל לא ראוי לצאת ככה לקבל את פני גדול גדול בישראל."
  },
  {
   "start": 97.49,
   "end": 97.93,
   "text": "זה לא מכובד."
  },
  {
   "start": 99.15,
   "end": 100.23,
   "text": "אולי תישארי בבית."
  },
  {
   "start": 100.91,
   "end": 101.89,
   "text": "מה גרם לך לבוא?"
  },
  {
   "start": 104.06,
   "end": 104.72,
   "text": "ורחל,"
  },
  {
   "start": 105.5,
   "end": 109.12,
   "text": "היא מורידה את ראשה בצניעות אופיינית."
  },
  {
   "start": 113.76,
   "end": 114.34,
   "text": "גדול הדור."
  },
  {
   "start": 115.42,
   "end": 118.26,
   "text": "צדיק כל כך גדול, תלמיד חכם כל כך עצום,"
  },
  {
   "start": 119.14,
   "end": 120.8,
   "text": "כמו שכל העולם מדבר עליו,"
  },
  {
   "start": 122.14,
   "end": 123.86,
   "text": "בטח אינו מתעניין בחיצוניות."
  },
  {
   "start": 125.76,
   "end": 127.1,
   "text": "הוא מתעניין רק בפנימיות."
  },
  {
   "start": 128.66,
   "end": 130.3,
   "text": "ואתם יודעים למה יצאתי מהבית?"
  },
  {
   "start": 131.4,
   "end": 132.22,
   "text": "אני בסך הכל,"
  },
  {
   "start": 133.52,
   "end": 136.58,
   "text": "בסך הכל רוצה לשאול על הבעל שלי."
  },
  {
   "start": 140.48,
   "end": 142.42,
   "text": "שמעתי שם הם הישיבה"
  },
  {
   "start": 144.46,
   "end": 145.7,
   "text": "אליה הלך עקיבא."
  },
  {
   "start": 146.7,
   "end": 148.18,
   "text": "אולי הם מכירים אותו שם?"
  },
  {
   "start": 149.26,
   "end": 151.34,
   "text": "אולי הם יספרו לי שביב של מידע"
  },
  {
   "start": 152.54,
   "end": 153.92,
   "text": "לגבי העקיבא שלי?"
  },
  {
   "start": 155.6,
   "end": 157.86,
   "text": "אולי הוא כבר יודע ללמוד, אולי יתקדם קצת,"
  },
  {
   "start": 159.14,
   "end": 160.16,
   "text": "משהו לדעת עליו."
  },
  {
   "start": 161.7,
   "end": 162.3,
   "text": "כך היא אומרת,"
  },
  {
   "start": 164.48,
   "end": 166.46,
   "text": "ופוסעת לה בשקט,"
  },
  {
   "start": 167.6,
   "end": 168.48,
   "text": "שקט מלכותי."
  },
  {
   "start": 170.18,
   "end": 171.78,
   "text": "וכולם בעיר נאספים,"
  },
  {
   "start": 172.76,
   "end": 174.1,
   "text": "מנער ועד זקן,"
  },
  {
   "start": 175.02,
   "end": 176.0,
   "text": "נשים וטף."
  },
  {
   "start": 177.84,
   "end": 183.8,
   "text": "כולם לבושים בגדים חגיגיים לקבל את פני מלכות התורה."
  },
  {
   "start": 189.64,
   "end": 192.44,
   "text": "בין כולם בולטת לה דמות אחת,"
  },
  {
   "start": 194.08,
   "end": 194.44,
   "text": "שונה."
  },
  {
   "start": 196.79,
   "end": 198.63,
   "text": "שם בין כולם נמצאת לה אישה,"
  },
  {
   "start": 199.47,
   "end": 201.49,
   "text": "לבושה לבוש פשוט ובלוי."
  },
  {
   "start": 202.17,
   "end": 204.37,
   "text": "כולה זועקת עוני ודלות."
  },
  {
   "start": 205.29,
   "end": 214.26,
   "text": "אבל רק המעמיקים להתבונן יכולים לזהות את מבט הפנים הקורן,"
  },
  {
   "start": 215.08,
   "end": 217.36,
   "text": "את העיניים הזוהרות בברק מיוחד,"
  },
  {
   "start": 218.0,
   "end": 223.3,
   "text": "שמלמדות אולי יותר מכל על גודל הנשמה של אותה אישה,"
  },
  {
   "start": 224.2,
   "end": 225.18,
   "text": "של רחל."
  },
  {
   "start": 230.62,
   "end": 232.16,
   "text": "קהל הנאספים נדרך,"
  },
  {
   "start": 234.07,
   "end": 234.91,
   "text": "הם מגיעים,"
  },
  {
   "start": 237.29,
   "end": 242.07,
   "text": "ואט-אט נכנסת לתהלוכה של תלמידי חכמים מופלגים."
  },
  {
   "start": 244.94,
   "end": 245.82,
   "text": "ובמרכז,"
  },
  {
   "start": 246.76,
   "end": 247.98,
   "text": "מוקף בתלמידיו,"
  },
  {
   "start": 248.88,
   "end": 250.16,
   "text": "גדול הדור והדרו,"
  },
  {
   "start": 250.94,
   "end": 251.8,
   "text": "והוא מתקרב."
  },
  {
   "start": 252.64,
   "end": 255.06,
   "text": "וכשהוא מתקרב, כולם נדחקים לראות אותו."
  },
  {
   "start": 255.76,
   "end": 259.88,
   "text": "אולי נזכה לברכה, אולי נזכה לראות את זיו פניו."
  },
  {
   "start": 261.24,
   "end": 262.06,
   "text": "ובין כולם,"
  },
  {
   "start": 262.9,
   "end": 263.72,
   "text": "בין כולם,"
  },
  {
   "start": 264.2,
   "end": 266.7,
   "text": "מפלצת לה דמות העדינה של אישה,"
  },
  {
   "start": 267.3,
   "end": 268.1,
   "text": "רחל."
  },
  {
   "start": 269.18,
   "end": 272.2,
   "text": "היא בסך הכל רוצה לדעת"
  },
  {
   "start": 273.22,
   "end": 274.0,
   "text": "על עקיבא שלה,"
  },
  {
   "start": 274.84,
   "end": 275.44,
   "text": "על בעלה."
  },
  {
   "start": 275.96,
   "end": 298.28,
   "text": "אולי מכירים אותו, אולי יישמעו אודותיו עוד צעד או עוד מטר והיא כבר ממש קרובה."
  },
  {
   "start": 299.92,
   "end": 301.7,
   "text": "אבל אז המעגל האנושי סביבו נסגר."
  },
  {
   "start": 304.27,
   "end": 306.95,
   "text": "תלמידי ערב אינם מניחים לה להתקרב,"
  },
  {
   "start": 307.63,
   "end": 308.65,
   "text": "היא נדחפת אחורה"
  },
  {
   "start": 309.47,
   "end": 313.31,
   "text": "ודוק של דמעות מופיע לו בעיניה."
  },
  {
   "start": 321.19,
   "end": 321.83,
   "text": "אז מבין,"
  },
  {
   "start": 322.41,
   "end": 329.16,
   "text": "מבין כתפי האנשים שמקיפים את גדול הדור"
  },
  {
   "start": 330.26,
   "end": 335.08,
   "text": "מבין כל הקהל לפתע עורר אותה מולו."
  },
  {
   "start": 339.45,
   "end": 340.39,
   "text": "זו רעייתו,"
  },
  {
   "start": 341.31,
   "end": 346.67,
   "text": "זאת שמסרה את כל מה שיש לה למען התורה שלו."
  },
  {
   "start": 347.91,
   "end": 350.31,
   "text": "רבי עקיבא הוא גדול הדור,"
  },
  {
   "start": 352.73,
   "end": 354.47,
   "text": "גדול הדור של ממש,"
  },
  {
   "start": 355.99,
   "end": 358.97,
   "text": "רב ל-24,000 תלמידי חכמים,"
  },
  {
   "start": 360.59,
   "end": 361.51,
   "text": "טנא קדוש,"
  },
  {
   "start": 364.34,
   "end": 366.48,
   "text": "הוא מזהה את רחלו."
  },
  {
   "start": 368.86,
   "end": 372.92,
   "text": "ואז הוא קורא בקול נרגש,"
  },
  {
   "start": 374.56,
   "end": 375.8,
   "text": "תניחו לה,"
  },
  {
   "start": 376.4,
   "end": 377.84,
   "text": "תניחו לה לאישה הזו,"
  },
  {
   "start": 381.64,
   "end": 383.24,
   "text": "נסתררה לה דממה."
  },
  {
   "start": 389.1,
   "end": 390.46,
   "text": "אז הוא הרים את ידו הימנית"
  },
  {
   "start": 391.24,
   "end": 393.04,
   "text": "לכיוון האישה שניצבה מולו,"
  },
  {
   "start": 394.16,
   "end": 397.76,
   "text": "לכיוון האישה שניצבה מולו בראש מורכן וקרא בקול נרגש,"
  },
  {
   "start": 399.62,
   "end": 400.2,
   "text": "תניחו לה,"
  },
  {
   "start": 400.2,
   "end": 404.0,
   "text": "שלי ושלכם,"
  },
  {
   "start": 405.3,
   "end": 405.92,
   "text": "שלה."
  },
  {
   "start": 410.53,
   "end": 413.85,
   "text": "ואת השקט ניתן היה לחתוך בשקים."
  },
  {
   "start": 420.58,
   "end": 421.9,
   "text": "כל הקהל העצום,"
  },
  {
   "start": 423.32,
   "end": 425.3,
   "text": "גברים, נשים וטף, נשתתקו."
  },
  {
   "start": 427.06,
   "end": 429.62,
   "text": "כמדומה שאף בעלי החיים נדמו."
  },
  {
   "start": 430.42,
   "end": 433.94,
   "text": "כאילו חש העולם כולו שהוא צריך לעצור את"
  },
  {
   "start": 434.52,
   "end": 436.04,
   "text": "זרם החיים, את הכל בעבורם."
  },
  {
   "start": 439.1,
   "end": 441.36,
   "text": "שביל אנושי נוצר בין האנשים."
  },
  {
   "start": 442.76,
   "end": 444.18,
   "text": "בקצה האחד גדול הדור,"
  },
  {
   "start": 445.44,
   "end": 445.94,
   "text": "רבי עקיבא."
  },
  {
   "start": 447.5,
   "end": 448.42,
   "text": "בקצה השני,"
  },
  {
   "start": 449.22,
   "end": 449.58,
   "text": "אישה"
  },
  {
   "start": 450.56,
   "end": 451.74,
   "text": "לבושה בפשטות,"
  },
  {
   "start": 452.92,
   "end": 457.13,
   "text": "אבל עם אור בעיניים ועם אור התורה בלב."
  },
  {
   "start": 459.84,
   "end": 462.14,
   "text": "שלי ושלכם שלה."
  },
  {
   "start": 463.4,
   "end": 464.06,
   "text": "כל התורה,"
  },
  {
   "start": 465.04,
   "end": 466.06,
   "text": "כל החוכמה,"
  },
  {
   "start": 467.16,
   "end": 468.2,
   "text": "כל הקדושה"
  },
  {
   "start": 469.12,
   "end": 470.28,
   "text": "שלכם ושלי"
  },
  {
   "start": 471.02,
   "end": 471.54,
   "text": "זה שלה."
  },
  {
   "start": 472.6,
   "end": 474.32,
   "text": "של אותה אישה קטנה גדולה"
  },
  {
   "start": 482.78,
   "end": 483.68,
   "text": "והדמעות"
  },
  {
   "start": 484.92,
   "end": 486.58,
   "text": "פורצות מעימיה,"
  },
  {
   "start": 487.56,
   "end": 488.88,
   "text": "לא שיהיה לה שליטה עליהן."
  },
  {
   "start": 489.94,
   "end": 490.48,
   "text": "זה בעלה."
  },
  {
   "start": 491.8,
   "end": 495.84,
   "text": "עשרים וארבע שנות הקרבה הגיעו לסיומן."
  },
  {
   "start": 497.46,
   "end": 498.24,
   "text": "זה בעלה."
  },
  {
   "start": 499.38,
   "end": 500.38,
   "text": "התנא הקדוש,"
  },
  {
   "start": 501.54,
   "end": 502.38,
   "text": "זה בעלה."
  },
  {
   "start": 503.64,
   "end": 507.42,
   "text": "רבי עקיבא שלה, אבי התורה שבעל פה,"
  },
  {
   "start": 510.29,
   "end": 511.61,
   "text": "זה הבעל שלה."
  }
 ]
}