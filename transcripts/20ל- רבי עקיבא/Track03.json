{
 "disc": "20ל- רבי עקיבא",
 "track": "Track03",
 "duration": 751.152,
 "segments": [
  {
   "start": 5.82,
   "end": 6.38,
   "text": "ועקיבא,"
  },
  {
   "start": 8.5,
   "end": 10.2,
   "text": "עקיבא עושה את צעדיו הראשונים בישיבה."
  },
  {
   "start": 14.06,
   "end": 14.82,
   "text": "קושי אדיר."
  },
  {
   "start": 16.48,
   "end": 19.28,
   "text": "קושי אדיר שאי אפשר אולי לדמיין."
  },
  {
   "start": 20.62,
   "end": 21.5,
   "text": "מעם הארץ,"
  },
  {
   "start": 22.16,
   "end": 23.04,
   "text": "להתאמץ,"
  },
  {
   "start": 23.74,
   "end": 24.18,
   "text": "ללמוד."
  },
  {
   "start": 25.7,
   "end": 26.66,
   "text": "עד גיל 40,"
  },
  {
   "start": 27.52,
   "end": 30.56,
   "text": "אתה מספיק, את מספיקה לרכוש כבר מידות."
  },
  {
   "start": 33.07,
   "end": 35.01,
   "text": "יש כבר תוואי לנפש."
  },
  {
   "start": 35.81,
   "end": 37.51,
   "text": "יש כבר בנייה של אישיות."
  },
  {
   "start": 37.51,
   "end": 40.17,
   "text": "לשנות את הכל,"
  },
  {
   "start": 43.8,
   "end": 45.56,
   "text": "לעשות מהפך של ממש,"
  },
  {
   "start": 46.72,
   "end": 47.94,
   "text": "צריך נשמה מיוחדת."
  },
  {
   "start": 53.56,
   "end": 55.86,
   "text": "כלי הנשק שעמדו לרשותו של עקיבא היו"
  },
  {
   "start": 57.14,
   "end": 59.84,
   "text": "אמונה בשם יתברך, שהכל,"
  },
  {
   "start": 60.56,
   "end": 61.52,
   "text": "אבל הכל ממנו."
  },
  {
   "start": 65.6,
   "end": 66.56,
   "text": "עקרון המים,"
  },
  {
   "start": 67.6,
   "end": 68.32,
   "text": "אין ייאוש,"
  },
  {
   "start": 69.1,
   "end": 70.28,
   "text": "גם כשאין הצלחה,"
  },
  {
   "start": 70.86,
   "end": 71.88,
   "text": "גם כשאין הבנה,"
  },
  {
   "start": 72.44,
   "end": 76.26,
   "text": "כל טיפה וטיפה, כל פירור ופירור של תורה,"
  },
  {
   "start": 77.02,
   "end": 78.74,
   "text": "עושים את שלהם, צריך רק סבלנות."
  },
  {
   "start": 81.8,
   "end": 82.62,
   "text": "ושיעור,"
  },
  {
   "start": 83.56,
   "end": 85.06,
   "text": "שיעור המוסר של רחל"
  },
  {
   "start": 86.42,
   "end": 88.14,
   "text": "עם אותו חמור היא השתילה על הגב."
  },
  {
   "start": 88.76,
   "end": 92.22,
   "text": "לא מעניין מה יגידו, חשוב מה אומרים בשמיים."
  },
  {
   "start": 92.96,
   "end": 94.56,
   "text": "לא אכפת לי מה אומרים עליי פה,"
  },
  {
   "start": 94.94,
   "end": 96.62,
   "text": "אכפת לי מה אומרים עליי בשמיים."
  },
  {
   "start": 97.12,
   "end": 98.08,
   "text": "וכך הוא משתדל."
  },
  {
   "start": 98.58,
   "end": 99.8,
   "text": "הוא לומד משנה אחת."
  },
  {
   "start": 101.12,
   "end": 102.2,
   "text": "נו עקיבא, תתקדם."
  },
  {
   "start": 102.66,
   "end": 104.44,
   "text": "תמשיך, אתה צריך להספיק כל כך הרבה."
  },
  {
   "start": 104.98,
   "end": 106.06,
   "text": "אבל את עקיבא זה לא מעניין."
  },
  {
   "start": 106.06,
   "end": 112.02,
   "text": "הוא לא עוזב את המשנה עד שהוא יותר יודע אותה ישר והפוך,"
  },
  {
   "start": 112.64,
   "end": 114.94,
   "text": "לפני ולפנים, חוקר כל אות,"
  },
  {
   "start": 115.52,
   "end": 116.14,
   "text": "כל פסיק,"
  },
  {
   "start": 116.84,
   "end": 117.26,
   "text": "רק כשהוא"
  },
  {
   "start": 118.14,
   "end": 121.18,
   "text": "מבין אותה טוב-טוב, רק אז הוא מרשה לעצמו להתקדם."
  },
  {
   "start": 122.52,
   "end": 126.32,
   "text": "וכך, כך עובר עוד יום של קושי, עוד יום ועוד יום."
  },
  {
   "start": 126.9,
   "end": 127.88,
   "text": "צוחקים עליו אולי."
  },
  {
   "start": 129.78,
   "end": 130.78,
   "text": "לא תמיד זה נעים,"
  },
  {
   "start": 131.44,
   "end": 132.46,
   "text": "אבל הוא ממשיך הלאה."
  },
  {
   "start": 136.0,
   "end": 138.06,
   "text": "וזה קורה, הוא מתחיל להתקדם."
  },
  {
   "start": 139.2,
   "end": 140.22,
   "text": "יום רודף יום,"
  },
  {
   "start": 144.96,
   "end": 146.92,
   "text": "יום רודף יום, חודש רודף חודש."
  },
  {
   "start": 150.12,
   "end": 154.52,
   "text": "שם בישיבה יש אדם שהשאיר את הכל מאחוריו לכבוד השם יתברך."
  },
  {
   "start": 155.66,
   "end": 157.72,
   "text": "שם בישיבה ניצב לו עקיבא,"
  },
  {
   "start": 158.22,
   "end": 162.5,
   "text": "זה שלא ידע קרוא וכתוב ונלחם על חייו לכבוד השם יתברך."
  },
  {
   "start": 164.36,
   "end": 167.28,
   "text": "שם בישיבה צומח לו, ולא על גב של חמור,"
  },
  {
   "start": 167.94,
   "end": 174.3,
   "text": "פרח מרהיב בגן הנפלא של הקדוש ברוך הוא."
  },
  {
   "start": 174.7,
   "end": 175.38,
   "text": "הבדידות קשה,"
  },
  {
   "start": 176.86,
   "end": 179.12,
   "text": "הריחוק מהבית לא קל,"
  },
  {
   "start": 179.96,
   "end": 182.04,
   "text": "מאשתו העיקרן נותרו רק זיכרונות."
  },
  {
   "start": 183.3,
   "end": 185.44,
   "text": "עקיבא אבל כל-כולו שגוע בתורה,"
  },
  {
   "start": 186.0,
   "end": 189.42,
   "text": "בהתמדה נפלאה, כל הזמן, כל הזמן."
  },
  {
   "start": 189.8,
   "end": 194.26,
   "text": "כל רגע פנוי, לא תמצא אותו, לא תמצא אותו רגע אחד,"
  },
  {
   "start": 194.78,
   "end": 195.5,
   "text": "מבטל."
  },
  {
   "start": 196.42,
   "end": 200.08,
   "text": "הפה שלו לא מפסיק למלמל, זמרו למלכנו זמרו,"
  },
  {
   "start": 200.38,
   "end": 204.34,
   "text": "זמרו למלכנו זמרו, כל מקום שהולך יש שנייה של פנאי,"
  },
  {
   "start": 204.76,
   "end": 206.16,
   "text": "ממלמל פסוקים,"
  },
  {
   "start": 206.58,
   "end": 208.18,
   "text": "זמרו למלכנו זמהו,"
  },
  {
   "start": 208.52,
   "end": 210.08,
   "text": "זמרו למלכנו זמהו,"
  },
  {
   "start": 210.34,
   "end": 213.0,
   "text": "זמרו למלכנו זמהו כל הזמן."
  },
  {
   "start": 214.18,
   "end": 215.02,
   "text": "וכך הוא לומד,"
  },
  {
   "start": 215.54,
   "end": 218.3,
   "text": "בבחינת כל גליך ומשבריך על היעבר."
  },
  {
   "start": 219.32,
   "end": 220.1,
   "text": "כל מה שעובר,"
  },
  {
   "start": 221.18,
   "end": 225.32,
   "text": "עקיבא, כל קושי מתכופף,"
  },
  {
   "start": 225.64,
   "end": 227.6,
   "text": "נותן לקושי לעבור מעל פניו,"
  },
  {
   "start": 228.04,
   "end": 231.5,
   "text": "לעבור מעליו כל הזמן, כל הזמן."
  },
  {
   "start": 233.7,
   "end": 234.82,
   "text": "שם הרחק מהבית,"
  },
  {
   "start": 235.44,
   "end": 241.45,
   "text": "שם בישיבה עקיבא מוציא לאור את כל מה שגלום בו,"
  },
  {
   "start": 242.33,
   "end": 245.07,
   "text": "את כל מה שרעייתו ראתה בו."
  },
  {
   "start": 246.95,
   "end": 247.61,
   "text": "היא צדקה."
  },
  {
   "start": 248.41,
   "end": 249.19,
   "text": "היא צדקה."
  },
  {
   "start": 252.55,
   "end": 255.89,
   "text": "לימים כשישאלו את רבי עקיבא הגדול"
  },
  {
   "start": 256.95,
   "end": 258.03,
   "text": "איך שרדת?"
  },
  {
   "start": 258.79,
   "end": 260.99,
   "text": "איך הצלחת להחזיק מעמד?"
  },
  {
   "start": 263.09,
   "end": 268.69,
   "text": "יענה רבי עקיבא כל גל וגל שהיה בא נדנדתי לו בראשי."
  },
  {
   "start": 269.45,
   "end": 273.41,
   "text": "כל גל, כל קושי, נתתי לו לעבור מעליי."
  },
  {
   "start": 277.37,
   "end": 282.22,
   "text": "וכך הוא גדל עד שחולפות להם."
  },
  {
   "start": 292.04,
   "end": 292.56,
   "text": "בינתיים,"
  },
  {
   "start": 297.98,
   "end": 298.48,
   "text": "בצריף קטן."
  },
  {
   "start": 300.86,
   "end": 303.48,
   "text": "הרחק משם יושבת לה רחל, אישה קטנה,"
  },
  {
   "start": 304.14,
   "end": 307.26,
   "text": "אישה צנועה, שמסרה את כל העולם הזה שלה,"
  },
  {
   "start": 307.86,
   "end": 309.26,
   "text": "את כל העושר של אבא שלה,"
  },
  {
   "start": 310.14,
   "end": 313.6,
   "text": "את כל מה שאפשר לדמיין בעולם הזה."
  },
  {
   "start": 314.66,
   "end": 317.46,
   "text": "היא נטשה לטובת חיים עם אדם בעל נשמה מיוחדת."
  },
  {
   "start": 318.82,
   "end": 327.08,
   "text": "וגם יותר מזה, היא מסרה את אותם חיים עם אותו אדם למען הקדוש ברוך הוא."
  },
  {
   "start": 332.31,
   "end": 333.13,
   "text": "קשה לה מאוד."
  },
  {
   "start": 334.35,
   "end": 337.65,
   "text": "כשאומרים את זה זה נשמע קליל, אבל זה קשה מאוד מאוד,"
  },
  {
   "start": 338.27,
   "end": 340.17,
   "text": "במיוחד לאישה, הבדידות,"
  },
  {
   "start": 340.81,
   "end": 341.91,
   "text": "חוסר כתף תומכת."
  },
  {
   "start": 343.09,
   "end": 344.29,
   "text": "אין מישהו להישען עליו,"
  },
  {
   "start": 345.07,
   "end": 347.93,
   "text": "להתמודדות יומיומית לבד, לבד."
  },
  {
   "start": 348.33,
   "end": 354.45,
   "text": "שבתות וחגים אצל כולם נשמעים קולות של גברים מקדשים על היין."
  },
  {
   "start": 355.75,
   "end": 356.79,
   "text": "אצל רחל בבקתה"
  },
  {
   "start": 357.63,
   "end": 359.81,
   "text": "כבר שנים לא נשמע קולו של בעלה."
  },
  {
   "start": 363.17,
   "end": 363.73,
   "text": "והסביבה,"
  },
  {
   "start": 364.79,
   "end": 368.51,
   "text": "המבטים המרחמים של כולם וההתנקרות אליה,"
  },
  {
   "start": 370.41,
   "end": 372.47,
   "text": "היו כגחלי אש בליבה."
  },
  {
   "start": 374.35,
   "end": 375.49,
   "text": "אבל היא סבלה הכל בדממה."
  },
  {
   "start": 376.21,
   "end": 376.95,
   "text": "היא הייתה מעודדת עצמה."
  },
  {
   "start": 377.87,
   "end": 378.29,
   "text": "היא הייתה"
  },
  {
   "start": 379.03,
   "end": 384.97,
   "text": "מחזק את עצמה ומתמלא כל פעם בגלי עושר על שבעלה נמצא בישיבה,"
  },
  {
   "start": 385.51,
   "end": 387.25,
   "text": "לומד את התורה הקדושה,"
  },
  {
   "start": 387.77,
   "end": 391.69,
   "text": "עושה את הרצון של מלך מלכי המלכים הקדוש ברוך הוא."
  },
  {
   "start": 393.01,
   "end": 393.93,
   "text": "מדי פעם הייתה נזכרת"
  },
  {
   "start": 397.17,
   "end": 398.37,
   "text": "במילים שהוא אמר לה,"
  },
  {
   "start": 399.11,
   "end": 400.25,
   "text": "לו הייתי יכול,"
  },
  {
   "start": 400.97,
   "end": 404.17,
   "text": "הייתי מביא לך ירושלים של זהב."
  },
  {
   "start": 407.26,
   "end": 413.1,
   "text": "עקיבא, היא שמעה את עצמה ממלמלת ומכין לה את ירושלים של מעלה."
  },
  {
   "start": 414.1,
   "end": 415.26,
   "text": "על ידי התורה הקדושה,"
  },
  {
   "start": 415.92,
   "end": 418.7,
   "text": "לו הייתי יכול הייתי מביא לך ירושלים של זהב,"
  },
  {
   "start": 419.22,
   "end": 421.52,
   "text": "עכשיו אתה מביא לי את ירושלים של מעלה,"
  },
  {
   "start": 422.24,
   "end": 423.48,
   "text": "הרבה יותר מזהב."
  },
  {
   "start": 439.12,
   "end": 441.94,
   "text": "כך עברו להם תריסר שנים,"
  },
  {
   "start": 444.95,
   "end": 447.15,
   "text": "דמותו של הרב פסאלה במשעול,"
  },
  {
   "start": 448.09,
   "end": 450.03,
   "text": "דמות של תלמיד חכם הדור פנים."
  },
  {
   "start": 451.51,
   "end": 452.89,
   "text": "הייתה זו דמותו של עקיבא,"
  },
  {
   "start": 453.93,
   "end": 454.29,
   "text": "סליחה,"
  },
  {
   "start": 455.27,
   "end": 456.23,
   "text": "של רבי עקיבא."
  },
  {
   "start": 458.33,
   "end": 459.57,
   "text": "הלב מתרונן באושר וגיל,"
  },
  {
   "start": 459.75,
   "end": 461.81,
   "text": "ובדרך הביתה"
  },
  {
   "start": 462.65,
   "end": 463.75,
   "text": "להפתיע את רעייתו,"
  },
  {
   "start": 464.55,
   "end": 465.21,
   "text": "לבשר לה"
  },
  {
   "start": 466.53,
   "end": 467.79,
   "text": "שמילאת מבוקשה,"
  },
  {
   "start": 468.57,
   "end": 470.07,
   "text": "חוזר הביתה כתלמיד חכם,"
  },
  {
   "start": 472.97,
   "end": 473.63,
   "text": "בעל תלמידים."
  },
  {
   "start": 475.88,
   "end": 478.4,
   "text": "והנה הוא מזהה כבר מרחוק, הנה הבית."
  },
  {
   "start": 480.24,
   "end": 481.94,
   "text": "הנה השביל הפונה אל דלת הכניסה,"
  },
  {
   "start": 482.6,
   "end": 484.06,
   "text": "כאילו לא ישתנה כאן דבר."
  },
  {
   "start": 489.51,
   "end": 490.03,
   "text": "הקולות,"
  },
  {
   "start": 490.75,
   "end": 491.97,
   "text": "הקולות שנשמעו מתוך הצריף,"
  },
  {
   "start": 492.89,
   "end": 493.79,
   "text": "גרמו לו לעצור,"
  },
  {
   "start": 494.95,
   "end": 495.45,
   "text": "לעצור"
  },
  {
   "start": 496.33,
   "end": 497.51,
   "text": "ולהאזין בקשב רב."
  },
  {
   "start": 502.16,
   "end": 502.92,
   "text": "היו אלה השכנים."
  },
  {
   "start": 504.88,
   "end": 506.7,
   "text": "השכנים שבאו לדבר על לב רחל."
  },
  {
   "start": 509.98,
   "end": 512.32,
   "text": "תראי אלו חיים יש לך, אין לך כלום."
  },
  {
   "start": 513.58,
   "end": 515.36,
   "text": "רחל, את הבת של כלבה סבוע."
  },
  {
   "start": 516.52,
   "end": 517.24,
   "text": "מה יצא ממך?"
  },
  {
   "start": 518.14,
   "end": 518.74,
   "text": "את לא נשואה"
  },
  {
   "start": 519.88,
   "end": 520.44,
   "text": "וגם לא גרושה."
  },
  {
   "start": 521.22,
   "end": 521.66,
   "text": "בלי בעל,"
  },
  {
   "start": 522.32,
   "end": 522.72,
   "text": "בלי כסף,"
  },
  {
   "start": 525.06,
   "end": 525.66,
   "text": "בלי כלום."
  },
  {
   "start": 528.24,
   "end": 529.62,
   "text": "ועוד הוסיף אחד השכנים,"
  },
  {
   "start": 530.3,
   "end": 531.6,
   "text": "אם היה תלמיד חכם,"
  },
  {
   "start": 532.56,
   "end": 532.94,
   "text": "ניחא,"
  },
  {
   "start": 533.78,
   "end": 536.36,
   "text": "אבל את שלחת בור ועם הארץ."
  },
  {
   "start": 536.84,
   "end": 540.78,
   "text": "ראש אטום ללמוד תורה, מה יצא ממנו?"
  },
  {
   "start": 541.88,
   "end": 543.72,
   "text": "אני כבר משוכנע שהוא כבר עזב אותך."
  },
  {
   "start": 544.44,
   "end": 545.32,
   "text": "בגלל זה הוא לא חוזר."
  },
  {
   "start": 550.06,
   "end": 552.5,
   "text": "אם תתגרשי ממנו, תזכי בכל."
  },
  {
   "start": 553.98,
   "end": 555.52,
   "text": "אבא שלך אוהב אותך, נחכה לך."
  },
  {
   "start": 556.78,
   "end": 558.28,
   "text": "תזכי אולי לחיים חדשים."
  },
  {
   "start": 558.66,
   "end": 563.2,
   "text": "תזכי לכסף, למשפחה, לכל מה שאפשר לך חלום."
  },
  {
   "start": 565.73,
   "end": 566.03,
   "text": "כדאי לך."
  },
  {
   "start": 568.01,
   "end": 569.81,
   "text": "תקשיבי לנו, כואב לנו לראות אותך."
  },
  {
   "start": 572.75,
   "end": 573.15,
   "text": "הדברים,"
  },
  {
   "start": 573.93,
   "end": 585.59,
   "text": "הקשים האלה הלמו ברבי עקיבא שעמד בחוץ מאזין בקשב רב ואז מתוך הצריף"
  },
  {
   "start": 587.25,
   "end": 590.81,
   "text": "נשמע קולה של רחל קול ברור,"
  },
  {
   "start": 591.63,
   "end": 595.65,
   "text": "צלול ותקיף היא ענתה"
  },
  {
   "start": 596.67,
   "end": 602.41,
   "text": "אחרי כל השנים הקשות תריסר שנים עברו מאז שעזב הלך לישיבה"
  },
  {
   "start": 604.33,
   "end": 604.77,
   "text": "אתם יודעים"
  },
  {
   "start": 605.61,
   "end": 607.37,
   "text": "אתם יודעים, אם הוא היה בא היום לכאן,"
  },
  {
   "start": 608.01,
   "end": 609.61,
   "text": "אם הוא היה כאן, מעבר לדלת,"
  },
  {
   "start": 610.37,
   "end": 611.15,
   "text": "והיה שואל אותי,"
  },
  {
   "start": 612.01,
   "end": 614.17,
   "text": "רחל, מה את הכי רוצה ממני?"
  },
  {
   "start": 615.11,
   "end": 617.49,
   "text": "מה את רוצה ממני, הדבר החשוב בעולם?"
  },
  {
   "start": 618.71,
   "end": 619.55,
   "text": "הייתי אומרת לו,"
  },
  {
   "start": 620.17,
   "end": 621.47,
   "text": "אתה רוצה לעשות עם מאושרת?"
  },
  {
   "start": 623.86,
   "end": 625.74,
   "text": "לך לעוד תריסר שנים."
  },
  {
   "start": 626.46,
   "end": 628.16,
   "text": "לך עוד תלמד בישיבה."
  },
  {
   "start": 629.88,
   "end": 631.38,
   "text": "לך שתהיה כד."
  },
  {
   "start": 631.86,
   "end": 634.8,
   "text": "24 שנים, כד מלא חוכמה."
  },
  {
   "start": 634.92,
   "end": 636.76,
   "text": "כ׳ שנים של חוכמה,"
  },
  {
   "start": 637.42,
   "end": 638.88,
   "text": "תהיה כת מלא חוכמה."
  },
  {
   "start": 641.47,
   "end": 642.05,
   "text": "והאמת,"
  },
  {
   "start": 642.91,
   "end": 644.25,
   "text": "האמת הנוקבת שבקול שלה,"
  },
  {
   "start": 645.03,
   "end": 646.47,
   "text": "מילאה את כל חלה לצריף."
  },
  {
   "start": 651.14,
   "end": 652.86,
   "text": "העולם הזה הוא בסך הכל פרוזדור."
  },
  {
   "start": 654.74,
   "end": 655.66,
   "text": "אל עולם הנצח."
  },
  {
   "start": 656.4,
   "end": 659.48,
   "text": "כדאי שבעולם הזה, בפרוזדור הצר הזה,"
  },
  {
   "start": 660.34,
   "end": 663.44,
   "text": "הקצר הזה, נצטייד בכמה שיותר תורה,"
  },
  {
   "start": 663.8,
   "end": 664.94,
   "text": "כמה שיותר מצוות,"
  },
  {
   "start": 665.4,
   "end": 668.18,
   "text": "כמה שיותר אוצרות בדרך אל עולם הנצח."
  },
  {
   "start": 670.78,
   "end": 671.18,
   "text": "ראחל,"
  },
  {
   "start": 673.43,
   "end": 675.45,
   "text": "תריסר שנים של בדידות וקשיים,"
  },
  {
   "start": 676.37,
   "end": 679.81,
   "text": "תדעו לכם, כל זה שווה עבור התורה הקדושה."
  },
  {
   "start": 680.57,
   "end": 683.15,
   "text": "כל זה שווה עבור עם ישראל."
  },
  {
   "start": 684.03,
   "end": 687.03,
   "text": "כל זה שווה עבור קוצ'ה בריחו."
  },
  {
   "start": 688.69,
   "end": 691.43,
   "text": "ואתם בבקשה מכם, צאו מכאן."
  },
  {
   "start": 692.23,
   "end": 693.83,
   "text": "אל תקררו לי את האמונה."
  },
  {
   "start": 694.71,
   "end": 696.61,
   "text": "אל תקררו לי את האמונה."
  },
  {
   "start": 700.42,
   "end": 701.3,
   "text": "הם יצאו במהירות,"
  },
  {
   "start": 702.06,
   "end": 703.3,
   "text": "בראש מורכן מבושה."
  },
  {
   "start": 703.3,
   "end": 705.76,
   "text": "פשוט התביישו לעמוד,"
  },
  {
   "start": 706.9,
   "end": 710.02,
   "text": "פשוט התביישו לעמוד מול גדלותה"
  },
  {
   "start": 710.78,
   "end": 711.74,
   "text": "של אותה אישה."
  },
  {
   "start": 715.12,
   "end": 717.98,
   "text": "מרוב מהירות לא שמו לב לדמות קטנה,"
  },
  {
   "start": 719.34,
   "end": 723.34,
   "text": "גדולה שהתרחקה לה במשעול,"
  },
  {
   "start": 724.42,
   "end": 731.36,
   "text": "דמותו של תלמיד חכם של רבי עקיבא החוזר לישיבה."
  },
  {
   "start": 736.76,
   "end": 738.98,
   "text": "כולו חדור עוצמה רוחנית"
  },
  {
   "start": 739.82,
   "end": 742.02,
   "text": "מרעייתו המופלאה, רחל."
  },
  {
   "start": 743.22,
   "end": 746.6,
   "text": "לא יכולתי הייתי מביא לך ירושלים של זהב."
  }
 ]
}