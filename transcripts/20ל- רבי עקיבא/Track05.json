{
 "disc": "20ל- רבי עקיבא",
 "track": "Track05",
 "duration": 454.2,
 "segments": [
  {
   "start": 3.52,
   "end": 4.2,
   "text": "קלבא סבוע,"
  },
  {
   "start": 7.85,
   "end": 9.37,
   "text": "מהעשירים שבעם ישראל,"
  },
  {
   "start": 9.91,
   "end": 11.21,
   "text": "מבקש לדבר עם גדול הדור."
  },
  {
   "start": 12.57,
   "end": 14.87,
   "text": "מבקש לדבר עם אותו רב מופלא."
  },
  {
   "start": 16.49,
   "end": 17.99,
   "text": "הוא אינו מזהה ברב שמולו,"
  },
  {
   "start": 19.05,
   "end": 22.65,
   "text": "זה שכל עולם התורה מריע לו את החתן שלו,"
  },
  {
   "start": 23.45,
   "end": 24.11,
   "text": "הרועה,"
  },
  {
   "start": 26.25,
   "end": 27.15,
   "text": "בור ועם הארץ."
  },
  {
   "start": 30.55,
   "end": 33.59,
   "text": "והוא מגיע אל הרב ומבקש, כבוד הרב,"
  },
  {
   "start": 34.25,
   "end": 35.11,
   "text": "באתי לבקש."
  },
  {
   "start": 36.27,
   "end": 36.87,
   "text": "יש לי בת,"
  },
  {
   "start": 37.73,
   "end": 38.23,
   "text": "יש לי בת,"
  },
  {
   "start": 40.48,
   "end": 41.38,
   "text": "ושמה רחל,"
  },
  {
   "start": 42.4,
   "end": 43.74,
   "text": "שאני סילקתי אותה מהבית,"
  },
  {
   "start": 44.36,
   "end": 46.34,
   "text": "הדרתי אותה מכל מה שיש לי,"
  },
  {
   "start": 50.4,
   "end": 51.88,
   "text": "ואני מבקש עטרה לנדר."
  },
  {
   "start": 52.3,
   "end": 53.38,
   "text": "היא כל כך סובלת,"
  },
  {
   "start": 53.92,
   "end": 56.5,
   "text": "וכל כך כואב לי לראות את המצב שלה."
  },
  {
   "start": 57.24,
   "end": 58.98,
   "text": "אני כבר לא יכול להחזיק מעמד."
  },
  {
   "start": 59.72,
   "end": 60.24,
   "text": "אני מבקש ממך,"
  },
  {
   "start": 61.36,
   "end": 73.7,
   "text": "כבוד הרב ימצא אולי משהו להתיר איזה צל של סיכוי שהנדר הזה יבוטל."
  },
  {
   "start": 76.24,
   "end": 79.32,
   "text": "והרב שואל את האבא מיוסר בעדינות,"
  },
  {
   "start": 80.56,
   "end": 81.4,
   "text": "למה נדרת?"
  },
  {
   "start": 82.7,
   "end": 85.76,
   "text": "עונה קל בסבוע, כבוד הרב, הכל בגלל."
  },
  {
   "start": 87.5,
   "end": 90.42,
   "text": "שלא יכולתי, לא יכולתי לראות את הבת שלי"
  },
  {
   "start": 91.48,
   "end": 92.88,
   "text": "נישאת לבור ועם הארץ."
  },
  {
   "start": 93.64,
   "end": 95.28,
   "text": "אני כל כך רציתי שהיא תינשא לתלמיד חכם."
  },
  {
   "start": 105.95,
   "end": 110.13,
   "text": "יש לי שערות לבנות מעצר שנגרם לי מהנישואים שלה"
  },
  {
   "start": 110.85,
   "end": 111.59,
   "text": "לעם הארץ שכזה."
  },
  {
   "start": 114.7,
   "end": 115.9,
   "text": "תגיד לי, אם היית יודע,"
  },
  {
   "start": 116.48,
   "end": 118.12,
   "text": "אם היית יודע שאותו רועה"
  },
  {
   "start": 119.7,
   "end": 121.18,
   "text": "נלך וילמד תורה,"
  },
  {
   "start": 122.06,
   "end": 122.74,
   "text": "היית נודר?"
  },
  {
   "start": 125.0,
   "end": 125.3,
   "text": "לא,"
  },
  {
   "start": 126.34,
   "end": 127.1,
   "text": "לא הייתי נודר."
  },
  {
   "start": 127.92,
   "end": 131.16,
   "text": "תגיד לי, אם היית יודע שאותו רועה"
  },
  {
   "start": 136.29,
   "end": 141.31,
   "text": "ילמד תורה במשך שנים,"
  },
  {
   "start": 143.78,
   "end": 144.52,
   "text": "היית נודר?"
  },
  {
   "start": 145.34,
   "end": 146.18,
   "text": "בוודאי שלא."
  },
  {
   "start": 147.04,
   "end": 147.7,
   "text": "בוודאי שלא."
  },
  {
   "start": 152.79,
   "end": 153.49,
   "text": "קם רבי עקיבא,"
  },
  {
   "start": 155.17,
   "end": 156.13,
   "text": "אדון קלבא סבוע,"
  },
  {
   "start": 157.67,
   "end": 158.31,
   "text": "אתה לא מזהה אותי?"
  },
  {
   "start": 160.55,
   "end": 161.17,
   "text": "תתאבי טוב."
  },
  {
   "start": 162.51,
   "end": 163.59,
   "text": "אני זה החתן שלך."
  },
  {
   "start": 164.79,
   "end": 167.15,
   "text": "אני זה אותו עקיבא רועה צאן."
  },
  {
   "start": 171.91,
   "end": 173.49,
   "text": "וקלבא שבוע נרתע אחורי,"
  },
  {
   "start": 175.98,
   "end": 177.0,
   "text": "רועד כל-כולו,"
  },
  {
   "start": 179.4,
   "end": 180.42,
   "text": "מבקש סליחה"
  },
  {
   "start": 182.5,
   "end": 183.32,
   "text": "בקול נרעד."
  },
  {
   "start": 189.48,
   "end": 189.9,
   "text": "אותה בת"
  },
  {
   "start": 190.6,
   "end": 191.82,
   "text": "שגרמה לכאורה צער,"
  },
  {
   "start": 192.46,
   "end": 195.82,
   "text": "שחיה חיי עוני ומחסור, צדקה מנה."
  },
  {
   "start": 197.94,
   "end": 200.06,
   "text": "אותו חתן שהתביישתי בו כל כך,"
  },
  {
   "start": 200.9,
   "end": 203.74,
   "text": "משמש לי מקור לכל כך הרבה שמחה."
  },
  {
   "start": 216.98,
   "end": 218.26,
   "text": "רבי עקיבא ורחל לבד,"
  },
  {
   "start": 219.42,
   "end": 220.38,
   "text": "הכל מאחורי די."
  },
  {
   "start": 226.42,
   "end": 226.92,
   "text": "ואז,"
  },
  {
   "start": 228.06,
   "end": 233.1,
   "text": "בדממה רוויית ההוד שמשתררת לה בביתם,"
  },
  {
   "start": 234.26,
   "end": 236.8,
   "text": "רבי עקיבא מוציא משהו מהכיס שלי,"
  },
  {
   "start": 238.28,
   "end": 239.02,
   "text": "מוציא עדי,"
  },
  {
   "start": 239.66,
   "end": 240.08,
   "text": "תכשיט,"
  },
  {
   "start": 240.96,
   "end": 241.68,
   "text": "בצורת"
  },
  {
   "start": 243.14,
   "end": 244.86,
   "text": "ירושלים של זהב."
  },
  {
   "start": 246.66,
   "end": 247.16,
   "text": "את זוכרת,"
  },
  {
   "start": 248.1,
   "end": 248.94,
   "text": "לו יכולתי,"
  },
  {
   "start": 249.84,
   "end": 253.32,
   "text": "הייתי מביא לך ירושלים של זהב."
  },
  {
   "start": 258.3,
   "end": 259.64,
   "text": "ואת האושר הזה,"
  },
  {
   "start": 260.08,
   "end": 263.26,
   "text": "את האושר הזה שמילא את כל חלל הבית,"
  },
  {
   "start": 263.8,
   "end": 264.92,
   "text": "את כל חלל ליבם,"
  },
  {
   "start": 265.46,
   "end": 269.74,
   "text": "לא ניתן היה ואי אפשר להמחיש בשום צורה כלשהי."
  },
  {
   "start": 271.7,
   "end": 272.12,
   "text": "כי פשוט,"
  },
  {
   "start": 272.94,
   "end": 275.88,
   "text": "הוא לא רק שנתן לה ירושלים של זהב,"
  },
  {
   "start": 276.74,
   "end": 278.82,
   "text": "הוא נתן לה את ירושלים של מה,"
  },
  {
   "start": 279.72,
   "end": 281.44,
   "text": "הוא נתן לה עולם ומלואו,"
  },
  {
   "start": 282.06,
   "end": 283.42,
   "text": "גן עדן של ממש,"
  },
  {
   "start": 285.0,
   "end": 287.7,
   "text": "שלי ושלכם, כל התורה,"
  },
  {
   "start": 288.6,
   "end": 290.16,
   "text": "הכל שלה."
  },
  {
   "start": 291.78,
   "end": 292.62,
   "text": "ולא כסיסמה,"
  },
  {
   "start": 293.76,
   "end": 305.14,
   "text": "אלא באמת, צריך לדעת,"
  },
  {
   "start": 308.08,
   "end": 310.08,
   "text": "גם היום כל בת ישראל"
  },
  {
   "start": 310.96,
   "end": 311.66,
   "text": "היא בבחינת רחל,"
  },
  {
   "start": 312.68,
   "end": 313.3,
   "text": "כל בעל"
  },
  {
   "start": 314.22,
   "end": 315.1,
   "text": "בבחינת רבי עקיבא קטן."
  },
  {
   "start": 316.58,
   "end": 317.12,
   "text": "בדור שלנו,"
  },
  {
   "start": 318.92,
   "end": 321.78,
   "text": "כולנו רבי עקיבא, כולנו רחל,"
  },
  {
   "start": 322.22,
   "end": 324.6,
   "text": "כי הקדוש ברוך הוא ממתין לכל יהודי ויהודייה,"
  },
  {
   "start": 325.58,
   "end": 329.42,
   "text": "לכל יהודי ויהודייה שמאיפה שהם נמצאים,"
  },
  {
   "start": 330.18,
   "end": 332.08,
   "text": "התקרבו אל השם."
  },
  {
   "start": 333.36,
   "end": 334.74,
   "text": "אנחנו נמצאים בדור של גאולה,"
  },
  {
   "start": 335.38,
   "end": 336.24,
   "text": "דור של צעד,"
  },
  {
   "start": 337.16,
   "end": 338.34,
   "text": "צעד לקדוש ברוך הוא."
  },
  {
   "start": 338.98,
   "end": 340.16,
   "text": "זה צעד של חיים,"
  },
  {
   "start": 341.18,
   "end": 343.3,
   "text": "זה צעד ענק"
  },
  {
   "start": 344.42,
   "end": 345.08,
   "text": "של גאולה."
  },
  {
   "start": 348.61,
   "end": 349.23,
   "text": "יש הרבה קשיים,"
  },
  {
   "start": 349.97,
   "end": 352.73,
   "text": "יש להם הרבה ניסיונות לכל אחד, לכל אחת."
  },
  {
   "start": 353.69,
   "end": 356.39,
   "text": "אבל מי שיחזיק מעמד, מי שתחזיק מעמד,"
  },
  {
   "start": 357.03,
   "end": 357.83,
   "text": "חרף כל הקשיים,"
  },
  {
   "start": 360.68,
   "end": 361.68,
   "text": "יהיו איזה שיהיו,"
  },
  {
   "start": 362.44,
   "end": 363.44,
   "text": "מי שידבוק,"
  },
  {
   "start": 363.78,
   "end": 366.4,
   "text": "מי שתדבוק כל הזמן בקדוש ברוך הוא בתורתו,"
  },
  {
   "start": 366.98,
   "end": 368.22,
   "text": "תנצח, ינצח,"
  },
  {
   "start": 369.12,
   "end": 370.96,
   "text": "וכולם נזכה לנצח."
  },
  {
   "start": 372.58,
   "end": 373.02,
   "text": "אתם יודעים,"
  },
  {
   "start": 374.8,
   "end": 377.14,
   "text": "לאחר היו שנים, 24 שנים,"
  },
  {
   "start": 378.1,
   "end": 382.74,
   "text": "שכנים שהתפלאו, לא הבינו, אולי גם הציקו קצת."
  },
  {
   "start": 383.66,
   "end": 385.22,
   "text": "בלי כוונה."
  },
  {
   "start": 386.04,
   "end": 386.76,
   "text": "אבל בכל אופן,"
  },
  {
   "start": 387.9,
   "end": 389.96,
   "text": "הם היו בטוחים שהם עושים את הצעד הנכון."
  },
  {
   "start": 390.78,
   "end": 393.34,
   "text": "הם היו בטוחים שהם בדרך הנכונה."
  },
  {
   "start": 394.42,
   "end": 397.18,
   "text": "תגידו לי, מישהו זוכר היום מי אלו השכנים?"
  },
  {
   "start": 398.1,
   "end": 399.1,
   "text": "מישהו מכיר אותם?"
  },
  {
   "start": 400.12,
   "end": 401.12,
   "text": "מישהו שמע עליהם?"
  },
  {
   "start": 402.56,
   "end": 404.06,
   "text": "אבל מי לא שמע על רבי עקיבא?"
  },
  {
   "start": 405.46,
   "end": 408.62,
   "text": "מי לא שמע על רחל אשתו של רבי עקיבא?"
  },
  {
   "start": 411.59,
   "end": 414.83,
   "text": "עד היום פוקדים את קברם."
  },
  {
   "start": 418.24,
   "end": 420.78,
   "text": "אלפים ועשרות אלפים מעם ישראל,"
  },
  {
   "start": 421.88,
   "end": 422.86,
   "text": "גברים ונשים,"
  },
  {
   "start": 423.76,
   "end": 424.68,
   "text": "בוכים בוכות,"
  },
  {
   "start": 425.52,
   "end": 426.98,
   "text": "מתפללים מתפללות."
  },
  {
   "start": 429.04,
   "end": 432.08,
   "text": "עד היום זכותם מגינה על כל עם ישראל."
  },
  {
   "start": 433.36,
   "end": 435.86,
   "text": "והשכנים שבחרו בדרך הקלה,"
  },
  {
   "start": 436.7,
   "end": 438.88,
   "text": "בדרך הקלילה, אולי בעולם הזה יותר,"
  },
  {
   "start": 442.55,
   "end": 443.39,
   "text": "זה מה שהם קיבלו."
  },
  {
   "start": 444.69,
   "end": 445.51,
   "text": "את העולם הזה."
  },
  {
   "start": 446.13,
   "end": 446.59,
   "text": "וזהו,"
  },
  {
   "start": 447.37,
   "end": 449.89,
   "text": "כשנגמר העולם הזה, נגמר הכל."
  }
 ]
}