{
 "disc": "1א - בוץ שווה זהב",
 "track": "Track02",
 "duration": 740.16,
 "segments": [
  {
   "start": 8.32,
   "end": 9.54,
   "text": "לפני כ-28 שנה,"
  },
  {
   "start": 11.14,
   "end": 18.96,
   "text": "כאן בארץ התרחש לו מקרה שמדבר אלינו מאוד,"
  },
  {
   "start": 21.93,
   "end": 25.35,
   "text": "שצריך לעזור לנו להסתכל בהסתכלות אמיתית על העולם"
  },
  {
   "start": 26.05,
   "end": 28.37,
   "text": "שבו אנחנו נמצאים, ועל העולם"
  },
  {
   "start": 28.99,
   "end": 31.23,
   "text": "שאליו אנחנו עתידים לבוא"
  },
  {
   "start": 36.04,
   "end": 37.42,
   "text": "באחרית ימינו"
  },
  {
   "start": 38.4,
   "end": 39.48,
   "text": "או באחרית הימים."
  },
  {
   "start": 40.74,
   "end": 42.26,
   "text": "אז כאן בארץ, ברחוב רבי עקיבא,"
  },
  {
   "start": 43.32,
   "end": 45.66,
   "text": "פינת איצקוביץ', מקום הומה מאדם,"
  },
  {
   "start": 46.0,
   "end": 46.38,
   "text": "הולכת רגל,"
  },
  {
   "start": 47.42,
   "end": 49.24,
   "text": "בעלת חזות שאינה שומרת הורא ומצוות,"
  },
  {
   "start": 50.06,
   "end": 51.78,
   "text": "עוברת במעבר חצייה,"
  },
  {
   "start": 52.46,
   "end": 55.34,
   "text": "ורכב שפנה ימינה פוגע בה פגיעה ישירה."
  },
  {
   "start": 56.24,
   "end": 57.02,
   "text": "מהפגיעה"
  },
  {
   "start": 57.7,
   "end": 58.24,
   "text": "היא פשוט"
  },
  {
   "start": 64.72,
   "end": 66.44,
   "text": "הגוף שלה ניתק מהקרקע,"
  },
  {
   "start": 69.49,
   "end": 77.08,
   "text": "ופשוט עף לכיוון אבן השפה."
  },
  {
   "start": 79.31,
   "end": 82.61,
   "text": "היא נפגעת בצורה קשה מאוד,"
  },
  {
   "start": 83.21,
   "end": 86.75,
   "text": "ולצוות הרפואי שמגיע למקום לא נותר לה לקבוע את מותה."
  },
  {
   "start": 89.69,
   "end": 92.51,
   "text": "זמן קצר אחרי שנקבע מותה התברר שאותה אישה היא ערירית."
  },
  {
   "start": 93.35,
   "end": 95.23,
   "text": "אין לה שום קרוב."
  },
  {
   "start": 95.91,
   "end": 97.37,
   "text": "אין לה שום קרוב. אישה בודדה,"
  },
  {
   "start": 97.95,
   "end": 100.75,
   "text": "ללא משפחה, ללא איש שיכול לעזור לה."
  },
  {
   "start": 103.23,
   "end": 104.77,
   "text": "מגיעים נציגי המכון הפותולוגי,"
  },
  {
   "start": 105.45,
   "end": 106.49,
   "text": "רוצים לקחת את הגופה,"
  },
  {
   "start": 107.29,
   "end": 109.07,
   "text": "אם זה לצורך ניתוח, אם זה לצורך בדיקה,"
  },
  {
   "start": 110.03,
   "end": 114.87,
   "text": "ממה בדיוק היא מתה, האם מהמכה, האם של הרכב, האם מהפגיעה בבן השפה."
  },
  {
   "start": 115.49,
   "end": 117.69,
   "text": "אבל בינתיים, בינתיים בבני ברק"
  },
  {
   "start": 118.63,
   "end": 119.69,
   "text": "מתפשטת לה השמועה"
  },
  {
   "start": 122.21,
   "end": 122.79,
   "text": "מה השמועה?"
  },
  {
   "start": 124.13,
   "end": 125.25,
   "text": "יש מת מצווה."
  },
  {
   "start": 131.5,
   "end": 132.3,
   "text": "יש מת מצווה."
  },
  {
   "start": 133.96,
   "end": 134.5,
   "text": "צריך לדעת"
  },
  {
   "start": 135.28,
   "end": 136.94,
   "text": "מה זה מת מצווה. ביהדות,"
  },
  {
   "start": 137.54,
   "end": 140.96,
   "text": "כבוד האדם אצל הקדוש ברוך הוא זה ערך עליון."
  },
  {
   "start": 141.86,
   "end": 142.96,
   "text": "לא רק כשהוא חי,"
  },
  {
   "start": 143.76,
   "end": 145.62,
   "text": "גם כשאדם נפטר מן העולם."
  },
  {
   "start": 148.29,
   "end": 150.95,
   "text": "וכאשר יש אדם שנפטר מן העולם,"
  },
  {
   "start": 151.27,
   "end": 154.23,
   "text": "והיא הפחות ביותר בישראל, ואין מי שיקבור אותו,"
  },
  {
   "start": 154.59,
   "end": 155.63,
   "text": "עוזבים את הכול."
  },
  {
   "start": 156.25,
   "end": 157.47,
   "text": "מצווה כל כך חשובה,"
  },
  {
   "start": 157.77,
   "end": 160.57,
   "text": "עוזבים את הכל והולכים לטפל בקבורה שלו."
  },
  {
   "start": 161.99,
   "end": 162.55,
   "text": "עד כך"
  },
  {
   "start": 163.75,
   "end": 167.95,
   "text": "שאם דוגמה יש בתקופת בית המקדש, בתקופת בית המקדש שהיה בא הכהנים,"
  },
  {
   "start": 168.45,
   "end": 170.59,
   "text": "הכהן התפקיד שלו היה לכפר על עם ישראל,"
  },
  {
   "start": 171.57,
   "end": 173.89,
   "text": "וכהן שעושה את הדרך אל בית המקדש,"
  },
  {
   "start": 176.68,
   "end": 177.78,
   "text": "והוא צריך תקולות טהור,"
  },
  {
   "start": 178.22,
   "end": 181.0,
   "text": "והוא הולך בדרך לבית המקדש ולפתע הוא ראה על אם הדרך,"
  },
  {
   "start": 182.8,
   "end": 184.62,
   "text": "שוכב לו אדם חסר בית,"
  },
  {
   "start": 185.5,
   "end": 188.52,
   "text": "מת, נפטר מן העולם, ואין מי שיטפל בו, רק הוא."
  },
  {
   "start": 189.76,
   "end": 191.44,
   "text": "אז הוא עוזב את בית המקדש כרגע."
  },
  {
   "start": 192.06,
   "end": 194.18,
   "text": "עם ישראל יכול לחכות עם הכפרות."
  },
  {
   "start": 195.56,
   "end": 198.0,
   "text": "הוא ילך עכשיו ויטפל באותו מת מצווה."
  },
  {
   "start": 201.73,
   "end": 202.35,
   "text": "עד כדי כך"
  },
  {
   "start": 203.59,
   "end": 208.67,
   "text": "חשוב כבוד האדם לא רק בחייו, גם אחרי מותו."
  },
  {
   "start": 216.25,
   "end": 217.51,
   "text": "וכשבבני ברק שמעו"
  },
  {
   "start": 218.35,
   "end": 222.77,
   "text": "שיש למעשה מת מצווה, אותה אישה, אין מי שיקבור אותה, אין מי שיטפל בה,"
  },
  {
   "start": 223.13,
   "end": 224.89,
   "text": "נחשבת בחזקת מת מצווה."
  },
  {
   "start": 230.0,
   "end": 232.7,
   "text": "השמועה התפשטה כאש בשדה קוצין,"
  },
  {
   "start": 233.26,
   "end": 234.1,
   "text": "ולאט לאט,"
  },
  {
   "start": 235.08,
   "end": 240.36,
   "text": "אבל בכמויות הולכות וגוברות, יצאו מן הבתים אנשים."
  },
  {
   "start": 240.9,
   "end": 242.94,
   "text": "התנדבו, אנחנו נטפל בזה, אנחנו נעשה את ההלוויה,"
  },
  {
   "start": 243.24,
   "end": 244.48,
   "text": "אנחנו נסדר את כל סידורי הקבורה,"
  },
  {
   "start": 244.94,
   "end": 246.56,
   "text": "אנחנו נסדר את כל סידורי הקבורה."
  },
  {
   "start": 246.9,
   "end": 249.24,
   "text": "ויהודים טובים יצאו והתחילו לטפל בכל,"
  },
  {
   "start": 249.68,
   "end": 251.52,
   "text": "ובני ברק התארגנה להלוויה."
  },
  {
   "start": 252.54,
   "end": 253.28,
   "text": "מת מצווה,"
  },
  {
   "start": 253.92,
   "end": 255.98,
   "text": "ברוך השם היום בחסדי השם בארץ,"
  },
  {
   "start": 256.74,
   "end": 260.96,
   "text": "זו מצווה נדירה. רוב האנשים יש להם קרובים, יש להם מכרים, יש מי שהוא יטפל."
  },
  {
   "start": 261.8,
   "end": 266.7,
   "text": "למצוא יהודייה שאין מי שיטפל בה זה נדיר מאוד."
  },
  {
   "start": 267.22,
   "end": 274.78,
   "text": "בבני ברק כולם רצו להשתתף במצווה הנדירה הזאת וכולם יוצאים מהבתים ונוהרים אל הרחובות,"
  },
  {
   "start": 275.46,
   "end": 277.08,
   "text": "אל ההלוויה הזו, הלוויה נדירה,"
  },
  {
   "start": 277.5,
   "end": 281.34,
   "text": "נדירה ומיוחדת עד לכך שגם גדולי ישראל, גדולי הדור בבני ברק,"
  },
  {
   "start": 281.86,
   "end": 287.52,
   "text": "שבדרך כלל לא יוצאים מבתיהם וגם לא להלוויות אלא למקרים נדירים ביותר, לא מבטלים רגע של תורה,"
  },
  {
   "start": 287.92,
   "end": 289.24,
   "text": "עזבו את הכל וסגרו,"
  },
  {
   "start": 289.54,
   "end": 290.46,
   "text": "סגרו את הגמרות,"
  },
  {
   "start": 290.54,
   "end": 294.68,
   "text": "סגרו את התורה ולמעשה באו להשתתף במצווה הנדירה הזו."
  },
  {
   "start": 295.52,
   "end": 296.2,
   "text": "מת מצווה."
  },
  {
   "start": 298.28,
   "end": 299.3,
   "text": "וכולם יוצאים,"
  },
  {
   "start": 300.2,
   "end": 301.04,
   "text": "אלפי בני אדם,"
  },
  {
   "start": 301.76,
   "end": 303.5,
   "text": "לא אלפי, עשרות אלפי,"
  },
  {
   "start": 304.18,
   "end": 306.36,
   "text": "עשרות עשרות עשרות אלפי,"
  },
  {
   "start": 306.96,
   "end": 308.3,
   "text": "הלוויה ממלכתית,"
  },
  {
   "start": 309.3,
   "end": 310.4,
   "text": "עוצמה אדירה,"
  },
  {
   "start": 311.52,
   "end": 313.72,
   "text": "מלווים אישה שלא מכירים,"
  },
  {
   "start": 314.12,
   "end": 317.72,
   "text": "אישה יהודייה שרחוקה מתורה ומצוות שאין לה מי שיקבור אותה,"
  },
  {
   "start": 318.22,
   "end": 319.26,
   "text": "עריד בודדה,"
  },
  {
   "start": 319.7,
   "end": 323.12,
   "text": "כולם מלווים אותה, איזה כבוד, איזה עוצמה."
  },
  {
   "start": 324.7,
   "end": 329.06,
   "text": "וידוע, ככל שהלוויה יותר גדולה יש נחת למעשה לנפטר."
  },
  {
   "start": 332.22,
   "end": 332.76,
   "text": "זה מעיד,"
  },
  {
   "start": 333.34,
   "end": 335.32,
   "text": "מעיד על העוצמה של היהודי, של היהודייה."
  },
  {
   "start": 336.8,
   "end": 342.1,
   "text": "וככה ההלוויה יוצאת לדרך ההלוויה מהגדולות ביותר שנערכו במדינת ישראל."
  },
  {
   "start": 348.5,
   "end": 349.2,
   "text": "בתום ההלוויה."
  },
  {
   "start": 351.53,
   "end": 352.21,
   "text": "בתום ההלוויה."
  },
  {
   "start": 354.19,
   "end": 356.71,
   "text": "פונים גדולי הדור אחד אל השני ואומרים,"
  },
  {
   "start": 358.91,
   "end": 360.47,
   "text": "משהו פה,"
  },
  {
   "start": 361.17,
   "end": 362.01,
   "text": "משהו פה לא הגיוני."
  },
  {
   "start": 363.03,
   "end": 366.48,
   "text": "משהו פה קצת, קצת שונה."
  },
  {
   "start": 368.56,
   "end": 369.2,
   "text": "אם אני לא טועה,"
  },
  {
   "start": 369.54,
   "end": 371.5,
   "text": "אם אני לא טועה, היו גדולי הדור החזון איש והסטייפלר."
  },
  {
   "start": 376.76,
   "end": 377.58,
   "text": "ואם זה כך,"
  },
  {
   "start": 380.21,
   "end": 381.77,
   "text": "אז אומר החזון איש לסטייפלר,"
  },
  {
   "start": 382.85,
   "end": 383.53,
   "text": "כבוד הרב,"
  },
  {
   "start": 384.55,
   "end": 387.45,
   "text": "כבוד הרב, איך אותה אישה, אף אחד לא מכיר אותה, איך אותה אישה,"
  },
  {
   "start": 387.85,
   "end": 394.39,
   "text": "הבנתי שהיא כנראה הייתה רחוקה מתורה ומצוות, איך היא זכתה להלוויה שתלמידי חכמים לא זוכים לה,"
  },
  {
   "start": 395.15,
   "end": 404.69,
   "text": "שאנשים בציבור הישראלי לא זוכים לה, חברי כנסת, שרים, כל מיני אנשים שמטבע הדברים צריכים ללוות אותם במדינת ישראל,"
  },
  {
   "start": 405.37,
   "end": 410.37,
   "text": "לא מלווים אותם כל כך הרבה. איך היא זכתה להוציא כמעט כל בני ברק לרחובות,"
  },
  {
   "start": 410.77,
   "end": 413.69,
   "text": "להלוויה ממלכתית, כזה דבר כל כך גדול, איזו עוצמה,"
  },
  {
   "start": 414.25,
   "end": 415.71,
   "text": "משהו פה צריך לברר."
  },
  {
   "start": 416.39,
   "end": 421.23,
   "text": "בזכות מה אותה אישה זכתה לכל כך הרבה כבוד אחרי מותה."
  },
  {
   "start": 423.97,
   "end": 426.55,
   "text": "אולי כבוד הרב יוכל לשלוח כמה בחורים לברר,"
  },
  {
   "start": 426.97,
   "end": 428.17,
   "text": "לעשות קצת תחקיר קצר,"
  },
  {
   "start": 428.49,
   "end": 428.99,
   "text": "לברר,"
  },
  {
   "start": 431.64,
   "end": 433.82,
   "text": "ונשלחו בחורים לברר."
  },
  {
   "start": 434.62,
   "end": 436.42,
   "text": "איך יכול להיות שאישה"
  },
  {
   "start": 437.02,
   "end": 437.96,
   "text": "שאיש לא מכיר אותה,"
  },
  {
   "start": 438.78,
   "end": 447.25,
   "text": "שאישה שאין לה קרובי משפחה, שאישה תזכה"
  },
  {
   "start": 449.54,
   "end": 453.48,
   "text": "להלוויה שזוכים אנשים מאוד מאוד מיוחדים?"
  },
  {
   "start": 454.14,
   "end": 456.3,
   "text": "מה המיוחד באותה אישה מסתורית?"
  },
  {
   "start": 459.86,
   "end": 462.84,
   "text": "זמן מה אחר כך מתבררת לה התעלומה."
  },
  {
   "start": 491.28,
   "end": 494.3,
   "text": "מתברר שאותה אישה,"
  },
  {
   "start": 495.04,
   "end": 500.9,
   "text": "כך סיפרו שכנים ניצולי שואה שהיו, גרו בסמוך אליהם, הכירו אותה,"
  },
  {
   "start": 501.74,
   "end": 503.24,
   "text": "אותה אישה הייתה ניצולת שואה,"
  },
  {
   "start": 505.0,
   "end": 509.8,
   "text": "אותה אישה הייתה בתקופת השואה במחנה ברגן בלזן,"
  },
  {
   "start": 512.57,
   "end": 517.82,
   "text": "ושם במחנה יש דבר אחד שעליו היא הקפידה,"
  },
  {
   "start": 518.78,
   "end": 521.32,
   "text": "יש דבר אחד שבו היא התפרסמה והצטיינה בו,"
  },
  {
   "start": 522.2,
   "end": 523.38,
   "text": "כאשר היא הייתה רואה"
  },
  {
   "start": 524.16,
   "end": 526.62,
   "text": "גופה של בת ישראל,"
  },
  {
   "start": 527.16,
   "end": 530.06,
   "text": "של יהודייה שנפטרה והמוות שם היה משתולל."
  },
  {
   "start": 530.86,
   "end": 532.54,
   "text": "וכל יום הייתה גופה חדשה,"
  },
  {
   "start": 533.22,
   "end": 537.02,
   "text": "אבל כשהיא הייתה רואה גופה של בת ישראל מוטלת ככה"
  },
  {
   "start": 538.6,
   "end": 540.14,
   "text": "בריש גלי ברחובות,"
  },
  {
   "start": 541.96,
   "end": 542.92,
   "text": "מתבזה,"
  },
  {
   "start": 543.68,
   "end": 546.32,
   "text": "היא לא הייתה יושבת ריקם."
  },
  {
   "start": 547.5,
   "end": 548.48,
   "text": "היא הייתה הולכת"
  },
  {
   "start": 549.32,
   "end": 553.62,
   "text": "ולוקחת עט ומעדר וחופרת קבר וקוברת."
  },
  {
   "start": 554.78,
   "end": 555.72,
   "text": "וכשלא היה,"
  },
  {
   "start": 556.04,
   "end": 556.96,
   "text": "כשלא היה מעדר,"
  },
  {
   "start": 557.28,
   "end": 560.82,
   "text": "כשלא היה עט, היא הייתה עושה את זה עם גזרי עץ,"
  },
  {
   "start": 561.66,
   "end": 562.22,
   "text": "עם עץ,"
  },
  {
   "start": 562.86,
   "end": 565.06,
   "text": "כל מיני קרשים שהיא מצאה."
  },
  {
   "start": 565.52,
   "end": 571.02,
   "text": "היא הייתה חופרת עם קרשים שהיא מצאה, חופרת קבר לאותה גופה,"
  },
  {
   "start": 571.4,
   "end": 573.64,
   "text": "לאותה יהודייה מת מצווה."
  },
  {
   "start": 574.76,
   "end": 576.66,
   "text": "וכאשר לא היה גם קרשים,"
  },
  {
   "start": 576.66,
   "end": 580.54,
   "text": "שאם לא היה במה לחפור, הייתה חופרת בציפורניים, אבל היא הייתה עושה קבר."
  },
  {
   "start": 580.9,
   "end": 584.04,
   "text": "היא לא תיתן לבת ישראל, לגוף שלה, להתבזות."
  },
  {
   "start": 585.04,
   "end": 590.8,
   "text": "היה משהו פנימי מניע אותה, אני לא אתן לבזות את בת ישראל אחרי המוות הנדאג לחסד של אמת."
  },
  {
   "start": 593.67,
   "end": 594.65,
   "text": "אמרו גדולי הדור,"
  },
  {
   "start": 596.11,
   "end": 597.25,
   "text": "עכשיו מובן הכל."
  },
  {
   "start": 597.97,
   "end": 599.23,
   "text": "לחיל הים יש מכם."
  },
  {
   "start": 600.19,
   "end": 601.81,
   "text": "לחיל האוויר יש מכם."
  },
  {
   "start": 602.17,
   "end": 603.79,
   "text": "גם לבורא עולם יש מכם."
  },
  {
   "start": 604.15,
   "end": 608.31,
   "text": "המכם של בורא עולם זה ראשי תיבות מכם, מידה כנגד מידה."
  },
  {
   "start": 609.07,
   "end": 612.79,
   "text": "בא בור העולם, רואה את הבת שלו, שם בלב התופת,"
  },
  {
   "start": 613.41,
   "end": 615.01,
   "text": "דואגת לאחיות שלה."
  },
  {
   "start": 615.77,
   "end": 617.27,
   "text": "דואגת לאחיות שלה,"
  },
  {
   "start": 617.81,
   "end": 619.05,
   "text": "דואגת לילדות שלי."
  },
  {
   "start": 619.69,
   "end": 621.61,
   "text": "אומר בור העולם, את דואגת לילדות שלי."
  },
  {
   "start": 622.07,
   "end": 625.33,
   "text": "את דואגת לילדות שלי שלא יתבזו אחרי מותם."
  },
  {
   "start": 626.65,
   "end": 627.47,
   "text": "אני אמתין לך,"
  },
  {
   "start": 628.17,
   "end": 629.09,
   "text": "ואני אדאג לזה."
  },
  {
   "start": 629.49,
   "end": 633.45,
   "text": "כשיבוא יום אחד יום הפטירה שלך, אפילו שאין לך אף אחד בעולם,"
  },
  {
   "start": 634.31,
   "end": 638.35,
   "text": "אני אדאג לך להלוויה ממלכתית, להלוויה שלא הייתה כמותה,"
  },
  {
   "start": 638.73,
   "end": 642.33,
   "text": "כי את דאגת, את תתאמץ בשביל הילדות שלי."
  },
  {
   "start": 643.65,
   "end": 645.73,
   "text": "אני אדאג לך, שם במחנות,"
  },
  {
   "start": 646.17,
   "end": 650.13,
   "text": "שם במוות, שם בברגן בלזן, אותה אישה כשהיא חפרה קברים."
  },
  {
   "start": 650.73,
   "end": 652.71,
   "text": "היא לא חשבה על שכר."
  },
  {
   "start": 654.05,
   "end": 656.31,
   "text": "היא ידעה שהיא מתאמצת, ומתאמצת"
  },
  {
   "start": 657.01,
   "end": 657.93,
   "text": "פשוט לא לצייר"
  },
  {
   "start": 659.49,
   "end": 661.77,
   "text": "את החברה של הבת ישראל."
  },
  {
   "start": 664.06,
   "end": 665.24,
   "text": "בא בורא עולם ואומר,"
  },
  {
   "start": 665.8,
   "end": 669.86,
   "text": "כל היגיעה, כל המאמצים, כל הזיעה שהשקעת, כל מה שהשקעת,"
  },
  {
   "start": 670.38,
   "end": 671.58,
   "text": "לא לריק, לא לריק."
  },
  {
   "start": 672.42,
   "end": 673.5,
   "text": "כבר בעולם הזה,"
  },
  {
   "start": 673.8,
   "end": 675.86,
   "text": "יראו איזה שכר יש לך בעולם הבא."
  },
  {
   "start": 681.91,
   "end": 682.81,
   "text": "כך אומר המדרש,"
  },
  {
   "start": 683.13,
   "end": 685.07,
   "text": "תלמוד ירושלמי, מסכת עבודה זרה,"
  },
  {
   "start": 685.55,
   "end": 686.47,
   "text": "דף דלת עמוד א',"
  },
  {
   "start": 687.03,
   "end": 690.39,
   "text": "כשהראו לרבי אבהו את השכר הצפון לו בגן עדן,"
  },
  {
   "start": 690.57,
   "end": 692.59,
   "text": "בכה רבי אבהו ואמר, ואני אמרתי,"
  },
  {
   "start": 693.47,
   "end": 695.03,
   "text": "ואני אמרתי לריק יגעתי."
  },
  {
   "start": 695.77,
   "end": 698.33,
   "text": "הוא חשב שכל המאמצים שלו,"
  },
  {
   "start": 699.43,
   "end": 702.33,
   "text": "כל הדברים שהוא עשה במהלך חייו לכבוד השם,"
  },
  {
   "start": 703.67,
   "end": 705.49,
   "text": "אבל אפילו שלא נראים ממש מצוות,"
  },
  {
   "start": 705.85,
   "end": 708.09,
   "text": "אולי אין על זה שכר."
  },
  {
   "start": 708.65,
   "end": 711.47,
   "text": "מתברר שעל כל דבר שאתה עושה, כל צעד"
  },
  {
   "start": 712.01,
   "end": 713.95,
   "text": "שאת עושה, יש שכר."
  },
  {
   "start": 714.53,
   "end": 715.41,
   "text": "עם אותה אישה,"
  },
  {
   "start": 715.91,
   "end": 719.07,
   "text": "עם אותה אישה בברגן בלזן, על גבורה היא מקבלת כך."
  },
  {
   "start": 719.63,
   "end": 720.43,
   "text": "כמה אישה,"
  },
  {
   "start": 720.75,
   "end": 724.73,
   "text": "כמה גבר יקבל על חיים שהוא דואג לכבוד השם יתברך."
  },
  {
   "start": 725.13,
   "end": 729.17,
   "text": "כמה אישה תקבל על זה שהיא תדאג לילדים, להביא חיים לעולם,"
  },
  {
   "start": 729.57,
   "end": 730.81,
   "text": "לגדל חיים בעולם."
  },
  {
   "start": 731.13,
   "end": 733.17,
   "text": "כמה גבר ידאג על חיים בעולם."
  },
  {
   "start": 733.17,
   "end": 737.23,
   "text": "כמה הגבר יקבל על כל מה שהוא עושה לכבוד השם יתברך."
  }
 ]
}