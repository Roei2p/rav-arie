{
 "disc": "1א - בוץ שווה זהב",
 "track": "2_merge_merged",
 "duration": 740.16,
 "segments": [
  {
   "start": 8.33,
   "end": 9.55,
   "text": "לפני כעשרים ושמונה שנה,"
  },
  {
   "start": 11.15,
   "end": 19.1,
   "text": "כאן בארץ התרחש לו מקרה שמדבר אלינו מאוד,"
  },
  {
   "start": 21.95,
   "end": 27.31,
   "text": "שצריך לעזור לנו להסתכל בהסתכלות אמיתית על העולם שבו אנחנו נמצאים,"
  },
  {
   "start": 27.77,
   "end": 37.44,
   "text": "ועל העולם שאליו אנחנו עתידים לבוא באחרית ימינו"
  },
  {
   "start": 38.42,
   "end": 39.52,
   "text": "או באחרית הימים."
  },
  {
   "start": 40.76,
   "end": 42.3,
   "text": "אז כאן בארץ, ברחוב רבי עקיבא,"
  },
  {
   "start": 43.34,
   "end": 46.74,
   "text": "פינת איצקוביץ', מקום הומה מאדם, הולכת רגל,"
  },
  {
   "start": 47.44,
   "end": 49.28,
   "text": "בעלת חזות שאינה שומר תורה ומצוות,"
  },
  {
   "start": 50.08,
   "end": 51.84,
   "text": "עוברת במעבר חצייה,"
  },
  {
   "start": 52.48,
   "end": 55.36,
   "text": "ורכב שפנה ימינה פוגע בה פגיעה ישירה."
  },
  {
   "start": 56.26,
   "end": 57.04,
   "text": "מהפגיעה"
  },
  {
   "start": 57.74,
   "end": 58.26,
   "text": "היא פשוט"
  },
  {
   "start": 64.74,
   "end": 66.46,
   "text": "הגוף שלה ניתק מהקרקע,"
  },
  {
   "start": 69.52,
   "end": 77.16,
   "text": "ופשוט עף לכיוון אבן השפה."
  },
  {
   "start": 79.32,
   "end": 79.92,
   "text": "היא נפגעת"
  },
  {
   "start": 81.26,
   "end": 82.68,
   "text": "בצורה קשה מאוד,"
  },
  {
   "start": 83.22,
   "end": 86.74,
   "text": "ולצוות הרפוי שמגיע למקום לא נותר לה לקבוע את מותה."
  },
  {
   "start": 89.73,
   "end": 92.53,
   "text": "זמן קצר אחרי שנקבע מותה התברר שאותה אישה היא ערירית."
  },
  {
   "start": 93.37,
   "end": 95.05,
   "text": "אין לה שום קרוב."
  },
  {
   "start": 95.93,
   "end": 97.39,
   "text": "אין לה שום קרוב. אישה בודדה,"
  },
  {
   "start": 97.99,
   "end": 100.77,
   "text": "ללא משפחה, ללא איש שיכול לעזור לה."
  },
  {
   "start": 103.27,
   "end": 104.77,
   "text": "מגיעים נציגי המכון הפותולוגי,"
  },
  {
   "start": 105.47,
   "end": 106.49,
   "text": "רוצים לקחת את הגופה,"
  },
  {
   "start": 107.31,
   "end": 109.09,
   "text": "אם זה לצורך ניתוח, אם זה לצורך בדיקה,"
  },
  {
   "start": 110.05,
   "end": 114.87,
   "text": "ממה בדיוק היא מתה, האם מהמכה של הרכב, האם מהפגיעה בבן השפה,"
  },
  {
   "start": 115.51,
   "end": 117.71,
   "text": "אבל בינתיים, בינתיים בבני ברק"
  },
  {
   "start": 118.41,
   "end": 119.65,
   "text": "מתפשטת לה השמועה."
  },
  {
   "start": 122.09,
   "end": 122.81,
   "text": "מה השמועה?"
  },
  {
   "start": 124.15,
   "end": 125.25,
   "text": "יש מת מצווה."
  },
  {
   "start": 131.51,
   "end": 132.33,
   "text": "יש מת מצווה."
  },
  {
   "start": 133.99,
   "end": 134.49,
   "text": "צריך לדעת"
  },
  {
   "start": 135.27,
   "end": 136.93,
   "text": "מה זה מת מצווה ביהדות?"
  },
  {
   "start": 137.53,
   "end": 140.97,
   "text": "כבוד האדם אצל הקדוש ברוך הוא זה ערך עליון."
  },
  {
   "start": 141.87,
   "end": 142.97,
   "text": "לא רק שהוא חי,"
  },
  {
   "start": 143.75,
   "end": 145.71,
   "text": "גם כשאדם נפטר מן העולם."
  },
  {
   "start": 148.29,
   "end": 150.99,
   "text": "וכאשר יש אדם שנפטר מן העולם,"
  },
  {
   "start": 151.29,
   "end": 154.21,
   "text": "והיא הפחות ביותר בישראל, ואין מי שיקבור אותו,"
  },
  {
   "start": 154.59,
   "end": 155.65,
   "text": "עוזבים את הכול."
  },
  {
   "start": 156.25,
   "end": 157.49,
   "text": "מצווה כל כך חשובה,"
  },
  {
   "start": 157.79,
   "end": 160.59,
   "text": "עוזבים את הכל והולכים לטפל בקבורה שלו."
  },
  {
   "start": 162.01,
   "end": 162.57,
   "text": "עד כך"
  },
  {
   "start": 163.77,
   "end": 168.01,
   "text": "שאם דוגמה יש בתקופת בית המקדש, בתקופת בית המקדש היה בא הכהנים,"
  },
  {
   "start": 168.47,
   "end": 170.61,
   "text": "הכהן התפקיד שלו היה לכפר על עם ישראל,"
  },
  {
   "start": 171.59,
   "end": 173.91,
   "text": "וכהן שעושה את הדרך אל בית המקדש,"
  },
  {
   "start": 176.66,
   "end": 177.8,
   "text": "והוא צריך את כולו טהור,"
  },
  {
   "start": 178.22,
   "end": 181.1,
   "text": "והוא הולך בדרך לבית המקדש ולפתע הוא ראה על אם הדרך,"
  },
  {
   "start": 182.8,
   "end": 184.62,
   "text": "שוכב לו אדם חסר בית,"
  },
  {
   "start": 185.52,
   "end": 188.52,
   "text": "מת, נפטר מן העולם, ואין מי שיטפל בו רק הוא."
  },
  {
   "start": 189.74,
   "end": 191.42,
   "text": "אז הוא עוזב את בית המקדש כרגע."
  },
  {
   "start": 192.06,
   "end": 194.16,
   "text": "עם ישראל יכול לחכות עם הכפרות."
  },
  {
   "start": 195.54,
   "end": 198.42,
   "text": "הוא ילך עכשיו ויטפל באותו מת מצווה."
  },
  {
   "start": 201.74,
   "end": 202.34,
   "text": "עד כדי כך"
  },
  {
   "start": 203.56,
   "end": 206.52,
   "text": "חשוב כבוד האדם לא רק בחייו,"
  },
  {
   "start": 207.18,
   "end": 208.54,
   "text": "גם אחרי מותו."
  },
  {
   "start": 216.25,
   "end": 217.51,
   "text": "וכשבבני ברק שמעו"
  },
  {
   "start": 218.63,
   "end": 222.79,
   "text": "שיש למעשה מת מצווה, אותה אישה, אין מי שיקבור אותה, אין מי שיטפל בה,"
  },
  {
   "start": 223.13,
   "end": 224.79,
   "text": "נחשבת בחזקת מת מצווה."
  },
  {
   "start": 229.98,
   "end": 232.68,
   "text": "השמועה התפשטה כאש בשדה קוצים,"
  },
  {
   "start": 233.26,
   "end": 234.1,
   "text": "ולאט לאט,"
  },
  {
   "start": 235.08,
   "end": 240.36,
   "text": "אבל בכמויות הולכות וגוברות, יצאו מן הבתים אנשים."
  },
  {
   "start": 240.92,
   "end": 242.94,
   "text": "התנדבו, אנחנו נטפל בזה, אנחנו נעשה את ההלוויה,"
  },
  {
   "start": 243.26,
   "end": 244.5,
   "text": "אנחנו נסדר את כל סידורי הקבורה,"
  },
  {
   "start": 244.92,
   "end": 246.48,
   "text": "אנחנו נסדר את כל סידורי הקבורה."
  },
  {
   "start": 246.9,
   "end": 249.24,
   "text": "יהודים טובים יצאו והתחילו לטפל בכל,"
  },
  {
   "start": 249.7,
   "end": 251.54,
   "text": "ובני ברק התארגנה להלוויה."
  },
  {
   "start": 252.54,
   "end": 253.2,
   "text": "מת מצווה,"
  },
  {
   "start": 253.92,
   "end": 256.0,
   "text": "ברוך השם היום בחסדי השם בארץ,"
  },
  {
   "start": 256.74,
   "end": 260.98,
   "text": "זו מצווה נדירה. רוב האנשים יש להם קרובים, יש להם מכרים, יש מי שיטפל."
  },
  {
   "start": 261.8,
   "end": 264.54,
   "text": "למצוא יהודייה שאין מי שיטפל בה,"
  },
  {
   "start": 265.5,
   "end": 270.94,
   "text": "זה נדיר מאוד, בבני ברק כולם רצו להשתתף במצווה הנדירה הזאת,"
  },
  {
   "start": 271.36,
   "end": 274.78,
   "text": "וכולם יוצאים מהבתים ונוהרים אל הרחובות,"
  },
  {
   "start": 275.46,
   "end": 277.1,
   "text": "אל ההלוויה הזו, הלוויה נדירה,"
  },
  {
   "start": 277.48,
   "end": 281.36,
   "text": "נדירה ומיוחדת עד לכך שגם גדולי ישראל, גדולי הדור בבני ברק,"
  },
  {
   "start": 281.84,
   "end": 287.54,
   "text": "שבדרך כלל לא יוצאים מבתיהם וגם לא להלוויות אלא למקרים נדירים ביותר, לא מבטלים רגע של תורה,"
  },
  {
   "start": 287.92,
   "end": 289.24,
   "text": "עזבו את הכל וסגרו,"
  },
  {
   "start": 289.56,
   "end": 290.46,
   "text": "סגרו את הגמרות,"
  },
  {
   "start": 290.54,
   "end": 291.5,
   "text": "סגרו את התורה,"
  },
  {
   "start": 291.98,
   "end": 294.68,
   "text": "ולמעשה באו להשתתף במצווה הנדירה הזו,"
  },
  {
   "start": 295.48,
   "end": 296.24,
   "text": "מת מצווה."
  },
  {
   "start": 298.28,
   "end": 299.32,
   "text": "וכולם יוצאים,"
  },
  {
   "start": 300.2,
   "end": 301.08,
   "text": "אלפי בני אדם,"
  },
  {
   "start": 301.76,
   "end": 303.5,
   "text": "לא אלפי, עשרות אלפי,"
  },
  {
   "start": 304.18,
   "end": 306.38,
   "text": "עשרות עשרות עשרות אלפי,"
  },
  {
   "start": 306.96,
   "end": 308.3,
   "text": "הלוויה ממלכתית,"
  },
  {
   "start": 309.28,
   "end": 310.4,
   "text": "עוצמה אדירה,"
  },
  {
   "start": 311.52,
   "end": 313.72,
   "text": "מלווים אישה שלא מכירים,"
  },
  {
   "start": 314.12,
   "end": 317.72,
   "text": "אישה יהודייה שרחוקה מתורה ומצוות שאין לה מי שיקבור אותה,"
  },
  {
   "start": 318.22,
   "end": 319.26,
   "text": "עריד בודדה,"
  },
  {
   "start": 319.7,
   "end": 320.48,
   "text": "כולם מלווים אותה."
  },
  {
   "start": 321.02,
   "end": 323.12,
   "text": "איזה כבוד, איזה עוצמה."
  },
  {
   "start": 324.7,
   "end": 326.68,
   "text": "וידוע, ככל שהלוויה יותר גדולה,"
  },
  {
   "start": 327.08,
   "end": 329.14,
   "text": "יש נחת למעשה לנפטר."
  },
  {
   "start": 332.11,
   "end": 332.79,
   "text": "זה מעיד,"
  },
  {
   "start": 333.31,
   "end": 335.35,
   "text": "מעיד על העוצמה של היהודי, של היהודייה."
  },
  {
   "start": 336.81,
   "end": 342.13,
   "text": "וככה ההלוויה יוצאת לדרך הלוויה מהגדולות ביותר שנערכו במדינת ישראל."
  },
  {
   "start": 348.48,
   "end": 349.22,
   "text": "בתום ההלוויה."
  },
  {
   "start": 351.53,
   "end": 352.23,
   "text": "בתום ההלוויה."
  },
  {
   "start": 354.21,
   "end": 355.99,
   "text": "פונים גדולי הדור אחד אל השני,"
  },
  {
   "start": 356.77,
   "end": 358.29,
   "text": "ואומרים,"
  },
  {
   "start": 359.81,
   "end": 360.47,
   "text": "משהו פה,"
  },
  {
   "start": 361.15,
   "end": 361.95,
   "text": "משהו פה לא הגיוני,"
  },
  {
   "start": 362.93,
   "end": 363.73,
   "text": "משהו פה קצת,"
  },
  {
   "start": 365.82,
   "end": 366.5,
   "text": "קצת שונה."
  },
  {
   "start": 368.56,
   "end": 369.1,
   "text": "אם אני לא טועה,"
  },
  {
   "start": 369.54,
   "end": 371.42,
   "text": "אם אני לא טועה, היו גדולי הדור החזון איש והסטייפלר,"
  },
  {
   "start": 376.73,
   "end": 377.59,
   "text": "ואם זה כך,"
  },
  {
   "start": 380.3,
   "end": 381.9,
   "text": "אז אומר החזון איש לסטייפלר,"
  },
  {
   "start": 382.84,
   "end": 383.5,
   "text": "כבוד הרב,"
  },
  {
   "start": 384.54,
   "end": 387.46,
   "text": "כבוד הרב, איך אותה אישה, אף אחד לא מכיר אותה, איך אותה אישה,"
  },
  {
   "start": 387.84,
   "end": 390.74,
   "text": "הבנתי שהיא כנראה הייתה רחוקה מתורה ומצוות,"
  },
  {
   "start": 390.82,
   "end": 394.4,
   "text": "איך היא זכתה להלוויה שתלמידי חכמים לא זוכים לה,"
  },
  {
   "start": 394.92,
   "end": 398.76,
   "text": "שאנשים בציבור הישראלי לא זוכים לה,"
  },
  {
   "start": 399.06,
   "end": 404.7,
   "text": "חברי כנסת, שרים, כל מיני אנשים שמטבע הדברים צריכים ללוות אותם במדינת ישראל,"
  },
  {
   "start": 405.36,
   "end": 413.7,
   "text": "לא מלווים אותם כל כך הרבה. איך היא זכתה להוציא כמעט כל בני ברק לרחובות להלוויה ממלכתית, כזה דבר כל כך גדול, איזו עוצמה."
  },
  {
   "start": 414.24,
   "end": 415.66,
   "text": "משהו פה, צריך לברר"
  },
  {
   "start": 416.4,
   "end": 421.22,
   "text": "בזכות מה אותה אישה זכתה לכל כך הרבה כבוד אחרי מותה?"
  },
  {
   "start": 423.96,
   "end": 426.52,
   "text": "אולי כבוד הרב יוכל לשלוח כמה בחורים לברר?"
  },
  {
   "start": 426.96,
   "end": 428.98,
   "text": "לעשות קצת תחקיר קצר, לברר?"
  },
  {
   "start": 431.66,
   "end": 433.82,
   "text": "ונשלחו בחורים לברר."
  },
  {
   "start": 434.62,
   "end": 436.42,
   "text": "איך יכול להיות שאישה"
  },
  {
   "start": 437.02,
   "end": 437.98,
   "text": "שאיש לא מכיר אותה,"
  },
  {
   "start": 438.78,
   "end": 441.94,
   "text": "שאישה שאין לה קרובי משפחה, שאישה"
  },
  {
   "start": 446.65,
   "end": 453.59,
   "text": "תזכה להלוויה שזוכים אנשים מאוד מאוד מיוחדים?"
  },
  {
   "start": 454.15,
   "end": 456.07,
   "text": "מה המיוחד באותה אישה מסתובבות?"
  },
  {
   "start": 459.88,
   "end": 462.88,
   "text": "זמן מה אחר כך מתבררת לה התעלומה."
  },
  {
   "start": 489.91,
   "end": 490.35,
   "text": "מתברר."
  },
  {
   "start": 491.25,
   "end": 491.89,
   "text": "מתברר"
  },
  {
   "start": 493.39,
   "end": 494.33,
   "text": "שאותה אישה,"
  },
  {
   "start": 495.05,
   "end": 500.29,
   "text": "כך סיפרו שכנים ניצולי שואה שהיו, גרו בסמוך אליהם, הכירו אותה."
  },
  {
   "start": 501.75,
   "end": 503.27,
   "text": "אותה אישה הייתה ניצולת שואה."
  },
  {
   "start": 505.03,
   "end": 505.91,
   "text": "אותה אישה הייתה"
  },
  {
   "start": 506.97,
   "end": 509.91,
   "text": "בתקופת השואה במחנה, במחנה ברגן בלזן."
  },
  {
   "start": 512.56,
   "end": 513.48,
   "text": "ושם במחנה"
  },
  {
   "start": 516.09,
   "end": 517.81,
   "text": "יש דבר אחד שעליו היא הקפידה,"
  },
  {
   "start": 518.79,
   "end": 521.35,
   "text": "יש דבר אחד שבו היא התפרסמה והצטיינה בו."
  },
  {
   "start": 522.21,
   "end": 523.41,
   "text": "כאשר היא הייתה רואה"
  },
  {
   "start": 524.09,
   "end": 524.61,
   "text": "גופה"
  },
  {
   "start": 525.23,
   "end": 526.65,
   "text": "של בת ישראל,"
  },
  {
   "start": 527.21,
   "end": 530.09,
   "text": "של יהודייה שנפטרה והמוות שם היה משתולל,"
  },
  {
   "start": 530.87,
   "end": 532.59,
   "text": "וכל יום הייתה גופה חדשה,"
  },
  {
   "start": 533.23,
   "end": 537.05,
   "text": "אבל כשהיא הייתה רואה גופה של בת ישראל מוטלת ככה"
  },
  {
   "start": 538.61,
   "end": 540.15,
   "text": "בריש גלי ברחובות,"
  },
  {
   "start": 541.99,
   "end": 542.95,
   "text": "מתבזה,"
  },
  {
   "start": 543.71,
   "end": 544.35,
   "text": "היא לא הייתה"
  },
  {
   "start": 545.19,
   "end": 546.31,
   "text": "יושבת רקם."
  },
  {
   "start": 547.51,
   "end": 548.51,
   "text": "היא הייתה הולכת"
  },
  {
   "start": 549.33,
   "end": 553.65,
   "text": "ולוקחת עט ומהדר וחופרת קבר וקוברת."
  },
  {
   "start": 554.81,
   "end": 555.75,
   "text": "וכשלא היה,"
  },
  {
   "start": 556.05,
   "end": 557.07,
   "text": "כשלא היה מהדר,"
  },
  {
   "start": 557.39,
   "end": 560.63,
   "text": "כשלא היה עט, היא הייתה עושה את זה עם גזרי עץ,"
  },
  {
   "start": 561.73,
   "end": 562.27,
   "text": "עם עץ,"
  },
  {
   "start": 562.89,
   "end": 565.13,
   "text": "כל מיני קרשים שהיא מצאה."
  },
  {
   "start": 565.55,
   "end": 571.07,
   "text": "היא הייתה חופרת עם קרשים שהיא מצאה, חופרת קבר לאותה גופה,"
  },
  {
   "start": 571.45,
   "end": 573.65,
   "text": "לאותה יהודייה מת מצווה."
  },
  {
   "start": 574.79,
   "end": 580.51,
   "text": "וכאשר לא היה גם קרשים לא היה במה לחפור את החופרת בציפורניים, אבל היא הייתה עושה קבר."
  },
  {
   "start": 580.89,
   "end": 583.83,
   "text": "היא לא תיתן לבת ישראל לגוף שלה להתבזות."
  },
  {
   "start": 585.05,
   "end": 590.81,
   "text": "היה משהו פנימי מניע אותה, אני לא אתן לבזות את בת ישראל אחרי המוות הנדאג לחסד של אנט."
  },
  {
   "start": 593.68,
   "end": 594.66,
   "text": "אמרו גדולי הדור,"
  },
  {
   "start": 596.12,
   "end": 599.16,
   "text": "עכשיו מובן הכל, לחיל הים יש מכם,"
  },
  {
   "start": 600.2,
   "end": 603.78,
   "text": "לחיל האוויר יש מכם, גם לבורא עולם יש מכם."
  },
  {
   "start": 604.18,
   "end": 608.32,
   "text": "המקאם של בורא עולם זה ראשי תיבות מקאם מידה כנגד מידה."
  },
  {
   "start": 609.06,
   "end": 609.82,
   "text": "בא בורא עולם,"
  },
  {
   "start": 610.32,
   "end": 611.2,
   "text": "רואה את הבת שלו,"
  },
  {
   "start": 611.68,
   "end": 615.06,
   "text": "שם בלב התופת דואגת לאחיות שלה."
  },
  {
   "start": 615.76,
   "end": 617.28,
   "text": "דואגת לאחיות שלה,"
  },
  {
   "start": 617.82,
   "end": 619.04,
   "text": "דואגת לילדות שלי."
  },
  {
   "start": 619.7,
   "end": 621.62,
   "text": "אומר בורא עולם, את דואגת לילדות שלי."
  },
  {
   "start": 622.12,
   "end": 625.36,
   "text": "את דואגת לילדות שלי שלא יתבזו אחרי מותם."
  },
  {
   "start": 626.66,
   "end": 627.5,
   "text": "אני אמתין לך,"
  },
  {
   "start": 628.18,
   "end": 629.1,
   "text": "ואני אדאג לזה,"
  },
  {
   "start": 629.52,
   "end": 631.2,
   "text": "כשיבוא יום אחד יום הפטירה שלך,"
  },
  {
   "start": 631.36,
   "end": 633.44,
   "text": "אפילו שאין לך אף אחד בעולם,"
  },
  {
   "start": 634.34,
   "end": 636.4,
   "text": "אני אדאג לך להלוויה ממלכתית,"
  },
  {
   "start": 636.78,
   "end": 638.38,
   "text": "להלוויה שלא הייתה כמותה,"
  },
  {
   "start": 638.72,
   "end": 639.8,
   "text": "כי את דאגת,"
  },
  {
   "start": 640.2,
   "end": 642.32,
   "text": "את התאמץ בשביל הילדות שלי."
  },
  {
   "start": 643.66,
   "end": 644.36,
   "text": "אני אדאג לך,"
  },
  {
   "start": 644.92,
   "end": 645.74,
   "text": "שם במחנות,"
  },
  {
   "start": 646.18,
   "end": 646.86,
   "text": "שם במוות,"
  },
  {
   "start": 647.2,
   "end": 648.5,
   "text": "שם בברגן בלזן,"
  },
  {
   "start": 648.82,
   "end": 650.38,
   "text": "אותה אישה כשהיא חפרה קברים,"
  },
  {
   "start": 650.72,
   "end": 652.74,
   "text": "היא לא חשבה על שכר."
  },
  {
   "start": 654.06,
   "end": 656.16,
   "text": "היא ידעה שהיא מתאמצת ומתאמצת,"
  },
  {
   "start": 657.02,
   "end": 657.84,
   "text": "פשוט לא לצייר."
  },
  {
   "start": 657.84,
   "end": 661.8,
   "text": "את החברה של הבת ישראל."
  },
  {
   "start": 664.05,
   "end": 665.25,
   "text": "בא בורא עולם ואומר,"
  },
  {
   "start": 665.81,
   "end": 666.47,
   "text": "כל היגיעה,"
  },
  {
   "start": 666.85,
   "end": 669.85,
   "text": "כל המאמצים, כל הזיעה שהשקעת, כל מה שהשקעת,"
  },
  {
   "start": 670.33,
   "end": 671.59,
   "text": "לא לריק, לא לריק."
  },
  {
   "start": 672.41,
   "end": 675.87,
   "text": "כבר בעולם הזה יראו איזה שכר יש לך בעולם הבא."
  },
  {
   "start": 681.92,
   "end": 685.1,
   "text": "כך אומר המדרש, תלמוד ירושלמי, מסכת עבודה זרה,"
  },
  {
   "start": 685.56,
   "end": 686.5,
   "text": "דף דף עמוד א',"
  },
  {
   "start": 687.02,
   "end": 690.38,
   "text": "כשהראו לרבי אבהו את השכר הצפון לו בגן עדן,"
  },
  {
   "start": 690.56,
   "end": 692.94,
   "text": "בכר רבי אבו ואמר, ואני אמרתי,"
  },
  {
   "start": 693.48,
   "end": 695.04,
   "text": "ואני אמרתי לארי כי הגעתי."
  },
  {
   "start": 695.78,
   "end": 698.34,
   "text": "הוא חשב שכל המאמצים שלו,"
  },
  {
   "start": 699.44,
   "end": 702.34,
   "text": "כל הדברים שהוא עשה במהלך חייו לכבוד השם,"
  },
  {
   "start": 703.54,
   "end": 705.5,
   "text": "אבל אפילו שלא נראים ממש מצוות,"
  },
  {
   "start": 707.0,
   "end": 707.94,
   "text": "אולי אין על זה שכר."
  },
  {
   "start": 708.64,
   "end": 711.48,
   "text": "מתברר שעל כל דבר שאתה עושה, כל צעד"
  },
  {
   "start": 712.02,
   "end": 713.98,
   "text": "שאת עושה, יש שכר."
  },
  {
   "start": 714.54,
   "end": 715.4,
   "text": "עם אותה אישה,"
  },
  {
   "start": 715.92,
   "end": 719.24,
   "text": "עם אותה אישה בברגן-בלזן, על קבורה היא מקבלת כך."
  },
  {
   "start": 719.62,
   "end": 724.74,
   "text": "כמה אישה, כמה גבר יקבל על חיים שהוא דואג לכבוד השם יתברך,"
  },
  {
   "start": 725.12,
   "end": 729.18,
   "text": "כמה אישה תקבל על זה שהיא תדאג לילדים, להביא חיים לעולם,"
  },
  {
   "start": 729.56,
   "end": 733.2,
   "text": "לגדל חיים בעולם, כמה גבר ידאג על חיים בעולם,"
  },
  {
   "start": 734.06,
   "end": 737.26,
   "text": "כמה גבר יקבל על כל מה שהוא עושה לכבוד השם יתברך."
  }
 ]
}