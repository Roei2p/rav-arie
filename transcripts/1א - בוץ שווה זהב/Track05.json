{
 "disc": "1א - בוץ שווה זהב",
 "track": "Track05",
 "duration": 1250.184,
 "segments": [
  {
   "start": 15.6,
   "end": 17.32,
   "text": "רבי ישראל מרוז'ין התארח,"
  },
  {
   "start": 20.2,
   "end": 22.34,
   "text": "התארח יום אחד אצל אחד מהחסידים שלו."
  },
  {
   "start": 23.26,
   "end": 24.14,
   "text": "היה זה גביר עשיר."
  },
  {
   "start": 27.45,
   "end": 29.35,
   "text": "כשרבי ישראל מרוז'ין הגיע לאותו כפיר,"
  },
  {
   "start": 29.81,
   "end": 30.45,
   "text": "אל אותו גביר,"
  },
  {
   "start": 31.91,
   "end": 33.81,
   "text": "כשרבי ישראל מרוז'ין הגיע לאותו גביר,"
  },
  {
   "start": 36.55,
   "end": 37.75,
   "text": "היה זה עניין של זמן,"
  },
  {
   "start": 38.95,
   "end": 42.05,
   "text": "שבמקום פשטה השמועה שהאדמו״ר מרוז'ין נמצא,"
  },
  {
   "start": 43.25,
   "end": 46.81,
   "text": "וקהל רב החל צובא על פתח הבית,"
  },
  {
   "start": 48.43,
   "end": 49.07,
   "text": "בחוץ."
  },
  {
   "start": 51.81,
   "end": 55.35,
   "text": "נערם לו שלג קל מכסה את פני האדמה,"
  },
  {
   "start": 56.75,
   "end": 57.73,
   "text": "ועשרות הפונים,"
  },
  {
   "start": 58.61,
   "end": 61.19,
   "text": "עשרות הממתינים להיכנס אל הרב,"
  },
  {
   "start": 65.32,
   "end": 67.88,
   "text": "נוצר מצב שהנעליים שלהם,"
  },
  {
   "start": 70.52,
   "end": 76.0,
   "text": "שדרכו באדמה שנרטבה מהשלג,"
  },
  {
   "start": 77.6,
   "end": 81.0,
   "text": "לכלכו את השטיחים בבית המפואר של הגביר."
  },
  {
   "start": 81.86,
   "end": 84.3,
   "text": "בבית של הגביר, הגביר אהב שטיחים,"
  },
  {
   "start": 84.78,
   "end": 87.06,
   "text": "הוא כיסה את כל הרצפה בשטיחים,"
  },
  {
   "start": 87.62,
   "end": 91.42,
   "text": "שטיחים יוקרתיים, ואותם שטיחים התמלאו להם"
  },
  {
   "start": 93.34,
   "end": 93.98,
   "text": "בבוץ."
  },
  {
   "start": 94.94,
   "end": 95.62,
   "text": "המשרתים,"
  },
  {
   "start": 96.3,
   "end": 97.42,
   "text": "המשרתים שראו את זה,"
  },
  {
   "start": 98.04,
   "end": 99.26,
   "text": "לא יכלו להחזיק מעמד."
  },
  {
   "start": 99.64,
   "end": 100.38,
   "text": "הם פנו אל הגביר,"
  },
  {
   "start": 101.08,
   "end": 101.72,
   "text": "ביקשו ממנו."
  },
  {
   "start": 102.84,
   "end": 104.92,
   "text": "אדוני הגביר, תראה מזה לכלוך,"
  },
  {
   "start": 105.24,
   "end": 106.0,
   "text": "תראה את השטיחים,"
  },
  {
   "start": 106.48,
   "end": 108.14,
   "text": "כמה זמן ייקח לנקות אותם,"
  },
  {
   "start": 108.44,
   "end": 109.76,
   "text": "תראה איך הבית נראה."
  },
  {
   "start": 111.06,
   "end": 111.68,
   "text": "והגביר,"
  },
  {
   "start": 112.82,
   "end": 116.2,
   "text": "הגביר הוא הוראה,"
  },
  {
   "start": 117.32,
   "end": 118.56,
   "text": "הוראה חד משמעית."
  },
  {
   "start": 119.04,
   "end": 122.7,
   "text": "לסגור, לסגור את שערי הבית בפני הפונים."
  },
  {
   "start": 128.88,
   "end": 136.88,
   "text": "והבית ששימש לפני דקות מספר למוקד לשפיכת לב,"
  },
  {
   "start": 137.36,
   "end": 142.22,
   "text": "מוקד לתקוות של יהודים שביקשו ברכה ישועה מאדמו מרוז'ין,"
  },
  {
   "start": 143.16,
   "end": 144.54,
   "text": "שעריו ננעלו בפניהם."
  },
  {
   "start": 155.26,
   "end": 155.76,
   "text": "הייתה שם,"
  },
  {
   "start": 156.66,
   "end": 158.02,
   "text": "הייתה שם משרתת יהודייה,"
  },
  {
   "start": 159.22,
   "end": 162.04,
   "text": "משרתת צעירה לימים, יהודייה."
  },
  {
   "start": 162.04,
   "end": 166.28,
   "text": "בין כל המשרתים הגויים, ולה כאב."
  },
  {
   "start": 167.98,
   "end": 169.72,
   "text": "כאב לה על הצער"
  },
  {
   "start": 170.92,
   "end": 172.2,
   "text": "של אותם עשרות יהודים,"
  },
  {
   "start": 173.28,
   "end": 178.06,
   "text": "גברים ונשים שרוצים להיכנס לפגוש את הרב,"
  },
  {
   "start": 178.56,
   "end": 183.42,
   "text": "ואינם יכולים, אינם יכולים להיכנס ולשטוח את הבעיות שלהם בפני הרב."
  },
  {
   "start": 190.3,
   "end": 191.18,
   "text": "אז היא המתינה לשעת כושר,"
  },
  {
   "start": 192.64,
   "end": 193.8,
   "text": "וכשהשעת כושר הזאת הגיעה,"
  },
  {
   "start": 194.92,
   "end": 200.62,
   "text": "היא ניצלה איזה רגע מזדמן שאף אחד לא ראה"
  },
  {
   "start": 201.48,
   "end": 203.1,
   "text": "וסיפרה, סיפרה לרב"
  },
  {
   "start": 204.96,
   "end": 208.16,
   "text": "על שעה ששערי הבית נסגרו בפני הפונים,"
  },
  {
   "start": 209.22,
   "end": 211.32,
   "text": "והמון יהודים, המון יהודים,"
  },
  {
   "start": 211.8,
   "end": 216.4,
   "text": "נשים, גברים וילדים רוצים לדבר עם הרב ואינם יכולים,"
  },
  {
   "start": 217.2,
   "end": 218.12,
   "text": "והם כל כך מאוכזבים."
  },
  {
   "start": 220.63,
   "end": 221.53,
   "text": "הרב שמע את זה."
  },
  {
   "start": 222.99,
   "end": 224.61,
   "text": "אחר כך הוא ביקש לקרוא לגביר."
  },
  {
   "start": 226.27,
   "end": 226.95,
   "text": "הגביר הגיע,"
  },
  {
   "start": 229.03,
   "end": 230.31,
   "text": "וכשהגביר הגביע הוא אומר לו,"
  },
  {
   "start": 230.89,
   "end": 234.85,
   "text": "יהודי יקר, אתה מארח אותי בבית שלך,"
  },
  {
   "start": 235.77,
   "end": 237.99,
   "text": "יהיה אכפת לך לשמוע ממני סיפור,"
  },
  {
   "start": 238.49,
   "end": 239.93,
   "text": "אני רוצה לספר לך סיפור?"
  },
  {
   "start": 241.23,
   "end": 245.07,
   "text": "והגביר שמח, אמר ודאי כבוד הרב,"
  },
  {
   "start": 245.71,
   "end": 249.11,
   "text": "בוא נשב, אשמח מאוד לשמוע סיפור מכבוד הרב."
  },
  {
   "start": 259.61,
   "end": 263.67,
   "text": "והרב התחיל לספר, הרב התחיל לספר."
  },
  {
   "start": 266.42,
   "end": 267.38,
   "text": "לפני עשרות שנים,"
  },
  {
   "start": 272.17,
   "end": 273.57,
   "text": "זה היה לפני עשרות שנים, השיר,"
  },
  {
   "start": 274.59,
   "end": 278.11,
   "text": "יהודי השיר, היה בדרך הביתה, אחרי מסע עסקים"
  },
  {
   "start": 278.73,
   "end": 279.35,
   "text": "די מוצלח."
  },
  {
   "start": 281.9,
   "end": 283.18,
   "text": "הוא נסע לו בתוך כרכרה,"
  },
  {
   "start": 285.0,
   "end": 286.08,
   "text": "כרכרה פרטית שלו,"
  },
  {
   "start": 287.1,
   "end": 287.7,
   "text": "בחוץ,"
  },
  {
   "start": 289.06,
   "end": 291.84,
   "text": "בחוץ השתוללה לאסופת שלגים."
  },
  {
   "start": 295.43,
   "end": 295.69,
   "text": "והוא,"
  },
  {
   "start": 297.61,
   "end": 299.79,
   "text": "והוא יושב לו בכרכרה מהודרת וחמימה,"
  },
  {
   "start": 301.03,
   "end": 301.61,
   "text": "חוצה,"
  },
  {
   "start": 302.29,
   "end": 304.19,
   "text": "חוצה יערות, חוצה חורשות,"
  },
  {
   "start": 305.75,
   "end": 308.31,
   "text": "כנגד הרוחות המשתוללות בחוץ,"
  },
  {
   "start": 309.43,
   "end": 311.15,
   "text": "מבקש להגיע כמה שיותר מהר הביתה."
  },
  {
   "start": 315.14,
   "end": 315.58,
   "text": "אבל אז,"
  },
  {
   "start": 316.46,
   "end": 319.32,
   "text": "כך באמצע הלילה, לפתע הוא שומע זעקות."
  },
  {
   "start": 320.44,
   "end": 323.44,
   "text": "זעקות ייללות של כאב, של צער."
  },
  {
   "start": 325.94,
   "end": 326.98,
   "text": "אז השיר לא היסס."
  },
  {
   "start": 328.12,
   "end": 329.26,
   "text": "היה לו לב רחום וחנון."
  },
  {
   "start": 329.66,
   "end": 331.72,
   "text": "הוא ביקש, הוא ביקש מהרכב שלו,"
  },
  {
   "start": 332.24,
   "end": 332.92,
   "text": "מהעגלון,"
  },
  {
   "start": 333.54,
   "end": 334.82,
   "text": "לעצור."
  },
  {
   "start": 337.04,
   "end": 338.16,
   "text": "אולי זה יהודי בצרה."
  },
  {
   "start": 339.14,
   "end": 339.86,
   "text": "תעצור שנייה."
  },
  {
   "start": 340.98,
   "end": 341.82,
   "text": "הוא הטה אוזן."
  },
  {
   "start": 342.74,
   "end": 343.5,
   "text": "וכששוב,"
  },
  {
   "start": 344.28,
   "end": 345.2,
   "text": "כששוב הוא שמע"
  },
  {
   "start": 346.2,
   "end": 347.5,
   "text": "את הקולות, את הזעקות,"
  },
  {
   "start": 348.24,
   "end": 349.68,
   "text": "הפעם באופן ברור יותר,"
  },
  {
   "start": 350.6,
   "end": 351.32,
   "text": "קרוב יותר."
  },
  {
   "start": 353.14,
   "end": 354.46,
   "text": "הוא החל לעשות מעשה."
  },
  {
   "start": 355.6,
   "end": 358.4,
   "text": "הוא ביקש מהרכב להתקדם עוד קצת לכיוון מקור הצעקות,"
  },
  {
   "start": 359.26,
   "end": 360.9,
   "text": "אמר לרכב שלו, תמתין כאן."
  },
  {
   "start": 362.12,
   "end": 363.32,
   "text": "ואז הוא ירד מהקיר קרה,"
  },
  {
   "start": 366.19,
   "end": 370.39,
   "text": "והחל פוסע בקור בשלג בעקבות הקולות."
  },
  {
   "start": 371.93,
   "end": 372.43,
   "text": "כך הוא פסע,"
  },
  {
   "start": 374.6,
   "end": 375.26,
   "text": "הוא לא היה צריך ללכת."
  },
  {
   "start": 376.44,
   "end": 376.88,
   "text": "הרבה."
  },
  {
   "start": 377.7,
   "end": 379.54,
   "text": "לפתע נגלה לעיניו מחזה,"
  },
  {
   "start": 380.98,
   "end": 383.68,
   "text": "מחזה לא כל כך נעים."
  },
  {
   "start": 384.52,
   "end": 386.08,
   "text": "היה זה יהודי, באמת יהודי,"
  },
  {
   "start": 386.68,
   "end": 388.28,
   "text": "יהודי מוכר ספרים עני,"
  },
  {
   "start": 389.56,
   "end": 394.97,
   "text": "עם עגלה שבנויה טלאים-טלאים,"
  },
  {
   "start": 395.49,
   "end": 400.14,
   "text": "עם סוס בודד,"
  },
  {
   "start": 400.98,
   "end": 401.92,
   "text": "והסוס שלו,"
  },
  {
   "start": 402.88,
   "end": 404.16,
   "text": "שפסל לו בשלג,"
  },
  {
   "start": 404.54,
   "end": 408.04,
   "text": "נפל בתוך בור שכוסב על ידי שלג,"
  },
  {
   "start": 409.02,
   "end": 409.92,
   "text": "והוא לא יכול להוציא אותו."
  },
  {
   "start": 412.68,
   "end": 413.18,
   "text": "ויהודי,"
  },
  {
   "start": 413.96,
   "end": 415.48,
   "text": "יהודי יושב על הסוס ובוכה,"
  },
  {
   "start": 416.1,
   "end": 416.96,
   "text": "מכוסה שלג,"
  },
  {
   "start": 419.16,
   "end": 421.06,
   "text": "לא יודע מה לעשות הספרים שלו בצד."
  },
  {
   "start": 423.92,
   "end": 425.42,
   "text": "הסוס במצב איום,"
  },
  {
   "start": 426.14,
   "end": 429.08,
   "text": "והוא חסר אונים פשוט זועק, זועק לעזרה."
  },
  {
   "start": 430.06,
   "end": 430.54,
   "text": "העשיר,"
  },
  {
   "start": 431.48,
   "end": 432.54,
   "text": "העשיר לא חיכה הרבה,"
  },
  {
   "start": 434.9,
   "end": 435.78,
   "text": "הוא לא חיכה הרבה,"
  },
  {
   "start": 437.81,
   "end": 439.51,
   "text": "הוא פשוט עשה מעשה."
  },
  {
   "start": 444.08,
   "end": 445.28,
   "text": "העשיר שינס את מותניו,"
  },
  {
   "start": 447.67,
   "end": 448.83,
   "text": "הרים את היהודי האומלל,"
  },
  {
   "start": 449.85,
   "end": 453.05,
   "text": "תוך כדי כך שהוא מלכלך את פרוות המינק היוקרתית שלו."
  },
  {
   "start": 454.07,
   "end": 458.15,
   "text": "והחל לנושא אותו בכל כוחו אל עבר הכרכרה."
  },
  {
   "start": 461.53,
   "end": 463.53,
   "text": "כשהוא הניח את היהודי בכרכרה החמימה,"
  },
  {
   "start": 464.67,
   "end": 466.89,
   "text": "הוא כבר רצה לתת פקודה לרכב לנסוע,"
  },
  {
   "start": 468.35,
   "end": 471.31,
   "text": "אבל הוראת העני בוכה."
  },
  {
   "start": 472.77,
   "end": 474.89,
   "text": "אז הוא אומר לו, תגיד לי, יהודי יקר, למה אתה בוכה?"
  },
  {
   "start": 475.59,
   "end": 477.49,
   "text": "למה אתה בוכה? הרי ניצלת."
  },
  {
   "start": 480.2,
   "end": 480.9,
   "text": "והיהודי אומר לו,"
  },
  {
   "start": 481.46,
   "end": 484.9,
   "text": "כן, אבל הספרים שלי, הסחורה שלי,"
  },
  {
   "start": 485.28,
   "end": 486.9,
   "text": "שם בחוץ בשלג,"
  },
  {
   "start": 488.28,
   "end": 490.1,
   "text": "אין לי כסף לגנות סחורה חדשה,"
  },
  {
   "start": 491.04,
   "end": 492.66,
   "text": "זו הפרנסה שלי, אני צריך למכור."
  },
  {
   "start": 493.64,
   "end": 495.66,
   "text": "והספרים שלי בשלג, איך אני לא אבכה."
  },
  {
   "start": 497.12,
   "end": 500.48,
   "text": "העשיר הביט ואמר,"
  },
  {
   "start": 502.18,
   "end": 503.1,
   "text": "טוב תמתין כאן."
  },
  {
   "start": 504.64,
   "end": 505.4,
   "text": "והוא שוב יצא,"
  },
  {
   "start": 506.06,
   "end": 506.46,
   "text": "החוצה,"
  },
  {
   "start": 507.44,
   "end": 509.12,
   "text": "אל הקור, אל השלג,"
  },
  {
   "start": 510.02,
   "end": 510.72,
   "text": "אל הבוץ,"
  },
  {
   "start": 511.32,
   "end": 514.5,
   "text": "מבוסס את דרכו בבוץ מעורב בשלג קל,"
  },
  {
   "start": 515.12,
   "end": 516.46,
   "text": "שכיסה את פני הקרקע,"
  },
  {
   "start": 516.46,
   "end": 519.06,
   "text": "והפך אותה לבוצית."
  },
  {
   "start": 521.26,
   "end": 524.36,
   "text": "אבל העשיר כבר לא היה אכפת לו על הנעליים שמתלכלכות,"
  },
  {
   "start": 525.0,
   "end": 527.1,
   "text": "על המכנסיים שמתלכלכות,"
  },
  {
   "start": 527.66,
   "end": 528.56,
   "text": "על פרוות המינג."
  },
  {
   "start": 529.4,
   "end": 533.14,
   "text": "הוא חיפש את הספרים, הוא רצה כבר ללכת הביתה."
  },
  {
   "start": 534.88,
   "end": 536.32,
   "text": "עד מהרה הוא מצא את שקית הספרים."
  },
  {
   "start": 544.76,
   "end": 547.1,
   "text": "עד מהרה הוא מצא את שקית הספרים קצת רטובים,"
  },
  {
   "start": 547.8,
   "end": 549.08,
   "text": "אבל עדיין במצב טוב."
  },
  {
   "start": 550.1,
   "end": 551.66,
   "text": "כך הוא החל מבוסס את דרכו חזרה,"
  },
  {
   "start": 552.4,
   "end": 553.04,
   "text": "הנה הספרים."
  },
  {
   "start": 554.16,
   "end": 554.7,
   "text": "בואו ניסע."
  },
  {
   "start": 556.28,
   "end": 557.0,
   "text": "אבל היהודי,"
  },
  {
   "start": 557.84,
   "end": 559.2,
   "text": "דמעות עדיין בעיניו,"
  },
  {
   "start": 560.04,
   "end": 563.9,
   "text": "והעשיר רחמיו נכמרו עליו. אני אומר לו, תגידי, למה עכשיו אתה בוכה?"
  },
  {
   "start": 564.86,
   "end": 565.72,
   "text": "אמר לו, הסוס,"
  },
  {
   "start": 566.84,
   "end": 567.88,
   "text": "הסוס של ישען,"
  },
  {
   "start": 568.56,
   "end": 570.5,
   "text": "בלעדיו איך אני אתפרנס?"
  },
  {
   "start": 571.04,
   "end": 577.82,
   "text": "אני לא אבכה, כל המזונות שלי, כל הפרנסה שלי הלכה לאיבוד."
  },
  {
   "start": 578.78,
   "end": 579.42,
   "text": "והעשיר,"
  },
  {
   "start": 580.82,
   "end": 583.2,
   "text": "שקיבל מאיזשהו מקום כוחות,"
  },
  {
   "start": 584.18,
   "end": 591.0,
   "text": "כוחות נעלים סימן לעגלון שלו, בוא תפנת את הכרכרה והכרכרה הופנתה למקום שקיעת הסוס."
  },
  {
   "start": 592.98,
   "end": 594.12,
   "text": "והעשיר יוצא עם העגלון,"
  },
  {
   "start": 594.9,
   "end": 596.04,
   "text": "קושר את הסוס,"
  },
  {
   "start": 597.32,
   "end": 602.48,
   "text": "וביחד הם האיצים בסוסי הכרכרה עוד פעם ועוד פעם,"
  },
  {
   "start": 603.02,
   "end": 605.82,
   "text": "והסוס מוהלה מן הבור במאמצים כבירים."
  },
  {
   "start": 609.47,
   "end": 610.57,
   "text": "הפעם הם יצאו לדרך."
  },
  {
   "start": 618.79,
   "end": 621.47,
   "text": "שעות אחר כך הם נמצאו בבית העשיר מול האח."
  },
  {
   "start": 621.47,
   "end": 624.83,
   "text": "העני עם בגדים חדשים, אוכל חם,"
  },
  {
   "start": 628.54,
   "end": 629.38,
   "text": "סוס ספרים,"
  },
  {
   "start": 630.32,
   "end": 632.96,
   "text": "חזר למיטבו,"
  },
  {
   "start": 633.92,
   "end": 636.82,
   "text": "ואחר כך נפרדו להם לשלום."
  },
  {
   "start": 653.91,
   "end": 654.73,
   "text": "היו להם שנים."
  },
  {
   "start": 655.83,
   "end": 656.55,
   "text": "עברו שנים."
  },
  {
   "start": 657.97,
   "end": 659.87,
   "text": "הגיע מועד פטירתו של העשיר."
  },
  {
   "start": 661.67,
   "end": 663.83,
   "text": "נשמתו עולה לשמיים."
  },
  {
   "start": 664.77,
   "end": 666.15,
   "text": "נשמתו עולה לשמיים,"
  },
  {
   "start": 667.23,
   "end": 670.81,
   "text": "ושם בשמיים ממתין לו תיק,"
  },
  {
   "start": 671.81,
   "end": 674.09,
   "text": "תיק אצל בורא עולם לא מלהיב במיוחד."
  },
  {
   "start": 675.73,
   "end": 679.05,
   "text": "היו לו שם לא מעט נקודות לא כל כך לבנות."
  },
  {
   "start": 682.52,
   "end": 684.66,
   "text": "הישיר לא היה מקפיד כל כך על מצוות,"
  },
  {
   "start": 685.82,
   "end": 687.36,
   "text": "ועכשיו שהוא ראה את האמת,"
  },
  {
   "start": 687.94,
   "end": 689.46,
   "text": "הנשמה פשוט החלה לבכות,"
  },
  {
   "start": 690.32,
   "end": 691.16,
   "text": "אבל מאוחר."
  },
  {
   "start": 694.44,
   "end": 694.94,
   "text": "וכך"
  },
  {
   "start": 695.52,
   "end": 697.2,
   "text": "בפני בית דין של מעלה."
  },
  {
   "start": 697.2,
   "end": 706.22,
   "text": "כף המאזניים נוטת בחוזקה מטה לחובה,"
  },
  {
   "start": 707.42,
   "end": 709.36,
   "text": "לחובת הנאה, לחובת אותו עשיר."
  },
  {
   "start": 713.03,
   "end": 715.51,
   "text": "והעשיר, הנשמה מבקשת,"
  },
  {
   "start": 716.35,
   "end": 719.35,
   "text": "מבקשת ישועה, אבל כסף כבר לא עוזר שם למעלה."
  },
  {
   "start": 720.55,
   "end": 723.51,
   "text": "משהו אחר יכול להכריע את הכף."
  },
  {
   "start": 723.83,
   "end": 733.68,
   "text": "ואותו עשיר, אותה נשמה אומללה מחפשת ישועה,"
  },
  {
   "start": 736.23,
   "end": 737.17,
   "text": "מחפשת מצווה."
  },
  {
   "start": 737.67,
   "end": 739.39,
   "text": "ואז,"
  },
  {
   "start": 740.71,
   "end": 742.33,
   "text": "אז הגיעה אותה מצווה גדולה,"
  },
  {
   "start": 743.19,
   "end": 745.37,
   "text": "מצווה גדולה של חסד ליהודי,"
  },
  {
   "start": 747.71,
   "end": 748.49,
   "text": "שם בלילה,"
  },
  {
   "start": 749.41,
   "end": 749.93,
   "text": "בשלג,"
  },
  {
   "start": 751.95,
   "end": 753.41,
   "text": "אותו מוכר ספרים עני,"
  },
  {
   "start": 754.27,
   "end": 755.35,
   "text": "אותה מצווה באה"
  },
  {
   "start": 757.23,
   "end": 759.65,
   "text": "והוסיפה המון המון זכויות,"
  },
  {
   "start": 760.21,
   "end": 764.09,
   "text": "והכף סוף סוף החלה עולה ועולה, עולה למעלה,"
  },
  {
   "start": 764.39,
   "end": 765.03,
   "text": "לזכות,"
  },
  {
   "start": 765.47,
   "end": 767.89,
   "text": "לזכות אותה נשמה של אותו עשיר."
  },
  {
   "start": 771.2,
   "end": 772.46,
   "text": "ומיד אחר כך באה"
  },
  {
   "start": 773.68,
   "end": 775.88,
   "text": "מצוות כבוד הספרים."
  },
  {
   "start": 776.52,
   "end": 779.58,
   "text": "העשיר הלך בה גם והציל את הספרים ספרי קודש."
  },
  {
   "start": 781.58,
   "end": 783.68,
   "text": "וגם מצווה זו באה והעלתה עוד את הכף."
  },
  {
   "start": 788.02,
   "end": 791.44,
   "text": "אבל צער גדול זה לא מספיק."
  },
  {
   "start": 817.38,
   "end": 818.86,
   "text": "הנה מגיעה לה עוד מצווה."
  },
  {
   "start": 819.56,
   "end": 820.98,
   "text": "הנה מגיעה לה עוד מצווה מיוחדת."
  },
  {
   "start": 822.5,
   "end": 824.16,
   "text": "ורחמיו על כל מעשיו,"
  },
  {
   "start": 825.0,
   "end": 826.22,
   "text": "צער בעלי חיים,"
  },
  {
   "start": 827.4,
   "end": 828.58,
   "text": "הרי הוא הציל גם את הסוס."
  },
  {
   "start": 829.54,
   "end": 831.38,
   "text": "וגם מצווה זו באה ומעלה עוד."
  },
  {
   "start": 832.02,
   "end": 833.02,
   "text": "עוד קצת את הכף."
  },
  {
   "start": 835.28,
   "end": 835.44,
   "text": "אבל,"
  },
  {
   "start": 837.06,
   "end": 841.9,
   "text": "אבל למגינת ליבו של אותו עשיר נותר עדיין מעט,"
  },
  {
   "start": 843.38,
   "end": 844.26,
   "text": "מעט חובה,"
  },
  {
   "start": 845.0,
   "end": 849.02,
   "text": "אבל בכל אופן הכף עדיין נוטה לחובתו,"
  },
  {
   "start": 851.75,
   "end": 852.91,
   "text": "דבר שמשמעו"
  },
  {
   "start": 854.21,
   "end": 856.67,
   "text": "ללכת ולשלם ביוקר,"
  },
  {
   "start": 857.31,
   "end": 857.93,
   "text": "ביוקר,"
  },
  {
   "start": 859.13,
   "end": 860.55,
   "text": "על כל העולם הזה,"
  },
  {
   "start": 861.95,
   "end": 862.99,
   "text": "על כל אותה טעות"
  },
  {
   "start": 863.65,
   "end": 864.93,
   "text": "בהבנה, בהסתכלות,"
  },
  {
   "start": 868.75,
   "end": 869.71,
   "text": "וגם לבכות."
  },
  {
   "start": 870.87,
   "end": 872.09,
   "text": "עכשיו יש הרבה זמן,"
  },
  {
   "start": 872.71,
   "end": 874.09,
   "text": "שנים על גבי שנים."
  },
  {
   "start": 886.45,
   "end": 886.95,
   "text": "ושם,"
  },
  {
   "start": 887.89,
   "end": 889.31,
   "text": "שם בבית דין של מעלה,"
  },
  {
   "start": 890.27,
   "end": 891.53,
   "text": "שם בבית דין של מעלה,"
  },
  {
   "start": 892.79,
   "end": 894.79,
   "text": "עומד, עומדת הנשמה."
  },
  {
   "start": 895.65,
   "end": 899.65,
   "text": "שם בבית דין של מעלה, היהודי, ברגע של אמת,"
  },
  {
   "start": 900.49,
   "end": 902.01,
   "text": "מתחיל לבכות."
  },
  {
   "start": 902.65,
   "end": 903.79,
   "text": "מאין יבוא עשרי?"
  },
  {
   "start": 905.81,
   "end": 907.07,
   "text": "מאין יבוא עשרי?"
  },
  {
   "start": 907.81,
   "end": 914.44,
   "text": "והנה,"
  },
  {
   "start": 915.46,
   "end": 916.1,
   "text": "הנה לפתע,"
  },
  {
   "start": 917.08,
   "end": 919.58,
   "text": "נשמע רעש מצד ימין,"
  },
  {
   "start": 920.46,
   "end": 921.12,
   "text": "מצד ימין,"
  },
  {
   "start": 921.68,
   "end": 922.62,
   "text": "נשמע רעש,"
  },
  {
   "start": 923.46,
   "end": 934.18,
   "text": "ואל בית דין של מעלה הגיע משהו נוסף לפתע אל כף המאזניים,"
  },
  {
   "start": 935.26,
   "end": 936.58,
   "text": "הושלכה לה שקית,"
  },
  {
   "start": 938.96,
   "end": 947.16,
   "text": "שקית שהמשקל שלה מעלה ומכריעה את הכף ברקע האחרון,"
  },
  {
   "start": 950.78,
   "end": 959.6,
   "text": "שקית שהמשקל שלה מעלה את הכף לזכות מזכה את אותו עשיר."
  },
  {
   "start": 960.52,
   "end": 963.62,
   "text": "אותה שקית באה והכריעה את חייו הנצחיים."
  },
  {
   "start": 964.02,
   "end": 966.77,
   "text": "לזכות בגן עדן?"
  },
  {
   "start": 968.49,
   "end": 969.89,
   "text": "לזכות בגן עדן?"
  },
  {
   "start": 988.61,
   "end": 989.65,
   "text": "העשיר זכה."
  },
  {
   "start": 990.85,
   "end": 999.54,
   "text": "העשיר זכה בסוף, גילם רבי ישראל מרוז'ין את סיפורו ואמר, תגיד לי,"
  },
  {
   "start": 1000.82,
   "end": 1002.12,
   "text": "תגיד לי עכשיו, יהודי יקר,"
  },
  {
   "start": 1003.52,
   "end": 1004.78,
   "text": "אתה יודע מה היה בשקית?"
  },
  {
   "start": 1006.38,
   "end": 1008.2,
   "text": "אתה יודע מה היה בשקית?"
  },
  {
   "start": 1009.5,
   "end": 1011.28,
   "text": "בשקית זו שהכריעה את הכף,"
  },
  {
   "start": 1013.64,
   "end": 1014.64,
   "text": "בשקית היה,"
  },
  {
   "start": 1015.58,
   "end": 1020.43,
   "text": "היה בוץ."
  },
  {
   "start": 1020.85,
   "end": 1022.21,
   "text": "כן, היה שם בוץ."
  },
  {
   "start": 1023.15,
   "end": 1026.65,
   "text": "הבוץ שלכלך לו את פרוות המינק היוקרתית שלו."
  },
  {
   "start": 1027.83,
   "end": 1032.19,
   "text": "אותו בוץ שנדבק לנעליים שלו כשהוא הלך שם להציל את היהודי,"
  },
  {
   "start": 1032.53,
   "end": 1033.63,
   "text": "ואחרי זה להביא את הספרים,"
  },
  {
   "start": 1034.01,
   "end": 1035.37,
   "text": "ואחרי זה להוציא את הסוס."
  },
  {
   "start": 1036.71,
   "end": 1037.73,
   "text": "גם הבוץ הזה,"
  },
  {
   "start": 1038.39,
   "end": 1039.03,
   "text": "לא רק העזרה,"
  },
  {
   "start": 1039.93,
   "end": 1041.25,
   "text": "לא רק התמיכה, לא רק המאמץ,"
  },
  {
   "start": 1041.49,
   "end": 1043.71,
   "text": "אפילו הבוץ שנדבק לו לבגדים,"
  },
  {
   "start": 1044.67,
   "end": 1046.29,
   "text": "גם הוא נלקח בחשבון,"
  },
  {
   "start": 1047.05,
   "end": 1049.09,
   "text": "והוא זה שהכריע בסוף את הכף."
  },
  {
   "start": 1050.87,
   "end": 1052.03,
   "text": "תדע לך, יהודי יקר,"
  },
  {
   "start": 1052.89,
   "end": 1054.31,
   "text": "עם ישראל זה עם מיוחד."
  },
  {
   "start": 1055.03,
   "end": 1058.45,
   "text": "יהודי, יהודייה זה נבראים מיוחדים."
  },
  {
   "start": 1059.07,
   "end": 1060.55,
   "text": "אצל יהודי, אצל יהודייה,"
  },
  {
   "start": 1061.07,
   "end": 1063.85,
   "text": "גם בוץ יכול להיות שווה זהב."
  },
  {
   "start": 1066.92,
   "end": 1067.42,
   "text": "אז אל תחשוש."
  },
  {
   "start": 1068.54,
   "end": 1070.08,
   "text": "אל תחשוש על הבוץ בשטיחים שלך."
  },
  {
   "start": 1070.72,
   "end": 1074.3,
   "text": "קיבוץ יכול להיות שווה זהב,"
  },
  {
   "start": 1080.42,
   "end": 1081.28,
   "text": "שערי אותו בית נפתחו."
  },
  {
   "start": 1089.97,
   "end": 1090.87,
   "text": "יהודי יקר,"
  },
  {
   "start": 1091.73,
   "end": 1092.65,
   "text": "אצל יהודי,"
  },
  {
   "start": 1093.31,
   "end": 1094.21,
   "text": "אצל יהודייה,"
  },
  {
   "start": 1095.17,
   "end": 1097.93,
   "text": "כל מה שעושים לכבוד השם מתברך,"
  },
  {
   "start": 1098.79,
   "end": 1099.61,
   "text": "גם אם זה מצליח,"
  },
  {
   "start": 1100.35,
   "end": 1101.43,
   "text": "גם אם זה לא מצליח,"
  },
  {
   "start": 1102.19,
   "end": 1103.13,
   "text": "אבל אתה עושה,"
  },
  {
   "start": 1103.75,
   "end": 1105.67,
   "text": "נחשב יקר ערך בשמיים."
  },
  {
   "start": 1114.02,
   "end": 1114.64,
   "text": "יהודי יקר,"
  },
  {
   "start": 1120.8,
   "end": 1123.86,
   "text": "יהודי יקר, אצל יהודי, אצל יהודייה,"
  },
  {
   "start": 1124.7,
   "end": 1125.02,
   "text": "גם,"
  },
  {
   "start": 1127.5,
   "end": 1128.46,
   "text": "לא גם, אלא כל,"
  },
  {
   "start": 1129.0,
   "end": 1130.88,
   "text": "כל מה שעושים לכבוד השם יתברך."
  },
  {
   "start": 1132.26,
   "end": 1136.18,
   "text": "כל מה שעושים לכבוד השם יתברך, בין אם זה מצליח וגם כשזה לא מצליח,"
  },
  {
   "start": 1136.98,
   "end": 1139.1,
   "text": "נחשב יקר הערך בשמיינו."
  },
  {
   "start": 1140.42,
   "end": 1143.14,
   "text": "גם דבר שנחשב סתם יגיע, אובדן זמן לכאורה,"
  },
  {
   "start": 1143.64,
   "end": 1145.34,
   "text": "אם זה לכבוד השם, זה שווה זהב."
  },
  {
   "start": 1147.14,
   "end": 1149.92,
   "text": "כל דבר שאתה עושה שאת עושה, אם זה לכבוד השם,"
  },
  {
   "start": 1150.3,
   "end": 1152.5,
   "text": "זה לא בזבוז זמן, זה שווה זהב."
  },
  {
   "start": 1153.48,
   "end": 1155.02,
   "text": "לכן בחר רבי אבהו,"
  },
  {
   "start": 1155.46,
   "end": 1156.34,
   "text": "רבי אברור,"
  },
  {
   "start": 1157.02,
   "end": 1165.26,
   "text": "כשראה יג, 13 נערות אפרסמון עבורו בגן עדן, בכה ואמר, ואני אמרתי לריק יגעתי."
  },
  {
   "start": 1165.62,
   "end": 1167.7,
   "text": "אני לא ידעתי שעל כל דבר ודבר,"
  },
  {
   "start": 1168.58,
   "end": 1174.42,
   "text": "גם על הזמן שאני כאילו מבזבז בהמתנה אפילו לאיזה משהו,"
  },
  {
   "start": 1175.16,
   "end": 1176.92,
   "text": "בנסיעה, אבל אם זה לכבוד השם?"
  },
  {
   "start": 1178.34,
   "end": 1178.88,
   "text": "זה לא לריק,"
  },
  {
   "start": 1179.64,
   "end": 1180.52,
   "text": "זה לא הולך לבטלה,"
  },
  {
   "start": 1181.34,
   "end": 1184.9,
   "text": "זה נצח, זה עולם הבא, זה זכויות."
  },
  {
   "start": 1184.9,
   "end": 1192.35,
   "text": "בחר רבי הפאום, כך אנחנו צריכים לדעת."
  },
  {
   "start": 1193.05,
   "end": 1194.65,
   "text": "ושלא נופתע ביום האחרון נראה."
  },
  {
   "start": 1196.78,
   "end": 1198.22,
   "text": "אתם יודעים למה נופתע?"
  },
  {
   "start": 1198.58,
   "end": 1199.4,
   "text": "למה שלא נופתע?"
  },
  {
   "start": 1199.86,
   "end": 1202.96,
   "text": "כי אם לא נבין שזה ככה, אם לא נבין שעל כל מה שאנחנו עושים מקבלים,"
  },
  {
   "start": 1203.32,
   "end": 1205.32,
   "text": "איך יהיה לנו כוח להמשיך, ואם אדם יכול להתייאש,"
  },
  {
   "start": 1205.64,
   "end": 1209.1,
   "text": "להגיד, טוב, אני מבזבז הרבה זמן שם, אבל אחרי 120 פתאום מתברר לו,"
  },
  {
   "start": 1209.66,
   "end": 1214.38,
   "text": "מתברר לה שעל כל הזמן שהשקיע לכבוד השם יתברך יש שכר עצום."
  },
  {
   "start": 1217.41,
   "end": 1218.55,
   "text": "יש שכר עצום."
  },
  {
   "start": 1218.55,
   "end": 1227.57,
   "text": "ואם הייתה יודעת את זה, אם הייתה יודעת את זה, לא הייתה משקיעה יותר, אז בואו בחסדי השם יתברך, נבין את זה, נדע את זה ונשקיע יותר."
  }
 ]
}