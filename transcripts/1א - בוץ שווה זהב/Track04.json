{
 "disc": "1א - בוץ שווה זהב",
 "track": "Track04",
 "duration": 945.168,
 "segments": [
  {
   "start": 6.34,
   "end": 6.68,
   "text": "ישיבת,"
  },
  {
   "start": 7.62,
   "end": 11.08,
   "text": "ישיבת כנסת ישראל חברון."
  },
  {
   "start": 13.38,
   "end": 15.7,
   "text": "בישיבת כנסת ישראל חברון,"
  },
  {
   "start": 17.94,
   "end": 19.62,
   "text": "ישיבת חברון, אחת מהדמויות,"
  },
  {
   "start": 20.82,
   "end": 22.92,
   "text": "אחת מהדמויות שנהפכו לסמל הישיבה"
  },
  {
   "start": 23.7,
   "end": 24.56,
   "text": "במשך שנים,"
  },
  {
   "start": 25.7,
   "end": 26.4,
   "text": "הייתה אישה,"
  },
  {
   "start": 27.06,
   "end": 28.74,
   "text": "אישה ערירית וגלמודה."
  },
  {
   "start": 33.75,
   "end": 38.92,
   "text": "מה הקשר בין אישה ערירית בודדה"
  },
  {
   "start": 40.64,
   "end": 41.5,
   "text": "לבין הישיבה?"
  },
  {
   "start": 41.5,
   "end": 44.64,
   "text": "זו הייתה המבשלת של הישיבה."
  },
  {
   "start": 45.54,
   "end": 47.7,
   "text": "זו הייתה אישה שעבדה בקשיים עצומים,"
  },
  {
   "start": 48.42,
   "end": 49.84,
   "text": "הן פיזיים והן נפשיים."
  },
  {
   "start": 52.12,
   "end": 54.28,
   "text": "אבל היא הייתה מוסרת נפש שם במטבח,"
  },
  {
   "start": 59.31,
   "end": 62.01,
   "text": "בין קליפות התפוחי האדמה לקליפות הבצל."
  },
  {
   "start": 63.61,
   "end": 64.95,
   "text": "היא הייתה משקיעה את מירב"
  },
  {
   "start": 65.75,
   "end": 66.55,
   "text": "שעות היום."
  },
  {
   "start": 70.77,
   "end": 72.49,
   "text": "היא הייתה שמחה בפנים,"
  },
  {
   "start": 73.81,
   "end": 74.73,
   "text": "בתוכה הייתה שמחה"
  },
  {
   "start": 76.53,
   "end": 79.55,
   "text": "להכין אוכל לאותם מאות בחורי ישיבה,"
  },
  {
   "start": 80.33,
   "end": 83.79,
   "text": "שהיו עושים את רוב היום באוהלה של תורה,"
  },
  {
   "start": 85.11,
   "end": 99.1,
   "text": "שהיו מבלים את רוב היום לא מבלים, אלא שוהים כל היום באוהלה של תורה, היו שוהים באוהלה של תורה,"
  },
  {
   "start": 101.95,
   "end": 103.35,
   "text": "ותמיד היא הייתה מעודדת את עצמה,"
  },
  {
   "start": 104.21,
   "end": 105.57,
   "text": "אבל כמה זה קשה,"
  },
  {
   "start": 106.53,
   "end": 110.81,
   "text": "העבודה שוחקת, הבדידות אוכלת כל חלקה טובה,"
  },
  {
   "start": 112.03,
   "end": 112.65,
   "text": "אבל תמיד,"
  },
  {
   "start": 113.35,
   "end": 114.89,
   "text": "תמיד היא הייתה מחזקת את עצמה,"
  },
  {
   "start": 116.03,
   "end": 116.53,
   "text": "ובמה?"
  },
  {
   "start": 120.0,
   "end": 122.6,
   "text": "היה לה משפט שגור בפה, היא הייתה אומרת"
  },
  {
   "start": 123.42,
   "end": 128.22,
   "text": "אתם יודעים ראש ישיבת חברון הרב יחזקאל סרנה זכר צדיק לברכה"
  },
  {
   "start": 128.74,
   "end": 137.24,
   "text": "הבטיח לי הוא עצמו בפיו הקדוש הבטיח לי שעל כל המאמצים שלי על כל היגיעה שלי במטבח"
  },
  {
   "start": 138.04,
   "end": 140.0,
   "text": "שנראה אולי שולי כל כך"
  },
  {
   "start": 142.96,
   "end": 145.86,
   "text": "הרב ראש הישיבה בכבודו ובעצמו אמר לי"
  },
  {
   "start": 146.44,
   "end": 150.88,
   "text": "שבשמיים רואים את מסירות הנפש בו אני עובדת"
  },
  {
   "start": 151.4,
   "end": 157.2,
   "text": "הם רואים את קילוף תפוח אדמה, את קילוף הבצל, את הכנת הפירה,"
  },
  {
   "start": 158.04,
   "end": 161.52,
   "text": "את הכנת האוכל כמלאכת קודש."
  },
  {
   "start": 163.18,
   "end": 165.94,
   "text": "ותדעי לך, הוא אמר לי, יגיע היום, יגיע היום, בוא,"
  },
  {
   "start": 166.62,
   "end": 168.54,
   "text": "בוא תצטרכי להיפטר מן העולם."
  },
  {
   "start": 170.75,
   "end": 172.09,
   "text": "וכך היא הוסיפה, אמרה,"
  },
  {
   "start": 172.47,
   "end": 178.63,
   "text": "היא הוסיפה בשמחה לא מוסתרת, ואותי היא אמרה על עצמה, ואותי ילוו מאות בחורי ישיבה."
  },
  {
   "start": 180.09,
   "end": 181.47,
   "text": "לא כל אישה זוכה לזה."
  },
  {
   "start": 182.35,
   "end": 184.75,
   "text": "אותי ילוו מאות בחורי ישיבת חברון,"
  },
  {
   "start": 185.71,
   "end": 187.07,
   "text": "אותי אישה בודדה,"
  },
  {
   "start": 187.77,
   "end": 188.61,
   "text": "אישה אומללה,"
  },
  {
   "start": 189.19,
   "end": 190.81,
   "text": "ילוו מאות בני תורה,"
  },
  {
   "start": 191.29,
   "end": 192.69,
   "text": "כמה זה משמח אותי."
  },
  {
   "start": 193.65,
   "end": 196.75,
   "text": "אולי זו נחמתי הגדולה ביותר בעולם הזה."
  },
  {
   "start": 198.59,
   "end": 200.71,
   "text": "כך אמרה אותה אישה קשת יום,"
  },
  {
   "start": 201.21,
   "end": 204.17,
   "text": "תראו מה משמח אישה קשת יום,"
  },
  {
   "start": 205.61,
   "end": 210.03,
   "text": "שאחרי מאה ועשרים ילוו אותה מאות בני הישיבה,"
  },
  {
   "start": 212.87,
   "end": 244.64,
   "text": "כך היא אמרה, ישיבת,"
  },
  {
   "start": 245.5,
   "end": 247.0,
   "text": "ישיבת כנסת ישראל חברון."
  },
  {
   "start": 256.12,
   "end": 262.84,
   "text": "ישיבת כנסת ישראל חברון הייתה שוממה אותו לילה,"
  },
  {
   "start": 263.5,
   "end": 263.98,
   "text": "למעט,"
  },
  {
   "start": 264.6,
   "end": 276.44,
   "text": "למעט מספר בחורים שנשארו על מנת שכל התורה לא ייפסק גם כששאר בחורי הישיבה נסעו אותו לילה."
  },
  {
   "start": 277.42,
   "end": 280.58,
   "text": "הם נסעו לחתונה, חתונה של אחד מהבחורים הוותיקים בישיבה."
  },
  {
   "start": 280.58,
   "end": 294.56,
   "text": "ומספר בחורים מצומצם נוטה להמשיך את רצף הלימוד כשלפתע צלצל לטלפון."
  },
  {
   "start": 298.24,
   "end": 303.86,
   "text": "צלצול הטלפון כאילו ביקש להשתלט על השקט שפקד את אולם הישיבה."
  },
  {
   "start": 308.28,
   "end": 310.66,
   "text": "אחד מהבחורים ניגש, ניגש אל הטלפון,"
  },
  {
   "start": 311.98,
   "end": 317.4,
   "text": "מרים את השפופרת והקול מהצד השני של הקו המר."
  },
  {
   "start": 318.32,
   "end": 320.26,
   "text": "מדברים מבית החולים שערי צדק,"
  },
  {
   "start": 321.08,
   "end": 322.5,
   "text": "אנחנו מצטערים להודיע לכם,"
  },
  {
   "start": 323.04,
   "end": 325.48,
   "text": "יש גברת, גברת בשם ארת מינה,"
  },
  {
   "start": 326.6,
   "end": 328.22,
   "text": "שהיא ידועה שהייתה מבשלת,"
  },
  {
   "start": 328.96,
   "end": 330.44,
   "text": "מבשלת בישיבה שלכם."
  },
  {
   "start": 331.18,
   "end": 332.98,
   "text": "מלבד זאת אין לה קול קרובים,"
  },
  {
   "start": 333.6,
   "end": 334.5,
   "text": "אין לה קול מכרים."
  },
  {
   "start": 335.2,
   "end": 337.56,
   "text": "רק אנחנו יודעים שהיא, כך היא אמרה לנו,"
  },
  {
   "start": 338.26,
   "end": 340.74,
   "text": "כשהיא התאשפזה בבית החולים אצלנו,"
  },
  {
   "start": 342.22,
   "end": 343.26,
   "text": "בית חולים שערי צדק,"
  },
  {
   "start": 343.72,
   "end": 344.42,
   "text": "היא אמרה שהיא,"
  },
  {
   "start": 344.86,
   "end": 347.1,
   "text": "כל מה שיש לה היא מבשלת בישיבת חברון."
  },
  {
   "start": 348.84,
   "end": 350.22,
   "text": "לצערנו הרב היא נפטרה."
  },
  {
   "start": 351.02,
   "end": 353.08,
   "text": "היא נפטרה זה עתה בבית החולים."
  },
  {
   "start": 354.4,
   "end": 359.2,
   "text": "אז אנחנו מתקשרים אליכם, נבקש מאנשי הישיבה לבוא ולטפל בסידורי ההלוויה שלה."
  },
  {
   "start": 360.4,
   "end": 363.42,
   "text": "אתם הקרובים משפחה שלה, אתם המשפחה שלה כנראה."
  },
  {
   "start": 375.22,
   "end": 377.0,
   "text": "הבחורים היו המומים,"
  },
  {
   "start": 380.61,
   "end": 381.71,
   "text": "אבל נוסף לצער,"
  },
  {
   "start": 382.41,
   "end": 385.03,
   "text": "לנוכח השמועה הקשה,"
  },
  {
   "start": 386.35,
   "end": 388.61,
   "text": "הם נותרו חסרי אונים, מה לעשות?"
  },
  {
   "start": 389.09,
   "end": 391.97,
   "text": "הם ידעו, ידעו על מה הסתמכה, על מה שמחה,"
  },
  {
   "start": 392.95,
   "end": 396.15,
   "text": "ממה חיזק, מה חיזק, מה היה התקווה של אותה מבשלת."
  },
  {
   "start": 397.79,
   "end": 399.99,
   "text": "ועכשיו, גם אם יתחילו בסידורי ההלוויה,"
  },
  {
   "start": 400.95,
   "end": 404.07,
   "text": "אין מי שיבוא ללוות את אותה מבשלת."
  },
  {
   "start": 406.62,
   "end": 413.6,
   "text": "כל השנים היא ייחלה לרגע כזה שיגיע, כשיצטרך להגיע,"
  },
  {
   "start": 415.94,
   "end": 420.56,
   "text": "ואז היא תזכה למה שהבטיח לה ראש הישיבה, להלוויה של מאות בני ישיבה."
  },
  {
   "start": 421.28,
   "end": 422.08,
   "text": "ועכשיו אין,"
  },
  {
   "start": 423.02,
   "end": 424.0,
   "text": "אין אפילו מניין."
  },
  {
   "start": 450.06,
   "end": 452.22,
   "text": "מה יעשו? מה יעשו בחורי הישיבה?"
  },
  {
   "start": 452.8,
   "end": 454.3,
   "text": "הם עשו את מה שצריך לעשות."
  },
  {
   "start": 457.93,
   "end": 460.47,
   "text": "הבחורים שנותרו בישיבה היו חסרי אונים."
  },
  {
   "start": 461.37,
   "end": 461.87,
   "text": "מה הם יעשו?"
  },
  {
   "start": 463.75,
   "end": 464.59,
   "text": "הם פשוט פנו,"
  },
  {
   "start": 465.11,
   "end": 466.25,
   "text": "פנו לרבה של ירושלים,"
  },
  {
   "start": 466.91,
   "end": 468.69,
   "text": "אל הגאון הרב צבי פסח פרנק,"
  },
  {
   "start": 469.39,
   "end": 470.65,
   "text": "זכר צדיק לברכה."
  },
  {
   "start": 471.95,
   "end": 473.53,
   "text": "שיפסוק, יורה להם מה לעשות."
  },
  {
   "start": 474.29,
   "end": 474.79,
   "text": "מצד אחד,"
  },
  {
   "start": 475.63,
   "end": 477.59,
   "text": "צריך לעשות את ההלוויה כמה שיותר מהר,"
  },
  {
   "start": 478.21,
   "end": 480.03,
   "text": "זה יותר טוב לנפטר."
  },
  {
   "start": 481.81,
   "end": 482.51,
   "text": "מצד שני,"
  },
  {
   "start": 485.55,
   "end": 487.29,
   "text": "בהקשתה של אותה נפטרת,"
  },
  {
   "start": 488.09,
   "end": 491.67,
   "text": "בקשתה מלפני שנים, תקוותה, שאיפתה איתה,"
  },
  {
   "start": 492.27,
   "end": 493.61,
   "text": "שבחורי הישיבה ילהו,"
  },
  {
   "start": 494.09,
   "end": 496.33,
   "text": "ועכשיו בחורי הישיבה נמצאים הרחק מהישיבה."
  },
  {
   "start": 567.47,
   "end": 572.11,
   "text": "רב צבי פסח פרנק פסק, אסור, אסור לדחות את ההלוויה."
  },
  {
   "start": 572.83,
   "end": 575.73,
   "text": "בשום פנים ואופן, אין לדחות את ההלוויה."
  },
  {
   "start": 579.82,
   "end": 581.98,
   "text": "והבחורים פנו לארגן את סידורי ההלוויה."
  },
  {
   "start": 583.2,
   "end": 586.14,
   "text": "כך נמוג חלומה של המבשלת האומללה."
  },
  {
   "start": 586.72,
   "end": 589.8,
   "text": "היא תזכה, מן הסתם, ללוויה שבמקרה הטוב,"
  },
  {
   "start": 590.3,
   "end": 593.44,
   "text": "יהיה בה מניין מלווים במקרה הטוב."
  },
  {
   "start": 649.06,
   "end": 652.3,
   "text": "צרחות, צרחות נשמעו בבית החולים שערי צדק."
  },
  {
   "start": 655.03,
   "end": 657.45,
   "text": "הצרחות הדהדו בכל הבית החולים."
  },
  {
   "start": 659.62,
   "end": 661.86,
   "text": "בבית החולים, בלב בית החולים הייתה גופה,"
  },
  {
   "start": 662.3,
   "end": 663.76,
   "text": "גופה עטופה בסדין."
  },
  {
   "start": 664.38,
   "end": 667.56,
   "text": "גופה שמותה נקבע ללא כל צל של ספק."
  },
  {
   "start": 668.4,
   "end": 669.24,
   "text": "ואותה גופה"
  },
  {
   "start": 670.52,
   "end": 675.06,
   "text": "של אישה שנפטרה מן העולם החלה לנוע."
  },
  {
   "start": 681.44,
   "end": 682.62,
   "text": "היא חזרה לחיים."
  },
  {
   "start": 683.32,
   "end": 683.94,
   "text": "המבשלת,"
  },
  {
   "start": 685.18,
   "end": 688.12,
   "text": "המבשלת מישיבת חברון חזרה לחיים."
  },
  {
   "start": 697.04,
   "end": 700.5,
   "text": "צלצול של טלפון לישיבה קטע את ההכנות להלוויה."
  },
  {
   "start": 701.24,
   "end": 702.22,
   "text": "לעצור את הכל,"
  },
  {
   "start": 702.98,
   "end": 705.02,
   "text": "אמר הכל, שוב מבית החולים שערי צדק,"
  },
  {
   "start": 705.46,
   "end": 705.98,
   "text": "היא חיה,"
  },
  {
   "start": 706.34,
   "end": 707.34,
   "text": "היא חזרה לחיים."
  },
  {
   "start": 708.58,
   "end": 709.82,
   "text": "מצב קשה, אבל היא חיה."
  },
  {
   "start": 714.31,
   "end": 735.36,
   "text": "וכל הבחורים נשמו לרווחה, מחרת בבוקר."
  },
  {
   "start": 737.38,
   "end": 739.72,
   "text": "ישיבת חברון שוקקת חיים,"
  },
  {
   "start": 740.34,
   "end": 741.24,
   "text": "אולם הישיבה"
  },
  {
   "start": 742.08,
   "end": 743.84,
   "text": "היה מלא בבחורים שלמדו,"
  },
  {
   "start": 747.07,
   "end": 750.77,
   "text": "ואז במשרדי הישיבה צלצל לטלפון."
  },
  {
   "start": 752.19,
   "end": 753.81,
   "text": "מדברים מבית החולים שערי צדק,"
  },
  {
   "start": 754.55,
   "end": 755.45,
   "text": "המבשלת,"
  },
  {
   "start": 756.23,
   "end": 758.09,
   "text": "מישיבת חברון, מרתמינה,"
  },
  {
   "start": 758.87,
   "end": 759.95,
   "text": "נפטרה מן העולם."
  },
  {
   "start": 761.71,
   "end": 762.45,
   "text": "והפעם זה סופי."
  },
  {
   "start": 771.78,
   "end": 773.24,
   "text": "שעות מספר אחר כך"
  },
  {
   "start": 773.92,
   "end": 776.54,
   "text": "היא יצתה להלוויה, יצאה להלוויה מכובדת."
  },
  {
   "start": 778.02,
   "end": 779.14,
   "text": "מאות בני ישיבה,"
  },
  {
   "start": 780.08,
   "end": 781.58,
   "text": "מלווים, אישה,"
  },
  {
   "start": 782.28,
   "end": 783.46,
   "text": "ערירית וגלמודה,"
  },
  {
   "start": 785.42,
   "end": 788.54,
   "text": "שכל ימיה עמלה אי שם במטבח,"
  },
  {
   "start": 791.06,
   "end": 792.84,
   "text": "אבל העמל שלה לא היה לשווא,"
  },
  {
   "start": 793.54,
   "end": 794.7,
   "text": "העמל שלה לא היה לריק."
  },
  {
   "start": 797.91,
   "end": 798.77,
   "text": "במשך שנים,"
  },
  {
   "start": 799.21,
   "end": 800.67,
   "text": "אמנם זו הייתה הפרנסה שלה,"
  },
  {
   "start": 801.11,
   "end": 802.23,
   "text": "זו הייתה המשכורת,"
  },
  {
   "start": 802.53,
   "end": 807.31,
   "text": "אבל אחרי הכל היא האכילה עשרות ומאות"
  },
  {
   "start": 808.15,
   "end": 808.95,
   "text": "בני ישיבה,"
  },
  {
   "start": 809.71,
   "end": 810.31,
   "text": "בני תורה."
  },
  {
   "start": 811.85,
   "end": 813.51,
   "text": "וכך, בדרכה האחרונה,"
  },
  {
   "start": 813.51,
   "end": 816.81,
   "text": "מלווים אותה מאות בני ישיבה."
  },
  {
   "start": 825.26,
   "end": 826.74,
   "text": "היא כבר נפטרה קודם,"
  },
  {
   "start": 828.34,
   "end": 835.61,
   "text": "אבל כאשר התברר שהבטחת ראש הישיבה,"
  },
  {
   "start": 836.09,
   "end": 838.29,
   "text": "שמה שמגיע לה עוד בעולם הזה,"
  },
  {
   "start": 838.81,
   "end": 841.11,
   "text": "אותה מאות בני ישיבה לא יגיעו להלוויה,"
  },
  {
   "start": 841.83,
   "end": 843.29,
   "text": "החליטו בשמיים לחכות לה."
  },
  {
   "start": 844.61,
   "end": 847.93,
   "text": "בשמיים עצרו את הכול וחיכו למרטמינה,"
  },
  {
   "start": 848.43,
   "end": 851.97,
   "text": "אישה חרירית וגלמודה,"
  },
  {
   "start": 852.69,
   "end": 853.91,
   "text": "אבל מבשלת,"
  },
  {
   "start": 854.55,
   "end": 855.85,
   "text": "מבשלת לבני תורה,"
  },
  {
   "start": 857.37,
   "end": 858.57,
   "text": "וכל מאמץ,"
  },
  {
   "start": 859.47,
   "end": 862.57,
   "text": "כל גרם של יגיעה נרשם,"
  },
  {
   "start": 863.43,
   "end": 868.79,
   "text": "והיא זוכה להלוויה, הלוויה של ראש ישיבה בדרכה אל מנוחת העולמים,"
  },
  {
   "start": 871.39,
   "end": 875.69,
   "text": "מותירה אותנו כאן נפעמים ונרגשים,"
  },
  {
   "start": 876.21,
   "end": 878.99,
   "text": "ואולי כדאי שהפעם נכניס אל הלב שלנו,"
  },
  {
   "start": 879.31,
   "end": 881.29,
   "text": "נבין שכל מה שאנחנו עושים,"
  },
  {
   "start": 881.65,
   "end": 884.65,
   "text": "אבל הכל הכל הכל, אם זה לכבוד השם יתברך,"
  },
  {
   "start": 884.89,
   "end": 890.97,
   "text": "היא מעורבת בזה כבוד שמיים, היא מעורבת בזה לשם שמיים, אפילו לא במאה אחוז."
  },
  {
   "start": 893.43,
   "end": 896.07,
   "text": "יש על זה שכר בעולם הבא,"
  },
  {
   "start": 896.91,
   "end": 900.15,
   "text": "ורואים תוצאות, רואים את האור עוד בעולם הזה."
  },
  {
   "start": 901.75,
   "end": 902.43,
   "text": "ועל זה,"
  },
  {
   "start": 902.97,
   "end": 906.07,
   "text": "על כל אלו באנו אליכם פה לחזק את כולנו,"
  },
  {
   "start": 906.55,
   "end": 907.79,
   "text": "לומר לכולנו,"
  },
  {
   "start": 909.82,
   "end": 914.82,
   "text": "להזכיר לכולנו. אמר רבי אבהו לפני מותו,"
  },
  {
   "start": 915.18,
   "end": 917.0,
   "text": "כשהראו לו את השכר העצום שלו,"
  },
  {
   "start": 917.0,
   "end": 933.99,
   "text": "אמר ואני אמרתי לריק יגעתי בך כשהבין שעל כל יקיעה על כל מאמץ כל מאמץ נחשב בשמיים"
  }
 ]
}