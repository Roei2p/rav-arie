{
 "disc": "29ק- סוד האומץ",
 "track": "Track01",
 "duration": 1002.12,
 "segments": [
  {
   "start": 2.22,
   "end": 2.58,
   "text": "שלום רב."
  },
  {
   "start": 3.82,
   "end": 9.06,
   "text": "אנחנו רוצים למעשה לחשוף בפניכם סוד,"
  },
  {
   "start": 9.74,
   "end": 10.26,
   "text": "סוד נפלא,"
  },
  {
   "start": 11.28,
   "end": 12.12,
   "text": "סוד שקשור אליך,"
  },
  {
   "start": 14.0,
   "end": 15.78,
   "text": "אלייך, אל כולם."
  },
  {
   "start": 16.82,
   "end": 18.36,
   "text": "למעשה אל כל עם ישראל,"
  },
  {
   "start": 18.86,
   "end": 22.3,
   "text": "אל כל העם הנפלא שלנו, ללא יוצא מהכלל."
  },
  {
   "start": 23.5,
   "end": 24.02,
   "text": "לשם כך"
  },
  {
   "start": 24.98,
   "end": 25.5,
   "text": "בואו נניע"
  },
  {
   "start": 26.5,
   "end": 30.78,
   "text": "ונסובב את גלגלי הזמן אחורה, אחורה."
  },
  {
   "start": 31.6,
   "end": 32.96,
   "text": "בואו נצא למסע היהודי,"
  },
  {
   "start": 34.18,
   "end": 34.94,
   "text": "או יותר נכון,"
  },
  {
   "start": 35.98,
   "end": 36.62,
   "text": "מסע אל הלב,"
  },
  {
   "start": 37.88,
   "end": 39.82,
   "text": "מסע אל הלב היהודי שמעולם,"
  },
  {
   "start": 41.12,
   "end": 43.32,
   "text": "מעולם לא הפסיק לפעום."
  },
  {
   "start": 43.98,
   "end": 49.04,
   "text": "בואו בעזרת השם נגלוש לאיזה מקרה שבעזרת השם יפתח לנו,"
  },
  {
   "start": 50.28,
   "end": 51.16,
   "text": "יפתח לנו פתח"
  },
  {
   "start": 53.38,
   "end": 54.62,
   "text": "ממנו נוכל להמשיך הלאה."
  },
  {
   "start": 58.92,
   "end": 64.52,
   "text": "זה למעשה התחיל ואולי אפילו הגיע לשלבי הסיום"
  },
  {
   "start": 65.44,
   "end": 68.84,
   "text": "בשנת 1939 בבלגיה."
  },
  {
   "start": 71.2,
   "end": 81.38,
   "text": "האוניברסיטה בבלגיה קיבלו בתדהמה את הוויתור של אותה בחורה יהודייה,"
  },
  {
   "start": 82.0,
   "end": 85.94,
   "text": "אותה בחורה יהודייה שהתקבלה לפקולטה לרפואה,"
  },
  {
   "start": 86.76,
   "end": 90.56,
   "text": "שכל כך הרבה ורבים מבני בלגיה,"
  },
  {
   "start": 92.12,
   "end": 95.72,
   "text": "כל כך הרבה סטודנטים שואפים להתקבל,"
  },
  {
   "start": 95.72,
   "end": 99.9,
   "text": "ומבין אלפים היא התקבלה,"
  },
  {
   "start": 101.14,
   "end": 106.08,
   "text": "אבל אותה צעירה יהודיתה כשהיא שמעה שזה מחייב אותה"
  },
  {
   "start": 106.68,
   "end": 115.46,
   "text": "לעבוד וללמוד ביום שהוא מקודש לעם שלה, ביום השבת,"
  },
  {
   "start": 116.34,
   "end": 117.48,
   "text": "היא ויתרה על הכל."
  },
  {
   "start": 119.8,
   "end": 121.46,
   "text": "היא ויתרה על לימודי הרפואה,"
  },
  {
   "start": 122.3,
   "end": 123.52,
   "text": "היא ויתרה על הקריירה,"
  },
  {
   "start": 124.74,
   "end": 126.38,
   "text": "היא ויתרה על העתיד שלה."
  },
  {
   "start": 127.36,
   "end": 128.86,
   "text": "אותה בחורה קראו לה מלע."
  },
  {
   "start": 129.48,
   "end": 130.26,
   "text": "בחורה צעירה,"
  },
  {
   "start": 132.64,
   "end": 133.78,
   "text": "כל החיים לפניה,"
  },
  {
   "start": 135.0,
   "end": 137.08,
   "text": "ומול עיניה יש מטרה, היא רוצה את השם."
  },
  {
   "start": 140.97,
   "end": 142.35,
   "text": "1942,"
  },
  {
   "start": 143.65,
   "end": 145.23,
   "text": "הפלישה הנאצית לבלגיה."
  },
  {
   "start": 146.09,
   "end": 147.57,
   "text": "הנאצים שוטפים את בלגיה."
  },
  {
   "start": 148.09,
   "end": 150.35,
   "text": "בכל מקום הם תופסים יהודים."
  },
  {
   "start": 150.75,
   "end": 154.31,
   "text": "כל מקום הסכנה קרבה, המוות משתולל ברחובות."
  },
  {
   "start": 155.79,
   "end": 156.23,
   "text": "ומלה,"
  },
  {
   "start": 157.65,
   "end": 158.93,
   "text": "מלה בעל כורחה,"
  },
  {
   "start": 161.86,
   "end": 163.12,
   "text": "אחרי ההפצרות של אבא,"
  },
  {
   "start": 163.7,
   "end": 165.0,
   "text": "אחרי לחץ מסיבי,"
  },
  {
   "start": 165.76,
   "end": 173.64,
   "text": "מצד אבא, מצד אימא, מצד האחים שמאלצים אותה לנצל"
  },
  {
   "start": 175.12,
   "end": 194.02,
   "text": "לנצל את כישורי הזמרה שלה ולהיהפך, להתחזות כמורה לזמרה בבית משפחה נוצרית בפרברי אנדוורפן וכך אף אחד לא ידע, אף אחד לא יחשוד שאותה מורה לזמרה של אותה משפחה נוצרית"
  },
  {
   "start": 194.7,
   "end": 198.26,
   "text": "שחיה לה בשקט ובשלווה בפרברי אנדוורפן"
  },
  {
   "start": 199.1,
   "end": 202.2,
   "text": "אותה מורה לזמרה היא יהודייה וכך היא תינצל"
  },
  {
   "start": 203.38,
   "end": 203.96,
   "text": "היא לא רוצה"
  },
  {
   "start": 204.72,
   "end": 206.34,
   "text": "היא רוצה להצטרף לאחראי היהודים"
  },
  {
   "start": 207.7,
   "end": 213.7,
   "text": "אבל הלחץ והדרישה מצד ההורים, כיבוד ההורים עולה על הכל"
  },
  {
   "start": 215.5,
   "end": 217.24,
   "text": "ומלה מוצאת את עצמם"
  },
  {
   "start": 218.36,
   "end": 220.7,
   "text": "בבית המשפחה הנוצרית, מורה לזמרה"
  },
  {
   "start": 223.17,
   "end": 225.25,
   "text": "אבל הנשמה שלה זועקת"
  },
  {
   "start": 225.95,
   "end": 227.91,
   "text": "אבל הנשמה שלה זועקת"
  },
  {
   "start": 227.91,
   "end": 234.11,
   "text": "ואותה נשמה כשהגיע היום,"
  },
  {
   "start": 234.65,
   "end": 238.71,
   "text": "יום קדוש ונורא לעם ישראל, יום הכיפורים,"
  },
  {
   "start": 240.71,
   "end": 251.07,
   "text": "מלה הרגישה שהיא לא יכולה לסבול תחת הבסכה שהיא עתתה על עצמה של כאילו בחורה גויה,"
  },
  {
   "start": 252.81,
   "end": 257.05,
   "text": "היא פשוט נעלה את עצמה בחדר שלה והחלה,"
  },
  {
   "start": 259.35,
   "end": 259.55,
   "text": "החלה"
  },
  {
   "start": 261.27,
   "end": 274.96,
   "text": "לתת דרור לנשמה שלה. היא החלה לשיר את כל נדרי אותה תפילה הפותחת את תפילות יום הכיפורים,"
  },
  {
   "start": 276.46,
   "end": 276.98,
   "text": "ולרגע,"
  },
  {
   "start": 278.34,
   "end": 282.98,
   "text": "לרגע היא מצאת עצמה במרחבי דמיונה, בבית הכנסת,"
  },
  {
   "start": 283.74,
   "end": 284.34,
   "text": "באזהרה,"
  },
  {
   "start": 291.11,
   "end": 292.11,
   "text": "מילא לא שמה לב,"
  },
  {
   "start": 293.33,
   "end": 300.3,
   "text": "מילא לא חשה באיזה תנועה של צל ליד החלום מישהו"
  },
  {
   "start": 302.06,
   "end": 306.02,
   "text": "מישהו שמע אותה, אותו מישהו גם רץ"
  },
  {
   "start": 307.84,
   "end": 310.28,
   "text": "למטה הגסטאפו באנדוורפן."
  },
  {
   "start": 314.52,
   "end": 315.56,
   "text": "כמה שעות אחר כך"
  },
  {
   "start": 316.56,
   "end": 317.56,
   "text": "התבררה הטרגדיה,"
  },
  {
   "start": 318.44,
   "end": 319.24,
   "text": "מלה נחשפה."
  },
  {
   "start": 324.42,
   "end": 326.38,
   "text": "זמן קצר אחר כך היא מועברת לאושוויץ,"
  },
  {
   "start": 327.6,
   "end": 328.74,
   "text": "למחנה המוות."
  },
  {
   "start": 331.36,
   "end": 332.18,
   "text": "ברכבת לאושוויץ,"
  },
  {
   "start": 334.73,
   "end": 337.33,
   "text": "מלה, מלה שהייתה בחורה מבריקה, מבינה עניין."
  },
  {
   "start": 338.97,
   "end": 339.27,
   "text": "היא רואה,"
  },
  {
   "start": 340.05,
   "end": 340.71,
   "text": "היא רואה את המוות,"
  },
  {
   "start": 340.71,
   "end": 343.05,
   "text": "היא רואה את הקשיים,"
  },
  {
   "start": 344.09,
   "end": 346.53,
   "text": "היא רואה את היחס של הגרמנים הנאצים, היא מבינה,"
  },
  {
   "start": 347.05,
   "end": 351.0,
   "text": "היא מבינה מה מתכננים עבור היהודים."
  },
  {
   "start": 351.54,
   "end": 354.72,
   "text": "ובאמת כשמגיעים למחנה המוות אושוויץ,"
  },
  {
   "start": 356.66,
   "end": 357.68,
   "text": "כל הנוסעים יורדים,"
  },
  {
   "start": 358.34,
   "end": 358.94,
   "text": "כל הנוסעות"
  },
  {
   "start": 360.24,
   "end": 361.7,
   "text": "יורדות ונדחפות,"
  },
  {
   "start": 364.01,
   "end": 365.29,
   "text": "ומקבלת את בניהם הקאפו,"
  },
  {
   "start": 366.11,
   "end": 373.86,
   "text": "הקאפו האכזרית שצועקת, שהולמת,"
  },
  {
   "start": 374.42,
   "end": 380.7,
   "text": "שמחליבה לאותן יהודיות אומללות שעדיין ישנותיו בהם שיג של תקווה,"
  },
  {
   "start": 381.02,
   "end": 384.02,
   "text": "אולי יוצאו בשלום מהמקום הזה."
  },
  {
   "start": 385.56,
   "end": 385.82,
   "text": "מילא"
  },
  {
   "start": 386.72,
   "end": 389.82,
   "text": "מהישירה מבט כלפי הקאפו האכזרית הזאת,"
  },
  {
   "start": 390.56,
   "end": 393.4,
   "text": "ולפתע היא פוסעת צעד ועוד צעד,"
  },
  {
   "start": 393.76,
   "end": 396.9,
   "text": "והיא מוצאת את עצמה מול אותה אישה אימתנית,"
  },
  {
   "start": 398.06,
   "end": 402.3,
   "text": "ללא היסוס. היא הרימה את ידה וסדרה לה על לחיה."
  },
  {
   "start": 402.3,
   "end": 410.62,
   "text": "שקט השתרר לו בכל האזור."
  },
  {
   "start": 411.62,
   "end": 414.4,
   "text": "שקט מזרה אימים."
  },
  {
   "start": 416.78,
   "end": 417.62,
   "text": "לפתע נשמע קול,"
  },
  {
   "start": 418.48,
   "end": 419.92,
   "text": "ליהודייה הזאת יש אופי."
  },
  {
   "start": 421.1,
   "end": 422.24,
   "text": "את, יש לך אופי."
  },
  {
   "start": 424.85,
   "end": 425.99,
   "text": "זה היה דוקטור קליין."
  },
  {
   "start": 427.27,
   "end": 431.55,
   "text": "דוקטור קליין היה רופא הנשים של בלוק הנשים של אושוויץ."
  },
  {
   "start": 436.97,
   "end": 438.35,
   "text": "אני אדאג לך לתפקיד טוב פה,"
  },
  {
   "start": 439.21,
   "end": 440.31,
   "text": "אמר דוקטור קליין,"
  },
  {
   "start": 440.31,
   "end": 446.99,
   "text": "שהתפעל מאומץ הרוח לגבורת הנפש של מלה."
  },
  {
   "start": 448.41,
   "end": 453.87,
   "text": "ומלה מצאה את עצמה נהפכת למתרגמת הראשית של מפקדת המחנה."
  },
  {
   "start": 455.71,
   "end": 461.27,
   "text": "להיות המתרגמת הראשית של מפקדת המחנה זה אומר סיכוי גדול להציל את חייך."
  },
  {
   "start": 462.83,
   "end": 473.66,
   "text": "נעים הרבה יותר טובים זה היה חלומה של כל יהודייה באושוויץ אבל לא"
  },
  {
   "start": 474.36,
   "end": 475.54,
   "text": "לא של יהודיה כמלה."
  },
  {
   "start": 477.48,
   "end": 481.02,
   "text": "היא מתפקדת כמתרגמת,"
  },
  {
   "start": 481.92,
   "end": 483.3,
   "text": "אבל כל הזמן ללא הרף."
  },
  {
   "start": 486.77,
   "end": 492.95,
   "text": "היא בוטחת בריבונו של עולם ומשתדלת למלא את זמנה ללא הרף בעזרה לאחיותיה,"
  },
  {
   "start": 493.45,
   "end": 497.17,
   "text": "סיוע, חסד, כל מה שהיא יכולה לעזור לאחיותיה היא עושה."
  },
  {
   "start": 498.79,
   "end": 500.69,
   "text": "מלה יודעת דבר אחד,"
  },
  {
   "start": 502.79,
   "end": 505.87,
   "text": "אני נשלחתי פה לצורך תפקיד לעזור לאחיותיי היהודיות,"
  },
  {
   "start": 506.37,
   "end": 507.75,
   "text": "ואני אעשה את זה בצורה הכי טובה."
  },
  {
   "start": 508.55,
   "end": 509.17,
   "text": "ולא רק זה,"
  },
  {
   "start": 510.55,
   "end": 513.09,
   "text": "היא הולכת ומתחילה להעביר חומר,"
  },
  {
   "start": 514.15,
   "end": 516.39,
   "text": "היא מתחילה להעביר פצצות למחתרת,"
  },
  {
   "start": 522.72,
   "end": 524.26,
   "text": "סיכון חיים של ממש."
  },
  {
   "start": 524.88,
   "end": 528.64,
   "text": "אבל מילה מוכנה למסור את נפשה כדי אולי להציל,"
  },
  {
   "start": 529.16,
   "end": 533.36,
   "text": "כדי אולי לעשות משהו למען העם שלה."
  },
  {
   "start": 541.37,
   "end": 542.19,
   "text": "ושוב הנשמה,"
  },
  {
   "start": 543.01,
   "end": 544.71,
   "text": "ושוב הנשמה זועקת."
  },
  {
   "start": 545.29,
   "end": 547.53,
   "text": "מילה כבר לא יכלה להחזיק במחנה המערכת."
  },
  {
   "start": 547.93,
   "end": 561.98,
   "text": "היא תכננה פריחה ובאמת מקץ זמן קצר בחסות החשיכה מלע בורחת."
  },
  {
   "start": 563.86,
   "end": 568.68,
   "text": "מלע בורחת מהמחנה והנאצים בלחץ."
  },
  {
   "start": 570.6,
   "end": 573.82,
   "text": "היהודיה הזאת יודעת יותר מדי, צריך לתפוס אותה."
  },
  {
   "start": 574.24,
   "end": 579.28,
   "text": "היהודיה הזאת יודעת יותר מדי, צריך בכל מקרה לא לוותר."
  },
  {
   "start": 583.88,
   "end": 587.0,
   "text": "הפקודה מועברת בכל מרחבי הגזנאבו ובכל המקומות."
  },
  {
   "start": 587.0,
   "end": 596.52,
   "text": "וחיפוש נרחב מתבצע אחרי מלע שנהפכת למוקד של עוצמה רוחנית בקרב אסירות המחנה."
  },
  {
   "start": 599.43,
   "end": 605.95,
   "text": "גלי הערצה לאותה יהודייה שדבקה בשם מתברך,"
  },
  {
   "start": 607.11,
   "end": 610.21,
   "text": "ששום דבר לא שובר את נפשה."
  },
  {
   "start": 619.53,
   "end": 624.63,
   "text": "והאסירות מתפללות יום-יום, לילה-לילה לשלמה,"
  },
  {
   "start": 629.72,
   "end": 630.34,
   "text": "אבל מלע,"
  },
  {
   "start": 630.34,
   "end": 633.44,
   "text": "מילא לא גמרה את התפקיד שלה בעולם,"
  },
  {
   "start": 636.02,
   "end": 639.04,
   "text": "למילא נועד עוד תפקיד מיוחד."
  },
  {
   "start": 646.03,
   "end": 646.89,
   "text": "שבוע אחר כך,"
  },
  {
   "start": 649.21,
   "end": 650.49,
   "text": "לפתע במחנה אושוויץ,"
  },
  {
   "start": 651.67,
   "end": 654.25,
   "text": "באמצע הלילה, נשמע קול אזעקה."
  },
  {
   "start": 655.31,
   "end": 656.89,
   "text": "קול אזעקה החריד את הלילה."
  },
  {
   "start": 658.61,
   "end": 660.67,
   "text": "קול אנשים הוצאו החוצה לגלוק אנשים."
  },
  {
   "start": 661.85,
   "end": 662.73,
   "text": "נעמדות."
  },
  {
   "start": 667.4,
   "end": 668.06,
   "text": "ולפתע"
  },
  {
   "start": 668.06,
   "end": 672.92,
   "text": "מתקרבת לדמות ובגמותה עוד פגויות"
  },
  {
   "start": 675.06,
   "end": 676.06,
   "text": "מתקרבת לדמות עדינה."
  },
  {
   "start": 677.86,
   "end": 678.32,
   "text": "מלה,"
  },
  {
   "start": 679.34,
   "end": 681.66,
   "text": "מלה חזרה, נתפסה."
  },
  {
   "start": 683.2,
   "end": 688.28,
   "text": "ואז לפתע אותם הסירות שלכאורה נדרש איבדו צלם אדם,"
  },
  {
   "start": 688.94,
   "end": 692.26,
   "text": "לפתע נשמעה נעימה מגרונותיהם, מליבם."
  },
  {
   "start": 692.98,
   "end": 697.32,
   "text": "מלה, מלה, מלה, מלה, מלה,"
  },
  {
   "start": 697.9,
   "end": 698.5,
   "text": "מלה!"
  },
  {
   "start": 700.76,
   "end": 709.82,
   "text": "ובקול המחנה נשמע הזעקה הזאת, מלה! מלה! ובחסות הלילה, נשמעו מאוד מקומות במחנה, מלה! מלה!"
  },
  {
   "start": 717.65,
   "end": 718.35,
   "text": "דוקטור קליין"
  },
  {
   "start": 719.03,
   "end": 719.97,
   "text": "נעמד מול מלה,"
  },
  {
   "start": 721.09,
   "end": 723.43,
   "text": "היה לך כל מה שהיא יהודיה יכולה לחלום עליו."
  },
  {
   "start": 725.77,
   "end": 726.85,
   "text": "ואת בגדת בנו?"
  },
  {
   "start": 728.55,
   "end": 734.65,
   "text": "מלה הרימה את ידה וסתרה לדוקטור קליין."
  },
  {
   "start": 734.71,
   "end": 737.13,
   "text": "מוטב למות,"
  },
  {
   "start": 738.05,
   "end": 740.51,
   "text": "מוטב למות ולא לסייע לכם,"
  },
  {
   "start": 744.17,
   "end": 748.2,
   "text": "אמרה נחרצות ונדמעות בעיניים,"
  },
  {
   "start": 749.98,
   "end": 750.88,
   "text": "וכל האסירות"
  },
  {
   "start": 753.39,
   "end": 757.19,
   "text": "פיתות בה כלא מאמינות."
  },
  {
   "start": 759.03,
   "end": 759.93,
   "text": "ואז הוסיפה מלח,"
  },
  {
   "start": 760.51,
   "end": 762.55,
   "text": "אני לא ארשה לכם להתעלל בי."
  },
  {
   "start": 763.49,
   "end": 766.43,
   "text": "אני בת ישראל לביתו של מלך מלכי המלכים הקדוש ברוך הוא."
  },
  {
   "start": 766.91,
   "end": 768.55,
   "text": "אני לא ארשה לכם להתעלל בי."
  },
  {
   "start": 770.76,
   "end": 773.22,
   "text": "לא ארשה לכם להתעלל בי, אמרה מלח."
  },
  {
   "start": 773.9,
   "end": 781.48,
   "text": "ולפתע מלמלה בכאב השם נתברך, יסלח לי הוא יסלח לי"
  },
  {
   "start": 782.58,
   "end": 783.04,
   "text": "ואז"
  },
  {
   "start": 784.14,
   "end": 791.14,
   "text": "ואז בתנועה חדה ומהירה היא שלפה סקין גילוייה חדה"
  },
  {
   "start": 793.62,
   "end": 795.1,
   "text": "וחתכה לה את הורידים"
  },
  {
   "start": 797.46,
   "end": 800.16,
   "text": "לנגד העיניים הנדהמות שבהו בה"
  },
  {
   "start": 801.7,
   "end": 803.44,
   "text": "לפני שמישהו הספיק להבין"
  },
  {
   "start": 803.9,
   "end": 805.78,
   "text": "מלע צנחה ארצה."
  },
  {
   "start": 807.94,
   "end": 812.08,
   "text": "דוקטור טליין צרח, חייבים, חייבים לתלות אותה."
  },
  {
   "start": 813.1,
   "end": 817.18,
   "text": "תכננו לה מוות, לא ייתכן, היא לא תמות ככה, חייבים לתלות אותה לפני כולם."
  },
  {
   "start": 821.98,
   "end": 823.06,
   "text": "היה כבר מאוחר,"
  },
  {
   "start": 825.61,
   "end": 829.38,
   "text": "הם לא הצליחו להחיות את מלע."
  },
  {
   "start": 833.12,
   "end": 834.56,
   "text": "ובזעם ובתסכול,"
  },
  {
   "start": 835.6,
   "end": 837.1,
   "text": "דוקטור טליין עזב את המחנה."
  },
  {
   "start": 838.68,
   "end": 842.04,
   "text": "כשמלע מועברת גוססת למשרפות,"
  },
  {
   "start": 843.04,
   "end": 845.52,
   "text": "במשרפה מספר שתיים באושוויץ."
  },
  {
   "start": 849.66,
   "end": 850.48,
   "text": "שם במשרפה,"
  },
  {
   "start": 851.32,
   "end": 852.5,
   "text": "בכוחות אחרונים,"
  },
  {
   "start": 853.4,
   "end": 859.44,
   "text": "היא פתחה את עיניה הטהורות וסימנה לבחורים להתקרב אליה."
  },
  {
   "start": 861.18,
   "end": 862.94,
   "text": "הבחורים שהיו במשרפות התקרבו,"
  },
  {
   "start": 864.26,
   "end": 865.64,
   "text": "ואז היא מלמלה ואמרה להם,"
  },
  {
   "start": 866.72,
   "end": 867.58,
   "text": "היא לחשה להם,"
  },
  {
   "start": 868.24,
   "end": 870.34,
   "text": "תקברו אותי, בבקשה,"
  },
  {
   "start": 871.3,
   "end": 874.6,
   "text": "תקברו אותי ותאמרו עליי קדיש."
  },
  {
   "start": 876.78,
   "end": 901.31,
   "text": "כך היא לחשה הגיבורה היהודיה הצעירה עוד שנייה ועוד שנייה ועיניה נעצמו ונשמתה יצאה בטהרה בלילה"
  },
  {
   "start": 902.89,
   "end": 913.44,
   "text": "בלילה התגנבו כמה מהבחורים באושוויץ והביאו את האפר הקדוש שלה לקבורה רוח חדשה"
  },
  {
   "start": 914.66,
   "end": 916.74,
   "text": "אמונה במחנה"
  },
  {
   "start": 917.62,
   "end": 920.38,
   "text": "רוח חדשה במחנה."
  },
  {
   "start": 921.34,
   "end": 923.3,
   "text": "תוכנית התקוממות בשם מלה."
  },
  {
   "start": 929.26,
   "end": 930.28,
   "text": "תוכנית התקוממות"
  },
  {
   "start": 932.8,
   "end": 934.52,
   "text": "תוכננה במחנה אושוויץ."
  },
  {
   "start": 934.98,
   "end": 935.8,
   "text": "לה תוכנית קראו"
  },
  {
   "start": 936.64,
   "end": 937.94,
   "text": "בשם מלה."
  },
  {
   "start": 947.52,
   "end": 948.0,
   "text": "תגידו לי,"
  },
  {
   "start": 949.78,
   "end": 951.26,
   "text": "למה אנחנו מספרים לכם את זה?"
  },
  {
   "start": 952.84,
   "end": 960.84,
   "text": "אם נחשוב לשנייה מה גורם פלאי פלאות, מה גורם לבחורה יהודייה"
  },
  {
   "start": 960.84,
   "end": 989.54,
   "text": "שלכאורה השיגה את כל מה שבחורה יכולה לשאוף בהתאם לתנאים שהיא הייתה יכלה אולי להינצל מה גרם לה למסור נפש מה גרם לה לעזור לאחיותיה למרות המחיר הכבד שהיא ידעה וידעה שהיא צריכה לשלם איזה סוד"
  },
  {
   "start": 990.58,
   "end": 991.86,
   "text": "איזה סוד מפעיל את היהודי"
  }
 ]
}