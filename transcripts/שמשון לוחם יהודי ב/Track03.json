{
 "disc": "שמשון לוחם יהודי ב",
 "track": "Track03",
 "duration": 769.896,
 "segments": [
  {
   "start": 20.44,
   "end": 23.0,
   "text": "יום החג של פלישתים מגיע."
  },
  {
   "start": 26.61,
   "end": 31.05,
   "text": "מכל ארץ פלישתים נוהרים לחגוג את ניצחונם על שמשון."
  },
  {
   "start": 33.19,
   "end": 34.59,
   "text": "כשכל הפלישתים בטוחים,"
  },
  {
   "start": 35.23,
   "end": 36.87,
   "text": "כי על ידי העבודה הזרה שלהם"
  },
  {
   "start": 37.57,
   "end": 38.93,
   "text": "נפל גיבור ישראל."
  },
  {
   "start": 40.87,
   "end": 46.29,
   "text": "הם הבינו, הרי לא ייתכן שגיבור ישראל כל כך נורא וקדוש ייפול בידי אישה."
  },
  {
   "start": 47.89,
   "end": 48.37,
   "text": "אין זה,"
  },
  {
   "start": 49.29,
   "end": 50.67,
   "text": "כי אם על ידי כוחות טומאה,"
  },
  {
   "start": 51.57,
   "end": 51.95,
   "text": "זה לא טבעי,"
  },
  {
   "start": 52.99,
   "end": 53.47,
   "text": "זה לא ייתכן."
  },
  {
   "start": 54.33,
   "end": 56.81,
   "text": "לכן הם תלו את הסיבה בעבודה זרה שלהם, בטומאה שלהם."
  },
  {
   "start": 58.89,
   "end": 61.13,
   "text": "הם לא מבינים שכאשר יהודי"
  },
  {
   "start": 61.99,
   "end": 63.13,
   "text": "מתרחק קצת מהשם,"
  },
  {
   "start": 64.43,
   "end": 65.65,
   "text": "אז הוא כבר נמצא בבעיה."
  },
  {
   "start": 66.75,
   "end": 69.51,
   "text": "כמו שהם לא מבינים שאם יהודי זועק אל השם,"
  },
  {
   "start": 70.25,
   "end": 70.45,
   "text": "הם בבעיה."
  },
  {
   "start": 72.65,
   "end": 74.55,
   "text": "כוחות הטומאה בבעיה."
  },
  {
   "start": 76.29,
   "end": 79.19,
   "text": "וכך מיטב מנהיגי פלישתים וכל העם,"
  },
  {
   "start": 79.75,
   "end": 82.97,
   "text": "גברים, נשים וטף, נוהרים לעזה,"
  },
  {
   "start": 83.55,
   "end": 86.57,
   "text": "רחובות עזה, מתנוצצים להם בססגוניות."
  },
  {
   "start": 87.25,
   "end": 88.35,
   "text": "כשבמרכז העיר,"
  },
  {
   "start": 89.03,
   "end": 89.81,
   "text": "באולם הענק,"
  },
  {
   "start": 90.71,
   "end": 92.19,
   "text": "בית העבודה זרע דגון,"
  },
  {
   "start": 92.87,
   "end": 95.93,
   "text": "לשם מופנות כל העיניים הטמעות של פלישתים."
  },
  {
   "start": 98.44,
   "end": 99.48,
   "text": "והאולם הענק"
  },
  {
   "start": 100.08,
   "end": 101.7,
   "text": "היה מלא מפה לפה,"
  },
  {
   "start": 102.42,
   "end": 106.06,
   "text": "מנהיגי פלישתים, כל הממשלה, כל המנהיגות הפלישתית."
  },
  {
   "start": 107.92,
   "end": 108.72,
   "text": "בתוך האולם,"
  },
  {
   "start": 109.98,
   "end": 110.82,
   "text": "בתוך הבית הזה,"
  },
  {
   "start": 112.24,
   "end": 112.88,
   "text": "אלפי אנשים,"
  },
  {
   "start": 113.8,
   "end": 116.6,
   "text": "בחוץ, בחוץ מתגודדים המונים."
  },
  {
   "start": 117.58,
   "end": 120.46,
   "text": "למעלה בגג הבניין, רק בשפה,"
  },
  {
   "start": 120.84,
   "end": 121.72,
   "text": "שפת הבניין,"
  },
  {
   "start": 122.16,
   "end": 124.12,
   "text": "על הגג היו אלפי פלישתים,"
  },
  {
   "start": 124.72,
   "end": 129.84,
   "text": "ובכל רוחב הגג הענקי נדחסו עשרות אלפי אנשים,"
  },
  {
   "start": 130.42,
   "end": 132.26,
   "text": "כולם חשובי פלישתים."
  },
  {
   "start": 133.12,
   "end": 134.8,
   "text": "כולם הלוחמים של פלישתים."
  },
  {
   "start": 136.26,
   "end": 138.08,
   "text": "מתו השמנה והסלתה של פלישתים,"
  },
  {
   "start": 139.36,
   "end": 142.2,
   "text": "והם קופצים מיוזעים, סוגדים ל..."
  },
  {
   "start": 143.12,
   "end": 144.18,
   "text": "לעבודה זרה שלהם."
  },
  {
   "start": 146.34,
   "end": 146.94,
   "text": "ובאולם,"
  },
  {
   "start": 147.6,
   "end": 148.66,
   "text": "באולם המתח גאה,"
  },
  {
   "start": 149.42,
   "end": 151.9,
   "text": "כולם מחכים אל הרגע המיוחל,"
  },
  {
   "start": 152.88,
   "end": 156.32,
   "text": "בו שמשון, גיבור ישראל, אמור להיכנס פנימה,"
  },
  {
   "start": 156.98,
   "end": 159.02,
   "text": "עיוור, מוכה ונכה,"
  },
  {
   "start": 159.74,
   "end": 164.32,
   "text": "ולרקוד ולשחק לפניהם כנער שעשועים."
  },
  {
   "start": 169.9,
   "end": 170.18,
   "text": "ואז"
  },
  {
   "start": 170.72,
   "end": 172.42,
   "text": "רעש נשמע מכיוון הכניסה"
  },
  {
   "start": 173.36,
   "end": 174.76,
   "text": "אל מרכז האולם,"
  },
  {
   "start": 175.74,
   "end": 179.98,
   "text": "הובל שמשון לכל מצהלות הנאספים."
  },
  {
   "start": 182.73,
   "end": 185.33,
   "text": "הם מאלצים את שמשון לשחק לפניהם."
  },
  {
   "start": 187.2,
   "end": 188.2,
   "text": "מי שהיה מתקרב"
  },
  {
   "start": 189.2,
   "end": 193.26,
   "text": "היה רואה הבעת צער איומה בפניו המיוסרים של שמשון."
  },
  {
   "start": 195.08,
   "end": 198.92,
   "text": "אבל אף את הזכות לבכות הם לקחו ממנו"
  },
  {
   "start": 199.66,
   "end": 200.94,
   "text": "כשלקחו את שתי עיניו."
  },
  {
   "start": 201.6,
   "end": 205.92,
   "text": "גם את הזכות לבכות הם לקחו ממנו כשלקחו את שתי עיניו."
  },
  {
   "start": 206.88,
   "end": 209.22,
   "text": "ליבו של שמשון בוער בקרבו."
  },
  {
   "start": 210.24,
   "end": 212.04,
   "text": "שם שמאי מתחלל בפרהסיה."
  },
  {
   "start": 217.4,
   "end": 218.92,
   "text": "והוא ככה משחק לפניהם."
  },
  {
   "start": 219.5,
   "end": 220.02,
   "text": "אין לו ברירה."
  },
  {
   "start": 221.4,
   "end": 222.66,
   "text": "אבל כשסימנו לשומרים,"
  },
  {
   "start": 223.42,
   "end": 225.74,
   "text": "כשסימנו לשומרים שלו לאפשר,"
  },
  {
   "start": 226.26,
   "end": 229.56,
   "text": "לאפשר לו לנוח על מנת שיוכל להמשיך"
  },
  {
   "start": 230.32,
   "end": 231.58,
   "text": "ולשחק בפניהם,"
  },
  {
   "start": 232.74,
   "end": 236.76,
   "text": "ניצל שמשון את ההפוגה וביקש מהנער שהיה איתו,"
  },
  {
   "start": 237.74,
   "end": 238.42,
   "text": "אני רוצה לנוח."
  },
  {
   "start": 239.4,
   "end": 240.44,
   "text": "תן לי לי שיין על משהו."
  },
  {
   "start": 241.54,
   "end": 244.56,
   "text": "תושיט לי את הידיים בבקשה על עמודי הבניין."
  },
  {
   "start": 245.84,
   "end": 246.4,
   "text": "והנער,"
  },
  {
   "start": 247.18,
   "end": 249.5,
   "text": "הנער הניח את הידיים של שמשון"
  },
  {
   "start": 251.36,
   "end": 254.34,
   "text": "על העמודים התומכים את העולם הענק."
  },
  {
   "start": 256.36,
   "end": 258.28,
   "text": "שמשון נשען מעט,"
  },
  {
   "start": 274.77,
   "end": 275.79,
   "text": "שמשון נשען מעט,"
  },
  {
   "start": 276.87,
   "end": 279.85,
   "text": "ובעוד הפלישתים צוהלים להם וצוחקים,"
  },
  {
   "start": 281.79,
   "end": 284.65,
   "text": "החל שמשון מתחנן אל השם,"
  },
  {
   "start": 287.43,
   "end": 289.17,
   "text": "זועק אל השם מקירות ליבו,"
  },
  {
   "start": 290.43,
   "end": 292.71,
   "text": "זועק אל השם מתוך ליבו, החוזר בתשובה."
  },
  {
   "start": 294.63,
   "end": 296.49,
   "text": "וכך התחנן שמשון,"
  },
  {
   "start": 297.35,
   "end": 298.95,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 300.17,
   "end": 304.45,
   "text": "זוכרני נא וחזקני נא,"
  },
  {
   "start": 305.27,
   "end": 312.2,
   "text": "אך הפעם הזו, האלוקים."
  },
  {
   "start": 314.35,
   "end": 319.35,
   "text": "זוכרני נא, חזקני נא, אך הפעם הזאת, האלוקים, והיא נקמה,"
  },
  {
   "start": 319.93,
   "end": 322.65,
   "text": "נקם אחת משתי עיניי מפלישתים."
  },
  {
   "start": 324.05,
   "end": 325.87,
   "text": "ריבונו של עולם, זוכרי נינה,"
  },
  {
   "start": 326.45,
   "end": 328.37,
   "text": "זכור שהייתי נזיר אלוקי מבטן,"
  },
  {
   "start": 329.01,
   "end": 333.19,
   "text": "זכור את השנים ששפטתי את בני ישראל, אהובי בצדק,"
  },
  {
   "start": 334.05,
   "end": 337.01,
   "text": "זכור את אמא שלי שהשתדלה לגדל אותי."
  },
  {
   "start": 337.85,
   "end": 345.94,
   "text": "זוכרי נינה וחזקי נינה."
  },
  {
   "start": 346.92,
   "end": 347.66,
   "text": "תן לי כוח,"
  },
  {
   "start": 348.28,
   "end": 349.28,
   "text": "כוח רוחני,"
  },
  {
   "start": 350.28,
   "end": 353.18,
   "text": "כוח של תשובה להילחם, לא להיכנע."
  },
  {
   "start": 353.4,
   "end": 354.38,
   "text": "לקום מהנפילות."
  },
  {
   "start": 355.08,
   "end": 357.26,
   "text": "אך הפעם הזאת, רק הגלגול הזה,"
  },
  {
   "start": 357.72,
   "end": 359.66,
   "text": "רק העולם הזה, רק הפעם הזאת."
  },
  {
   "start": 360.32,
   "end": 361.7,
   "text": "האלוקים בורא עולם,"
  },
  {
   "start": 362.32,
   "end": 365.12,
   "text": "למען השם שלך, אלוקים!"
  },
  {
   "start": 366.9,
   "end": 367.82,
   "text": "והיא נקמה,"
  },
  {
   "start": 368.56,
   "end": 371.9,
   "text": "נקם אחת משתי עיניי מפלישתים."
  },
  {
   "start": 372.62,
   "end": 373.58,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 374.4,
   "end": 379.06,
   "text": "תן לי לנקום על מה שעשו לי, שנקרו לי את העיניים."
  },
  {
   "start": 379.8,
   "end": 381.96,
   "text": "תן לי אפשרות לנקום על עין אחת."
  },
  {
   "start": 382.52,
   "end": 382.92,
   "text": "עכשיו,"
  },
  {
   "start": 383.96,
   "end": 387.38,
   "text": "ואת העין השנייה תשמור לי לעתיד לבוא."
  },
  {
   "start": 390.47,
   "end": 391.43,
   "text": "אמר שמשון,"
  },
  {
   "start": 392.63,
   "end": 394.33,
   "text": "זכור לי שהייתי נזיר אלוקי,"
  },
  {
   "start": 395.33,
   "end": 396.81,
   "text": "תחזק אותי, תן לי כוח."
  },
  {
   "start": 398.39,
   "end": 401.71,
   "text": "לא להיכנע לקום מכל הנפילות, גם מהנפילה הזאת."
  },
  {
   "start": 403.59,
   "end": 406.85,
   "text": "זוכרני נא חזקני נא אך הפעם הזו,"
  },
  {
   "start": 407.31,
   "end": 408.35,
   "text": "רק הפעם הזו,"
  },
  {
   "start": 408.67,
   "end": 410.83,
   "text": "כל ניסיון זו מלחמה בפני עצמה,"
  },
  {
   "start": 413.29,
   "end": 415.23,
   "text": "רק הפעם הזו."
  },
  {
   "start": 416.95,
   "end": 420.39,
   "text": "רק את מסכת החיים הזאת תן לי לעבור, בורא עולם."
  },
  {
   "start": 421.29,
   "end": 425.65,
   "text": "למען שמך זוכרני נא וחזקני נא,"
  },
  {
   "start": 426.11,
   "end": 430.73,
   "text": "אך הפעם הזו האלוקים למען שמך, אלוקים, לא בשבילי."
  },
  {
   "start": 432.21,
   "end": 433.95,
   "text": "ותן לי אפשרות לנקום"
  },
  {
   "start": 436.01,
   "end": 436.77,
   "text": "על מה שנקרו"
  },
  {
   "start": 438.03,
   "end": 438.81,
   "text": "את עיניי."
  },
  {
   "start": 439.27,
   "end": 441.05,
   "text": "תן לי נקמה של עין אחת,"
  },
  {
   "start": 442.45,
   "end": 443.09,
   "text": "עכשיו,"
  },
  {
   "start": 443.91,
   "end": 447.37,
   "text": "ואת שכר העין השנייה תשמור לי לעתיד לבוא."
  },
  {
   "start": 448.01,
   "end": 453.17,
   "text": "אז יהיו דורות אחרונים שיצטרכו להתמודד עם ניסיונות קשים של שמירת עיניים."
  },
  {
   "start": 453.75,
   "end": 457.29,
   "text": "אז לעתיד לבוא אני אבקש את נקמת העין השנייה שלי."
  },
  {
   "start": 458.59,
   "end": 463.49,
   "text": "תן לי ריבונו של עולם לנקום נקמת אחת משתי עיניי מפלישתים."
  },
  {
   "start": 464.01,
   "end": 469.11,
   "text": "זוכרני נא וחזקני נא, אך הפעם הזאת האלוקים"
  },
  {
   "start": 470.21,
   "end": 473.03,
   "text": "והיא נקמה נקם אחת משתי עיניי."
  },
  {
   "start": 473.09,
   "end": 487.3,
   "text": "עיניי מפלישתים ואז חשים שון"
  },
  {
   "start": 488.52,
   "end": 490.94,
   "text": "איך ננחסכת בו שוב."
  },
  {
   "start": 492.72,
   "end": 494.48,
   "text": "כיבמי כבימים ימימה"
  },
  {
   "start": 495.16,
   "end": 496.26,
   "text": "רוח השם,"
  },
  {
   "start": 497.52,
   "end": 498.9,
   "text": "רוח גבורה,"
  },
  {
   "start": 499.86,
   "end": 501.42,
   "text": "רוח של קדושה."
  },
  {
   "start": 506.24,
   "end": 508.44,
   "text": "אפילו שאדם מאבד את עצמו לדעת,"
  },
  {
   "start": 509.12,
   "end": 511.22,
   "text": "ייתכן שמאבד את נפשו בשמיים,"
  },
  {
   "start": 511.74,
   "end": 513.64,
   "text": "אבל אני מוכן לספוג כל עונש,"
  },
  {
   "start": 514.26,
   "end": 518.7,
   "text": "ובלבד שאזכה להינקם בפלישתים על עין אחת,"
  },
  {
   "start": 519.32,
   "end": 522.12,
   "text": "ולעתיד לבוא אני אחכה להם עם העין השנייה."
  },
  {
   "start": 522.76,
   "end": 523.22,
   "text": "שמשון,"
  },
  {
   "start": 523.98,
   "end": 527.26,
   "text": "לפט בשתי ידיו את עמודי התווך של בית דגון,"
  },
  {
   "start": 528.3,
   "end": 530.86,
   "text": "מוכן לסבול בעולם הזה ובעולם הבא,"
  },
  {
   "start": 532.1,
   "end": 532.84,
   "text": "וזעק"
  },
  {
   "start": 534.22,
   "end": 535.28,
   "text": "בקול מר,"
  },
  {
   "start": 537.02,
   "end": 542.26,
   "text": "תמות נפשי עם פלישתים!"
  },
  {
   "start": 543.24,
   "end": 554.22,
   "text": "טמאות נפשים פלישתים ואז שמשון דחף בעוצמה את עמודי הבית."
  },
  {
   "start": 556.49,
   "end": 558.91,
   "text": "דממת מוות השתררה בחלל האולם."
  },
  {
   "start": 559.65,
   "end": 561.55,
   "text": "עיני כולם נפערו בפחד מוות."
  },
  {
   "start": 562.85,
   "end": 569.15,
   "text": "ההבנה האיומה שהם הולכים למות חלחלה להם אל תודעתם,"
  },
  {
   "start": 569.89,
   "end": 571.01,
   "text": "זחלה להם אל מוחם,"
  },
  {
   "start": 571.67,
   "end": 575.71,
   "text": "והבעת פחד תהומי תפסה את מקול ארץ השמחה,"
  },
  {
   "start": 577.98,
   "end": 580.22,
   "text": "וכך עוד שנייה חלפה,"
  },
  {
   "start": 581.44,
   "end": 586.02,
   "text": "וכל רעד אדיר העמודים נפלו,"
  },
  {
   "start": 587.4,
   "end": 588.38,
   "text": "העמודים נפלו,"
  },
  {
   "start": 589.54,
   "end": 592.2,
   "text": "ואיתם קרס הבניין הענק,"
  },
  {
   "start": 593.6,
   "end": 598.86,
   "text": "קובר תחתיו עשרות אלפי פלישתים."
  },
  {
   "start": 601.14,
   "end": 607.12,
   "text": "שמשון נקם ומת עם פלישתים,"
  },
  {
   "start": 608.04,
   "end": 609.84,
   "text": "תמות נפשי ופלישתים."
  },
  {
   "start": 611.5,
   "end": 612.34,
   "text": "שמשון מת,"
  },
  {
   "start": 613.18,
   "end": 617.08,
   "text": "מוכן לאבד את נפשו,"
  },
  {
   "start": 619.16,
   "end": 621.18,
   "text": "לשלם על זה מחיר בשמיים,"
  },
  {
   "start": 622.24,
   "end": 627.96,
   "text": "ובלבד שהוא יזכה להינקם בפלישתים על כל מה שחוללו לו ולכל עם ישראל."
  },
  {
   "start": 632.26,
   "end": 635.28,
   "text": "הפחד שנפל על ארץ פלישתים היה כה גדול."
  },
  {
   "start": 635.84,
   "end": 641.64,
   "text": "את המכה הזו ששמשון הנחית על פלישתים לעולם הם לא יתאוששו."
  },
  {
   "start": 644.5,
   "end": 645.92,
   "text": "עשרים שנה אחר כך"
  },
  {
   "start": 646.64,
   "end": 652.04,
   "text": "עוד בפלישתים חששו שמאי שמשון יקום פתאום מהכפר שלו וינקום בהם."
  },
  {
   "start": 655.82,
   "end": 663.42,
   "text": "האחים של שמשון וכל בית מנוח אביו וכל נציגי שבטו שבדן מגיעים למקום"
  },
  {
   "start": 664.66,
   "end": 665.94,
   "text": "ואיש לא נוגע בהם."
  },
  {
   "start": 666.88,
   "end": 669.5,
   "text": "אוספים את גופת שמשון מבין ההריסות,"
  },
  {
   "start": 670.68,
   "end": 674.0,
   "text": "ואיש לא נוגע בהם, איש לא מפריע להם בדרכם."
  },
  {
   "start": 676.59,
   "end": 677.75,
   "text": "מסע הלוויה מכובד"
  },
  {
   "start": 678.45,
   "end": 681.81,
   "text": "מלווה את שמשון בדרכו האחרונה,"
  },
  {
   "start": 683.13,
   "end": 684.63,
   "text": "לפחות לעת עתה."
  },
  {
   "start": 687.59,
   "end": 689.41,
   "text": "זוכרני נא וחזקני נא,"
  },
  {
   "start": 690.25,
   "end": 691.13,
   "text": "אך הפעם הזו,"
  },
  {
   "start": 692.33,
   "end": 693.15,
   "text": "והיא האלוקים,"
  },
  {
   "start": 693.79,
   "end": 697.61,
   "text": "והיא נקמה בפלישתים נקמת אחת משתי עיניי."
  },
  {
   "start": 704.26,
   "end": 705.34,
   "text": "ושמשון נקבר,"
  },
  {
   "start": 706.04,
   "end": 711.72,
   "text": "בין צורעה ובין אשתאול בחלקת קבר מנוח."
  },
  {
   "start": 721.68,
   "end": 723.04,
   "text": "האיש שמסר את כל-כולו"
  },
  {
   "start": 723.82,
   "end": 724.94,
   "text": "לעלות מנפילה,"
  },
  {
   "start": 725.72,
   "end": 729.18,
   "text": "מוכן למסור את כולו למען השם יתברך,"
  },
  {
   "start": 730.3,
   "end": 738.49,
   "text": "למען המלחמה הגדולה של כל עם ישראל וכל הכוחות הטומאה."
  },
  {
   "start": 740.07,
   "end": 742.29,
   "text": "מוכן למסור את הכול ולנצח,"
  },
  {
   "start": 745.13,
   "end": 751.0,
   "text": "ולהוביל את עם ישראל ולעתיד לבוא."
  },
  {
   "start": 752.72,
   "end": 755.82,
   "text": "לעתיד לבוא הוא יקבל את שכר עינו השנייה,"
  },
  {
   "start": 756.44,
   "end": 759.62,
   "text": "את שכר הצער הגדול שנקרוא את עיניו השנייה,"
  },
  {
   "start": 760.2,
   "end": 760.86,
   "text": "את עינו השנייה."
  },
  {
   "start": 761.48,
   "end": 762.7,
   "text": "אוהבים אותך שמשון,"
  },
  {
   "start": 763.56,
   "end": 766.08,
   "text": "אשרינו שזכינו לשופט כמו שמשון."
  }
 ]
}