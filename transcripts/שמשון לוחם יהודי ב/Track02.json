{
 "disc": "שמשון לוחם יהודי ב",
 "track": "Track02",
 "duration": 1380.168,
 "segments": [
  {
   "start": 1.61,
   "end": 2.11,
   "text": "בלעם."
  },
  {
   "start": 2.93,
   "end": 5.65,
   "text": "בלעם, נביא אומות העולם הגדול כל כך לגביהם,"
  },
  {
   "start": 9.18,
   "end": 10.82,
   "text": "שאחרי זה כל העולם גילה את שפלותו,"
  },
  {
   "start": 11.82,
   "end": 13.52,
   "text": "מגלה את נקודות התורפה של היהודי."
  },
  {
   "start": 14.32,
   "end": 16.32,
   "text": "נקודת התורפה של היהודי, שמירת עיניים,"
  },
  {
   "start": 16.94,
   "end": 17.7,
   "text": "חוסר צניעות."
  },
  {
   "start": 19.18,
   "end": 21.14,
   "text": "את העצה הזאת הוא מסיא למדיין."
  },
  {
   "start": 22.36,
   "end": 25.44,
   "text": "אפשר להפיל את ישראל על ידי שמירת עיניים,"
  },
  {
   "start": 25.9,
   "end": 26.64,
   "text": "חוסר צניעות."
  },
  {
   "start": 28.34,
   "end": 31.7,
   "text": "ולשם כך מוכנים אומות העולם להקריב אפילו את הנסיכות שלהן,"
  },
  {
   "start": 32.36,
   "end": 33.52,
   "text": "על מנת להפיל יהודי."
  },
  {
   "start": 34.1,
   "end": 37.26,
   "text": "היצר היה יעשה הכל על מנת להפיל יהודי."
  },
  {
   "start": 37.78,
   "end": 38.52,
   "text": "יביא לנו סרטים,"
  },
  {
   "start": 38.98,
   "end": 41.42,
   "text": "תוכניות טלוויזיה, מחשבים, כסף,"
  },
  {
   "start": 41.82,
   "end": 42.34,
   "text": "סמים,"
  },
  {
   "start": 42.6,
   "end": 48.58,
   "text": "הכל. העיקר להרוג, העיקר להוריד את הצניעות בישראל, העיקר להרוג את הנשמה היהודית."
  },
  {
   "start": 50.8,
   "end": 51.08,
   "text": "וכך אז,"
  },
  {
   "start": 51.92,
   "end": 52.96,
   "text": "וכך גם בדור שלנו."
  },
  {
   "start": 54.02,
   "end": 55.82,
   "text": "היצר תוקף אותנו דווקא בנושא הזה,"
  },
  {
   "start": 56.78,
   "end": 57.92,
   "text": "הראשון לכל פורענות."
  },
  {
   "start": 59.1,
   "end": 62.34,
   "text": "שמירת עיניים לגבר וצניעות לאישה."
  },
  {
   "start": 64.58,
   "end": 65.7,
   "text": "אז בואו נחזור, בואו נחזור לשמשון."
  },
  {
   "start": 67.16,
   "end": 67.6,
   "text": "אתם יודעים,"
  },
  {
   "start": 68.5,
   "end": 69.24,
   "text": "לפני זמן רב,"
  },
  {
   "start": 69.96,
   "end": 71.44,
   "text": "בתקופת האבות הקדושים,"
  },
  {
   "start": 72.0,
   "end": 72.7,
   "text": "הייתה אישה,"
  },
  {
   "start": 73.32,
   "end": 74.96,
   "text": "בת מלכים, תמנע אשמה,"
  },
  {
   "start": 75.72,
   "end": 79.32,
   "text": "שרצתה כל כך להצטרף לעם ישראל,"
  },
  {
   "start": 79.94,
   "end": 83.26,
   "text": "ולא נתנו לה לא אברהם, לא יצחק ולא יעקב."
  },
  {
   "start": 84.34,
   "end": 85.8,
   "text": "והיא נישאה לבן של עשיו,"
  },
  {
   "start": 86.44,
   "end": 87.62,
   "text": "וממנה יצא עמלק,"
  },
  {
   "start": 89.46,
   "end": 93.1,
   "text": "והיא כאילו נשארה למעשה עם הרצון שלה להתקרב לעם ישראל."
  },
  {
   "start": 94.02,
   "end": 95.58,
   "text": "עוברות להם שנים,"
  },
  {
   "start": 96.16,
   "end": 99.26,
   "text": "ואותו רצון של אותה אישה מתממש."
  },
  {
   "start": 100.78,
   "end": 102.12,
   "text": "ניתנת לה ההזדמנות"
  },
  {
   "start": 102.8,
   "end": 104.02,
   "text": "להצטרף לעם ישראל."
  },
  {
   "start": 105.36,
   "end": 106.74,
   "text": "האם היא תנצל את ההזדמנות"
  },
  {
   "start": 107.42,
   "end": 108.12,
   "text": "ותזכה?"
  },
  {
   "start": 109.16,
   "end": 109.74,
   "text": "או אולי,"
  },
  {
   "start": 110.42,
   "end": 114.28,
   "text": "כמו שחששו האבות הקדושים שלא רצו לקבל אותה,"
  },
  {
   "start": 115.52,
   "end": 117.18,
   "text": "והיא, ברגע שתקבל הזדמנות,"
  },
  {
   "start": 117.88,
   "end": 118.62,
   "text": "תקלקל,"
  },
  {
   "start": 119.18,
   "end": 119.96,
   "text": "תהרוס,"
  },
  {
   "start": 120.58,
   "end": 121.36,
   "text": "תנתץ."
  },
  {
   "start": 126.06,
   "end": 126.32,
   "text": "בואו."
  },
  {
   "start": 127.32,
   "end": 129.52,
   "text": "בואו ביחד, נבדוק."
  },
  {
   "start": 133.6,
   "end": 135.8,
   "text": "נשמתה של תמנע מקבלת הזדמנות,"
  },
  {
   "start": 136.74,
   "end": 138.8,
   "text": "יורדת לעולם בתור אישה גויה,"
  },
  {
   "start": 139.8,
   "end": 140.6,
   "text": "דלילה שמה,"
  },
  {
   "start": 141.34,
   "end": 141.98,
   "text": "אישה יפה,"
  },
  {
   "start": 143.22,
   "end": 145.06,
   "text": "שאליה התקרב לא פחות ולא יותר"
  },
  {
   "start": 145.8,
   "end": 147.22,
   "text": "מנהיגם של ישראל,"
  },
  {
   "start": 148.36,
   "end": 150.34,
   "text": "והיא מצידה יכולה לזכות ולקלקל."
  },
  {
   "start": 153.35,
   "end": 154.29,
   "text": "נחל סורק,"
  },
  {
   "start": 155.45,
   "end": 155.69,
   "text": "שם,"
  },
  {
   "start": 156.47,
   "end": 157.25,
   "text": "שם הכל התחיל,"
  },
  {
   "start": 158.11,
   "end": 158.81,
   "text": "נחל סורק,"
  },
  {
   "start": 159.73,
   "end": 161.33,
   "text": "שם מבעד להצא הנחל,"
  },
  {
   "start": 162.25,
   "end": 163.37,
   "text": "שם ראה שמשון"
  },
  {
   "start": 163.99,
   "end": 164.41,
   "text": "אישה"
  },
  {
   "start": 164.99,
   "end": 165.85,
   "text": "ושמה דלילה,"
  },
  {
   "start": 167.05,
   "end": 168.71,
   "text": "ומשהו מושך אותו."
  },
  {
   "start": 169.67,
   "end": 173.13,
   "text": "איזה כוח קדמוני מושך אותו אל דלילה."
  },
  {
   "start": 173.97,
   "end": 176.45,
   "text": "שמשון אוהב את דלילה."
  },
  {
   "start": 177.15,
   "end": 181.23,
   "text": "הפעם שמשון אוהב את האישה הזו, את דלילה."
  },
  {
   "start": 194.1,
   "end": 197.32,
   "text": "יום אחד באים מנהיגי פלישתים"
  },
  {
   "start": 198.5,
   "end": 199.12,
   "text": "אל דלילה,"
  },
  {
   "start": 201.02,
   "end": 202.24,
   "text": "בשקט בלי שאף אחד ידע."
  },
  {
   "start": 203.62,
   "end": 204.38,
   "text": "ואומרים לה, תקשיבי,"
  },
  {
   "start": 205.2,
   "end": 209.16,
   "text": "אם תצליחי לגלות את מקור הכוח של שמשון,"
  },
  {
   "start": 210.54,
   "end": 214.14,
   "text": "תקבלי מכל אחד מאיתנו סכום עתק"
  },
  {
   "start": 214.74,
   "end": 216.62,
   "text": "של אלף ומאה כסף,"
  },
  {
   "start": 218.1,
   "end": 221.08,
   "text": "סכום שיעשה אותך לאישה העשירה בתבל."
  },
  {
   "start": 224.36,
   "end": 224.86,
   "text": "ודלילה,"
  },
  {
   "start": 226.14,
   "end": 226.98,
   "text": "עיניה בורקות."
  },
  {
   "start": 228.22,
   "end": 230.42,
   "text": "הכסף מסנוור את כל חושיה."
  },
  {
   "start": 231.84,
   "end": 232.3,
   "text": "אין לה רגשות."
  },
  {
   "start": 234.64,
   "end": 235.7,
   "text": "כסף, עוצמה."
  },
  {
   "start": 238.64,
   "end": 241.3,
   "text": "אני חייבת לדעת את מקור כוחו של שמשון,"
  },
  {
   "start": 242.3,
   "end": 242.84,
   "text": "כך היא מחליטה."
  },
  {
   "start": 245.18,
   "end": 247.5,
   "text": "ודלילה מחליטה ומבצעת."
  },
  {
   "start": 249.16,
   "end": 250.98,
   "text": "היא מתחילה להציק לשמשון,"
  },
  {
   "start": 251.6,
   "end": 252.8,
   "text": "יום אחרי יום,"
  },
  {
   "start": 253.82,
   "end": 254.9,
   "text": "לא נותנת לו מנוחה,"
  },
  {
   "start": 258.42,
   "end": 260.14,
   "text": "חופרת בנפשו."
  },
  {
   "start": 260.48,
   "end": 265.46,
   "text": "אכפת לי ממך, היא אומרת לו. אם היא אומרת לך, תילחמו בך,"
  },
  {
   "start": 265.98,
   "end": 267.12,
   "text": "אני חושש שאני אאבד אותך."
  },
  {
   "start": 267.98,
   "end": 271.1,
   "text": "אם תאמר לי את מקור הכוח שלך, אדע איך לעזור לך."
  },
  {
   "start": 271.1,
   "end": 274.5,
   "text": "וככה היא כל יום, כל יום."
  },
  {
   "start": 276.6,
   "end": 277.18,
   "text": "ולבסוף,"
  },
  {
   "start": 278.14,
   "end": 279.18,
   "text": "לבסוף, שמשון."
  },
  {
   "start": 281.44,
   "end": 282.4,
   "text": "שמשון מגלה לה,"
  },
  {
   "start": 283.2,
   "end": 284.24,
   "text": "אבל לא ממש את האמת."
  },
  {
   "start": 285.86,
   "end": 286.96,
   "text": "אבל שמשון."
  },
  {
   "start": 289.09,
   "end": 290.17,
   "text": "שמשון לא שם לב."
  },
  {
   "start": 291.19,
   "end": 294.05,
   "text": "שמשון, עצם זה שאתה הסכמת לומר משהו."
  },
  {
   "start": 294.57,
   "end": 295.93,
   "text": "זו כניעה, שמשון."
  },
  {
   "start": 296.29,
   "end": 298.93,
   "text": "במלחמת היצר אתה חייב להציב גדרים,"
  },
  {
   "start": 299.31,
   "end": 300.05,
   "text": "מחסומים."
  },
  {
   "start": 300.35,
   "end": 302.05,
   "text": "זה מה שעושים כל הזמן חזל."
  },
  {
   "start": 302.85,
   "end": 303.73,
   "text": "חזל הקדושים."
  },
  {
   "start": 304.19,
   "end": 306.95,
   "text": "מחסומים, גדרים, אין ויתורים, אין קניות."
  },
  {
   "start": 309.48,
   "end": 313.7,
   "text": "ושמשון לא שם לב לסכנה שמרחפת מעל ראשו."
  },
  {
   "start": 314.86,
   "end": 316.46,
   "text": "הוא אומר לדלילה, טוב, תקשיבי, די,"
  },
  {
   "start": 317.08,
   "end": 318.02,
   "text": "אני אגלה לך, די, מספיק."
  },
  {
   "start": 320.48,
   "end": 321.42,
   "text": "אם יעשרו אותי"
  },
  {
   "start": 322.1,
   "end": 323.86,
   "text": "בשבעה חבלים יתרים,"
  },
  {
   "start": 324.62,
   "end": 325.06,
   "text": "לחים,"
  },
  {
   "start": 325.86,
   "end": 326.54,
   "text": "לחים ממש,"
  },
  {
   "start": 327.8,
   "end": 328.34,
   "text": "אז אני אהיה"
  },
  {
   "start": 329.32,
   "end": 330.08,
   "text": "כמו אדם רגיל."
  },
  {
   "start": 332.37,
   "end": 333.09,
   "text": "גלילה שומעת,"
  },
  {
   "start": 334.17,
   "end": 334.83,
   "text": "היא מהססת,"
  },
  {
   "start": 336.47,
   "end": 337.51,
   "text": "היא מספיק חשדנית."
  },
  {
   "start": 338.63,
   "end": 340.59,
   "text": "היא לא יודעת אם להאמין לו."
  },
  {
   "start": 341.51,
   "end": 343.85,
   "text": "מה שהיא עושה, היא יוצרת קשר עם פלישתים,"
  },
  {
   "start": 344.43,
   "end": 347.97,
   "text": "מסכמת איתם להתחבא באחד החדרים הפנימיים בבית,"
  },
  {
   "start": 348.89,
   "end": 350.15,
   "text": "ורק לסימן ממנה,"
  },
  {
   "start": 350.65,
   "end": 351.99,
   "text": "כשיגיע הסימן ממנה,"
  },
  {
   "start": 352.37,
   "end": 352.67,
   "text": "אז הם יתקפו."
  },
  {
   "start": 356.76,
   "end": 357.78,
   "text": "שעת לילה מאוחרת."
  },
  {
   "start": 359.24,
   "end": 360.3,
   "text": "שמשון נם את שנתו,"
  },
  {
   "start": 361.38,
   "end": 363.42,
   "text": "לא חש בה סכנה מרחפת מעל ראשו."
  },
  {
   "start": 365.0,
   "end": 365.36,
   "text": "דלילה"
  },
  {
   "start": 366.3,
   "end": 369.96,
   "text": "קושרת בקלילות את שמשון בשבעה חבלים,"
  },
  {
   "start": 370.66,
   "end": 372.06,
   "text": "לחים יתרים."
  },
  {
   "start": 374.26,
   "end": 375.28,
   "text": "ואז היא נסוגה אחורה"
  },
  {
   "start": 376.94,
   "end": 377.52,
   "text": "וקוראת"
  },
  {
   "start": 378.58,
   "end": 379.44,
   "text": "פלישתים!"
  },
  {
   "start": 379.9,
   "end": 381.68,
   "text": "פלישתים עליך, שמשון!"
  },
  {
   "start": 382.42,
   "end": 385.38,
   "text": "שמשון! פלישתים עליך!"
  },
  {
   "start": 385.74,
   "end": 387.84,
   "text": "פלישתים עליך, שמשון!"
  },
  {
   "start": 389.26,
   "end": 389.94,
   "text": "אינסטקטיבית,"
  },
  {
   "start": 390.86,
   "end": 393.4,
   "text": "שמשון כמו קפיץ דרוך, קופץ,"
  },
  {
   "start": 394.26,
   "end": 396.16,
   "text": "והחבלים ניתקים להם מזרועותיו,"
  },
  {
   "start": 396.92,
   "end": 398.54,
   "text": "כאילו טבלו בנהר של אש."
  },
  {
   "start": 401.83,
   "end": 403.23,
   "text": "שמשון דרוך כולו מסתכל"
  },
  {
   "start": 403.25,
   "end": 406.89,
   "text": "רואה את פניה של דילה מאוכזבים,"
  },
  {
   "start": 408.97,
   "end": 411.61,
   "text": "דמעות של זעם מבין עיניה."
  },
  {
   "start": 412.13,
   "end": 413.67,
   "text": "ניסיתי אותך ושיקרת לי."
  },
  {
   "start": 415.57,
   "end": 417.23,
   "text": "ניסיתי אותך ושיקרת לי."
  },
  {
   "start": 417.79,
   "end": 418.47,
   "text": "ושמשון,"
  },
  {
   "start": 419.33,
   "end": 421.65,
   "text": "שמשון לא מבין, הוא לא חש בסכנה."
  },
  {
   "start": 426.52,
   "end": 427.38,
   "text": "מקץ זמן מה,"
  },
  {
   "start": 428.2,
   "end": 429.5,
   "text": "היא שוב חוזרת להציק."
  },
  {
   "start": 432.86,
   "end": 435.36,
   "text": "לשמשון, אני רוצה שתגיד לדמקור הכוח שלך."
  },
  {
   "start": 436.7,
   "end": 437.64,
   "text": "שמשון לא חושד,"
  },
  {
   "start": 438.38,
   "end": 439.44,
   "text": "לא יכול להאמין."
  },
  {
   "start": 441.26,
   "end": 442.72,
   "text": "איזו נפש טמאה"
  },
  {
   "start": 443.32,
   "end": 444.16,
   "text": "יש לדלילה."
  },
  {
   "start": 447.15,
   "end": 450.45,
   "text": "תמנע, נותנים לך הזדמנות למה את לא לוקחת אותה."
  },
  {
   "start": 452.8,
   "end": 454.76,
   "text": "והיא ממשיכה להציק לשמשון."
  },
  {
   "start": 456.7,
   "end": 459.04,
   "text": "לבסוף שמשון כבר לא יכול להחזיק."
  },
  {
   "start": 459.8,
   "end": 461.24,
   "text": "בסך הכל שמשון רצה מנוחה."
  },
  {
   "start": 472.32,
   "end": 474.0,
   "text": "שמשון אומר לה, אני אמרתי לך."
  },
  {
   "start": 474.96,
   "end": 476.3,
   "text": "אני אגיד לך, אולי לא הסברתי לך."
  },
  {
   "start": 476.84,
   "end": 478.08,
   "text": "החבלים שקושרים אותי,"
  },
  {
   "start": 478.68,
   "end": 480.64,
   "text": "הם צריכים להיות כאלה חבלים גם חדשים,"
  },
  {
   "start": 480.76,
   "end": 481.52,
   "text": "את זה לא אמרתי לך."
  },
  {
   "start": 482.08,
   "end": 484.92,
   "text": "כאלה חדשים ששום מלאכה לא עשו בהם."
  },
  {
   "start": 487.92,
   "end": 488.3,
   "text": "זו התשובה."
  },
  {
   "start": 489.3,
   "end": 490.9,
   "text": "צריך לקשור אותי בשבעה חבלים,"
  },
  {
   "start": 491.62,
   "end": 494.24,
   "text": "אבל חדשים שלא עשו בהם מלאכה."
  },
  {
   "start": 497.67,
   "end": 499.19,
   "text": "דלילה לא שמחה על איש."
  },
  {
   "start": 499.99,
   "end": 500.83,
   "text": "זה הפרויקט שלה."
  },
  {
   "start": 501.77,
   "end": 502.65,
   "text": "זו המשימה שלה."
  },
  {
   "start": 506.13,
   "end": 507.07,
   "text": "שעת לילה מאוחרת."
  },
  {
   "start": 508.05,
   "end": 508.99,
   "text": "שמשון ישן."
  },
  {
   "start": 510.39,
   "end": 514.51,
   "text": "דלילה מוצאה את החבלים החדשים שהיא קנתה במיוחד."
  },
  {
   "start": 515.15,
   "end": 515.49,
   "text": "היא קנתה,"
  },
  {
   "start": 516.17,
   "end": 517.09,
   "text": "כדי שלא יהיה שום טעויות."
  },
  {
   "start": 518.73,
   "end": 520.69,
   "text": "ואז היא קושרת וקושרת,"
  },
  {
   "start": 522.45,
   "end": 526.04,
   "text": "מתרחקת וקוראת"
  },
  {
   "start": 526.62,
   "end": 529.04,
   "text": "פלישתים עליך, שמשון!"
  },
  {
   "start": 529.72,
   "end": 531.28,
   "text": "שמשון, פלישתים עליך!"
  },
  {
   "start": 536.32,
   "end": 536.82,
   "text": "מתעורר."
  },
  {
   "start": 537.92,
   "end": 538.96,
   "text": "כבר לא קפיצה,"
  },
  {
   "start": 542.6,
   "end": 545.52,
   "text": "רוח השם מתחילה לעזוב אותו."
  },
  {
   "start": 546.22,
   "end": 547.66,
   "text": "הוא משתחרר במאמץ קל."
  },
  {
   "start": 548.9,
   "end": 550.6,
   "text": "ושוב, אל מול פניו,"
  },
  {
   "start": 551.7,
   "end": 552.74,
   "text": "פניה העצובות"
  },
  {
   "start": 553.42,
   "end": 554.26,
   "text": "של דלילה."
  },
  {
   "start": 554.66,
   "end": 557.52,
   "text": "היא מסננת לו, שיקרת עליי,"
  },
  {
   "start": 558.58,
   "end": 559.58,
   "text": "שיקרת עליי,"
  },
  {
   "start": 566.9,
   "end": 568.04,
   "text": "שוב שיקרת עליי."
  },
  {
   "start": 571.54,
   "end": 572.2,
   "text": "ושמשון"
  },
  {
   "start": 575.26,
   "end": 579.8,
   "text": "לא מזהה את הצפעוני הזה שלפניו."
  },
  {
   "start": 580.74,
   "end": 581.4,
   "text": "אוי תמנע,"
  },
  {
   "start": 581.98,
   "end": 583.08,
   "text": "יחד לתקן,"
  },
  {
   "start": 583.84,
   "end": 585.44,
   "text": "כמה את מומחת בלקלקל."
  },
  {
   "start": 588.0,
   "end": 588.78,
   "text": "ודלילה,"
  },
  {
   "start": 589.44,
   "end": 593.46,
   "text": "דלילה מציקה לשמשון ביתר שאת, היא לא נותנת לו מנוחה."
  },
  {
   "start": 595.58,
   "end": 596.94,
   "text": "לבסוף שמשון אומר לה, תראי,"
  },
  {
   "start": 597.4,
   "end": 600.24,
   "text": "את רוצה לדעת את מקור הכוח שלי?"
  },
  {
   "start": 601.34,
   "end": 606.56,
   "text": "אם תצליחי, תהרגי, אם מישהו יהרוג את שבע צמות השיער של הראש שלי,"
  },
  {
   "start": 607.16,
   "end": 608.96,
   "text": "הרי השיער שיש לי הוא גדול לגמרי מבצמות."
  },
  {
   "start": 609.92,
   "end": 613.46,
   "text": "אם מישהו יהרוג את שבע צמות השיערות הראש שלי עם המסכת,"
  },
  {
   "start": 614.3,
   "end": 616.78,
   "text": "יקשרו אותם, כלומר, אל קורה שהורגים בה את החוטים,"
  },
  {
   "start": 617.32,
   "end": 618.8,
   "text": "ואת הקורה הזו יחזקו"
  },
  {
   "start": 619.54,
   "end": 622.8,
   "text": "עם נעיצת יתד אל הקרקע."
  },
  {
   "start": 623.22,
   "end": 625.48,
   "text": "אם יקשרו את השערות שלי אל קורה,"
  },
  {
   "start": 625.9,
   "end": 626.66,
   "text": "אל המסכת."
  },
  {
   "start": 627.56,
   "end": 628.3,
   "text": "אל קורה,"
  },
  {
   "start": 629.02,
   "end": 631.7,
   "text": "ואת הקורה הזה יהדקו עם יתד אל הקרקע,"
  },
  {
   "start": 632.88,
   "end": 634.44,
   "text": "אז יסור הכוח שלי."
  },
  {
   "start": 639.41,
   "end": 640.29,
   "text": "לילה עטור כוכבים."
  },
  {
   "start": 641.65,
   "end": 645.11,
   "text": "דלילה קושרת את מחלפות ראשו של שמשון אל המסכת."
  },
  {
   "start": 646.09,
   "end": 649.75,
   "text": "אחר כך לוקחת את היתד החזקה ביותר שהיא מצאה,"
  },
  {
   "start": 650.29,
   "end": 650.99,
   "text": "ותוקעת"
  },
  {
   "start": 651.79,
   "end": 653.93,
   "text": "בהחלטיות בנחישות ואכזריות"
  },
  {
   "start": 654.51,
   "end": 654.97,
   "text": "אל הקרקע."
  },
  {
   "start": 656.51,
   "end": 658.07,
   "text": "פלישתים עליך, שמשון!"
  },
  {
   "start": 658.51,
   "end": 660.21,
   "text": "שמשון, פלישתים עליך, שמשון!"
  },
  {
   "start": 661.87,
   "end": 662.67,
   "text": "ושמשון,"
  },
  {
   "start": 663.67,
   "end": 664.89,
   "text": "ויקץ משנתו,"
  },
  {
   "start": 665.39,
   "end": 666.03,
   "text": "מתעורר."
  },
  {
   "start": 666.91,
   "end": 668.97,
   "text": "אבל עכשיו כבר לוקח זמן."
  },
  {
   "start": 670.95,
   "end": 671.71,
   "text": "הוא בכל אופן קם."
  },
  {
   "start": 673.23,
   "end": 675.75,
   "text": "הוא בכל אופן מצליח להסיעה בכוח שלו את הקורות,"
  },
  {
   "start": 676.23,
   "end": 679.17,
   "text": "וגם את היתד התקועה באדמה בחוזקה כל כך."
  },
  {
   "start": 679.63,
   "end": 681.11,
   "text": "את הכל הוא מנער באחת."
  },
  {
   "start": 681.77,
   "end": 683.65,
   "text": "אבל כבר זה לא כל כך קל."
  },
  {
   "start": 684.23,
   "end": 686.55,
   "text": "שמשון רוח השם עוזבת אותך."
  },
  {
   "start": 688.7,
   "end": 689.04,
   "text": "ושוב"
  },
  {
   "start": 689.8,
   "end": 691.52,
   "text": "הוא נתקל בפניה."
  },
  {
   "start": 692.6,
   "end": 694.32,
   "text": "המאוכזבות של דלילה."
  },
  {
   "start": 697.06,
   "end": 699.8,
   "text": "ודלילה מאמצת את כל הכוחות שלה."
  },
  {
   "start": 700.44,
   "end": 702.06,
   "text": "לחץ מאסיבי על שמשון."
  },
  {
   "start": 703.14,
   "end": 705.9,
   "text": "ושמשון מוצא את עצמו בתוך הניסיון הגדול הזה."
  },
  {
   "start": 706.78,
   "end": 708.6,
   "text": "בתוך התיקון הגדול שהוא צריך לתקן."
  },
  {
   "start": 708.98,
   "end": 712.2,
   "text": "הוא לאט לאט מאבד את יישוב דעתו, את הדבר הכי חשוב ליהודי."
  },
  {
   "start": 712.56,
   "end": 713.26,
   "text": "יישוב הדעת."
  },
  {
   "start": 713.76,
   "end": 719.3,
   "text": "הוא מאבד זכויות במלחמה הזו על תיקון או קלקול משנים קדמוניות."
  },
  {
   "start": 719.68,
   "end": 721.58,
   "text": "מלחמה שאברהם לא נכנס אליה,"
  },
  {
   "start": 722.58,
   "end": 729.32,
   "text": "אלא דחה אותה מפניו יצחק לא נכנס אליה יעקב לא נכנס אליה והוא שמשון"
  },
  {
   "start": 729.88,
   "end": 733.52,
   "text": "נאלץ להתמודד עם כוח אפל כל כך"
  },
  {
   "start": 734.12,
   "end": 743.16,
   "text": "עם אמו של עמלק עם כלתו של עשיו עם המלחמה שלנו של הדורות שלנו שבט דן"
  },
  {
   "start": 743.72,
   "end": 751.44,
   "text": "מאסף לכל המחנות אל כל היהודים הנידחים הוא אוסף את המלחמה של כולם הוא מנהל"
  },
  {
   "start": 752.16,
   "end": 753.1,
   "text": "וזה לא קל."
  },
  {
   "start": 754.76,
   "end": 756.02,
   "text": "והלחץ גובר."
  },
  {
   "start": 756.96,
   "end": 758.54,
   "text": "דלילה לא בחלה בשום אמצעי."
  },
  {
   "start": 762.24,
   "end": 764.04,
   "text": "דלילה יש לה את הכוח של אותה,"
  },
  {
   "start": 764.68,
   "end": 767.36,
   "text": "אותה קליפה שגורמת לאדם לפגום."
  },
  {
   "start": 768.82,
   "end": 771.16,
   "text": "ושמשון כבר נמאס לו,"
  },
  {
   "start": 771.86,
   "end": 773.44,
   "text": "כבר מבקש את נפשו למות."
  },
  {
   "start": 777.29,
   "end": 779.01,
   "text": "אז הוא מגלה לה"
  },
  {
   "start": 781.08,
   "end": 782.64,
   "text": "מקור הכוח שלי."
  },
  {
   "start": 784.22,
   "end": 785.82,
   "text": "הוא אומר בקול רווי כאב."
  },
  {
   "start": 788.37,
   "end": 791.69,
   "text": "אולי הוא חש בסוף המתקרב אליו."
  },
  {
   "start": 793.01,
   "end": 797.61,
   "text": "מקור הכוח שלי הוא כתוצאה מנזירות מבטן."
  },
  {
   "start": 798.43,
   "end": 799.93,
   "text": "אני נזיר אלוקים,"
  },
  {
   "start": 800.35,
   "end": 801.57,
   "text": "נזיר אלוקים אני,"
  },
  {
   "start": 801.97,
   "end": 804.15,
   "text": "ולא גילחתי את שערות ראשי."
  },
  {
   "start": 805.69,
   "end": 806.69,
   "text": "כך מגלה שמשון."
  },
  {
   "start": 807.55,
   "end": 810.55,
   "text": "האמת, הוא חשב שרק זה חלק מהכוח שלו,"
  },
  {
   "start": 810.97,
   "end": 813.23,
   "text": "וגם הנזירות מהיין יש חלק נכבד."
  },
  {
   "start": 814.25,
   "end": 814.75,
   "text": "אבל הוא טעה."
  },
  {
   "start": 815.67,
   "end": 816.55,
   "text": "הפעם הוא טעה."
  },
  {
   "start": 817.01,
   "end": 818.59,
   "text": "רוח השם שרה ממנו,"
  },
  {
   "start": 819.11,
   "end": 821.31,
   "text": "שרוח השם שרה מעליו כלל,"
  },
  {
   "start": 821.67,
   "end": 825.15,
   "text": "והוא ניצב מול הכוח הזה של דלילה,"
  },
  {
   "start": 826.07,
   "end": 826.63,
   "text": "של אותה קליפה,"
  },
  {
   "start": 829.33,
   "end": 834.37,
   "text": "אותו תיקון עצום ונורא."
  },
  {
   "start": 837.34,
   "end": 839.64,
   "text": "דלילה בלב של הפנימה עלזה."
  },
  {
   "start": 840.5,
   "end": 842.28,
   "text": "הפעם ידעה זו כל האמת."
  },
  {
   "start": 843.54,
   "end": 844.58,
   "text": "היא ידעה למרות הכל."
  },
  {
   "start": 845.16,
   "end": 848.08,
   "text": "דלילה ידעה ששמשון ירא שמיים כזה גדול."
  },
  {
   "start": 848.54,
   "end": 849.96,
   "text": "הוא לא יסביר שם שמיים סתם."
  },
  {
   "start": 850.64,
   "end": 853.14,
   "text": "דלילה ידע שבתוכו הוא טהור וצדיק,"
  },
  {
   "start": 854.1,
   "end": 856.36,
   "text": "שידע שהיהודי גם כשהוא נמצא במעמקים,"
  },
  {
   "start": 856.82,
   "end": 858.66,
   "text": "גם כשהוא נמצא איתה עם גויה."
  },
  {
   "start": 860.6,
   "end": 863.14,
   "text": "הנשמה שלו בפנים יש את הנקודה היהודית הטהורה."
  },
  {
   "start": 863.48,
   "end": 864.76,
   "text": "אם הוא הזכיר שם שמיים,"
  },
  {
   "start": 865.32,
   "end": 866.8,
   "text": "לא מזכיר שם שמיים לבטלה."
  },
  {
   "start": 867.46,
   "end": 870.92,
   "text": "הפעם היא פנתה למנהיגי הפלישתים, שלחה להם הודעה מסר"
  },
  {
   "start": 871.72,
   "end": 872.88,
   "text": "תכינו את הכסף"
  },
  {
   "start": 874.02,
   "end": 875.62,
   "text": "ותבואי עם אחינו, כי הלילה,"
  },
  {
   "start": 876.76,
   "end": 879.26,
   "text": "הלילה שמשון נלכד בידינו,"
  },
  {
   "start": 879.84,
   "end": 882.3,
   "text": "הלילה שמשון נלכד מידינו."
  },
  {
   "start": 885.7,
   "end": 887.6,
   "text": "הלילה שמשון נלכד מידינו."
  },
  {
   "start": 899.51,
   "end": 900.21,
   "text": "לילה אפל,"
  },
  {
   "start": 901.45,
   "end": 902.23,
   "text": "מבשר האות."
  },
  {
   "start": 903.73,
   "end": 904.53,
   "text": "שמשון ישן,"
  },
  {
   "start": 905.77,
   "end": 906.37,
   "text": "ודלילה"
  },
  {
   "start": 907.19,
   "end": 907.93,
   "text": "היא עסוקה."
  },
  {
   "start": 909.47,
   "end": 910.37,
   "text": "היא מגלחת"
  },
  {
   "start": 910.99,
   "end": 913.41,
   "text": "את שערות ראשו של שמשון בעדינות,"
  },
  {
   "start": 916.19,
   "end": 917.59,
   "text": "מבלי שיחוש בה סכנה."
  },
  {
   "start": 921.86,
   "end": 922.36,
   "text": "אחר כך,"
  },
  {
   "start": 923.12,
   "end": 924.24,
   "text": "אחר כך היא קושרת אותו"
  },
  {
   "start": 924.86,
   "end": 926.24,
   "text": "בחבלים עבים,"
  },
  {
   "start": 926.28,
   "end": 930.22,
   "text": "אבי מאוד ואז היא מתרחקת"
  },
  {
   "start": 931.72,
   "end": 933.28,
   "text": "חיוך שטני בפניה"
  },
  {
   "start": 934.4,
   "end": 936.28,
   "text": "פלישתים עליך שמשון"
  },
  {
   "start": 936.94,
   "end": 938.7,
   "text": "פלישתים עליך שמשון"
  },
  {
   "start": 940.38,
   "end": 941.02,
   "text": "ושמשון"
  },
  {
   "start": 941.74,
   "end": 942.86,
   "text": "מנסה להתעורר"
  },
  {
   "start": 944.38,
   "end": 945.56,
   "text": "כבר לא קל"
  },
  {
   "start": 947.65,
   "end": 948.83,
   "text": "מנסה להתעורר"
  },
  {
   "start": 950.15,
   "end": 951.71,
   "text": "ורוח השם"
  },
  {
   "start": 952.39,
   "end": 953.57,
   "text": "סרה ממנו,"
  },
  {
   "start": 955.11,
   "end": 958.69,
   "text": "ושמשון לא מצליח להשתחרר,"
  },
  {
   "start": 959.73,
   "end": 960.73,
   "text": "הוא כבול,"
  },
  {
   "start": 962.67,
   "end": 964.21,
   "text": "לראשונה בחייו,"
  },
  {
   "start": 965.59,
   "end": 966.85,
   "text": "חסר אונים,"
  },
  {
   "start": 967.61,
   "end": 968.43,
   "text": "רוח השם"
  },
  {
   "start": 969.49,
   "end": 970.39,
   "text": "עזבה אותו,"
  },
  {
   "start": 971.53,
   "end": 973.91,
   "text": "פלישתים עליך, שמשון."
  },
  {
   "start": 975.41,
   "end": 976.01,
   "text": "והבית"
  },
  {
   "start": 976.63,
   "end": 978.95,
   "text": "תוך דקות התמלא בפלישתים,"
  },
  {
   "start": 979.73,
   "end": 980.33,
   "text": "הם קפצו"
  },
  {
   "start": 981.21,
   "end": 982.55,
   "text": "ואחזו בו בחוזקה."
  },
  {
   "start": 983.93,
   "end": 985.63,
   "text": "ושמשון לראשונה בחייו,"
  },
  {
   "start": 986.31,
   "end": 986.85,
   "text": "בידיהם,"
  },
  {
   "start": 987.51,
   "end": 988.25,
   "text": "חסר אונים,"
  },
  {
   "start": 990.42,
   "end": 992.26,
   "text": "עיניו מתחילות לדמוע."
  },
  {
   "start": 993.68,
   "end": 995.84,
   "text": "שמשון מבין עד כמה הוא טעה."
  },
  {
   "start": 1035.89,
   "end": 1037.03,
   "text": "התעללו בשמשון."
  },
  {
   "start": 1037.97,
   "end": 1039.41,
   "text": "הם פגעו בו שוב ושוב."
  },
  {
   "start": 1040.29,
   "end": 1042.39,
   "text": "הם פגעו שוב ושוב ברגליו,"
  },
  {
   "start": 1043.31,
   "end": 1044.51,
   "text": "ברגליו הנכות."
  },
  {
   "start": 1045.09,
   "end": 1047.79,
   "text": "שמשון כל החיים סבל מהרגליים,"
  },
  {
   "start": 1048.33,
   "end": 1056.16,
   "text": "והפלישתים באכזריות מרסקים לו אותם. אחזו בו פלישתים,"
  },
  {
   "start": 1058.7,
   "end": 1060.08,
   "text": "הביטו לו בפניו,"
  },
  {
   "start": 1061.24,
   "end": 1062.14,
   "text": "וחייכו להם."
  },
  {
   "start": 1063.6,
   "end": 1067.5,
   "text": "וזה המראה האחרון ששמשון רואה בימי חייו."
  },
  {
   "start": 1069.28,
   "end": 1072.64,
   "text": "הם ניקרו לו את העיניים."
  },
  {
   "start": 1073.76,
   "end": 1076.26,
   "text": "הם ניקרו לו, אותם פלישתים אכזריים,"
  },
  {
   "start": 1076.98,
   "end": 1077.86,
   "text": "את העין האחת,"
  },
  {
   "start": 1080.15,
   "end": 1081.95,
   "text": "ואחר כך את העין השנייה."
  },
  {
   "start": 1084.09,
   "end": 1087.79,
   "text": "ושמשון נותר עיוור."
  },
  {
   "start": 1096.78,
   "end": 1101.22,
   "text": "שמשון עיוור מובא לעזה"
  },
  {
   "start": 1102.16,
   "end": 1103.52,
   "text": "בקול תרועה גדול."
  },
  {
   "start": 1104.58,
   "end": 1106.14,
   "text": "שם הוא נאסר בנחושתיים."
  },
  {
   "start": 1107.26,
   "end": 1108.68,
   "text": "שם מעבידים אותו בכלא,"
  },
  {
   "start": 1109.36,
   "end": 1109.86,
   "text": "בעבדת פרך,"
  },
  {
   "start": 1110.98,
   "end": 1112.66,
   "text": "מסובבת אבן הריחיים הענקית,"
  },
  {
   "start": 1113.56,
   "end": 1114.56,
   "text": "שעות על גבי שעות."
  },
  {
   "start": 1115.94,
   "end": 1116.24,
   "text": "איזה כאב,"
  },
  {
   "start": 1117.48,
   "end": 1118.08,
   "text": "איזה צער,"
  },
  {
   "start": 1119.32,
   "end": 1120.16,
   "text": "איזה אובדן."
  },
  {
   "start": 1124.75,
   "end": 1126.01,
   "text": "אמרו חזל הקדושים,"
  },
  {
   "start": 1128.48,
   "end": 1130.04,
   "text": "בוטח בלבו וכסיל,"
  },
  {
   "start": 1131.08,
   "end": 1132.18,
   "text": "והולך בחוכמה,"
  },
  {
   "start": 1132.82,
   "end": 1133.36,
   "text": "הוא ימלט."
  },
  {
   "start": 1134.72,
   "end": 1135.56,
   "text": "מי שחושב"
  },
  {
   "start": 1136.14,
   "end": 1136.8,
   "text": "שיכול"
  },
  {
   "start": 1137.94,
   "end": 1139.06,
   "text": "לעמוד מול היצר"
  },
  {
   "start": 1139.8,
   "end": 1142.54,
   "text": "ללא גדרים, ללא שמירת עיניים,"
  },
  {
   "start": 1143.4,
   "end": 1144.78,
   "text": "ללא שמירת המחשבה,"
  },
  {
   "start": 1145.36,
   "end": 1145.88,
   "text": "זה כסיל."
  },
  {
   "start": 1146.9,
   "end": 1147.38,
   "text": "והחכם,"
  },
  {
   "start": 1148.08,
   "end": 1150.2,
   "text": "זה שמשתדל לעצום עיניו מלראות רע,"
  },
  {
   "start": 1151.5,
   "end": 1152.26,
   "text": "הוא ימלט מהיצר."
  },
  {
   "start": 1153.74,
   "end": 1154.54,
   "text": "שמירת עיניים,"
  },
  {
   "start": 1155.5,
   "end": 1158.86,
   "text": "אחד מ-24 דברים המעכבים את התשובה."
  },
  {
   "start": 1160.02,
   "end": 1163.06,
   "text": "ברא הקדוש ברוך הוא עפעפיים לאדם שיסגור אותם,"
  },
  {
   "start": 1163.72,
   "end": 1167.5,
   "text": "על מנת לא להכניס מראות אסורים אל טוהר נשמתו."
  },
  {
   "start": 1170.16,
   "end": 1171.14,
   "text": "אבל מה אנחנו חושבים?"
  },
  {
   "start": 1171.78,
   "end": 1173.5,
   "text": "האם אין סיכוי לאדם? זהו,"
  },
  {
   "start": 1177.97,
   "end": 1178.83,
   "text": "ככה אנחנו חושבים?"
  },
  {
   "start": 1180.45,
   "end": 1181.49,
   "text": "אם ככה אנחנו חושבים,"
  },
  {
   "start": 1182.31,
   "end": 1183.07,
   "text": "טעות היא בידינו,"
  },
  {
   "start": 1183.99,
   "end": 1185.39,
   "text": "כי יש לנו את אבא שבשמיים,"
  },
  {
   "start": 1186.47,
   "end": 1189.19,
   "text": "שמה שיהיה על האדם יעבור עליו מה שיעבור."
  },
  {
   "start": 1190.57,
   "end": 1191.77,
   "text": "הקדוש ברוך הוא איתו,"
  },
  {
   "start": 1192.37,
   "end": 1194.59,
   "text": "אוהב אותו, מוכן לשלוף אותו."
  },
  {
   "start": 1195.45,
   "end": 1196.37,
   "text": "מהיכן שהוא יהיה,"
  },
  {
   "start": 1197.43,
   "end": 1198.73,
   "text": "מהיכן שהוא יהיה."
  },
  {
   "start": 1206.6,
   "end": 1208.56,
   "text": "במעמקי בית הסוהר המחריד של עזה,"
  },
  {
   "start": 1213.05,
   "end": 1214.09,
   "text": "מבית עין שאול,"
  },
  {
   "start": 1215.21,
   "end": 1216.47,
   "text": "שם נמצא שמשון,"
  },
  {
   "start": 1217.11,
   "end": 1217.53,
   "text": "עיוור,"
  },
  {
   "start": 1218.27,
   "end": 1218.75,
   "text": "נכה,"
  },
  {
   "start": 1219.59,
   "end": 1221.05,
   "text": "היסורים איומים הוא עובר."
  },
  {
   "start": 1222.15,
   "end": 1223.77,
   "text": "אבל משם, מתחתית המדרגה,"
  },
  {
   "start": 1224.51,
   "end": 1226.59,
   "text": "שמשון בוכה ומתפלל אל השם,"
  },
  {
   "start": 1227.45,
   "end": 1230.19,
   "text": "יודע שטעה, יודע שנכשל."
  },
  {
   "start": 1231.25,
   "end": 1232.11,
   "text": "אבל עושה תשובה,"
  },
  {
   "start": 1233.15,
   "end": 1234.09,
   "text": "לא מתייאש."
  },
  {
   "start": 1234.75,
   "end": 1238.07,
   "text": "אפילו חרב חדה מונחת על צווארו של אדם."
  },
  {
   "start": 1238.87,
   "end": 1240.11,
   "text": "אל ימנע עצמו מן הרחמים."
  },
  {
   "start": 1241.43,
   "end": 1241.93,
   "text": "גם שמה,"
  },
  {
   "start": 1242.69,
   "end": 1247.93,
   "text": "במקום שכל אדם היה נשבר, היה מתרסק,"
  },
  {
   "start": 1248.73,
   "end": 1250.11,
   "text": "שמשון בונה את עצמו,"
  },
  {
   "start": 1251.29,
   "end": 1258.75,
   "text": "פיסה אחרו, חלק אחרי חלק."
  },
  {
   "start": 1259.07,
   "end": 1262.47,
   "text": "שיער ראשו כבר מתחיל לבצבץ לו,"
  },
  {
   "start": 1268.34,
   "end": 1272.2,
   "text": "וכבר שמשון שוב עוסק בתפילה, אתם יודעים על מה?"
  },
  {
   "start": 1273.26,
   "end": 1276.28,
   "text": "בורא עולם, אני לא מתייאש, אני רוצה להילחם, להמשיך."
  },
  {
   "start": 1276.94,
   "end": 1277.86,
   "text": "למרות מה שעשיתי,"
  },
  {
   "start": 1278.48,
   "end": 1279.56,
   "text": "למרות מה שפגמתי,"
  },
  {
   "start": 1280.04,
   "end": 1284.76,
   "text": "למרות מה שקלקלתי, לא היה מתאים לי להגיע בכלל לדלילה להיכשל שם."
  },
  {
   "start": 1285.54,
   "end": 1291.36,
   "text": "למרות מצבי הנוכחי, בורא עולם, תאפשר לי להמשיך במלחמה עם פלשתין."
  },
  {
   "start": 1291.94,
   "end": 1295.36,
   "text": "תאפשר לי להמשיך בתפקיד,"
  },
  {
   "start": 1295.64,
   "end": 1298.54,
   "text": "בתפקיד הרמב״ם הניסה הזה של יהודי להילחם,"
  },
  {
   "start": 1299.04,
   "end": 1299.8,
   "text": "להילחם,"
  },
  {
   "start": 1300.2,
   "end": 1300.92,
   "text": "להילחם,"
  },
  {
   "start": 1301.34,
   "end": 1302.02,
   "text": "לא להפסיק,"
  },
  {
   "start": 1302.5,
   "end": 1303.26,
   "text": "לא להיכנע,"
  },
  {
   "start": 1303.58,
   "end": 1304.22,
   "text": "גם אם נופלים,"
  },
  {
   "start": 1304.74,
   "end": 1306.16,
   "text": "קמים ונלחמים."
  },
  {
   "start": 1306.68,
   "end": 1308.22,
   "text": "זה אני, זה שמשון."
  },
  {
   "start": 1308.64,
   "end": 1309.8,
   "text": "תן לי את האפשרות הזאת."
  },
  {
   "start": 1313.31,
   "end": 1315.23,
   "text": "הסוהרים הפלישתים עוקבים אחרי שמשון,"
  },
  {
   "start": 1315.79,
   "end": 1317.33,
   "text": "ורואים שהשיער שלו גדל,"
  },
  {
   "start": 1318.63,
   "end": 1319.91,
   "text": "אבל אין שינוי בו."
  },
  {
   "start": 1320.57,
   "end": 1324.29,
   "text": "לא כוח רוחני ולא כוח גשמי, כלום."
  },
  {
   "start": 1326.17,
   "end": 1327.17,
   "text": "וכבר הם אינם מודאגים,"
  },
  {
   "start": 1328.69,
   "end": 1329.11,
   "text": "הם לא יודעים."
  },
  {
   "start": 1330.67,
   "end": 1332.31,
   "text": "הם לא יודעים מה זה יהודי שנלחם,"
  },
  {
   "start": 1333.03,
   "end": 1334.27,
   "text": "שאינו מפסיק להתייאש,"
  },
  {
   "start": 1334.79,
   "end": 1336.21,
   "text": "שלמרות שהוא נופל,"
  },
  {
   "start": 1336.73,
   "end": 1337.59,
   "text": "הוא קם!"
  },
  {
   "start": 1337.95,
   "end": 1342.23,
   "text": "למרות שהוא נופל מאיפה שהוא לא יהיה, הוא זועק אל השם."
  },
  {
   "start": 1343.49,
   "end": 1344.91,
   "text": "ואפילו מבית עין שאול."
  },
  {
   "start": 1347.48,
   "end": 1348.84,
   "text": "וזה מה שעושה שמשון."
  }
 ]
}