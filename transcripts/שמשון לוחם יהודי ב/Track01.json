{
 "disc": "שמשון לוחם יהודי ב",
 "track": "Track01",
 "duration": 1508.16,
 "segments": [
  {
   "start": 18.04,
   "end": 25.06,
   "text": "וירדו שלושת אלפים מבני יהודה אל סעיף סלע עטם,"
  },
  {
   "start": 26.32,
   "end": 27.64,
   "text": "ויאמרו לשמשון,"
  },
  {
   "start": 28.5,
   "end": 29.06,
   "text": "הלא ידעת,"
  },
  {
   "start": 29.82,
   "end": 31.42,
   "text": "כי מושלים בנו פלישתים,"
  },
  {
   "start": 32.2,
   "end": 33.46,
   "text": "ומה זאת עשית לנו?"
  },
  {
   "start": 35.1,
   "end": 35.74,
   "text": "בני יהודה,"
  },
  {
   "start": 36.6,
   "end": 38.48,
   "text": "כתוצאה מהלחץ של פלישתים,"
  },
  {
   "start": 39.94,
   "end": 43.26,
   "text": "מאבדים קצת את חוזק האמונה של היהודי,"
  },
  {
   "start": 44.9,
   "end": 46.04,
   "text": "ופונים אל שמשון,"
  },
  {
   "start": 46.22,
   "end": 48.84,
   "text": "זה שהיכה בפלישתים,"
  },
  {
   "start": 51.16,
   "end": 53.24,
   "text": "זה שפגע בפלישתים, והפלישתים עכשיו"
  },
  {
   "start": 53.72,
   "end": 57.7,
   "text": "צרים על יהודה ורוצים אותו, שיסגירו אותו אליהם."
  },
  {
   "start": 58.7,
   "end": 62.38,
   "text": "בלית בירה בני יהודה פונים אל שמשון ומבקשים להסגיר אותו,"
  },
  {
   "start": 63.06,
   "end": 63.78,
   "text": "את שמשון."
  },
  {
   "start": 64.64,
   "end": 66.32,
   "text": "זה הלוחם, הכי גר,"
  },
  {
   "start": 67.04,
   "end": 68.7,
   "text": "שלמרות הנכות שברגלו,"
  },
  {
   "start": 69.24,
   "end": 70.3,
   "text": "הוא מכה בפלישתים."
  },
  {
   "start": 71.08,
   "end": 71.82,
   "text": "זה שמשון,"
  },
  {
   "start": 72.26,
   "end": 76.78,
   "text": "שמשתמש בכוח שחנן אותו השם רק כנגד פלישתים,"
  },
  {
   "start": 77.36,
   "end": 80.32,
   "text": "ולא על מנת להשיג מעמד בעולם הזה,"
  },
  {
   "start": 81.1,
   "end": 83.36,
   "text": "לא מנסה לפגוע לו, והוא זה,"
  },
  {
   "start": 84.34,
   "end": 84.98,
   "text": "כהוא זה,"
  },
  {
   "start": 85.68,
   "end": 86.9,
   "text": "במישהו מעם ישראל."
  },
  {
   "start": 87.8,
   "end": 88.78,
   "text": "נציג שבט דן,"
  },
  {
   "start": 89.68,
   "end": 92.18,
   "text": "שבט דן מאסף לכל המחנות."
  },
  {
   "start": 94.1,
   "end": 96.16,
   "text": "שבט דן היה מאסף לכל המחנות,"
  },
  {
   "start": 96.86,
   "end": 101.0,
   "text": "שמשון היה מאסף לכל עם ישראל, אוסף את כל הנשמות."
  },
  {
   "start": 101.88,
   "end": 104.26,
   "text": "היה לו כוח עצום רוחני, להחיות,"
  },
  {
   "start": 104.94,
   "end": 106.4,
   "text": "להעביר אש בלבבות,"
  },
  {
   "start": 107.12,
   "end": 109.26,
   "text": "של כל הנשמות ולו הנידחות ביותר."
  },
  {
   "start": 111.22,
   "end": 114.56,
   "text": "ושמשון שומע את בקשתם של בני יהודה ממנו."
  },
  {
   "start": 115.58,
   "end": 116.16,
   "text": "כל חייו,"
  },
  {
   "start": 117.56,
   "end": 120.52,
   "text": "מגיל קטן מזה, מהרגע שהוא התוודע לכוחו העצום,"
  },
  {
   "start": 120.98,
   "end": 122.42,
   "text": "הוא חשש מפגיעה ביהודי."
  },
  {
   "start": 124.95,
   "end": 125.95,
   "text": "הוא יודע שאם הוא יסכים,"
  },
  {
   "start": 126.79,
   "end": 127.37,
   "text": "וייכנע,"
  },
  {
   "start": 128.01,
   "end": 129.59,
   "text": "ויימסר ביד פלישתים,"
  },
  {
   "start": 132.81,
   "end": 136.25,
   "text": "אז הוא לא יצטרך להילחם באחים שלו ולפגוע בהם."
  },
  {
   "start": 137.53,
   "end": 138.33,
   "text": "אז שמשון חשב,"
  },
  {
   "start": 138.97,
   "end": 139.91,
   "text": "גם אם אני צודק,"
  },
  {
   "start": 141.11,
   "end": 142.49,
   "text": "גם אם אני מסכן את עצמי,"
  },
  {
   "start": 143.85,
   "end": 145.07,
   "text": "אבל כל זה שווה"
  },
  {
   "start": 145.93,
   "end": 147.91,
   "text": "כדי שלא תיפול שערה אחת"
  },
  {
   "start": 149.33,
   "end": 150.49,
   "text": "מראש של יהודי."
  },
  {
   "start": 152.47,
   "end": 153.21,
   "text": "אז שמשון,"
  },
  {
   "start": 153.73,
   "end": 157.43,
   "text": "אוהבם הגדול של ישראל פונה אליך ואומר להם,"
  },
  {
   "start": 157.95,
   "end": 159.53,
   "text": "להילחם בכם חס וחלילה."
  },
  {
   "start": 161.27,
   "end": 162.21,
   "text": "אני לא אלחם בכם,"
  },
  {
   "start": 162.91,
   "end": 163.49,
   "text": "אני אבוא איתכם,"
  },
  {
   "start": 164.15,
   "end": 164.93,
   "text": "רק יש לי בקשה,"
  },
  {
   "start": 165.61,
   "end": 166.21,
   "text": "תבטיחו לי,"
  },
  {
   "start": 166.83,
   "end": 168.29,
   "text": "תבטיחו לי שלא תפגעו בי,"
  },
  {
   "start": 168.91,
   "end": 170.45,
   "text": "רק תסגיר אותי לפלישתים, זה הכול."
  },
  {
   "start": 174.26,
   "end": 175.94,
   "text": "ורטט של התרגשות אוחז בהם."
  },
  {
   "start": 178.2,
   "end": 180.62,
   "text": "הם מלאים הערצה לגדלות הרוח שלו."
  },
  {
   "start": 181.48,
   "end": 184.56,
   "text": "הם מבטיחים לו, לא ניגע בך חס וחלילה לרעה,"
  },
  {
   "start": 185.26,
   "end": 186.0,
   "text": "רק נאסור אותך."
  },
  {
   "start": 187.74,
   "end": 188.84,
   "text": "ואתה יודע, שמשון,"
  },
  {
   "start": 189.4,
   "end": 191.74,
   "text": "נאסור אותך בחבלים חדשים ודקים,"
  },
  {
   "start": 192.34,
   "end": 193.96,
   "text": "שאתה יכול להשתחרר מהם בקלות."
  },
  {
   "start": 195.86,
   "end": 197.34,
   "text": "פשוט אין לנו ברירה, שמשון,"
  },
  {
   "start": 198.32,
   "end": 199.7,
   "text": "הם אומרים לו בקול רועד,"
  },
  {
   "start": 204.42,
   "end": 204.96,
   "text": "וכך"
  },
  {
   "start": 205.82,
   "end": 207.2,
   "text": "מסעיף סלע איתם"
  },
  {
   "start": 207.9,
   "end": 209.9,
   "text": "יוצאים שלושת אלפים מבחורי יהודה,"
  },
  {
   "start": 211.34,
   "end": 213.82,
   "text": "ואימאם פוסע במרכז,"
  },
  {
   "start": 215.3,
   "end": 216.48,
   "text": "במרכז החבורה,"
  },
  {
   "start": 217.12,
   "end": 218.2,
   "text": "במרכז הקבוצה,"
  },
  {
   "start": 218.96,
   "end": 219.58,
   "text": "שמשון,"
  },
  {
   "start": 220.22,
   "end": 221.46,
   "text": "גיבורם של ישראל,"
  },
  {
   "start": 222.36,
   "end": 223.16,
   "text": "כשהוא כבול."
  },
  {
   "start": 226.88,
   "end": 227.52,
   "text": "שם למטה,"
  },
  {
   "start": 228.14,
   "end": 228.66,
   "text": "בשדה,"
  },
  {
   "start": 229.26,
   "end": 230.7,
   "text": "מחנה פלישתים צוהל,"
  },
  {
   "start": 231.36,
   "end": 233.86,
   "text": "זעקות פורעות של שמחה נשמעות."
  },
  {
   "start": 234.86,
   "end": 236.18,
   "text": "שמשון עוד מעט"
  },
  {
   "start": 236.98,
   "end": 238.06,
   "text": "בידיים שלהם."
  },
  {
   "start": 240.57,
   "end": 244.43,
   "text": "ואם אתה רק היית מטה אוזן, אם רק היית מטה אוזן,"
  },
  {
   "start": 245.39,
   "end": 247.37,
   "text": "הייתם יכולים לשמוע שירי ביזיון,"
  },
  {
   "start": 247.91,
   "end": 248.79,
   "text": "שירי לגלוג,"
  },
  {
   "start": 249.87,
   "end": 252.07,
   "text": "שנשמעים להם במרחבי השטח הפתוח,"
  },
  {
   "start": 253.21,
   "end": 254.41,
   "text": "בו נעסקו הפלישתים."
  },
  {
   "start": 256.41,
   "end": 258.91,
   "text": "הבחורים מיהודה שלחו את שמשון,"
  },
  {
   "start": 259.87,
   "end": 260.77,
   "text": "והם עמדו מרחוק,"
  },
  {
   "start": 262.27,
   "end": 264.97,
   "text": "ושמשון מתקרב לו,"
  },
  {
   "start": 266.61,
   "end": 267.27,
   "text": "יחידי"
  },
  {
   "start": 268.51,
   "end": 269.57,
   "text": "אל מחנה פלישתים."
  },
  {
   "start": 272.03,
   "end": 273.19,
   "text": "אל אותו מחנה פלישתים"
  },
  {
   "start": 275.07,
   "end": 276.73,
   "text": "שממתינים לנפילתו."
  },
  {
   "start": 278.53,
   "end": 282.97,
   "text": "שממתינים לנפילתו בידיהם כפרי בשל."
  },
  {
   "start": 295.27,
   "end": 295.97,
   "text": "ועוד צעד"
  },
  {
   "start": 297.41,
   "end": 299.13,
   "text": "במרחבי השטח הפתוח."
  },
  {
   "start": 300.41,
   "end": 300.81,
   "text": "מחזה,"
  },
  {
   "start": 302.13,
   "end": 302.79,
   "text": "מרעיד לב."
  },
  {
   "start": 303.93,
   "end": 305.83,
   "text": "מצד אחד מחנה פלישתים צואל,"
  },
  {
   "start": 306.75,
   "end": 308.57,
   "text": "מצד שני יהודי,"
  },
  {
   "start": 309.27,
   "end": 311.97,
   "text": "יהודי, נזיר אלוקים מבטן ולידה,"
  },
  {
   "start": 312.75,
   "end": 316.85,
   "text": "עושה צעד ועוד צעד אל עבר המחנה,"
  },
  {
   "start": 317.81,
   "end": 318.67,
   "text": "כשזרועותיו"
  },
  {
   "start": 319.33,
   "end": 320.13,
   "text": "קשורות להם בחבלים."
  },
  {
   "start": 351.12,
   "end": 356.64,
   "text": "אז עיניו של שמשון נחו להם על שאריות של גביעת חמור,"
  },
  {
   "start": 357.54,
   "end": 358.28,
   "text": "עייר קטן,"
  },
  {
   "start": 358.98,
   "end": 361.62,
   "text": "כבין אולי מספר ימים,"
  },
  {
   "start": 362.82,
   "end": 365.46,
   "text": "שגביעתו זרוקה לה על אם הדרך,"
  },
  {
   "start": 366.3,
   "end": 375.44,
   "text": "ועיניו של שמשון קלטו מימין לגבייה לחי של חמור עדיין רכה עדיין לחה"
  },
  {
   "start": 376.56,
   "end": 377.18,
   "text": "הוא התקרב"
  },
  {
   "start": 378.42,
   "end": 379.04,
   "text": "והתקרב"
  },
  {
   "start": 380.2,
   "end": 382.52,
   "text": "כשהוא צד קצת מצודד ימינה"
  },
  {
   "start": 383.84,
   "end": 387.36,
   "text": "ומנגד עומדים הפלישתים תאבי דם"
  },
  {
   "start": 389.56,
   "end": 392.88,
   "text": "והנה הנה פתאום אחזה בורא עדה"
  },
  {
   "start": 393.7,
   "end": 396.42,
   "text": "רוח השם נכנסה אל שמשון"
  },
  {
   "start": 397.14,
   "end": 398.7,
   "text": "רוח השם נכנסה אל תוכו,"
  },
  {
   "start": 399.4,
   "end": 405.0,
   "text": "הוא הניע את זרועותיו והחבלים פשוט נמסו להם."
  },
  {
   "start": 407.12,
   "end": 408.02,
   "text": "שמשון התכופב,"
  },
  {
   "start": 409.82,
   "end": 411.06,
   "text": "אחז בלחי החמור"
  },
  {
   "start": 411.72,
   "end": 414.66,
   "text": "כבמעין כלי נשק שמונח לו בידו"
  },
  {
   "start": 415.66,
   "end": 419.2,
   "text": "והחל מתקרב מסתער לעבר מחנה פלישתים,"
  },
  {
   "start": 419.58,
   "end": 425.06,
   "text": "תוך שניות המרחק מצטמצם והוא מתקרב צעד ועוד צעד,"
  },
  {
   "start": 425.52,
   "end": 426.6,
   "text": "מטר ועוד מטר,"
  },
  {
   "start": 427.8,
   "end": 428.84,
   "text": "והוא כבר בתוכם,"
  },
  {
   "start": 429.66,
   "end": 431.82,
   "text": "והוא החל מניף את זרועותיו העצומות,"
  },
  {
   "start": 432.5,
   "end": 435.78,
   "text": "והחל מכה במהירות מדהימה,"
  },
  {
   "start": 436.68,
   "end": 437.96,
   "text": "בעוצמה אדירה."
  },
  {
   "start": 440.04,
   "end": 441.32,
   "text": "מכה ומכה."
  },
  {
   "start": 443.14,
   "end": 447.54,
   "text": "איש אחרי איש נופלים ללא רוח חיים,"
  },
  {
   "start": 448.04,
   "end": 450.7,
   "text": "איש אחרי איש נופלים הרוגים,"
  },
  {
   "start": 453.84,
   "end": 457.92,
   "text": "וזרועותיו של שמשון נאות ללא הרף."
  },
  {
   "start": 458.78,
   "end": 462.22,
   "text": "הוא עובד כמכונת מלחמה משומנת, לא נח"
  },
  {
   "start": 463.0,
   "end": 463.76,
   "text": "ולו לרגע."
  },
  {
   "start": 465.18,
   "end": 469.06,
   "text": "הולם והולם, איזה כוח עצום, איזה סיבולת."
  },
  {
   "start": 473.07,
   "end": 475.81,
   "text": "אלף פלישתים נהרגים,"
  },
  {
   "start": 476.63,
   "end": 483.12,
   "text": "אלף פלישתים, כשהשאר בורחים להם בפחד בל יתואר,"
  },
  {
   "start": 484.12,
   "end": 485.26,
   "text": "נסים על חייהם."
  },
  {
   "start": 489.08,
   "end": 492.56,
   "text": "הם הגיעו לארץ פלישתים הבורחים, באפיסת כוחות,"
  },
  {
   "start": 493.2,
   "end": 495.3,
   "text": "בעיניים פעורות מפחד תהומי,"
  },
  {
   "start": 496.1,
   "end": 499.2,
   "text": "ומספרים שם בפלישתים על תוצאות הקרב."
  },
  {
   "start": 501.0,
   "end": 505.5,
   "text": "והאימה והפחד תופסים להם מקום של כבוד בקרב הפלישתים."
  },
  {
   "start": 506.16,
   "end": 508.5,
   "text": "יהודי אחד עם רוח אלוקים,"
  },
  {
   "start": 509.26,
   "end": 511.6,
   "text": "יהודי אחד עם אמונה קדושה."
  },
  {
   "start": 512.58,
   "end": 518.36,
   "text": "מה יכולים לעשות ולחולל המוני יהודים עם תורה ומצוות,"
  },
  {
   "start": 518.8,
   "end": 519.56,
   "text": "עם תשובה,"
  },
  {
   "start": 520.34,
   "end": 522.12,
   "text": "עם שמירת עיניים, עם צניעות?"
  },
  {
   "start": 522.62,
   "end": 523.76,
   "text": "אי אפשר לתאר."
  },
  {
   "start": 524.56,
   "end": 528.26,
   "text": "אפשר להבין רק מניצחון של יהודי אחד,"
  },
  {
   "start": 529.02,
   "end": 531.0,
   "text": "שמשון, גיבורם של ישראל."
  },
  {
   "start": 541.93,
   "end": 544.69,
   "text": "מאחור בשדה הקרב זרוע החללים."
  },
  {
   "start": 545.61,
   "end": 546.75,
   "text": "שמשון נותר לבד."
  },
  {
   "start": 549.95,
   "end": 552.69,
   "text": "דממה משתררת לה שם מאחור."
  },
  {
   "start": 554.27,
   "end": 555.43,
   "text": "ושמשון ממלמל,"
  },
  {
   "start": 556.09,
   "end": 557.21,
   "text": "בלחי חמור,"
  },
  {
   "start": 557.83,
   "end": 559.99,
   "text": "בלחי חמור הכיתי אלף איש,"
  },
  {
   "start": 561.13,
   "end": 561.99,
   "text": "הוא אומר בהתפעלות."
  },
  {
   "start": 564.25,
   "end": 564.73,
   "text": "אחר כך"
  },
  {
   "start": 565.57,
   "end": 567.39,
   "text": "הוא מרשה לעצמו להרפות את ידו,"
  },
  {
   "start": 568.35,
   "end": 570.29,
   "text": "ולחי החמור מושלכת לה."
  },
  {
   "start": 570.93,
   "end": 573.25,
   "text": "שם המקום יקרב וייזכר כרמת לחי."
  },
  {
   "start": 575.27,
   "end": 576.39,
   "text": "על שם אותה לחי חמור."
  },
  {
   "start": 578.84,
   "end": 581.58,
   "text": "שמשון מסתובב ומבקש לחזור אל הבית שלו,"
  },
  {
   "start": 582.46,
   "end": 583.38,
   "text": "סוף סוף אל הבית."
  },
  {
   "start": 584.84,
   "end": 585.28,
   "text": "אבל אז,"
  },
  {
   "start": 586.64,
   "end": 587.52,
   "text": "לפתע גל,"
  },
  {
   "start": 588.22,
   "end": 589.64,
   "text": "גל של חולשה אדירה,"
  },
  {
   "start": 590.38,
   "end": 591.68,
   "text": "פושט לו בכל גופו,"
  },
  {
   "start": 592.36,
   "end": 594.86,
   "text": "בכל גופו הסחוט מעייפות."
  },
  {
   "start": 596.2,
   "end": 597.0,
   "text": "צמא אדיר"
  },
  {
   "start": 597.64,
   "end": 598.94,
   "text": "זוחה לו במעלה גרונו."
  },
  {
   "start": 599.66,
   "end": 600.36,
   "text": "הוא רוצה ללכת,"
  },
  {
   "start": 602.1,
   "end": 602.24,
   "text": "אבל"
  },
  {
   "start": 603.16,
   "end": 603.84,
   "text": "אין לו כוח."
  },
  {
   "start": 605.36,
   "end": 606.86,
   "text": "הוא צונח באפיסת כוחות,"
  },
  {
   "start": 607.58,
   "end": 608.46,
   "text": "מיובש כולו."
  },
  {
   "start": 609.7,
   "end": 611.92,
   "text": "אפילו להושיט יד לכוספיים,"
  },
  {
   "start": 612.6,
   "end": 613.6,
   "text": "אם היו מגישים לו,"
  },
  {
   "start": 614.16,
   "end": 614.72,
   "text": "אין לו כוח."
  },
  {
   "start": 616.5,
   "end": 617.14,
   "text": "מה קורה לי?"
  },
  {
   "start": 618.2,
   "end": 618.82,
   "text": "מה קורה לי?"
  },
  {
   "start": 619.38,
   "end": 620.68,
   "text": "עלמה המחשבה במוחו."
  },
  {
   "start": 624.14,
   "end": 626.26,
   "text": "בלחי חמור הכיתי אלף איש."
  },
  {
   "start": 627.52,
   "end": 628.72,
   "text": "הוא נזכר בדבריו."
  },
  {
   "start": 629.9,
   "end": 630.66,
   "text": "אני הכיתי."
  },
  {
   "start": 632.16,
   "end": 632.36,
   "text": "אני,"
  },
  {
   "start": 633.1,
   "end": 634.4,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 635.52,
   "end": 636.28,
   "text": "אתה הכית,"
  },
  {
   "start": 639.57,
   "end": 641.51,
   "text": "לא אני הכיתי, ריבונו של עולם."
  },
  {
   "start": 642.53,
   "end": 643.13,
   "text": "אתה נתת"
  },
  {
   "start": 644.79,
   "end": 647.41,
   "text": "בי עבדיך את התשועה הגדולה הזו."
  },
  {
   "start": 648.33,
   "end": 651.05,
   "text": "אתה נתת ביד עבדיך את התשועה הגדולה הזו."
  },
  {
   "start": 652.53,
   "end": 653.97,
   "text": "אתה בעולם, איך אני התרגלתי?"
  },
  {
   "start": 654.69,
   "end": 658.35,
   "text": "איך אני חשבתי לרגע אני הכיתי? זה אתה אשם."
  },
  {
   "start": 661.5,
   "end": 663.16,
   "text": "כמה יצר מטה את האדם."
  },
  {
   "start": 663.66,
   "end": 666.16,
   "text": "ניצחון אחד כל כך גדול וכבר"
  },
  {
   "start": 666.9,
   "end": 669.62,
   "text": "לשנייה שכחתי את השם לא מתאים לי,"
  },
  {
   "start": 670.52,
   "end": 671.34,
   "text": "חשב שמשון."
  },
  {
   "start": 672.54,
   "end": 674.72,
   "text": "וככה שהוא שוכב נזכר לו,"
  },
  {
   "start": 675.36,
   "end": 676.5,
   "text": "שאימא שלו סיפרה לו"
  },
  {
   "start": 677.34,
   "end": 678.5,
   "text": "על דברי המלאך"
  },
  {
   "start": 679.5,
   "end": 681.3,
   "text": "כשהוא היה קטן, כשהיה עוד לא נולד,"
  },
  {
   "start": 682.1,
   "end": 685.6,
   "text": "כשהמלאך בא לאימו כשהייתה בהיריון ואמר לה"
  },
  {
   "start": 686.22,
   "end": 689.06,
   "text": "ועל הילד והוא יאחל להושיע את ישראל,"
  },
  {
   "start": 689.84,
   "end": 691.84,
   "text": "והוא יאחל, רק יתחיל"
  },
  {
   "start": 692.62,
   "end": 693.72,
   "text": "מה, כאן זה נגמר?"
  },
  {
   "start": 695.08,
   "end": 697.82,
   "text": "הרי יכולים לבוא עכשיו פלישתים להרוג אותי, אין לי כוח לזוז."
  },
  {
   "start": 698.68,
   "end": 699.8,
   "text": "ברור לעם, כאן זה נגמר?"
  },
  {
   "start": 700.68,
   "end": 702.82,
   "text": "ריבונו של עולם, תרחם עליי."
  },
  {
   "start": 703.62,
   "end": 704.76,
   "text": "אני עושה תשובה."
  },
  {
   "start": 705.56,
   "end": 706.16,
   "text": "ברור העולם,"
  },
  {
   "start": 706.98,
   "end": 707.84,
   "text": "אני יהודי."
  },
  {
   "start": 708.52,
   "end": 711.82,
   "text": "ברור לעם, אתה יודע, אפילו אם ההבדל ביני לבין פלישתים,"
  },
  {
   "start": 712.36,
   "end": 715.08,
   "text": "זה בסך הכל בזה שאני יהודי עם ברית מילה."
  },
  {
   "start": 715.7,
   "end": 719.72,
   "text": "אולי אני מלא עבירות, אבל יש לי ברית מילה ולהם אין."
  },
  {
   "start": 720.48,
   "end": 722.0,
   "text": "בזכות הברית מילה,"
  },
  {
   "start": 722.46,
   "end": 725.64,
   "text": "בזכות המצווה הזו, כדאי שאני לא אפול בידיהם."
  },
  {
   "start": 725.98,
   "end": 727.62,
   "text": "אל תיתן לי ליפול בידיהם."
  },
  {
   "start": 729.4,
   "end": 730.14,
   "text": "תראו מה זה,"
  },
  {
   "start": 731.06,
   "end": 735.64,
   "text": "שמשון, נציג שבט דן, המאסף לכל המחנות,"
  },
  {
   "start": 736.32,
   "end": 737.22,
   "text": "מגלה לנו סוד עצום,"
  },
  {
   "start": 738.3,
   "end": 740.28,
   "text": "גם כשנראה שאנחנו בתחתית,"
  },
  {
   "start": 740.98,
   "end": 742.08,
   "text": "בשיא התאומות,"
  },
  {
   "start": 742.94,
   "end": 747.12,
   "text": "ולו מצווה אחת כמו ברית מילה שעשו לנו כשהיינו קטנים,"
  },
  {
   "start": 747.92,
   "end": 750.22,
   "text": "מעלה אותנו מעל כל הגויים בעולם."
  },
  {
   "start": 752.64,
   "end": 756.76,
   "text": "איזה יקרים, כמה יקרים אנחנו בעיני השם."
  },
  {
   "start": 758.04,
   "end": 760.56,
   "text": "על מה הוא מתפלל ברגעים כאלה קריטיים,"
  },
  {
   "start": 761.1,
   "end": 763.96,
   "text": "שזכות הברית מילה המצווה הזאת תגן עליו."
  },
  {
   "start": 764.66,
   "end": 766.0,
   "text": "לא כלום מעבר לזה."
  },
  {
   "start": 768.41,
   "end": 771.59,
   "text": "אתם יודעים מהו כוח תפילה של יהודי שמשון מלמד אותנו."
  },
  {
   "start": 772.69,
   "end": 777.49,
   "text": "אני תולה את כל מבטחי בשם יתברך, ולו בזכות מצווה שעשו לי בגיל שמונה ימים,"
  },
  {
   "start": 778.15,
   "end": 779.79,
   "text": "שלא שאלו אותי ולא כלום,"
  },
  {
   "start": 780.37,
   "end": 783.41,
   "text": "ולו בזכות זה, ברור העולם, אני יודע שאתה יכול לגרול אותי."
  },
  {
   "start": 784.31,
   "end": 788.01,
   "text": "ושימשון שוכב, כל כך חלוש, כל כך מיובש."
  },
  {
   "start": 788.41,
   "end": 791.13,
   "text": "שמשון, תתפלל על המצוות, על התורה שעשית. לא,"
  },
  {
   "start": 791.65,
   "end": 792.73,
   "text": "על המצווה הזאת אני אתפלל."
  },
  {
   "start": 794.73,
   "end": 796.79,
   "text": "ושימשון, שאפילו את היד שלו לא יכול להרים,"
  },
  {
   "start": 797.55,
   "end": 801.47,
   "text": "אבל את השפתיים הוא כן יכול עדיין קצת להזיז בתחינה אל השם,"
  },
  {
   "start": 802.85,
   "end": 804.49,
   "text": "אז הוא מזיז אותם, אז הוא מתפלל."
  },
  {
   "start": 805.61,
   "end": 809.07,
   "text": "והשם מתברך ממעון קודשו מן השמיים,"
  },
  {
   "start": 809.07,
   "end": 814.93,
   "text": "שומע את הבן שלו שעושה את מה שיהודי צריך לעשות."
  },
  {
   "start": 815.77,
   "end": 818.83,
   "text": "אפילו חרב חדה מונחת על צווארו של אדם,"
  },
  {
   "start": 819.43,
   "end": 821.03,
   "text": "אל ימנע עצמו מן הרחמים."
  },
  {
   "start": 821.63,
   "end": 824.61,
   "text": "אפילו בן אדם כמה שחטא, כמה שפגם,"
  },
  {
   "start": 825.31,
   "end": 827.13,
   "text": "אל ימנע עצמו מן הרחמים."
  },
  {
   "start": 827.51,
   "end": 830.77,
   "text": "שמשון לא מפסיק להתפלל באיזה מצב שהוא לא יהיה."
  },
  {
   "start": 832.07,
   "end": 833.21,
   "text": "והקדוש ברוך הוא שומע."
  },
  {
   "start": 833.83,
   "end": 834.53,
   "text": "אתם יודעים מה קורה?"
  },
  {
   "start": 835.21,
   "end": 836.73,
   "text": "קורה לו נס כזה מופלא."
  },
  {
   "start": 836.73,
   "end": 843.57,
   "text": "מעיין מים קטן פורץ לו ומפעפע לו מבין השיניים שלו."
  },
  {
   "start": 843.97,
   "end": 845.21,
   "text": "הרי שמשון, אתה לא יכול לקום."
  },
  {
   "start": 845.75,
   "end": 847.13,
   "text": "אין לך כוח להרים את היד."
  },
  {
   "start": 847.71,
   "end": 850.97,
   "text": "אני אדאג לך, מעיין פרטי בתוך הפה שלך."
  },
  {
   "start": 852.09,
   "end": 859.47,
   "text": "מעיין פרטי מבין השיניים של שמשון פורץ לו ומשקה ומרווה ומחיה את שמשון."
  },
  {
   "start": 860.29,
   "end": 861.27,
   "text": "ושמשון ניצל."
  },
  {
   "start": 862.87,
   "end": 864.23,
   "text": "לפני כמה מאות שנים"
  },
  {
   "start": 864.91,
   "end": 866.03,
   "text": "היה נביא בישראל,"
  },
  {
   "start": 866.81,
   "end": 867.47,
   "text": "משה רבנו,"
  },
  {
   "start": 868.35,
   "end": 869.85,
   "text": "וכשהוא בירך את בני ישראל,"
  },
  {
   "start": 870.37,
   "end": 871.85,
   "text": "כשהוא מברך את שבט דן,"
  },
  {
   "start": 872.55,
   "end": 874.39,
   "text": "הוא מבקש זכות שתעמוד לדורות."
  },
  {
   "start": 875.49,
   "end": 880.97,
   "text": "זכות שתעמוד לדורות הבאים, לאיזה יהודי שברגע שהוא חלש,"
  },
  {
   "start": 881.27,
   "end": 882.81,
   "text": "ברגע של חולשה, הוא יפנה אל השם."
  },
  {
   "start": 884.85,
   "end": 886.35,
   "text": "גור אריה,"
  },
  {
   "start": 887.01,
   "end": 887.45,
   "text": "דן,"
  },
  {
   "start": 888.03,
   "end": 890.51,
   "text": "גור אריה יזנק מן הבשן."
  },
  {
   "start": 891.03,
   "end": 891.81,
   "text": "מה זה מן הבשן?"
  },
  {
   "start": 893.07,
   "end": 894.03,
   "text": "מה זה דן?"
  },
  {
   "start": 894.59,
   "end": 895.53,
   "text": "דן זה שבט דן."
  },
  {
   "start": 896.01,
   "end": 902.39,
   "text": "גור אריה שמשון, יזנק מן הבשן, שיזנק מן הבשן מבין שיניו."
  },
  {
   "start": 903.19,
   "end": 905.97,
   "text": "מן הבשן, ראשי תיבות, מבין שיניו מים."
  },
  {
   "start": 906.29,
   "end": 908.69,
   "text": "בור עולם תושיע אותו ברגע שהוא יצעק אליך."
  },
  {
   "start": 909.15,
   "end": 912.85,
   "text": "ככה משה רבנו מתפלל עלינו גם, רק נצעק אליו."
  },
  {
   "start": 914.59,
   "end": 915.75,
   "text": "והקדוש ברוך הוא יושיע אותנו,"
  },
  {
   "start": 917.17,
   "end": 917.79,
   "text": "והוא מושיע אותו."
  },
  {
   "start": 918.77,
   "end": 920.23,
   "text": "מים חיים מתוך שיניו."
  },
  {
   "start": 920.89,
   "end": 921.89,
   "text": "שמשון לוגם."
  },
  {
   "start": 922.71,
   "end": 927.25,
   "text": "מתעורר לחיים, קם וחוזר הביתה."
  },
  {
   "start": 930.63,
   "end": 931.81,
   "text": "ואחר הדברים האלה,"
  },
  {
   "start": 932.89,
   "end": 940.82,
   "text": "בני ישראל מתחזקים באמונה בשם יתברך,"
  },
  {
   "start": 943.56,
   "end": 946.44,
   "text": "ומידה כנגד מידה, ידם של פלישתים,"
  },
  {
   "start": 947.4,
   "end": 948.46,
   "text": "ידם של פלישתים"
  },
  {
   "start": 949.76,
   "end": 950.34,
   "text": "נרפט מהם,"
  },
  {
   "start": 951.94,
   "end": 952.72,
   "text": "ושמשון,"
  },
  {
   "start": 953.8,
   "end": 954.48,
   "text": "שמשון נהיה"
  },
  {
   "start": 955.52,
   "end": 956.52,
   "text": "שופט ישראל."
  },
  {
   "start": 966.25,
   "end": 970.99,
   "text": "אומר הפסוק כי שמש הוא מגן השם אלוקים כי שמש הוא מגן"
  },
  {
   "start": 971.95,
   "end": 977.73,
   "text": "השם אלוקים כמו שהשמש מאירה את העולם בלי קבלת מורא בלי טובות"
  },
  {
   "start": 978.39,
   "end": 986.57,
   "text": "רק מטיבה עם העולם רק מאירה לעולם ככה היה שמשון רק מיטיב עם עם ישראל רק מאיר להם את הדרך"
  },
  {
   "start": 987.13,
   "end": 993.41,
   "text": "כשהוא היה שופט של עם ישראל אוהב עם ישראל הוא היה שופט מתווך פותר בעיות בעם"
  },
  {
   "start": 993.81,
   "end": 995.37,
   "text": "ללא קבלת תמורה,"
  },
  {
   "start": 995.71,
   "end": 997.43,
   "text": "ללא קבלת טובת הנאה,"
  },
  {
   "start": 997.85,
   "end": 998.55,
   "text": "רק משפיע,"
  },
  {
   "start": 999.07,
   "end": 999.83,
   "text": "רק נותן,"
  },
  {
   "start": 1000.35,
   "end": 1007.69,
   "text": "עד לכך שבמשך עשרים השנה שהוא שפט הוא מעולם לא אמר לאדם,"
  },
  {
   "start": 1008.41,
   "end": 1010.89,
   "text": "תעביר לי את הדבר הזה ממקום למקום,"
  },
  {
   "start": 1011.25,
   "end": 1012.39,
   "text": "תעביר לי את זה מכאן לכאן,"
  },
  {
   "start": 1013.03,
   "end": 1013.89,
   "text": "הוא לא אמר את זה."
  },
  {
   "start": 1014.91,
   "end": 1015.59,
   "text": "כי אני שופט,"
  },
  {
   "start": 1016.19,
   "end": 1018.21,
   "text": "אסור שיהיה לי משהו של טובת הנאה."
  },
  {
   "start": 1019.79,
   "end": 1021.81,
   "text": "כי שמש ומגן השם אלוקים,"
  },
  {
   "start": 1022.31,
   "end": 1024.45,
   "text": "כמו שהקדוש ברוך הוא נוהג עם ישראל,"
  },
  {
   "start": 1024.87,
   "end": 1027.65,
   "text": "ככה למד שימשון ממידותיו של הקדוש ברוך הוא,"
  },
  {
   "start": 1028.09,
   "end": 1029.47,
   "text": "ורק אוהב את עם ישראל,"
  },
  {
   "start": 1030.05,
   "end": 1032.15,
   "text": "רק משפיע כל כך על עם ישראל."
  },
  {
   "start": 1033.53,
   "end": 1035.49,
   "text": "וכמו שהשם יתברך מבטיח לנו,"
  },
  {
   "start": 1036.13,
   "end": 1038.85,
   "text": "ולעתיד לבוא ואשא אתכם על כנפי נשרים,"
  },
  {
   "start": 1039.23,
   "end": 1041.07,
   "text": "ואשא אתכם על כנפי נשרים, למה?"
  },
  {
   "start": 1041.67,
   "end": 1044.65,
   "text": "כמו נשר ששם את הבנים שלו על הכנפיים,"
  },
  {
   "start": 1045.31,
   "end": 1047.07,
   "text": "ואומר אם ינסו לפגוע בהם,"
  },
  {
   "start": 1047.69,
   "end": 1050.23,
   "text": "איזה חץ ינסו לשלוח עלי הילדים שלי,"
  },
  {
   "start": 1050.95,
   "end": 1053.71,
   "text": "הפגיעה תהיה קודם כל בגוף של ליבי."
  },
  {
   "start": 1054.59,
   "end": 1057.31,
   "text": "מוטב שיזיקו לי ולא יפגעו בילדים שלי."
  },
  {
   "start": 1057.95,
   "end": 1059.89,
   "text": "ככה שמשון העדיף שיפגעו בו,"
  },
  {
   "start": 1060.21,
   "end": 1061.65,
   "text": "שיסגירו אותו לפלישתין,"
  },
  {
   "start": 1061.95,
   "end": 1063.89,
   "text": "ולא יינזק יהודי אחד,"
  },
  {
   "start": 1064.93,
   "end": 1067.05,
   "text": "ולא תיפול שערה אחת מראש של יהודי,"
  },
  {
   "start": 1067.35,
   "end": 1068.29,
   "text": "מראש של יהודייה."
  },
  {
   "start": 1088.86,
   "end": 1090.46,
   "text": "היה מצביא אחד בעולם,"
  },
  {
   "start": 1091.5,
   "end": 1094.8,
   "text": "שכמעט כבש את מרבית העולם של אז, קראו לו אלכסנדר מוקדון."
  },
  {
   "start": 1096.5,
   "end": 1098.6,
   "text": "כשהוא באחד ממסעות הכיבוש שלו,"
  },
  {
   "start": 1100.02,
   "end": 1101.12,
   "text": "חזר הביתה למוקדוניה,"
  },
  {
   "start": 1102.1,
   "end": 1103.5,
   "text": "פגש את אחד מזקני העיר,"
  },
  {
   "start": 1104.92,
   "end": 1106.36,
   "text": "ואמר לו אותו זקן, אמר לו,"
  },
  {
   "start": 1106.98,
   "end": 1108.2,
   "text": "אלכסנדרוס מוקדונוס,"
  },
  {
   "start": 1109.6,
   "end": 1110.78,
   "text": "המלחמה הגדולה"
  },
  {
   "start": 1111.76,
   "end": 1112.44,
   "text": "עדיין לפניך,"
  },
  {
   "start": 1113.28,
   "end": 1114.72,
   "text": "יש מלחמה אחת שעדיין לא ניצחת."
  },
  {
   "start": 1116.66,
   "end": 1117.2,
   "text": "אמר לו, איזה?"
  },
  {
   "start": 1118.52,
   "end": 1120.54,
   "text": "כמעט לא נותר מקום אחד שלא כבשתי."
  },
  {
   "start": 1121.42,
   "end": 1123.62,
   "text": "איזה מלחמה אתה מדבר? איזה מלחמה גדולה?"
  },
  {
   "start": 1124.3,
   "end": 1126.06,
   "text": "אמר לו הזקן אלכסנדרוס,"
  },
  {
   "start": 1126.76,
   "end": 1128.88,
   "text": "המלחמה הגדולה שעדיין לא ניצחת,"
  },
  {
   "start": 1129.66,
   "end": 1132.12,
   "text": "זו המלחמה של האדם בעצמו,"
  },
  {
   "start": 1132.82,
   "end": 1133.82,
   "text": "ביצרים שלו."
  },
  {
   "start": 1134.58,
   "end": 1135.76,
   "text": "זו המלחמה הגדולה מכולם."
  },
  {
   "start": 1139.23,
   "end": 1141.07,
   "text": "כמה צדק, חוכמה בה גויים,"
  },
  {
   "start": 1142.39,
   "end": 1144.31,
   "text": "תאמין, תורה בה גויים, אל תאמין."
  },
  {
   "start": 1152.7,
   "end": 1153.64,
   "text": "עוברות השנים,"
  },
  {
   "start": 1155.08,
   "end": 1159.08,
   "text": "ומלחמת הכוחות הרוחניים בשמשון עולה לה וגואה."
  },
  {
   "start": 1161.32,
   "end": 1162.26,
   "text": "ניצוץ עשיו,"
  },
  {
   "start": 1163.28,
   "end": 1165.58,
   "text": "אותו עשיו שנהרג בידי חושים,"
  },
  {
   "start": 1166.48,
   "end": 1167.56,
   "text": "חושים בן דן,"
  },
  {
   "start": 1168.52,
   "end": 1170.84,
   "text": "שגלגול נשמתו הוא שמשון,"
  },
  {
   "start": 1171.52,
   "end": 1173.52,
   "text": "אותו ניצוץ עשיו ששוכן בתוכו,"
  },
  {
   "start": 1174.08,
   "end": 1174.82,
   "text": "שיש לדכא אותו,"
  },
  {
   "start": 1175.34,
   "end": 1176.94,
   "text": "שיש להתגבר אותו עליו,"
  },
  {
   "start": 1179.56,
   "end": 1180.82,
   "text": "לא נותן לשמשון מנוח."
  },
  {
   "start": 1182.9,
   "end": 1185.8,
   "text": "יהי דן נחש על לדרך, ברך יעקב את שבט דן,"
  },
  {
   "start": 1187.2,
   "end": 1191.76,
   "text": "כי דן צריך לתקן את אותו תיקון של חטא נחש הקדמוני,"
  },
  {
   "start": 1192.22,
   "end": 1194.98,
   "text": "ועל כתפיו הגדולות של שמשון,"
  },
  {
   "start": 1195.5,
   "end": 1196.12,
   "text": "גם החטא הזה"
  },
  {
   "start": 1197.24,
   "end": 1198.08,
   "text": "הוא צריך לתקן,"
  },
  {
   "start": 1198.86,
   "end": 1204.04,
   "text": "ונשאר עדיין איישם באפלה את אותו תיקון שהותירו אברהם,"
  },
  {
   "start": 1205.1,
   "end": 1207.26,
   "text": "יצחק ויעקב."
  },
  {
   "start": 1208.76,
   "end": 1209.42,
   "text": "את אותו תיקון,"
  },
  {
   "start": 1210.44,
   "end": 1212.36,
   "text": "כשהם השאירו את תימנע,"
  },
  {
   "start": 1213.22,
   "end": 1215.98,
   "text": "אחות לא תן ולא קירבו אותה לעם ישראל."
  },
  {
   "start": 1217.92,
   "end": 1219.84,
   "text": "האם ניתנת לה הזדמנות נוספת?"
  },
  {
   "start": 1220.74,
   "end": 1221.2,
   "text": "בואו נראה."
  },
  {
   "start": 1224.86,
   "end": 1226.58,
   "text": "כל מלחמת היצרים בשמשון"
  },
  {
   "start": 1228.32,
   "end": 1229.86,
   "text": "נושאת את שמשון חזרה"
  },
  {
   "start": 1230.64,
   "end": 1231.04,
   "text": "לעזה."
  },
  {
   "start": 1235.96,
   "end": 1237.12,
   "text": "כוח פנימי לא מובן"
  },
  {
   "start": 1237.82,
   "end": 1238.6,
   "text": "מושך אותו אל הסכנה."
  },
  {
   "start": 1240.7,
   "end": 1241.5,
   "text": "ויצר רע,"
  },
  {
   "start": 1242.4,
   "end": 1245.06,
   "text": "היצר רע, מלך זקן וכסיל,"
  },
  {
   "start": 1245.74,
   "end": 1249.8,
   "text": "תוקף את שמשון בנשק קטלני עתיק יומין."
  },
  {
   "start": 1251.26,
   "end": 1251.8,
   "text": "שמירת עיניים."
  },
  {
   "start": 1254.18,
   "end": 1256.18,
   "text": "נראה שאצל אדם גדול כשמשון,"
  },
  {
   "start": 1257.14,
   "end": 1257.78,
   "text": "לא, זה לא יקרה,"
  },
  {
   "start": 1258.46,
   "end": 1259.24,
   "text": "הוא מחוסן."
  },
  {
   "start": 1260.28,
   "end": 1261.12,
   "text": "אבל זה לא כך."
  },
  {
   "start": 1262.12,
   "end": 1263.34,
   "text": "אין אדם מחוסן."
  },
  {
   "start": 1264.28,
   "end": 1264.98,
   "text": "גם אצלו"
  },
  {
   "start": 1265.88,
   "end": 1267.12,
   "text": "כמו כל אחד זה קורה."
  },
  {
   "start": 1268.42,
   "end": 1271.94,
   "text": "התורה הקדושה לא חילקה בין תלמיד חכם, צדיק, יהודי פשוט."
  },
  {
   "start": 1272.64,
   "end": 1276.36,
   "text": "כולנו צריכים לשמור את עצמנו, את קדושת נשמתנו"
  },
  {
   "start": 1277.5,
   "end": 1278.4,
   "text": "ואת מחשבותינו."
  },
  {
   "start": 1279.22,
   "end": 1284.16,
   "text": "והפתח לכל אלו זה העיניים, פתח המחשבה, פתחי הנשמה."
  },
  {
   "start": 1284.88,
   "end": 1285.66,
   "text": "לכן הדור שלנו,"
  },
  {
   "start": 1286.24,
   "end": 1287.04,
   "text": "דור של גאולה."
  },
  {
   "start": 1287.86,
   "end": 1290.86,
   "text": "יש עוצמה כל כך גדולה של חוסר צניעות."
  },
  {
   "start": 1292.64,
   "end": 1293.92,
   "text": "כי זהו נשק קטלני עשיו,"
  },
  {
   "start": 1294.76,
   "end": 1295.84,
   "text": "הכוח הזה, הקליפה הזאת,"
  },
  {
   "start": 1297.97,
   "end": 1299.99,
   "text": "פורסת, פותחת את הנשק הקטלני שלה,"
  },
  {
   "start": 1300.63,
   "end": 1301.97,
   "text": "שמסוגל לפגוע בנשמה שלנו."
  },
  {
   "start": 1302.93,
   "end": 1303.29,
   "text": "ומול,"
  },
  {
   "start": 1303.89,
   "end": 1305.19,
   "text": "מול זה חייבים להילחם ולהילחם,"
  },
  {
   "start": 1306.99,
   "end": 1310.13,
   "text": "וגם אם נכשלים, להילחם ולהילחם."
  },
  {
   "start": 1311.75,
   "end": 1312.49,
   "text": "ושמשון,"
  },
  {
   "start": 1313.17,
   "end": 1315.61,
   "text": "שמשון מוצא את עצמו בבית אישה פלישתית."
  },
  {
   "start": 1317.87,
   "end": 1318.25,
   "text": "בחוץ,"
  },
  {
   "start": 1319.29,
   "end": 1319.95,
   "text": "עיניים רעות,"
  },
  {
   "start": 1321.05,
   "end": 1322.15,
   "text": "אורבות להם ליהודי,"
  },
  {
   "start": 1323.07,
   "end": 1326.37,
   "text": "שהקים את ישראל מתחת רגלי פלישתים."
  },
  {
   "start": 1327.33,
   "end": 1328.97,
   "text": "כוח של פלישתים אורב לו."
  },
  {
   "start": 1329.63,
   "end": 1330.81,
   "text": "הם מתארגנים מחוץ לבית,"
  },
  {
   "start": 1331.43,
   "end": 1332.45,
   "text": "לרשותם כל הלילה."
  },
  {
   "start": 1333.65,
   "end": 1335.57,
   "text": "לפנות בוקר, כשיצא שמשון,"
  },
  {
   "start": 1336.25,
   "end": 1338.07,
   "text": "הוא יעמוד מול שערי עזה הנעולים,"
  },
  {
   "start": 1338.63,
   "end": 1340.41,
   "text": "אותם שערים חזקים נעולים,"
  },
  {
   "start": 1341.25,
   "end": 1342.43,
   "text": "שערי ברזל אדירים."
  },
  {
   "start": 1343.19,
   "end": 1344.81,
   "text": "הוא לא יוכל לפתוח כי הם יהיו נעולים,"
  },
  {
   "start": 1345.53,
   "end": 1345.93,
   "text": "ואז,"
  },
  {
   "start": 1346.53,
   "end": 1348.27,
   "text": "אז יתנפלו עליו אלפי פלישתים,"
  },
  {
   "start": 1348.67,
   "end": 1351.97,
   "text": "שבמשך הלילה מתחילים להיות מגויסים אל המשימה הזאת."
  },
  {
   "start": 1352.53,
   "end": 1354.95,
   "text": "וישימו קץ לאותו איום יהודי."
  },
  {
   "start": 1388.31,
   "end": 1390.77,
   "text": "היא קרבה לה אל שערי העיר הנעולים,"
  },
  {
   "start": 1391.59,
   "end": 1392.05,
   "text": "הפתיעה את כולם."
  },
  {
   "start": 1393.55,
   "end": 1394.45,
   "text": "מבעד לעלטה"
  },
  {
   "start": 1395.17,
   "end": 1395.87,
   "text": "נתגלית לה"
  },
  {
   "start": 1396.49,
   "end": 1397.67,
   "text": "דמותו של שמשון."
  },
  {
   "start": 1399.19,
   "end": 1399.89,
   "text": "מוקדם מדי,"
  },
  {
   "start": 1400.69,
   "end": 1403.23,
   "text": "מוקדם מדי, סיננו בזעם הפלישתין."
  },
  {
   "start": 1404.41,
   "end": 1408.21,
   "text": "הוא לא נשאר שם כמו שהם חשבו, כמו שהם תכננו."
  },
  {
   "start": 1410.19,
   "end": 1414.03,
   "text": "מה שהוא זעק בנשמה של שמשון, לך הביתה, זה לא המקום שלך."
  },
  {
   "start": 1414.67,
   "end": 1415.59,
   "text": "הנשמה רוצה הביתה."
  },
  {
   "start": 1416.93,
   "end": 1417.73,
   "text": "בא לך פה בעזה."
  },
  {
   "start": 1418.47,
   "end": 1419.01,
   "text": "ושמשון"
  },
  {
   "start": 1420.19,
   "end": 1420.59,
   "text": "יוצא"
  },
  {
   "start": 1421.83,
   "end": 1422.25,
   "text": "לפתע"
  },
  {
   "start": 1426.28,
   "end": 1427.34,
   "text": "אל מחוץ לאותו בית."
  },
  {
   "start": 1428.54,
   "end": 1432.76,
   "text": "שמשון מגיע לשערי עזה הגדולים, 30 מטר,"
  },
  {
   "start": 1433.66,
   "end": 1437.24,
   "text": "שערי ברזל עצומים, שאפילו הקורות של השער"
  },
  {
   "start": 1437.9,
   "end": 1439.46,
   "text": "נעשו ביחד עם הדלתות."
  },
  {
   "start": 1440.6,
   "end": 1444.02,
   "text": "אין איש בעולם שיכול לפתוח את השער הזה כשהם נעולים,"
  },
  {
   "start": 1445.0,
   "end": 1446.32,
   "text": "את השערים האלה כשהם נעולים."
  },
  {
   "start": 1447.14,
   "end": 1448.34,
   "text": "ושמשון פוסע,"
  },
  {
   "start": 1449.42,
   "end": 1450.92,
   "text": "פוסע ולא נעצר"
  },
  {
   "start": 1451.88,
   "end": 1453.46,
   "text": "גם למול השערים הנעולים."
  },
  {
   "start": 1454.26,
   "end": 1456.48,
   "text": "הוא פשוט שולח את זרועותיו,"
  },
  {
   "start": 1457.02,
   "end": 1458.7,
   "text": "אותן זרועות קטלניות,"
  },
  {
   "start": 1459.44,
   "end": 1461.06,
   "text": "ועוקר את שערי העיר,"
  },
  {
   "start": 1461.78,
   "end": 1468.44,
   "text": "עוקר את שערי עיר עזה ממקומם לתדהמת האורבים שנשארים במערב המומאים."
  },
  {
   "start": 1469.28,
   "end": 1471.2,
   "text": "אחר כך הוא פשוט מעמיס אותם,"
  },
  {
   "start": 1471.94,
   "end": 1475.08,
   "text": "את אותם שערים על הכתפיים הרחבות שלו,"
  },
  {
   "start": 1475.7,
   "end": 1478.04,
   "text": "ונושא אותם עמו כל הדרך,"
  },
  {
   "start": 1479.06,
   "end": 1480.34,
   "text": "עוד דקה ועוד דקה,"
  },
  {
   "start": 1481.66,
   "end": 1482.96,
   "text": "והוא נעלם להם שם,"
  },
  {
   "start": 1483.66,
   "end": 1486.14,
   "text": "אל ראש שער השהר אשר על פני חברון,"
  },
  {
   "start": 1486.86,
   "end": 1487.24,
   "text": "יהודה."
  },
  {
   "start": 1488.58,
   "end": 1491.84,
   "text": "משאיר מאחוריו לוחמים פלישתים"
  },
  {
   "start": 1492.84,
   "end": 1493.28,
   "text": "תאורי פה."
  }
 ]
}