{
 "disc": "14יד- בעלי תשובה",
 "track": "Track02",
 "duration": 976.176,
 "segments": [
  {
   "start": 0.75,
   "end": 1.61,
   "text": "שני השותפים,"
  },
  {
   "start": 2.75,
   "end": 5.13,
   "text": "מונופול הבשר של העיר קראקוב."
  },
  {
   "start": 6.87,
   "end": 8.67,
   "text": "שם דבר בקהילה, בעלי משפחה."
  },
  {
   "start": 9.33,
   "end": 12.29,
   "text": "הם נתנו לילדים שלהם את החינוך הטוב ביותר."
  },
  {
   "start": 12.81,
   "end": 14.25,
   "text": "את מה שהם לא קיבלו כילדים,"
  },
  {
   "start": 14.65,
   "end": 15.55,
   "text": "הם נתנו לילדים שלהם."
  },
  {
   "start": 17.15,
   "end": 19.81,
   "text": "כשהגיע זמן השידוך שלהם, הם נישאו"
  },
  {
   "start": 20.83,
   "end": 22.23,
   "text": "לשידוכים הטובים ביותר."
  },
  {
   "start": 23.09,
   "end": 27.85,
   "text": "ושפע של תלמידי חכמים מאתר את שולחנם בשבתות, בחגים."
  },
  {
   "start": 37.3,
   "end": 37.76,
   "text": "יום אחד,"
  },
  {
   "start": 38.46,
   "end": 39.84,
   "text": "אחד מהשותפים חוזר הביתה."
  },
  {
   "start": 41.64,
   "end": 42.18,
   "text": "הוא שומע את"
  },
  {
   "start": 42.8,
   "end": 44.6,
   "text": "ניגון הלימוד של החתן שלו."
  },
  {
   "start": 46.36,
   "end": 50.22,
   "text": "את זה הגאון שהבת שלו הצעירה כל כך רצתה להינשא לו."
  },
  {
   "start": 51.18,
   "end": 55.62,
   "text": "ולפתע הוא נמשך באיזה חבלי קסם נפלאים אל כל הלימוד,"
  },
  {
   "start": 56.44,
   "end": 58.48,
   "text": "אל הלימוד שלו, אל הקול המתנגן."
  },
  {
   "start": 59.76,
   "end": 60.24,
   "text": "ואז הוא מקשיב."
  },
  {
   "start": 61.08,
   "end": 62.2,
   "text": "הוא שומע את החתן שלו"
  },
  {
   "start": 64.55,
   "end": 69.82,
   "text": "אומר את הדברים האלה, את המדרש הזה."
  },
  {
   "start": 71.04,
   "end": 71.98,
   "text": "שמעולם הוא לא שמע."
  },
  {
   "start": 73.72,
   "end": 74.32,
   "text": "הוא שומע."
  },
  {
   "start": 75.06,
   "end": 76.38,
   "text": "אם חטא במזיד,"
  },
  {
   "start": 77.2,
   "end": 78.76,
   "text": "ועוד החטיא את הרבים,"
  },
  {
   "start": 79.32,
   "end": 82.48,
   "text": "ואכילם נבלות וטרפות בזדון,"
  },
  {
   "start": 83.42,
   "end": 86.16,
   "text": "אין לו חלק בעולם הבא."
  },
  {
   "start": 87.1,
   "end": 89.32,
   "text": "אינו קם בתחיית המתים,"
  },
  {
   "start": 90.16,
   "end": 91.84,
   "text": "ונידון בכפקלע לנצח."
  },
  {
   "start": 96.81,
   "end": 97.27,
   "text": "הוא עמד כפול,"
  },
  {
   "start": 99.17,
   "end": 101.01,
   "text": "הכל הדהד במוחו."
  },
  {
   "start": 101.77,
   "end": 103.05,
   "text": "אם חטא במזיד,"
  },
  {
   "start": 103.63,
   "end": 108.01,
   "text": "ועוד החטיא את הרבים והאכילם נבלות וטרפות בזדון."
  },
  {
   "start": 108.61,
   "end": 110.89,
   "text": "אין לו חלק בעולם הבא,"
  },
  {
   "start": 111.41,
   "end": 116.19,
   "text": "אינו קם בתחיית המתים ונידון בכף הקלע לנצח."
  },
  {
   "start": 118.72,
   "end": 119.52,
   "text": "הוא חש משהו,"
  },
  {
   "start": 120.6,
   "end": 121.28,
   "text": "משהו נשבר בתוכו."
  },
  {
   "start": 123.96,
   "end": 125.92,
   "text": "פעם הוא לא חשב על הנזק שהוא גרם."
  },
  {
   "start": 126.98,
   "end": 128.06,
   "text": "זה היה אורח החיים שלו."
  },
  {
   "start": 130.34,
   "end": 130.64,
   "text": "לפתע"
  },
  {
   "start": 131.66,
   "end": 134.0,
   "text": "הכל התפרץ לנגד עיניו."
  },
  {
   "start": 139.35,
   "end": 139.71,
   "text": "שנים,"
  },
  {
   "start": 140.35,
   "end": 141.83,
   "text": "שנים של הונאת הבריות,"
  },
  {
   "start": 143.09,
   "end": 145.67,
   "text": "שנים של האכלת טרפות ונבלות,"
  },
  {
   "start": 146.21,
   "end": 147.61,
   "text": "וכולם סומכים עליו,"
  },
  {
   "start": 148.77,
   "end": 150.13,
   "text": "וכולם מאמינים בו."
  },
  {
   "start": 151.05,
   "end": 156.19,
   "text": "האדם יכול לחטוא ולא להרגיש כמה רע הוא עושה,"
  },
  {
   "start": 156.81,
   "end": 159.05,
   "text": "אבל אז הקדוש ברוך הוא שולח לו איזה קול"
  },
  {
   "start": 159.89,
   "end": 161.61,
   "text": "שמראה לו את נקודת האמת."
  },
  {
   "start": 165.92,
   "end": 166.58,
   "text": "ואז הוא שומע,"
  },
  {
   "start": 167.14,
   "end": 170.58,
   "text": "מבין להרהורים האיומים שלופתים את מוחו,"
  },
  {
   "start": 170.9,
   "end": 172.82,
   "text": "הוא שומע את קול החתן שלו ממשיך."
  },
  {
   "start": 173.28,
   "end": 176.1,
   "text": "האוכל טרפה בשוגג, חייו כרת,"
  },
  {
   "start": 177.04,
   "end": 180.2,
   "text": "ויכול אף להיכרת מן העולם טרם זמנו."
  },
  {
   "start": 181.24,
   "end": 183.18,
   "text": "מי שאוכל מהאוכל שלי,"
  },
  {
   "start": 184.14,
   "end": 185.44,
   "text": "אוי ואבוי לי."
  },
  {
   "start": 185.82,
   "end": 187.5,
   "text": "ואז הוא פרץ בריצה מהבית."
  },
  {
   "start": 188.12,
   "end": 188.7,
   "text": "אוי לי! הוא צעק."
  },
  {
   "start": 189.3,
   "end": 189.84,
   "text": "אוי לי!"
  },
  {
   "start": 191.08,
   "end": 192.98,
   "text": "ובני ביתו מסתכלים עליו המונים."
  },
  {
   "start": 193.9,
   "end": 194.64,
   "text": "אבא, מה קרה?"
  },
  {
   "start": 195.26,
   "end": 196.16,
   "text": "סבא, מה קרה?"
  },
  {
   "start": 206.35,
   "end": 207.23,
   "text": "עוד באותו לילה,"
  },
  {
   "start": 208.43,
   "end": 209.65,
   "text": "הוא נפגש עם השותף שלו."
  },
  {
   "start": 210.61,
   "end": 213.87,
   "text": "הוא מסביר לו, מסביר לו את חומרת המעשים."
  },
  {
   "start": 215.27,
   "end": 217.35,
   "text": "תגיד לי, מה נאמר, חיים רק פעם אחת?"
  },
  {
   "start": 218.61,
   "end": 219.23,
   "text": "מה נגיד,"
  },
  {
   "start": 219.89,
   "end": 220.85,
   "text": "חיים רק פעם אחת?"
  },
  {
   "start": 221.47,
   "end": 223.09,
   "text": "אתה יודע מה ממתין לנו אחרי מותנו?"
  },
  {
   "start": 224.31,
   "end": 225.61,
   "text": "לא כאן בעולם הזה."
  },
  {
   "start": 226.03,
   "end": 228.15,
   "text": "כמה נשאר לנו הכי לחיות בעולם הזה?"
  },
  {
   "start": 229.21,
   "end": 230.77,
   "text": "תראה כבר כמה מתו במגפות."
  },
  {
   "start": 232.19,
   "end": 234.29,
   "text": "מי אמר שאנחנו לא הבאים בתור?"
  },
  {
   "start": 235.99,
   "end": 238.39,
   "text": "תגיד לי, מה נגיד שם, שהיינו יתומים אומללים?"
  },
  {
   "start": 240.59,
   "end": 242.15,
   "text": "טוב, מה שהיה איתנו זה כשהיינו קטנים,"
  },
  {
   "start": 243.27,
   "end": 246.63,
   "text": "אבל עכשיו כבר גדלנו."
  },
  {
   "start": 247.85,
   "end": 252.55,
   "text": "ומה שהיה איתנו, מה שעשו לנו כשהיינו קטנים, זה כמו גן עדל לעומת מה שיעשו לנו."
  },
  {
   "start": 256.14,
   "end": 256.96,
   "text": "והחבר שלו,"
  },
  {
   "start": 258.04,
   "end": 258.94,
   "text": "החבר שלו מתחיל להבין,"
  },
  {
   "start": 260.24,
   "end": 261.22,
   "text": "והעיניים בורקות"
  },
  {
   "start": 263.78,
   "end": 264.84,
   "text": "והדמעות יורדות."
  },
  {
   "start": 267.23,
   "end": 267.85,
   "text": "מה יהיה איתנו?"
  },
  {
   "start": 268.69,
   "end": 269.85,
   "text": "תלמידי חכמים,"
  },
  {
   "start": 270.43,
   "end": 273.45,
   "text": "צדיקים, חתונות קדושות, בר מצווה, מה לא עשינו?"
  },
  {
   "start": 274.13,
   "end": 276.85,
   "text": "סיום ש״ס, שמחת תורה היה פה,"
  },
  {
   "start": 278.53,
   "end": 282.39,
   "text": "סעודות מצווה בישיבות, בתי כנסיות, וכולם,"
  },
  {
   "start": 282.95,
   "end": 285.95,
   "text": "כולם האכלנו אותם מהבשר הטרף שלנו."
  },
  {
   "start": 289.7,
   "end": 290.78,
   "text": "איך נצא מהמעגל הזה?"
  },
  {
   "start": 291.48,
   "end": 292.0,
   "text": "מה נעשה?"
  },
  {
   "start": 293.32,
   "end": 295.88,
   "text": "והם יושבים בלילה, ליל שימורים,"
  },
  {
   "start": 297.36,
   "end": 298.14,
   "text": "איום ונורא."
  },
  {
   "start": 299.44,
   "end": 300.72,
   "text": "לבסוף הם החליטו פה אחד,"
  },
  {
   "start": 301.74,
   "end": 303.82,
   "text": "אין עצה אחרת, אין דרך אחרת,"
  },
  {
   "start": 304.4,
   "end": 305.62,
   "text": "חייבים להפסיק את זה."
  },
  {
   "start": 306.2,
   "end": 306.32,
   "text": "בוא,"
  },
  {
   "start": 306.92,
   "end": 308.2,
   "text": "בוא נלך לרב של קרקוב,"
  },
  {
   "start": 308.92,
   "end": 312.48,
   "text": "נתוודה בפניו ונבקש דרך לתשובה שלמה."
  },
  {
   "start": 315.02,
   "end": 317.12,
   "text": "ושני הקצבים,"
  },
  {
   "start": 317.6,
   "end": 318.32,
   "text": "שני היתומים,"
  },
  {
   "start": 319.8,
   "end": 321.24,
   "text": "עושים את דרכם אל בית הרב."
  },
  {
   "start": 327.03,
   "end": 327.59,
   "text": "בבית הרב"
  },
  {
   "start": 328.35,
   "end": 329.33,
   "text": "הם יתקבלו בכבוד,"
  },
  {
   "start": 330.15,
   "end": 332.41,
   "text": "כאל הנדבנים בעלי צדקה כל כך חשובים,"
  },
  {
   "start": 333.03,
   "end": 334.29,
   "text": "מפרנסי העיר ממש."
  },
  {
   "start": 335.39,
   "end": 338.41,
   "text": "אבל אז הם מבקשים כבוד הרב, אנחנו רוצים לדבר עם כבוד הרב בסודיות."
  },
  {
   "start": 339.43,
   "end": 340.51,
   "text": "אם אפשר שיצאו,"
  },
  {
   "start": 341.33,
   "end": 342.23,
   "text": "שכולם ייצאו,"
  },
  {
   "start": 344.2,
   "end": 345.04,
   "text": "כל הנוכחים יוצאים,"
  },
  {
   "start": 346.44,
   "end": 346.86,
   "text": "ואז,"
  },
  {
   "start": 348.12,
   "end": 350.26,
   "text": "אז הם יושבים לפני הרעב,"
  },
  {
   "start": 351.2,
   "end": 352.0,
   "text": "כתפיים שמוטות,"
  },
  {
   "start": 353.4,
   "end": 354.12,
   "text": "השפה רועדת,"
  },
  {
   "start": 355.48,
   "end": 356.4,
   "text": "והם פורסים בפניו,"
  },
  {
   "start": 357.84,
   "end": 359.82,
   "text": "אחת לאחת את מסכת חייהם,"
  },
  {
   "start": 363.09,
   "end": 365.09,
   "text": "וכך הם שוטחים בפניו"
  },
  {
   "start": 366.73,
   "end": 367.57,
   "text": "וחושפים בפניו."
  },
  {
   "start": 368.63,
   "end": 369.83,
   "text": "איך עשרות שנים"
  },
  {
   "start": 370.41,
   "end": 374.43,
   "text": "אין בית בעיר קרקוב שהמטבח שלו"
  },
  {
   "start": 375.07,
   "end": 375.89,
   "text": "לא נטרף."
  },
  {
   "start": 381.32,
   "end": 382.22,
   "text": "ובעלה מגלה המוכות,"
  },
  {
   "start": 383.34,
   "end": 384.14,
   "text": "הרב הקדוש,"
  },
  {
   "start": 384.68,
   "end": 385.96,
   "text": "העליט את פניו בידיו."
  },
  {
   "start": 386.8,
   "end": 387.98,
   "text": "הגוף שלו החל לרעוד."
  },
  {
   "start": 388.8,
   "end": 389.74,
   "text": "אויב האבוי."
  },
  {
   "start": 390.68,
   "end": 391.76,
   "text": "יהודים כשרים,"
  },
  {
   "start": 392.62,
   "end": 393.92,
   "text": "נשים צעירות,"
  },
  {
   "start": 395.1,
   "end": 397.3,
   "text": "כמה נפטרו בקיצור ימים."
  },
  {
   "start": 398.6,
   "end": 400.04,
   "text": "זה הסיבה למגפות."
  },
  {
   "start": 400.66,
   "end": 401.94,
   "text": "ילדים, תינוקות."
  },
  {
   "start": 403.36,
   "end": 404.2,
   "text": "כמה תפילות עשי."
  },
  {
   "start": 405.3,
   "end": 406.36,
   "text": "כמה תעניתות."
  },
  {
   "start": 407.1,
   "end": 410.0,
   "text": "שנים שאני מחפש מהיכן שורש האסונות."
  },
  {
   "start": 410.94,
   "end": 411.98,
   "text": "מאיפה ההרוגים האלה?"
  },
  {
   "start": 413.0,
   "end": 418.8,
   "text": "מי היה חולם על זה שדברים כל כך איומים ומזעזעים מתבצעים כל יום,"
  },
  {
   "start": 419.14,
   "end": 419.8,
   "text": "כל שעה,"
  },
  {
   "start": 420.5,
   "end": 421.48,
   "text": "ואף אחד לא יודע?"
  },
  {
   "start": 423.14,
   "end": 423.74,
   "text": "והרב"
  },
  {
   "start": 424.44,
   "end": 425.28,
   "text": "פרץ בבכי,"
  },
  {
   "start": 426.06,
   "end": 428.78,
   "text": "ואחריו שני השותפים פרצו בבכי."
  },
  {
   "start": 437.09,
   "end": 437.97,
   "text": "בפקודת הרב"
  },
  {
   "start": 438.81,
   "end": 441.65,
   "text": "יצאו שליחים לבער את כלי המטבח,"
  },
  {
   "start": 442.55,
   "end": 445.93,
   "text": "הן חמץ, הן של פסח, לשרוף את הכול,"
  },
  {
   "start": 446.77,
   "end": 449.59,
   "text": "ואסרו לאכול בשר עד להודעה חדשה."
  },
  {
   "start": 451.11,
   "end": 451.67,
   "text": "בקרקוב"
  },
  {
   "start": 452.59,
   "end": 454.33,
   "text": "הייתה יכול לראות מחזה נורא,"
  },
  {
   "start": 455.13,
   "end": 456.39,
   "text": "מדורות בכל פינה,"
  },
  {
   "start": 457.33,
   "end": 459.01,
   "text": "ערמות של שברי כלים,"
  },
  {
   "start": 459.77,
   "end": 464.89,
   "text": "מערכות אוכל שלמות מחרסינה מתנפצות להם לעין כול,"
  },
  {
   "start": 469.36,
   "end": 470.34,
   "text": "ובבית של הרב,"
  },
  {
   "start": 471.3,
   "end": 472.26,
   "text": "מוגף סגור."
  },
  {
   "start": 473.76,
   "end": 474.36,
   "text": "פונה הרב"
  },
  {
   "start": 475.9,
   "end": 477.04,
   "text": "לשניים ואומר להם,"
  },
  {
   "start": 477.76,
   "end": 478.24,
   "text": "אני לא יכול,"
  },
  {
   "start": 478.76,
   "end": 481.14,
   "text": "אני לא מסוגל לתת לכם פסק דין של תשובה."
  },
  {
   "start": 482.02,
   "end": 483.54,
   "text": "אני חייב לכנס בית דין,"
  },
  {
   "start": 484.32,
   "end": 485.7,
   "text": "בית דין של גדולי הדור,"
  },
  {
   "start": 486.32,
   "end": 487.38,
   "text": "של גדולי הרבנים."
  },
  {
   "start": 489.63,
   "end": 490.21,
   "text": "לכו הביתה."
  },
  {
   "start": 491.17,
   "end": 491.85,
   "text": "כשיגיעו,"
  },
  {
   "start": 492.67,
   "end": 494.07,
   "text": "אני אזמין אתכם לאותו בית דין."
  },
  {
   "start": 513.97,
   "end": 516.27,
   "text": "גדולי התורה שהגיעו לקרקוב"
  },
  {
   "start": 517.29,
   "end": 518.43,
   "text": "הפעימו לתושבי העיר את הלבבות."
  },
  {
   "start": 520.05,
   "end": 521.65,
   "text": "הם קראו לזה כינוס הגדולים."
  },
  {
   "start": 522.47,
   "end": 523.47,
   "text": "אף אחד לא ידע למה,"
  },
  {
   "start": 524.33,
   "end": 526.15,
   "text": "למה הם באו ועל מה הם באו."
  },
  {
   "start": 527.11,
   "end": 530.55,
   "text": "בינתיים מוזמנים שני הקצבים, שני היתומים,"
  },
  {
   "start": 530.99,
   "end": 531.77,
   "text": "מוזמנים אל הרב."
  },
  {
   "start": 533.49,
   "end": 536.07,
   "text": "ואז הם עומדים מול בית דין נורא,"
  },
  {
   "start": 536.93,
   "end": 539.21,
   "text": "בית דין נורא הוד של גדולי הדור,"
  },
  {
   "start": 540.23,
   "end": 542.17,
   "text": "שם הם פורסים את חטאם הנורא,"
  },
  {
   "start": 545.34,
   "end": 546.48,
   "text": "וכשהכול נחשף,"
  },
  {
   "start": 547.42,
   "end": 550.1,
   "text": "כשהכול התגלה בפני הרבנים הנדהמים,"
  },
  {
   "start": 552.67,
   "end": 553.67,
   "text": "התגובות היו איומות,"
  },
  {
   "start": 554.71,
   "end": 555.35,
   "text": "מצער"
  },
  {
   "start": 556.35,
   "end": 556.87,
   "text": "ועד אימה,"
  },
  {
   "start": 557.81,
   "end": 558.43,
   "text": "מכעס"
  },
  {
   "start": 559.35,
   "end": 560.01,
   "text": "ועד כאב,"
  },
  {
   "start": 560.93,
   "end": 563.13,
   "text": "מיללות ועד בכי."
  },
  {
   "start": 565.94,
   "end": 568.14,
   "text": "קם בעל המגלה עמוקות וטוען,"
  },
  {
   "start": 568.76,
   "end": 572.08,
   "text": "קם רבה של קרקו וטוען, אין חטא שאין לו תיקון."
  },
  {
   "start": 573.04,
   "end": 574.84,
   "text": "אף שנהרגו אנשים בגללם,"
  },
  {
   "start": 575.32,
   "end": 579.74,
   "text": "אפילו שהם חטאו וטימאו נפשות של צדיקים במאכלים טמאים,"
  },
  {
   "start": 580.18,
   "end": 583.92,
   "text": "הקב' ברוך הוא רחמן ונותן דרך תשובה לכל אחד,"
  },
  {
   "start": 584.66,
   "end": 585.34,
   "text": "גם לאנשים כאלו."
  },
  {
   "start": 587.26,
   "end": 589.7,
   "text": "חייב אני למצוא להם דרך תשובה, כבוד בית הדין,"
  },
  {
   "start": 590.32,
   "end": 591.02,
   "text": "קרא המגלה עמוקות."
  },
  {
   "start": 596.83,
   "end": 602.99,
   "text": "בית הדין דן בדק בכל המקורות האפשריים על מנת להשלים גזר דין,"
  },
  {
   "start": 606.1,
   "end": 609.94,
   "text": "כשנכנסו שני הקצבים להשמעת גזר הדין."
  },
  {
   "start": 612.3,
   "end": 613.08,
   "text": "הם כבר נראו,"
  },
  {
   "start": 614.92,
   "end": 615.74,
   "text": "נראו אומללים."
  },
  {
   "start": 618.69,
   "end": 619.65,
   "text": "קם אב בית הדין"
  },
  {
   "start": 622.55,
   "end": 623.59,
   "text": "המגלה עמוקות"
  },
  {
   "start": 624.53,
   "end": 625.25,
   "text": "ואמר להם,"
  },
  {
   "start": 626.07,
   "end": 628.79,
   "text": "האם אתם מוכנים לקיים את מה שבית דין יגזור?"
  },
  {
   "start": 631.39,
   "end": 633.99,
   "text": "בכל חלוש הם אמרו הכל, את הכל נקיים."
  },
  {
   "start": 638.53,
   "end": 639.41,
   "text": "אז קודם כל,"
  },
  {
   "start": 642.13,
   "end": 643.43,
   "text": "תיתנו עכשיו, לכו הביתה."
  },
  {
   "start": 644.43,
   "end": 647.17,
   "text": "תנו לכל אחד מבני ביתכם, לחתנים שלכם,"
  },
  {
   "start": 648.11,
   "end": 648.75,
   "text": "לכלות שלכם,"
  },
  {
   "start": 649.51,
   "end": 650.43,
   "text": "לבנים-לבנות,"
  },
  {
   "start": 651.11,
   "end": 654.35,
   "text": "לכולם, לנשים שלכם, את כל החפצים שלהם,"
  },
  {
   "start": 654.97,
   "end": 655.95,
   "text": "האישיים שלהם,"
  },
  {
   "start": 656.47,
   "end": 658.11,
   "text": "ושיעזבו את הבית שלכם מיד."
  },
  {
   "start": 659.65,
   "end": 661.53,
   "text": "ורק לכם ולנשים שלכם,"
  },
  {
   "start": 662.75,
   "end": 664.81,
   "text": "תשאירו רק פריטי לבוש בודדים,"
  },
  {
   "start": 665.63,
   "end": 667.85,
   "text": "ואתם הולכים ושרופים את כל הרכוש שלכם,"
  },
  {
   "start": 668.61,
   "end": 669.07,
   "text": "את הכל,"
  },
  {
   "start": 669.65,
   "end": 670.27,
   "text": "גם את הכסף."
  },
  {
   "start": 671.67,
   "end": 673.61,
   "text": "ואפילו בכסף לא לתת צדקה."
  },
  {
   "start": 674.07,
   "end": 675.37,
   "text": "לכו ותשרפו את הכל."
  },
  {
   "start": 677.23,
   "end": 678.55,
   "text": "לכו עכשיו ותעשו את זה."
  },
  {
   "start": 679.29,
   "end": 680.81,
   "text": "ואם תצליחו לעמוד במשימה,"
  },
  {
   "start": 681.25,
   "end": 682.97,
   "text": "תבואו להמשך פסק הדין."
  },
  {
   "start": 686.29,
   "end": 688.43,
   "text": "הם יצאו מבית הדין,"
  },
  {
   "start": 691.67,
   "end": 693.63,
   "text": "והם ביצעו את פסק הדין אחת לאחת."
  },
  {
   "start": 694.91,
   "end": 696.01,
   "text": "חזרו מקץ ימים,"
  },
  {
   "start": 696.63,
   "end": 697.45,
   "text": "הכל כבר שרוף."
  },
  {
   "start": 698.39,
   "end": 699.49,
   "text": "אין רכוש, אין כלום."
  },
  {
   "start": 700.57,
   "end": 701.77,
   "text": "עניים ואומללים."
  },
  {
   "start": 704.9,
   "end": 706.58,
   "text": "קם אב בית הדין ואמר להם, עכשיו,"
  },
  {
   "start": 707.12,
   "end": 709.26,
   "text": "כששרפתם ונשארתם חסרי כול,"
  },
  {
   "start": 710.42,
   "end": 711.56,
   "text": "לכו תקבצו נדבות,"
  },
  {
   "start": 712.6,
   "end": 716.88,
   "text": "בכסף תקנו לכם בגדים ותשרפו גם את הבגדים שעליכם,"
  },
  {
   "start": 717.48,
   "end": 718.92,
   "text": "כי גם הם אסורים בהנאה."
  },
  {
   "start": 720.64,
   "end": 722.96,
   "text": "שום דבר שלכם אסור בהנאה,"
  },
  {
   "start": 723.8,
   "end": 724.5,
   "text": "ואז תחזרו אליי."
  },
  {
   "start": 726.26,
   "end": 726.72,
   "text": "הם הלכו,"
  },
  {
   "start": 727.94,
   "end": 728.86,
   "text": "אספו קצת כסף,"
  },
  {
   "start": 730.76,
   "end": 732.8,
   "text": "קנו בגדים ושרפו את הבגדים הישנים שלהם."
  },
  {
   "start": 733.96,
   "end": 734.5,
   "text": "אחרי זה הם חזרו."
  },
  {
   "start": 735.42,
   "end": 739.6,
   "text": "כשהם חזרו, קם הרב המגלה עמוקות ופרץ בבכי ואמר,"
  },
  {
   "start": 740.16,
   "end": 741.58,
   "text": "תראו כמה קדושים ישראל."
  },
  {
   "start": 742.46,
   "end": 745.12,
   "text": "מי היה מוכן מכל אומות העולם לעשות ככה?"
  },
  {
   "start": 745.8,
   "end": 747.66,
   "text": "פורע עולם כדי לבוא אליך נקיים."
  },
  {
   "start": 748.42,
   "end": 749.74,
   "text": "תראה את עם ישראל קדושים."
  },
  {
   "start": 761.71,
   "end": 763.13,
   "text": "ואז אמר הרב בקול שבור,"
  },
  {
   "start": 764.95,
   "end": 769.53,
   "text": "כשם שינכם סובלים, תדעו לכם, גם אני סובל."
  },
  {
   "start": 770.47,
   "end": 771.79,
   "text": "גם אני סובל בשיא גופין,"
  },
  {
   "start": 772.45,
   "end": 773.03,
   "text": "ללא שינה."
  },
  {
   "start": 774.01,
   "end": 776.65,
   "text": "אבל אני חייב להוציא אתכם מהדין הנורא הממתין לכם."
  },
  {
   "start": 777.73,
   "end": 781.17,
   "text": "לכן חובה עלינו להמשיך הלאה בביצוע פסק הדין."
  },
  {
   "start": 782.27,
   "end": 782.83,
   "text": "אתם מוכנים?"
  },
  {
   "start": 783.95,
   "end": 785.13,
   "text": "אמרו לו כן, כבוד הרב."
  },
  {
   "start": 786.79,
   "end": 789.33,
   "text": "אמר להם עכשיו עליכם לעבור בבית הכנסת של קרקוב,"
  },
  {
   "start": 790.31,
   "end": 793.39,
   "text": "לעלות על הבמה שם ולהתוודות על כל החטאים שלכם,"
  },
  {
   "start": 794.47,
   "end": 796.89,
   "text": "ועל זה שגרמתם מגפות ומיתות"
  },
  {
   "start": 797.53,
   "end": 801.89,
   "text": "ליקירי העיר ולבקש מחילה עד שימחלו לכם."
  },
  {
   "start": 802.89,
   "end": 803.25,
   "text": "וככה"
  },
  {
   "start": 803.83,
   "end": 804.99,
   "text": "תתבזו לעיני כולם."
  },
  {
   "start": 805.99,
   "end": 808.21,
   "text": "אחר כך תצטרכו לצאת לבית הקברות,"
  },
  {
   "start": 808.63,
   "end": 811.77,
   "text": "ושמה לבקש מחילה מהנפטרים במגפות."
  },
  {
   "start": 812.85,
   "end": 815.05,
   "text": "ומאותם צדיקים שנפטרו בינתיים,"
  },
  {
   "start": 815.69,
   "end": 819.01,
   "text": "וכשעלו למעלה התברר להם שהם פגמו במאכלים טמאים."
  },
  {
   "start": 821.25,
   "end": 823.49,
   "text": "ולא רק זה, אחרי שתעשו את כל זה,"
  },
  {
   "start": 824.03,
   "end": 825.77,
   "text": "תצאו לשלוש שנים של גלות."
  },
  {
   "start": 826.61,
   "end": 829.73,
   "text": "שלוש שנים בהם לא תישנו במקום אחד יותר מ-24 שעות,"
  },
  {
   "start": 830.37,
   "end": 832.17,
   "text": "חוץ משבת ויום טוב."
  },
  {
   "start": 832.75,
   "end": 835.53,
   "text": "בכל מקום שתגיעו, תספרו בדיוק מה קרה איתכם."
  },
  {
   "start": 836.25,
   "end": 837.09,
   "text": "תלכו לבית כנסת,"
  },
  {
   "start": 837.49,
   "end": 839.61,
   "text": "תעלו שם על הבמה ותספרו את הסיפור שלכם."
  },
  {
   "start": 843.16,
   "end": 844.32,
   "text": "ואחרי שלוש שנים תחזרו."
  },
  {
   "start": 845.86,
   "end": 846.9,
   "text": "אם אני אהיה בין החיים,"
  },
  {
   "start": 847.56,
   "end": 848.7,
   "text": "אני אסביר לכם מה לעשות."
  },
  {
   "start": 849.68,
   "end": 850.58,
   "text": "אם לא אהיה בין החיים,"
  },
  {
   "start": 851.22,
   "end": 853.76,
   "text": "אני אשאיר מכתב לממלא המקום שלי."
  },
  {
   "start": 867.99,
   "end": 870.35,
   "text": "העיר קרקוב הוכתה בהלם,"
  },
  {
   "start": 872.57,
   "end": 873.95,
   "text": "גל של תשובה וקבלות,"
  },
  {
   "start": 874.61,
   "end": 875.91,
   "text": "להתחזק בשמירת כשרות."
  },
  {
   "start": 877.79,
   "end": 878.77,
   "text": "עכשיו הובן הכול,"
  },
  {
   "start": 879.79,
   "end": 883.37,
   "text": "וידוים הנורא של שני בעלי התשובה חולל רעש עצום בקרקוב."
  },
  {
   "start": 884.35,
   "end": 887.27,
   "text": "היו שביזו אותם, היו שריחמו עליהם,"
  },
  {
   "start": 887.89,
   "end": 889.59,
   "text": "אבל איש לא יכל להישאר אדיש."
  },
  {
   "start": 890.07,
   "end": 891.53,
   "text": "איש לא יוכל להישאר אדיש."
  },
  {
   "start": 903.27,
   "end": 915.57,
   "text": "וכשהם סיימו את מסע הביזיונות, שלא היה קל, הרבה אנשים לא השלימו עם זה. להרבה אנשים היה קשה להאמין, קשה להבין שאותם שניים אלה שגורמים,"
  },
  {
   "start": 915.93,
   "end": 917.47,
   "text": "אלה הם אלה שגרמו לכל המגפות."
  },
  {
   "start": 918.63,
   "end": 919.71,
   "text": "אבל הם עמדו בזה בכבוד."
  },
  {
   "start": 920.35,
   "end": 922.27,
   "text": "והם יצאו לשלוש שנים של גלות,"
  },
  {
   "start": 924.62,
   "end": 925.42,
   "text": "כשהם מבינים,"
  },
  {
   "start": 926.64,
   "end": 928.76,
   "text": "כשהם מבינים שמה שהאדם עובר בעולם,"
  },
  {
   "start": 929.58,
   "end": 930.28,
   "text": "גם את כל הקשיים,"
  },
  {
   "start": 930.6,
   "end": 931.06,
   "text": "את הכל,"
  },
  {
   "start": 931.6,
   "end": 933.86,
   "text": "זה הכל מהשם יתברך לטובת האדם,"
  },
  {
   "start": 934.22,
   "end": 935.22,
   "text": "לנקות את האדם,"
  },
  {
   "start": 935.76,
   "end": 937.52,
   "text": "כי את אשר יאהב השם יוכיח,"
  },
  {
   "start": 938.18,
   "end": 941.16,
   "text": "והם מוכנים לקבל את זה כדי למרק את החטאים שלהם,"
  },
  {
   "start": 941.54,
   "end": 943.46,
   "text": "וזה מה שנותן להם כוחות עצומים להחזיק,"
  },
  {
   "start": 944.0,
   "end": 945.62,
   "text": "להחזיק בית כנסת אחרי בית כנסת,"
  },
  {
   "start": 946.2,
   "end": 946.96,
   "text": "עיר אחרי עיר."
  },
  {
   "start": 947.48,
   "end": 949.6,
   "text": "זה לא היה קל, זה קשה, זה איום."
  },
  {
   "start": 950.16,
