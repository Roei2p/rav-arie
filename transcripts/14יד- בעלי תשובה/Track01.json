{
 "disc": "14יד- בעלי תשובה",
 "track": "Track01",
 "duration": 672.168,
 "segments": [
  {
   "start": 2.83,
   "end": 3.05,
   "text": "קרקוב."
  },
  {
   "start": 5.85,
   "end": 6.57,
   "text": "שני הילדים."
  },
  {
   "start": 8.37,
   "end": 9.51,
   "text": "שני הילדים היו יתומים."
  },
  {
   "start": 10.97,
   "end": 11.61,
   "text": "בלי אבא,"
  },
  {
   "start": 12.81,
   "end": 13.59,
   "text": "גם בלי אימא."
  },
  {
   "start": 15.43,
   "end": 16.15,
   "text": "שני יתומים שגדלו,"
  },
  {
   "start": 20.97,
   "end": 24.49,
   "text": "גדלו וגדלו אצל אחד מקצבי קרקוב."
  },
  {
   "start": 27.38,
   "end": 27.9,
   "text": "הקצב,"
  },
  {
   "start": 28.78,
   "end": 33.1,
   "text": "הקצב הוא לא התכוון להפסיד מכך שהוא אסף אל הבית שלו שני יתומים."
  },
  {
   "start": 36.15,
   "end": 37.73,
   "text": "בשר כשר וליקר."
  },
  {
   "start": 38.95,
   "end": 40.63,
   "text": "בשר כשר רק עשירים קונים."
  },
  {
   "start": 41.59,
   "end": 43.77,
   "text": "והעשירים רוצים משלוח אל בית הלקוח,"
  },
  {
   "start": 45.73,
   "end": 48.89,
   "text": "אז הילדים האלה יספקו את השירות הזה."
  },
  {
   "start": 50.92,
   "end": 52.46,
   "text": "שני היתומים עבדו בפרך,"
  },
  {
   "start": 54.53,
   "end": 55.65,
   "text": "קמים לפנות בוקר."
  },
  {
   "start": 56.37,
   "end": 56.95,
   "text": "שיא הקור!"
  },
  {
   "start": 58.85,
   "end": 59.57,
   "text": "לא תפילה,"
  },
  {
   "start": 60.73,
   "end": 61.97,
   "text": "גם לא ארוחת בוקר."
  },
  {
   "start": 63.95,
   "end": 64.81,
   "text": "ישר לאתליז,"
  },
  {
   "start": 65.91,
   "end": 66.65,
   "text": "הפשטת אורות,"
  },
  {
   "start": 67.57,
   "end": 68.09,
   "text": "חיתוך,"
  },
  {
   "start": 68.75,
   "end": 69.39,
   "text": "ניקוי,"
  },
  {
   "start": 70.39,
   "end": 73.89,
   "text": "העמסת סלים עם עשרות קילוגרם למשלוח."
  },
  {
   "start": 75.45,
   "end": 77.25,
   "text": "כעבור כמה שעות הם חוזרים עם הכסף."
  },
  {
   "start": 78.51,
   "end": 79.55,
   "text": "שני ילדים קטנים,"
  },
  {
   "start": 80.11,
   "end": 82.13,
   "text": "שהחיים לא מאירים להם פנים."
  },
  {
   "start": 83.85,
   "end": 85.93,
   "text": "וכשהם חוזרים עם הכסף, רק אז,"
  },
  {
   "start": 86.57,
   "end": 87.77,
   "text": "רק אז הם זוכים"
  },
  {
   "start": 88.85,
   "end": 89.93,
   "text": "למנת אוכל דלה."
  },
  {
   "start": 93.28,
   "end": 94.6,
   "text": "אני לא יודע אם אפשר לקרוא לזה אוכל,"
  },
  {
   "start": 95.58,
   "end": 96.58,
   "text": "אבל זה מה שהם אכלו."
  },
  {
   "start": 101.95,
   "end": 102.85,
   "text": "עיכוב בעבודה?"
  },
  {
   "start": 103.91,
   "end": 104.51,
   "text": "אם היו מתעכבים,"
  },
  {
   "start": 105.47,
   "end": 107.59,
   "text": "זה היה גורר מכות,"
  },
  {
   "start": 108.91,
   "end": 109.61,
   "text": "מכות כואבות."
  },
  {
   "start": 111.31,
   "end": 113.37,
   "text": "ואולי הכאב יותר גדול כשאין לך אבא ואימא,"
  },
  {
   "start": 113.95,
   "end": 115.23,
   "text": "אין לך כתף להישיין עליה."
  },
  {
   "start": 116.75,
   "end": 118.05,
   "text": "בקשת אוכל מופרזת,"
  },
  {
   "start": 119.03,
   "end": 121.01,
   "text": "או בקשת אוכל קצת לפני הזמן,"
  },
  {
   "start": 121.99,
   "end": 123.59,
   "text": "הייתה גוררת גם היא מכות."
  },
  {
   "start": 128.22,
   "end": 129.92,
   "text": "כילד הם רצו לבכות, אבל..."
  },
  {
   "start": 131.52,
   "end": 132.96,
   "text": "אבל לא ידעו אם יש למי."
  },
  {
   "start": 135.84,
   "end": 142.62,
   "text": "תנאי החיים שלהם היו עם חוסר שינה כרוני."
  },
  {
   "start": 143.72,
   "end": 144.46,
   "text": "ללא תורה,"
  },
  {
   "start": 145.28,
   "end": 147.88,
   "text": "ללא בית ספר, ללא תלמוד תורה,"
  },
  {
   "start": 148.58,
   "end": 149.68,
   "text": "ואפילו לא תפילה."
  },
  {
   "start": 150.56,
   "end": 150.84,
   "text": "כלום."
  },
  {
   "start": 156.2,
   "end": 157.64,
   "text": "כך הם גודלים, מתחילים להתבגר."
  },
  {
   "start": 160.82,
   "end": 162.7,
   "text": "חשים כל הזמן מושפלים,"
  },
  {
   "start": 163.78,
   "end": 165.3,
   "text": "בודדים ומבודדים,"
  },
  {
   "start": 165.94,
   "end": 167.22,
   "text": "נראים מאוד מאוד גרוע."
  },
  {
   "start": 169.08,
   "end": 170.68,
   "text": "וכולם, כולם מתרחקים מהם."
  },
  {
   "start": 174.26,
   "end": 175.64,
   "text": "ומה כואב יותר מכול?"
  },
  {
   "start": 176.32,
   "end": 177.46,
   "text": "הם היו מודעים למצב שלהם,"
  },
  {
   "start": 178.34,
   "end": 179.12,
   "text": "למצב הקשה."
  },
  {
   "start": 180.26,
   "end": 180.82,
   "text": "בלילה,"
  },
  {
   "start": 180.98,
   "end": 183.74,
   "text": "בלילה הם למדו לבכות,"
  },
  {
   "start": 184.34,
   "end": 186.34,
   "text": "לבכות על המשכב שלהם שם, הדל,"
  },
  {
   "start": 187.64,
   "end": 188.5,
   "text": "על הכרית"
  },
  {
   "start": 189.3,
   "end": 190.22,
   "text": "הבלויה שלהם,"
  },
  {
   "start": 191.1,
   "end": 192.34,
   "text": "דמעות של יתומים,"
  },
  {
   "start": 193.26,
   "end": 194.96,
   "text": "דמעות של יתומים חסרי ישע."
  },
  {
   "start": 206.16,
   "end": 207.26,
   "text": "זה יכל להמשיך כך"
  },
  {
   "start": 208.1,
   "end": 209.4,
   "text": "אני לא יודע עד כמה."
  },
  {
   "start": 211.46,
   "end": 214.79,
   "text": "אבל יום אחד זה קרה."
  },
  {
   "start": 215.77,
   "end": 219.25,
   "text": "יום אחד אחד מהנערים מצא מטבע."
  },
  {
   "start": 222.29,
   "end": 224.11,
   "text": "מה הוא יכול לעשות עם המטבע? הוא חשב."
  },
  {
   "start": 225.27,
   "end": 226.69,
   "text": "הדבר היחיד שהוא הכיר זה בשר."
  },
  {
   "start": 228.87,
   "end": 230.71,
   "text": "לבטא הבזיק פה רעיון."
  },
  {
   "start": 234.81,
   "end": 236.83,
   "text": "הוא ידע שבשר טרף"
  },
  {
   "start": 238.25,
   "end": 239.03,
   "text": "עולה זול."
  },
  {
   "start": 243.73,
   "end": 248.79,
   "text": "אז מה יקרה אם אני אלך ואני אקנה לי בשר טרף במטבעה הזאת שמצאתי,"
  },
  {
   "start": 249.65,
   "end": 255.43,
   "text": "ואני אמכור אותה כבשר מהדרין במסגרת המשלוחים שלי? מי ידע?"
  },
  {
   "start": 259.57,
   "end": 262.03,
   "text": "כמה שעות אחר כך הוא יהיה עם סכון קצת"
  },
  {
   "start": 263.25,
   "end": 264.81,
   "text": "בשבילו לא מבוטל בכיס"
  },
  {
   "start": 265.45,
   "end": 266.35,
   "text": "בלי שאף אחד יודע."
  },
  {
   "start": 267.97,
   "end": 270.91,
   "text": "סוף סוף הוא יכל להרשות לעצמו לאכול אוכל,"
  },
  {
   "start": 271.57,
   "end": 272.31,
   "text": "אוכל אמיתי."
  },
  {
   "start": 273.93,
   "end": 276.85,
   "text": "הוא מזמין את היתום השני,"
  },
  {
   "start": 277.59,
   "end": 278.77,
   "text": "את החבר שלו השני,"
  },
  {
   "start": 281.61,
   "end": 282.47,
   "text": "למנה עגונה."
  },
  {
   "start": 288.16,
   "end": 289.2,
   "text": "נשאר לו עוד קצת כסף,"
  },
  {
   "start": 290.02,
   "end": 292.64,
   "text": "והוא שוב ממשיך לקנות בשר טרף,"
  },
  {
   "start": 293.92,
   "end": 295.76,
   "text": "ואף אחד לא יודע שהוא מוכר אותו כמהדרין."
  },
  {
   "start": 300.14,
   "end": 302.12,
   "text": "רק היתום השני, החבר שלו,"
  },
  {
   "start": 302.7,
   "end": 304.34,
   "text": "מתחיל לחשוד שמשהו לא בסדר."
  },
  {
   "start": 307.02,
   "end": 308.28,
   "text": "כשהוא שואל יותר מדי,"
  },
  {
   "start": 312.29,
   "end": 314.21,
   "text": "הוא מוצא את עצמו אחרי כמה זמן שותף."
  },
  {
   "start": 315.39,
   "end": 315.99,
   "text": "ושניהם,"
  },
  {
   "start": 317.41,
   "end": 319.95,
   "text": "בסכומי הכסף שהתחילו לגדול בכיסם,"
  },
  {
   "start": 320.55,
   "end": 324.99,
   "text": "קונים טרף מהנוצרים וממשיכים למכור כמהדרין,"
  },
  {
   "start": 325.55,
   "end": 326.13,
   "text": "עוד קצת תוספת."
  },
  {
   "start": 327.29,
   "end": 332.05,
   "text": "אם קודם הם מכרו 20 קילו מטעם מייטיז היה להם כבר 30 קילו,"
  },
  {
   "start": 332.47,
   "end": 335.87,
   "text": "10 קילו הם מכרו קצת יותר בזול בשר לכאורה מהדרין."
  },
  {
   "start": 337.01,
   "end": 337.95,
   "text": "והרווחים גודלים,"
  },
  {
   "start": 341.71,
   "end": 343.89,
   "text": "והחלום שלהם מתחיל לרקום עור וגידים."
  },
  {
   "start": 344.21,
   "end": 347.17,
   "text": "אולי יום אחד הם יוכלו לשנות את המציאות המרה של החיים שלהם."
  },
  {
   "start": 347.97,
   "end": 349.73,
   "text": "יום אחד הם יוכלו לעזוב את האתליז הזה."
  },
  {
   "start": 350.21,
   "end": 350.69,
   "text": "ואולי,"
  },
  {
   "start": 351.45,
   "end": 354.05,
   "text": "אולי לפתוח את האתליז משלהם?"
  },
  {
   "start": 358.36,
   "end": 359.22,
   "text": "כשאחד מהם התנהג,"
  },
  {
   "start": 360.86,
   "end": 363.64,
   "text": "התחיל להתנהג לא כשורה, ולבסוף הוא עף"
  },
  {
   "start": 366.28,
   "end": 367.24,
   "text": "על ידי אותו קצב"
  },
  {
   "start": 368.38,
   "end": 371.78,
   "text": "ועבר לאתליז אחר בקצה השני, אף אחד לא חשב שזה מבוים."
  },
  {
   "start": 372.54,
   "end": 374.74,
   "text": "אף אחד לא חשב שזה פרי התכנון של שני היתומים,"
  },
  {
   "start": 375.2,
   "end": 375.96,
   "text": "אותם אומללים."
  },
  {
   "start": 376.76,
   "end": 381.32,
   "text": "וכך הם עובדים בשני קצוות העיר ומתחלקים ברווחים."
  },
  {
   "start": 382.72,
   "end": 383.1,
   "text": "ככה זה."
  },
  {
   "start": 383.62,
   "end": 385.08,
   "text": "בהתחלה עושים משהו קצת חוששים,"
  },
  {
   "start": 385.58,
   "end": 387.06,
   "text": "עושים פה עבירה, שם עבירה,"
  },
  {
   "start": 387.48,
   "end": 388.76,
   "text": "אחר כך זה נהיה כהרגל."
  },
  {
   "start": 390.86,
   "end": 391.9,
   "text": "כך עוברים להם החודשים,"
  },
  {
   "start": 392.6,
   "end": 395.46,
   "text": "וכשהם חסכו להם סכום כסף די רציני,"
  },
  {
   "start": 398.56,
   "end": 400.18,
   "text": "הם פתחו להם אטליז משלהם."
  },
  {
   "start": 401.22,
   "end": 403.94,
   "text": "באטליז הם היו קונים עגלים כשרים ביום,"
  },
  {
   "start": 404.72,
   "end": 405.32,
   "text": "בלילה,"
  },
  {
   "start": 405.32,
   "end": 410.22,
   "text": "הם היו קונים בזול עגלים של טרפות,"
  },
  {
   "start": 410.88,
   "end": 411.34,
   "text": "נבלות,"
  },
  {
   "start": 412.02,
   "end": 414.88,
   "text": "מערבבים הכל ומוכרים בהנחה."
  },
  {
   "start": 426.81,
   "end": 427.57,
   "text": "השנים חולפות להם."
  },
  {
   "start": 431.77,
   "end": 433.67,
   "text": "איטליז אחרי איטליז נסגרים."
  },
  {
   "start": 434.55,
   "end": 435.69,
   "text": "אי אפשר לעמוד בתחרות."
  },
  {
   "start": 436.65,
   "end": 437.49,
   "text": "יש רק איטליז אחד"
  },
  {
   "start": 438.21,
   "end": 441.05,
   "text": "שמתעלה וממשיך הלאה פורץ קדימה."
  },
  {
   "start": 441.45,
   "end": 442.87,
   "text": "המוניטין שלו גדל מיום ליום."
  },
  {
   "start": 443.71,
   "end": 444.93,
   "text": "אותו איטליז של שני היתומים."
  },
  {
   "start": 445.75,
   "end": 446.65,
   "text": "העסקים מתרחבים,"
  },
  {
   "start": 447.57,
   "end": 450.73,
   "text": "ואט-אט הם נהפכים לאנשים מכובדים,"
  },
  {
   "start": 451.39,
   "end": 452.49,
   "text": "לאנשים עשירים."
  },
  {
   "start": 453.29,
   "end": 454.39,
   "text": "כבר שכחו מהיכן באו."
  },
  {
   "start": 456.11,
   "end": 457.09,
   "text": "אבל דבר אחד הם לא שכחו,"
  },
  {
   "start": 458.57,
   "end": 459.97,
   "text": "לתת צדקה, לעזור."
  },
  {
   "start": 462.19,
   "end": 464.23,
   "text": "את זה הם ידעו טוב מאוד, הם חוו את זה על בשרם."
  },
  {
   "start": 465.19,
   "end": 466.91,
   "text": "והם נהפכים לאנשי צדקה וחסד"
  },
  {
   "start": 468.03,
   "end": 469.09,
   "text": "מדרגה ראשונה."
  },
  {
   "start": 471.41,
   "end": 474.81,
   "text": "ככה הם נחשבים, עשירים, מכובדים, אנשי צדקה וחסד."
  },
  {
   "start": 475.43,
   "end": 475.91,
   "text": "אבל בלילה,"
  },
  {
   "start": 476.55,
   "end": 479.15,
   "text": "בלילה הם עובדים במחסן הסתר שלהם,"
  },
  {
   "start": 480.13,
   "end": 481.31,
   "text": "עם הבשר, בשר הטרף,"
  },
  {
   "start": 482.69,
   "end": 484.03,
   "text": "עם כל הנבלות והטרפות."
  },
  {
   "start": 485.79,
   "end": 489.05,
   "text": "לא מדמיינים שכאשר אדם רוצה לחטאו,"
  },
  {
   "start": 489.91,
   "end": 491.13,
   "text": "כאשר אדם רוצה"
  },
  {
   "start": 491.93,
   "end": 493.33,
   "text": "לעשות הרע בעיני ה',"
  },
  {
   "start": 493.85,
   "end": 496.67,
   "text": "בא היצר רע ונותן לו כוח, נותן לו להצליח."
  },
  {
   "start": 505.4,
   "end": 505.98,
   "text": "בינתיים,"
  },
  {
   "start": 506.74,
   "end": 507.8,
   "text": "בצד השני של העיר,"
  },
  {
   "start": 508.4,
   "end": 508.88,
   "text": "רב העיר,"
  },
  {
   "start": 509.58,
   "end": 510.92,
   "text": "רבי נתן נטע שפירא,"
  },
  {
   "start": 511.7,
   "end": 516.92,
   "text": "זכר צדיק וקדוש לברכה, איש אלוקים קדוש, בעל המגלה עמוקות,"
  },
  {
   "start": 517.62,
   "end": 519.5,
   "text": "המגלה עמוקות רבי נתן נטע שפירא,"
  },
  {
   "start": 520.24,
   "end": 521.18,
   "text": "בעל עיניים בהירות,"
  },
  {
   "start": 522.42,
   "end": 524.98,
   "text": "בעל עיניים קדושות שרועות למרחקים."
  },
  {
   "start": 526.48,
   "end": 527.7,
   "text": "אבל היצר רע."
  },
  {
   "start": 528.7,
   "end": 531.0,
   "text": "במקרה הזה כיסה את עיניו בדוק של ערפל,"
  },
  {
   "start": 531.78,
   "end": 535.0,
   "text": "והוא לא חש במעשים המזעזעים הנעשים בעירו."
  },
  {
   "start": 549.18,
   "end": 549.68,
   "text": "קרקוב"
  },
  {
   "start": 550.54,
   "end": 552.02,
   "text": "הייתה אבלה וחפוית ראש."
  },
  {
   "start": 553.58,
   "end": 555.22,
   "text": "מכת מגפות נוראה פקדה אותה."
  },
  {
   "start": 556.12,
   "end": 557.4,
   "text": "מבוגרים נהרגים,"
  },
  {
   "start": 558.02,
   "end": 559.62,
   "text": "ילדים קטנים נפטרים,"
  },
  {
   "start": 560.16,
   "end": 561.28,
   "text": "משפחות אומללות."
  },
  {
   "start": 562.7,
   "end": 564.24,
   "text": "ואיש מהקהילה היהודית לא מבין."
  },
  {
   "start": 564.82,
   "end": 566.94,
   "text": "אנחנו בני תורה, אנחנו מקיימים מצוות."
  },
  {
   "start": 567.52,
   "end": 567.98,
   "text": "מה קורה כאן?"
  },
  {
   "start": 568.76,
   "end": 569.46,
   "text": "מה קורה כאן?"
  },
  {
   "start": 571.68,
   "end": 572.36,
   "text": "בית הקברות"
  },
  {
   "start": 573.68,
   "end": 576.92,
   "text": "כבר קטן מלאכלס את הכמויות הגדולות של הנפגעים,"
  },
  {
   "start": 577.78,
   "end": 578.64,
   "text": "וכולם מחפשים."
  },
  {
   "start": 579.36,
   "end": 582.68,
   "text": "כולם תרים אחר תרופה, אחר פתרון למוות הזה."
  },
  {
   "start": 585.45,
   "end": 586.05,
   "text": "מטענים,"
  },
  {
   "start": 586.59,
   "end": 587.17,
   "text": "תפילות."
  },
  {
   "start": 588.35,
   "end": 589.35,
   "text": "זה מקל על המגפות."
  },
  {
   "start": 590.45,
   "end": 591.33,
   "text": "קצת יורד הכמות."
  },
  {
   "start": 592.87,
   "end": 593.81,
   "text": "יורדת לה הכמות,"
  },
  {
   "start": 594.71,
   "end": 595.33,
   "text": "אבל זה לא מספיק,"
  },
  {
   "start": 599.96,
   "end": 604.0,
   "text": "ואיש מאנשי העיר לא יודע שכל הזמן הזה"
  },
  {
   "start": 604.82,
   "end": 607.42,
   "text": "מדיר המגלה עמוקות שינה מעיניו."
  },
  {
   "start": 608.56,
   "end": 609.12,
   "text": "הוא חש,"
  },
  {
   "start": 609.9,
   "end": 612.52,
   "text": "הוא חש שבאיזה מקום בוערת לה אש זרה."
  },
  {
   "start": 613.74,
   "end": 616.34,
   "text": "מדי פעם הוא יוצא אל פתח ביתו, בלילות,"
  },
  {
   "start": 618.78,
   "end": 625.3,
   "text": "מנסה להביט, מנסה לטעת להרגיש מהיכן בוערת לה אותה אש זרה,"
  },
  {
   "start": 625.8,
   "end": 626.7,
   "text": "אותה אש לוהטת,"
  },
  {
   "start": 627.16,
   "end": 627.82,
   "text": "אש הזעם."
  },
  {
   "start": 629.76,
   "end": 630.2,
   "text": "מה קורה?"
  },
  {
   "start": 630.72,
   "end": 631.62,
   "text": "מה עובר על העיר?"
  },
  {
   "start": 635.14,
   "end": 637.28,
   "text": "הוא יודע שרק כוח של עבירה נוראה"
  },
  {
   "start": 637.96,
   "end": 641.3,
   "text": "יכולה לפגוע כל כך בזולת ובעולם כולו."
  },
  {
   "start": 646.22,
   "end": 649.44,
   "text": "לבעל המגלה המוכות לא נשאר אלא לעשות דבר אחד."
  },
  {
   "start": 651.77,
   "end": 654.59,
   "text": "והוא בוכה לשם, מבקש מהשם בורא עולם,"
  },
  {
   "start": 655.37,
   "end": 656.21,
   "text": "בורא עולם תענה לי,"
  },
  {
   "start": 656.87,
   "end": 657.51,
   "text": "בורא עולם תן לי,"
  },
  {
   "start": 658.49,
   "end": 658.95,
   "text": "תגלה לי."
  },
  {
   "start": 659.83,
   "end": 660.09,
   "text": "למה?"
  },
  {
   "start": 664.82,
   "end": 665.28,
   "text": "מה קורה פה?"
  },
  {
   "start": 668.31,
   "end": 669.83,
   "text": "היכן בוערת לה אותה אש?"
  },
  {
   "start": 670.67,
   "end": 671.25,
   "text": "אש איומה."
  },
  {
   "start": 671.45,
   "end": 671.55,
   "text": "תודה רבה."
  }
 ]
}