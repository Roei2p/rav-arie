{
 "disc": "14יד- בעלי תשובה",
 "track": "Track05",
 "duration": 927.12,
 "segments": [
  {
   "start": 6.33,
   "end": 7.35,
   "text": "הוא המתין כל השבעה,"
  },
  {
   "start": 9.61,
   "end": 10.59,
   "text": "גם שבוע אחרי זה."
  },
  {
   "start": 11.79,
   "end": 12.61,
   "text": "אבל כלום לא קרה,"
  },
  {
   "start": 15.89,
   "end": 18.03,
   "text": "עד הלילה של, שלאחר השלושים."
  },
  {
   "start": 21.07,
   "end": 22.21,
   "text": "אז התגלה לו השותף בחלום,"
  },
  {
   "start": 26.61,
   "end": 27.41,
   "text": "נראה זוהר,"
  },
  {
   "start": 28.11,
   "end": 29.61,
   "text": "נראה מפיץ אור יקרות,"
  },
  {
   "start": 30.69,
   "end": 32.43,
   "text": "וקולו נשמע נמרץ ונפלא."
  },
  {
   "start": 33.11,
   "end": 33.89,
   "text": "חברי האהוב,"
  },
  {
   "start": 34.65,
   "end": 37.59,
   "text": "בעולם השפל, העולם שלכם השפל,"
  },
  {
   "start": 38.13,
   "end": 43.37,
   "text": "לא יודעים מיהו המגלה עמוקות ששערי השמיים פתוחים בפניו."
  },
  {
   "start": 44.59,
   "end": 45.97,
   "text": "תדע לך, אחי היקר,"
  },
  {
   "start": 46.57,
   "end": 48.05,
   "text": "תדע לך, חברי לצרה,"
  },
  {
   "start": 48.81,
   "end": 51.23,
   "text": "הפחד שלנו היה אמיתי,"
  },
  {
   "start": 52.15,
   "end": 52.81,
   "text": "היה אמיתי."
  },
  {
   "start": 53.89,
   "end": 55.33,
   "text": "כאן אי אפשר, כאן,"
  },
  {
   "start": 55.89,
   "end": 60.45,
   "text": "בעולם הבא אי אפשר לתקן את מה שלא תיקנו בעולם השפל שלכם."
  },
  {
   "start": 62.47,
   "end": 64.27,
   "text": "תדע לך, כשהנשמה שלי יצאה,"
  },
  {
   "start": 65.19,
   "end": 66.27,
   "text": "הקיפו את המזיקים,"
  },
  {
   "start": 67.09,
   "end": 68.33,
   "text": "כחול אשר על שפת הים."
  },
  {
   "start": 69.47,
   "end": 72.43,
   "text": "איזה מראה היום מפחיד, מיליוני קליפות,"
  },
  {
   "start": 72.95,
   "end": 73.75,
   "text": "מלאכי חבלה,"
  },
  {
   "start": 74.57,
   "end": 75.19,
   "text": "והתחושה,"
  },
  {
   "start": 75.77,
   "end": 76.65,
   "text": "התחושה הייתה פחד,"
  },
  {
   "start": 77.33,
   "end": 77.59,
   "text": "פחד,"
  },
  {
   "start": 78.11,
   "end": 78.63,
   "text": "איך אני אסביר?"
  },
  {
   "start": 79.69,
   "end": 82.05,
   "text": "כמו שאיזה חיית טרף רודפת אחריך,"
  },
  {
   "start": 82.37,
   "end": 86.19,
   "text": "כאילו איזה, איזה נמר רודף אחריך,"
  },
  {
   "start": 87.13,
   "end": 88.21,
   "text": "ואתה בורח בפחד,"
  },
  {
   "start": 88.95,
   "end": 92.87,
   "text": "וכולם ברעש היום סביבי ממתינים לשנייה הזאת,"
  },
  {
   "start": 93.39,
   "end": 95.73,
   "text": "לאיזה אות לכלות בי את צעמם,"
  },
  {
   "start": 98.03,
   "end": 98.43,
   "text": "ואז,"
  },
  {
   "start": 99.97,
   "end": 101.57,
   "text": "ואז מ-מאנשהו,"
  },
  {
   "start": 101.57,
   "end": 106.85,
   "text": "מאיזה מקום הכריחו ארבעה דמויות מוארות"
  },
  {
   "start": 107.99,
   "end": 109.43,
   "text": "מלאות רוך וחום,"
  },
  {
   "start": 110.89,
   "end": 111.91,
   "text": "תפסו בי, אחזו בי,"
  },
  {
   "start": 112.91,
   "end": 116.01,
   "text": "ומנעו גישה מכל צבאות המזיקים,"
  },
  {
   "start": 117.41,
   "end": 120.35,
   "text": "שניסו למצוא איזה פרצה לתפוס בי,"
  },
  {
   "start": 122.01,
   "end": 123.11,
   "text": "וכך עד שנקברתי."
  },
  {
   "start": 124.97,
   "end": 125.63,
   "text": "וכשנקברתי,"
  },
  {
   "start": 126.89,
   "end": 128.39,
   "text": "באו ארבעה מלאכים אחרים,"
  },
  {
   "start": 129.03,
   "end": 131.47,
   "text": "ולקחו את הנשמה שלי אל על,"
  },
  {
   "start": 131.91,
   "end": 133.13,
   "text": "אל בית דין של מה."
  },
  {
   "start": 137.12,
   "end": 139.24,
   "text": "אתה יודע, בית דין, בבית הדין,"
  },
  {
   "start": 139.82,
   "end": 140.82,
   "text": "יש אור עצום."
  },
  {
   "start": 141.8,
   "end": 145.54,
   "text": "זה יופי שאני לא יכול לתאר לך אותו במילים."
  },
  {
   "start": 146.44,
   "end": 146.64,
   "text": "לא יכול."
  },
  {
   "start": 147.84,
   "end": 150.08,
   "text": "אבל זה יופי שאין כדוגמתו"
  },
  {
   "start": 151.02,
   "end": 151.96,
   "text": "בעולם השפל."
  },
  {
   "start": 153.12,
   "end": 154.64,
   "text": "ושם, בבית הדין של מעלה,"
  },
  {
   "start": 155.2,
   "end": 156.12,
   "text": "באמצע האולם,"
  },
  {
   "start": 156.64,
   "end": 157.92,
   "text": "נמצא שולחן ענק."
  },
  {
   "start": 159.32,
   "end": 161.62,
   "text": "כשלוחשות להם אותיות של אש,"
  },
  {
   "start": 162.52,
   "end": 164.1,
   "text": "תורת משה אמת,"
  },
  {
   "start": 165.14,
   "end": 168.48,
   "text": "תורת משה אמת, לוחשות להם אותיות של אש,"
  },
  {
   "start": 169.14,
   "end": 171.76,
   "text": "ועל השולחן ספר תורה,"
  },
  {
   "start": 172.5,
   "end": 173.78,
   "text": "ספר תורה פתוח."
  },
  {
   "start": 175.56,
   "end": 178.68,
   "text": "ואני תפסתי לי פינה בפחד מה הייתי?"
  },
  {
   "start": 179.6,
   "end": 180.62,
   "text": "עולם האמת."
  },
  {
   "start": 181.58,
   "end": 183.56,
   "text": "בפני בית דין אין שום דבר נסתר."
  },
  {
   "start": 184.16,
   "end": 187.22,
   "text": "ככה הרגשתי, ככה הבנתי, אתה יודע שזו האמת."
  },
  {
   "start": 188.16,
   "end": 189.62,
   "text": "אתה יודע שיודעים הכל עליך."
  },
  {
   "start": 190.56,
   "end": 192.12,
   "text": "הכל פתוח, אי אפשר להסתיר כלום."
  },
  {
   "start": 192.88,
   "end": 196.18,
   "text": "ומי שלא עשה תשובה, השם ירחם."
  },
  {
   "start": 197.5,
   "end": 199.16,
   "text": "כל המפלט שלי, כל הביטחון שלי,"
  },
  {
   "start": 199.6,
   "end": 203.34,
   "text": "הרגשתי שהוא היה נשען על מגנת הקלף של הרב,"
  },
  {
   "start": 203.88,
   "end": 204.86,
   "text": "של המגלה המוכות."
  },
  {
   "start": 209.12,
   "end": 210.06,
   "text": "אז קראו בשם שלי,"
  },
  {
   "start": 211.28,
   "end": 212.64,
   "text": "והוליך אותי לבית הדין,"
  },
  {
   "start": 214.4,
   "end": 217.32,
   "text": "ונפתח לו ספר הזיכרונות."
  },
  {
   "start": 219.04,
   "end": 220.72,
   "text": "ונפתח לו ספר הזיכרונות."
  },
  {
   "start": 229.43,
   "end": 238.56,
   "text": "כל היום נשמע מה הרשע הזה עושה כאן,"
  },
  {
   "start": 239.54,
   "end": 241.2,
   "text": "מה הרשע הזה עושה כאן?"
  },
  {
   "start": 242.02,
   "end": 245.02,
   "text": "כל מדורי הגהנום לא יספיקו בשבילו."
  },
  {
   "start": 245.8,
   "end": 247.68,
   "text": "ואני קפטתי לי, בפחד היום."
  },
  {
   "start": 249.96,
   "end": 250.42,
   "text": "המלחים,"
  },
  {
   "start": 251.02,
   "end": 253.84,
   "text": "המלחים שהיו עוזרים לי, שהתברר שהם הסנגורים שלי,"
  },
  {
   "start": 254.7,
   "end": 255.52,
   "text": "עוררו אותי."
  },
  {
   "start": 257.87,
   "end": 262.71,
   "text": "ואני שמתי כולי רועד את מגילת הקלף של המגלה עמוקות על השולחן."
  },
  {
   "start": 264.23,
   "end": 265.23,
   "text": "ואז נשמע הקול הזה,"
  },
  {
   "start": 265.83,
   "end": 266.45,
   "text": "הקול האיום הזה."
  },
  {
   "start": 267.33,
   "end": 269.61,
   "text": "מה פתאום המגלה העמוקות גוזר,"
  },
  {
   "start": 269.61,
   "end": 272.51,
   "text": "שנפטור נשמה כזו מעונש."
  },
  {
   "start": 274.13,
   "end": 278.73,
   "text": "מה פתאום לפטור נשמה כזו שהאכילה טרפות עשרות שנים?"
  },
  {
   "start": 279.57,
   "end": 280.59,
   "text": "לא בא בחשבון."
  },
  {
   "start": 283.07,
   "end": 285.97,
   "text": "לא בא בחשבון זעק הקול האיום והנורא."
  },
  {
   "start": 287.33,
   "end": 288.73,
   "text": "והסנגורי מצד שני,"
  },
  {
   "start": 289.19,
   "end": 290.81,
   "text": "איך אנו מפרטים את תהליך התשובה?"
  },
  {
   "start": 291.77,
   "end": 292.33,
   "text": "את מה שעשינו,"
  },
  {
   "start": 293.15,
   "end": 296.17,
   "text": "את שרפת הרכוש שלנו, שרפנו את כל הכסף, את הכול."
  },
  {
   "start": 296.79,
   "end": 299.31,
   "text": "את הווידוי לפני כולם, את הביזיונות,"
  },
  {
   "start": 299.89,
   "end": 300.59,
   "text": "את הגלות,"
  },
  {
   "start": 301.11,
   "end": 304.21,
   "text": "הם בעלי תשובה, הם בעלי תשובה!"
  },
  {
   "start": 307.0,
   "end": 308.44,
   "text": "אבל זה לא נגמר כל כך מהר."
  },
  {
   "start": 312.39,
   "end": 313.75,
   "text": "מצד שמאל נשמע שוב,"
  },
  {
   "start": 314.53,
   "end": 315.71,
   "text": "שוב הקול המצמרר."
  },
  {
   "start": 317.07,
   "end": 319.35,
   "text": "בואו תראו מה נשמה זו חוללה!"
  },
  {
   "start": 320.15,
   "end": 322.39,
   "text": "בואו תראו מה נשמה זו חוללה!"
  },
  {
   "start": 328.07,
   "end": 328.95,
   "text": "ומכל עבר"
  },
  {
   "start": 330.47,
   "end": 331.09,
   "text": "הגיחו"
  },
  {
   "start": 331.83,
   "end": 332.77,
   "text": "אלפי נשמות,"
  },
  {
   "start": 333.79,
   "end": 335.99,
   "text": "מייללות ובוכות."
  },
  {
   "start": 337.45,
   "end": 339.99,
   "text": "בגללו אני נפטרתי ללא תשובה."
  },
  {
   "start": 341.05,
   "end": 343.03,
   "text": "בגללו נפטרתי ללא תשובה."
  },
  {
   "start": 346.27,
   "end": 347.27,
   "text": "לפתע נשמעו זעקות,"
  },
  {
   "start": 347.95,
   "end": 348.99,
   "text": "אנחנו ילדים קטנים,"
  },
  {
   "start": 349.39,
   "end": 350.93,
   "text": "יכלנו להיות גדולי תורה,"
  },
  {
   "start": 351.45,
   "end": 352.17,
   "text": "אם לא הוא,"
  },
  {
   "start": 352.55,
   "end": 352.89,
   "text": "הוא,"
  },
  {
   "start": 353.25,
   "end": 354.39,
   "text": "הוא גרם לנו למות."
  },
  {
   "start": 355.85,
   "end": 359.23,
   "text": "אני אימא צעירה, הבן שלי יתום בגללו."
  },
  {
   "start": 360.13,
   "end": 362.91,
   "text": "הבן שלי למטה יתום וסובל בגללו."
  },
  {
   "start": 363.33,
   "end": 364.19,
   "text": "זעקה נשמה אחרת."
  },
  {
   "start": 365.75,
   "end": 366.25,
   "text": "ואני,"
  },
  {
   "start": 366.67,
   "end": 372.73,
   "text": "אני נשרפת מצער כשאני שומעת על הצער של הבנים שלי שנשארו ללא אימא."
  },
  {
   "start": 373.71,
   "end": 374.65,
   "text": "בגללו!"
  },
  {
   "start": 377.39,
   "end": 378.97,
   "text": "והקולות מקיפים אותי."
  },
  {
   "start": 380.39,
   "end": 381.17,
   "text": "ואני נזכר רק"
  },
  {
   "start": 383.35,
   "end": 384.63,
   "text": "בפסוק אחד"
  },
  {
   "start": 385.49,
   "end": 389.21,
   "text": "פלגי מים ירדו עיניי הלא שמרו תורתך."
  },
  {
   "start": 389.91,
   "end": 390.89,
   "text": "ואני מתחיל לבכות."
  },
  {
   "start": 391.49,
   "end": 392.19,
   "text": "פלגי מים"
  },
  {
   "start": 393.05,
   "end": 395.71,
   "text": "ירדו עיניי הלא שמרו תורתך."
  },
  {
   "start": 396.41,
   "end": 397.47,
   "text": "והקולות מקיפים אותי."
  },
  {
   "start": 397.85,
   "end": 398.21,
   "text": "הקולות האלה."
  },
  {
   "start": 398.67,
   "end": 399.37,
   "text": "והפתע עוד נשמה."
  },
  {
   "start": 400.01,
   "end": 402.45,
   "text": "כל חיי שמרתי תורה ומצוות בדין."
  },
  {
   "start": 402.91,
   "end": 406.11,
   "text": "וכשהובאתי לכאן התברר לי הפסד נצרי,"
  },
  {
   "start": 406.11,
   "end": 407.45,
   "text": "הפסדתי בגללו,"
  },
  {
   "start": 407.91,
   "end": 410.17,
   "text": "בגללו הוא האכיל אותי נבלות וטרפות,"
  },
  {
   "start": 410.67,
   "end": 411.57,
   "text": "לא לוותר לו."
  },
  {
   "start": 415.91,
   "end": 419.15,
   "text": "כמה חיכינו ליום שהתנקמו בו על כל מה שגרם,"
  },
  {
   "start": 422.08,
   "end": 423.08,
   "text": "ואני לא יודע מה לעשות."
  },
  {
   "start": 425.18,
   "end": 428.18,
   "text": "ולפתע פלשו עדרים של צאן ובקר."
  },
  {
   "start": 429.38,
   "end": 430.24,
   "text": "אנחנו היינו גלגולים,"
  },
  {
   "start": 431.0,
   "end": 433.04,
   "text": "נשמות שחיכינו להגיע ליהודים,"
  },
  {
   "start": 434.3,
   "end": 436.78,
   "text": "ולבסוף היהודים האלה הרגו אותנו בלילה"
  },
  {
   "start": 437.7,
   "end": 438.78,
   "text": "בלי שחיטה,"
  },
  {
   "start": 439.38,
   "end": 441.12,
   "text": "וניפצו את כל תקוותנו,"
  },
  {
   "start": 441.58,
   "end": 444.24,
   "text": "ומאז אנחנו נעים ונדים בעולמות."
  },
  {
   "start": 445.3,
   "end": 445.52,
   "text": "וככה,"
  },
  {
   "start": 446.4,
   "end": 447.18,
   "text": "ככה רעש,"
  },
  {
   "start": 447.66,
   "end": 455.02,
   "text": "זעקות ייללות ובכיות מחרישות אוזניים של כל מיני נשמות שלא מצאו מנוח לנפשם,"
  },
  {
   "start": 455.66,
   "end": 456.9,
   "text": "תיקון לנשמתם,"
  },
  {
   "start": 457.54,
   "end": 458.74,
   "text": "והכל בגללי."
  },
  {
   "start": 460.9,
   "end": 463.22,
   "text": "ואני רואה איך כף המאזניים נעה לרעתי,"
  },
  {
   "start": 464.18,
   "end": 465.06,
   "text": "ולי אין מה להגיד,"
  },
  {
   "start": 467.08,
   "end": 467.78,
   "text": "רק לבכות."
  },
  {
   "start": 468.4,
   "end": 472.16,
   "text": "פלגי מים ירדו עיניי, הלא שמרו תורתך."
  },
  {
   "start": 472.72,
   "end": 475.6,
   "text": "פלגי מים ירדו עיניי, הלא שמרו תורתך."
  },
  {
   "start": 479.39,
   "end": 480.59,
   "text": "וכך נותרתי דומם."
  },
  {
   "start": 481.39,
   "end": 483.09,
   "text": "אני לא מצליח לומר דבר."
  },
  {
   "start": 498.64,
   "end": 501.14,
   "text": "אני לא יכול להגיד דבר. מה אתה יכול להגיד?"
  },
  {
   "start": 501.76,
   "end": 503.14,
   "text": "מי יכול לתת לי תשובה?"
  },
  {
   "start": 503.78,
   "end": 504.84,
   "text": "רק מצאתי את עצמי"
  },
  {
   "start": 506.42,
   "end": 510.88,
   "text": "זועק פלגי מים ירדו עיניי, הלא שמרו תורתך."
  },
  {
   "start": 511.84,
   "end": 515.04,
   "text": "פלגי מים ירדו עיניי, הלא שמרו תורתך."
  },
  {
   "start": 548.68,
   "end": 549.58,
   "text": "המלאך שלצידי"
  },
  {
   "start": 550.9,
   "end": 552.08,
   "text": "לקח את מגילת הקלף,"
  },
  {
   "start": 554.14,
   "end": 554.74,
   "text": "נעלם."
  },
  {
   "start": 556.36,
   "end": 557.12,
   "text": "נשארתי לבד."
  },
  {
   "start": 559.14,
   "end": 560.96,
   "text": "אבל הוא חזר."
  },
  {
   "start": 561.84,
   "end": 563.58,
   "text": "הוא חזר עם מחנה של מלאכים."
  },
  {
   "start": 564.44,
   "end": 566.02,
   "text": "מחנה של מלאכים מהירים,"
  },
  {
   "start": 567.16,
   "end": 568.08,
   "text": "שהחל טוען."
  },
  {
   "start": 569.0,
   "end": 570.54,
   "text": "הילדות הקשה שלו."
  },
  {
   "start": 573.1,
   "end": 576.74,
   "text": "צריך להתחשב בילדות הקשה של היהודי הזה. יתום, סבל,"
  },
  {
   "start": 577.28,
   "end": 579.44,
   "text": "לא חונך בתלמוד תורה, לא למד כלום."
  },
  {
   "start": 580.56,
   "end": 582.12,
   "text": "הוא לא הבין את חומרת הדברים,"
  },
  {
   "start": 582.98,
   "end": 586.42,
   "text": "וכשהוא הבין הוא חזר בתשובה ועשה וידוי."
  },
  {
   "start": 587.5,
   "end": 590.72,
   "text": "ולבסוף יש פה, הנה, פסק דין של המגלה העמוקות."
  },
  {
   "start": 591.8,
   "end": 593.5,
   "text": "חייבים לקבל את הפסק דין,"
  },
  {
   "start": 594.16,
   "end": 595.2,
   "text": "זה בעל תשובה."
  },
  {
   "start": 595.78,
   "end": 602.62,
   "text": "במקום שבעלי תשובה עומדים צדיקים גמורים אינם יכולים לעמוד."
  },
  {
   "start": 607.94,
   "end": 609.4,
   "text": "דנו להם שופטי בית הדין,"
  },
  {
   "start": 610.58,
   "end": 613.04,
   "text": "ובתום זמן ארוך של דיונים,"
  },
  {
   "start": 613.62,
   "end": 618.74,
   "text": "כשכל אותו זמן אני חשך אני מזמזם, ממלמל."
  },
  {
   "start": 619.32,
   "end": 621.0,
   "text": "פלגיים ירדו עיניי,"
  },
  {
   "start": 621.68,
   "end": 622.98,
   "text": "הלא שמרו תורתיך,"
  },
  {
   "start": 623.62,
   "end": 624.66,
   "text": "ואני יושב ובוכה."
  },
  {
   "start": 625.44,
   "end": 627.0,
   "text": "פלגיים ירדו עיניי,"
  },
  {
   "start": 627.88,
   "end": 629.32,
   "text": "הלא שמרו תורתיך."
  },
  {
   "start": 630.34,
   "end": 630.74,
   "text": "ואז,"
  },
  {
   "start": 631.38,
   "end": 632.5,
   "text": "ואז בדין של מעלה,"
  },
  {
   "start": 634.42,
   "end": 642.11,
   "text": "קובע פסק דין,"
  },
  {
   "start": 642.77,
   "end": 644.87,
   "text": "פסק דינו של המגלה עמוקות,"
  },
  {
   "start": 645.87,
   "end": 652.2,
   "text": "שריר וקיים הקצב,"
  },
  {
   "start": 653.26,
   "end": 662.62,
   "text": "בעל תשובה נקי מכל חטא כמו תינוק שנולד."
  },
  {
   "start": 676.24,
   "end": 676.86,
   "text": "ומיד,"
  },
  {
   "start": 677.54,
   "end": 681.92,
   "text": "מיד הוצא פסק דין נוסף שבעקבות התשובה שלנו,"
  },
  {
   "start": 682.74,
   "end": 688.24,
   "text": "בעקבות פסק הדין של בית דין של מטה ושל בית דין של מעלה,"
  },
  {
   "start": 689.0,
   "end": 694.06,
   "text": "כל הנשמות שסבלו וחלקם נפגע בכל העולמות"
  },
  {
   "start": 694.5,
   "end": 696.24,
   "text": "יקבלו את התיקון שלהם,"
  },
  {
   "start": 696.66,
   "end": 699.48,
   "text": "ושערי גן עדן ייפתחו בפניהם."
  },
  {
   "start": 709.49,
   "end": 713.19,
   "text": "ושערי גן עדן נפתחו בפני כל אותם נשמות,"
  },
  {
   "start": 713.51,
   "end": 718.75,
   "text": "ועדרים עדרים של נשמות נלקחים להם אל גן עדן."
  },
  {
   "start": 724.99,
   "end": 729.95,
   "text": "כל נשמה נלקחת לה ברוב פאר והדר אל מקומה הראוי לה."
  },
  {
   "start": 731.43,
   "end": 731.85,
   "text": "ואז,"
  },
  {
   "start": 732.87,
   "end": 733.07,
   "text": "אז,"
  },
  {
   "start": 733.75,
   "end": 736.75,
   "text": "באו אליי, והכריזו זכאי!"
  },
  {
   "start": 738.21,
   "end": 739.83,
   "text": "והכל אמר שירה,"
  },
  {
   "start": 740.43,
   "end": 743.13,
   "text": "וכל ההיכלות החלו לנגן, נגינה."
  },
  {
   "start": 744.87,
   "end": 747.93,
   "text": "הוא צדיק, הוא זכאי, בעל תשובה,"
  },
  {
   "start": 748.59,
   "end": 754.87,
   "text": "ואלפי מלאכי עליון נוצצים באו לקבל אותי ולהוליך אותי לגן עדן."
  },
  {
   "start": 756.31,
   "end": 757.67,
   "text": "על ראשי שמו כתר,"
  },
  {
   "start": 758.55,
   "end": 759.85,
   "text": "בעל תשובה גמור,"
  },
  {
   "start": 761.43,
   "end": 767.2,
   "text": "והוליך אותי להיכל מפואר ונהדר,"
  },
  {
   "start": 767.2,
   "end": 771.42,
   "text": "ואני, כולי, כולי התרגשות."
  },
  {
   "start": 775.9,
   "end": 777.46,
   "text": "עד כאן הייתה לי רשות לגלות לך."
  },
  {
   "start": 780.6,
   "end": 781.24,
   "text": "באתי אליך."
  },
  {
   "start": 782.0,
   "end": 783.18,
   "text": "אני צריך לחזור להיכל שלי."
  },
  {
   "start": 783.76,
   "end": 785.5,
   "text": "לספר לך, לעודד אותך. אל תדאג."
  },
  {
   "start": 786.74,
   "end": 789.48,
   "text": "פלגי מים ירדו עיניי הלא שברו תורתך."
  },
  {
   "start": 789.94,
   "end": 791.86,
   "text": "שווה כל בכי ובכי שבכינו."
  },
  {
   "start": 793.0,
   "end": 793.22,
   "text": "לך,"
  },
  {
   "start": 793.92,
   "end": 794.84,
   "text": "לך ספר לרב."
  },
  {
   "start": 795.82,
   "end": 797.04,
   "text": "ותעלו את זה על הכתב."
  },
  {
   "start": 797.74,
   "end": 798.74,
   "text": "שידעו כולם,"
  },
  {
   "start": 799.32,
   "end": 801.86,
   "text": "שידעו כולם מהי כוחה של תשובה."
  },
  {
   "start": 802.5,
   "end": 805.14,
   "text": "תרשמו את זה בפנקס הקהילה של קרקוב,"
  },
  {
   "start": 805.6,
   "end": 808.18,
   "text": "שכל העולם ידע מה זה כוח של תשובה,"
  },
  {
   "start": 808.64,
   "end": 810.18,
   "text": "שכמה שאדם יקלקל,"
  },
  {
   "start": 810.74,
   "end": 812.12,
   "text": "יש לו אפשרות לתקן,"
  },
  {
   "start": 812.7,
   "end": 814.14,
   "text": "יש לו אפשרות לתקן."
  },
  {
   "start": 814.56,
   "end": 816.28,
   "text": "תרשמו את זה, שכולם ידעו,"
  },
  {
   "start": 817.26,
   "end": 818.58,
   "text": "שכולם ידעו."
  },
  {
   "start": 822.9,
   "end": 824.64,
   "text": "ואני אגיד לך רק לסיום דבר אחד,"
  },
  {
   "start": 827.07,
   "end": 828.17,
   "text": "אני בצער מדבר אחד,"
  },
  {
   "start": 829.11,
   "end": 834.31,
   "text": "כמה יכולתי להספיק יותר אם הייתי מנצל עוד קצת מהעולם הזה,"
  },
  {
   "start": 835.25,
   "end": 836.15,
   "text": "מהעולם השפל,"
  },
  {
   "start": 836.59,
   "end": 841.89,
   "text": "לך נשאר עוד קצת לחיות נצל כל דקה לתורה למצוות"
  },
  {
   "start": 842.81,
   "end": 845.47,
   "text": "כי אחרי זה מה שתוכל להגיד רק"
  },
  {
   "start": 846.19,
   "end": 850.75,
   "text": "תוכל לבכות ולהגיד פלגמאים ירדו עיניי הלא שמרו תורתך."
  },
  {
   "start": 857.54,
   "end": 857.96,
   "text": "המקרה הזה"
  },
  {
   "start": 859.04,
   "end": 860.94,
   "text": "המקרה הזה נרשם בקהילה של קרקו"
  },
  {
   "start": 861.52,
   "end": 867.36,
   "text": "היה בתקופתו של רבינת הנטר שפירא בעל המגלה עמוקות,"
  },
  {
   "start": 867.7,
   "end": 868.68,
   "text": "כוח של תשובה,"
  },
  {
   "start": 869.32,
   "end": 873.9,
   "text": "תשובה אמיתית ואנחנו בעזרת השם צריכים לדעת"
  },
  {
   "start": 882.4,
   "end": 884.1,
   "text": "שהיום אפשר ללכת למצוא תורה בכל מקום."
  },
  {
   "start": 884.96,
   "end": 886.12,
   "text": "אפשר לחזור בתשובה,"
  },
  {
   "start": 886.82,
   "end": 887.94,
   "text": "בפשטות, בנעימות."
  },
  {
   "start": 888.84,
   "end": 889.78,
   "text": "לא צריך לעשות היום גלות."
  },
  {
   "start": 890.56,
   "end": 891.22,
   "text": "אפשר ללכת"
  },
  {
   "start": 891.82,
   "end": 897.54,
   "text": "ופשוט לצאת מכל, מכל אבלי העולם הזה, להתקרב אל השם בשמחה."
  },
  {
   "start": 898.78,
   "end": 899.38,
   "text": "ואז יום אחד,"
  },
  {
   "start": 899.94,
   "end": 902.28,
   "text": "אם רק נעשה את הצעדים, נתחיל להתקרב אל השם."
  },
  {
   "start": 903.12,
   "end": 906.58,
   "text": "נתחיל לבכות עוד בעולם הזה, נאמר, פלגי מים ירדו עיניי,"
  },
  {
   "start": 906.96,
   "end": 908.2,
   "text": "הלא שמרו תורתך."
  },
  {
   "start": 908.78,
   "end": 910.3,
   "text": "אם הייתי שומר יותר את התורה,"
  },
  {
   "start": 910.76,
   "end": 915.12,
   "text": "אם הייתי שומר יותר את העיניים, איי, איי, איי, מה הפסדתי בעולם הזה?"
  },
  {
   "start": 916.38,
   "end": 921.68,
   "text": "קל וחומר בעולם הבא, אז בואו בעזרת השם נעצור את מסלול החיים המטורף הזה,"
  },
  {
   "start": 922.06,
   "end": 924.6,
   "text": "ובואו נפנה את העיניים אל אבא שבשמיים."
  }
 ]
}