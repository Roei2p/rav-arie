{
 "disc": "14יד- בעלי תשובה",
 "track": "Track04",
 "duration": 408.168,
 "segments": [
  {
   "start": 6.35,
   "end": 7.95,
   "text": "שלוש שנים של גלות,"
  },
  {
   "start": 10.13,
   "end": 11.11,
   "text": "בכל מקום וידוי."
  },
  {
   "start": 12.59,
   "end": 13.99,
   "text": "כל לילה שינה על אבנים,"
  },
  {
   "start": 14.75,
   "end": 16.41,
   "text": "וקושי מזון, מזג אוויר קשה."
  },
  {
   "start": 18.33,
   "end": 19.47,
   "text": "אבל השניים מקפידים"
  },
  {
   "start": 21.77,
   "end": 23.85,
   "text": "לקיים את פסק הדין במדויק,"
  },
  {
   "start": 26.21,
   "end": 27.75,
   "text": "ואפילו יש מקרים שהם החמירו על עצמם."
  },
  {
   "start": 44.06,
   "end": 54.92,
   "text": "עם ישראל, וכך חולפות להם השלוש שנים."
  },
  {
   "start": 56.78,
   "end": 57.8,
   "text": "בינתיים בקרקוב,"
  },
  {
   "start": 58.34,
   "end": 64.54,
   "text": "בעל המגלה עמוקות שכל אותן שלוש שנים חושב עליהן"
  },
  {
   "start": 66.0,
   "end": 67.04,
   "text": "ביום ובלילה,"
  },
  {
   "start": 69.6,
   "end": 70.8,
   "text": "ממתין ליד חלונו."
  },
  {
   "start": 71.84,
   "end": 72.3,
   "text": "ממתין."
  },
  {
   "start": 74.0,
   "end": 74.78,
   "text": "אולי הם יבואו."
  },
  {
   "start": 76.22,
   "end": 81.88,
   "text": "אולי היום כבר עברו להם השלוש שנים."
  },
  {
   "start": 82.68,
   "end": 83.8,
   "text": "הוא ממתין בקוצר רוח."
  },
  {
   "start": 86.21,
   "end": 86.47,
   "text": "ואז,"
  },
  {
   "start": 89.45,
   "end": 90.95,
   "text": "ערב אחד הוא רואה שני דמויות"
  },
  {
   "start": 92.09,
   "end": 93.73,
   "text": "נראות כרוחות רפאים"
  },
  {
   "start": 94.61,
   "end": 95.77,
   "text": "שמתקרבות להם"
  },
  {
   "start": 96.39,
   "end": 97.63,
   "text": "אט-אט אל בית הרב."
  },
  {
   "start": 100.17,
   "end": 100.49,
   "text": "והרב,"
  },
  {
   "start": 103.29,
   "end": 104.95,
   "text": "הרב יוצא מפתח בתור אצלם."
  },
  {
   "start": 106.09,
   "end": 106.99,
   "text": "אתם צדיקים."
  },
  {
   "start": 107.95,
   "end": 108.93,
   "text": "אתם צדיקים."
  },
  {
   "start": 109.75,
   "end": 114.01,
   "text": "במקום שבעלי תשובה עומדים, צדיקים גמורים אינם יכולים לעמוד."
  },
  {
   "start": 115.97,
   "end": 117.09,
   "text": "הוא מכניס אותם אליו הביתה,"
  },
  {
   "start": 117.93,
   "end": 121.27,
   "text": "מכבד אותם, לראשונה מזה שלוש שנים."
  },
  {
   "start": 121.99,
   "end": 122.47,
   "text": "אוכל,"
  },
  {
   "start": 123.55,
   "end": 124.37,
   "text": "כי בני אדם"
  },
  {
   "start": 124.37,
   "end": 128.03,
   "text": "יכולים לשבת על כיסא כבני אדם"
  },
  {
   "start": 129.39,
   "end": 130.11,
   "text": "עכשיו נגמר"
  },
  {
   "start": 130.99,
   "end": 131.71,
   "text": "נגמר הכל"
  },
  {
   "start": 132.49,
   "end": 134.73,
   "text": "עכשיו תלכו ותתפרנסו ביושר כפיים"
  },
  {
   "start": 137.5,
   "end": 138.36,
   "text": "אבל זה לא רק זה"
  },
  {
   "start": 138.88,
   "end": 143.24,
   "text": "אלא הרב של קרקוב המגלה עמוקות מוציא כרוז בכל קרקוב למחרת כבר"
  },
  {
   "start": 143.9,
   "end": 145.0,
   "text": "שני הקצבים"
  },
  {
   "start": 145.68,
   "end": 150.88,
   "text": "בעלי התשובה חזרו מהגלות שלהם וקיימו את גזר הדין בשלמות"
  },
  {
   "start": 151.52,
   "end": 154.12,
   "text": "מעתה הם נקיים וצדיקים גמורים"
  },
  {
   "start": 154.76,
   "end": 158.08,
   "text": "אף אחד, אף אחד אסור לו לפגוע בכבודם."
  },
  {
   "start": 158.86,
   "end": 161.72,
   "text": "לא רק זה, אלא חובה על כל אחד מתושבי קרקוב"
  },
  {
   "start": 162.24,
   "end": 164.64,
   "text": "לנסות ולסייע להם במציאת פרנסה,"
  },
  {
   "start": 165.26,
   "end": 167.2,
   "text": "לכבד אותם בכבוד הראוי להם,"
  },
  {
   "start": 167.64,
   "end": 170.9,
   "text": "ואיסור חמור להזכיר את העבר שלהם."
  },
  {
   "start": 181.42,
   "end": 184.48,
   "text": "זמן מה אחר כך הם מצאו להם עבודה כסבלים."
  },
  {
   "start": 185.58,
   "end": 187.76,
   "text": "אבל בכל אופן הם העדיפו לגור מחוץ לעיר,"
  },
  {
   "start": 188.6,
   "end": 189.76,
   "text": "כדי שהנכדים שלהם,"
  },
  {
   "start": 190.56,
   "end": 191.8,
   "text": "שהנכדים שלהם לא יתביישו בהם."
  },
  {
   "start": 195.52,
   "end": 197.02,
   "text": "כך עוברות להם מספר שנים."
  },
  {
   "start": 202.04,
   "end": 204.18,
   "text": "אחרי מספר שנים הם באים לרב מודאגים."
  },
  {
   "start": 205.44,
   "end": 206.54,
   "text": "הרב אומר להם, למה? מה קרה?"
  },
  {
   "start": 207.28,
   "end": 208.12,
   "text": "למה אתם מודאגים?"
  },
  {
   "start": 209.6,
   "end": 212.56,
   "text": "כבוד הרב, יש אתנו פחד כל הזמן מלווה אותנו."
  },
  {
   "start": 213.0,
   "end": 214.5,
   "text": "הפחד מה יהיה איתנו בעולם הבא."
  },
  {
   "start": 215.46,
   "end": 216.6,
   "text": "והרב מנסה להרגיע,"
  },
  {
   "start": 217.4,
   "end": 217.94,
   "text": "אבל הוא לא מצליח."
  },
  {
   "start": 219.24,
   "end": 220.38,
   "text": "הוא רואה את הפחד ניבט,"
  },
  {
   "start": 222.26,
   "end": 224.74,
   "text": "משתקף לו מתוך עיניהם."
  },
  {
   "start": 227.48,
   "end": 228.42,
   "text": "מה יכול להרגיע אתכם?"
  },
  {
   "start": 229.58,
   "end": 230.34,
   "text": "מה אתם רוצים?"
  },
  {
   "start": 231.26,
   "end": 232.62,
   "text": "כבוד הרב אנחנו מבקשים,"
  },
  {
   "start": 233.08,
   "end": 234.88,
   "text": "אם כבוד הרב ייתן לנו אישור בכתב."
  },
  {
   "start": 235.96,
   "end": 238.22,
   "text": "אישור בכתב שנוכל לבוא איתו לעולם הבא."
  },
  {
   "start": 240.3,
   "end": 241.52,
   "text": "ובעל המגלה עמוקות"
  },
  {
   "start": 242.12,
   "end": 243.06,
   "text": "יושב בלילה"
  },
  {
   "start": 243.88,
   "end": 245.3,
   "text": "וכותב על מגילת קלף"
  },
  {
   "start": 245.84,
   "end": 246.82,
   "text": "אני החתום מטה,"
  },
  {
   "start": 247.62,
   "end": 253.38,
   "text": "רבה של קרקוב ואב בית דין הגדול שהוציא את דינם כדי לכפר על פשעיהם,"
  },
  {
   "start": 253.84,
   "end": 257.9,
   "text": "הריני גוזר שכשם שקבע בית דין של מטה,"
  },
  {
   "start": 258.44,
   "end": 260.58,
   "text": "כך יקיימו בבית דין של מעלה,"
  },
  {
   "start": 261.18,
   "end": 265.32,
   "text": "והשניים נקיים מכל עוון ופשע."
  },
  {
   "start": 266.36,
   "end": 267.08,
   "text": "אני החתום מטה,"
  },
  {
   "start": 267.72,
   "end": 270.3,
   "text": "רבה של קרקוב והבית דין הגדול."
  },
  {
   "start": 271.9,
   "end": 274.5,
   "text": "הריני גוזר כשם שקבע בית דין של מטה,"
  },
  {
   "start": 274.86,
   "end": 276.36,
   "text": "כך יקיימו בבית דין של מעלה."
  },
  {
   "start": 278.83,
   "end": 280.91,
   "text": "על החתום רבי נתן נטע שפירא."
  },
  {
   "start": 283.7,
   "end": 284.96,
   "text": "כך כתב המגלה המוכות."
  },
  {
   "start": 286.82,
   "end": 288.02,
   "text": "והשניים חזרו לביתם."
  },
  {
   "start": 291.21,
   "end": 292.29,
   "text": "עוברות להם שנים."
  },
  {
   "start": 293.27,
   "end": 294.69,
   "text": "אחד מהשותפים החולה מאוד,"
  },
  {
   "start": 295.69,
   "end": 296.91,
   "text": "על ערש דווי."
  },
  {
   "start": 299.05,
   "end": 302.45,
   "text": "הוא מפוחד, הוא מסויט מהמזיקים שממתינים לו."
  },
  {
   "start": 303.47,
   "end": 304.89,
   "text": "החבר'ה קדישא מזיקים את הרב,"
  },
  {
   "start": 306.19,
   "end": 307.09,
   "text": "וכשהרב מגיע,"
  },
  {
   "start": 307.69,
   "end": 308.39,
   "text": "הוא רואה את הפחד,"
  },
  {
   "start": 309.37,
   "end": 311.47,
   "text": "את הפחד של העומד למות."
  },
  {
   "start": 313.09,
   "end": 313.41,
   "text": "פוקד,"
  },
  {
   "start": 313.99,
   "end": 316.73,
   "text": "אדוני המשפחת תוציאו, תמסרו את מגילת הקלף שכתבתי לו,"
  },
  {
   "start": 317.29,
   "end": 318.47,
   "text": "שייקח אותה איתו לקבר."
  },
  {
   "start": 320.25,
   "end": 322.05,
   "text": "ואז הרב מבקש לקרוא לשותף השני."
  },
  {
   "start": 323.17,
   "end": 324.03,
   "text": "ואומר, אני מבקש מכם,"
  },
  {
   "start": 324.77,
   "end": 328.75,
   "text": "תתקעו כף עכשיו, שאחרי מותו יבוא החבר שלך,"
  },
  {
   "start": 329.61,
   "end": 333.23,
   "text": "זה שהולך להיפטר מן העולם, ויספר לך מה עשו בדינו."
  },
  {
   "start": 334.25,
   "end": 335.09,
   "text": "ויספר לך"
  },
  {
   "start": 335.67,
   "end": 336.25,
   "text": "מה עשו בדינו."
  },
  {
   "start": 340.52,
   "end": 341.56,
   "text": "יומיים אחר כך"
  },
  {
   "start": 342.3,
   "end": 343.98,
   "text": "נפטר אותו בעל תשובה."
  },
  {
   "start": 344.84,
   "end": 346.88,
   "text": "בעל התשובה, אחד מבין השתיים נפטר."
  },
  {
   "start": 348.52,
   "end": 349.08,
   "text": "הלוויה."
  },
  {
   "start": 350.4,
   "end": 353.44,
   "text": "בהספד הרב אומר, ראו, תראו מה זה כוחה של תשובה."
  },
  {
   "start": 354.1,
   "end": 356.98,
   "text": "גם מי שגרם נזקים רבים, יש לו תקנה."
  },
  {
   "start": 362.39,
   "end": 364.43,
   "text": "ואחרי ההלוויה,"
  },
  {
   "start": 365.93,
   "end": 366.81,
   "text": "בתום ההספדים,"
  },
  {
   "start": 368.15,
   "end": 370.11,
   "text": "השותף השני ממתין כל השבעה"
  },
  {
   "start": 371.01,
   "end": 371.81,
   "text": "לחבר שלו,"
  },
  {
   "start": 373.17,
   "end": 374.37,
   "text": "שלא מופיע בחלום,"
  },
  {
   "start": 376.01,
   "end": 377.67,
   "text": "מחכה לו, מתי תבוא אליי?"
  },
  {
   "start": 378.45,
   "end": 382.47,
   "text": "מתי תבוא אליי בחלום? תגלה לי, תגיד לי. הרי תקענו קו,"
  },
  {
   "start": 383.37,
   "end": 384.03,
   "text": "סיכמנו,"
  },
  {
   "start": 384.75,
   "end": 385.47,
   "text": "ליד הרב,"
  },
  {
   "start": 389.18,
   "end": 390.36,
   "text": "כך מתארך לו הזמן,"
  },
  {
   "start": 390.8,
   "end": 391.8,
   "text": "והרב מרגיע,"
  },
  {
   "start": 392.82,
   "end": 394.36,
   "text": "הרב מרגיע תמתין בסבלנות,"
  },
  {
   "start": 398.09,
   "end": 398.63,
   "text": "ואז,"
  },
  {
   "start": 402.67,
   "end": 403.25,
   "text": "ואז,"
  },
  {
   "start": 405.44,
   "end": 405.9,
   "text": "ואז זה הגיע."
  }
 ]
}