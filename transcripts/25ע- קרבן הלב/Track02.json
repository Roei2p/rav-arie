{
 "disc": "25ע- קרבן הלב",
 "track": "Track02",
 "duration": 1037.184,
 "segments": [
  {
   "start": 1.64,
   "end": 4.82,
   "text": "בפרשת העגל, כשעם ישראל רואה שמשה מתעכב,"
  },
  {
   "start": 5.7,
   "end": 8.88,
   "text": "והם החליטו לעשות להם עגל, לעשות להם"
  },
  {
   "start": 9.88,
   "end": 11.96,
   "text": "איזה משהו שדרכו יוכלו לעבוד את השם."
  },
  {
   "start": 13.12,
   "end": 14.36,
   "text": "אז הם פונים בהתחלה לחור."
  },
  {
   "start": 16.36,
   "end": 17.06,
   "text": "אמרו לו, תיזהר,"
  },
  {
   "start": 17.58,
   "end": 19.02,
   "text": "אם אתה לא תעזור לנו, נהרוג אותך."
  },
  {
   "start": 19.94,
   "end": 21.76,
   "text": "ולא אכפת לו, חור עומד בפרץ."
  },
  {
   "start": 22.76,
   "end": 23.9,
   "text": "הוא לא זז ולא נע."
  },
  {
   "start": 24.6,
   "end": 25.14,
   "text": "ואותם,"
  },
  {
   "start": 25.82,
   "end": 26.7,
   "text": "אותם ערב רב,"
  },
  {
   "start": 27.54,
   "end": 30.92,
   "text": "שהנהיגו את המהפכה הגרועה הזאת,"
  },
  {
   "start": 33.7,
   "end": 36.14,
   "text": "התנפלו עליו ורצחו אותו."
  },
  {
   "start": 38.2,
   "end": 39.26,
   "text": "חור נפל הרוג."
  },
  {
   "start": 40.78,
   "end": 41.32,
   "text": "ואז הם מסתובבים."
  },
  {
   "start": 42.54,
   "end": 43.26,
   "text": "נשאר אהרון."
  },
  {
   "start": 44.22,
   "end": 45.4,
   "text": "הם מתקרבים לאהרון הכהן,"
  },
  {
   "start": 46.3,
   "end": 47.06,
   "text": "ואומרים לו אהרון,"
  },
  {
   "start": 48.96,
   "end": 50.18,
   "text": "אתה תעזור לנו."
  },
  {
   "start": 50.54,
   "end": 52.12,
   "text": "ואהרון יודע שחור נרצח,"
  },
  {
   "start": 53.46,
   "end": 54.66,
   "text": "והוא מנסה להרוויח זמן,"
  },
  {
   "start": 55.52,
   "end": 57.16,
   "text": "והוא מנסה אומר להם, תשמעו, הוא צריך זהב."
  },
  {
   "start": 57.58,
   "end": 60.26,
   "text": "הוא יודע שאולי הם ילכו לנשים שלהם, והנשים שלהם צדקניות,"
  },
  {
   "start": 60.98,
   "end": 62.7,
   "text": "נשים צדיקות, נשים זאת אמונה."
  },
  {
   "start": 62.7,
   "end": 66.06,
   "text": "הם לא יוותרו להם בקלות על התכשיטים שלהם."
  },
  {
   "start": 67.52,
   "end": 69.66,
   "text": "אבל הם התנפלו על אנשים אותו ערב רב,"
  },
  {
   "start": 70.96,
   "end": 72.38,
   "text": "הם פשוט לקחו בכוח"
  },
  {
   "start": 73.08,
   "end": 73.92,
   "text": "והביאו לו את הזהב."
  },
  {
   "start": 74.68,
   "end": 75.22,
   "text": "ואהרון,"
  },
  {
   "start": 77.26,
   "end": 79.96,
   "text": "אהרון הלוברלבשור, עוזר להם למעשה לעשות העגל."
  },
  {
   "start": 80.28,
   "end": 82.26,
   "text": "עם ישראל, אותם ערב רב נענשו."
  },
  {
   "start": 84.12,
   "end": 86.14,
   "text": "עם ישראל הפסיד הזדמנות להיגאל."
  },
  {
   "start": 87.04,
   "end": 87.96,
   "text": "אהרון הכהן?"
  },
  {
   "start": 88.84,
   "end": 89.88,
   "text": "אהרון עוד לא היה כהן אז."
  },
  {
   "start": 90.8,
   "end": 91.64,
   "text": "אחרי העגל"
  },
  {
   "start": 92.6,
   "end": 95.5,
   "text": "הוא קיבל במתנה את הכהונה הגדולה."
  },
  {
   "start": 98.12,
   "end": 98.98,
   "text": "איך זה ייתכן?"
  },
  {
   "start": 100.42,
   "end": 102.9,
   "text": "איך זה ייתכן? הרי אתה היית שותף למעשה העגל."
  },
  {
   "start": 103.58,
   "end": 104.62,
   "text": "היית צריך להיענש."
  },
  {
   "start": 106.08,
   "end": 106.96,
   "text": "ועוד אתה אהרון."
  },
  {
   "start": 107.58,
   "end": 109.82,
   "text": "היית צריך למסור נפש כמו חור."
  },
  {
   "start": 110.7,
   "end": 111.18,
   "text": "למות."
  },
  {
   "start": 111.88,
   "end": 114.6,
   "text": "ולא לעבוד עבודה זרה, לא לעזור להם לעשות עבודה זרה."
  },
  {
   "start": 114.94,
   "end": 115.8,
   "text": "איך זה יכול להיות?"
  },
  {
   "start": 116.42,
   "end": 116.92,
   "text": "עבודה זרה"
  },
  {
   "start": 117.66,
   "end": 119.24,
   "text": "ייהרג ובל יעבור."
  },
  {
   "start": 120.14,
   "end": 124.64,
   "text": "איך יכול להיות שאהרון הכהן עוזר לעם ישראל לעשות עבודה זרה,"
  },
  {
   "start": 125.26,
   "end": 128.68,
   "text": "ובתמורה לזה זוכה לשכר כל כך עצום,"
  },
  {
   "start": 129.12,
   "end": 130.56,
   "text": "כהונת עולם,"
  },
  {
   "start": 131.02,
   "end": 133.38,
   "text": "להיות הכהן הגדול, איך יכול להיות?"
  },
  {
   "start": 136.59,
   "end": 137.61,
   "text": "כדי להבין מה קרה שם,"
  },
  {
   "start": 138.49,
   "end": 139.41,
   "text": "אז בואו בעזרת השם,"
  },
  {
   "start": 140.55,
   "end": 144.05,
   "text": "בואו נעבור לתקופה אחרת בעם ישראל."
  },
  {
   "start": 145.07,
   "end": 146.05,
   "text": "בואו נעבור לתקופת"
  },
  {
   "start": 146.89,
   "end": 147.71,
   "text": "המלכים,"
  },
  {
   "start": 148.89,
   "end": 151.17,
   "text": "אל סוף תקופת מלכות החזייה."
  },
  {
   "start": 151.89,
   "end": 153.33,
   "text": "כשאחזייה המלך נרצח,"
  },
  {
   "start": 156.46,
   "end": 156.96,
   "text": "ואז"
  },
  {
   "start": 159.67,
   "end": 160.21,
   "text": "ביהודה"
  },
  {
   "start": 161.27,
   "end": 162.69,
   "text": "מסתורר לו קצת תוהו ובוהו."
  },
  {
   "start": 164.53,
   "end": 166.39,
   "text": "האמא של אחזייה קראו לה עטליה."
  },
  {
   "start": 167.41,
   "end": 170.71,
   "text": "עטליה רצתה למלוך, היא רוצה להיות המלכה."
  },
  {
   "start": 171.67,
   "end": 176.45,
   "text": "אבל היא יודעת שביהודה המלכות עוברת מאב לבן."
  },
  {
   "start": 178.13,
   "end": 183.57,
   "text": "כלומר הבן של אחזייה צריך להיות הנכד שלה."
  },
  {
   "start": 184.81,
   "end": 185.21,
   "text": "אבל היא,"
  },
  {
   "start": 186.03,
   "end": 188.01,
   "text": "היא רוצה להיות המלכה,"
  },
  {
   "start": 188.95,
   "end": 190.05,
   "text": "ושום דבר"
  },
  {
   "start": 191.53,
   "end": 192.55,
   "text": "לא יעצור אותה."
  },
  {
   "start": 193.35,
   "end": 195.43,
   "text": "היא החליטה ששום דבר לא יעמוד בדרכה."
  },
  {
   "start": 196.69,
   "end": 199.43,
   "text": "עתליה לא היה אכפת לה כלום בעולם חוץ ממנה,"
  },
  {
   "start": 199.95,
   "end": 200.95,
   "text": "חוץ מהרצונות שלה."
  },
  {
   "start": 202.95,
   "end": 205.03,
   "text": "אז היא החלה מארגנת בשיטתיות."
  },
  {
   "start": 207.31,
   "end": 209.51,
   "text": "מסע של התנגשויות, מסע של רציחות."
  },
  {
   "start": 210.89,
   "end": 213.77,
   "text": "היא הייתה מומחת ברעלים, היא הייתה רוקחת לרעלים,"
  },
  {
   "start": 214.67,
   "end": 216.99,
   "text": "והורגת את הנכדים שלה,"
  },
  {
   "start": 218.07,
   "end": 219.17,
   "text": "נכד אחרי נכד."
  },
  {
   "start": 220.27,
   "end": 221.67,
   "text": "היא הרגה, רצחה בדם קר."
  },
  {
   "start": 223.53,
   "end": 225.63,
   "text": "לא היה לה נקיפות מצפון לאותה עתליה."
  },
  {
   "start": 232.61,
   "end": 235.53,
   "text": "לבסוף נשאר לעתליה נכד אחד."
  },
  {
   "start": 237.47,
   "end": 237.97,
   "text": "קטן."
  },
  {
   "start": 239.27,
   "end": 240.01,
   "text": "קראו לו יואש."
  },
  {
   "start": 241.09,
   "end": 241.85,
   "text": "תינוק קטן."
  },
  {
   "start": 242.47,
   "end": 242.93,
   "text": "עוד רק נולד."
  },
  {
   "start": 244.25,
   "end": 244.95,
   "text": "הייתה לו מנקת."
  },
  {
   "start": 246.71,
   "end": 249.25,
   "text": "ועתליה תכננה תוכנית"
  },
  {
   "start": 250.03,
   "end": 250.63,
   "text": "מזוויעה."
  },
  {
   "start": 255.51,
   "end": 256.79,
   "text": "היא רק חלה איזה רעל,"
  },
  {
   "start": 257.53,
   "end": 258.89,
   "text": "המנקת שותה את זה,"
  },
  {
   "start": 259.81,
   "end": 261.05,
   "text": "אז לה לא קורה כלום."
  },
  {
   "start": 262.19,
   "end": 263.97,
   "text": "אבל כשיבוא אותו תינוק,"
  },
  {
   "start": 264.55,
   "end": 265.57,
   "text": "אותו יואש התינוק,"
  },
  {
   "start": 266.09,
   "end": 267.13,
   "text": "לשתות את החלב"
  },
  {
   "start": 268.71,
   "end": 269.55,
   "text": "מהמנקת"
  },
  {
   "start": 270.99,
   "end": 271.47,
   "text": "הוא ימות."
  },
  {
   "start": 273.99,
   "end": 275.51,
   "text": "היא רק לא לקחה בחשבון דבר אחד,"
  },
  {
   "start": 276.05,
   "end": 276.71,
   "text": "את יהושבה."
  },
  {
   "start": 277.53,
   "end": 279.67,
   "text": "יהושבה זו הייתה הבת של עתליה."
  },
  {
   "start": 280.57,
   "end": 282.93,
   "text": "את הבנות שלה היא לא הרגה, כי הן לא סיכנו את המלוכה שלה."
  },
  {
   "start": 283.93,
   "end": 285.45,
   "text": "יאושבה, הבת שלה, טליה,"
  },
  {
   "start": 287.23,
   "end": 289.67,
   "text": "התמלאה רחמים על יואש, על התינוק הזה."
  },
  {
   "start": 290.09,
   "end": 291.45,
   "text": "היא ידעה מה אימא שלה מתכננת."
  },
  {
   "start": 294.53,
   "end": 297.69,
   "text": "וכשאף אחד לא היה בלילה חשוך אחד,"
  },
  {
   "start": 299.47,
   "end": 302.73,
   "text": "היא הצליחה ללכת, להתגנב לבית איפה שיואש היה,"
  },
  {
   "start": 304.07,
   "end": 305.21,
   "text": "ולחטוף אותו ולברוח איתו."
  },
  {
   "start": 307.82,
   "end": 309.44,
   "text": "היא הייתה אשתו של יאוהדה הכהן,"
  },
  {
   "start": 310.62,
   "end": 311.86,
   "text": "אותו כהן שהיה אז בתקופה."
  },
  {
   "start": 313.2,
   "end": 315.1,
   "text": "והיא באה מבקשת ממנו, תחביא את הילד."
  },
  {
   "start": 315.64,
   "end": 316.8,
   "text": "תחבית הילד מהסבתא הזאת."
  },
  {
   "start": 319.83,
   "end": 322.55,
   "text": "והיודע הכהן הגדול, הוא יודע שהטליה תחפש בכל מקום."
  },
  {
   "start": 323.07,
   "end": 323.71,
   "text": "לפתע מפזיק"
  },
  {
   "start": 324.85,
   "end": 325.45,
   "text": "במוחו רעיון,"
  },
  {
   "start": 326.85,
   "end": 327.29,
   "text": "רעיון לא עז."
  },
  {
   "start": 328.05,
   "end": 329.51,
   "text": "הוא אמר, רגע, הילד הרי קטן."
  },
  {
   "start": 329.87,
   "end": 332.11,
   "text": "לילד אין הרי מחשבת חטא, זה ילד קטנצ'יק."
  },
  {
   "start": 332.53,
   "end": 335.71,
   "text": "אני אשים אותו במקום שאף אחד לא יחפש, בקודש הקודשים."
  },
  {
   "start": 336.29,
   "end": 338.25,
   "text": "בקודש הקודשים אני אשים אותו."
  },
  {
   "start": 338.97,
   "end": 340.25,
   "text": "מקום שיש מי שנכנס לשם,"
  },
  {
   "start": 340.63,
   "end": 343.81,
   "text": "ויש לו איזו מחשבה קטנה של טומאה, של חטא,"
  },
  {
   "start": 344.17,
   "end": 344.95,
   "text": "הוא לא יוצא חי."
  },
  {
   "start": 345.53,
   "end": 348.19,
   "text": "אז גם מי שינסה להיכנס, לקחת אותו,"
  },
  {
   "start": 348.97,
   "end": 349.41,
   "text": "הרי ימות במקום."
  },
  {
   "start": 350.93,
   "end": 352.25,
   "text": "והוא מחביא אותו בקודש הקודשים."
  },
  {
   "start": 353.49,
   "end": 355.79,
   "text": "ועתליה מחפשת בכל הממלכה ולא מוצאת,"
  },
  {
   "start": 357.19,
   "end": 357.63,
   "text": "עד שהיא מתייאשת."
  },
  {
   "start": 361.14,
   "end": 362.32,
   "text": "ושקט מסתרר בממלכה."
  },
  {
   "start": 363.3,
   "end": 364.58,
   "text": "עתליה שולטת ביד רמה."
  },
  {
   "start": 365.4,
   "end": 368.14,
   "text": "כל העם סובל את השיגיונות שלה."
  },
  {
   "start": 370.32,
   "end": 371.36,
   "text": "גורמת צער לכולם."
  },
  {
   "start": 372.62,
   "end": 373.86,
   "text": "כולם חורקים שיניים."
  },
  {
   "start": 375.64,
   "end": 376.3,
   "text": "אין להם ברירה."
  },
  {
   "start": 388.51,
   "end": 389.47,
   "text": "שש שנים אחר כך,"
  },
  {
   "start": 394.22,
   "end": 395.98,
   "text": "לעם כבר נמאס מהמלכה,"
  },
  {
   "start": 397.84,
   "end": 399.18,
   "text": "שכולה איתה הרשע."
  },
  {
   "start": 400.96,
   "end": 402.04,
   "text": "ואז בשנה השביעית"
  },
  {
   "start": 402.8,
   "end": 406.76,
   "text": "פורץ יהיו ידיים שרי החצר ומכריז למעשה מרד,"
  },
  {
   "start": 407.9,
   "end": 409.86,
   "text": "והם ממליכים את יואש,"
  },
  {
   "start": 410.82,
   "end": 411.48,
   "text": "ילד בן שבע."
  },
  {
   "start": 412.1,
   "end": 413.48,
   "text": "הוא מוציא אותו מקודש הקודשים,"
  },
  {
   "start": 414.5,
   "end": 417.1,
   "text": "את אותו יואש בן שבע שנים, וממליכים אותו."
  },
  {
   "start": 419.38,
   "end": 420.54,
   "text": "עתליה שמעה על זה."
  },
  {
   "start": 421.72,
   "end": 423.7,
   "text": "היא מבינה שהמעגל סביבה מתהדק,"
  },
  {
   "start": 424.62,
   "end": 425.4,
   "text": "היא חייבת לברוח."
  },
  {
   "start": 426.08,
   "end": 426.8,
   "text": "היא מתחילה לברוח,"
  },
  {
   "start": 427.96,
   "end": 429.12,
   "text": "ואז מתנהל אחרי המרדף,"
  },
  {
   "start": 430.42,
   "end": 431.0,
   "text": "היא ברחה,"
  },
  {
   "start": 432.32,
   "end": 432.78,
   "text": "ואז"
  },
  {
   "start": 434.74,
   "end": 438.54,
   "text": "בעורבת הסוסים היא נתפסת שם ונהרגת."
  },
  {
   "start": 439.52,
   "end": 441.32,
   "text": "אז יואש מולך בגיל שבע."
  },
  {
   "start": 442.26,
   "end": 444.92,
   "text": "מגיל שבע הוא מולך במשך ארבעים שנה."
  },
  {
   "start": 451.32,
   "end": 452.24,
   "text": "באותה תקופה גם יהוידע,"
  },
  {
   "start": 454.66,
   "end": 455.84,
   "text": "אותו כהן שהציל,"
  },
  {
   "start": 456.42,
   "end": 457.08,
   "text": "הציל את יואש,"
  },
  {
   "start": 458.32,
   "end": 459.24,
   "text": "נפטר מן העולם,"
  },
  {
   "start": 460.8,
   "end": 462.06,
   "text": "וזכריה הבן שלו"
  },
  {
   "start": 462.6,
   "end": 463.32,
   "text": "נהיה הכהן,"
  },
  {
   "start": 464.4,
   "end": 465.52,
   "text": "המנהיג הרוחני של העם."
  },
  {
   "start": 467.42,
   "end": 470.89,
   "text": "יום אחד עם ישראל החליטו,"
  },
  {
   "start": 472.25,
   "end": 473.23,
   "text": "החלטה קצת מוזרה,"
  },
  {
   "start": 476.74,
   "end": 482.32,
   "text": "אמרו עם ישראל, רגע, אם יואש בקודש הקודשים נשאר והצליח לשרוד בקודש הקודשים,"
  },
  {
   "start": 482.98,
   "end": 483.56,
   "text": "כנראה הוא,"
  },
  {
   "start": 484.8,
   "end": 487.2,
   "text": "הוא בעצמו משהו מיוחד."
  },
  {
   "start": 487.98,
   "end": 489.04,
   "text": "צריך לעבוד אותו."
  },
  {
   "start": 490.04,
   "end": 491.78,
   "text": "צריך להשתחוות אליו,"
  },
  {
   "start": 492.32,
   "end": 493.46,
   "text": "צריך להתפלל אליו."
  },
  {
   "start": 494.56,
   "end": 498.66,
   "text": "ועם ישראל שוגה ויואש."
  },
  {
   "start": 499.22,
   "end": 500.92,
   "text": "יואש לא מנסה להעמיד אותם על הטעות שלהם."
  },
  {
   "start": 501.76,
   "end": 503.82,
   "text": "יואש התחיל בעצם למצוא חן בעיניו הרעיון."
  },
  {
   "start": 505.06,
   "end": 506.36,
   "text": "אולי באמת אני משהו מיוחד?"
  },
  {
   "start": 506.78,
   "end": 508.16,
   "text": "אולי אני באמת אדם עליון?"
  },
  {
   "start": 509.76,
   "end": 511.46,
   "text": "ומתחילים לעבוד את יואש."
  },
  {
   "start": 511.86,
   "end": 512.58,
   "text": "וזכריה הנביא,"
  },
  {
   "start": 513.64,
   "end": 514.46,
   "text": "הבן שלו ידע,"
  },
  {
   "start": 515.14,
   "end": 515.92,
   "text": "זה שהציל את יואש,"
  },
  {
   "start": 516.2,
   "end": 519.36,
   "text": "מתחנן בפני עם ישראל, אתם עושים טעות,"
  },
  {
   "start": 520.02,
   "end": 523.32,
   "text": "אבל אף אחד לא מוכן לשמוע אותו. הוא מנסה להוכיח את העם,"
  },
  {
   "start": 523.86,
   "end": 526.46,
   "text": "אבל אף אחד לא מוכן להתייחס אליו."
  },
  {
   "start": 526.78,
   "end": 528.38,
   "text": "הוא צועק, האמת איתו!"
  },
  {
   "start": 529.82,
   "end": 534.3,
   "text": "אבל כשיצר רע שולט בעולם, מי זוכר בכלל את יצר הטוב?"
  },
  {
   "start": 538.86,
   "end": 539.9,
   "text": "ואז יום אחד מגיע."
  },
  {
   "start": 541.48,
   "end": 542.5,
   "text": "מגיע יום הכיפורים"
  },
  {
   "start": 543.48,
   "end": 544.46,
   "text": "שחל בשבת,"
  },
  {
   "start": 547.0,
   "end": 553.3,
   "text": "וזכריה מנצל את הכינוס הגדול שהיה בבית המקדש לרגל יום הכיפורים שהיה בשבת,"
  },
  {
   "start": 554.56,
   "end": 555.2,
   "text": "ומתנבא,"
  },
  {
   "start": 555.98,
   "end": 557.62,
   "text": "ובא לכולם ואומר להם, תדעו לכם,"
  },
  {
   "start": 558.22,
   "end": 559.82,
   "text": "אם אתם תמשיכו עם ההתנהגות שלכם,"
  },
  {
   "start": 560.44,
   "end": 564.72,
   "text": "אם תמשיכו לעשות את מלך יהודה עבודה זרה, אם תמשיכו להתרחק מהשם,"
  },
  {
   "start": 566.06,
   "end": 568.16,
   "text": "עוד בית המקדש חס וחלילה ייחרב."
  },
  {
   "start": 570.74,
   "end": 572.36,
   "text": "אותם אנשים שהיו שם ממנהיגי העם,"
  },
  {
   "start": 573.56,
   "end": 574.48,
   "text": "כבר נמאס להם"
  },
  {
   "start": 575.26,
   "end": 578.0,
   "text": "מזכריה, שהיה כמו איזה תמרור של אזהרה,"
  },
  {
   "start": 578.64,
   "end": 580.6,
   "text": "תמרור של אמת בעיניים שלהם."
  },
  {
   "start": 582.44,
   "end": 583.48,
   "text": "פשוט התנפלו עליו"
  },
  {
   "start": 584.56,
   "end": 585.28,
   "text": "ורצחו אותו."
  },
  {
   "start": 586.3,
   "end": 586.78,
   "text": "כהן,"
  },
  {
   "start": 588.24,
   "end": 588.72,
   "text": "נביא,"
  },
  {
   "start": 589.88,
   "end": 593.14,
   "text": "ביום הכיפורים שחל להיות בשבת בבית המקדש."
  },
  {
   "start": 594.56,
   "end": 597.16,
   "text": "כשהם רצחו אותו, קרה דבר מזעזע,"
  },
  {
   "start": 597.88,
   "end": 598.86,
   "text": "קרה דבר מרתית,"
  },
  {
   "start": 601.45,
   "end": 601.89,
   "text": "הדם שלו."
  },
  {
   "start": 602.81,
   "end": 603.63,
   "text": "הדם שלו היה רותח,"
  },
  {
   "start": 604.47,
   "end": 605.35,
   "text": "הדם שלו נשפך,"
  },
  {
   "start": 605.91,
   "end": 609.75,
   "text": "שלולי דם התנגזה לה בבית המקדש ברצפה שם, ליד המזבח,"
  },
  {
   "start": 610.29,
   "end": 611.33,
   "text": "והדם החל מבעבע."
  },
  {
   "start": 611.83,
   "end": 613.67,
   "text": "כאילו ממש רותח עכשיו, מבעבע,"
  },
  {
   "start": 614.29,
   "end": 615.99,
   "text": "ואי אפשר, אי אפשר להרגיע אותו,"
  },
  {
   "start": 616.65,
   "end": 617.49,
   "text": "אי אפשר לצנן אותו."
  },
  {
   "start": 620.44,
   "end": 621.6,
   "text": "כמה שניסו לנקות,"
  },
  {
   "start": 622.24,
   "end": 623.14,
   "text": "כמה שניסו לשטוף,"
  },
  {
   "start": 623.68,
   "end": 624.12,
   "text": "אי אפשר."
  },
  {
   "start": 624.76,
   "end": 625.52,
   "text": "זה היה משהו מעל הטבע."
  },
  {
   "start": 626.58,
   "end": 629.84,
   "text": "כאילו נראה הדבר כמו שבורא עולם אומר לעם ישראל,"
  },
  {
   "start": 630.62,
   "end": 631.02,
   "text": "הגזמתם."
  },
  {
   "start": 631.74,
   "end": 632.56,
   "text": "כהן ונביא,"
  },
  {
   "start": 633.4,
   "end": 634.56,
   "text": "קצת קשה לכפר על זה."
  },
  {
   "start": 635.26,
   "end": 636.28,
   "text": "הדם הזה יהיה מול העיניים שלכם."
  },
  {
   "start": 637.52,
   "end": 638.08,
   "text": "לא עוד הרבה זמן."
  },
  {
   "start": 645.14,
   "end": 645.62,
   "text": "עברו שנים."
  },
  {
   "start": 647.2,
   "end": 648.54,
   "text": "עברו שנים, מלך בבל."
  },
  {
   "start": 649.5,
   "end": 651.2,
   "text": "מלך בבל נלחם בירושלים."
  },
  {
   "start": 651.92,
   "end": 654.78,
   "text": "נלחם בעם ישראל ומנצח. הוא כמעט שולט בכל העולם."
  },
  {
   "start": 655.52,
   "end": 656.62,
   "text": "קוראים לו נבוכדנצר."
  },
  {
   "start": 657.68,
   "end": 659.68,
   "text": "והוא שולח את שר הצבא שלו."
  },
  {
   "start": 660.66,
   "end": 662.12,
   "text": "שר הצבא שלו זה שר הטבחים."
  },
  {
   "start": 662.62,
   "end": 663.54,
   "text": "קראו לו נבוזרעדן."
  },
  {
   "start": 664.26,
   "end": 665.96,
   "text": "אתם יודעים מה זה שר הטבחים מלשון טבח?"
  },
  {
   "start": 666.68,
   "end": 667.24,
   "text": "היה רוצח מקצועי."
  },
  {
   "start": 668.16,
   "end": 672.02,
   "text": "עיר אחרי עיר נופלת בזרועותיו הרצחניות."
  },
  {
   "start": 672.58,
   "end": 674.6,
   "text": "הוא רוצח שם, הורג שם,"
  },
  {
   "start": 675.08,
   "end": 678.9,
   "text": "במלחמות 2.1 מיליון יהודים."
  },
  {
   "start": 680.48,
   "end": 682.46,
   "text": "עד שהוא מגיע בסוף לבית המקדש."
  },
  {
   "start": 683.44,
   "end": 685.44,
   "text": "וכשהוא נכנס לבית המקדש,"
  },
  {
   "start": 686.54,
   "end": 690.9,
   "text": "מה שהמראה שנקלט לו בעיניו"
  },
  {
   "start": 691.48,
   "end": 693.96,
   "text": "זו הייתה שלולית דם על הרצפה,"
  },
  {
   "start": 694.68,
   "end": 695.24,
   "text": "מבעבעת,"
  },
  {
   "start": 696.22,
   "end": 696.72,
   "text": "רותחת,"
  },
  {
   "start": 698.22,
   "end": 699.56,
   "text": "זה היה משהו לא טבעי."
  },
  {
   "start": 700.68,
   "end": 702.72,
   "text": "נבוזרדן הבין משהו מיוחד."
  },
  {
   "start": 703.46,
   "end": 703.88,
   "text": "מה זה פה?"
  },
  {
   "start": 704.6,
   "end": 706.38,
   "text": "הוא קרא למנהיגי ישראל, לסנהדרין,"
  },
  {
   "start": 706.76,
   "end": 708.42,
   "text": "אמר להם, תגידו לי, מה זה הדם הזה?"
  },
  {
   "start": 710.12,
   "end": 711.8,
   "text": "אז הם אמרו לו, תראה, זה דם של הקורבנות."
  },
  {
   "start": 713.36,
   "end": 716.32,
   "text": "חייך נבוזרדן חיוך מקפיא ואמר להם,"
  },
  {
   "start": 716.9,
   "end": 718.4,
   "text": "בדם, סוגי דם אני מומחה,"
  },
  {
   "start": 718.86,
   "end": 722.1,
   "text": "אני יודע להבדיל בין דם של קורבנות לדם של אדם."
  },
  {
   "start": 722.92,
   "end": 723.76,
   "text": "זה דם של אדם."
  },
  {
   "start": 723.84,
   "end": 724.38,
   "text": "אדם."
  },
  {
   "start": 725.32,
   "end": 727.52,
   "text": "והביאו פר ושחטו,"
  },
  {
   "start": 728.24,
   "end": 730.04,
   "text": "והוא הראה לה, אם אתם רואים אדם שונה,"
  },
  {
   "start": 730.76,
   "end": 732.64,
   "text": "לי אל תספרו סיפורים."
  },
  {
   "start": 734.08,
   "end": 736.16,
   "text": "ולא היה להם ברירה, הם סיפרו לו את האמת."
  },
  {
   "start": 737.16,
   "end": 739.44,
   "text": "אמרו לו, היה לנו פה כהן ונביא."
  },
  {
   "start": 741.4,
   "end": 743.32,
   "text": "לפני שנים שקראו לו זכריה,"
  },
  {
   "start": 743.94,
   "end": 747.98,
   "text": "והוא אמר עוד שאתה תבוא לפה ותהרוס את בית המקדש."
  },
  {
   "start": 749.08,
   "end": 751.66,
   "text": "ולא שמענו לו והתנפלנו ורצחנו אותו,"
  },
  {
   "start": 752.32,
   "end": 754.94,
   "text": "וזעתם שלו מבעבע מאז ועד היום."
  },
  {
   "start": 757.67,
   "end": 758.51,
   "text": "נבוזר אדם."
  },
  {
   "start": 760.29,
   "end": 761.81,
   "text": "אמר, אני ארגיע את הדם."
  },
  {
   "start": 762.77,
   "end": 764.83,
   "text": "זכריה הנביא, אני ארגיע את הדם שלך."
  },
  {
   "start": 765.49,
   "end": 766.71,
   "text": "אני אנקום את הנקמה שלך."
  },
  {
   "start": 767.83,
   "end": 769.27,
   "text": "וכמו איזה שליח שמבצע שליחות,"
  },
  {
   "start": 770.35,
   "end": 773.83,
   "text": "הוא לקח את הסנהדרין ושחט אותם שם."
  },
  {
   "start": 774.49,
   "end": 775.55,
   "text": "ולקח אחרי זה"
  },
  {
   "start": 777.51,
   "end": 780.65,
   "text": "תינוקות של בית רבן ושחט אותם."
  },
  {
   "start": 781.59,
   "end": 783.81,
   "text": "והדם לא נרגע."
  },
  {
   "start": 784.41,
   "end": 787.09,
   "text": "הוא לקח פרחי כהונה, כהנים צעירים,"
  },
  {
   "start": 787.97,
   "end": 789.09,
   "text": "והרג אותם שם."
  },
  {
   "start": 790.25,
   "end": 792.31,
   "text": "והדם לא נרגע."
  },
  {
   "start": 792.77,
   "end": 793.61,
   "text": "אמר, זה לא מרגיע."
  },
  {
   "start": 794.59,
   "end": 795.87,
   "text": "הלך עוד מעם ישראל."
  },
  {
   "start": 796.39,
   "end": 802.79,
   "text": "הלך ורצח ושחט 940 אלף יהודים."
  },
  {
   "start": 803.31,
   "end": 806.35,
   "text": "940 אלף יהודים."
  },
  {
   "start": 806.95,
   "end": 809.53,
   "text": "והדם לא נרגע."
  },
  {
   "start": 809.87,
   "end": 812.05,
   "text": "והדם לא נרגע."
  },
  {
   "start": 815.46,
   "end": 816.76,
   "text": "אמר נבוזר אדן,"
  },
  {
   "start": 817.76,
   "end": 819.2,
   "text": "כשראה את כל זה הוא הזדרזע."
  },
  {
   "start": 820.46,
   "end": 823.1,
   "text": "הוא אמר, תגיד לי, זכריה זכריה,"
  },
  {
   "start": 824.12,
   "end": 826.62,
   "text": "הרגתי טובים שבהם."
  },
  {
   "start": 827.18,
   "end": 830.0,
   "text": "את האנשים הטובים בעם ישראל אני הרגתי בשביל להרגיע,"
  },
  {
   "start": 830.5,
   "end": 831.58,
   "text": "בשביל לנקום את הנקמה שלך,"
  },
  {
   "start": 832.28,
   "end": 833.06,
   "text": "להרגיע את הדם שלך."
  },
  {
   "start": 834.08,
   "end": 834.58,
   "text": "נוח לך?"
  },
  {
   "start": 834.96,
   "end": 836.82,
   "text": "אתה רוצה שאני אהרוג את כל עם ישראל?"
  },
  {
   "start": 837.7,
   "end": 839.28,
   "text": "והדם נרגע."
  },
  {
   "start": 840.62,
   "end": 841.74,
   "text": "כאילו שמקו את זה."
  },
  {
   "start": 842.4,
   "end": 843.34,
   "text": "כאילו זכריה שמע."
  },
  {
   "start": 848.43,
   "end": 850.83,
   "text": "מה התוצאה של הרצח של זכריה?"
  },
  {
   "start": 853.05,
   "end": 861.43,
   "text": "שתי מיליון ומאה ועוד 940 אלף שלוש מיליון יהודים ויותר נהרגו, נרצחו."
  },
  {
   "start": 862.33,
   "end": 863.47,
   "text": "והאדם לא נרגע."
  },
  {
   "start": 864.67,
   "end": 869.13,
   "text": "עם ישראל בסוף שילם ביוקר על רצח הכהן והנביא."
  },
  {
   "start": 871.56,
   "end": 873.56,
   "text": "עכשיו אולי נבין מה קרה עם אהרן הכהן."
  },
  {
   "start": 874.7,
   "end": 877.54,
   "text": "אהרן הכהן, כשעם ישראל מתקרב אליו"
  },
  {
   "start": 877.94,
   "end": 882.66,
   "text": "ואומרים לו, תשמע, אם אתה לא תעזור לנו, אנחנו נרצח אותך, נהרוג אותך."
  },
  {
   "start": 883.22,
   "end": 887.34,
   "text": "אהרן הכהן ידע כמה עם ישראל ישלמו על זה."
  },
  {
   "start": 888.6,
   "end": 890.02,
   "text": "אם על זכריה הנביא,"
  },
  {
   "start": 891.44,
   "end": 894.98,
   "text": "לא כהן גדול, לא אהרן הכהן, זה זכריה, אחריו בהרבה."
  },
  {
   "start": 895.8,
   "end": 896.66,
   "text": "זה זכריה."
  },
  {
   "start": 897.36,
   "end": 901.3,
   "text": "אם על זכריה נהרגו כמה מיליונים,"
  },
  {
   "start": 902.2,
   "end": 904.22,
   "text": "כמה יהרגו על אהרן הכהן?"
  },
  {
   "start": 905.72,
   "end": 907.22,
   "text": "אז מה, שאהרן יהיה צדיק?"
  },
  {
   "start": 908.4,
   "end": 910.48,
   "text": "ועם ישראל יהרגו מיליונים?"
  },
  {
   "start": 910.94,
   "end": 912.16,
   "text": "אמר אהרון, לא."
  },
  {
   "start": 913.06,
   "end": 913.88,
   "text": "אני אלך!"
  },
  {
   "start": 914.96,
   "end": 916.82,
   "text": "אני אאבד אולי את העולם הבא שלי!"
  },
  {
   "start": 917.36,
   "end": 919.22,
   "text": "אני אאבד אולי את העולם הזה שלי!"
  },
  {
   "start": 920.88,
   "end": 924.82,
   "text": "אבל שערה מעם ישראל מיהודי אחד לא ייפול בגללי."
  },
  {
   "start": 925.98,
   "end": 926.54,
   "text": "אני מעדיף"
  },
  {
   "start": 927.12,
   "end": 929.42,
   "text": "שלנצח נצחים יהיה רשום בתורה,"
  },
  {
   "start": 929.94,
   "end": 932.42,
   "text": "אהרון הכהן עזר לעשות העגל."
  },
  {
   "start": 933.08,
   "end": 934.3,
   "text": "אבל שיהודי לא ייפגע."
  },
  {
   "start": 934.64,
   "end": 939.12,
   "text": "כאשר בורא העולם ראה את המסירות נפש הזו של אהרן הכהן,"
  },
  {
   "start": 939.68,
   "end": 942.68,
   "text": "אמר, אתה מוסר נפש למען הילדים שלי?"
  },
  {
   "start": 943.68,
   "end": 944.6,
   "text": "אתה זה שראוי!"
  },
  {
   "start": 945.28,
   "end": 953.0,
   "text": "אתה זה שראוי להיות כהן גדול! לכפר על כל עם ישראל! להיכנס ביום הכיפורים ולבקש כפרה לכל עם ישראל!"
  },
  {
   "start": 953.54,
   "end": 955.4,
   "text": "כי אתה מוכן למסור את עצמך!"
  },
  {
   "start": 955.72,
   "end": 959.26,
   "text": "למסור נפש! למסור נפש לילדים שלי!"
  },
  {
   "start": 962.49,
   "end": 966.63,
   "text": "בעולם ראה את המסירות נפש הזאת. אז במקום לכאורה לכעוס,"
  },
  {
   "start": 967.45,
   "end": 971.65,
   "text": "על אהרון אתה הולך לעזור לעשות עגל."
  },
  {
   "start": 972.11,
   "end": 975.67,
   "text": "אמר בורא העולם, אני אתן לך כהונת עולם."
  },
  {
   "start": 976.33,
   "end": 978.17,
   "text": "כי מסירות נפש זה דגל,"
  },
  {
   "start": 979.05,
   "end": 980.43,
   "text": "זה מראה על הנשמה של היהודי."
  },
  {
   "start": 981.13,
   "end": 982.71,
   "text": "וצריך לדעת, גם היום אנחנו פה."
  },
  {
   "start": 983.75,
   "end": 985.23,
   "text": "מסירות נפש זה כפרה."
  },
  {
   "start": 986.37,
   "end": 988.49,
   "text": "מסירות נפש, הכוח שלה לבטל גזרות,"
  },
  {
   "start": 989.23,
   "end": 990.59,
   "text": "לכפר על עם ישראל,"
  },
  {
   "start": 991.11,
   "end": 993.71,
   "text": "לגאול אותנו, זה מה שצריך האדם היום."
  },
  {
   "start": 994.25,
   "end": 997.55,
   "text": "והיום זכינו שאנחנו דור של מסירות נפש."
  },
  {
   "start": 998.09,
   "end": 999.01,
   "text": "דור של מסירות נפש."
  },
  {
   "start": 999.75,
   "end": 1001.91,
   "text": "היום אדם, כל צעד שלו צריך למסור נפש."
  },
  {
   "start": 1003.09,
   "end": 1004.69,
   "text": "בעבודה, בבית,"
  },
  {
   "start": 1005.81,
   "end": 1006.67,
   "text": "בבית הספר,"
  },
  {
   "start": 1007.39,
   "end": 1007.81,
   "text": "בכל."
  },
  {
   "start": 1008.43,
   "end": 1009.13,
   "text": "מסירות נפש."
  }
 ]
}