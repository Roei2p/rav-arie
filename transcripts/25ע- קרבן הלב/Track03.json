{
 "disc": "25ע- קרבן הלב",
 "track": "Track03",
 "duration": 937.176,
 "segments": [
  {
   "start": 11.81,
   "end": 12.45,
   "text": "הם עמדו להם"
  },
  {
   "start": 13.79,
   "end": 14.41,
   "text": "זה מול זה."
  },
  {
   "start": 15.97,
   "end": 16.95,
   "text": "תריסר לוחמים"
  },
  {
   "start": 18.73,
   "end": 19.67,
   "text": "מול תריסר לוחמים."
  },
  {
   "start": 21.69,
   "end": 22.11,
   "text": "בקרב,"
  },
  {
   "start": 23.09,
   "end": 23.67,
   "text": "קרב היסטורי,"
  },
  {
   "start": 24.81,
   "end": 27.09,
   "text": "שהחל כספורט,"
  },
  {
   "start": 28.35,
   "end": 28.91,
   "text": "כתחרות,"
  },
  {
   "start": 30.45,
   "end": 33.49,
   "text": "ונגמר במרחץ דמים."
  },
  {
   "start": 38.92,
   "end": 42.74,
   "text": "המקום בריכת גבעון שבארץ ישראל,"
  },
  {
   "start": 43.62,
   "end": 44.9,
   "text": "מקום די מרכזי באותה תקופה."
  },
  {
   "start": 45.36,
   "end": 46.74,
   "text": "התקופה,"
  },
  {
   "start": 47.4,
   "end": 48.36,
   "text": "תחילת מלכות דוד,"
  },
  {
   "start": 50.64,
   "end": 54.12,
   "text": "כאשר בנו של שאול מולך מולך גם הוא."
  },
  {
   "start": 59.63,
   "end": 64.49,
   "text": "זה מול זה עומדים להם מצד אחד אבנר בנר,"
  },
  {
   "start": 65.55,
   "end": 66.49,
   "text": "גיבור ישראל,"
  },
  {
   "start": 67.71,
   "end": 68.81,
   "text": "שר צבאו של שאול,"
  },
  {
   "start": 69.61,
   "end": 72.91,
   "text": "מהצד השני משפחת בן צרויה,"
  },
  {
   "start": 73.65,
   "end": 79.51,
   "text": "האחים יואב בן צרויה עם האחים שלו אבישי בן צרויה והאח הקטן עשאל בן צרויה."
  },
  {
   "start": 81.93,
   "end": 84.19,
   "text": "יואב בן זוהר הוא השר צבא של דוד."
  },
  {
   "start": 84.87,
   "end": 85.79,
   "text": "אבנר מציע תחרות,"
  },
  {
   "start": 87.09,
   "end": 90.29,
   "text": "תחרות של היאבקות בין תריסר נערים מכאן, מכל צד,"
  },
  {
   "start": 91.27,
   "end": 94.33,
   "text": "ואז אולי במקום להילחם באמת בין שני המחנות,"
  },
  {
   "start": 94.93,
   "end": 95.69,
   "text": "אנשי שאול,"
  },
  {
   "start": 97.09,
   "end": 99.01,
   "text": "או אנשי בנו של שאול יותר נכון, מאנשי דוד,"
  },
  {
   "start": 100.37,
   "end": 101.17,
   "text": "אולי זה יכריע."
  },
  {
   "start": 102.99,
   "end": 103.45,
   "text": "והקרב מתחיל."
  },
  {
   "start": 109.05,
   "end": 117.78,
   "text": "לא ידוע מי זה שהתחיל את המפנה הנורא הזה,"
  },
  {
   "start": 118.5,
   "end": 119.42,
   "text": "את המפנה האיום הזה."
  },
  {
   "start": 120.26,
   "end": 126.16,
   "text": "אבל עד מהרה הפך הקרב הזה מספורט למלחמה אכזרית."
  },
  {
   "start": 128.52,
   "end": 130.0,
   "text": "אחד עלם בשני באכזריות."
  },
  {
   "start": 131.04,
   "end": 132.46,
   "text": "אי אפשר היה לעצור את זה."
  },
  {
   "start": 133.42,
   "end": 134.52,
   "text": "כמו סופה אימתנית,"
  },
  {
   "start": 135.94,
   "end": 137.14,
   "text": "היצר הרע לקח את השלטון."
  },
  {
   "start": 139.44,
   "end": 146.02,
   "text": "מחולל הרס ואובדן חיים עם תוצאות טרגיות."
  },
  {
   "start": 151.04,
   "end": 153.24,
   "text": "תוצאות טרגיות עד מאוד."
  },
  {
   "start": 154.84,
   "end": 156.88,
   "text": "תריסר לוחמים מצד זה,"
  },
  {
   "start": 157.54,
   "end": 160.6,
   "text": "ועוד תריסר לוחמים מצד זה נהרגו."
  },
  {
   "start": 162.48,
   "end": 163.56,
   "text": "איש הרג את רעהו,"
  },
  {
   "start": 165.9,
   "end": 169.64,
   "text": "כמו כל קרב שבו בדרך כלל ישניהם מפסידים."
  },
  {
   "start": 173.62,
   "end": 176.46,
   "text": "וכשלכולם נגלם מרחץ הדמים הזה,"
  },
  {
   "start": 177.12,
   "end": 180.86,
   "text": "פרץ קרב קשה בין אנשי יואב לאנשי אבנר."
  },
  {
   "start": 187.82,
   "end": 189.78,
   "text": "ואבנר והאנשים שלו מובסים."
  },
  {
   "start": 190.74,
   "end": 193.32,
   "text": "אבנר בנר, שר צבא ישראל, לא נותרה לו ברירה,"
  },
  {
   "start": 193.9,
   "end": 194.32,
   "text": "אלא לסגת,"
  },
  {
   "start": 195.32,
   "end": 195.82,
   "text": "ובמהירות."
  },
  {
   "start": 202.58,
   "end": 204.02,
   "text": "אבנר בנר בורח."
  },
  {
   "start": 204.88,
   "end": 206.0,
   "text": "די לו בשפיכות הדמים"
  },
  {
   "start": 207.06,
   "end": 208.12,
   "text": "של יהודי ביהודי."
  },
  {
   "start": 208.86,
   "end": 209.32,
   "text": "מנקרת"
  },
  {
   "start": 209.98,
   "end": 210.68,
   "text": "המחשבה במוחו."
  },
  {
   "start": 211.7,
   "end": 212.44,
   "text": "הוא רץ במהירות,"
  },
  {
   "start": 213.98,
   "end": 215.34,
   "text": "כשהלב שלו מלא צער."
  },
  {
   "start": 217.69,
   "end": 219.57,
   "text": "ואז הוא שומע קול צעדים רצים אחריו."
  },
  {
   "start": 221.01,
   "end": 223.43,
   "text": "הוא מגביר את צעדיו, אבל הצעדים בעקבותיו."
  },
  {
   "start": 231.0,
   "end": 231.56,
   "text": "הוא מסתובב."
  },
  {
   "start": 233.61,
   "end": 236.23,
   "text": "הוא מסתובב ואז הוא רואה את עשהאל."
  },
  {
   "start": 237.23,
   "end": 239.41,
   "text": "את עשהאל בן צרויה, אחיו הצעיר"
  },
  {
   "start": 239.41,
   "end": 243.63,
   "text": "של יואב בן צרויה רודף אחריו"
  },
  {
   "start": 244.99,
   "end": 245.49,
   "text": "להרוג אותו."
  },
  {
   "start": 250.73,
   "end": 253.65,
   "text": "אבנר קורא לעשהאל, די, בוא נימנע."
  },
  {
   "start": 254.79,
   "end": 255.87,
   "text": "בוא נימנע משפיכות דמים."
  },
  {
   "start": 257.09,
   "end": 262.32,
   "text": "אתה זה עשהאל, אתה רוצה לשפוך דם. בבקשה, לא, די."
  },
  {
   "start": 263.98,
   "end": 266.4,
   "text": "אבל עשהאל מתעקש, הוא לא מרפא."
  },
  {
   "start": 267.48,
   "end": 268.14,
   "text": "בחור צעיר."
  },
  {
   "start": 269.74,
   "end": 270.98,
   "text": "הדם זורם בעורקיו."
  },
  {
   "start": 272.3,
   "end": 273.1,
   "text": "אבנר היה בטוח."
  },
  {
   "start": 273.98,
   "end": 278.22,
   "text": "אבנר היה בטוח אולי עשהאל למעשה לא יודע איך לצאת"
  },
  {
   "start": 278.9,
   "end": 280.18,
   "text": "בכבוד מהמרדף הזה."
  },
  {
   "start": 281.68,
   "end": 282.92,
   "text": "אז הוא מציע לו תוך כדי מרדף."
  },
  {
   "start": 284.7,
   "end": 285.42,
   "text": "צועק לו, תראה,"
  },
  {
   "start": 286.2,
   "end": 289.26,
   "text": "תפנה הצידה, תמשיך תרדוף אחרי אנשים אחרים, לא אחריי."
  },
  {
   "start": 290.44,
   "end": 291.44,
   "text": "תפוס לך איזה נער."
  },
  {
   "start": 292.14,
   "end": 294.42,
   "text": "אל תהרוג אותו, אבל תחזור עימו כשבוי,"
  },
  {
   "start": 294.9,
   "end": 297.48,
   "text": "ותחשב כגיבור אם אתה כל כך מעוניין להיות גיבור."
  },
  {
   "start": 299.0,
   "end": 301.18,
   "text": "אבל עשהאל מסרב."
  },
  {
   "start": 302.26,
   "end": 303.06,
   "text": "דבק במטרה."
  },
  {
   "start": 303.48,
   "end": 304.36,
   "text": "הוא רוצה את אבנר."
  },
  {
   "start": 307.62,
   "end": 308.26,
   "text": "עשהאל,"
  },
  {
   "start": 309.14,
   "end": 310.48,
   "text": "תתרחק אם אני אעזוב אותי."
  },
  {
   "start": 311.14,
   "end": 312.28,
   "text": "איך אני אוכל להביט ביואב?"
  },
  {
   "start": 313.9,
   "end": 315.98,
   "text": "איך אני אוכל להביט בפנים של אחיך?"
  },
  {
   "start": 320.03,
   "end": 320.97,
   "text": "אם אני אפגע בך,"
  },
  {
   "start": 321.57,
   "end": 323.19,
   "text": "אני מבקש ממך לחזור חזרה."
  },
  {
   "start": 324.69,
   "end": 325.39,
   "text": "אבל זה לא עוזר."
  },
  {
   "start": 326.55,
   "end": 327.53,
   "text": "עשהאל נחוש בהחלטתו."
  },
  {
   "start": 329.61,
   "end": 330.23,
   "text": "הוא או יהרוג"
  },
  {
   "start": 331.43,
   "end": 333.31,
   "text": "או ילכוד את אבנר."
  },
  {
   "start": 340.76,
   "end": 342.02,
   "text": "אבנר יודע שאין לו ברירה."
  },
  {
   "start": 343.48,
   "end": 344.18,
   "text": "ללכוד אותו,"
  },
  {
   "start": 345.8,
   "end": 347.26,
   "text": "הוא לא בטוח שהוא רוצה, עשהאל."
  },
  {
   "start": 347.76,
   "end": 349.02,
   "text": "אולי הוא מתכוון יותר להרוג אותו."
  },
  {
   "start": 350.14,
   "end": 350.96,
   "text": "יש פה דין רודף."
  },
  {
   "start": 352.02,
   "end": 352.7,
   "text": "אך אבנר מבין"
  },
  {
   "start": 355.43,
   "end": 356.71,
   "text": "לבסוף שעשהאל פשוט"
  },
  {
   "start": 357.27,
   "end": 357.69,
   "text": "באמת"
  },
  {
   "start": 358.29,
   "end": 359.31,
   "text": "מתכוון להרוג אותו,"
  },
  {
   "start": 360.05,
   "end": 361.69,
   "text": "כי הוא רודף ולא מוותר,"
  },
  {
   "start": 363.15,
   "end": 364.33,
   "text": "ומכין את כלי הנשק שלו."
  },
  {
   "start": 368.08,
   "end": 369.14,
   "text": "לאבנר לא הייתה ברירה."
  },
  {
   "start": 370.5,
   "end": 372.5,
   "text": "עשהאל לפתע החל מרגיש,"
  },
  {
   "start": 372.94,
   "end": 374.26,
   "text": "החל חש שהוא מקטין את המרחק,"
  },
  {
   "start": 374.68,
   "end": 375.9,
   "text": "את הפער בינו לבין אבנר."
  },
  {
   "start": 376.5,
   "end": 377.82,
   "text": "אז הוא החליט הגביר את המהירות שלו."
  },
  {
   "start": 379.36,
   "end": 379.74,
   "text": "מגביר."
  },
  {
   "start": 379.86,
   "end": 384.22,
   "text": "הנה עוד, עוד מטר, ועוד מטר, והוא כבר רואה את הגב של אבנר בקרבתו."
  },
  {
   "start": 385.0,
   "end": 385.66,
   "text": "עוד מטר."
  },
  {
   "start": 387.04,
   "end": 389.96,
   "text": "וכשעשהאל הבין שזה תחבולה,"
  },
  {
   "start": 390.64,
   "end": 394.1,
   "text": "שהוא נפל במלכודת, שאבנר הלוחם הוותיק,"
  },
  {
   "start": 396.5,
   "end": 398.26,
   "text": "טמן לו מלכודת בלית ברירה,"
  },
  {
   "start": 398.92,
   "end": 399.74,
   "text": "זה היה מאוחר מדי."
  },
  {
   "start": 400.94,
   "end": 402.24,
   "text": "אבנר הלוחם המנוסה,"
  },
  {
   "start": 402.92,
   "end": 403.76,
   "text": "לפתע נעצר,"
  },
  {
   "start": 404.4,
   "end": 405.8,
   "text": "וסובב אחורה את החנית שלו."
  },
  {
   "start": 407.16,
   "end": 409.56,
   "text": "ועשהאל, שהיה במרוצה קדימה,"
  },
  {
   "start": 410.34,
   "end": 410.72,
   "text": "נחת."
  },
  {
   "start": 411.44,
   "end": 412.38,
   "text": "הישר אל החנית."
  },
  {
   "start": 413.78,
   "end": 415.12,
   "text": "עשהאל נהרג במקום."
  },
  {
   "start": 419.54,
   "end": 420.22,
   "text": "עשהאל,"
  },
  {
   "start": 420.9,
   "end": 422.46,
   "text": "אחיו של יואב בן צרויה,"
  },
  {
   "start": 423.12,
   "end": 423.58,
   "text": "נהרג."
  },
  {
   "start": 424.44,
   "end": 426.0,
   "text": "לא הייתה אולי דרך אחרת"
  },
  {
   "start": 426.74,
   "end": 427.38,
   "text": "לעצור אותו."
  },
  {
   "start": 428.74,
   "end": 430.38,
   "text": "לא הייתה דרך אחרת לעצור אותו."
  },
  {
   "start": 449.16,
   "end": 450.1,
   "text": "עובר לו זמן,"
  },
  {
   "start": 451.12,
   "end": 451.42,
   "text": "זמן,"
  },
  {
   "start": 452.4,
   "end": 455.18,
   "text": "זמן לא קצר מהמקרה הטרגי הזה."
  },
  {
   "start": 457.56,
   "end": 459.64,
   "text": "הדברים משתנים בעם ישראל."
  },
  {
   "start": 462.05,
   "end": 462.79,
   "text": "דוד המלך,"
  },
  {
   "start": 464.11,
   "end": 465.73,
   "text": "מלכותו צוברת תאוצה."
  },
  {
   "start": 469.17,
   "end": 469.65,
   "text": "אבנר,"
  },
  {
   "start": 470.29,
   "end": 471.07,
   "text": "אבנר בנר,"
  },
  {
   "start": 471.73,
   "end": 472.73,
   "text": "שר צבא ישראל,"
  },
  {
   "start": 474.13,
   "end": 475.43,
   "text": "מצליח להתפייס עם דוד,"
  },
  {
   "start": 476.45,
   "end": 480.11,
   "text": "ולמעשה מנסה לאחד את כל עם ישראל סביב דוד המלך,"
  },
  {
   "start": 481.01,
   "end": 482.15,
   "text": "להקים את מלכות דוד,"
  },
  {
   "start": 482.69,
   "end": 484.61,
   "text": "שעם ישראל מחכה לה כל כך הרבה שנים."
  },
  {
   "start": 489.24,
   "end": 492.72,
   "text": "יואב בן צרויה, כששמע שדוד מתפייס עם אבנר,"
  },
  {
   "start": 493.76,
   "end": 496.52,
   "text": "הוא הזמין את אבנר לחברון, לשיחת שלום."
  },
  {
   "start": 497.2,
   "end": 498.4,
   "text": "הגיע הזמן שגם אנחנו"
  },
  {
   "start": 499.32,
   "end": 500.52,
   "text": "נעשה שלום בינינו"
  },
  {
   "start": 501.36,
   "end": 502.76,
   "text": "למען אחדות עם ישראל."
  },
  {
   "start": 505.2,
   "end": 506.64,
   "text": "ואבנר נעתר בשמחה."
  },
  {
   "start": 507.22,
   "end": 508.88,
   "text": "הנה זה הזמן ליישר את תעדורין,"
  },
  {
   "start": 513.07,
   "end": 514.25,
   "text": "והוא מגיע למקום, מגיע לחברון."
  },
  {
   "start": 518.64,
   "end": 520.24,
   "text": "כשהוא מגיע ומתחיל לדבר עם יואב,"
  },
  {
   "start": 521.16,
   "end": 521.46,
   "text": "יואב"
  },
  {
   "start": 522.14,
   "end": 523.08,
   "text": "מאשים את אבנר."
  },
  {
   "start": 523.64,
   "end": 524.7,
   "text": "למה הרגת את אח שלי?"
  },
  {
   "start": 525.86,
   "end": 527.02,
   "text": "למה הרגת את אח שלי?"
  },
  {
   "start": 528.2,
   "end": 530.04,
   "text": "מסביר לו אבנר, תבין, הוא רדף אחריי."
  },
  {
   "start": 531.3,
   "end": 532.92,
   "text": "לא הייתה לי ברירה, ניסיתי לדבר איתו,"
  },
  {
   "start": 533.52,
   "end": 534.32,
   "text": "ניסיתי לעצור אותו."
  },
  {
   "start": 535.22,
   "end": 536.62,
   "text": "ויואב ממשיך, אומר לו, תראה,"
  },
  {
   "start": 537.58,
   "end": 538.56,
   "text": "הוא ילד קטן עדיין."
  },
  {
   "start": 539.42,
   "end": 540.9,
   "text": "הוא אמנם, נכון, הוא אדם בוגר,"
  },
  {
   "start": 541.42,
   "end": 544.08,
   "text": "אבל הוא עדיין צעיר, הוא נחשב כמו ילד קטן לגביך."
  },
  {
   "start": 544.84,
   "end": 546.76,
   "text": "הוא לא לוחם כל כך מיומן כמוך."
  },
  {
   "start": 547.66,
   "end": 549.68,
   "text": "למה לא פצעת אותו?"
  },
  {
   "start": 550.78,
   "end": 553.02,
   "text": "למה היית פוצע אותו? למה הרגת אותו?"
  },
  {
   "start": 555.1,
   "end": 557.66,
   "text": "ואבנר אומר לו, תראה, יואב, לא יכלתי לכוון."
  },
  {
   "start": 558.22,
   "end": 560.08,
   "text": "זה היה מאחורה, הוא בא מאחורה."
  },
  {
   "start": 560.62,
   "end": 562.56,
   "text": "אם היה מקדימה הייתי מכוון, לא יכלתי."
  },
  {
   "start": 563.88,
   "end": 564.42,
   "text": "לא יכלתי."
  },
  {
   "start": 566.91,
   "end": 568.13,
   "text": "ומדברים, ומסביר."
  },
  {
   "start": 568.63,
   "end": 572.09,
   "text": "ואבנר מסביר בעדינות ליואב את המצב,"
  },
  {
   "start": 572.99,
   "end": 574.47,
   "text": "והוא רואה מבט של ההבנה אצל יואב."
  },
  {
   "start": 575.37,
   "end": 576.45,
   "text": "קצת מתחיל לרגע, הנה,"
  },
  {
   "start": 577.11,
   "end": 577.53,
   "text": "הנה עכשיו"
  },
  {
   "start": 578.05,
   "end": 579.71,
   "text": "זה הזמן אולי באמת סוף סוף"
  },
  {
   "start": 581.03,
   "end": 582.37,
   "text": "למפגש ככה לעשות"
  },
  {
   "start": 583.15,
   "end": 583.67,
   "text": "שלום"
  },
  {
   "start": 584.41,
   "end": 585.53,
   "text": "להרבות שלום בעם ישראל."
  },
  {
   "start": 589.42,
   "end": 589.78,
   "text": "אבל אז,"
  },
  {
   "start": 590.74,
   "end": 591.86,
   "text": "לפתח תוך דיבור,"
  },
  {
   "start": 593.14,
   "end": 594.24,
   "text": "כשאבנר לא היה מרוכז,"
  },
  {
   "start": 594.64,
   "end": 596.58,
   "text": "כשאבנר עשה איזה פעולה מסוימת,"
  },
  {
   "start": 597.68,
   "end": 598.58,
   "text": "יואב בן צרויה,"
  },
  {
   "start": 599.24,
   "end": 600.4,
   "text": "בתנועה חדה ומהירה,"
  },
  {
   "start": 600.84,
   "end": 604.98,
   "text": "תקף ופגע בחרב, בחרב שלו ישירות"
  },
  {
   "start": 605.68,
   "end": 606.42,
   "text": "בלבו של אבנר."
  },
  {
   "start": 607.3,
   "end": 609.58,
   "text": "אבנר חש את עוצמת המכה."
  },
  {
   "start": 609.96,
   "end": 610.3,
   "text": "אבנר"
  },
  {
   "start": 611.06,
   "end": 611.98,
   "text": "ידע להבחין,"
  },
  {
   "start": 612.64,
   "end": 616.46,
   "text": "ידע לחוש מה זו מכה קטלנית ומה זו לא."
  },
  {
   "start": 617.4,
   "end": 617.8,
   "text": "הוא ידע,"
  },
  {
   "start": 618.76,
   "end": 619.88,
   "text": "ללא קול צל של ספק,"
  },
  {
   "start": 621.5,
   "end": 622.78,
   "text": "שהמכה הייתה קטלנית."
  },
  {
   "start": 624.82,
   "end": 625.2,
   "text": "הוא הבין"
  },
  {
   "start": 626.62,
   "end": 629.64,
   "text": "שהוא אהב תמן לו מלכודת, שהוא אהב בלינקום,"
  },
  {
   "start": 630.64,
   "end": 632.36,
   "text": "והוא מבין שעכשיו הוא עומד למות."
  },
  {
   "start": 634.12,
   "end": 635.16,
   "text": "אבל אז אבנר בנר,"
  },
  {
   "start": 635.84,
   "end": 637.46,
   "text": "שהיה לו עוצמה של פלדה,"
  },
  {
   "start": 638.44,
   "end": 641.8,
   "text": "בשארית כוחותיו הוא מצליח לתפוס את יואב."
  },
  {
   "start": 642.5,
   "end": 644.6,
   "text": "אבנר חזק מאוד ולופת את יואב."
  },
  {
   "start": 645.9,
   "end": 648.54,
   "text": "לופת את הרוצח שלו בשתי ידיו."
  },
  {
   "start": 649.32,
   "end": 650.78,
   "text": "את האיש שטמן לו מלכודת."
  },
  {
   "start": 651.32,
   "end": 653.3,
   "text": "את האיש שלמעשה לא היה מוכן לוותר."
  },
  {
   "start": 653.86,
   "end": 655.78,
   "text": "לא היה מוכן לשוחח. הוא בא להרוג אותו."
  },
  {
   "start": 657.48,
   "end": 658.62,
   "text": "ועכשיו הרוצח הזה"
  },
  {
   "start": 658.62,
   "end": 660.46,
   "text": "בידיים שלו."
  },
  {
   "start": 663.54,
   "end": 668.16,
   "text": "אתה מבין שאתה הולך למות והרוצח שלך בידיים שלך."
  },
  {
   "start": 671.01,
   "end": 671.73,
   "text": "מה אתה עושה?"
  },
  {
   "start": 679.55,
   "end": 682.81,
   "text": "אבל אז מתקרבים אל המחזה המרטיט הזה,"
  },
  {
   "start": 683.95,
   "end": 685.37,
   "text": "אל המחזה הדרמטי הזה."
  },
  {
   "start": 687.11,
   "end": 689.83,
   "text": "בני ישראל, עם ישראל קדושים,"
  },
  {
   "start": 691.03,
   "end": 692.81,
   "text": "קהל של יהודים פשוטים,"
  },
  {
   "start": 695.26,
   "end": 696.86,
   "text": "ומתחילים להתחנן"
  },
  {
   "start": 698.2,
   "end": 698.84,
   "text": "אל אבנר,"
  },
  {
   "start": 699.84,
   "end": 701.44,
   "text": "שעומד בשארית כוחותיו."
  },
  {
   "start": 703.32,
   "end": 705.74,
   "text": "כל שנייה מקרבת אותו אל מותו,"
  },
  {
   "start": 706.66,
   "end": 708.1,
   "text": "ועם ישראל מתחננים,"
  },
  {
   "start": 708.9,
   "end": 709.42,
   "text": "תניח,"
  },
  {
   "start": 710.16,
   "end": 712.1,
   "text": "תעזוב את יואב, תוותר לו,"
  },
  {
   "start": 712.86,
   "end": 713.5,
   "text": "אל תהרוג אותו,"
  },
  {
   "start": 714.42,
   "end": 715.38,
   "text": "אפילו שהוא לא בסדר,"
  },
  {
   "start": 716.4,
   "end": 717.5,
   "text": "כי אנחנו צריכים אותו."
  },
  {
   "start": 718.38,
   "end": 721.0,
   "text": "כי אם גם הוא ימות, מי יהיה לנו שר צבא?"
  },
  {
   "start": 721.6,
   "end": 723.14,
   "text": "כי מסביב יש לנו את פלישתים,"
  },
  {
   "start": 724.22,
   "end": 725.34,
   "text": "את פלסטין שמה,"
  },
  {
   "start": 725.88,
   "end": 727.88,
   "text": "את הפלישתים שעושים לנו צרות,"
  },
  {
   "start": 728.42,
   "end": 729.7,
   "text": "שרוצים להרוג אותנו."
  },
  {
   "start": 730.12,
   "end": 731.72,
   "text": "מי ינהיג אותנו במלחמה?"
  },
  {
   "start": 732.28,
   "end": 733.86,
   "text": "עכשיו אתה הולך למות"
  },
  {
   "start": 735.56,
   "end": 737.72,
   "text": "וגם יואב ימותמיא יהיה איתנו."
  },
  {
   "start": 740.2,
   "end": 745.16,
   "text": "ההיגיון אומר אותי, זה לא מעניין, אני הולך למות, אני אקח אותו איתי, מה אכפת לי?"
  },
  {
   "start": 746.32,
   "end": 747.82,
   "text": "הם לא דואגים לי!"
  },
  {
   "start": 749.28,
   "end": 750.6,
   "text": "זה ההיגיון אומר."
  },
  {
   "start": 751.32,
   "end": 752.54,
   "text": "אבל יהודי הוא מעל ההיגיון."
  },
  {
   "start": 754.46,
   "end": 755.46,
   "text": "הכל מתערפל"
  },
  {
   "start": 756.24,
   "end": 757.16,
   "text": "סביב אבנר,"
  },
  {
   "start": 757.78,
   "end": 759.22,
   "text": "הרוצח בידיים שלו."
  },
  {
   "start": 760.02,
   "end": 766.9,
   "text": "מביט בו בעיניים מתחננות מסביב קולות של יהודים שמבקשים חנינה כי צריך אותו."
  },
  {
   "start": 768.1,
   "end": 769.4,
   "text": "אבנר בנר עומד,"
  },
  {
   "start": 770.24,
   "end": 774.58,
   "text": "איזו עבודת מידות, יואב לפוט בידיו,"
  },
  {
   "start": 775.24,
   "end": 777.7,
   "text": "אני יכול באבחה אחת להרוג אותו,"
  },
  {
   "start": 779.1,
   "end": 782.38,
   "text": "אבל כל עם ישראל מבקשים, עם ישראל צריך"
  },
  {
   "start": 782.92,
   "end": 784.2,
   "text": "טובת ישראל."
  },
  {
   "start": 787.53,
   "end": 788.55,
   "text": "ואבנר בנר,"
  },
  {
   "start": 790.84,
   "end": 792.94,
   "text": "גדול, עצום,"
  },
  {
   "start": 795.76,
   "end": 796.58,
   "text": "מביט ביואב,"
  },
  {
   "start": 797.92,
   "end": 800.18,
   "text": "ולמען עם ישראל,"
  },
  {
   "start": 801.56,
   "end": 803.34,
   "text": "למען הבנים של השם יתברך,"
  },
  {
   "start": 804.16,
   "end": 806.9,
   "text": "לעשות נחת רוח להשם יתברך,"
  },
  {
   "start": 808.56,
   "end": 809.92,
   "text": "שומט את יואב,"
  },
  {
   "start": 811.28,
   "end": 814.64,
   "text": "נותן לו את החיים שלו במתנה לרוצח שלו,"
  },
  {
   "start": 815.9,
   "end": 817.16,
   "text": "כדי שעם ישראל"
  },
  {
   "start": 818.08,
   "end": 819.26,
   "text": "יוכל לחיות בשלום."
  },
  {
   "start": 821.16,
   "end": 822.68,
   "text": "שניות ספורות אחר כך"
  },
  {
   "start": 822.68,
   "end": 834.91,
   "text": "כורע אבנר בנר על ברכיו ונופל למען עם ישראל,"
  },
  {
   "start": 836.47,
   "end": 837.89,
   "text": "למען שארית ישראל."
  },
  {
   "start": 839.87,
   "end": 843.05,
   "text": "גם אנחנו היום למען עם ישראל,"
  },
  {
   "start": 844.23,
   "end": 845.77,
   "text": "למען שארית ישראל,"
  },
  {
   "start": 846.47,
   "end": 847.41,
   "text": "גם אם קשה לנו,"
  },
  {
   "start": 848.01,
   "end": 848.97,
   "text": "גם אם יש לנו טענות,"
  },
  {
   "start": 850.07,
   "end": 851.51,
   "text": "גם אם לא משנה מה קורה,"
  },
  {
   "start": 852.03,
   "end": 854.85,
   "text": "גם אם אנחנו מקבלים מכות על ימין ועל שמאל,"
  },
  {
   "start": 855.51,
   "end": 856.65,
   "text": "רק למסור נפש,"
  },
  {
   "start": 857.23,
   "end": 857.93,
   "text": "רק למסור נפש."
  },
  {
   "start": 858.93,
   "end": 860.97,
   "text": "תגידו לי איך אנחנו נעמוד, הרי עוד מעט בא משיח."
  },
  {
   "start": 861.67,
   "end": 864.13,
   "text": "נצטרך אנחנו, עם כל הקליפות שלנו,"
  },
  {
   "start": 864.53,
   "end": 865.69,
   "text": "עם כל מה שקורה ברחובות,"
  },
  {
   "start": 866.37,
   "end": 867.63,
   "text": "עם כל מה שקורה היום,"
  },
  {
   "start": 867.95,
   "end": 872.81,
   "text": "עם כל הקשיים שלנו, כל התשובה שלנו, לבוא ולעמוד מול רבי שמעון בר יוחאי."
  },
  {
   "start": 873.57,
   "end": 876.01,
   "text": "יקומו כל המתים, הרבי שמעון בר יוחאי, החפץ חיים."
  },
  {
   "start": 877.25,
   "end": 884.01,
   "text": "הגאון מווילנה, אהרן הכהן, משה רבנו, מרים הנביאה, שרה אימנו, רחל אימנו, יעקב, יעקב,"
  },
  {
   "start": 884.53,
   "end": 885.67,
   "text": "רבי עקיבא!"
  },
  {
   "start": 886.47,
   "end": 887.75,
   "text": "איך נעמוד לידם?"
  },
  {
   "start": 888.29,
   "end": 891.81,
   "text": "איך נלחץ להם ידיים? איך נשב איתם במחיצתם?"
  },
  {
   "start": 893.17,
   "end": 895.45,
   "text": "בעולם שכולו טוב, בעולם פה?"
  },
  {
   "start": 896.71,
   "end": 899.57,
   "text": "בזכות המסירות נפש, דווקא ברגעים האלה,"
  },
  {
   "start": 900.15,
   "end": 901.17,
   "text": "הרגעים הקשים האלה,"
  },
  {
   "start": 905.15,
   "end": 906.11,
   "text": "אבנר בנר"
  },
  {
   "start": 906.97,
   "end": 909.83,
   "text": "הוכיח לכל עם ישראל שגם על המידות,"
  },
  {
   "start": 910.53,
   "end": 912.75,
   "text": "גם כשאתה כועס, גם כשאתה פגוע,"
  },
  {
   "start": 913.27,
   "end": 915.47,
   "text": "גם כשאתה לא יודע, בצער גדול,"
  },
  {
   "start": 916.19,
   "end": 919.35,
   "text": "אסור לנו לשכוח את עם ישראל,"
  },
  {
   "start": 919.87,
   "end": 921.75,
   "text": "ועיני עם ישראל תלויות אלינו."
  },
  {
   "start": 922.89,
   "end": 925.51,
   "text": "ועיני עם ישראל תלויות בנו, תזכרו, תדעו לכם,"
  },
  {
   "start": 926.03,
   "end": 928.35,
   "text": "מי מצפים, ממי מצפים, מאיתנו, מאיתנו,"
  },
  {
   "start": 929.67,
   "end": 932.55,
   "text": "ממך, ממך, ממני, מכולנו,"
  },
  {
   "start": 933.41,
   "end": 934.65,
   "text": "כל עם ישראל הקדושים."
  }
 ]
}