{
 "disc": "25ע- קרבן הלב",
 "track": "Track04",
 "duration": 1346.184,
 "segments": [
  {
   "start": 8.42,
   "end": 9.2,
   "text": "העיירה זלוטשוב."
  },
  {
   "start": 10.36,
   "end": 11.16,
   "text": "הרביני זלוטשוב."
  },
  {
   "start": 12.06,
   "end": 13.04,
   "text": "היה אהוב על הקהילה שלו."
  },
  {
   "start": 14.34,
   "end": 15.38,
   "text": "היה צדיק, תמים,"
  },
  {
   "start": 15.98,
   "end": 16.78,
   "text": "מופרש,"
  },
  {
   "start": 17.8,
   "end": 19.58,
   "text": "כמעט מופרש מכל ענייני העולם הזה."
  },
  {
   "start": 21.04,
   "end": 22.16,
   "text": "כולם העריצו אותו,"
  },
  {
   "start": 23.0,
   "end": 23.96,
   "text": "כולם כיבדו אותו."
  },
  {
   "start": 25.64,
   "end": 27.42,
   "text": "למעשה אולי, אולי לא כולם."
  },
  {
   "start": 28.7,
   "end": 29.7,
   "text": "הייתה משפחה אחת"
  },
  {
   "start": 32.47,
   "end": 33.89,
   "text": "שלא כיבדה, היא לא כיבדה אף,"
  },
  {
   "start": 34.51,
   "end": 35.01,
   "text": "אף אדם."
  },
  {
   "start": 36.69,
   "end": 38.19,
   "text": "זו המשפחה של שבתאי הקצב."
  },
  {
   "start": 40.15,
   "end": 42.47,
   "text": "שבתאי הקצב והבנים שלו."
  },
  {
   "start": 44.41,
   "end": 49.66,
   "text": "הם היו בריונים שהטילו טרור על כל עיירה זלוטשוב."
  },
  {
   "start": 50.28,
   "end": 51.1,
   "text": "כולם פחדו ממנו."
  },
  {
   "start": 52.88,
   "end": 55.7,
   "text": "כולם ידעו ששבתאי רוצה רב אחר."
  },
  {
   "start": 56.74,
   "end": 57.62,
   "text": "רב שיתפשר יותר."
  },
  {
   "start": 58.82,
   "end": 60.2,
   "text": "רב שיותר בעניינים."
  },
  {
   "start": 61.18,
   "end": 62.1,
   "text": "רב יותר מודרני."
  },
  {
   "start": 64.31,
   "end": 65.61,
   "text": "יעזור לו אולי לעסקים."
  },
  {
   "start": 67.55,
   "end": 68.63,
   "text": "לשיווק המאסר."
  },
  {
   "start": 71.81,
   "end": 72.31,
   "text": "וככה,"
  },
  {
   "start": 72.85,
   "end": 74.07,
   "text": "שעת לילה מאוחרת,"
  },
  {
   "start": 75.41,
   "end": 76.13,
   "text": "בבית של הרב,"
  },
  {
   "start": 78.43,
   "end": 78.91,
   "text": "ולפתע"
  },
  {
   "start": 79.85,
   "end": 80.99,
   "text": "החלון התנפץ לו"
  },
  {
   "start": 81.79,
   "end": 84.51,
   "text": "מאבן כבדה שנזרקה לעברו,"
  },
  {
   "start": 86.97,
   "end": 87.85,
   "text": "והאבן מונחת לה"
  },
  {
   "start": 89.95,
   "end": 91.15,
   "text": "במרכז הסלון."
  },
  {
   "start": 92.61,
   "end": 93.13,
   "text": "בני הבית,"
  },
  {
   "start": 95.32,
   "end": 96.08,
   "text": "משפחת הרב,"
  },
  {
   "start": 97.28,
   "end": 98.38,
   "text": "התכווצו בפחד."
  },
  {
   "start": 100.75,
   "end": 103.05,
   "text": "הם לא רגילים למראות שכאלה."
  },
  {
   "start": 104.43,
   "end": 106.71,
   "text": "והרב שישב ולמד באותה שעה,"
  },
  {
   "start": 108.27,
   "end": 109.21,
   "text": "הרים את הראש שלו,"
  },
  {
   "start": 110.21,
   "end": 113.61,
   "text": "הביט מהורהר בחלון וחזר ללמוד."
  },
  {
   "start": 115.88,
   "end": 118.32,
   "text": "כולם ידעו במי מדובר."
  },
  {
   "start": 119.06,
   "end": 120.64,
   "text": "כולם ידעו מי זרק את האבן."
  },
  {
   "start": 123.55,
   "end": 124.37,
   "text": "שבתאי הקצב"
  },
  {
   "start": 125.89,
   "end": 126.75,
   "text": "והבנים שלו"
  },
  {
   "start": 128.43,
   "end": 129.03,
   "text": "מאיימים"
  },
  {
   "start": 129.87,
   "end": 130.41,
   "text": "על הרב"
  },
  {
   "start": 131.39,
   "end": 132.03,
   "text": "שמקפיד"
  },
  {
   "start": 133.21,
   "end": 134.87,
   "text": "יותר מדי לטעמם בענייני הכשרות."
  },
  {
   "start": 138.01,
   "end": 139.95,
   "text": "וככה מתנהלים להם החיים בעיר זלוטשוב,"
  },
  {
   "start": 140.47,
   "end": 144.85,
   "text": "עיר שלמה והרב שלה סובלים בדממה"
  },
  {
   "start": 145.65,
   "end": 146.67,
   "text": "משבתאי הקצב"
  },
  {
   "start": 147.47,
   "end": 148.33,
   "text": "והבנים שלו שמאיימים,"
  },
  {
   "start": 150.71,
   "end": 153.11,
   "text": "שדוחפים, שדורסים את כל מי שעומד מולם."
  },
  {
   "start": 158.07,
   "end": 158.99,
   "text": "אני נוסע לססוב,"
  },
  {
   "start": 161.06,
   "end": 161.6,
   "text": "אמר הרב,"
  },
  {
   "start": 162.2,
   "end": 163.24,
   "text": "בנפרד ממשפחתו."
  },
  {
   "start": 169.08,
   "end": 170.2,
   "text": "כבוד הרב, אולי תבקש"
  },
  {
   "start": 171.2,
   "end": 172.4,
   "text": "מהרבי מססוב"
  },
  {
   "start": 173.48,
   "end": 177.24,
   "text": "שיתפלל ויברך את כל העיר הזו שניפטר מההצהרה הזאת."
  },
  {
   "start": 177.76,
   "end": 182.18,
   "text": "ביקשה אשתו המיוסרת של הרב,"
  },
  {
   "start": 184.53,
   "end": 184.89,
   "text": "וכך"
  },
  {
   "start": 187.06,
   "end": 187.88,
   "text": "עלה לססוב,"
  },
  {
   "start": 189.92,
   "end": 191.36,
   "text": "הרב שזלוצ'וב וביקש."
  },
  {
   "start": 192.78,
   "end": 193.48,
   "text": "ואתם יודעים מה?"
  },
  {
   "start": 194.36,
   "end": 194.86,
   "text": "זה קרה."
  },
  {
   "start": 196.46,
   "end": 199.9,
   "text": "יום אחד מחליט לו שבתא יא קצב, לעקור,"
  },
  {
   "start": 200.6,
   "end": 201.6,
   "text": "לעקור לעיר ברודי,"
  },
  {
   "start": 202.0,
   "end": 203.18,
   "text": "שם הוא יצליח בעסקים,"
  },
  {
   "start": 203.52,
   "end": 205.38,
   "text": "נמאס לו מהעיירה הזאת, הקטנה הזאת."
  },
  {
   "start": 208.11,
   "end": 208.89,
   "text": "הוא אמר ועשה,"
  },
  {
   "start": 209.63,
   "end": 211.83,
   "text": "וכל העיר זלוצ'וב צהלה וסמך."
  },
  {
   "start": 212.91,
   "end": 213.53,
   "text": "איזו שמחה."
  },
  {
   "start": 214.81,
   "end": 216.17,
   "text": "עברה לה שנה שלמה."
  },
  {
   "start": 217.25,
   "end": 218.07,
   "text": "הרבי מזלוטשוב"
  },
  {
   "start": 218.83,
   "end": 221.17,
   "text": "מתארח בססוב לשבת."
  },
  {
   "start": 222.01,
   "end": 222.39,
   "text": "בססוב"
  },
  {
   "start": 222.99,
   "end": 224.39,
   "text": "היה רב, רבו,"
  },
  {
   "start": 225.47,
   "end": 226.11,
   "text": "רבי משה"
  },
  {
   "start": 227.13,
   "end": 228.43,
   "text": "לייב מססוב,"
  },
  {
   "start": 233.18,
   "end": 235.08,
   "text": "הצדיק הקדוש אוהבם של ישראל."
  },
  {
   "start": 236.1,
   "end": 239.42,
   "text": "איזו שבת של נפלאה של קדושה, איזו שבת של דרומות הרוח."
  },
  {
   "start": 241.32,
   "end": 241.86,
   "text": "אבל לפתע,"
  },
  {
   "start": 244.02,
   "end": 245.14,
   "text": "הרבי מזלוטשוב נדרך."
  },
  {
   "start": 245.92,
   "end": 248.64,
   "text": "עיניו קלטו את דמותו של אחד העורכים,"
  },
  {
   "start": 248.96,
   "end": 249.58,
   "text": "דמות מוכרת."
  },
  {
   "start": 250.9,
   "end": 252.44,
   "text": "הוא שפשף את עיניו לא להאמין."
  },
  {
   "start": 253.24,
   "end": 253.46,
   "text": "זהו?"
  },
  {
   "start": 254.44,
   "end": 255.18,
   "text": "זה שבתאי."
  },
  {
   "start": 256.24,
   "end": 257.2,
   "text": "זה שבתאי הקצב."
  },
  {
   "start": 259.51,
   "end": 262.33,
   "text": "מה יש לאדם שכזה אצל הרב?"
  },
  {
   "start": 263.15,
   "end": 265.47,
   "text": "מה יש לאדם כזה אצל הרב שלי?"
  },
  {
   "start": 267.6,
   "end": 270.06,
   "text": "וברקע לפתע נשמע קולו של הגבאי."
  },
  {
   "start": 270.92,
   "end": 272.5,
   "text": "רבי שבתאי מברודי"
  },
  {
   "start": 273.08,
   "end": 274.26,
   "text": "יבוא לקבל ברכה."
  },
  {
   "start": 277.37,
   "end": 279.43,
   "text": "הוא חש שראשו סחרחר עליו."
  },
  {
   "start": 279.97,
   "end": 280.55,
   "text": "איך יכול להיות?"
  },
  {
   "start": 281.65,
   "end": 282.49,
   "text": "רבי שמשון,"
  },
  {
   "start": 283.09,
   "end": 285.17,
   "text": "בנו של רבי שבתאי הקצב,"
  },
  {
   "start": 286.99,
   "end": 291.19,
   "text": "יבוא לקבל ברכה, רבי שלמה רבי מזלושוב התיישב,"
  },
  {
   "start": 291.91,
   "end": 293.17,
   "text": "לא מבין, לא מאמין,"
  },
  {
   "start": 295.8,
   "end": 297.22,
   "text": "וככה שהוא יושב מסוחרר,"
  },
  {
   "start": 298.2,
   "end": 298.88,
   "text": "לא מבין,"
  },
  {
   "start": 299.58,
   "end": 300.8,
   "text": "לפתע העיניים שלו נתקלו"
  },
  {
   "start": 301.8,
   "end": 302.64,
   "text": "בעיני הצדיק,"
  },
  {
   "start": 305.45,
   "end": 306.55,
   "text": "בעיני הצדיק מססוב,"
  },
  {
   "start": 307.57,
   "end": 309.39,
   "text": "שהביטו אליו מי חייכות"
  },
  {
   "start": 310.35,
   "end": 311.07,
   "text": "באור מיוחד."
  },
  {
   "start": 313.83,
   "end": 315.23,
   "text": "אבל זה עדיין לא נגמר."
  },
  {
   "start": 316.01,
   "end": 316.79,
   "text": "מוצאי שבת,"
  },
  {
   "start": 317.51,
   "end": 319.81,
   "text": "אחרי ההבדלה, ניגש שבתאי."
  },
  {
   "start": 320.29,
   "end": 321.43,
   "text": "זה שבתאי הביריון."
  },
  {
   "start": 322.65,
   "end": 326.87,
   "text": "זה שהטיל אימה ופחד. זה שהטיל טרור. זה שלא היה אכפת לו מתורה ומצוות."
  },
  {
   "start": 329.28,
   "end": 330.22,
   "text": "בא לרב"
  },
  {
   "start": 330.82,
   "end": 331.54,
   "text": "מססוב"
  },
  {
   "start": 334.0,
   "end": 338.56,
   "text": "ומבקש ממנו ברכה. אני מבקש ברכה. אני רוצה לחזור לעיר זלוטשוב, שם הייתי."
  },
  {
   "start": 339.72,
   "end": 341.26,
   "text": "והוא מקבל ברכה חמה מהצדיק."
  },
  {
   "start": 342.66,
   "end": 344.4,
   "text": "לחזור לעיר זלוטשוב, אני לא מאמין."
  },
  {
   "start": 344.4,
   "end": 346.4,
   "text": "ספג כפיו."
  },
  {
   "start": 347.44,
   "end": 349.96,
   "text": "הרב מזלוטשוב, הוא יותר לא יכל להחזיק מעמד."
  },
  {
   "start": 350.56,
   "end": 351.34,
   "text": "הוא נכנס לרב שלו."
  },
  {
   "start": 351.82,
   "end": 352.82,
   "text": "כבוד הרב, אני רוצה לדבר איתך."
  },
  {
   "start": 353.36,
   "end": 353.84,
   "text": "כבוד הרב,"
  },
  {
   "start": 354.24,
   "end": 359.0,
   "text": "כבוד הרב, אני באתי והייתי מתחנן שנים על אותו קצב, זה אותו קצב שעשה לי כל כך הרבה צרות,"
  },
  {
   "start": 359.38,
   "end": 362.36,
   "text": "ועכשיו הרב מברך אותו ומכבד אותו כל כך, מה קורה פה?"
  },
  {
   "start": 366.71,
   "end": 367.53,
   "text": "והרב מיססוב"
  },
  {
   "start": 368.23,
   "end": 369.95,
   "text": "מסתכל בעיניו הקדושות"
  },
  {
   "start": 372.51,
   "end": 376.8,
   "text": "ואומר בטח יודע,"
  },
  {
   "start": 377.38,
   "end": 379.48,
   "text": "בני אתה בטח יודע שמעולם,"
  },
  {
   "start": 379.72,
   "end": 380.68,
   "text": "שמעולם,"
  },
  {
   "start": 381.5,
   "end": 383.84,
   "text": "מעולם לא היה יהודי מיותר."
  },
  {
   "start": 385.24,
   "end": 385.66,
   "text": "יהודי,"
  },
  {
   "start": 386.48,
   "end": 387.76,
   "text": "יהודייה,"
  },
  {
   "start": 388.42,
   "end": 389.86,
   "text": "זו נשמה יקרה,"
  },
  {
   "start": 390.38,
   "end": 391.24,
   "text": "יקרה מאוד."
  },
  {
   "start": 391.6,
   "end": 393.24,
   "text": "בכל מקום שהיא נמצאת,"
  },
  {
   "start": 394.58,
   "end": 397.44,
   "text": "הקדוש ברוך הוא ממתין לאותה נשמה."
  },
  {
   "start": 398.22,
   "end": 404.48,
   "text": "בכל מקום שיהודי נמצא, הקדוש ברוך הוא ממתין לאותה נשמה שתתגלה במלוא יופייה,"
  },
  {
   "start": 404.86,
   "end": 405.58,
   "text": "במלוא הודה,"
  },
  {
   "start": 405.92,
   "end": 406.72,
   "text": "במלוא הדרה."
  },
  {
   "start": 407.26,
   "end": 409.88,
   "text": "יהודי בכל מקום שהוא נמצא הוא לא מיותר."
  },
  {
   "start": 411.62,
   "end": 413.88,
   "text": "הוא יכול שמה לנצוץ"
  },
  {
   "start": 415.36,
   "end": 416.56,
   "text": "כמו יהלום נפלא."
  },
  {
   "start": 417.94,
   "end": 420.1,
   "text": "והקדוש ברוך הוא יושב איתו וממתין לו."
  },
  {
   "start": 424.1,
   "end": 427.08,
   "text": "בכל יהודי יש את החלק האלוקי,"
  },
  {
   "start": 427.92,
   "end": 431.98,
   "text": "והחלק הזה רוצה יותר מכל להידבק בשם יתברך."
  },
  {
   "start": 436.16,
   "end": 436.56,
   "text": "שבתאי,"
  },
  {
   "start": 437.24,
   "end": 438.34,
   "text": "שבתאי חזר לזלוטשוף,"
  },
  {
   "start": 439.68,
   "end": 440.26,
   "text": "והפעם הוא השתנה."
  },
  {
   "start": 441.22,
   "end": 444.12,
   "text": "שבתאי היה הרבה יותר גרוע מקודם."
  },
  {
   "start": 445.56,
   "end": 450.74,
   "text": "הרבה יותר איום נורא צרות"
  },
  {
   "start": 451.9,
   "end": 452.9,
   "text": "עשה בכל מקום."
  },
  {
   "start": 454.5,
   "end": 456.76,
   "text": "בכל שדה פרחים אתה מוצא קוצים."
  },
  {
   "start": 457.96,
   "end": 460.2,
   "text": "שבתאי היה הקוץ של זלות שוב."
  },
  {
   "start": 464.05,
   "end": 466.57,
   "text": "וכך מגיע לו יום הכיפורים,"
  },
  {
   "start": 467.05,
   "end": 468.35,
   "text": "ליל כיפורים בבית הכנסת."
  },
  {
   "start": 469.21,
   "end": 470.45,
   "text": "כל העיירה בתפילה."
  },
  {
   "start": 471.21,
   "end": 472.29,
   "text": "יהודים קדושים,"
  },
  {
   "start": 472.85,
   "end": 473.71,
   "text": "עובדים את השם,"
  },
  {
   "start": 473.71,
   "end": 477.23,
   "text": "מתפללים לשם בקשת מחילה לפני השם יתברך."
  },
  {
   "start": 478.53,
   "end": 479.17,
   "text": "ואז לפתע,"
  },
  {
   "start": 486.81,
   "end": 489.21,
   "text": "לפתע נשמע רעש מבחוץ."
  },
  {
   "start": 490.83,
   "end": 491.99,
   "text": "זה היה רעש ברקע,"
  },
  {
   "start": 492.57,
   "end": 494.87,
   "text": "אבל הרעש הזה הלך וגבר,"
  },
  {
   "start": 495.63,
   "end": 497.23,
   "text": "והלך וגבר."
  },
  {
   "start": 498.95,
   "end": 499.87,
   "text": "עד שהוא היה קרוב,"
  },
  {
   "start": 500.93,
   "end": 501.57,
   "text": "קרוב מאוד,"
  },
  {
   "start": 502.43,
   "end": 504.87,
   "text": "אולי קרוב מדי."
  },
  {
   "start": 507.79,
   "end": 508.21,
   "text": "גדוד,"
  },
  {
   "start": 508.87,
   "end": 509.55,
   "text": "גדוד צבאי,"
  },
  {
   "start": 510.09,
   "end": 512.43,
   "text": "פרץ לעיירה וכיתר את בית הכנסת."
  },
  {
   "start": 514.31,
   "end": 516.77,
   "text": "וכל היהודים קפאו במקומותיהם בפחד."
  },
  {
   "start": 519.24,
   "end": 520.16,
   "text": "אתה לא יכול להאמין."
  },
  {
   "start": 520.96,
   "end": 522.2,
   "text": "זו הייתה תקופה שבה לקחו"
  },
  {
   "start": 522.92,
   "end": 524.94,
   "text": "נערים יהודים לצבא הרוסי,"
  },
  {
   "start": 526.6,
   "end": 527.72,
   "text": "לצבא הפולני."
  },
  {
   "start": 529.32,
   "end": 530.92,
   "text": "והיהודים האלה, הנערים האלה,"
  },
  {
   "start": 532.14,
   "end": 534.6,
   "text": "רק אחרי 25 שנה היו חוזרים,"
  },
  {
   "start": 535.02,
   "end": 536.3,
   "text": "לא היה להם כבר לאן לחזור,"
  },
  {
   "start": 537.04,
   "end": 538.42,
   "text": "היו עוקרים אותם מהכול."
  },
  {
   "start": 541.12,
   "end": 544.42,
   "text": "אז כל פעם שהיו באים, מנסים לקחת נערים, הנערים היו מסתתרים."
  },
  {
   "start": 545.06,
   "end": 545.9,
   "text": "הפעם התחכמו,"
  },
  {
   "start": 547.1,
   "end": 549.24,
   "text": "הצבא התחכם ובא ביום הכיפורים,"
  },
  {
   "start": 549.72,
   "end": 551.22,
   "text": "הם ידעו שכולם בבית הכנסת."
  },
  {
   "start": 552.56,
   "end": 553.86,
   "text": "אז הם צרו על בית הכנסת."
  },
  {
   "start": 556.23,
   "end": 556.57,
   "text": "פחד פחדים,"
  },
  {
   "start": 559.83,
   "end": 560.41,
   "text": "תוך שניות,"
  },
  {
   "start": 561.15,
   "end": 562.25,
   "text": "נפרצת אל בית הכנסת,"
  },
  {
   "start": 563.03,
   "end": 565.09,
   "text": "ופלוגת חיילים נכנסת פנימה."
  },
  {
   "start": 567.41,
   "end": 569.75,
   "text": "עשרות בחורים נתפסים,"
  },
  {
   "start": 570.83,
   "end": 574.85,
   "text": "נאספים אל קרונות המעצר שהמתינו להם בחוץ."
  },
  {
   "start": 575.31,
   "end": 578.37,
   "text": "אין זמן לחשוב,"
  },
  {
   "start": 578.97,
   "end": 583.48,
   "text": "מה תדעת? דממת מוות השתררה לה."
  },
  {
   "start": 585.14,
   "end": 590.76,
   "text": "דממת מוות שהופרה על ידי קולנאי בכי תמרורים שפרץ לו מאזרת הנשים."
  },
  {
   "start": 591.72,
   "end": 594.34,
   "text": "אמהות בוכות על הילדים שלהם שנלקחים,"
  },
  {
   "start": 597.52,
   "end": 597.96,
   "text": "ואז זה קרה."
  },
  {
   "start": 599.48,
   "end": 601.02,
   "text": "כמה מן היהודים התעוררו לפתע"
  },
  {
   "start": 601.8,
   "end": 603.34,
   "text": "מהלם הפחד שאחז בם"
  },
  {
   "start": 604.84,
   "end": 607.18,
   "text": "וקפצו על החיילים עם כיסאות,"
  },
  {
   "start": 608.36,
   "end": 608.86,
   "text": "עם מוטות,"
  },
  {
   "start": 609.5,
   "end": 611.82,
   "text": "עם ברזלים מכל הבא ליד,"
  },
  {
   "start": 612.86,
   "end": 616.2,
   "text": "וקרב אכזרי מאין כמותו ניטש לו בבית הכנסת."
  },
  {
   "start": 617.28,
   "end": 619.52,
   "text": "היהודים נלחמו על החיות שלהם,"
  },
  {
   "start": 620.16,
   "end": 622.58,
   "text": "על התורה שלהם, על הילדים שלהם."
  },
  {
   "start": 627.03,
   "end": 627.43,
   "text": "בצד"
  },
  {
   "start": 628.49,
   "end": 631.97,
   "text": "עומדים להם שבתאי הקצה והבנים שלו אדישים, לא מתערבים."
  },
  {
   "start": 632.89,
   "end": 637.05,
   "text": "לא רק זה, הם אפילו ניסו למנוע מכמה יהודים להתנגד לחיילים."
  },
  {
   "start": 638.37,
   "end": 639.05,
   "text": "אבל זה לא עזר להם."
  },
  {
   "start": 639.89,
   "end": 642.15,
   "text": "החיילים הופתעו, החיילים ברחו."
  },
  {
   "start": 642.85,
   "end": 645.67,
   "text": "הם לא הבינו מה קורה, הם לא היו רגילים להתנגדות."
  },
  {
   "start": 646.77,
   "end": 648.57,
   "text": "אז הם נסוגו קצת להתארגן שנית,"
  },
  {
   "start": 649.11,
   "end": 649.81,
   "text": "לאסוף כוחות."
  },
  {
   "start": 651.73,
   "end": 653.95,
   "text": "והיהודים שהסתערו,"
  },
  {
   "start": 657.07,
   "end": 658.45,
   "text": "לא נתנו להם זמן להתארגן."
  },
  {
   "start": 658.95,
   "end": 659.99,
   "text": "חיילים רבים הוכו,"
  },
  {
   "start": 660.47,
   "end": 661.67,
   "text": "חיילים רבים הוכרעו,"
  },
  {
   "start": 662.19,
   "end": 664.57,
   "text": "וקרונות המעצר נפרצו על ידי ההמון,"
  },
  {
   "start": 665.29,
   "end": 666.63,
   "text": "והנערים ברחו להם,"
  },
  {
   "start": 668.17,
   "end": 669.97,
   "text": "ובצד עומדים להם שבתא יובניו,"
  },
  {
   "start": 670.95,
   "end": 673.89,
   "text": "עוזבים מקץ כמה דקות את המקום בזעם."
  },
  {
   "start": 678.32,
   "end": 678.74,
   "text": "החיילים"
  },
  {
   "start": 680.14,
   "end": 682.1,
   "text": "לא ויתרו, הם ניסו לפרוץ אל בית הכנסת."
  },
  {
   "start": 683.9,
   "end": 685.14,
   "text": "הם לא לקחו בחשבון"
  },
  {
   "start": 686.58,
   "end": 689.4,
   "text": "שעל גג בית הכנסת היו מספר בחורים"
  },
  {
   "start": 690.68,
   "end": 691.3,
   "text": "שעלו"
  },
  {
   "start": 693.08,
   "end": 695.28,
   "text": "והיו מוכנים לסכן את עצמם."
  },
  {
   "start": 695.76,
   "end": 697.18,
   "text": "וכשהחיילים התקרבו,"
  },
  {
   "start": 699.34,
   "end": 700.4,
   "text": "אז הם זרקו עליהם"
  },
  {
   "start": 701.02,
   "end": 703.6,
   "text": "רהיטים כבדים מגג בית הכנסת."
  },
  {
   "start": 704.24,
   "end": 706.22,
   "text": "היהודים נלחמו בחירוף נפש."
  },
  {
   "start": 707.78,
   "end": 710.7,
   "text": "והחיילים שספגו מן האוויר אבנים כבדות,"
  },
  {
   "start": 711.3,
   "end": 711.88,
   "text": "רהיטים,"
  },
  {
   "start": 712.92,
   "end": 713.98,
   "text": "לא היה להם ברירה, הם נסוגו."
  },
  {
   "start": 714.74,
   "end": 717.8,
   "text": "כשהם משאירים מאחוריהם שישה הרוגים,"
  },
  {
   "start": 718.54,
   "end": 719.94,
   "text": "שישה חיילים הרוגים."
  },
  {
   "start": 720.5,
   "end": 721.8,
   "text": "לא היה דבר כזה."
  },
  {
   "start": 722.48,
   "end": 723.96,
   "text": "בפולין לא היה דבר כזה ברוסיה."
  },
  {
   "start": 727.51,
   "end": 728.65,
   "text": "קרב עקוב מדם,"
  },
  {
   "start": 730.87,
   "end": 732.13,
   "text": "דם של חיילים גויים."
  },
  {
   "start": 739.91,
   "end": 740.55,
   "text": "בזלות שוב"
  },
  {
   "start": 741.25,
   "end": 743.01,
   "text": "לא חגגו את חגיגות הניצחון."
  },
  {
   "start": 744.33,
   "end": 745.93,
   "text": "פחד ואימה לפתו את כולם."
  },
  {
   "start": 746.85,
   "end": 751.15,
   "text": "כולם ידעו שמלכות פולין לא תעבור על כך בשתיקה,"
  },
  {
   "start": 754.62,
   "end": 756.4,
   "text": "ויאמר ונמהר זה הגיע."
  },
  {
   "start": 758.14,
   "end": 759.4,
   "text": "זלוצ'וב כותרה"
  },
  {
   "start": 760.44,
   "end": 766.72,
   "text": "על ידי גדודי חיילים והרב של זלוצ'וב,"
  },
  {
   "start": 767.52,
   "end": 768.74,
   "text": "יחד עם מנהיגי הקהל,"
  },
  {
   "start": 769.38,
   "end": 771.42,
   "text": "נעצרו באשמת הסתה ומרד."
  },
  {
   "start": 774.39,
   "end": 776.59,
   "text": "הם נחשפו לחקירה,"
  },
  {
   "start": 777.35,
   "end": 778.09,
   "text": "לעינויים,"
  },
  {
   "start": 779.91,
   "end": 781.13,
   "text": "ולא הוציאו מילה."
  },
  {
   "start": 782.11,
   "end": 783.89,
   "text": "השלטונות,"
  },
  {
   "start": 784.89,
   "end": 786.07,
   "text": "הצבא רצה דבר אחד,"
  },
  {
   "start": 787.09,
   "end": 788.47,
   "text": "אנחנו רוצים לדעת מי אלו,"
  },
  {
   "start": 789.51,
   "end": 791.05,
   "text": "מי אלו שזרקו את האבנים,"
  },
  {
   "start": 791.67,
   "end": 793.99,
   "text": "מי אלו שיעזו להרוג חיילים."
  },
  {
   "start": 796.5,
   "end": 797.98,
   "text": "אם אתם לא תגלו לנו, אתם,"
  },
  {
   "start": 798.6,
   "end": 799.36,
   "text": "אתם תיהרגו,"
  },
  {
   "start": 800.18,
   "end": 802.64,
   "text": "וכל הרכוש של כל היהודים יוחרם."
  },
  {
   "start": 813.06,
   "end": 817.22,
   "text": "כל העיר זלוטשוב התפעלה מדמותו של הרב,"
  },
  {
   "start": 818.24,
   "end": 819.08,
   "text": "שהתגלתה לה במלוא הדרה."
  },
  {
   "start": 820.1,
   "end": 821.06,
   "text": "הרב לא היה מוכן לוותר,"
  },
  {
   "start": 822.04,
   "end": 824.82,
   "text": "הוא נסח עוצמה וביטחון בעצורים האחרים."
  },
  {
   "start": 826.34,
   "end": 829.8,
   "text": "ולא הוציא מילה, לא הסגיר ולו יהודי אחד,"
  },
  {
   "start": 831.22,
   "end": 832.22,
   "text": "מקבל עליו"
  },
  {
   "start": 834.28,
   "end": 835.46,
   "text": "את הדין באהבה."
  },
  {
   "start": 837.06,
   "end": 837.86,
   "text": "בלית ברירה,"
  },
  {
   "start": 838.64,
   "end": 841.4,
   "text": "מקץ ימים רבים של עינויים,"
  },
  {
   "start": 842.38,
   "end": 845.14,
   "text": "החליטו שלטונות הצבא לדון אותם למוות."
  },
  {
   "start": 846.58,
   "end": 847.24,
   "text": "ואת העיר,"
  },
  {
   "start": 847.24,
   "end": 853.08,
   "text": "לעוצר ממושך שבתומו יחרימו את כל רכושם."
  },
  {
   "start": 859.68,
   "end": 860.66,
   "text": "יומיים אחר כך"
  },
  {
   "start": 861.58,
   "end": 865.44,
   "text": "מסתובב כרוז בעיר זלוטשוב השוממה והמסוגרת ומודיע"
  },
  {
   "start": 866.3,
   "end": 868.04,
   "text": "מה שיכול להציל את הרב שלכם,"
  },
  {
   "start": 868.58,
   "end": 875.06,
   "text": "את המנהיגים שלכם ואת הרכוש שלכם זה אם תמסרו את שמות האשמים האמיתיים."
  },
  {
   "start": 876.24,
   "end": 877.62,
   "text": "נותנים לכם שבוע אולטימטום."
  },
  {
   "start": 891.4,
   "end": 892.12,
   "text": "עיירה זלוטשוב"
  },
  {
   "start": 893.74,
   "end": 895.36,
   "text": "שרתה המהומה"
  },
  {
   "start": 896.48,
   "end": 898.72,
   "text": "כולם רצים, כולם מדברים."
  },
  {
   "start": 899.5,
   "end": 900.08,
   "text": "מה קרה שם?"
  },
  {
   "start": 900.98,
   "end": 902.52,
   "text": "כולם ראו את שבתאי הקצב באמצע,"
  },
  {
   "start": 904.16,
   "end": 909.3,
   "text": "באמצע רחוב סואן, באמצע היום חוצה את כל הרחוב המרכזי של זלוטשוב"
  },
  {
   "start": 910.18,
   "end": 911.68,
   "text": "אל עבר מחנה הצבא."
  },
  {
   "start": 912.26,
   "end": 912.86,
   "text": "ואז הם ידעו."
  },
  {
   "start": 914.6,
   "end": 916.14,
   "text": "שבתאי הקצב והילדים שלו,"
  },
  {
   "start": 916.72,
   "end": 918.0,
   "text": "שפסעו בעקבותיו,"
  },
  {
   "start": 918.42,
   "end": 924.96,
   "text": "הולכים להסגיר את הנערים שהרגו את החיילים."
  },
  {
   "start": 927.53,
   "end": 928.61,
   "text": "הדברים היו ברורים הרי."
  },
  {
   "start": 930.07,
   "end": 932.61,
   "text": "וכי שבתא יתן שיחרימו את הרכוש שלו"
  },
  {
   "start": 935.35,
   "end": 938.53,
   "text": "בגלל אותם יהודים שכל כך אהב לשנוא,"
  },
  {
   "start": 939.31,
   "end": 940.55,
   "text": "כל כך אהב להציק להם."
  },
  {
   "start": 944.63,
   "end": 945.93,
   "text": "ימים מספר אחר כך"
  },
  {
   "start": 946.79,
   "end": 947.63,
   "text": "נפתחת הדלת."
  },
  {
   "start": 949.43,
   "end": 950.51,
   "text": "דלתתה של הרבי מזלוטשוף,"
  },
  {
   "start": 951.77,
   "end": 953.27,
   "text": "דלתתה של מנהיגי הקהל היהודי"
  },
  {
   "start": 954.19,
   "end": 954.97,
   "text": "ומושל העיר"
  },
  {
   "start": 956.21,
   "end": 957.73,
   "text": "פונה ואומר אתם משוחררים."
  },
  {
   "start": 959.07,
   "end": 960.75,
   "text": "תפסנו את הרוצח חייך מושל,"
  },
  {
   "start": 962.41,
   "end": 963.85,
   "text": "והרב החוויר כמו סיד."
  },
  {
   "start": 964.65,
   "end": 965.25,
   "text": "לא ייתכן,"
  },
  {
   "start": 965.91,
   "end": 966.59,
   "text": "לא ייתכן."
  },
  {
   "start": 969.65,
   "end": 971.11,
   "text": "והמושל הצבאי בחיוך,"
  },
  {
   "start": 974.0,
   "end": 974.38,
   "text": "כן,"
  },
  {
   "start": 975.08,
   "end": 975.86,
   "text": "אתמול,"
  },
  {
   "start": 976.98,
   "end": 982.28,
   "text": "אתמול הסגיר עצמו לידינו שבתאי בן יוסף"
  },
  {
   "start": 982.94,
   "end": 983.84,
   "text": "והילדים שלו."
  },
  {
   "start": 986.22,
   "end": 987.18,
   "text": "שבתאי בן יוסף,"
  },
  {
   "start": 988.12,
   "end": 991.68,
   "text": "הוא הודה שהוא זה שרצח את החיילים, את ששת החיילים במו ידיו."
  },
  {
   "start": 993.56,
   "end": 994.56,
   "text": "בהתחלה לא האמנו לו,"
  },
  {
   "start": 995.22,
   "end": 997.1,
   "text": "אבל חקרנו אותו והוא עמד על דעתו,"
  },
  {
   "start": 997.54,
   "end": 999.9,
   "text": "שהוא והילדים שלו הם הרוצחים היחידים."
  },
  {
   "start": 1004.82,
   "end": 1005.66,
   "text": "תפסנו אותם,"
  },
  {
   "start": 1006.42,
   "end": 1007.36,
   "text": "אתם משוחררים."
  },
  {
   "start": 1009.3,
   "end": 1010.64,
   "text": "ואל תשכחו מחר,"
  },
  {
   "start": 1011.64,
   "end": 1012.78,
   "text": "מחר לבוא לחזות"
  },
  {
   "start": 1014.14,
   "end": 1015.32,
   "text": "בטקס ההוצאה להורג"
  },
  {
   "start": 1015.88,
   "end": 1031.16,
   "text": "של אותם יהודים שייהרגו לפני כולם למען יראו וייראו במזלות שוב."
  },
  {
   "start": 1033.54,
   "end": 1034.54,
   "text": "פסע אט אט,"
  },
  {
   "start": 1035.36,
   "end": 1036.32,
   "text": "כולו מאורהר"
  },
  {
   "start": 1039.24,
   "end": 1040.5,
   "text": "בדרך החוצה."
  },
  {
   "start": 1042.57,
   "end": 1045.73,
   "text": "דמעות מלוכות מתגלגלות מעיניו."
  },
  {
   "start": 1050.08,
   "end": 1053.22,
   "text": "בני נשמע במוחו קולו של הרבי מיסאסוי."
  },
  {
   "start": 1054.1,
   "end": 1055.68,
   "text": "קול יהודי יקר ערך."
  },
  {
   "start": 1056.44,
   "end": 1057.8,
   "text": "בכל מקום שהוא נמצא,"
  },
  {
   "start": 1058.7,
   "end": 1060.14,
   "text": "הקדוש ברוך הוא ממתין לו."
  },
  {
   "start": 1061.38,
   "end": 1062.92,
   "text": "לרגע בו תתנוצץ לה נשמתו,"
  },
  {
   "start": 1068.14,
   "end": 1071.32,
   "text": "אי אפשר להבין מה גרם לשבתאי הקצב,"
  },
  {
   "start": 1072.18,
   "end": 1073.34,
   "text": "לשבתאי בן יוסף,"
  },
  {
   "start": 1074.26,
   "end": 1076.26,
   "text": "זה שנלחם כנגד יהדות"
  },
  {
   "start": 1077.44,
   "end": 1079.16,
   "text": "לבוא ולהפוך את העור שלו"
  },
  {
   "start": 1080.44,
   "end": 1083.32,
   "text": "ולקדש שם שמיים כדי להציל עיר שלמה."
  },
  {
   "start": 1084.04,
   "end": 1088.12,
   "text": "מי יכול להבין גודל נשמה יהודית?"
  },
  {
   "start": 1089.84,
   "end": 1091.2,
   "text": "מי יכול להבין?"
  },
  {
   "start": 1092.0,
   "end": 1096.22,
   "text": "אז אנחנו יכולים להבין מה אנחנו מסוגלים לעשות לכבוד השם יתברך,"
  },
  {
   "start": 1097.52,
   "end": 1100.94,
   "text": "מה אנחנו מסוגלים, ולא למות, לחיות,"
  },
  {
   "start": 1101.7,
   "end": 1103.2,
   "text": "לתת, למסור."
  },
  {
   "start": 1108.43,
   "end": 1109.15,
   "text": "למחרת"
  },
  {
   "start": 1110.49,
   "end": 1112.31,
   "text": "ברחוב הראשי של העיר זלוטשוף"
  },
  {
   "start": 1112.93,
   "end": 1116.99,
   "text": "נאספים אלפים של גויים לחזות"
  },
  {
   "start": 1118.43,
   "end": 1123.27,
   "text": "בהוצאה להורג של שבתאי והילדים שלו"
  },
  {
   "start": 1126.08,
   "end": 1130.84,
   "text": "וגם היהודים נאספו לבוא אל כיכר העיר,"
  },
  {
   "start": 1133.44,
   "end": 1139.5,
   "text": "בראשים מכוסים בשק ולא הנאשמים אל מקום ביצוע גזר הדין."
  },
  {
   "start": 1143.13,
   "end": 1148.11,
   "text": "עסקים מוסריים בראש שבתאי,"
  },
  {
   "start": 1149.09,
   "end": 1151.97,
   "text": "שפתיו ממלמלות תפילה,"
  },
  {
   "start": 1155.02,
   "end": 1156.22,
   "text": "פתח את העיניים שלו"
  },
  {
   "start": 1156.78,
   "end": 1159.54,
   "text": "ושנייה לפני ההוצאה להורג"
  },
  {
   "start": 1160.54,
   "end": 1162.12,
   "text": "הוא הרים עיניים לשמיים,"
  },
  {
   "start": 1162.78,
   "end": 1164.14,
   "text": "ובעיניים דומעות,"
  },
  {
   "start": 1164.46,
   "end": 1166.92,
   "text": "עיניים של בן שחוזר לאבא שלו,"
  },
  {
   "start": 1167.26,
   "end": 1168.84,
   "text": "צעק שמע ישראל,"
  },
  {
   "start": 1169.14,
   "end": 1170.66,
   "text": "אדוני אלוהינו,"
  },
  {
   "start": 1171.12,
   "end": 1171.98,
   "text": "אדוני אחד,"
  },
  {
   "start": 1172.78,
   "end": 1178.54,
   "text": "וברקע הדהדו קולותיהם של בניו שמקדשים שם שמיים יחד איתו."
  },
  {
   "start": 1185.61,
   "end": 1186.27,
   "text": "עוד שנייה,"
  },
  {
   "start": 1187.65,
   "end": 1188.57,
   "text": "ועוד שנייה,"
  },
  {
   "start": 1189.59,
   "end": 1190.51,
   "text": "והעיר זלוטשוב"
  },
  {
   "start": 1191.37,
   "end": 1192.29,
   "text": "נפרדה לה."
  },
  {
   "start": 1192.39,
   "end": 1195.11,
   "text": "מיהודי יקר מאוד,"
  },
  {
   "start": 1195.71,
   "end": 1197.15,
   "text": "שאיש לא ידע להעריך אותו,"
  },
  {
   "start": 1198.01,
   "end": 1200.21,
   "text": "איש לא ידע להבין את גודל נשמתו."
  },
  {
   "start": 1202.54,
   "end": 1204.64,
   "text": "בעיירה זלוטשוב, ישנה מצבה,"
  },
  {
   "start": 1205.54,
   "end": 1206.26,
   "text": "שם חרוט,"
  },
  {
   "start": 1207.06,
   "end": 1208.36,
   "text": "מספר מילים קטנות"
  },
  {
   "start": 1210.3,
   "end": 1212.8,
   "text": "שמסתירות סיפור חיים שלם."
  },
  {
   "start": 1213.82,
   "end": 1214.54,
   "text": "פה נטמן הקדוש,"
  },
  {
   "start": 1216.5,
   "end": 1218.1,
   "text": "רבי שבתאי בן יוסף,"
  },
  {
   "start": 1219.52,
   "end": 1220.26,
   "text": "ובניו,"
  },
  {
   "start": 1220.8,
   "end": 1223.7,
   "text": "שמסרו נפש להצלת"
  },
  {
   "start": 1224.64,
   "end": 1225.9,
   "text": "בני עמו היהודים."
  },
  {
   "start": 1232.66,
   "end": 1233.5,
   "text": "מן הסתם,"
  },
  {
   "start": 1233.9,
   "end": 1241.16,
   "text": "נשמתו של רבי עקיבא יצאה לקבל את נשמות שבתאי וילדיו."
  },
  {
   "start": 1246.56,
   "end": 1255.09,
   "text": "מי יכול להבין גודל נשמתה של יהודייה, של יהודי? אי אפשר להבין."
  },
  {
   "start": 1256.39,
   "end": 1256.97,
   "text": "אנחנו לא יודעים,"
  },
  {
   "start": 1257.71,
   "end": 1259.73,
   "text": "לא יודעים איזה כוחות גלומים בנו."
  },
  {
   "start": 1260.55,
   "end": 1263.49,
   "text": "כאשר יענו אותו כנרבה וכנפרוץ,"
  },
  {
   "start": 1264.19,
   "end": 1265.83,
   "text": "זו הסיסמה של עם ישראל,"
  },
  {
   "start": 1266.47,
   "end": 1267.97,
   "text": "דווקא כשהיו מלחיצים אותנו,"
  },
  {
   "start": 1270.53,
   "end": 1271.49,
   "text": "היינו עולים יותר,"
  },
  {
   "start": 1272.01,
   "end": 1273.71,
   "text": "גם כשהיצרה לוחץ אותנו,"
  },
  {
   "start": 1274.07,
   "end": 1276.39,
   "text": "גם כשמבית ומחוץ לוחצים אותנו,"
  },
  {
   "start": 1276.99,
   "end": 1278.07,
   "text": "מאיימים עלינו,"
  },
  {
   "start": 1278.49,
   "end": 1281.55,
   "text": "רוצים להוריד לנו את המעט רוחניות שעוד יש בנו."
  },
  {
   "start": 1282.37,
   "end": 1284.25,
   "text": "דווקא אז זה הזמן,"
  },
  {
   "start": 1284.91,
   "end": 1285.35,
   "text": "זו העת,"
  },
  {
   "start": 1286.41,
   "end": 1294.18,
   "text": "זו העת וזה הזמן לבוא ולהצהיר אמונים לבורא עולם,"
  },
  {
   "start": 1294.9,
   "end": 1297.44,
   "text": "לבוא ולמסור נפש,"
  },
  {
   "start": 1297.76,
   "end": 1300.54,
   "text": "ולדרוך במשעול בו צעדו אבותינו,"
  },
  {
   "start": 1300.96,
   "end": 1302.66,
   "text": "ולא למות על קידוש השם,"
  },
  {
   "start": 1303.0,
   "end": 1304.4,
   "text": "לחיות על קידוש השם,"
  },
  {
   "start": 1304.74,
   "end": 1305.98,
   "text": "לחיות על קידוש השם."
  },
  {
   "start": 1311.96,
   "end": 1314.18,
   "text": "ונזכה כולנו בביאת גואל צדק,"
  },
  {
   "start": 1315.44,
   "end": 1317.24,
   "text": "כי מסרנו נפש, כי לא ויתרנו."
  },
  {
   "start": 1317.86,
   "end": 1319.84,
   "text": "כשהיה קשה, כשרדפו,"
  },
  {
   "start": 1320.32,
   "end": 1321.7,
   "text": "כשמנעו מאיתנו תורה,"
  },
  {
   "start": 1322.3,
   "end": 1325.84,
   "text": "אנחנו הלכנו ואמרנו, בורא העולם, עכשיו אנחנו מוכיחים לך."
  },
  {
   "start": 1326.52,
   "end": 1328.5,
   "text": "עד עכשיו, אולי זה היה,"
  },
  {
   "start": 1329.06,
   "end": 1329.88,
   "text": "אולי זה היה פשוט."
  },
  {
   "start": 1329.88,
   "end": 1332.9,
   "text": "פשוט, עכשיו אנחנו נראה לך בורא עולם,"
  },
  {
   "start": 1333.34,
   "end": 1336.76,
   "text": "נוכיח לך שאנחנו איתך באש ובמים."
  },
  {
   "start": 1337.36,
   "end": 1340.46,
   "text": "באש ובמים, באמת אוהבים אותך, באמת אוהבים אותך."
  }
 ]
}