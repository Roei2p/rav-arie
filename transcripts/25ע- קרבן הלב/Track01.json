{
 "disc": "25ע- קרבן הלב",
 "track": "Track01",
 "duration": 746.184,
 "segments": [
  {
   "start": 32.59,
   "end": 37.58,
   "text": "לכל תפקיד בעולם ישנן דרישות."
  },
  {
   "start": 40.6,
   "end": 43.3,
   "text": "בקורס טיס, למי שרוצה להיות טייס,"
  },
  {
   "start": 44.22,
   "end": 46.02,
   "text": "מצפים ממנו לקואורדינציה,"
  },
  {
   "start": 47.44,
   "end": 49.52,
   "text": "עמידה בלחץ, מהירות תפיסה,"
  },
  {
   "start": 50.52,
   "end": 52.86,
   "text": "כושר גופני ברמה מסוימת,"
  },
  {
   "start": 53.74,
   "end": 61.7,
   "text": "ועוד בפקולטה לרפואה מרופא מצפים לפסיכומטרי ברמה מסוימת,"
  },
  {
   "start": 62.4,
   "end": 63.48,
   "text": "לעבור מבחני כניסה,"
  },
  {
   "start": 64.38,
   "end": 65.22,
   "text": "מספר שנות לימוד,"
  },
  {
   "start": 65.84,
   "end": 66.62,
   "text": "אחר כך סטאז'"
  },
  {
   "start": 67.22,
   "end": 68.24,
   "text": "ועוד כמה דברים."
  },
  {
   "start": 69.3,
   "end": 78.64,
   "text": "מנשיא ארצות הברית מצפים להצלחה בבחירות דלות נשיא, ניסיון פוליטי, יחסי ציבור ועוד כמה דברים."
  },
  {
   "start": 82.55,
   "end": 83.55,
   "text": "ומה אצל היהודי?"
  },
  {
   "start": 84.61,
   "end": 85.55,
   "text": "מה אצל היהודייה?"
  },
  {
   "start": 88.41,
   "end": 90.87,
   "text": "אצל הקדוש ברוך הוא יש גם מבחן."
  },
  {
   "start": 92.11,
   "end": 99.01,
   "text": "יש קריטריון להעפיל לפסגת העולם בקדושה ובטהרה."
  },
  {
   "start": 99.59,
   "end": 105.01,
   "text": "אתם יודעים מהו שיא הקדושה שאדם יכול להגיע?"
  },
  {
   "start": 107.6,
   "end": 108.56,
   "text": "אתם יודעים מהו שיא?"
  },
  {
   "start": 109.14,
   "end": 112.78,
   "text": "שיא השיאים שאדם או אישה יכולים לשאוף אליהם"
  },
  {
   "start": 113.5,
   "end": 114.42,
   "text": "ולהגיע אליהם?"
  },
  {
   "start": 115.22,
   "end": 116.82,
   "text": "ופה לא מדובר על צדיקים,"
  },
  {
   "start": 117.34,
   "end": 121.88,
   "text": "מספר צדיקים וזהו, או ל״ו צדיקים נסתרים במקום זה או אחר. לא, לא."
  },
  {
   "start": 122.48,
   "end": 123.24,
   "text": "מדובר עלינו,"
  },
  {
   "start": 123.82,
   "end": 126.82,
   "text": "על כל יהודי ויהודייה פשוטים,"
  },
  {
   "start": 127.84,
   "end": 129.34,
   "text": "נפלאים,"
  },
  {
   "start": 130.22,
   "end": 134.1,
   "text": "כולם אהובים, כולם ברורים, אומר רבי חיים מצאנז."
  },
  {
   "start": 134.84,
   "end": 136.66,
   "text": "אומר, מדוע בית המקדש,"
  },
  {
   "start": 137.16,
   "end": 138.22,
   "text": "מדוע בית המקדש,"
  },
  {
   "start": 138.42,
   "end": 139.52,
   "text": "קודש הקודשים,"
  },
  {
   "start": 139.86,
   "end": 142.98,
   "text": "הוא דווקא על הר המוריה ולא על הר סיני?"
  },
  {
   "start": 143.38,
   "end": 145.94,
   "text": "הרי בהר סיני ניתנה התורה."
  },
  {
   "start": 146.76,
   "end": 151.82,
   "text": "הלו בהר סיני הייתה התגלות אלוקית שלא הייתה כמותה מאז ומעולם."
  },
  {
   "start": 153.38,
   "end": 155.64,
   "text": "אז למה על בית המקדש ולא על הר סיני?"
  },
  {
   "start": 156.1,
   "end": 158.62,
   "text": "למה הוא דווקא על הר המוריה?"
  },
  {
   "start": 159.46,
   "end": 160.58,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 161.28,
   "end": 165.8,
   "text": "אתם יודעים למה בית המקדש הוא דווקא על הר המוריה?"
  },
  {
   "start": 167.98,
   "end": 172.92,
   "text": "מה מיוחד בהר המוריה? למה הוא זכה להיות פסגת קודש הקודשים?"
  },
  {
   "start": 173.56,
   "end": 182.74,
   "text": "כי בהר המוריה לפני אלפי שנים עמד יהודי ופשט את צווארו לכבוד השם יתברך."
  },
  {
   "start": 183.46,
   "end": 188.16,
   "text": "כי בהר המוריה עמד יצחק אבינו יחד עם אבא שלו אברהם,"
  },
  {
   "start": 188.62,
   "end": 191.16,
   "text": "ומסרו נפש לכבוד השם יתברך."
  },
  {
   "start": 192.06,
   "end": 196.2,
   "text": "לכן בורא העולם אמר באותו הר המוריה יהיה בית המקדש,"
  },
  {
   "start": 196.62,
   "end": 197.94,
   "text": "תהיה שיא הקדושה."
  },
  {
   "start": 200.44,
   "end": 203.28,
   "text": "לעולם, כי שם יהודי מסר נפש."
  },
  {
   "start": 209.81,
   "end": 211.85,
   "text": "העולם רוצה איי-קיו."
  },
  {
   "start": 213.01,
   "end": 214.19,
   "text": "העולם רוצה פוליטיקה."
  },
  {
   "start": 215.17,
   "end": 216.53,
   "text": "העולם רוצה כסף,"
  },
  {
   "start": 217.25,
   "end": 217.89,
   "text": "דולרים,"
  },
  {
   "start": 218.55,
   "end": 219.13,
   "text": "כבוד,"
  },
  {
   "start": 220.05,
   "end": 220.83,
   "text": "גאווה,"
  },
  {
   "start": 224.52,
   "end": 225.34,
   "text": "דמיונות."
  },
  {
   "start": 227.81,
   "end": 228.91,
   "text": "זה מה שהעולם רוצה."
  },
  {
   "start": 229.99,
   "end": 232.35,
   "text": "בורא עולם רוצה מהיהודייה,"
  },
  {
   "start": 233.39,
   "end": 235.33,
   "text": "מהיהודי, מהילדים שלו."
  },
  {
   "start": 235.85,
   "end": 241.89,
   "text": "בורא עולם, מלך מלכי המלכים, הקדוש ברוך הוא, רוצה מהילדים שלו רק דבר אחד,"
  },
  {
   "start": 244.15,
   "end": 245.13,
   "text": "את הלב שלנו,"
  },
  {
   "start": 246.01,
   "end": 247.09,
   "text": "את הרצון שלנו,"
  },
  {
   "start": 248.47,
   "end": 249.37,
   "text": "את הרגש שלנו,"
  },
  {
   "start": 250.03,
   "end": 252.87,
   "text": "שהיהודי ייתן לבורא עולם מהלב שלו,"
  },
  {
   "start": 253.51,
   "end": 254.49,
   "text": "שהיהודייה תיתן"
  },
  {
   "start": 255.19,
   "end": 257.17,
   "text": "מהלב שלה להשם יתברך,"
  },
  {
   "start": 258.09,
   "end": 263.33,
   "text": "שנפתח קשרי אהבה בינינו לבין הקדוש ברוך הוא."
  },
  {
   "start": 263.77,
   "end": 265.57,
   "text": "לכן כל יום יהודי אומר,"
  },
  {
   "start": 265.95,
   "end": 268.25,
   "text": "ואהבת את השם אלוקיך."
  },
  {
   "start": 269.93,
   "end": 271.35,
   "text": "בורא עולם שברא את כל העולם,"
  },
  {
   "start": 272.33,
   "end": 276.51,
   "text": "שמכיר את הכל, שיודע מה היה בעבר, מה יש עכשיו"
  },
  {
   "start": 277.05,
   "end": 278.25,
   "text": "ומה יהיה לעתיד לבוא."
  },
  {
   "start": 279.13,
   "end": 281.43,
   "text": "הוא מכיר כסף, מכיר זהב, מכיר פלטינה,"
  },
  {
   "start": 282.29,
   "end": 284.17,
   "text": "מכיר אורניום, מכיר הכל."
  },
  {
   "start": 284.91,
   "end": 286.69,
   "text": "יודע שהדבר היקר ביותר בעולם."
  },
  {
   "start": 287.75,
   "end": 292.95,
   "text": "הדבר החשוב ביותר בעולם זה הלב היהודי הגדול והנפלא שלנו."
  },
  {
   "start": 294.53,
   "end": 296.03,
   "text": "ואת הלב שלנו הוא רוצה"
  },
  {
   "start": 298.17,
   "end": 299.35,
   "text": "שנתאחד כולנו."
  },
  {
   "start": 300.33,
   "end": 303.51,
   "text": "כל ליבות עם ישראל לכנסת ישראל, ללב אחד גדול"
  },
  {
   "start": 304.03,
   "end": 307.19,
   "text": "שמהווה את כנסת ישראל שיהיה כולו לשם."
  },
  {
   "start": 308.33,
   "end": 312.17,
   "text": "שיהיה כולו לשם, שנלך בדרכי אבותינו, צריך לדעת את זה."
  },
  {
   "start": 312.49,
   "end": 317.95,
   "text": "בתקופה שלנו, כן, צריכים להרים את הראש וללכת בדרכים של אבותינו."
  },
  {
   "start": 324.28,
   "end": 325.92,
   "text": "היו הרבה יהודים בעולם."
  },
  {
   "start": 330.0,
   "end": 335.7,
   "text": "היה יהודי אחד שאולי התעלה בזמן יחסית קצר"
  },
  {
   "start": 337.02,
   "end": 339.1,
   "text": "אל מעבר לתפיסה בכלל."
  },
  {
   "start": 343.1,
   "end": 344.0,
   "text": "קראו לו רבי עקיבא."
  },
  {
   "start": 350.02,
   "end": 350.68,
   "text": "רבי עקיבא."
  },
  {
   "start": 351.44,
   "end": 353.48,
   "text": "רבי עקיבא היה איש אמת."
  },
  {
   "start": 354.0,
   "end": 362.08,
   "text": "רבי עקיבא עד גיל 40 היה לא אוהב תלמידי חכמים. היה אומר, אם אני אתפוס תלמיד חכם אני אמשך אותו נשיכה של חמור."
  },
  {
   "start": 363.2,
   "end": 365.94,
   "text": "שאלו אותו, תגיד לי, רבי עקיבא, למה נשיכה של חמור?"
  },
  {
   "start": 365.94,
   "end": 370.76,
   "text": "עולם המשיכה של כלב אמר להם כי משיכה של חמור מרסקת עצמות"
  },
  {
   "start": 378.87,
   "end": 379.83,
   "text": "אבל רחל"
  },
  {
   "start": 381.21,
   "end": 383.07,
   "text": "רחל ראתה את התכונות"
  },
  {
   "start": 383.59,
   "end": 389.57,
   "text": "ראתה את האמת של רבי עקיבא אם אני אם אני אקרב אותו אל השם יתברך זה נשמה של יהודי"
  },
  {
   "start": 390.39,
   "end": 392.63,
   "text": "הוא יכול לחצוב עולמות באמת שלו"
  },
  {
   "start": 394.8,
   "end": 395.64,
   "text": "ורבי עקיבא"
  },
  {
   "start": 396.4,
   "end": 397.38,
   "text": "הלך עד הסוף"
  },
  {
   "start": 398.0,
   "end": 403.82,
   "text": "רבי עקיבא שינה את המהות שלו והלך ללמוד תורה ניא אוהב תורה מאין כמותו"
  },
  {
   "start": 405.48,
   "end": 414.02,
   "text": "והלך ולמד עשרים וארבע שנים וחזר כאבי התורה שבעל פה. גדול ישראל עצום. תנא קדוש, תנא אלוקים."
  },
  {
   "start": 419.27,
   "end": 420.11,
   "text": "והרומאים,"
  },
  {
   "start": 421.73,
   "end": 424.05,
   "text": "הרומאים אותם יפי נפש,"
  },
  {
   "start": 425.65,
   "end": 430.45,
   "text": "אותם יפי נפש שהלכו וטבחו בעם ישראל והרגו ורצחו"
  },
  {
   "start": 431.01,
   "end": 432.29,
   "text": "עם חוקים נפלאים,"
  },
  {
   "start": 432.65,
   "end": 433.69,
   "text": "עם נימוסים נפלאים,"
  },
  {
   "start": 433.97,
   "end": 435.01,
   "text": "עם אינטליגנציה,"
  },
  {
   "start": 435.31,
   "end": 436.01,
   "text": "עם תעודות,"
  },
  {
   "start": 436.33,
   "end": 437.73,
   "text": "אבל הם היו רוצחים פשוטים,"
  },
  {
   "start": 438.23,
   "end": 439.77,
   "text": "לא יכלו לעמוד מול רבי עקיבא,"
  },
  {
   "start": 440.17,
   "end": 442.95,
   "text": "לא יכלו לעמוד מול האמת של התורה הקדושה."
  },
  {
   "start": 445.55,
   "end": 447.29,
   "text": "והם גזרו לו ללמוד תורה."
  },
  {
   "start": 448.65,
   "end": 449.63,
   "text": "מה אכפת לכם?"
  },
  {
   "start": 450.73,
   "end": 452.07,
   "text": "מה אכפת לכם?"
  },
  {
   "start": 452.83,
   "end": 453.43,
   "text": "כואב להם."
  },
  {
   "start": 454.17,
   "end": 456.27,
   "text": "כואב להם שהאמת תהיה ברחובות."
  },
  {
   "start": 457.03,
   "end": 457.93,
   "text": "לא, לא, לא."
  },
  {
   "start": 458.37,
   "end": 461.27,
   "text": "הם יודעים את הכוח הרוחני של התורה הקדושה הזו הם גוזרים,"
  },
  {
   "start": 461.71,
   "end": 463.41,
   "text": "ורבי עקיבא זה החיות שלו."
  },
  {
   "start": 464.07,
   "end": 466.09,
   "text": "הוא ממשיך ללמוד וללמד תורה,"
  },
  {
   "start": 466.65,
   "end": 467.25,
   "text": "ואז הוא נתפס"
  },
  {
   "start": 468.17,
   "end": 471.09,
   "text": "וסורקים את גופו שבמסרקות של ברזל."
  },
  {
   "start": 471.47,
   "end": 473.69,
   "text": "לוקחים ולאט לאט הרומאים האכזרים,"
  },
  {
   "start": 474.11,
   "end": 476.43,
   "text": "כמו כל הג'נטלמנים לכל אורך הדורות,"
  },
  {
   "start": 476.95,
   "end": 478.07,
   "text": "שהלכו ורצחו,"
  },
  {
   "start": 478.41,
   "end": 479.71,
   "text": "ועשו את מסעות הצלב,"
  },
  {
   "start": 480.03,
   "end": 480.85,
   "text": "ואת השואה,"
  },
  {
   "start": 481.15,
   "end": 482.43,
   "text": "ואת כל הדברים האיומים."
  },
  {
   "start": 485.95,
   "end": 487.81,
   "text": "אומרים לרבי עקיבא, תראה רבי עקיבא,"
  },
  {
   "start": 489.33,
   "end": 489.91,
   "text": "אם אתה,"
  },
  {
   "start": 490.85,
   "end": 492.07,
   "text": "אם אתה תעזוב את התורה,"
  },
  {
   "start": 495.42,
   "end": 496.36,
   "text": "נקל מעליך,"
  },
  {
   "start": 497.42,
   "end": 498.78,
   "text": "אולי לא נהרוג אותך."
  },
  {
   "start": 499.24,
   "end": 501.92,
   "text": "ורבי עקיבא לא מעניין אותו כלום, הוא לא רואה כלום."
  },
  {
   "start": 502.74,
   "end": 506.86,
   "text": "הוא רואה רק את רצון ה' הוא רואה רק את התורה הקדושה"
  },
  {
   "start": 507.26,
   "end": 522.98,
   "text": "הוא רואה אותנו הוא אומר אני רוצה להנחיל במותי את הכוח לחיים את הכוח לנו בתקופה שלנו להתחזק לא להתייאש להתחזק למסור נפש נמסור נפש לכבוד השם לא להתייאש"
  },
  {
   "start": 530.5,
   "end": 536.76,
   "text": "והם סורקים את גופו במסריקות של ברזל אומר רב שולם שבדרון באו התלמידים של רבי עקיבא"
  },
  {
   "start": 537.38,
   "end": 539.62,
   "text": "ואומרים לו רבי עקיבא עד כאן."
  },
  {
   "start": 540.84,
   "end": 546.64,
   "text": "התפעלו התלמידים של רבי עקיבא, ראו אותו מקבל עליו עול מלכות שמיים באהבה."
  },
  {
   "start": 547.32,
   "end": 548.46,
   "text": "איך הם ידעו שזה באהבה?"
  },
  {
   "start": 549.2,
   "end": 552.64,
   "text": "הם ראו את האור בעיניים שלו בדיוק כמו שהוא לימד אותם תורה."
  },
  {
   "start": 553.0,
   "end": 555.6,
   "text": "הוא לימד אותם תורה באהבה, במתיקות."
  },
  {
   "start": 556.44,
   "end": 557.26,
   "text": "את אותה מתיקות,"
  },
  {
   "start": 557.94,
   "end": 562.82,
   "text": "את אותה אהבה הם רואים בעיניים שלו כשסורקים את גופו במסריקות של ברזל."
  },
  {
   "start": 563.2,
   "end": 566.46,
   "text": "אמרו לו רבנו עד כאן, איך הגעת לדרגות האלה?"
  },
  {
   "start": 566.46,
   "end": 567.72,
   "text": "ואיך אפשר להגיע?"
  },
  {
   "start": 569.32,
   "end": 570.16,
   "text": "אמר להם, תדעו לכם,"
  },
  {
   "start": 572.41,
   "end": 572.93,
   "text": "כל יום"
  },
  {
   "start": 573.67,
   "end": 575.19,
   "text": "אני אומר, ואהבת את השם אלוקיך."
  },
  {
   "start": 576.63,
   "end": 579.69,
   "text": "כל יהודי אומר את זה, בכל לבבך ובכל נפשך."
  },
  {
   "start": 580.61,
   "end": 585.99,
   "text": "זה כמו איזה שטר שכל שם הם אומרים, כל יום אומרים, כל יום אומרים."
  },
  {
   "start": 587.57,
   "end": 589.59,
   "text": "אבל יום אחד לאותו שטר פתאום,"
  },
  {
   "start": 590.15,
   "end": 593.27,
   "text": "בורא עולם דואג שיגיע זמן הפירעון."
  },
  {
   "start": 594.43,
   "end": 596.03,
   "text": "זמן הפירעון."
  },
  {
   "start": 598.48,
   "end": 600.8,
   "text": "וכשמגיע זמן הפירעון,"
  },
  {
   "start": 601.82,
   "end": 605.08,
   "text": "אז בורא העולם אומר, בוא נראה אם השטר מזויף או אמיתי."
  },
  {
   "start": 605.5,
   "end": 610.42,
   "text": "בוא נראה אם כשאמרת ואהבת את השם אלוקיך בכל לבבך ובכל נפשך,"
  },
  {
   "start": 610.8,
   "end": 613.0,
   "text": "אמרת את זה ובאמת אהבת אותי,"
  },
  {
   "start": 613.34,
   "end": 615.28,
   "text": "ובאמת אהבת את התורה הקדושה."
  },
  {
   "start": 615.94,
   "end": 621.04,
   "text": "רבי עקיבא אומר להם, עד שהגיעה לידי ההזדמנות הזאת לקיים את השטר,"
  },
  {
   "start": 621.52,
   "end": 626.72,
   "text": "להראות באמת שכל השנים שאמרתי ואהבת, אהבתי את השם,"
  },
  {
   "start": 626.88,
   "end": 628.34,
   "text": "אהבתי את התורה הזו!"
  },
  {
   "start": 629.58,
   "end": 641.15,
   "text": "אני לא אקיים אותו בכל ספרי הקודש."
  },
  {
   "start": 642.67,
   "end": 653.07,
   "text": "בזוהר הקדוש יש תיאור מינימלי אבל תיאור כלשהו לפחות קצת של היכלות בגן עדן."
  },
  {
   "start": 655.56,
   "end": 658.14,
   "text": "יש היכלות, תיאור של מספר היכלות בשמיים,"
  },
  {
   "start": 659.38,
   "end": 661.32,
   "text": "אבל ההיכל של מקדשי השם,"
  },
  {
   "start": 661.92,
   "end": 665.34,
   "text": "ההיכל ששם נמצא רבי עקיבא וחבריו,"
  },
  {
   "start": 665.92,
   "end": 669.04,
   "text": "ההיכל הזה, עליו רשום בכל המקומות."
  },
  {
   "start": 670.16,
   "end": 675.22,
   "text": "אין לא ראתה אלוקים זולתך. זהו, זהו."
  },
  {
   "start": 675.72,
   "end": 680.2,
   "text": "אף אדם, אף נשמה לא זכתה לראות."
  },
  {
   "start": 681.0,
   "end": 686.4,
   "text": "לראות את זה. אי אפשר להבין את ההנאה שיש להם. אי אפשר להבין את ההשגה שיש להם שם."
  },
  {
   "start": 686.92,
   "end": 688.04,
   "text": "זה מקדשי השם."
  },
  {
   "start": 689.22,
   "end": 690.56,
   "text": "זה שיא של אהבה."
  },
  {
   "start": 691.56,
   "end": 695.44,
   "text": "זה מפגש בין נשמה לאבא שלה שבשמיים."
  },
  {
   "start": 707.22,
   "end": 710.98,
   "text": "אם יש איזו נקודה אחת"
  },
  {
   "start": 711.6,
   "end": 716.54,
   "text": "שאיתה אפשר לקפוץ מאות דרגות,"
  },
  {
   "start": 717.9,
   "end": 722.78,
   "text": "להגיע בהבזק של שנייה למעלות קדושים וטהורים,"
  },
  {
   "start": 724.24,
   "end": 725.18,
   "text": "זו הנקודה הזו"
  },
  {
   "start": 725.86,
   "end": 727.46,
   "text": "של מסירות נפש,"
  },
  {
   "start": 728.04,
   "end": 729.16,
   "text": "של קידוש עם שמיים,"
  },
  {
   "start": 729.72,
   "end": 731.8,
   "text": "שלעמוד, לא משנה מי אתה,"
  },
  {
   "start": 732.52,
   "end": 733.28,
   "text": "לא משנה מי את,"
  },
  {
   "start": 734.08,
   "end": 736.68,
   "text": "לא משנה מה, ולקדש שם שמיים."
  }
 ]
}