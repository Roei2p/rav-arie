{
 "disc": "2ב- הלב",
 "track": "Track05",
 "duration": 311.16,
 "segments": [
  {
   "start": 6.38,
   "end": 8.32,
   "text": "בואו נצא למסע"
  },
  {
   "start": 10.2,
   "end": 11.66,
   "text": "אל ליבו של האדם,"
  },
  {
   "start": 14.43,
   "end": 15.51,
   "text": "אל הלב שלנו."
  },
  {
   "start": 19.05,
   "end": 20.59,
   "text": "יש לאדם לב רוחני"
  },
  {
   "start": 21.41,
   "end": 22.31,
   "text": "בו הוא מרגיש."
  },
  {
   "start": 24.61,
   "end": 25.77,
   "text": "יש לאדם גם לב גשמי,"
  },
  {
   "start": 27.33,
   "end": 33.43,
   "text": "לב של בשר שפועם ומשפיע חיוניות ודם לכל האיברים."
  },
  {
   "start": 35.49,
   "end": 41.64,
   "text": "משפיע חיוניות כמו שהלב הרוחני משפיע על כל האיברים הרוחניים."
  },
  {
   "start": 42.64,
   "end": 45.32,
   "text": "ומאותו לב של בשר ניתן ללמוד הרבה."
  },
  {
   "start": 46.42,
   "end": 49.26,
   "text": "ניתן ללמוד הרבה על הלב, לב האדם הרוחני."
  },
  {
   "start": 51.08,
   "end": 51.36,
   "text": "הלב,"
  },
  {
   "start": 53.36,
   "end": 54.86,
   "text": "ארבעה חדרים יש ללב."
  },
  {
   "start": 56.32,
   "end": 59.92,
   "text": "החדר השמאלי מוליך דם לכל הגוף,"
  },
  {
   "start": 61.42,
   "end": 62.96,
   "text": "גם לאיברים שרחוקים ממנו."
  },
  {
   "start": 64.82,
   "end": 67.36,
   "text": "החדר הימני נוציא דם לריאות"
  },
  {
   "start": 68.12,
   "end": 69.14,
   "text": "שהן בסמוך אליו."
  },
  {
   "start": 72.8,
   "end": 73.6,
   "text": "להעביר דם"
  },
  {
   "start": 74.36,
   "end": 78.34,
   "text": "לריאות שהן קרובות אין צורך בלחץ גדול."
  },
  {
   "start": 79.62,
   "end": 81.12,
   "text": "לא צריך כל כך הרבה לחץ."
  },
  {
   "start": 82.36,
   "end": 83.44,
   "text": "והפלא ופלא,"
  },
  {
   "start": 83.98,
   "end": 86.56,
   "text": "עובי, העובי של החדר הימני,"
  },
  {
   "start": 87.28,
   "end": 88.5,
   "text": "זה שמעביר לריאות"
  },
  {
   "start": 89.5,
   "end": 90.54,
   "text": "הוא כחצי"
  },
  {
   "start": 91.28,
   "end": 93.06,
   "text": "מעובי החדר השמאלי,"
  },
  {
   "start": 93.58,
   "end": 94.68,
   "text": "שמעביר לכל הגוף,"
  },
  {
   "start": 95.2,
   "end": 96.84,
   "text": "שצריך הרבה יותר כוח,"
  },
  {
   "start": 97.94,
   "end": 99.08,
   "text": "הרבה יותר אנרגיה."
  },
  {
   "start": 100.12,
   "end": 102.22,
   "text": "אוי ואבוי לנו אם זה היה הפוך."
  },
  {
   "start": 103.6,
   "end": 108.1,
   "text": "מבשרי אחזה אלוקה, איזה תכנון מדויק ומדהים."
  },
  {
   "start": 113.11,
   "end": 117.83,
   "text": "יש בורא לאדם, את זה גם הלב יודע."
  },
  {
   "start": 121.73,
   "end": 123.17,
   "text": "חכם לוי ייקח מצוות,"
  },
  {
   "start": 124.25,
   "end": 125.21,
   "text": "אומרים חז״ל."
  },
  {
   "start": 125.85,
   "end": 127.45,
   "text": "חכם לוי יקנה אמונה."
  },
  {
   "start": 130.34,
   "end": 130.6,
   "text": "הלב,"
  },
  {
   "start": 131.44,
   "end": 132.34,
   "text": "הלב לא רק זאת,"
  },
  {
   "start": 133.28,
   "end": 137.8,
   "text": "אלא הלב של האדם כשהאדם הוא מתאמץ פיזית או נפשית."
  },
  {
   "start": 139.58,
   "end": 140.46,
   "text": "הלב יודע,"
  },
  {
   "start": 141.32,
   "end": 146.34,
   "text": "יודע בדיוק למהר ולשלוח דם במהירות גדולה יותר."
  },
  {
   "start": 147.02,
   "end": 150.42,
   "text": "וכשהאדם נח וישן ורגוע,"
  },
  {
   "start": 151.0,
   "end": 151.9,
   "text": "גם את זה הלב יודע,"
  },
  {
   "start": 152.54,
   "end": 153.78,
   "text": "ומאט את הפעילות שלו,"
  },
  {
   "start": 154.28,
   "end": 156.38,
   "text": "ושולח דם במהירות פחותה יותר."
  },
  {
   "start": 157.36,
   "end": 158.42,
   "text": "איזה תזמון מדויק."
  },
  {
   "start": 159.86,
   "end": 161.9,
   "text": "מבשרי אחזה אלוקה."
  },
  {
   "start": 163.02,
   "end": 163.76,
   "text": "יש מתכנן,"
  },
  {
   "start": 164.4,
   "end": 167.6,
   "text": "יש מתכנן ומשגיח, את זה גם הלב מבין."
  },
  {
   "start": 168.58,
   "end": 177.28,
   "text": "הלב, יצירת מופת שפועמת יותר משניים וחצי מיליארד פעימות במשך שבעים וחמש שנים."
  },
  {
   "start": 177.84,
   "end": 182.72,
   "text": "יותר משניים וחצי מיליארד פעימות במשך שבעים וחמש שנים."
  },
  {
   "start": 185.53,
   "end": 187.23,
   "text": "כשבלעדי פעימה אחת,"
  },
  {
   "start": 188.39,
   "end": 190.01,
   "text": "בלעדי העמקת מרץ הזו,"
  },
  {
   "start": 190.49,
   "end": 192.47,
   "text": "לא יגיע האדם החיוני כל כך,"
  },
  {
   "start": 194.25,
   "end": 196.39,
   "text": "שבגוף האדם אל כל חלקי הגוף,"
  },
  {
   "start": 200.27,
   "end": 201.99,
   "text": "בא בורא עולם ואומר, תראה,"
  },
  {
   "start": 204.14,
   "end": 209.97,
   "text": "תראה איך הלב מספק מהירות."
  },
  {
   "start": 210.45,
   "end": 212.55,
   "text": "ככה הלב הרוחני צריך לספק."
  },
  {
   "start": 213.09,
   "end": 216.09,
   "text": "הלב היהודי, שפת הלב צריכו לומר לנו,"
  },
  {
   "start": 216.47,
   "end": 223.07,
   "text": "בואו להתעורר אל אבא שבשמיים במהירות, בהתמדה, לא לעזוב את הקדוש ברוך הוא, לא לעזוב את עם ישראל, לא לעזוב את היהודית."
  },
  {
   "start": 229.16,
   "end": 231.62,
   "text": "איש לא יודע מה מפעיל את הלב."
  },
  {
   "start": 232.76,
   "end": 234.44,
   "text": "למה כשהעובר נוצר,"
  },
  {
   "start": 235.12,
   "end": 237.56,
   "text": "לפתע הלב מתחיל לעבוד. מי מפעיל אותו? מה מפעיל אותו?"
  },
  {
   "start": 238.38,
   "end": 240.1,
   "text": "ומה גורם לו להפסיק? סתם כך."
  },
  {
   "start": 241.04,
   "end": 242.72,
   "text": "באיזה יום בהיר שטוף שמש,"
  },
  {
   "start": 243.24,
   "end": 246.02,
   "text": "ואפילו שכל האיברים שלמים ותקינים."
  },
  {
   "start": 246.66,
   "end": 247.26,
   "text": "לפתע פתאום"
  },
  {
   "start": 247.94,
   "end": 248.76,
   "text": "הלב מפסיק."
  },
  {
   "start": 251.62,
   "end": 253.76,
   "text": "בהשם יתברך לומר, תדע לך, יהודי,"
  },
  {
   "start": 254.34,
   "end": 256.0,
   "text": "יש התחלה ויש סוף."
  },
  {
   "start": 256.68,
   "end": 260.92,
   "text": "תנצל את הזמן, תלמד את השיעור שהלב שלך מלמד אותך."
  },
  {
   "start": 261.72,
   "end": 262.8,
   "text": "תנצל את הלב"
  },
  {
   "start": 263.5,
   "end": 265.0,
   "text": "כל זמן שיש לך זמן."
  },
  {
   "start": 266.48,
   "end": 266.72,
   "text": "הלב,"
  },
  {
   "start": 267.84,
   "end": 269.62,
   "text": "כשהגוף מתאמץ במשך זמן,"
  },
  {
   "start": 270.6,
   "end": 276.14,
   "text": "הלב מספק כמות פי שמונה של דם,"
  },
  {
   "start": 276.66,
   "end": 279.1,
   "text": "משהו כמו ארבעים וחמישה ליטר לדקה."
  },
  {
   "start": 280.32,
   "end": 280.76,
   "text": "והלב,"
  },
  {
   "start": 281.28,
   "end": 281.92,
   "text": "כשהוא מתאמץ,"
  },
  {
   "start": 282.32,
   "end": 282.98,
   "text": "הוא גודל,"
  },
  {
   "start": 283.4,
   "end": 285.68,
   "text": "הוא גודל מגודל רגיל כמו של אגרוף,"
  },
  {
   "start": 286.66,
   "end": 289.58,
   "text": "לגודל כזה שממלא את חצי בתחזה."
  },
  {
   "start": 292.46,
   "end": 293.76,
   "text": "בא הלב ללמד אותנו,"
  },
  {
   "start": 294.34,
   "end": 296.02,
   "text": "כאשר האדם מתאמץ,"
  },
  {
   "start": 296.4,
   "end": 299.8,
   "text": "כאשר היהודי-היהודייה מתאמצים לכבוד השם,"
  },
  {
   "start": 300.26,
   "end": 304.74,
   "text": "הם גודלים פי כמה וכמה יותר ממה שהם באמת."
  },
  {
   "start": 305.36,
   "end": 308.82,
   "text": "הם לא יכולים לחולל פלאות, הם יכולים להביא ישועות לעולם."
  }
 ]
}