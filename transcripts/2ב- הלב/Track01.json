{
 "disc": "2ב- הלב",
 "track": "Track01",
 "duration": 515.16,
 "segments": [
  {
   "start": 29.97,
   "end": 34.52,
   "text": "החפץ חיים, החפץ חיים."
  },
  {
   "start": 35.9,
   "end": 40.92,
   "text": "פעם אחת נצרך לצאת,"
  },
  {
   "start": 42.42,
   "end": 43.3,
   "text": "לצאת מראדין,"
  },
  {
   "start": 44.88,
   "end": 45.48,
   "text": "וללכת"
  },
  {
   "start": 46.86,
   "end": 48.12,
   "text": "אל שלטונות פולין,"
  },
  {
   "start": 49.2,
   "end": 49.46,
   "text": "למען,"
  },
  {
   "start": 50.38,
   "end": 51.02,
   "text": "למען הדבר,"
  },
  {
   "start": 51.82,
   "end": 53.76,
   "text": "למען העם שהוא כל כך אהב אותו, עם ישראל."
  },
  {
   "start": 83.62,
   "end": 85.82,
   "text": "היה זה כאשר שלטונות פולין,"
  },
  {
   "start": 86.46,
   "end": 92.88,
   "text": "שלטונות פולין החליטו שכל ילד יהודי שרוצה ללמוד תורה,"
  },
  {
   "start": 93.46,
   "end": 95.74,
   "text": "שרוצה להתקרב לאבא שבשמיים,"
  },
  {
   "start": 96.24,
   "end": 102.08,
   "text": "יצטרך לשלב יחד עם זה גם אזרחות פולנית."
  },
  {
   "start": 102.88,
   "end": 103.44,
   "text": "ובכלל,"
  },
  {
   "start": 103.84,
   "end": 109.68,
   "text": "שלטונות פולין החליטו שכל דבר של יהדות, כל דבר של תורה יצומצם,"
  },
  {
   "start": 110.02,
   "end": 110.74,
   "text": "ואז הם נפגשו."
  },
  {
   "start": 112.54,
   "end": 115.88,
   "text": "האדמו״ר מגור וחפץ חיים,"
  },
  {
   "start": 116.4,
   "end": 122.21,
   "text": "כבר כשהחפץ חיים היה אדם ישיש מאוד בדרך"
  },
  {
   "start": 124.64,
   "end": 125.78,
   "text": "אל שלטונות פולין."
  },
  {
   "start": 127.22,
   "end": 128.5,
   "text": "וזה לא העניין של מה בכך."
  },
  {
   "start": 132.47,
   "end": 133.35,
   "text": "שם אצל הפולנים"
  },
  {
   "start": 135.27,
   "end": 137.23,
   "text": "לא היה שייך המושג הזה רחמים."
  },
  {
   "start": 139.68,
   "end": 142.68,
   "text": "שם אצל הפולנים טעות קטנה,"
  },
  {
   "start": 143.4,
   "end": 146.26,
   "text": "מילה אולי לא כל כך מתאימה,"
  },
  {
   "start": 148.86,
   "end": 151.94,
   "text": "ואותו האדם יכול לשלם על כך בחייו,"
  },
  {
   "start": 152.5,
   "end": 154.04,
   "text": "ואולי אף לגרום לנזק"
  },
  {
   "start": 155.4,
   "end": 156.16,
   "text": "יותר גדול."
  },
  {
   "start": 159.13,
   "end": 159.95,
   "text": "והחפץ חיים"
  },
  {
   "start": 159.95,
   "end": 172.63,
   "text": "נכנס פנימה ועוד מספר דקות והוא עומד מול ראשי ממשלת פולין."
  },
  {
   "start": 177.3,
   "end": 180.08,
   "text": "החפץ חיים לא ידע פולנית, לכן העמידו שם מתורגמן."
  },
  {
   "start": 180.84,
   "end": 186.9,
   "text": "מתורגמן יהודי שיודע לתרגם לפולנית,"
  },
  {
   "start": 192.24,
   "end": 195.74,
   "text": "וניתנה הרשות"
  },
  {
   "start": 196.34,
   "end": 199.62,
   "text": "לחפץ חיים להסביר מה הוא רוצה,"
  },
  {
   "start": 200.32,
   "end": 208.1,
   "text": "מה מפריע למנהיגות היהודית של עם ישראל ולהפתעת הכל,"
  },
  {
   "start": 210.38,
   "end": 216.62,
   "text": "החפץ חיים פתח את פיו הקדוש והטהור,"
  },
  {
   "start": 217.54,
   "end": 220.12,
   "text": "את פיו זה שכל חייו שמר"
  },
  {
   "start": 221.82,
   "end": 224.18,
   "text": "לו להוציא לשון הרע על אחיו."
  },
  {
   "start": 226.1,
   "end": 227.24,
   "text": "אמר החפץ חיים,"
  },
  {
   "start": 227.98,
   "end": 228.54,
   "text": "תדע לך,"
  },
  {
   "start": 229.72,
   "end": 231.76,
   "text": "תדעו לכם כל שלטונות פולין,"
  },
  {
   "start": 232.72,
   "end": 233.42,
   "text": "שלא תצליחו,"
  },
  {
   "start": 234.38,
   "end": 240.22,
   "text": "שאת עם ישראל טהור היהודי של יהודי ויהודייה אי אפשר לכבות, לא תצליחו."
  },
  {
   "start": 240.62,
   "end": 243.38,
   "text": "היו רבים וטובים בעולם שניסו ולא הצליחו."
  },
  {
   "start": 243.84,
   "end": 246.28,
   "text": "היה אפילו מלך מצרים שקוראים לו פרעה,"
  },
  {
   "start": 246.72,
   "end": 247.4,
   "text": "שהוא אמר,"
  },
  {
   "start": 247.78,
   "end": 249.86,
   "text": "בין הילודי אורא תשליכו."
  },
  {
   "start": 250.3,
   "end": 252.2,
   "text": "הוא רצה להרוג את כל הילדים,"
  },
  {
   "start": 252.86,
   "end": 257.62,
   "text": "ובסוף הוא וכל חילו טבעו בים."
  },
  {
   "start": 258.78,
   "end": 262.76,
   "text": "ורק הוא ניצה לבוא לספר לכל המשפחות של החיילים שלו,"
  },
  {
   "start": 263.88,
   "end": 268.12,
   "text": "שהוא למעשה גרם בניסיונות שלו לפגוע בעם ישראל"
  },
  {
   "start": 268.12,
   "end": 272.44,
   "text": "להרס של אממ, העם המצרי, האימפריה המצרית לצמיתות."
  },
  {
   "start": 273.26,
   "end": 278.38,
   "text": "אז כמו שפרעה קיבל מכות נוראות מבורא עולם,"
  },
  {
   "start": 278.82,
   "end": 279.56,
   "text": "גם אתם,"
  },
  {
   "start": 279.98,
   "end": 285.14,
   "text": "גם אתה תקבל מכות נוראות מבורא עולם אם לא תפסיק עם זה,"
  },
  {
   "start": 285.58,
   "end": 291.84,
   "text": "אם לא תפסיק לעצר את עולם התורה היהודי."
  },
  {
   "start": 296.59,
   "end": 300.96,
   "text": "כל היהודים שהיו בחדר נדרכו, תורגמן."
  },
  {
   "start": 302.22,
   "end": 303.46,
   "text": "המתורגמן עמד,"
  },
  {
   "start": 304.02,
   "end": 310.3,
   "text": "חיוור כולו ופשוט החל לרעוד רועד בכל גופו."
  },
  {
   "start": 311.76,
   "end": 317.18,
   "text": "הוא פחד אפילו לתרגם דבר שכזה."
  },
  {
   "start": 318.16,
   "end": 321.52,
   "text": "איך הוא יגיד? איך הוא יגיד את מה שהחפץ חיים אמר לזה?"
  },
  {
   "start": 322.1,
   "end": 327.32,
   "text": "זה לא יאומן שיהודי ירשה לעצמו לומר דברים כאלה לשלטונות פולין?"
  },
  {
   "start": 333.22,
   "end": 338.38,
   "text": "אז התרחש מה שאותו מתורגמן לא ישכח כל ימי חייו."
  },
  {
   "start": 347.65,
   "end": 348.55,
   "text": "הכל בפולנית."
  },
  {
   "start": 349.59,
   "end": 354.55,
   "text": "הקול של ראש שלטונות פולין היה ברור והחלטי,"
  },
  {
   "start": 356.27,
   "end": 357.03,
   "text": "מתורגמן,"
  },
  {
   "start": 357.79,
   "end": 359.11,
   "text": "אל תתרגם לי כלום."
  },
  {
   "start": 360.53,
   "end": 361.91,
   "text": "אתה לא צריך לתרגם לי."
  },
  {
   "start": 362.87,
   "end": 363.45,
   "text": "הבנתי,"
  },
  {
   "start": 364.41,
   "end": 365.45,
   "text": "הבנתי את היהודי הזה,"
  },
  {
   "start": 366.23,
   "end": 367.41,
   "text": "הבנתי את מה שהוא אמר."
  },
  {
   "start": 369.31,
   "end": 370.39,
   "text": "וכולם הסתכלו,"
  },
  {
   "start": 371.13,
   "end": 373.25,
   "text": "איך אתה יודע, הוא לא דיבר בפולנית."
  },
  {
   "start": 374.11,
   "end": 374.99,
   "text": "כך פנו אליו,"
  },
  {
   "start": 375.59,
   "end": 378.55,
   "text": "כולם אומרים לו, איך אתה יודע מה הוא אמר,"
  },
  {
   "start": 378.55,
   "end": 379.93,
   "text": "הוא לא דיבר בפולנית."
  },
  {
   "start": 383.95,
   "end": 384.93,
   "text": "אתם יודעים איך אני יודע,"
  },
  {
   "start": 386.01,
   "end": 386.69,
   "text": "הוא אמר."
  },
  {
   "start": 387.67,
   "end": 389.03,
   "text": "הוא דיבר בשפה,"
  },
  {
   "start": 389.95,
   "end": 391.89,
   "text": "הוא דיבר בשפה בינלאומית."
  },
  {
   "start": 393.41,
   "end": 398.23,
   "text": "לא צריך מתורגמן להבין את מה שהיהודי המבוגר הזה דיבר,"
  },
  {
   "start": 398.71,
   "end": 400.59,
   "text": "את מה שהיהודי החכם הזה דיבר,"
  },
  {
   "start": 401.21,
   "end": 405.09,
   "text": "כי הוא לא דיבר בשפה רגילה, הוא דיבר בשפה בינלאומית."
  },
  {
   "start": 406.07,
   "end": 408.07,
   "text": "היהודי הזה דיבר מהלב,"
  },
  {
   "start": 408.95,
   "end": 410.61,
   "text": "דיבר מהלב שלו."
  },
  {
   "start": 411.15,
   "end": 413.01,
   "text": "לא כואב באמת על היהודים."
  },
  {
   "start": 414.33,
   "end": 416.73,
   "text": "ואת השפה הזו, השפה של הלב,"
  },
  {
   "start": 417.65,
   "end": 419.09,
   "text": "את זה כולם מבינים."
  },
  {
   "start": 420.19,
   "end": 425.73,
   "text": "לא צריך מתורגמן כדי להבין את השפה, את שפת הלב."
  },
  {
   "start": 429.78,
   "end": 433.4,
   "text": "וכאדם אני חייב להיענות למה שהוא אמר."
  },
  {
   "start": 434.1,
   "end": 436.7,
   "text": "כל הבקשות שלך, אני אפילו לא יודע מה הן במדויק,"
  },
  {
   "start": 437.3,
   "end": 439.02,
   "text": "אבל כל מה שאתה רוצה,"
  },
  {
   "start": 440.3,
   "end": 441.18,
   "text": "יתבצע."
  },
  {
   "start": 442.1,
   "end": 443.62,
   "text": "הלב שלך דיבר."
  },
  {
   "start": 443.94,
   "end": 449.32,
   "text": "זה מה שצריך בעולם שלנו, לב, כל מה שאתה דורש, יהודי יקר."
  },
  {
   "start": 450.78,
   "end": 452.38,
   "text": "אנחנו מסכימים, מבטלים את הכול."
  },
  {
   "start": 454.91,
   "end": 463.14,
   "text": "והחפץ חי יצא עם המשלחת היהודית אחרי שנתן שיעור לכולם"
  },
  {
   "start": 464.88,
   "end": 468.36,
   "text": "על גודל ועוצמת הלב היהודי."
  },
  {
   "start": 473.74,
   "end": 484.1,
   "text": "ואת השפה הזאת אנחנו רוצים להזכיר לכולנו."
  },
  {
   "start": 485.6,
   "end": 486.56,
   "text": "להזכיר לכולנו."
  },
  {
   "start": 486.56,
   "end": 491.38,
   "text": "בדור שאולי לא היה דור מכני כל כך."
  },
  {
   "start": 493.93,
   "end": 498.03,
   "text": "בואו בעזרת השם היום נדבר בשפה שכולם מבינים,"
  },
  {
   "start": 498.37,
   "end": 500.01,
   "text": "שפה שכולם רוצים,"
  },
  {
   "start": 500.27,
   "end": 502.37,
   "text": "שפה שכולם הורגים אליה."
  },
  {
   "start": 502.91,
   "end": 503.99,
   "text": "שפת הלב."
  },
  {
   "start": 504.27,
   "end": 505.27,
   "text": "שפת הלב."
  },
  {
   "start": 506.31,
   "end": 507.31,
   "text": "שפת."
  }
 ]
}