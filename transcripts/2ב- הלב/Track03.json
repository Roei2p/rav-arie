{
 "disc": "2ב- הלב",
 "track": "Track03",
 "duration": 1177.176,
 "segments": [
  {
   "start": 8.38,
   "end": 9.68,
   "text": "זהו מקרה מאוד מיוחד,"
  },
  {
   "start": 12.02,
   "end": 20.19,
   "text": "שהתרחש לפני כמה שנים כאן,"
  },
  {
   "start": 21.23,
   "end": 22.09,
   "text": "בארץ ישראל,"
  },
  {
   "start": 27.11,
   "end": 28.21,
   "text": "בתוך אחד המקומות"
  },
  {
   "start": 31.67,
   "end": 36.11,
   "text": "שרבים מאיתנו לא היו שמחים להיות שם,"
  },
  {
   "start": 37.57,
   "end": 38.85,
   "text": "בתוך בית הסוהר,"
  },
  {
   "start": 42.62,
   "end": 42.92,
   "text": "שם,"
  },
  {
   "start": 44.18,
   "end": 44.84,
   "text": "שם בכלא,"
  },
  {
   "start": 48.51,
   "end": 49.67,
   "text": "באגף של היהודים,"
  },
  {
   "start": 51.78,
   "end": 56.16,
   "text": "בקולתה שכנו להם אחר כבוד 40 אסירים,"
  },
  {
   "start": 56.86,
   "end": 57.8,
   "text": "צפיפות נוראה,"
  },
  {
   "start": 58.9,
   "end": 62.06,
   "text": "חלק מהאסירים היה על רקע מדיני,"
  },
  {
   "start": 62.56,
   "end": 63.56,
   "text": "זה היה עידן המחתרות,"
  },
  {
   "start": 64.78,
   "end": 65.46,
   "text": "לחי אצל,"
  },
  {
   "start": 68.16,
   "end": 68.6,
   "text": "וחלק"
  },
  {
   "start": 69.54,
   "end": 70.88,
   "text": "היו אסירים פליליים."
  },
  {
   "start": 79.55,
   "end": 80.19,
   "text": "בין כל האסירים,"
  },
  {
   "start": 84.76,
   "end": 87.24,
   "text": "ואפילו האסירים הפליליים הקשים ביותר,"
  },
  {
   "start": 89.95,
   "end": 90.63,
   "text": "היה אחד,"
  },
  {
   "start": 91.93,
   "end": 93.33,
   "text": "אסיר אחד שקראו לו יונה."
  },
  {
   "start": 94.49,
   "end": 95.81,
   "text": "יונה היה אסיר העולם."
  },
  {
   "start": 97.91,
   "end": 100.83,
   "text": "יונה פשוט"
  },
  {
   "start": 102.67,
   "end": 103.43,
   "text": "קם יום אחד,"
  },
  {
   "start": 106.47,
   "end": 107.37,
   "text": "ולאור היום,"
  },
  {
   "start": 108.05,
   "end": 108.81,
   "text": "בירושלים,"
  },
  {
   "start": 110.47,
   "end": 116.25,
   "text": "רצח את אשתו כשהיא אוחזת בידיים שלה את התינוק שלהם."
  },
  {
   "start": 117.91,
   "end": 124.23,
   "text": "הוא רצח אותה במו ידיו לאור היום באכזריות נוראה,"
  },
  {
   "start": 126.8,
   "end": 130.7,
   "text": "ובמשפט שלו הוא טען,"
  },
  {
   "start": 131.86,
   "end": 133.12,
   "text": "אני לא מבין מה הבעיה."
  },
  {
   "start": 134.1,
   "end": 134.78,
   "text": "היא אשתי."
  },
  {
   "start": 138.1,
   "end": 139.48,
   "text": "מה אתם רוצים? מה הבעיה?"
  },
  {
   "start": 140.26,
   "end": 140.8,
   "text": "היא אשתי."
  },
  {
   "start": 143.8,
   "end": 144.54,
   "text": "בבית הסוהר,"
  },
  {
   "start": 145.5,
   "end": 148.94,
   "text": "אף אחד לא רצה להיות בקרבתו של יונה."
  },
  {
   "start": 149.72,
   "end": 150.78,
   "text": "כולם סלדו ממנו."
  },
  {
   "start": 152.18,
   "end": 161.36,
   "text": "כולם סלדו מאותו אדם שנראה ששום ניצוץ של רגש אין בו."
  },
  {
   "start": 162.06,
   "end": 163.22,
   "text": "הוא יקר כקרח,"
  },
  {
   "start": 169.77,
   "end": 170.29,
   "text": "מרוחק מכולם,"
  },
  {
   "start": 171.37,
   "end": 172.39,
   "text": "מסוגר מכולם,"
  },
  {
   "start": 174.56,
   "end": 175.42,
   "text": "אולי גם מאיים מכולם."
  },
  {
   "start": 187.03,
   "end": 188.01,
   "text": "שם בבית הסוהר,"
  },
  {
   "start": 190.82,
   "end": 197.12,
   "text": "שם באמצע החיים הקשוחים של אסיר בכלא,"
  },
  {
   "start": 198.4,
   "end": 203.56,
   "text": "היה אדם אחד מיוחד שהיה בא לבקר את האסירים."
  },
  {
   "start": 205.26,
   "end": 207.02,
   "text": "כי הם כינו אותו הרב של האסירים,"
  },
  {
   "start": 208.02,
   "end": 209.1,
   "text": "רבי אריה לוין."
  },
  {
   "start": 210.78,
   "end": 211.76,
   "text": "ורבי אריה לוין"
  },
  {
   "start": 213.18,
   "end": 216.22,
   "text": "הוא לא הבדיל בין אסיר זה לאסיר אחר."
  },
  {
   "start": 216.9,
   "end": 218.44,
   "text": "את כולם הוא היה מקרב,"
  },
  {
   "start": 219.24,
   "end": 220.48,
   "text": "את כולם הוא היה מלטף,"
  },
  {
   "start": 221.66,
   "end": 223.06,
   "text": "אל כולם הוא היה מתייחס."
  },
  {
   "start": 225.16,
   "end": 225.96,
   "text": "וגם אל יונה,"
  },
  {
   "start": 226.72,
   "end": 227.38,
   "text": "אותו יונה,"
  },
  {
   "start": 228.0,
   "end": 230.5,
   "text": "שהיה מנוכר ומובדל מכל האסירים,"
  },
  {
   "start": 231.7,
   "end": 233.02,
   "text": "שאיש לא רצה בקרבתו,"
  },
  {
   "start": 234.32,
   "end": 235.2,
   "text": "גם אליו הוא התקרב,"
  },
  {
   "start": 236.36,
   "end": 236.92,
   "text": "גם אליו"
  },
  {
   "start": 237.8,
   "end": 239.1,
   "text": "הוא היה נותן יחס."
  },
  {
   "start": 240.66,
   "end": 243.34,
   "text": "ויום אחד, כשהוא חש שעה-שעה כשרה,"
  },
  {
   "start": 244.16,
   "end": 245.4,
   "text": "הוא הניח יד תומכת,"
  },
  {
   "start": 246.34,
   "end": 247.88,
   "text": "יד אבהית, יד אבהית,"
  },
  {
   "start": 249.0,
   "end": 252.18,
   "text": "חמה ומחזקת גם ליונה."
  },
  {
   "start": 267.06,
   "end": 267.94,
   "text": "זה היה ביום ראשון."
  },
  {
   "start": 271.85,
   "end": 272.47,
   "text": "לפתע יונה,"
  },
  {
   "start": 278.67,
   "end": 279.55,
   "text": "יונה קם בבוקר."
  },
  {
   "start": 280.71,
   "end": 285.53,
   "text": "ומתקרב אל אזור האסירים,"
  },
  {
   "start": 288.13,
   "end": 291.57,
   "text": "ופונה אל משה סגל."
  },
  {
   "start": 292.27,
   "end": 295.81,
   "text": "אותו סגל היה הראש של האסירים, המנהיג של האסירים שם."
  },
  {
   "start": 296.37,
   "end": 297.71,
   "text": "על פיו יישק דבר בכלא."
  },
  {
   "start": 298.69,
   "end": 299.21,
   "text": "פנה אליו"
  },
  {
   "start": 301.03,
   "end": 302.31,
   "text": "אני רוצה תפילין."
  },
  {
   "start": 304.21,
   "end": 305.03,
   "text": "וסגל הביט בו."
  },
  {
   "start": 309.03,
   "end": 310.09,
   "text": "תוך שניות ספורות"
  },
  {
   "start": 311.41,
   "end": 312.89,
   "text": "השתררה דממה מעיקה,"
  },
  {
   "start": 313.87,
   "end": 316.93,
   "text": "ואת המתח באוויר יהיה ניתן לחתוך בסכין."
  },
  {
   "start": 319.22,
   "end": 320.12,
   "text": "אני רוצה תפילין,"
  },
  {
   "start": 321.18,
   "end": 323.04,
   "text": "סינן יונה."
  },
  {
   "start": 324.98,
   "end": 327.86,
   "text": "והאסירים, האסירים הפליליים, קמו ממקומם."
  },
  {
   "start": 329.18,
   "end": 337.15,
   "text": "הם לא היו מוכנים לסבול שיונה יבוא ויהיה זלזל אולי במצרך היקר ביותר בבית הסוהר שם,"
  },
  {
   "start": 338.53,
   "end": 339.49,
   "text": "בסמל של היהודי."
  },
  {
   "start": 342.25,
   "end": 346.27,
   "text": "יונה מעולם לא התקרב ליהדות, יונה לא גילה זיק של אמונה."
  },
  {
   "start": 347.87,
   "end": 350.03,
   "text": "מה פתאום הוא רוצה תפילין? כנראה הוא רוצה לזלזל."
  },
  {
   "start": 350.65,
   "end": 354.99,
   "text": "כנראה הוא רוצה לפגוע בדבר המקודש לנו."
  },
  {
   "start": 356.39,
   "end": 357.27,
   "text": "ואז הם עמדו מנגד."
  },
  {
   "start": 361.1,
   "end": 368.88,
   "text": "עניין של שניות מספר שהתרחש מאבק רצחני בין האסירים הקשוחים ליונה."
  },
  {
   "start": 370.1,
   "end": 371.24,
   "text": "אותו רוצח אכזר."
  },
  {
   "start": 373.81,
   "end": 376.73,
   "text": "אבל אז סגל הרגיע את האסירים."
  },
  {
   "start": 379.31,
   "end": 382.57,
   "text": "אתה בטוח שאתה רוצה תפילין? הוא פנה אל יונה, ויונה אמר לו כן."
  },
  {
   "start": 384.57,
   "end": 387.29,
   "text": "סגל לקח את שקית התפילין,"
  },
  {
   "start": 388.83,
   "end": 388.99,
   "text": "זו"
  },
  {
   "start": 389.61,
   "end": 391.89,
   "text": "ששירתה את כולם באמונה,"
  },
  {
   "start": 393.39,
   "end": 394.13,
   "text": "ונתן אותה"
  },
  {
   "start": 395.69,
   "end": 396.15,
   "text": "אל יונה."
  },
  {
   "start": 398.44,
   "end": 401.44,
   "text": "יונה לוקח את התפילין ומתחיל להניח תפילין."
  },
  {
   "start": 405.03,
   "end": 405.61,
   "text": "אבל אז,"
  },
  {
   "start": 406.53,
   "end": 407.61,
   "text": "אז המתח גאה,"
  },
  {
   "start": 408.43,
   "end": 409.21,
   "text": "אז הזעם עלה."
  },
  {
   "start": 410.47,
   "end": 412.59,
   "text": "יונה הניח תפילין ביד ימין,"
  },
  {
   "start": 413.41,
   "end": 414.31,
   "text": "כאילו לא יודע,"
  },
  {
   "start": 415.15,
   "end": 420.45,
   "text": "או כאילו לא אכפת לו שתפילין מניחים ביד שמאל ומניח ביד ימין."
  },
  {
   "start": 422.91,
   "end": 423.41,
   "text": "האסירים,"
  },
  {
   "start": 425.29,
   "end": 430.57,
   "text": "האסירים שראו בזה פגיעה וזלזול בתפילין קמו."
  },
  {
   "start": 432.53,
   "end": 439.21,
   "text": "הם רצו לעשות שפטים ביונה, אבל אז סגל עצר אותם, אמר להם תמתינו,"
  },
  {
   "start": 442.5,
   "end": 442.96,
   "text": "תמתינו,"
  },
  {
   "start": 443.6,
   "end": 443.84,
   "text": "הרב,"
  },
  {
   "start": 444.58,
   "end": 447.32,
   "text": "הרב לא ירצה את זה, הקדוש ברוך הוא לא יאהב את זה."
  },
  {
   "start": 448.12,
   "end": 449.06,
   "text": "בואו נמתין שנייה."
  },
  {
   "start": 455.52,
   "end": 456.7,
   "text": "יונה הניח את התפילין,"
  },
  {
   "start": 460.95,
   "end": 461.75,
   "text": "כשהוא סיים,"
  },
  {
   "start": 463.09,
   "end": 464.89,
   "text": "קיפל אותם בזהירות ושם אותם"
  },
  {
   "start": 466.07,
   "end": 466.95,
   "text": "בכיס התפילין."
  },
  {
   "start": 467.89,
   "end": 468.47,
   "text": "ניגש אליו,"
  },
  {
   "start": 469.25,
   "end": 470.25,
   "text": "ניגש אליו סגל,"
  },
  {
   "start": 471.37,
   "end": 474.11,
   "text": "כשמסביבו עומדים דרוכים האסירים,"
  },
  {
   "start": 475.21,
   "end": 476.89,
   "text": "ואמר לו יונה, תגיד לי."
  },
  {
   "start": 477.57,
   "end": 479.71,
   "text": "יונה, תגיד לי, אתה לא יודע באיזה יד,"
  },
  {
   "start": 480.33,
   "end": 482.43,
   "text": "אתה לא יודע באיזו יד מניחים את התפילין?"
  },
  {
   "start": 483.43,
   "end": 484.81,
   "text": "אמר לו יונה, אני יודע."
  },
  {
   "start": 484.81,
   "end": 489.97,
   "text": "יונה אתה יודע שביד שמאל מניחים את התפילין?"
  },
  {
   "start": 490.93,
   "end": 492.43,
   "text": "ויונה מביט בו"
  },
  {
   "start": 493.35,
   "end": 497.15,
   "text": "ואומר לו כן אני יודע שביד שמאל מניחים את התפילין"
  },
  {
   "start": 497.97,
   "end": 499.61,
   "text": "אז למה הנחת ביד ימין?"
  },
  {
   "start": 500.85,
   "end": 503.41,
   "text": "אולי אולי אתה איתר?"
  },
  {
   "start": 504.21,
   "end": 506.69,
   "text": "אולי אתה לא יכול להניח ביד שמאל?"
  },
  {
   "start": 510.88,
   "end": 512.44,
   "text": "אמר לו יונה אני לא איתר."
  },
  {
   "start": 513.42,
   "end": 516.54,
   "text": "למעשה אני צריך להניח ביד שמאל."
  },
  {
   "start": 521.72,
   "end": 522.8,
   "text": "אבל אתה שואל אותי,"
  },
  {
   "start": 523.52,
   "end": 524.34,
   "text": "אתה שואל אותי"
  },
  {
   "start": 525.18,
   "end": 531.63,
   "text": "למה הנחתי ביד ימין?"
  },
  {
   "start": 538.82,
   "end": 539.64,
   "text": "אז תדע לך,"
  },
  {
   "start": 540.28,
   "end": 543.92,
   "text": "תדעו לכם כולכם, אחרי הביקור של הרב,"
  },
  {
   "start": 545.06,
   "end": 546.06,
   "text": "אחרי שהרב,"
  },
  {
   "start": 547.88,
   "end": 549.06,
   "text": "אחרי שהרב בא,"
  },
  {
   "start": 550.42,
   "end": 558.4,
   "text": "רבי אריה לוין בא ונתן לי את מה שהעולם בחוץ לא נתן לי מעולם,"
  },
  {
   "start": 559.04,
   "end": 559.94,
   "text": "נתן לי קצת קרבה,"
  },
  {
   "start": 561.72,
   "end": 563.5,
   "text": "נתן לי קצת יחס חם."
  },
  {
   "start": 564.98,
   "end": 569.06,
   "text": "סוף סוף אחרי שנים נפתח לי הלב,"
  },
  {
   "start": 569.8,
   "end": 572.36,
   "text": "נפתח לי הלב האטום שלי."
  },
  {
   "start": 573.52,
   "end": 580.0,
   "text": "ולפתע שכבתי בלילה ואני חושב הזיכרונות עולים,"
  },
  {
   "start": 581.06,
   "end": 584.18,
   "text": "והבנתי מה עשיתי,"
  },
  {
   "start": 585.5,
   "end": 591.86,
   "text": "הבנתי מה עוללתי,"
  },
  {
   "start": 592.32,
   "end": 595.14,
   "text": "איזה פשע איום עשיתי."
  },
  {
   "start": 596.08,
   "end": 606.24,
   "text": "ובאתי וביקשתי להניח תפילין. וכשבאתי להניח את התפילין והרמתי את יד שמאל,"
  },
  {
   "start": 607.58,
   "end": 614.64,
   "text": "אז נזכרתי לפתע, אבל ביד שמאל, ביד שמאל אני רצחתי אותי."
  },
  {
   "start": 615.04,
   "end": 620.66,
   "text": "ביד שמאל אני פגעתי באשתי על לא עוול בכפרה."
  },
  {
   "start": 621.88,
   "end": 622.64,
   "text": "יד שמאל"
  },
  {
   "start": 624.4,
   "end": 625.9,
   "text": "שפכה דם."
  },
  {
   "start": 626.78,
   "end": 627.3,
   "text": "אני לא יכול,"
  },
  {
   "start": 628.12,
   "end": 631.56,
   "text": "לא יכול להניח דבר כל כך קדוש כמו תפילין."
  },
  {
   "start": 635.97,
   "end": 642.22,
   "text": "אני לא יכול להניח דבר כל כך קדוש ביד שמאל,"
  },
  {
   "start": 643.04,
   "end": 644.82,
   "text": "זאת ששפכה דם נקי."
  },
  {
   "start": 651.49,
   "end": 653.13,
   "text": "לכן הנחתי על יתימון,"
  },
  {
   "start": 655.76,
   "end": 659.44,
   "text": "ויונה הביט באסירים שמולו."
  },
  {
   "start": 660.36,
   "end": 671.35,
   "text": "לראשונה מזה עשרות שנים התגלגלו להם תזוג דמעות שקופות במורד לחיות."
  },
  {
   "start": 673.47,
   "end": 673.95,
   "text": "יונה,"
  },
  {
   "start": 675.29,
   "end": 676.39,
   "text": "יונה בכה,"
  },
  {
   "start": 677.21,
   "end": 678.13,
   "text": "בכה ללא קול,"
  },
  {
   "start": 679.15,
   "end": 685.36,
   "text": "אבל עם כל הלב, באותו מעמד"
  },
  {
   "start": 687.88,
   "end": 689.58,
   "text": "האסירים הקשוחים ביותר,"
  },
  {
   "start": 690.72,
   "end": 693.7,
   "text": "אלה שרגילים לחיות כל חייהם בקשיחות."
  },
  {
   "start": 696.66,
   "end": 699.22,
   "text": "עיני האסירים הקשוחים ביותר נתמלאו דמעות."
  },
  {
   "start": 700.18,
   "end": 709.52,
   "text": "איש לא יכל להחזיק את עצמו בשוויון נפש למול היחשפות הלב היהודי,"
  },
  {
   "start": 711.47,
   "end": 713.65,
   "text": "הניצוץ המופלא הזה שבלב היהודי."
  },
  {
   "start": 718.11,
   "end": 719.79,
   "text": "אם התחלנו לפתוח את הלב,"
  },
  {
   "start": 720.17,
   "end": 721.77,
   "text": "את הניצוץ שבלב היהודי,"
  },
  {
   "start": 722.23,
   "end": 723.13,
   "text": "אז בואו נמשיך,"
  },
  {
   "start": 723.55,
   "end": 726.75,
   "text": "בואו נעבור מארץ ישראל אל מקום רחוק,"
  },
  {
   "start": 727.87,
   "end": 728.99,
   "text": "אל מקום נידח,"
  },
  {
   "start": 729.87,
   "end": 731.91,
   "text": "אל מרחבי התייגה הסיבירית,"
  },
  {
   "start": 732.79,
   "end": 734.29,
   "text": "אל מרחבי התייגה הסיבירית."
  },
  {
   "start": 738.91,
   "end": 743.83,
   "text": "זה היה בתקופת מלחמת העולם השנייה בסיביר."
  },
  {
   "start": 746.4,
   "end": 749.8,
   "text": "היו יהודים שנשלחו למחנות העבודה בסיביר."
  },
  {
   "start": 751.4,
   "end": 753.88,
   "text": "מי שזכה לחזור משם,"
  },
  {
   "start": 758.45,
   "end": 759.89,
   "text": "זה היו אנשים בודדים."
  },
  {
   "start": 761.69,
   "end": 765.07,
   "text": "רבים וטובים לא חזרו משם."
  },
  {
   "start": 769.94,
   "end": 774.3,
   "text": "אחד הדברים המסוכנים ביותר שם במחנה העבודה בסיביר זה להיות חולה."
  },
  {
   "start": 776.87,
   "end": 777.25,
   "text": "הרוסים"
  },
  {
   "start": 777.25,
   "end": 780.49,
   "text": "לא סבלו חולים."
  },
  {
   "start": 781.45,
   "end": 782.15,
   "text": "אדם חולה"
  },
  {
   "start": 783.15,
   "end": 784.75,
   "text": "הוא אדם לא יעיל, הוא אדם מיותר."
  },
  {
   "start": 786.13,
   "end": 789.23,
   "text": "והם מוצאים דרכים שונות ומשונות להיפטר מהחולים."
  },
  {
   "start": 793.31,
   "end": 794.93,
   "text": "וכך, במחנה עבודה בסיביר,"
  },
  {
   "start": 795.55,
   "end": 796.87,
   "text": "בלב הטייגה הסיבירית,"
  },
  {
   "start": 797.99,
   "end": 800.25,
   "text": "אחד מהדברים המפחידים האימתניים ביותר"
  },
  {
   "start": 800.83,
   "end": 805.19,
   "text": "שיכולים לצפות שם לאותם עובדי כפייה במחנות,"
  },
  {
   "start": 806.91,
   "end": 808.03,
   "text": "זה המפגש עם הרופא."
  },
  {
   "start": 810.56,
   "end": 811.62,
   "text": "אתה חייב להיות בריא."
  },
  {
   "start": 815.57,
   "end": 817.19,
   "text": "והמקרה שלנו לוקח אותנו אל סיביר,"
  },
  {
   "start": 817.77,
   "end": 819.67,
   "text": "אל תקופת מלחמת העולם השנייה, במחנה העבודה."
  },
  {
   "start": 821.03,
   "end": 821.93,
   "text": "רופא המחנה."
  },
  {
   "start": 823.69,
   "end": 825.29,
   "text": "רופא נטול הבעה, נטול רגשות."
  },
  {
   "start": 826.31,
   "end": 827.13,
   "text": "עורך ביקורת"
  },
  {
   "start": 828.93,
   "end": 830.61,
   "text": "במחנה העבודה. הוא נכנס אל הצריף,"
  },
  {
   "start": 831.23,
   "end": 837.31,
   "text": "שם נמצאים העובדים, אסירים פוליטיים,"
  },
  {
   "start": 838.05,
   "end": 839.99,
   "text": "שרוצים אולי להגיע לארץ ישראל, רוצים לצאת,"
  },
  {
   "start": 840.97,
   "end": 841.99,
   "text": "לחזור לארץ הקודש."
  },
  {
   "start": 845.94,
   "end": 847.0,
   "text": "זה כל הפשע שלהם."
  },
  {
   "start": 851.04,
   "end": 852.1,
   "text": "ביקורת רפואית."
  },
  {
   "start": 852.98,
   "end": 854.98,
   "text": "כולם מנסים להיראות בריאים."
  },
  {
   "start": 858.52,
   "end": 862.18,
   "text": "כולם יודעים מי שיימצא חולה יילקח ולעולם לא יחזור."
  },
  {
   "start": 863.24,
   "end": 864.22,
   "text": "היו בצריף חולים."
  },
  {
   "start": 865.38,
   "end": 867.5,
   "text": "הם התחזו בכל כוחותיהם לבריאים."
  },
  {
   "start": 868.26,
   "end": 870.34,
   "text": "משתדלים להחניק את השיעול שלהם,"
  },
  {
   "start": 870.96,
   "end": 872.58,
   "text": "שלא תשתעל חס וחלילה."
  },
  {
   "start": 873.42,
   "end": 875.06,
   "text": "שיעול עלול לעלות בחיים."
  },
  {
   "start": 877.0,
   "end": 878.04,
   "text": "וככה הרופא עובר את כולם,"
  },
  {
   "start": 880.94,
   "end": 882.48,
   "text": "כולם הצליחו לעבור את הביקורת."
  },
  {
   "start": 885.56,
   "end": 886.5,
   "text": "הוא כבר בא לצאת."
  },
  {
   "start": 888.12,
   "end": 888.66,
   "text": "אבל אז,"
  },
  {
   "start": 889.52,
   "end": 891.88,
   "text": "אז הוא נעצר אל מול דלת הצריף."
  },
  {
   "start": 897.55,
   "end": 898.87,
   "text": "נעצר אל מול דלת הצריף!"
  },
  {
   "start": 901.94,
   "end": 904.46,
   "text": "החולים מחליקים עוד יותר את השיעול שלהם."
  },
  {
   "start": 905.68,
   "end": 914.12,
   "text": "הוא נעצר מול דלת הצריף והיא נסתובב חמור סבר בדלת."
  },
  {
   "start": 915.06,
   "end": 918.34,
   "text": "בדלת היה תלוי לוח שנה עברי שאחד,"
  },
  {
   "start": 920.12,
   "end": 926.06,
   "text": "אחד מתושבי הצריף, בחור יהודי צעיר, כתב בעברית ותלה,"
  },
  {
   "start": 926.46,
   "end": 932.82,
   "text": "כדי שכולם ידעו מתי החגים, כדי שכולם לא ישכחו את הזיק היהודי,"
  },
  {
   "start": 934.96,
   "end": 935.76,
   "text": "זמני תפילות,"
  },
  {
   "start": 938.46,
   "end": 939.2,
   "text": "קריאת שמע,"
  },
  {
   "start": 941.55,
   "end": 948.82,
   "text": "ואותו בחור שכח להוריד את הלוח שנה מעשי ידיו."
  },
  {
   "start": 964.88,
   "end": 967.18,
   "text": "הרופא הביט על כל תושבי הצריף"
  },
  {
   "start": 968.22,
   "end": 970.98,
   "text": "שעמדו עם מבט מבואל בעיניים."
  },
  {
   "start": 973.17,
   "end": 973.81,
   "text": "מי כתב את זה?"
  },
  {
   "start": 975.72,
   "end": 976.82,
   "text": "מי כתב את זה?"
  },
  {
   "start": 980.09,
   "end": 980.87,
   "text": "אז הוא שוב שאל"
  },
  {
   "start": 982.47,
   "end": 983.07,
   "text": "ושוב התמבה."
  },
  {
   "start": 984.23,
   "end": 985.15,
   "text": "בפעם השלישית"
  },
  {
   "start": 986.31,
   "end": 986.77,
   "text": "הוא אמר,"
  },
  {
   "start": 987.47,
   "end": 987.75,
   "text": "תדעו לכם,"
  },
  {
   "start": 988.71,
   "end": 989.33,
   "text": "יש לכם דקה."
  },
  {
   "start": 989.33,
   "end": 990.85,
   "text": "דקה,"
  },
  {
   "start": 991.99,
   "end": 993.51,
   "text": "אם לא יצא זה שכתב,"
  },
  {
   "start": 994.61,
   "end": 995.25,
   "text": "כולכם,"
  },
  {
   "start": 996.01,
   "end": 998.15,
   "text": "כולכם תירשמו אצלי כחולים,"
  },
  {
   "start": 998.85,
   "end": 1000.47,
   "text": "את כולכם אני ארשום כחולים."
  },
  {
   "start": 1004.9,
   "end": 1005.64,
   "text": "לא הייתה ברירה,"
  },
  {
   "start": 1015.18,
   "end": 1015.98,
   "text": "חלפה לה דקה."
  },
  {
   "start": 1017.46,
   "end": 1018.08,
   "text": "בתום הדקה,"
  },
  {
   "start": 1019.56,
   "end": 1021.24,
   "text": "מהשורה של היהודים שעמדו,"
  },
  {
   "start": 1023.02,
   "end": 1024.92,
   "text": "פסע לו קדימה בחור, בחור צעיר,"
  },
  {
   "start": 1025.46,
   "end": 1026.5,
   "text": "אותו בחור שכתב את הלוח."
  },
  {
   "start": 1029.5,
   "end": 1030.7,
   "text": "הרופא אמר לו, בוא אליי."
  },
  {
   "start": 1032.18,
   "end": 1032.94,
   "text": "הבחור התקרב,"
  },
  {
   "start": 1035.72,
   "end": 1036.68,
   "text": "מה כתוב כאן?"
  },
  {
   "start": 1038.06,
   "end": 1038.76,
   "text": "והרופא הצביע"
  },
  {
   "start": 1040.62,
   "end": 1041.84,
   "text": "על מילים שהיו כתובות בלוח."
  },
  {
   "start": 1043.3,
   "end": 1043.72,
   "text": "הבחור,"
  },
  {
   "start": 1044.98,
   "end": 1046.02,
   "text": "לא היה לו ברירה."
  },
  {
   "start": 1046.94,
   "end": 1048.54,
   "text": "הוא אמר, כתוב פה פרשת השבוע."
  },
  {
   "start": 1050.98,
   "end": 1056.4,
   "text": "כתוב פה את שם פרשת השבוע מהתורה הקדושה. כל שבוע יש, אנחנו קוראים חלק מהתורה הקדושה,"
  },
  {
   "start": 1057.02,
   "end": 1060.04,
   "text": "ופה רשום את פרשת השבוע הקרוב."
  },
  {
   "start": 1062.42,
   "end": 1063.06,
   "text": "אמר לו הרופא,"
  },
  {
   "start": 1063.9,
   "end": 1065.16,
   "text": "מה שם הפרשה שרשומה?"
  },
  {
   "start": 1066.48,
   "end": 1068.08,
   "text": "אמר לו, פרשת ואראה."
  },
  {
   "start": 1069.56,
   "end": 1071.76,
   "text": "פרשת וערה בספר שמות,"
  },
  {
   "start": 1074.64,
   "end": 1076.6,
   "text": "פנה אליו הרופא ואמר לו, תגיד לי,"
  },
  {
   "start": 1077.44,
   "end": 1082.34,
   "text": "אתה לא יודע שווערה כותבים בסוף עם א'"
  },
  {
   "start": 1083.16,
   "end": 1084.0,
   "text": "ולא עם ה'?"
  },
  {
   "start": 1085.42,
   "end": 1086.48,
   "text": "אתה לא יודע שווערה,"
  },
  {
   "start": 1087.5,
   "end": 1090.04,
   "text": "שאת וערה כותבים בסוף עם א'"
  },
  {
   "start": 1090.72,
   "end": 1091.58,
   "text": "ולא עם ה'?"
  },
  {
   "start": 1092.54,
   "end": 1093.28,
   "text": "רעם כולו,"
  },
  {
   "start": 1095.77,
   "end": 1099.73,
   "text": "ומזווית עינו התגלגלה לדמעה הקטנה,"
  },
  {
   "start": 1099.73,
   "end": 1102.73,
   "text": "נחפזת לה לצאת,"
  },
  {
   "start": 1105.2,
   "end": 1106.38,
   "text": "הרופא ניהר לצאת,"
  },
  {
   "start": 1108.75,
   "end": 1110.25,
   "text": "עד כה הסתיר את היהדות שלו."
  },
  {
   "start": 1111.31,
   "end": 1111.83,
   "text": "אבל משהו,"
  },
  {
   "start": 1112.47,
   "end": 1114.09,
   "text": "כולם ראו משהו קרה לו,"
  },
  {
   "start": 1114.71,
   "end": 1116.15,
   "text": "משהו זז בלב שלו."
  },
  {
   "start": 1117.83,
   "end": 1118.53,
   "text": "מאותו יום,"
  },
  {
   "start": 1119.17,
   "end": 1126.55,
   "text": "אותו רופא שהתגלה כיהודי שינה את היחס שלו מלב של חייל רוסי קרקע קרח."
  },
  {
   "start": 1127.51,
   "end": 1132.76,
   "text": "הוא הפך ללב יהודי. דואג, משגיח,"
  },
  {
   "start": 1133.6,
   "end": 1142.92,
   "text": "משתדל שכל היהודים ישרדו, כל היהודים יצליחו לעבור את מסלול הניסיונות האלה שם, בתייגה הסיבירית,"
  },
  {
   "start": 1143.48,
   "end": 1144.96,
   "text": "בערבות סיביר."
  },
  {
   "start": 1145.72,
   "end": 1152.48,
   "text": "לב יהודי שאפילו הקור והשלג והקרח של סיביר לא הצליח להקפיא אותו."
  },
  {
   "start": 1155.06,
   "end": 1164.3,
   "text": "ברגע קטן של מבט על לוח כתוב עברית, הלב הזה מתמוסס קשר אל הקדוש ברוך הוא."
  },
  {
   "start": 1164.36,
   "end": 1169.52,
   "text": "יהודי, יהודייה, עם הנצח, אשרינו שזכינו לעם כזה."
  }
 ]
}