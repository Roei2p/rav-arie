{
 "disc": "2ב- הלב",
 "track": "Track02",
 "duration": 407.16,
 "segments": [
  {
   "start": 24.21,
   "end": 26.61,
   "text": "שחי עד לפני מספר שנים בארץ."
  },
  {
   "start": 27.89,
   "end": 29.31,
   "text": "קראו לו רבי אריה לוין."
  },
  {
   "start": 32.43,
   "end": 41.06,
   "text": "רבי אריה לוין התפרסם בעם ישראל כרבם של האסירים."
  },
  {
   "start": 41.76,
   "end": 43.0,
   "text": "הוא בתקופת המחתרות,"
  },
  {
   "start": 43.64,
   "end": 44.8,
   "text": "קצת לפני קום המדינה,"
  },
  {
   "start": 46.2,
   "end": 47.1,
   "text": "כשבתי הסוהר"
  },
  {
   "start": 48.5,
   "end": 50.0,
   "text": "התמלאו להם באסירי מחתרות."
  },
  {
   "start": 52.53,
   "end": 55.35,
   "text": "הם התפלאו כל האסירים, אם זה אסירים פליליים,"
  },
  {
   "start": 56.73,
   "end": 59.31,
   "text": "כל סוגי האסירים, אסירים מדיניים,"
  },
  {
   "start": 61.11,
   "end": 65.03,
   "text": "נידונים למוות, לגלות את רבי אריה לוין,"
  },
  {
   "start": 65.93,
   "end": 70.21,
   "text": "רבי יהודים נשמה מיוחדת שהיה בא ומעודד אותם ומחזק אותם."
  },
  {
   "start": 75.25,
   "end": 76.35,
   "text": "סיפר נידון למוות"
  },
  {
   "start": 78.01,
   "end": 79.93,
   "text": "יחזקאל בן חור אלטמן."
  },
  {
   "start": 80.55,
   "end": 84.37,
   "text": "הוא נידון למוות על ידי הבריטים עד שקיבל חנינה."
  },
  {
   "start": 85.77,
   "end": 87.83,
   "text": "סיפר אותו נידון למוות שקיבל חנינה,"
  },
  {
   "start": 90.01,
   "end": 91.91,
   "text": "תקשיבו מה הוא סיפר, בואו נקשיב מה הוא סיפר."
  },
  {
   "start": 93.45,
   "end": 93.95,
   "text": "כך הוא אמר,"
  },
  {
   "start": 94.47,
   "end": 101.57,
   "text": "כך הוא סיפר יחזקאל אלטמן בן חור בתקופה הקשה בתקופה הקשה שלי"
  },
  {
   "start": 102.89,
   "end": 119.61,
   "text": "שהייתי יושב כנידון למוות היה בא רבי אריה לוין והיה מחזק מעודד ותומך כמו אבא וכשהייתי רואה אותו מרחוק"
  },
  {
   "start": 121.65,
   "end": 126.21,
   "text": "הייתה לי כיפה מיוחדת ששמתי בכיס כשהייתי רואה אותו הייתי שם ישר את הכיפה"
  },
  {
   "start": 129.18,
   "end": 132.18,
   "text": "ופעם אחת היה שם אסיר, אסיר קומוניסט."
  },
  {
   "start": 133.42,
   "end": 134.1,
   "text": "קראו לו יעקב."
  },
  {
   "start": 135.24,
   "end": 136.04,
   "text": "הוא היה כל כך"
  },
  {
   "start": 136.8,
   "end": 138.08,
   "text": "לא אוהב יהדות."
  },
  {
   "start": 139.52,
   "end": 140.84,
   "text": "הוא היה כל פעם שרואה את הרב,"
  },
  {
   "start": 141.42,
   "end": 142.48,
   "text": "היה משתדל להרגיז אותו."
  },
  {
   "start": 144.02,
   "end": 147.92,
   "text": "הרב לוין, רבי אריה לוין, היה לפעמים בא לבקר אותנו בשבת."
  },
  {
   "start": 149.12,
   "end": 151.48,
   "text": "אז יעקב היה מסתובב מולו עם סיגריה,"
  },
  {
   "start": 152.48,
   "end": 155.16,
   "text": "דלוקה, בוערת, אל מול פניו,"
  },
  {
   "start": 155.94,
   "end": 156.66,
   "text": "מעשן,"
  },
  {
   "start": 157.3,
   "end": 158.28,
   "text": "מכסה את הרב,"
  },
  {
   "start": 158.82,
   "end": 161.3,
   "text": "בעשן של סיגריה, כך בחוצפה,"
  },
  {
   "start": 162.56,
   "end": 163.84,
   "text": "כך בחוסר אכפתיות."
  },
  {
   "start": 164.68,
   "end": 165.32,
   "text": "והרב,"
  },
  {
   "start": 166.34,
   "end": 168.62,
   "text": "הרב נשאר עם אותו רוך,"
  },
  {
   "start": 169.26,
   "end": 175.48,
   "text": "אותה נשמה, פעם אחת."
  },
  {
   "start": 176.84,
   "end": 177.7,
   "text": "פעם אחת הוא ניגש,"
  },
  {
   "start": 178.52,
   "end": 179.3,
   "text": "הוא ניגש אל הרב."
  },
  {
   "start": 180.16,
   "end": 184.32,
   "text": "הוא כבר לא יכל להחזיק את הזעם המתפרץ בליבו."
  },
  {
   "start": 185.14,
   "end": 186.04,
   "text": "אמר, תגיד לי,"
  },
  {
   "start": 186.88,
   "end": 190.24,
   "text": "למה אתה מתעסק עם רמאים ושקרנים?"
  },
  {
   "start": 190.8,
   "end": 195.14,
   "text": "למה אתה בא פה לבית הסוהר לעודד ולחזק רמאים ושקרנים?"
  },
  {
   "start": 196.82,
   "end": 197.4,
   "text": "רבי אריה,"
  },
  {
   "start": 198.06,
   "end": 198.52,
   "text": "לויני,"
  },
  {
   "start": 210.28,
   "end": 211.28,
   "text": "מי למה תדבר ככה?"
  },
  {
   "start": 212.36,
   "end": 214.38,
   "text": "למה אתה מדבר ככה על עם ישראל,"
  },
  {
   "start": 214.98,
   "end": 216.2,
   "text": "על האחים שלך?"
  },
  {
   "start": 218.45,
   "end": 220.01,
   "text": "אז יעקב, פלט."
  },
  {
   "start": 221.43,
   "end": 223.07,
   "text": "הרב, אתה חושב שהם דתיים?"
  },
  {
   "start": 224.11,
   "end": 225.09,
   "text": "אני רואה אותם."
  },
  {
   "start": 225.89,
   "end": 228.23,
   "text": "כשאתה הולך, הם מורידים את הכיפה."
  },
  {
   "start": 229.47,
   "end": 230.39,
   "text": "כשאתה הולך,"
  },
  {
   "start": 231.37,
   "end": 232.45,
   "text": "הם מורידים את הכיפה."
  },
  {
   "start": 232.93,
   "end": 233.99,
   "text": "הם עושים מה שהם רוצים."
  },
  {
   "start": 235.23,
   "end": 236.51,
   "text": "הנה, תירד בן חור."
  },
  {
   "start": 237.25,
   "end": 238.81,
   "text": "זה שנידון למוות, בן חור,"
  },
  {
   "start": 239.15,
   "end": 241.21,
   "text": "הוא רואה אותך מרחוק, אז הוא שם את הכיפה."
  },
  {
   "start": 247.61,
   "end": 248.55,
   "text": "אז הוא מוריד אותה."
  },
  {
   "start": 254.16,
   "end": 255.38,
   "text": "אמר לו רבי אריה לוין,"
  },
  {
   "start": 256.44,
   "end": 256.98,
   "text": "בני,"
  },
  {
   "start": 258.54,
   "end": 262.56,
   "text": "בני אהובי, את היהודים הטהורים האלה אתה מכנה רמאים?"
  },
  {
   "start": 264.14,
   "end": 266.62,
   "text": "וכי אתה חושב שאני מסתכל על הראש שלהם,"
  },
  {
   "start": 267.2,
   "end": 269.16,
   "text": "אם יש להם כיפה או אין להם כיפה?"
  },
  {
   "start": 269.7,
   "end": 271.42,
   "text": "מי מסתכל על הראש שלהם?"
  },
  {
   "start": 271.42,
   "end": 280.6,
   "text": "אני מתבונן אל הלב שלהם ואני רואה בלב שלהם שהוא טהור, שהוא חם, לב יהודי."
  },
  {
   "start": 281.98,
   "end": 283.72,
   "text": "אני לא מסתכל על הראש שלהם."
  },
  {
   "start": 285.14,
   "end": 292.58,
   "text": "אני לא מסתכל על הראש שלהם אם יש כיפה או אין כיפה. אני מסתכל על הלב שלהם. ויהודי זה לב, לב טהור, לב חם."
  },
  {
   "start": 296.21,
   "end": 297.67,
   "text": "אני בא בגלל הלב שלהם."
  },
  {
   "start": 300.99,
   "end": 304.43,
   "text": "מספר יחזקאל אלטמן, הלוא הוא בן חור."
  },
  {
   "start": 305.63,
   "end": 306.51,
   "text": "בביקור הבא"
  },
  {
   "start": 307.17,
   "end": 308.69,
   "text": "כשרבי אריה לוין הגיע,"
  },
  {
   "start": 312.63,
   "end": 313.27,
   "text": "אותו יעקב"
  },
  {
   "start": 315.39,
   "end": 316.79,
   "text": "היה כבר חבוש כיפה,"
  },
  {
   "start": 317.51,
   "end": 319.45,
   "text": "ממתין לו בפתח של הבית כנסת."
  },
  {
   "start": 320.73,
   "end": 323.17,
   "text": "ממתין לכבוד הרב,"
  },
  {
   "start": 324.03,
   "end": 326.43,
   "text": "ממתין לכבוד הרב, כדבריו."
  },
  {
   "start": 330.14,
   "end": 331.14,
   "text": "לב יהודי."
  },
  {
   "start": 332.38,
   "end": 333.7,
   "text": "לב יהודי,"
  },
  {
   "start": 336.1,
   "end": 338.9,
   "text": "שכאשר אתה פונה אליו, אתה רואה אפילו את ה..."
  },
  {
   "start": 340.06,
   "end": 341.96,
   "text": "יהודי מגרעין הקשה, מתעורר."
  },
  {
   "start": 343.9,
   "end": 345.62,
   "text": "וזו ההסתכלות, זו ההסתכלות"
  },
  {
   "start": 346.24,
   "end": 347.8,
   "text": "שהקדוש ברוך הוא רוצה מאיתנו,"
  },
  {
   "start": 348.54,
   "end": 349.36,
   "text": "אותה הסתכלות של"
  },
  {
   "start": 350.16,
   "end": 352.3,
   "text": "רבי אריה לוי, להסתכל על הלב,"
  },
  {
   "start": 352.72,
   "end": 354.5,
   "text": "על הלב של היהודי, של היהודייה."
  },
  {
   "start": 355.7,
   "end": 358.24,
   "text": "ולא רק זה, להסתכל על עצמנו, על הלב שלנו,"
  },
  {
   "start": 358.78,
   "end": 361.62,
   "text": "שכמה שאנחנו לפעמים רחוקים מהשם,"
  },
  {
   "start": 362.04,
   "end": 366.04,
   "text": "אבל שהוא תלב את הניצוץ שרוצה בהם לעשות באמת את רצון השם,"
  },
  {
   "start": 366.46,
   "end": 368.16,
   "text": "וללכת ולשמוע לכל הלב הזה."
  },
  {
   "start": 369.74,
   "end": 372.04,
   "text": "ללכת ולשמוע לכל הלב הזה."
  },
  {
   "start": 374.22,
   "end": 377.08,
   "text": "לא להתבייש ללכת לבית כנסת כמה שאתה יכול,"
  },
  {
   "start": 377.28,
   "end": 381.56,
   "text": "כמה שאת יכולה, לבוא לשיעורי תורה כמה שאתה יכול, כמה שאתה יכולה."
  },
  {
   "start": 383.94,
   "end": 390.64,
   "text": "לב, לב יהודי זה משהו מיוחד, הלב היהודי יכול להתעורר, אי אפשר להבין את זה, יש ניצוץ מיוחד בלב,"
  },
  {
   "start": 391.28,
   "end": 394.92,
   "text": "אותו ניצוץ מופלא, אותו חוכמת לב,"
  },
  {
   "start": 396.24,
   "end": 400.34,
   "text": "שכאשר אתה מאיר את זה אתה מגלה חכם לב, ייקח מצוות."
  }
 ]
}