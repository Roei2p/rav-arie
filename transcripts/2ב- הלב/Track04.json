{
 "disc": "2ב- הלב",
 "track": "Track04",
 "duration": 1031.16,
 "segments": [
  {
   "start": 4.38,
   "end": 6.9,
   "text": "כשאנחנו מתבוננים אל הלב, אל הלב היהודי,"
  },
  {
   "start": 7.6,
   "end": 11.34,
   "text": "צריך לדעת שהוא לא רק מוקד של אש,"
  },
  {
   "start": 12.5,
   "end": 14.02,
   "text": "של קרבה לשם,"
  },
  {
   "start": 20.48,
   "end": 23.8,
   "text": "אלא הלב הוא גם עוצמה של רגש נקי וטהור."
  },
  {
   "start": 25.96,
   "end": 26.76,
   "text": "אחת מהטענות"
  },
  {
   "start": 28.99,
   "end": 30.21,
   "text": "שהם האשימו אותנו,"
  },
  {
   "start": 30.93,
   "end": 34.75,
   "text": "אותם גרמנים שעשו את השואה,"
  },
  {
   "start": 35.67,
   "end": 38.49,
   "text": "שהיהודים הביאו את המצפון לעולם,"
  },
  {
   "start": 39.75,
   "end": 40.63,
   "text": "את החסד,"
  },
  {
   "start": 41.25,
   "end": 42.71,
   "text": "את ההתחשבות בזולת,"
  },
  {
   "start": 45.81,
   "end": 46.71,
   "text": "כמה שהם צודקים."
  },
  {
   "start": 50.3,
   "end": 52.06,
   "text": "זה אנחנו, הנשמות הקדושות,"
  },
  {
   "start": 52.6,
   "end": 55.22,
   "text": "שהביאו את המצפון לעולם, את האנושיות."
  },
  {
   "start": 61.72,
   "end": 62.3,
   "text": "לדוגמה,"
  },
  {
   "start": 64.4,
   "end": 65.44,
   "text": "לדוגמה הייתה ספינה,"
  },
  {
   "start": 66.7,
   "end": 68.54,
   "text": "ספינה נעה לה לארץ ישראל."
  },
  {
   "start": 69.36,
   "end": 70.76,
   "text": "היו בה ארבעים משפחות."
  },
  {
   "start": 71.9,
   "end": 73.78,
   "text": "בראש הספינה, בראש המשפחות,"
  },
  {
   "start": 74.16,
   "end": 77.56,
   "text": "עמד רבי ישראל משקלוב, זכר צדיק לברכה."
  },
  {
   "start": 78.68,
   "end": 80.58,
   "text": "אחד מתלמידיו הגדולים של הגאון,"
  },
  {
   "start": 81.0,
   "end": 82.78,
   "text": "רבי אליהו מוילנה, הגאון מווילנה."
  },
  {
   "start": 83.74,
   "end": 86.06,
   "text": "והספינה הזאת הייתה בדרך לארץ ישראל,"
  },
  {
   "start": 86.96,
   "end": 94.52,
   "text": "ובאמצע הדרך בלב ים לפתע שערה."
  },
  {
   "start": 95.6,
   "end": 96.62,
   "text": "שערה בלב ים,"
  },
  {
   "start": 99.08,
   "end": 101.76,
   "text": "וכולם מרגישים אבודים, כולם לא יודעים מה לעשות."
  },
  {
   "start": 102.7,
   "end": 104.68,
   "text": "ורבי ישראל מישקלוב מרגיע את כולם,"
  },
  {
   "start": 105.14,
   "end": 107.82,
   "text": "ואומר להם לעשות את מה שיהודי צריך לעשות."
  },
  {
   "start": 108.42,
   "end": 112.3,
   "text": "להפנות את העיניים שלו אל סידור התפילה,"
  },
  {
   "start": 112.82,
   "end": 115.02,
   "text": "ולהפנות את הלב שלו לאבא שבשמיים."
  },
  {
   "start": 116.1,
   "end": 116.66,
   "text": "להתפלל."
  },
  {
   "start": 117.64,
   "end": 118.74,
   "text": "לעשות תשובה."
  },
  {
   "start": 120.32,
   "end": 124.24,
   "text": "והורה להם רבי ישראל מישקלוב שכל אחד יתוודה על העוונות שהוא עשה,"
  },
  {
   "start": 124.76,
   "end": 125.82,
   "text": "על מה שהוא עשה לא בסדר."
  },
  {
   "start": 126.92,
   "end": 128.64,
   "text": "כל אחד יתוודה לפני הקדוש ברוך הוא,"
  },
  {
   "start": 129.1,
   "end": 133.56,
   "text": "ומי שרוצה יכול גם להגיד לרב כדי שהרב יורה לו דרך תשובה,"
  },
  {
   "start": 135.14,
   "end": 138.08,
   "text": "ובלבד שהסערה הזאת תישכך,"
  },
  {
   "start": 138.7,
   "end": 139.9,
   "text": "שהסערה תיפסק,"
  },
  {
   "start": 141.28,
   "end": 145.98,
   "text": "שננצל כי אין דבר שהוא לא קורה בהשגחה עליונה מהקדוש ברוך הוא."
  },
  {
   "start": 146.52,
   "end": 148.72,
   "text": "אם אנחנו נהיה בסדר עם הקדוש ברוך הוא לא יקרה לנו כלום."
  },
  {
   "start": 152.26,
   "end": 154.14,
   "text": "היה שם, היה שם ילד אחד."
  },
  {
   "start": 155.56,
   "end": 160.76,
   "text": "והילד הזה בא וניגש אל הרב ואומר הרב אני רוצה להתוודות על חטא גדול מאוד שעשיתי."
  },
  {
   "start": 161.42,
   "end": 164.68,
   "text": "ואני רוצה שהרב ימצא לי דרך תשובה."
  },
  {
   "start": 166.34,
   "end": 167.42,
   "text": "והרב אומר לו כן ילדי,"
  },
  {
   "start": 168.34,
   "end": 169.2,
   "text": "מהו החטא הגדול?"
  },
  {
   "start": 170.06,
   "end": 176.69,
   "text": "ואז הוא מספר לרב משפחתי אנחנו גרים,"
  },
  {
   "start": 177.29,
   "end": 182.31,
   "text": "גרנו צמוד לגאון, לגאון מווילנה."
  },
  {
   "start": 183.01,
   "end": 185.71,
   "text": "גרנו בווילנה צמוד לגאון מווילנה."
  },
  {
   "start": 187.75,
   "end": 190.99,
   "text": "וכל הלימוד של הגאון היה נשמע אצלנו בבית."
  },
  {
   "start": 192.07,
   "end": 192.49,
   "text": "ואבא שלי,"
  },
  {
   "start": 193.25,
   "end": 195.23,
   "text": "אבא שלי שכל כך אהב תורה,"
  },
  {
   "start": 196.05,
   "end": 199.03,
   "text": "היה יושב שעות צמוד לקיר,"
  },
  {
   "start": 199.97,
   "end": 200.63,
   "text": "מאזין,"
  },
  {
   "start": 201.27,
   "end": 203.45,
   "text": "מקשיב לכל מילה קדושה שיוצאת מפיו,"
  },
  {
   "start": 204.33,
   "end": 205.95,
   "text": "הקדוש של הגאון מווילנה."
  },
  {
   "start": 208.14,
   "end": 209.64,
   "text": "וכך שעות על גבי שעות."
  },
  {
   "start": 210.78,
   "end": 211.76,
   "text": "הוא לא יצא לעבוד."
  },
  {
   "start": 212.82,
   "end": 213.84,
   "text": "בקושי היה אוכל,"
  },
  {
   "start": 214.52,
   "end": 221.33,
   "text": "רק היה שם את אוזנו במאזין אל הגאון מווילנה."
  },
  {
   "start": 222.39,
   "end": 226.37,
   "text": "ופרנסה וכסף, לא היה דבר מצוי בבית."
  },
  {
   "start": 228.53,
   "end": 229.81,
   "text": "ואני כשראיתי את זה,"
  },
  {
   "start": 231.9,
   "end": 234.86,
   "text": "ראיתי שהאוכל מתחיל להיות, כמות האוכל להיות מוגבלת."
  },
  {
   "start": 236.54,
   "end": 237.68,
   "text": "ואני האח הגדול בבית."
  },
  {
   "start": 238.42,
   "end": 240.46,
   "text": "אני הילד הגדול בבית. כל הילדים הקטנים,"
  },
  {
   "start": 241.42,
   "end": 242.0,
   "text": "הם לא מבינים,"
  },
  {
   "start": 243.7,
   "end": 244.78,
   "text": "הם רוצים אוכל."
  },
  {
   "start": 249.25,
   "end": 255.76,
   "text": "אז כבוד הרב, אני התחלתי לשקר. רבי ישראל מישק לו והביט בילד,"
  },
  {
   "start": 256.52,
   "end": 258.28,
   "text": "והביט בעיניו הטהורות של העט ואמר לו,"
  },
  {
   "start": 259.14,
   "end": 259.94,
   "text": "בני, מה השקר?"
  },
  {
   "start": 261.12,
   "end": 261.8,
   "text": "כבוד הרב,"
  },
  {
   "start": 262.46,
   "end": 262.96,
   "text": "לא היה לי ברירה."
  },
  {
   "start": 264.5,
   "end": 267.14,
   "text": "אני אמרתי להורים שלי שבחדר,"
  },
  {
   "start": 267.98,
   "end": 269.04,
   "text": "בתלמוד תורה,"
  },
  {
   "start": 269.62,
   "end": 270.38,
   "text": "שם אני לומד,"
  },
  {
   "start": 270.84,
   "end": 274.0,
   "text": "התחילו לספק לנו ארוחת צהריים,"
  },
  {
   "start": 274.36,
   "end": 275.94,
   "text": "אני אוכל שם ארוחת צהריים,"
  },
  {
   "start": 276.78,
   "end": 280.74,
   "text": "ולכן אין צורך להכין לי ארוחת צהריים בבית."
  },
  {
   "start": 285.08,
   "end": 287.4,
   "text": "ולא היה בתלמוד תורה שום ארוחת צהריים."
  },
  {
   "start": 288.46,
   "end": 292.08,
   "text": "רציתי פשוט שיהיה יותר אוכל לאחים שלי,"
  },
  {
   "start": 292.84,
   "end": 293.84,
   "text": "לאחים הקטנים."
  },
  {
   "start": 295.12,
   "end": 299.66,
   "text": "אז כך במשך שנים הם בטוחים שאני אוכל בתלמוד תורה."
  },
  {
   "start": 303.96,
   "end": 304.98,
   "text": "לא אליברר, הרב,"
  },
  {
   "start": 305.64,
   "end": 308.04,
   "text": "שיקרתי כדי שיהיהיה יותר אוכל לאחים הקטנים שלי."
  },
  {
   "start": 311.31,
   "end": 313.47,
   "text": "שמע את זה הגאון רבי ישראל מישי אקלוב,"
  },
  {
   "start": 314.43,
   "end": 315.51,
   "text": "ופרץ בבכי,"
  },
  {
   "start": 317.19,
   "end": 320.31,
   "text": "פנה ואמר, ריבונו של עולם,"
  },
  {
   "start": 321.05,
   "end": 322.21,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 322.81,
   "end": 325.87,
   "text": "כל מה שאנחנו מבקשים ממך, אל תביט על החטאים שלנו."
  },
  {
   "start": 327.21,
   "end": 329.07,
   "text": "אבל עכשיו, ריבונו של עולם,"
  },
  {
   "start": 329.69,
   "end": 332.57,
   "text": "ריבונו של עולם, אני מבקש ממך, תביט,"
  },
  {
   "start": 333.21,
   "end": 336.39,
   "text": "תביט איזה חטאים יש לעמך ישראל."
  },
  {
   "start": 337.59,
   "end": 341.25,
   "text": "בור עולם, תקשיב, תראה איזה חטאים יש לילד הזה,"
  },
  {
   "start": 341.79,
   "end": 342.85,
   "text": "על מה הוא בא להתוודות."
  },
  {
   "start": 343.95,
   "end": 346.17,
   "text": "תראה איזה לב יש לעם ישראל,"
  },
  {
   "start": 350.92,
   "end": 351.56,
   "text": "כך הוא בכה."
  },
  {
   "start": 354.4,
   "end": 358.4,
   "text": "ובורח פלא, הים, הים הסוער נרקע,"
  },
  {
   "start": 359.28,
   "end": 361.22,
   "text": "הסערה נעלמה כלא הייתה."
  },
  {
   "start": 365.62,
   "end": 373.84,
   "text": "למותר לציין שלימים הילד גדל והוא נהיה מחבר הספר דקלין חדתי."
  },
  {
   "start": 376.15,
   "end": 380.52,
   "text": "למותר לציין שלב,"
  },
  {
   "start": 381.3,
   "end": 384.66,
   "text": "שלב של ילד כזה אפשר למצוא רק בעם ישראל."
  },
  {
   "start": 390.83,
   "end": 391.21,
   "text": "אתם יודעים,"
  },
  {
   "start": 391.21,
   "end": 392.75,
   "text": "בבית המוסר בירושלים."
  },
  {
   "start": 396.22,
   "end": 403.64,
   "text": "בבית המוסר בירושלים עמד לפני שלושים שנה בקירוב הגאון רבי אליהו לופיאן,"
  },
  {
   "start": 404.58,
   "end": 405.72,
   "text": "זכר צדיק לברכה."
  },
  {
   "start": 411.01,
   "end": 413.57,
   "text": "וכך הוא מספר, הגאון רבי אליהו לופיאן."
  },
  {
   "start": 415.17,
   "end": 416.85,
   "text": "הוא סיפר לפני מאה עשרים שנה."
  },
  {
   "start": 418.89,
   "end": 419.89,
   "text": "היה עשיר גוי,"
  },
  {
   "start": 424.58,
   "end": 428.04,
   "text": "אחד מהעשירים הגדולים ביותר באירופה, באירופה המזרחית,"
  },
  {
   "start": 430.49,
   "end": 433.97,
   "text": "והוא היה מדי פעם יוצא לגיחה לתהלוכה של מסע עסקים."
  },
  {
   "start": 435.65,
   "end": 436.85,
   "text": "היו יוצאים איתו מלווים,"
  },
  {
   "start": 438.01,
   "end": 439.33,
   "text": "אנשי עסקים זוטרים,"
  },
  {
   "start": 442.48,
   "end": 446.86,
   "text": "וגם שומרי ראש ששמרו על הכסף שלו."
  },
  {
   "start": 447.62,
   "end": 451.06,
   "text": "הוא היה הולך עם סחורה וחוזר עם שק מלא כסף,"
  },
  {
   "start": 452.16,
   "end": 453.64,
   "text": "כששומרי הראש שומרים על שק הכסף."
  },
  {
   "start": 455.42,
   "end": 457.66,
   "text": "וככה התהלוכה הזאת יוצאת,"
  },
  {
   "start": 458.32,
   "end": 459.82,
   "text": "תהלוכה של מספר כרכרות,"
  },
  {
   "start": 460.76,
   "end": 461.66,
   "text": "כשבמרכז,"
  },
  {
   "start": 462.42,
   "end": 464.22,
   "text": "בכרכרה האדורה ביותר,"
  },
  {
   "start": 464.84,
   "end": 465.56,
   "text": "יושב לו שמה,"
  },
  {
   "start": 466.36,
   "end": 467.18,
   "text": "העשיר הגוי."
  },
  {
   "start": 467.92,
   "end": 474.34,
   "text": "אותו עשיר יושב, המרכבה מרופדת עם שטיחים בכל מקום."
  },
  {
   "start": 475.42,
   "end": 477.4,
   "text": "איש לא העז להתקרב אל העשיר,"
  },
  {
   "start": 478.18,
   "end": 479.48,
   "text": "איש לא העז להטריד אותו."
  },
  {
   "start": 480.8,
   "end": 483.2,
   "text": "היחיד שהיה קרוב אל העשיר,"
  },
  {
   "start": 483.52,
   "end": 486.56,
   "text": "היחיד שהעשיר נתן לו דריסת רגל אצלו בכרכרה,"
  },
  {
   "start": 487.76,
   "end": 488.54,
   "text": "היה הכלב שלו."
  },
  {
   "start": 489.48,
   "end": 494.66,
   "text": "היה לו כלב גדול, כלב, כלבו הנאמן"
  },
  {
   "start": 495.42,
   "end": 496.62,
   "text": "שהיה נמצא איתו במרכבה."
  },
  {
   "start": 499.94,
   "end": 500.58,
   "text": "והכלב הזה,"
  },
  {
   "start": 501.56,
   "end": 506.26,
   "text": "שלא פעם ולא פעמיים הציל את העשיר ממצבים מביכים,"
  },
  {
   "start": 506.92,
   "end": 507.64,
   "text": "משודדים,"
  },
  {
   "start": 508.38,
   "end": 512.46,
   "text": "היה מדי פעם שהיה חש בסכנה, פורץ החוצה מהכרכרה,"
  },
  {
   "start": 514.14,
   "end": 515.78,
   "text": "ומזהיר את כולם ומתריע את כולם,"
  },
  {
   "start": 516.2,
   "end": 519.18,
   "text": "ומתריע על כל מיני גנבים ושודדים."
  },
  {
   "start": 521.04,
   "end": 521.62,
   "text": "אותו כלב,"
  },
  {
   "start": 522.38,
   "end": 524.12,
   "text": "הוא היחיד שהיה קרוב אל העשיר,"
  },
  {
   "start": 524.5,
   "end": 531.18,
   "text": "הוא היחיד שרבץ לו שם על שטיח יוקרתי ליד העשיר."
  },
  {
   "start": 534.14,
   "end": 537.3,
   "text": "בתום מעשה עסקים הם חזרו, חזרו הביתה,"
  },
  {
   "start": 538.32,
   "end": 539.64,
   "text": "כששומרי הראש שומרים על שק הכסף."
  },
  {
   "start": 541.48,
   "end": 541.94,
   "text": "ככה הם עושים,"
  },
  {
   "start": 542.7,
   "end": 543.48,
   "text": "עוברים דרך יער,"
  },
  {
   "start": 546.4,
   "end": 547.46,
   "text": "יער מלא פרחים,"
  },
  {
   "start": 548.16,
   "end": 551.08,
   "text": "שזור בלבלוב של עצים,"
  },
  {
   "start": 553.33,
   "end": 553.93,
   "text": "לפתע הכלב."
  },
  {
   "start": 555.23,
   "end": 556.55,
   "text": "הכלב פרץ החוצה,"
  },
  {
   "start": 558.01,
   "end": 558.89,
   "text": "פרץ מהכרכרה,"
  },
  {
   "start": 560.17,
   "end": 562.29,
   "text": "והחל מסתובב מקיף,"
  },
  {
   "start": 562.95,
   "end": 564.99,
   "text": "מקיף את התהלוכה הזאת."
  },
  {
   "start": 568.09,
   "end": 568.75,
   "text": "ואז הוא נעצר,"
  },
  {
   "start": 570.05,
   "end": 570.71,
   "text": "נעמד לו,"
  },
  {
   "start": 572.47,
   "end": 573.69,
   "text": "חוסם את הדרך,"
  },
  {
   "start": 574.29,
   "end": 575.75,
   "text": "אבל הוא נותן לאף אחד להתקדם."
  },
  {
   "start": 577.25,
   "end": 578.45,
   "text": "ואף אחד לא מבין מה קורה פה,"
  },
  {
   "start": 579.25,
   "end": 580.01,
   "text": "מה קרה לכלב."
  },
  {
   "start": 581.13,
   "end": 583.39,
   "text": "מנסים להזיז אותו, מנסים להרגיע אותו."
  },
  {
   "start": 586.34,
   "end": 588.5,
   "text": "הכלב לא זז רק נובח ומאיים."
  },
  {
   "start": 591.95,
   "end": 594.59,
   "text": "העשיר ירד מן המרכבה,"
  },
  {
   "start": 596.33,
   "end": 597.31,
   "text": "ניגש אל הכלב,"
  },
  {
   "start": 600.1,
   "end": 601.8,
   "text": "מנסה להרגיע אותו, מנסה להזיז אותו,"
  },
  {
   "start": 602.26,
   "end": 603.1,
   "text": "ללא הועיל."
  },
  {
   "start": 604.24,
   "end": 606.04,
   "text": "הכלב רק נובח ונובח,"
  },
  {
   "start": 606.72,
   "end": 607.72,
   "text": "ניסה לתת לו אוכל,"
  },
  {
   "start": 609.12,
   "end": 609.72,
   "text": "גם זה לא עזר."
  },
  {
   "start": 611.76,
   "end": 613.66,
   "text": "העשיר הנעיד את ראשו בצער,"
  },
  {
   "start": 614.8,
   "end": 620.78,
   "text": "כנראה הכלב איבד את דעתו."
  },
  {
   "start": 624.39,
   "end": 626.25,
   "text": "העשיר הנעיד ראשו בצער,"
  },
  {
   "start": 626.89,
   "end": 629.73,
   "text": "פסע אל המרכבה וחזר עם תיבה."
  },
  {
   "start": 630.91,
   "end": 635.61,
   "text": "תיבה סבורה, הוא פתח את התיבה והוציא משם אקדח."
  },
  {
   "start": 638.83,
   "end": 642.21,
   "text": "הוא פנה אל הכלב ואמר, כלבי הנאמן, שירת אותי שנים רבות."
  },
  {
   "start": 643.07,
   "end": 644.87,
   "text": "היינו ביחד, היית כלב נאמן,"
  },
  {
   "start": 645.51,
   "end": 646.35,
   "text": "אבל כפי הנראה,"
  },
  {
   "start": 651.1,
   "end": 651.82,
   "text": "כפי הנראה,"
  },
  {
   "start": 654.88,
   "end": 655.94,
   "text": "נהיית כלב שותה,"
  },
  {
   "start": 657.56,
   "end": 659.1,
   "text": "אז אין לי ברירה אלא להרוג אותך."
  },
  {
   "start": 660.4,
   "end": 661.38,
   "text": "הוא כיוון את האקדח,"
  },
  {
   "start": 664.12,
   "end": 671.15,
   "text": "והכלב מביט בו, מביט באדון שלו,"
  },
  {
   "start": 672.17,
   "end": 673.39,
   "text": "האדון שהוא היה נאמן לו,"
  },
  {
   "start": 677.25,
   "end": 680.21,
   "text": "והעשיר לוחץ על ההדק ויורה בו."
  },
  {
   "start": 682.11,
   "end": 686.44,
   "text": "הכלב ארצה,"
  },
  {
   "start": 688.3,
   "end": 693.02,
   "text": "שניות מספר אחר כך קם ופסע לאט-לאט הצידה,"
  },
  {
   "start": 694.14,
   "end": 694.56,
   "text": "ושוב צנח."
  },
  {
   "start": 699.24,
   "end": 701.88,
   "text": "כולם עלו אל הכרכרות ונסו."
  },
  {
   "start": 705.45,
   "end": 706.23,
   "text": "כשהגיעו אל הבית,"
  },
  {
   "start": 709.0,
   "end": 709.32,
   "text": "לפתע,"
  },
  {
   "start": 712.62,
   "end": 713.84,
   "text": "שק הכסף נעלם."
  },
  {
   "start": 714.72,
   "end": 717.26,
   "text": "אין כסף."
  },
  {
   "start": 717.64,
   "end": 718.42,
   "text": "הם רצו."
  },
  {
   "start": 719.16,
   "end": 720.5,
   "text": "החלו חוזרים, מחפשים."
  },
  {
   "start": 722.46,
   "end": 722.94,
   "text": "כולם,"
  },
  {
   "start": 723.6,
   "end": 725.44,
   "text": "כולם חזרו, אל אותה עיר."
  },
  {
   "start": 726.04,
   "end": 729.06,
   "text": "כולם מחפשים, חלק רוצים אולי למצוא, לקחת חלק,"
  },
  {
   "start": 729.58,
   "end": 733.82,
   "text": "חלק מתוך רצון למצוא חן בעיני העשיר,"
  },
  {
   "start": 734.24,
   "end": 735.42,
   "text": "וחלק מחוסר ברירה,"
  },
  {
   "start": 735.8,
   "end": 736.34,
   "text": "חוזרים ומחפשים."
  },
  {
   "start": 738.5,
   "end": 740.42,
   "text": "הם הגיעו שוב אל העיר מקץ מסע ארוך,"
  },
  {
   "start": 741.24,
   "end": 743.78,
   "text": "מחפשים, אבל אין זכר לשק הכסף."
  },
  {
   "start": 744.68,
   "end": 748.08,
   "text": "העשיר מכריז על פרס למי שימצא את שק הכסף."
  },
  {
   "start": 750.26,
   "end": 754.0,
   "text": "אבל איש לא יודע לאן הוא נעלם."
  },
  {
   "start": 757.55,
   "end": 757.97,
   "text": "הם עולים"
  },
  {
   "start": 759.17,
   "end": 763.25,
   "text": "על הכרכרות מקץ זמן חיפושים רב,"
  },
  {
   "start": 764.13,
   "end": 765.09,
   "text": "ויוצאים חזרה בדרך הביתה."
  },
  {
   "start": 766.27,
   "end": 770.17,
   "text": "בדרך הביתה הם חוזרים דרך היער, באותו דרך, אותו מסלול שהם פסעו קודם."
  },
  {
   "start": 772.39,
   "end": 774.51,
   "text": "ואז העשיר מסמן להם, אני רוצה לעבור שוב דרך,"
  },
  {
   "start": 776.82,
   "end": 778.08,
   "text": "דרך הגופה של הכלב."
  },
  {
   "start": 779.94,
   "end": 782.36,
   "text": "זה שנפרדתי ממנו, שנים היינו ביחד."
  },
  {
   "start": 783.82,
   "end": 786.66,
   "text": "תעצרו איפה שהכלב, תראו את הגופה של הכלב מת, אני רוצה לראות."
  },
  {
   "start": 787.22,
   "end": 788.0,
   "text": "לראות אותו."
  },
  {
   "start": 792.22,
   "end": 793.4,
   "text": "הם הגיעו אל חלקת היער."
  },
  {
   "start": 794.84,
   "end": 797.06,
   "text": "שם ירה אותו עשיר בכלב."
  },
  {
   "start": 801.87,
   "end": 802.87,
   "text": "והעשיר יורד."
  },
  {
   "start": 805.43,
   "end": 809.25,
   "text": "הוא רואה שם מרחוק את השרידים של הגופה של הכלב."
  },
  {
   "start": 809.59,
   "end": 810.57,
   "text": "הוא מתחיל להתקרב."
  },
  {
   "start": 812.74,
   "end": 813.16,
   "text": "והנה,"
  },
  {
   "start": 814.14,
   "end": 815.48,
   "text": "הוא רואה שם על מרבד,"
  },
  {
   "start": 816.44,
   "end": 817.56,
   "text": "מרבד הדשא הירוק,"
  },
  {
   "start": 818.36,
   "end": 819.5,
   "text": "שטרות של כסף"
  },
  {
   "start": 820.6,
   "end": 822.02,
   "text": "ומטבעות של כסף."
  },
  {
   "start": 822.84,
   "end": 824.0,
   "text": "והם רצים, הולכים לאסוף."
  },
  {
   "start": 824.98,
   "end": 828.3,
   "text": "והעשיר פונה ומביט בתדהמה."
  },
  {
   "start": 829.34,
   "end": 832.54,
   "text": "מתחת לשרידים של הגופה של הכלב,"
  },
  {
   "start": 833.2,
   "end": 835.44,
   "text": "שנאכלה על ידי תנים, על ידי זאבים,"
  },
  {
   "start": 837.89,
   "end": 839.03,
   "text": "התגלה להם."
  },
  {
   "start": 839.93,
   "end": 841.11,
   "text": "שק הכסף האבוד,"
  },
  {
   "start": 843.97,
   "end": 844.55,
   "text": "הכלב,"
  },
  {
   "start": 845.41,
   "end": 846.71,
   "text": "הכלב הנאמן,"
  },
  {
   "start": 847.51,
   "end": 850.11,
   "text": "חש ששק הכסף נפל."
  },
  {
   "start": 850.59,
   "end": 853.17,
   "text": "איש לא שם לב חוץ מהכלב הנאמן."
  },
  {
   "start": 853.79,
   "end": 855.93,
   "text": "הוא עצר וחסם את השיירה."
  },
  {
   "start": 856.67,
   "end": 861.09,
   "text": "הוא רצה שהם יאספו, הוא רצה שהם יביטו סביבותם ויגלו את שק הכסף."
  },
  {
   "start": 864.09,
   "end": 864.95,
   "text": "אבל איש לא הבין,"
  },
  {
   "start": 865.71,
   "end": 866.75,
   "text": "ולא רק זה אלא העשיר,"
  },
  {
   "start": 867.49,
   "end": 871.81,
   "text": "גם מה לא בכך שירה בו כדור קטלני."
  },
  {
   "start": 877.06,
   "end": 878.2,
   "text": "גם כשהוא נורה,"
  },
  {
   "start": 879.18,
   "end": 880.8,
   "text": "גם כשהוא נורה למוות,"
  },
  {
   "start": 881.5,
   "end": 883.04,
   "text": "גרר את עצמו הכלב,"
  },
  {
   "start": 884.06,
   "end": 885.02,
   "text": "גרר את עצמו,"
  },
  {
   "start": 885.88,
   "end": 887.64,
   "text": "ואפילו שהם התרחקו כבר,"
  },
  {
   "start": 888.3,
   "end": 889.9,
   "text": "הוא המשיך בשארית כוחותיו,"
  },
  {
   "start": 890.92,
   "end": 894.48,
   "text": "גרר את עצמו אל שק הכסף,"
  },
  {
   "start": 894.48,
   "end": 903.52,
   "text": "וכיסה בגוף שלו את השק של הכסף לשמור את זה לאדון שלו."
  },
  {
   "start": 904.38,
   "end": 914.5,
   "text": "בנאמנות מדהימה שומר בשארית כוחותיו על הכסף של האדון שלו,"
  },
  {
   "start": 915.1,
   "end": 915.7,
   "text": "זה שירה פה."
  },
  {
   "start": 919.73,
   "end": 920.99,
   "text": "אמר רבי אלו לופיאן,"
  },
  {
   "start": 927.5,
   "end": 929.64,
   "text": "כלב נקרא כלב בלשון הקודש,"
  },
  {
   "start": 930.56,
   "end": 932.62,
   "text": "למה כלב כי כולו לב?"
  },
  {
   "start": 934.0,
   "end": 935.64,
   "text": "כלב כולו לב."
  },
  {
   "start": 939.88,
   "end": 942.68,
   "text": "הכלב היה כל כך נאמן לאדון שלו."
  },
  {
   "start": 943.12,
   "end": 945.04,
   "text": "אם רק האדון שלו נותן לו קצת אוכל,"
  },
  {
   "start": 945.56,
   "end": 946.42,
   "text": "קצת שתייה,"
  },
  {
   "start": 947.42,
   "end": 950.44,
   "text": "ואיזו נאמנות הכלב מחזיר לאדון שלו."
  },
  {
   "start": 953.93,
   "end": 954.23,
   "text": "הכלב"
  },
  {
   "start": 954.77,
   "end": 956.39,
   "text": "נאמן לאדון שלו."
  },
  {
   "start": 957.51,
   "end": 958.79,
   "text": "והאם האדון שלו"
  },
  {
   "start": 959.59,
   "end": 960.37,
   "text": "נאמן"
  },
  {
   "start": 962.21,
   "end": 963.15,
   "text": "אל אדוניו?"
  },
  {
   "start": 965.13,
   "end": 967.09,
   "text": "אל מי שאמר והיה עולם?"
  },
  {
   "start": 968.33,
   "end": 970.11,
   "text": "למה האדון הרבה פעמים"
  },
  {
   "start": 972.11,
   "end": 976.85,
   "text": "לפעמים מוצא את עצמו פחות נאמן אל מי שאמר והיה העולם."
  },
  {
   "start": 980.54,
   "end": 983.02,
   "text": "לכלב יש גן עדן על הנאמנות שלו?"
  },
  {
   "start": 983.66,
   "end": 984.16,
   "text": "לא ולא."
  },
  {
   "start": 985.56,
   "end": 987.36,
   "text": "במקרה הרע הוא יקבל ירייה,"
  },
  {
   "start": 988.06,
   "end": 990.12,
   "text": "במקרה הטוב הוא ימות מזקנה."
  },
  {
   "start": 993.5,
   "end": 995.12,
   "text": "אבל בכל אופן הוא נאמן."
  },
  {
   "start": 995.92,
   "end": 996.66,
   "text": "ואנחנו,"
  },
  {
   "start": 997.72,
   "end": 998.4,
   "text": "אנחנו,"
  },
  {
   "start": 1000.02,
   "end": 1003.14,
   "text": "על הנאמנות שלנו לקדוש ברוך הוא,"
  },
  {
   "start": 1003.74,
   "end": 1005.66,
   "text": "אנחנו נקבל גן עדן."
  },
  {
   "start": 1008.71,
   "end": 1018.43,
   "text": "האם לא כדאי להפנות את הלב שלנו לבורא עולם שמעניק לנו חיות,"
  },
  {
   "start": 1021.31,
   "end": 1022.95,
   "text": "אוכל, שתייה,"
  },
  {
   "start": 1023.69,
   "end": 1024.97,
   "text": "כוחות בריאות?"
  }
 ]
}