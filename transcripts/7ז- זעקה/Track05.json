{
 "disc": "7ז- זעקה",
 "track": "Track05",
 "duration": 75.216,
 "segments": [
  {
   "start": 0.86,
   "end": 1.78,
   "text": "אומר אליהו הנביא,"
  },
  {
   "start": 3.42,
   "end": 4.86,
   "text": "אמר הקדוש ברוך הוא,"
  },
  {
   "start": 7.0,
   "end": 16.74,
   "text": "הרי אני מודיעך ממקצת דרכיי, כשאני רואה בני אדם שאין בהם תורה ומצוות,"
  },
  {
   "start": 17.64,
   "end": 19.22,
   "text": "שאין להם תורה ומצוות,"
  },
  {
   "start": 20.24,
   "end": 23.12,
   "text": "ואפילו אין להם זכות אבות,"
  },
  {
   "start": 24.72,
   "end": 27.06,
   "text": "לא זכות אבות ולא תורה ומצוות,"
  },
  {
   "start": 28.68,
   "end": 29.88,
   "text": "אבל רק דבר אחד,"
  },
  {
   "start": 30.84,
   "end": 34.06,
   "text": "שהם עומדים ומתחננים לפניי"
  },
  {
   "start": 35.26,
   "end": 36.92,
   "text": "אני נעתר להם."
  },
  {
   "start": 39.6,
   "end": 43.48,
   "text": "רק כשהוא עומד, רק כשהיא עומדת ומתחננת."
  },
  {
   "start": 45.04,
   "end": 49.02,
   "text": "אבל מכל הלב לפני הקדוש ברוך הוא אומר הקדוש ברוך הוא,"
  },
  {
   "start": 50.34,
   "end": 53.72,
   "text": "בכבודו ובעצמו הוא אומר אני נעתר להם."
  },
  {
   "start": 54.94,
   "end": 60.42,
   "text": "ועל זה יש את הפסוק פנה אל תפילת הערער ולא בזה את תפילתם."
  },
  {
   "start": 60.42,
   "end": 64.64,
   "text": "כל אחד התפילה שלו נשמעת, כל אחד"
  }
 ]
}