{
 "disc": "7ז- זעקה",
 "track": "Track01",
 "duration": 1267.152,
 "segments": [
  {
   "start": 13.89,
   "end": 15.09,
   "text": "אורי עזב את הבית שלו."
  },
  {
   "start": 17.38,
   "end": 18.5,
   "text": "אורי, כמו כל השנה,"
  },
  {
   "start": 21.03,
   "end": 22.41,
   "text": "מיד אחרי תשעה באב,"
  },
  {
   "start": 23.39,
   "end": 32.16,
   "text": "הוא עושה את כל הדרך אל העיירות שנמצאות הרחק ממקום מגוריו."
  },
  {
   "start": 33.74,
   "end": 35.5,
   "text": "אורי היה אברך עני,"
  },
  {
   "start": 37.36,
   "end": 38.6,
   "text": "אבל על דבר אחד הוא הקפיד."
  },
  {
   "start": 40.94,
   "end": 43.3,
   "text": "כל שקל, כל פרוטה שהייתה מגיעה אליו,"
  },
  {
   "start": 44.0,
   "end": 45.28,
   "text": "היה מפריש קצת הצידה,"
  },
  {
   "start": 46.84,
   "end": 51.06,
   "text": "כדי שיהיה לו כסף לקנות,"
  },
  {
   "start": 53.3,
   "end": 54.08,
   "text": "והשנה הזאת"
  },
  {
   "start": 55.4,
   "end": 56.58,
   "text": "היו בכיסו מונחים"
  },
  {
   "start": 58.36,
   "end": 59.56,
   "text": "55 רובל,"
  },
  {
   "start": 61.04,
   "end": 62.52,
   "text": "סכום יפה לכל הדעות,"
  },
  {
   "start": 65.08,
   "end": 69.88,
   "text": "שאורי עבד עליהן והזיע במשך כל השנה כדי שיוכל"
  },
  {
   "start": 69.88,
   "end": 74.52,
   "text": "סוף סוף ללכת ולקנות אתרוג עליו הוא חולם כל השנה."
  },
  {
   "start": 76.32,
   "end": 79.08,
   "text": "וככה בלב מתרונן, בלב מלא תקווה,"
  },
  {
   "start": 79.76,
   "end": 82.3,
   "text": "הוא הולך לחפש לו אתרוג, אתרוג מהודר."
  },
  {
   "start": 83.22,
   "end": 86.24,
   "text": "הוא ידע שכל העיירה סטרליסק, העיירה בה הוא נולד,"
  },
  {
   "start": 86.74,
   "end": 90.18,
   "text": "מצפים ממנו, אף אחד לא מביא אתרוג, חכו אורי, מצפים ממנו"
  },
  {
   "start": 91.92,
   "end": 93.24,
   "text": "להביא אתרוג מהודר."
  },
  {
   "start": 94.8,
   "end": 98.34,
   "text": "גם אשתו מצפה לראות את בעלה מביא אתרוג"
  },
  {
   "start": 99.04,
   "end": 100.6,
   "text": "שמפיץ צריח ניחוח בכל הבית."
  },
  {
   "start": 101.38,
   "end": 101.94,
   "text": "ולא רק זה,"
  },
  {
   "start": 102.48,
   "end": 106.34,
   "text": "אלא בכל המועד סוכות היה נוהג אורי ללכת אל רבותיו,"
  },
  {
   "start": 106.8,
   "end": 110.5,
   "text": "אל בית המדרש של רבי זושה ורבי אלימלך מליזנסק, האחים הקדושים,"
  },
  {
   "start": 111.46,
   "end": 113.06,
   "text": "עם האתרוג הנפלא שהיה קונה."
  },
  {
   "start": 113.98,
   "end": 114.98,
   "text": "וגם השנה יהיה כך,"
  },
  {
   "start": 115.88,
   "end": 116.68,
   "text": "כך הוא חשב לו,"
  },
  {
   "start": 118.36,
   "end": 122.23,
   "text": "כשהוא פוסע לו במורד השביל."
  },
  {
   "start": 123.99,
   "end": 125.23,
   "text": "באמצע הדרך היה פונדק,"
  },
  {
   "start": 126.19,
   "end": 127.11,
   "text": "פונדק של יהודי,"
  },
  {
   "start": 127.65,
   "end": 129.69,
   "text": "יהודי פשוט שהוא הכיר אותו, יהודי נחמד,"
  },
  {
   "start": 130.09,
   "end": 131.05,
   "text": "יהודי חם לב,"
  },
  {
   "start": 131.55,
   "end": 134.33,
   "text": "שרבי יורי היה מדי פעם נכנס אליו,"
  },
  {
   "start": 134.93,
   "end": 137.75,
   "text": "במיוחד כשהיה הולך בדרך לחפש אתרוגים."
  },
  {
   "start": 138.49,
   "end": 139.15,
   "text": "וגם השנה,"
  },
  {
   "start": 140.21,
   "end": 141.51,
   "text": "קצת צריך לעשות חנייה מדי פעם."
  },
  {
   "start": 144.4,
   "end": 146.28,
   "text": "הוא פתח את הדלת ונכנס אל הפונדק,"
  },
  {
   "start": 147.24,
   "end": 148.96,
   "text": "ואז הוא נעמד והביט,"
  },
  {
   "start": 151.08,
   "end": 157.0,
   "text": "הביט במבט נוגה על המחזה המרטיט שנגלה לנגד עיניו."
  },
  {
   "start": 159.22,
   "end": 162.3,
   "text": "ליד הדלפק ישב לו יהודי גדול,"
  },
  {
   "start": 162.94,
   "end": 164.32,
   "text": "יהודי מגודל וגס,"
  },
  {
   "start": 166.4,
   "end": 166.74,
   "text": "גבו"
  },
  {
   "start": 167.4,
   "end": 169.7,
   "text": "אל אורי והוא כולו שבור,"
  },
  {
   "start": 173.34,
   "end": 175.88,
   "text": "בוכה ומיילל."
  },
  {
   "start": 177.26,
   "end": 178.54,
   "text": "ואורי מעולם לא ראה,"
  },
  {
   "start": 179.46,
   "end": 181.98,
   "text": "מעולם לא ראה יהודי במצב כל כך נורא."
  },
  {
   "start": 185.23,
   "end": 189.71,
   "text": "בעל הפונדק מנסה להרגיע את היהודי, אבל היהודי הזה נראה כלא מתנחם."
  },
  {
   "start": 190.27,
   "end": 193.13,
   "text": "נראה יהודי שפשוט חרב עליו עולמו,"
  },
  {
   "start": 195.85,
   "end": 197.03,
   "text": "והיהודי הזה ממלמל."
  },
  {
   "start": 199.01,
   "end": 200.03,
   "text": "אני מעדיף למות,"
  },
  {
   "start": 200.91,
   "end": 202.25,
   "text": "אין לי טעם בחיים האלה."
  },
  {
   "start": 202.95,
   "end": 203.95,
   "text": "ואורי נזדעזע."
  },
  {
   "start": 204.67,
   "end": 206.95,
   "text": "איך יהודי יכול להגיד שאין לו טעם בחיים?"
  },
  {
   "start": 207.61,
   "end": 211.79,
   "text": "איך יהודי יכול להגיד צי מילים נוראות כאלה מהפה?"
  },
  {
   "start": 212.47,
   "end": 214.21,
   "text": "כנראה הוא הגיע למצב כל כך נורא."
  },
  {
   "start": 216.07,
   "end": 218.01,
   "text": "אורי פנה אל בעל הפונדק, קרא לו, אמר לו,"
  },
  {
   "start": 218.57,
   "end": 219.27,
   "text": "תגיד לי, מה קרה?"
  },
  {
   "start": 219.87,
   "end": 222.77,
   "text": "מה קרה לו, אותו יהודי שם שיושב שפוף לו בדלפק ובוכה?"
  },
  {
   "start": 223.77,
   "end": 226.85,
   "text": "אמר לו, בעל הפונדק, מה אני אגיד לך, יהודי איזה מסכן, אני מרחם עליו."
  },
  {
   "start": 227.75,
   "end": 228.09,
   "text": "אתה יודע,"
  },
  {
   "start": 228.77,
   "end": 233.13,
   "text": "זה יהודי פשוט לא יודע קרוא וכתוב ולא יודע כלום. מגיל קטן, אבא שלו,"
  },
  {
   "start": 233.85,
   "end": 236.27,
   "text": "שהיה עגלון, לימד אותו להיות עגלון כמוהו."
  },
  {
   "start": 237.43,
   "end": 238.99,
   "text": "זה אומר שכל החיות שלו,"
  },
  {
   "start": 239.45,
   "end": 241.71,
   "text": "כל הפרנסה שלו ושל הילדים שלו,"
  },
  {
   "start": 242.61,
   "end": 244.03,
   "text": "תלוי בעבודה שלו כעגלון."
  },
  {
   "start": 245.55,
   "end": 246.27,
   "text": "והיהודי הזה,"
  },
  {
   "start": 246.95,
   "end": 249.73,
   "text": "היהודי הזה נשאר לו סוס אחד,"
  },
  {
   "start": 251.78,
   "end": 252.96,
   "text": "והוא עבד עם הסוס,"
  },
  {
   "start": 255.98,
   "end": 259.44,
   "text": "והיום בבוקר הוא בא והסוס מת."
  },
  {
   "start": 260.22,
   "end": 261.04,
   "text": "הסוס מת!"
  },
  {
   "start": 261.98,
   "end": 263.34,
   "text": "הוא נשאר בלי סוס,"
  },
  {
   "start": 264.02,
   "end": 267.5,
   "text": "ואין לו כסף לקנות סוס חדש,"
  },
  {
   "start": 270.75,
   "end": 271.85,
   "text": "והוא לא יודע מה לעשות."
  },
  {
   "start": 272.55,
   "end": 274.37,
   "text": "הוא לא מכיר שום עבודה אחרת."
  },
  {
   "start": 274.95,
   "end": 277.21,
   "text": "אף אחד גם לא יקבל אותו לעבודה, הוא לא מוכשר."
  },
  {
   "start": 278.33,
   "end": 279.87,
   "text": "דבר אחד הוא יודע, להיות עגלון."
  },
  {
   "start": 280.99,
   "end": 283.83,
   "text": "ואין לו סוס ואין לו כסף לבנות סוס חדש."
  },
  {
   "start": 284.47,
   "end": 285.87,
   "text": "אתה יודע מה פירוש הדברים, אורי?"
  },
  {
   "start": 286.63,
   "end": 287.53,
   "text": "גזר דין מוות."
  },
  {
   "start": 288.99,
   "end": 291.85,
   "text": "מה הוא יביא הביתה? איך הוא יסתכל על הילדים שלו? היהודי איזה שבוע."
  },
  {
   "start": 292.75,
   "end": 295.95,
   "text": "ותאמין לי, אורי, תאמין לי שהלב שלי נקרע בקרבי."
  },
  {
   "start": 297.05,
   "end": 298.03,
   "text": "אתה יודע, יש לי פה סוס."
  },
  {
   "start": 298.75,
   "end": 300.29,
   "text": "מאחורה שווה מאה רובה."
  },
  {
   "start": 300.29,
   "end": 306.15,
   "text": "אני מוכן לתת לו ממני לעשות לו הנחה חמישים רובל,"
  },
  {
   "start": 307.21,
   "end": 311.51,
   "text": "אבל אפילו חמישים רובל לקנות את הסוס במבצע בשבילו,"
  },
  {
   "start": 311.97,
   "end": 313.21,
   "text": "וחמישים רובל אין לו."
  },
  {
   "start": 313.65,
   "end": 316.07,
   "text": "אז הוא יושב פה, בוחן, מנסה לנחם אותו."
  },
  {
   "start": 316.65,
   "end": 317.71,
   "text": "אורי שמע את זה."
  },
  {
   "start": 319.57,
   "end": 321.81,
   "text": "הוא יחש שבכיס שלו"
  },
  {
   "start": 323.05,
   "end": 323.83,
   "text": "הכסף בוער,"
  },
  {
   "start": 329.82,
   "end": 330.66,
   "text": "אבל יש פה יהודי,"
  },
  {
   "start": 331.84,
   "end": 332.4,
   "text": "יהודי,"
  },
  {
   "start": 333.72,
   "end": 334.9,
   "text": "יהודי במצוקה."
  },
  {
   "start": 335.36,
   "end": 339.26,
   "text": "הוא הרגיש איך היד שלו נשלחת אל הכיס,"
  },
  {
   "start": 341.5,
   "end": 345.08,
   "text": "תופסת מתוך החמישים וחמש רובל, חמישים רובל."
  },
  {
   "start": 345.7,
   "end": 347.6,
   "text": "חמישים רובל שהוא עבד עליהם שנה,"
  },
  {
   "start": 348.22,
   "end": 349.44,
   "text": "אורי בעצמו היה עני."
  },
  {
   "start": 350.28,
   "end": 354.14,
   "text": "חמישים רובל שכל העיירה סטרליסק נושאת פניה אליהם."
  },
  {
   "start": 355.38,
   "end": 358.56,
   "text": "חמישים רובל שהוא צריך לבוא לבית המדרש של הרבנים שלו."
  },
  {
   "start": 360.48,
   "end": 361.98,
   "text": "אבל הוא תפס את החמישים רובל"
  },
  {
   "start": 363.02,
   "end": 364.16,
   "text": "בלב שוטט,"
  },
  {
   "start": 367.9,
   "end": 369.08,
   "text": "בלב כואב,"
  },
  {
   "start": 371.69,
   "end": 372.79,
   "text": "תפס את החמישים רובל,"
  },
  {
   "start": 374.19,
   "end": 375.73,
   "text": "שם אותם על הדלפק,"
  },
  {
   "start": 376.43,
   "end": 377.61,
   "text": "אמר לבעל הפונדק,"
  },
  {
   "start": 378.55,
   "end": 379.19,
   "text": "תן לו תסוס."
  },
  {
   "start": 380.85,
   "end": 383.79,
   "text": "תפס את מעט החבילות שהיו איתו, ויצא מהר."
  },
  {
   "start": 384.57,
   "end": 385.93,
   "text": "אורי לא רצה לשמוע תודה,"
  },
  {
   "start": 386.79,
   "end": 390.03,
   "text": "לא רצה שום הנאה מהמצווה שהוא עשה,"
  },
  {
   "start": 390.41,
   "end": 394.11,
   "text": "פשוט יצא משם במרוצה עם חמש רובל."
  },
  {
   "start": 397.98,
   "end": 398.88,
   "text": "בינתיים בפונדק,"
  },
  {
   "start": 401.23,
   "end": 401.87,
   "text": "בעל הפונדק"
  },
  {
   "start": 402.47,
   "end": 404.53,
   "text": "אסף בידיים רועדות את החמישים רובל."
  },
  {
   "start": 404.53,
   "end": 407.83,
   "text": "ואורי חוזר הביתה."
  },
  {
   "start": 409.97,
   "end": 411.47,
   "text": "הוא לא הלך להסתכל מה קרה בפונדק,"
  },
  {
   "start": 412.15,
   "end": 413.31,
   "text": "פשוט חזר הביתה."
  },
  {
   "start": 415.6,
   "end": 416.4,
   "text": "באותה שנה"
  },
  {
   "start": 417.22,
   "end": 419.1,
   "text": "כל הירס פרליס התאכזבה."
  },
  {
   "start": 421.08,
   "end": 424.72,
   "text": "אורי השיג אתרוג מצומק,"
  },
  {
   "start": 425.86,
   "end": 428.22,
   "text": "כשר ככה אולי בדיעבד."
  },
  {
   "start": 434.92,
   "end": 437.6,
   "text": "אשתו הביטה אליו באכזבה, אבל הוא שתק,"
  },
  {
   "start": 438.08,
   "end": 438.84,
   "text": "הוא לא דיבר מילה."
  },
  {
   "start": 439.7,
   "end": 441.2,
   "text": "נושא את הכאב שלו בפנים,"
  },
  {
   "start": 441.78,
   "end": 446.96,
   "text": "אבל מצד שני שמח על מה שעשה."
  },
  {
   "start": 448.92,
   "end": 453.7,
   "text": "באמצע חג הסוכות, בחול המועד הוא מגיע לבית המדרש של הרבנים שלו,"
  },
  {
   "start": 454.1,
   "end": 457.16,
   "text": "האחים הקדושים רבי זושה ורבי אלימלך מליזנסק."
  },
  {
   "start": 462.14,
   "end": 467.8,
   "text": "באמצע התפילה ניגש רבי זושה אל רבי אלימלך,"
  },
  {
   "start": 468.16,
   "end": 469.74,
   "text": "בדיוק במקום שאפשר לדבר,"
  },
  {
   "start": 470.86,
   "end": 471.44,
   "text": "ואומר לו,"
  },
  {
   "start": 471.96,
   "end": 472.16,
   "text": "אחי,"
  },
  {
   "start": 473.06,
   "end": 474.56,
   "text": "אתה מריח את מה שאני מריח?"
  },
  {
   "start": 475.4,
   "end": 477.14,
   "text": "אומר רבי אלימלך, כן, גם אני מריח."
  },
  {
   "start": 477.14,
   "end": 479.7,
   "text": "ריח של גן עדן,"
  },
  {
   "start": 480.54,
   "end": 481.62,
   "text": "ריח של גן עדן."
  },
  {
   "start": 483.42,
   "end": 485.64,
   "text": "והאחים הקדושים, קדושי עליון,"
  },
  {
   "start": 486.34,
   "end": 488.04,
   "text": "מתחילים להסתובב בבית המדרש,"
  },
  {
   "start": 488.56,
   "end": 492.1,
   "text": "מרחרחים, מאין הם מריחים ריח של גן עדן."
  },
  {
   "start": 492.48,
   "end": 494.78,
   "text": "ככה הם עוברים ספסל אחרי ספסל,"
  },
  {
   "start": 495.52,
   "end": 496.86,
   "text": "עד שמגיעים לפינה,"
  },
  {
   "start": 497.86,
   "end": 499.1,
   "text": "שם ישב לו אורי,"
  },
  {
   "start": 499.8,
   "end": 500.94,
   "text": "אורי מסדרליסק."
  },
  {
   "start": 501.96,
   "end": 502.78,
   "text": "הם מגיעים אליו,"
  },
  {
   "start": 503.28,
   "end": 506.9,
   "text": "והוא רועד, מסתכל עליהם ומתבייש ככה באתרוג המצומק שיש לו ביד."
  },
  {
   "start": 508.06,
   "end": 510.8,
   "text": "רבי זושה מצביע לאתרוג ואומר מכאן,"
  },
  {
   "start": 511.12,
   "end": 515.32,
   "text": "מכאן ארח תביא לי את האתרוג שנייה ומרחים ואומרים מהאתרוג הזה,"
  },
  {
   "start": 515.7,
   "end": 517.1,
   "text": "מהאתרוג הזה יש ריח,"
  },
  {
   "start": 518.08,
   "end": 520.38,
   "text": "יש ריח של גן עדן."
  },
  {
   "start": 521.34,
   "end": 524.82,
   "text": "ואורי לא מבין וכל החסידים לא מבינים מצטופפים,"
  },
  {
   "start": 525.24,
   "end": 528.3,
   "text": "האברכים לא מבינים במה מדובר."
  },
  {
   "start": 530.04,
   "end": 532.4,
   "text": "פנה רבי אלימלך לאורי ואמר לו תספר לי,"
  },
  {
   "start": 532.82,
   "end": 534.38,
   "text": "תספר לי איך השגת את האתרוג הזה,"
  },
  {
   "start": 534.86,
   "end": 537.42,
   "text": "תספר לי את כל האמת ורק את האמת,"
  },
  {
   "start": 537.9,
   "end": 539.32,
   "text": "אל תחסיר דבר."
  },
  {
   "start": 539.94,
   "end": 541.0,
   "text": "להוריל לא הייתה ברירה,"
  },
  {
   "start": 541.86,
   "end": 542.86,
   "text": "הוא פשוט סיפר."
  },
  {
   "start": 547.28,
   "end": 550.44,
   "text": "איך הוא פגש את היהודי הזה, העגלון?"
  },
  {
   "start": 551.06,
   "end": 553.18,
   "text": "איך הוא נתן לו את הכסף של האתרוג המעוטר,"
  },
  {
   "start": 553.56,
   "end": 555.48,
   "text": "וכן האתרוג פשוט במקום זה."
  },
  {
   "start": 557.16,
   "end": 558.56,
   "text": "כשהוא גמר לספר,"
  },
  {
   "start": 559.36,
   "end": 560.4,
   "text": "אמר רבי אלימלך,"
  },
  {
   "start": 561.84,
   "end": 565.26,
   "text": "אמר רבי זושה, עכשיו אנחנו נספר לך מה קרה,"
  },
  {
   "start": 565.98,
   "end": 567.54,
   "text": "עכשיו אנחנו נספר לך את ההמשך."
  },
  {
   "start": 568.22,
   "end": 569.88,
   "text": "אנחנו נשלים את הסיפור."
  },
  {
   "start": 570.94,
   "end": 572.22,
   "text": "אתה יודע מה קרה בפונדק?"
  },
  {
   "start": 573.18,
   "end": 574.3,
   "text": "אתם יודעים מה קרה בפונדק?"
  },
  {
   "start": 575.22,
   "end": 576.7,
   "text": "בפונדק, בעל הפונדק?"
  },
  {
   "start": 577.28,
   "end": 578.58,
   "text": "לקחת חמישים רובל."
  },
  {
   "start": 579.6,
   "end": 583.16,
   "text": "העיר את העגלון ואמר לו, תפסיק לבכות, הגיעה לך הישועה."
  },
  {
   "start": 583.6,
   "end": 586.6,
   "text": "הנה חמישים רובל, אני תורם חמישים רובל,"
  },
  {
   "start": 586.96,
   "end": 588.84,
   "text": "והיה פה מישהו נתן חמישים רובל."
  },
  {
   "start": 590.22,
   "end": 592.76,
   "text": "ואתה יכול לקחת את הסוס שנמצא מאחורי."
  },
  {
   "start": 593.86,
   "end": 594.62,
   "text": "והעגלון,"
  },
  {
   "start": 596.67,
   "end": 598.41,
   "text": "שבן רגע התהפך עליו מזלו,"
  },
  {
   "start": 599.17,
   "end": 601.19,
   "text": "שברגע אחד העיר אליו העולם,"
  },
  {
   "start": 601.83,
   "end": 604.65,
   "text": "שברגע אחד הסתדרו לו החיים."
  },
  {
   "start": 605.11,
   "end": 608.31,
   "text": "עכשיו הוא יכול לבוא הביתה, יכול לבוא לאשתו, יכול לבוא לילדים שלו."
  },
  {
   "start": 609.29,
   "end": 610.51,
   "text": "היה כל כך מאושר."
  },
  {
   "start": 611.75,
   "end": 616.61,
   "text": "התחיל לנשק את בעל הפונדק, אמר, מי זה? מי זה האדם? תגיד לי, מי זה? מי זה התורם?"
  },
  {
   "start": 617.79,
   "end": 620.95,
   "text": "בעל הפונדק לא ידע מה להגיד לו, אמר לו, אתה יודע מה? אני לא יודע מה אני אגיד לך."
  },
  {
   "start": 621.33,
   "end": 623.47,
   "text": "הוא הסתלק מפה? מה זה הסתלק? מה, הוא לא בן אדם?"
  },
  {
   "start": 623.47,
   "end": 628.37,
   "text": "אז עלה רעיון בבעל הפונדק, אמר לו, מה, אני אגיד לך, אולי זה אליהו נביא, לך תדע."
  },
  {
   "start": 629.17,
   "end": 631.55,
   "text": "נס, זה שליח של השם."
  },
  {
   "start": 632.53,
   "end": 634.07,
   "text": "שליח של השם נתן לך."
  },
  {
   "start": 636.71,
   "end": 640.33,
   "text": "ובעל הפונדק הלך, לקח את העגלון ונתן לו את הסוס."
  },
  {
   "start": 641.03,
   "end": 642.45,
   "text": "את הסוס היפה והחדש."
  },
  {
   "start": 643.81,
   "end": 645.49,
   "text": "והעגלון עשה את דרכו הביתה,"
  },
  {
   "start": 646.57,
   "end": 648.41,
   "text": "שמח ומאושר, וככה"
  },
  {
   "start": 650.19,
   "end": 651.39,
   "text": "הוא דוהר לו ביער,"
  },
  {
   "start": 652.51,
   "end": 654.43,
   "text": "בין השיחים, בין העצים הגבוהים."
  },
  {
   "start": 656.35,
   "end": 691.49,
   "text": "דוהר לו ודוהר לו, תוך שהוא גומה מטרים אחרי מטרים ביער."
  },
  {
   "start": 692.43,
   "end": 693.39,
   "text": "התחיל לחשוב אותו,"
  },
  {
   "start": 694.11,
   "end": 694.73,
   "text": "אותו עגלון,"
  },
  {
   "start": 695.75,
   "end": 696.71,
   "text": "מי הושיע אותי?"
  },
  {
   "start": 697.55,
   "end": 698.53,
   "text": "שליח של השם?"
  },
  {
   "start": 699.59,
   "end": 701.33,
   "text": "בעל הפונדק אמר שליח של השם."
  },
  {
   "start": 702.23,
   "end": 703.75,
   "text": "אולי אליהו הנביא היה פה."
  },
  {
   "start": 708.45,
   "end": 713.98,
   "text": "חשב העגלון, הרי אני,"
  },
  {
   "start": 716.73,
   "end": 718.09,
   "text": "הרי אני בחיים לא התפללתי,"
  },
  {
   "start": 719.25,
   "end": 720.99,
   "text": "הרי אני לא יודע צורה של אות,"
  },
  {
   "start": 720.99,
   "end": 730.87,
   "text": "ובה השם יתברך בבורא עולם ושולח לי שליח כדי לתת לי סוס,"
  },
  {
   "start": 731.51,
   "end": 733.09,
   "text": "כדי לעשות לי נס,"
  },
  {
   "start": 733.63,
   "end": 735.71,
   "text": "איך אני יכול להודות לו?"
  },
  {
   "start": 736.25,
   "end": 742.39,
   "text": "איך אני יכול להודות לו? אני יהודי פשוט, לא יודע כלום, לא לימדו אותי כלום, בחיים לא הייתי בבית כנסת, מה אני עושה?"
  },
  {
   "start": 743.51,
   "end": 747.27,
   "text": "וככה הולך לו, טוהר לו העגלון וחושב מה אני אעשה."
  },
  {
   "start": 748.69,
   "end": 749.37,
   "text": "ולפתע,"
  },
  {
   "start": 750.21,
   "end": 751.93,
   "text": "לפתע הפסיק לו רעיון,"
  },
  {
   "start": 753.55,
   "end": 754.61,
   "text": "הוא עצר את הסוסים,"
  },
  {
   "start": 755.73,
   "end": 759.56,
   "text": "עצר את הסוסים באמצע היער,"
  },
  {
   "start": 762.72,
   "end": 763.48,
   "text": "מהעגלה,"
  },
  {
   "start": 764.62,
   "end": 765.96,
   "text": "נחוש בדעתו,"
  },
  {
   "start": 768.48,
   "end": 775.85,
   "text": "לקח את השוט והתחיל לפסוע לו אל מרכז היער,"
  },
  {
   "start": 777.21,
   "end": 781.59,
   "text": "ושם הוא עמד ואמר בורא עולם,"
  },
  {
   "start": 782.57,
   "end": 783.47,
   "text": "בורא עולם,"
  },
  {
   "start": 784.41,
   "end": 788.01,
   "text": "תאמין לי בורא עולם אני לא יודע איך להגיד לך תודה,"
  },
  {
   "start": 788.79,
   "end": 790.21,
   "text": "לא לימדו אותי כלום,"
  },
  {
   "start": 790.67,
   "end": 796.6,
   "text": "לא יודע כלום, לא יודע קרוא ולא יודע כתוב."
  },
  {
   "start": 797.58,
   "end": 799.96,
   "text": "אבל דבר אחד בורא עולם אני יודע,"
  },
  {
   "start": 800.92,
   "end": 802.26,
   "text": "להיות עגלון,"
  },
  {
   "start": 803.04,
   "end": 806.84,
   "text": "להניף את השוט ולהדהיר את הסוסים שלי."
  },
  {
   "start": 807.96,
   "end": 810.14,
   "text": "אז בורא עולם בוא אני אגיד לך תודה."
  },
  {
   "start": 811.0,
   "end": 812.36,
   "text": "בורא עולם אני אתפלל אליך,"
  },
  {
   "start": 812.88,
   "end": 817.02,
   "text": "אני אזעק אליך, אני אומר לך תודה דרך השוט שלי."
  },
  {
   "start": 817.02,
   "end": 826.82,
   "text": "והוא הניף את השוט ונתן צליפה אחת וצעק הצליפה הזאת לכבוד השם יתברך תודה ונתן צליפה"
  },
  {
   "start": 827.22,
   "end": 840.4,
   "text": "ולקח עוד פעם אמר בורא עולם אתה הוא מלך מלכי המלאכים אתה אתה בורא העולמים תודה ונתן עוד צליפה עם השוט ולקח את השוט בפעם השלישית ואמר"
  },
  {
   "start": 841.94,
   "end": 846.5,
   "text": "תודה רבה לך השם יתברך תודה רבה על הכל על הכל"
  },
  {
   "start": 847.56,
   "end": 853.7,
   "text": "על הנשמה שנתת לי, על הניסים שאתה עושה איתי ונתן עוד צליפה אחת."
  },
  {
   "start": 854.64,
   "end": 858.24,
   "text": "שלוש צליפות שוט הדהדו להם ביער,"
  },
  {
   "start": 858.92,
   "end": 860.52,
   "text": "קורעות את הדממה,"
  },
  {
   "start": 862.52,
   "end": 878.16,
   "text": "שוברות את השקט והעגלון שהדמעות זרמו מעיניו בלי להבין מאז שהילד קטן לא חש כמיהה כזאת אל השם יתברך."
  },
  {
   "start": 878.16,
   "end": 882.26,
   "text": "געגועים כאלה, אל השם יתברך, אל אבא שבשמיים."
  },
  {
   "start": 884.07,
   "end": 887.79,
   "text": "הרגיש כל כך, כל כך קרבה ואהבה לשם."
  },
  {
   "start": 888.53,
   "end": 889.53,
   "text": "אחרי זה הלך לו לאיתו,"
  },
  {
   "start": 890.11,
   "end": 891.13,
   "text": "חזר לעגלה,"
  },
  {
   "start": 892.19,
   "end": 895.11,
   "text": "ואמר תודה, וכל הדרך הוא מלמל, תודה לך השם,"
  },
  {
   "start": 895.49,
   "end": 896.59,
   "text": "תודה לך השם,"
  },
  {
   "start": 896.97,
   "end": 901.31,
   "text": "ככה שהוא, עד שהוא הגיע למחוז חפצי."
  },
  {
   "start": 901.73,
   "end": 907.69,
   "text": "את זה סיפרו רבי אלימלך ורבי זושה לכל בית המדרש."
  },
  {
   "start": 908.73,
   "end": 910.29,
   "text": "והם אמרו, אבל זה לא הכל."
  },
  {
   "start": 911.75,
   "end": 913.35,
   "text": "כל זה היה לפני ראש השנה."
  },
  {
   "start": 914.61,
   "end": 916.81,
   "text": "בראש השנה יום הדין."
  },
  {
   "start": 917.99,
   "end": 919.39,
   "text": "כל עם ישראל בא במשפט."
  },
  {
   "start": 923.98,
   "end": 930.94,
   "text": "ירדה גזירה גדולה על כל עם ישראל בכל התפוצות ואין מי שיבטל אותה."
  },
  {
   "start": 932.52,
   "end": 935.32,
   "text": "לא בראש השנה ולא ביום הכיפורים."
  },
  {
   "start": 936.58,
   "end": 937.92,
   "text": "ואז הגיעה תפילת נעילה."
  },
  {
   "start": 939.82,
   "end": 940.86,
   "text": "בתפילת נעילה"
  },
  {
   "start": 941.74,
   "end": 946.8,
   "text": "עולות כל התפילות מגיעים אל שער,"
  },
  {
   "start": 947.28,
   "end": 948.82,
   "text": "שער התפילה והרחמים,"
  },
  {
   "start": 949.2,
   "end": 951.88,
   "text": "ומשם צריכים לבטל את כל הגזרות."
  },
  {
   "start": 953.1,
   "end": 961.16,
   "text": "ואותה שנה שום תפילה לא מצליחה לבטל את אותה גזרה נוראה."
  },
  {
   "start": 961.84,
   "end": 965.24,
   "text": "וכל גדולי ישראל בכל המקומות בוכים,"
  },
  {
   "start": 965.78,
   "end": 966.64,
   "text": "זועקים,"
  },
  {
   "start": 966.96,
   "end": 971.52,
   "text": "ולא מצליחים לפתוח את שער הרחמים לבטל את הגזרה."
  },
  {
   "start": 990.78,
   "end": 992.48,
   "text": "לא יודעים מאיזה מקום, מאיזה צד,"
  },
  {
   "start": 994.52,
   "end": 995.82,
   "text": "הגיעה לבית דין של מעלה."
  },
  {
   "start": 996.24,
   "end": 997.24,
   "text": "תפילה מיוחדת."
  },
  {
   "start": 998.72,
   "end": 1000.2,
   "text": "לפתע בבית דין של מעלה"
  },
  {
   "start": 1001.68,
   "end": 1002.6,
   "text": "נשמעו להן"
  },
  {
   "start": 1003.28,
   "end": 1005.3,
   "text": "שלוש צליפות שוט"
  },
  {
   "start": 1006.56,
   "end": 1014.42,
   "text": "שלוש צליפות שוט שיצאו מהלב של עגלון של יהודי פשוט זעקות של תודה לשם יתברך"
  },
  {
   "start": 1015.18,
   "end": 1022.35,
   "text": "תפילה לשם של יהודי שאין לו דרך אחרת לבטא את התודה שלוש זעקות"
  },
  {
   "start": 1023.29,
   "end": 1040.04,
   "text": "זעקות לשם ואותן צליפות צאו את המחיצות,"
  },
  {
   "start": 1041.68,
   "end": 1042.72,
   "text": "תקחו את השערים,"
  },
  {
   "start": 1044.26,
   "end": 1049.34,
   "text": "קרעו את המסכים והכל נפרץ."
  },
  {
   "start": 1050.16,
   "end": 1051.18,
   "text": "ים של רחמים,"
  },
  {
   "start": 1052.68,
   "end": 1053.96,
   "text": "ים של תשובה,"
  },
  {
   "start": 1054.62,
   "end": 1056.86,
   "text": "ים של דמעות, של תפילות."
  },
  {
   "start": 1059.23,
   "end": 1061.83,
   "text": "עשו להם את דרכם אל כיסא הכבוד,"
  },
  {
   "start": 1064.79,
   "end": 1066.45,
   "text": "מוחקים את הגזרות."
  },
  {
   "start": 1069.28,
   "end": 1086.35,
   "text": "שוברים מלב של יהודי פשחיל החלו להם פנימה"
  },
  {
   "start": 1087.73,
   "end": 1093.1,
   "text": "וחתמו את עם ישראל לזכות."
  },
  {
   "start": 1112.45,
   "end": 1114.41,
   "text": "פנו רבי זושה ורבי אלימלך"
  },
  {
   "start": 1115.33,
   "end": 1118.53,
   "text": "לקהל האברכים שסביבם."
  },
  {
   "start": 1120.23,
   "end": 1122.47,
   "text": "אתם מבינים מה זה זעקה של יהודי פשוט?"
  },
  {
   "start": 1123.93,
   "end": 1125.37,
   "text": "אתה מבין, אורי, מה עשית?"
  },
  {
   "start": 1127.84,
   "end": 1129.32,
   "text": "זיקית את כל עם ישראל."
  },
  {
   "start": 1130.62,
   "end": 1133.08,
   "text": "הסרת ענן שחור מעל כל היהדות."
  },
  {
   "start": 1138.37,
   "end": 1143.37,
   "text": "הוויתור שלך למען העלאת חיוך על פני יהודי."
  },
  {
   "start": 1143.37,
   "end": 1149.29,
   "text": "ואותו, אותה פנייה קורעת לב של יהודי, פנייה פשוטה,"
  },
  {
   "start": 1149.91,
   "end": 1153.59,
   "text": "מישר מהלב, מהתנור החם, הלב של יהודי."
  },
  {
   "start": 1154.65,
   "end": 1159.65,
   "text": "אי אפשר לעצור, אי אפשר לעצור, אי אפשר לעצור צעקה כזאת."
  },
  {
   "start": 1160.43,
   "end": 1165.41,
   "text": "היא פורצת ועולה לה ופורחת ושוברת והורסת את כל המקטרגים,"
  },
  {
   "start": 1170.89,
   "end": 1174.17,
   "text": "כי הקדוש ברוך הוא רוצה את הלב שלנו, לב של יהודי,"
  },
  {
   "start": 1175.29,
   "end": 1177.35,
   "text": "עם כיסופים לשם מתפרך."
  },
  {
   "start": 1178.27,
   "end": 1183.85,
   "text": "עם אהבה להשם יתברך, נבטל מנות כל הגזרות,"
  },
  {
   "start": 1185.07,
   "end": 1206.78,
   "text": "ננצח בכל המלחמות, ככה כל דור ודור."
  },
  {
   "start": 1210.07,
   "end": 1210.75,
   "text": "יהודייה,"
  },
  {
   "start": 1211.23,
   "end": 1215.97,
   "text": "הלכה לחבלים, להיות אותם יהודים שבבכי קטן,"
  },
  {
   "start": 1216.29,
   "end": 1219.91,
   "text": "בצעקה להשם, בהקרבה לכבוד השם יתברך,"
  },
  {
   "start": 1220.67,
   "end": 1223.53,
   "text": "נותנים לכל עם ישראל חיות לעוד שנה,"
  },
  {
   "start": 1224.19,
   "end": 1225.15,
   "text": "לעוד שנה,"
  },
  {
   "start": 1225.63,
   "end": 1228.31,
   "text": "וזוכים לגן עדן."
  },
  {
   "start": 1230.58,
   "end": 1231.28,
   "text": "אותו אורי,"
  },
  {
   "start": 1231.28,
   "end": 1260.71,
   "text": "לימים עלה וצמח ואותו שתיל נהיה אילן וניהה לו רבי אורי מיסטרליסק השרף מיסטרליסק זכר צדיק וקדוש לברכה ואנחנו אולי נבין מהו ערך של נשמה של יהודי זעקה של יהודי כדי שנבין מה אנחנו מי אתה"
  }
 ]
}