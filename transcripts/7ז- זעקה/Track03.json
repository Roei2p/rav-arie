{
 "disc": "7ז- זעקה",
 "track": "Track03",
 "duration": 1458.192,
 "segments": [
  {
   "start": 0.8,
   "end": 3.64,
   "text": "רבי יעקב יצחק הורוביץ,"
  },
  {
   "start": 5.56,
   "end": 8.24,
   "text": "הלא הוא החוזה מלובלין, החוזה הקדוש מלובלין."
  },
  {
   "start": 10.34,
   "end": 20.9,
   "text": "יהודי קדוש שמגיל שבע ועד גיל שמונה עשרה סגר את העיניים,"
  },
  {
   "start": 22.04,
   "end": 23.32,
   "text": "כיסה את העיניים עם מטפחת,"
  },
  {
   "start": 24.9,
   "end": 25.74,
   "text": "לא ראה כלום,"
  },
  {
   "start": 26.66,
   "end": 29.18,
   "text": "ובגיל שמונה עשרה, כשהוא פתח את העיניים,"
  },
  {
   "start": 30.46,
   "end": 31.54,
   "text": "הקדוש ברוך הוא זיכה אותו"
  },
  {
   "start": 32.18,
   "end": 33.36,
   "text": "בראייה רוחנית,"
  },
  {
   "start": 34.12,
   "end": 34.98,
   "text": "בראייה כזאת"
  },
  {
   "start": 37.1,
   "end": 38.42,
   "text": "יותר מכל אדם רגיל,"
  },
  {
   "start": 39.44,
   "end": 41.78,
   "text": "ברוח הקודש במנות מופלגות."
  },
  {
   "start": 43.44,
   "end": 50.04,
   "text": "החוזה מלובלין שהתפרסם בכל עולם התורה,"
  },
  {
   "start": 51.24,
   "end": 52.8,
   "text": "שהיה הרבי של כל הרבים,"
  },
  {
   "start": 53.66,
   "end": 55.62,
   "text": "סביבו אלפי תלמידים."
  },
  {
   "start": 60.94,
   "end": 61.52,
   "text": "פעם אחת"
  },
  {
   "start": 62.62,
   "end": 63.84,
   "text": "פנו אליו תלמידים שלו,"
  },
  {
   "start": 64.7,
   "end": 66.3,
   "text": "התלמידים שלו מעיר קצת רחוקה,"
  },
  {
   "start": 66.84,
   "end": 67.64,
   "text": "אמרו לו כבוד הרב,"
  },
  {
   "start": 68.4,
   "end": 70.02,
   "text": "כבוד הרב אנחנו כל פעם באים אליך,"
  },
  {
   "start": 70.52,
   "end": 72.3,
   "text": "כבוד הרב, יש לנו עיר של מעשה,"
  },
  {
   "start": 72.76,
   "end": 74.66,
   "text": "היא כל כך משוועת לפעמים לאיזה דמות"
  },
  {
   "start": 76.14,
   "end": 77.42,
   "text": "של רב שיבוא לשם"
  },
  {
   "start": 78.76,
   "end": 83.42,
   "text": "ואולי יחזק אותם. כבוד הרב, אולי יבוא אלינו פעם אחת, פעם אחת, החלום שלנו."
  },
  {
   "start": 84.02,
   "end": 86.58,
   "text": "הרב יבוא פעם לשבת אחת לעשות אצלנו."
  },
  {
   "start": 87.8,
   "end": 90.52,
   "text": "וכך הם מפצירים לא יום ולא יומיים,"
  },
  {
   "start": 91.78,
   "end": 92.7,
   "text": "עד שיום אחד."
  },
  {
   "start": 94.72,
   "end": 95.58,
   "text": "החוזה מלובלין,"
  },
  {
   "start": 96.18,
   "end": 97.64,
   "text": "שלא נהג הרבה לצאת מביתו,"
  },
  {
   "start": 97.64,
   "end": 108.17,
   "text": "נענה והסכים וכך"
  },
  {
   "start": 109.45,
   "end": 112.03,
   "text": "הם יצאו לדרך החוזה מלובלין,"
  },
  {
   "start": 113.25,
   "end": 114.29,
   "text": "עשרה מתלמידיו"
  },
  {
   "start": 116.01,
   "end": 117.51,
   "text": "והעגלון מקצועי יוצאים לדרך."
  },
  {
   "start": 120.96,
   "end": 125.22,
   "text": "באמצע הדרך לפתע נעצר העגלון"
  },
  {
   "start": 127.1,
   "end": 129.94,
   "text": "ומתחיל למרר בבכי כמו ילד קטן."
  },
  {
   "start": 135.17,
   "end": 137.21,
   "text": "פונים החסידים ואומרים לו תגיד לי מה קרה?"
  },
  {
   "start": 138.03,
   "end": 138.69,
   "text": "מה אתה בוכה?"
  },
  {
   "start": 140.91,
   "end": 143.39,
   "text": "והוא פונה ואומר להם, תקשיבו, אני לא יודע מה קרה פה."
  },
  {
   "start": 145.17,
   "end": 147.33,
   "text": "שלושים שנה אני עגלון."
  },
  {
   "start": 147.95,
   "end": 150.41,
   "text": "אני מכיר את כל הדרכים כמו כף היד שלי."
  },
  {
   "start": 151.39,
   "end": 152.11,
   "text": "את היער הזה"
  },
  {
   "start": 153.75,
   "end": 155.83,
   "text": "אני עובר כמעט מדי יום ביומו,"
  },
  {
   "start": 156.89,
   "end": 158.51,
   "text": "והיום אני לא יכול להסביר."
  },
  {
   "start": 161.33,
   "end": 163.69,
   "text": "הלילה הזה אני לא יכול להסביר מה קורה פה."
  },
  {
   "start": 165.63,
   "end": 166.05,
   "text": "אני פשוט"
  },
  {
   "start": 166.77,
   "end": 169.91,
   "text": "נוסע ונוסע ולא מתקדם."
  },
  {
   "start": 170.53,
   "end": 171.59,
   "text": "עוברים כבר כמה שעות,"
  },
  {
   "start": 171.67,
   "end": 173.47,
   "text": "אתם לא שמים לב, אבל לא התקדמנו."
  },
  {
   "start": 174.03,
   "end": 176.07,
   "text": "אני נוסע במעגלים, איבדתי את הכיוון,"
  },
  {
   "start": 176.39,
   "end": 178.05,
   "text": "איבדתי את הדרך, אני לא יודע מה לעשות."
  },
  {
   "start": 179.47,
   "end": 180.85,
   "text": "לא מבין, זה אף פעם לא קרה לי."
  },
  {
   "start": 183.51,
   "end": 184.49,
   "text": "כך הוא אומר בייאוש,"
  },
  {
   "start": 185.35,
   "end": 193.18,
   "text": "כשיאיאוש תהומי ניבט מעיניו והתלמידים מסתובבים."
  },
  {
   "start": 193.88,
   "end": 203.38,
   "text": "כל העיניים ניסעות אל החוזה הקדוש מנובלין שיושב במרכז העגלה,"
  },
  {
   "start": 204.22,
   "end": 205.58,
   "text": "במרכז המרכבה,"
  },
  {
   "start": 206.46,
   "end": 207.36,
   "text": "בעיניים עצומות."
  },
  {
   "start": 211.32,
   "end": 216.18,
   "text": "ואז החוזה פתח את עיניו ואמר לעגלון,"
  },
  {
   "start": 217.06,
   "end": 217.72,
   "text": "תעזוב,"
  },
  {
   "start": 218.4,
   "end": 219.46,
   "text": "תעזוב את המושכות,"
  },
  {
   "start": 220.18,
   "end": 221.72,
   "text": "תן לסוסים ללכת,"
  },
  {
   "start": 222.22,
   "end": 225.16,
   "text": "תן להם לדהור לבד, הם כבר ידעו לאן ללכת."
  },
  {
   "start": 228.48,
   "end": 229.28,
   "text": "הוא עזב את המושכות."
  },
  {
   "start": 230.64,
   "end": 232.34,
   "text": "בשנייה שהוא עזב את המושכות,"
  },
  {
   "start": 233.08,
   "end": 235.08,
   "text": "הסוסים כאילו קיבלו פקודה מלמעלה,"
  },
  {
   "start": 235.66,
   "end": 241.14,
   "text": "והחלו לדהור כמו דוהרים, דוהרים,"
  },
  {
   "start": 241.72,
   "end": 243.14,
   "text": "כאילו הם יודעים לאן ללכת,"
  },
  {
   "start": 243.14,
   "end": 246.66,
   "text": "כאילו יש איזה מישהו שמנחה אותם לאיזה כיוון"
  },
  {
   "start": 247.88,
   "end": 248.8,
   "text": "הם צריכים להגיע."
  },
  {
   "start": 252.16,
   "end": 252.5,
   "text": "ואז,"
  },
  {
   "start": 254.3,
   "end": 254.66,
   "text": "לפתע,"
  },
  {
   "start": 256.1,
   "end": 257.36,
   "text": "כאילו היער נגמר פתאום,"
  },
  {
   "start": 260.95,
   "end": 263.37,
   "text": "וכל החבורה מצאה את עצמה בעיר,"
  },
  {
   "start": 265.71,
   "end": 266.35,
   "text": "עיר זרה."
  },
  {
   "start": 268.19,
   "end": 269.85,
   "text": "כולם הכריחו, כולם שמחו."
  },
  {
   "start": 272.09,
   "end": 277.35,
   "text": "הרבי הקדוש גרם לסוסים לדהור להוביל אותנו לבד אל מחוז חפצנו,"
  },
  {
   "start": 278.01,
   "end": 279.05,
   "text": "והם ירדו בשמחה,"
  },
  {
   "start": 279.05,
   "end": 291.08,
   "text": "משאירים את העגלון המום אבל עד מהרה החיוכים נמחקו להם."
  },
  {
   "start": 293.1,
   "end": 297.3,
   "text": "הם החלו לברר והתברר להם שזו לא העיר"
  },
  {
   "start": 298.52,
   "end": 299.64,
   "text": "אותה הם חיפשו."
  },
  {
   "start": 300.52,
   "end": 308.56,
   "text": "הם נמצאים בעיר זרה כבר עוד מעט שבת ואין לך מה לעשות,"
  },
  {
   "start": 311.1,
   "end": 312.02,
   "text": "אין לאן ללכת,"
  },
  {
   "start": 313.44,
   "end": 315.26,
   "text": "חייבים לשבות בו, בעיר."
  },
  {
   "start": 318.92,
   "end": 324.0,
   "text": "ואז אמר להם החוזה מלובלין,"
  },
  {
   "start": 324.56,
   "end": 325.62,
   "text": "תקשיבו,"
  },
  {
   "start": 327.32,
   "end": 328.8,
   "text": "אנחנו עושים פה שבת בעיר,"
  },
  {
   "start": 331.21,
   "end": 333.11,
   "text": "אבל דבר אחד אני רוצה להגיד לכם,"
  },
  {
   "start": 334.37,
   "end": 335.49,
   "text": "השבת הזאת,"
  },
  {
   "start": 336.77,
   "end": 338.31,
   "text": "אני לא הרב."
  },
  {
   "start": 339.29,
   "end": 340.33,
   "text": "אתם לא קוראים לי הרב,"
  },
  {
   "start": 341.29,
   "end": 344.15,
   "text": "אני לא הרבין מבחינתכם, אני יהודי פשוט."
  },
  {
   "start": 345.51,
   "end": 349.01,
   "text": "אני מצווה עליכם להתייחס אליי כאל יהודי פשוט,"
  },
  {
   "start": 349.53,
   "end": 355.77,
   "text": "ולא להסגיר ולא במאום את זה שאני הרב שלכם."
  },
  {
   "start": 362.86,
   "end": 363.6,
   "text": "והתלמידים,"
  },
  {
   "start": 365.18,
   "end": 367.14,
   "text": "יש להם הרבה שאלות לשאול למה."
  },
  {
   "start": 368.76,
   "end": 370.56,
   "text": "הרב יסביר לנו, אבל אי אפשר לשאול."
  },
  {
   "start": 371.76,
   "end": 372.92,
   "text": "הרב אמר, הרב יודע."
  },
  {
   "start": 374.48,
   "end": 376.8,
   "text": "וכולם ממלאים את פיהם מים."
  },
  {
   "start": 377.96,
   "end": 378.96,
   "text": "כולם שותקים."
  },
  {
   "start": 379.94,
   "end": 381.06,
   "text": "נגזרה הגזרה."
  },
  {
   "start": 390.78,
   "end": 391.48,
   "text": "ערב שבת,"
  },
  {
   "start": 393.77,
   "end": 397.81,
   "text": "כל הקהילה היהודית של העיר נמצאת בבית הכנסת הגדול של העיר."
  },
  {
   "start": 400.66,
   "end": 401.5,
   "text": "כולם מתפללים."
  },
  {
   "start": 403.12,
   "end": 403.94,
   "text": "וגם התלמידים"
  },
  {
   "start": 404.88,
   "end": 407.98,
   "text": "עם החוזה מלוגלי נכנסו לבית כנסת והתפללו."
  },
  {
   "start": 412.11,
   "end": 412.73,
   "text": "איפה הם יאכלו?"
  },
  {
   "start": 413.57,
   "end": 414.73,
   "text": "איפה הם יתארחו בשבת?"
  },
  {
   "start": 417.07,
   "end": 426.13,
   "text": "עם ישראל לא היה צריך ולא צריך ביטוח לאומי ולא שירות סוציאלי ולא לשכת הסעד."
  },
  {
   "start": 426.81,
   "end": 428.77,
   "text": "בעם ישראל תמיד היה כלל."
  },
  {
   "start": 429.63,
   "end": 434.23,
   "text": "אז באותן תקופות עם ישראל לא היה צריך, לא לשכת הסעד, לא כלום."
  },
  {
   "start": 435.19,
   "end": 436.61,
   "text": "יהודי היה מגיע לבית הכנסת,"
  },
  {
   "start": 437.13,
   "end": 438.65,
   "text": "היית מזהה שהוא לא מהמקום,"
  },
  {
   "start": 439.29,
   "end": 441.01,
   "text": "היית מזמין אותו אליך שבת."
  },
  {
   "start": 442.71,
   "end": 443.33,
   "text": "אז כך גם הם,"
  },
  {
   "start": 444.23,
   "end": 445.39,
   "text": "מתפללים בבית הכנסת,"
  },
  {
   "start": 446.01,
   "end": 446.95,
   "text": "בסיום התפילה,"
  },
  {
   "start": 447.71,
   "end": 448.99,
   "text": "פונים אליהם אנשי הקהילה,"
  },
  {
   "start": 450.53,
   "end": 452.07,
   "text": "שלום כבודו, אולי יתארח אצלי,"
  },
  {
   "start": 452.67,
   "end": 453.25,
   "text": "בוא בבקשה."
  },
  {
   "start": 455.19,
   "end": 458.11,
   "text": "אדם בעל השני, שלום, אולי כבודו יתארח אצלי,"
  },
  {
   "start": 458.67,
   "end": 484.39,
   "text": "תודה, בו בבקשה לקח אחד-אחד ונצטרף לבעל בית אל שולחן השבת של אנשי הקהילה והחוזה מלובלי נשאר בבית הכנסת ארבעים דקות אחר כך"
  },
  {
   "start": 485.43,
   "end": 486.53,
   "text": "ומסיים את התפילה."
  },
  {
   "start": 487.97,
   "end": 490.45,
   "text": "מסתובב הבית כנסת"
  },
  {
   "start": 490.97,
   "end": 499.51,
   "text": "ריק שומם לבד מיהודי עשיש שנמצא לו בפינת בית הכנסת"
  },
  {
   "start": 500.53,
   "end": 502.55,
   "text": "יהודי השיש, בן שמונים, תשעים,"
  },
  {
   "start": 505.06,
   "end": 506.26,
   "text": "הגבאי של בית הכנסת."
  },
  {
   "start": 509.02,
   "end": 511.62,
   "text": "והוא פונה אל החוזה ואומר לו, יהודי יקר,"
  },
  {
   "start": 512.54,
   "end": 513.54,
   "text": "יהודי יקר, תראה,"
  },
  {
   "start": 514.56,
   "end": 516.14,
   "text": "יש לך איפה פה לעשות שבת?"
  },
  {
   "start": 517.12,
   "end": 518.1,
   "text": "אחוז אומר לו, לא."
  },
  {
   "start": 519.62,
   "end": 521.1,
   "text": "יהודי יקר, תראה, עכשיו כבר מאוחר."
  },
  {
   "start": 522.82,
   "end": 525.26,
   "text": "סיימת את התפילה מאוחר, לקחת אותך,"
  },
  {
   "start": 525.9,
   "end": 528.52,
   "text": "לקחת אותך אל אחד מהאנשים, מאנשי הקהילה."
  },
  {
   "start": 529.66,
   "end": 531.78,
   "text": "כבר כולם גמרו לאכול,"
  },
  {
   "start": 532.32,
   "end": 533.84,
   "text": "כולם גמרו את סעודת השבת."
  },
  {
   "start": 535.22,
   "end": 539.4,
   "text": "אולי היא תלך לבית מלון ואנחנו נממן את זה, הקהילה."
  },
  {
   "start": 541.06,
   "end": 545.5,
   "text": "מביט בו החוזה מלובלין ואומר לו, בבית מלון שלו מדליקים נרות שבת, אני לא נכנס."
  },
  {
   "start": 547.06,
   "end": 548.14,
   "text": "והיהודי האשיש נדהם."
  },
  {
   "start": 550.77,
   "end": 554.91,
   "text": "מאיפה האברך הזה יודע מה קורה בבית מלון?"
  },
  {
   "start": 555.69,
   "end": 557.23,
   "text": "אבל הוא שותק ואומר, תראה, יהודי."
  },
  {
   "start": 558.79,
   "end": 559.79,
   "text": "תראה, רבי יהודי."
  },
  {
   "start": 559.79,
   "end": 563.49,
   "text": "אם היה לי לארח אותך, אם אין לי אפשרות,"
  },
  {
   "start": 564.41,
   "end": 566.15,
   "text": "הייתי מארח אותך, אבל תאמין לי,"
  },
  {
   "start": 566.79,
   "end": 568.21,
   "text": "יש לי בסך הכל שתי חלות,"
  },
  {
   "start": 568.87,
   "end": 570.09,
   "text": "בקבוק של יין."
  },
  {
   "start": 570.71,
   "end": 571.23,
   "text": "אין לי הרבה."
  },
  {
   "start": 572.11,
   "end": 573.23,
   "text": "אין לי אמצעים הרבה."
  },
  {
   "start": 574.93,
   "end": 576.07,
   "text": "יש לך שתי חלות!"
  },
  {
   "start": 576.59,
   "end": 578.83,
   "text": "יש לך בקבוק של יין! זה נפלא!"
  },
  {
   "start": 579.35,
   "end": 580.07,
   "text": "זה נפלא!"
  },
  {
   "start": 580.39,
   "end": 581.77,
   "text": "זה מספיק די והותר!"
  },
  {
   "start": 582.13,
   "end": 584.79,
   "text": "אז אולי נצטרף אליך, אולי נעשה ביחד."
  },
  {
   "start": 587.1,
   "end": 588.6,
   "text": "ויש איש כל כך שמח."
  },
  {
   "start": 591.04,
   "end": 591.16,
   "text": "כן!"
  },
  {
   "start": 591.64,
   "end": 592.68,
   "text": "זה מספיק לך?"
  },
  {
   "start": 593.4,
   "end": 595.36,
   "text": "אתה מוכן להיות האורח שלי? בוודאי!"
  },
  {
   "start": 596.6,
   "end": 598.3,
   "text": "וכך הם הולכים ביחד,"
  },
  {
   "start": 600.56,
   "end": 602.14,
   "text": "ישיש כבן תשעים,"
  },
  {
   "start": 604.82,
   "end": 605.96,
   "text": "אך הוזה מלובלין,"
  },
  {
   "start": 607.97,
   "end": 609.05,
   "text": "הולכים אליו הביתה."
  },
  {
   "start": 610.47,
   "end": 610.95,
   "text": "ושמה,"
  },
  {
   "start": 611.59,
   "end": 615.53,
   "text": "קצת חלה, קצת יין, אבל הרבה הרבה שמחה,"
  },
  {
   "start": 616.11,
   "end": 619.03,
   "text": "הרבה הרבה תורה, הרבה הרבה שירה."
  },
  {
   "start": 619.73,
   "end": 621.21,
   "text": "הלב מתרונן."
  },
  {
   "start": 644.59,
   "end": 647.07,
   "text": "הישיש מביט,"
  },
  {
   "start": 647.31,
   "end": 650.81,
   "text": "מביט בחוזה מלובלין ושואל אותו, תגיד לי"
  },
  {
   "start": 651.49,
   "end": 652.27,
   "text": "יהודי יקר"
  },
  {
   "start": 653.97,
   "end": 654.81,
   "text": "מהיכן אתה?"
  },
  {
   "start": 657.19,
   "end": 659.25,
   "text": "אמר לו החוזה, אני מלובלין."
  },
  {
   "start": 661.75,
   "end": 664.29,
   "text": "מבט פניו של היש השתנה."
  },
  {
   "start": 665.05,
   "end": 665.81,
   "text": "הוא התחיל לרעוד,"
  },
  {
   "start": 666.51,
   "end": 671.69,
   "text": "לרעוד בהתרגשות וכשהוא כולו נרגש והוא הרעוד אומר לו, אתה?"
  },
  {
   "start": 672.17,
   "end": 673.15,
   "text": "אתה מלובלין?"
  },
  {
   "start": 673.75,
   "end": 674.91,
   "text": "הוא אומר לו, כן, אני מלובלין."
  },
  {
   "start": 675.91,
   "end": 676.63,
   "text": "תגיד לי,"
  },
  {
   "start": 677.77,
   "end": 678.63,
   "text": "אתה שמעת?"
  },
  {
   "start": 679.17,
   "end": 680.69,
   "text": "שמעת על החוזה מלובלין?!"
  },
  {
   "start": 681.95,
   "end": 685.61,
   "text": "אומר לו, החוזה כן, שמעתי עליו קצת."
  },
  {
   "start": 687.48,
   "end": 689.28,
   "text": "תגיד לי, אתה ראית אותו?"
  },
  {
   "start": 689.96,
   "end": 692.46,
   "text": "אומר לו, כן, גם ראיתי אותו."
  },
  {
   "start": 694.91,
   "end": 700.17,
   "text": "והישיש שלא יודע שלפניו ניצב החוזה מלובלין ממשיך ואומר לו,"
  },
  {
   "start": 700.73,
   "end": 701.35,
   "text": "תגיד לי,"
  },
  {
   "start": 702.21,
   "end": 704.21,
   "text": "ספר לי, ספר לי עליו."
  },
  {
   "start": 705.37,
   "end": 706.13,
   "text": "והוא מתחיל,"
  },
  {
   "start": 708.05,
   "end": 710.63,
   "text": "נאבק בגל דמעות שעולה,"
  },
  {
   "start": 711.05,
   "end": 711.57,
   "text": "אבל הוא לא מצליח,"
  },
  {
   "start": 712.23,
   "end": 713.25,
   "text": "ומתחיל לבכות."
  },
  {
   "start": 713.79,
   "end": 717.49,
   "text": "ויש איש בוכה, והחוזה לא מבין, אומר לו, יהודי, מה קרה?"
  },
  {
   "start": 718.69,
   "end": 719.37,
   "text": "מה קרה?"
  },
  {
   "start": 719.93,
   "end": 721.15,
   "text": "אבל אני אספר לך,"
  },
  {
   "start": 721.95,
   "end": 723.09,
   "text": "אני אספר לך."
  },
  {
   "start": 723.77,
   "end": 729.99,
   "text": "אתה יודע, אני כבר אחרי גיל 90. אני יודע שאין לי הרבה זמן לחיות."
  },
  {
   "start": 732.34,
   "end": 736.72,
   "text": "ואני פעם, כשהייתי צעיר,"
  },
  {
   "start": 739.39,
   "end": 740.83,
   "text": "אני הייתי בעיירה ליקוב."
  },
  {
   "start": 742.59,
   "end": 746.77,
   "text": "בעיירה ליקוב היה יהודי בשם רבי יעקב קופל מליקוב,"
  },
  {
   "start": 750.23,
   "end": 752.87,
   "text": "והבת שלו התחתנה עם העילוי משוורשין."
  },
  {
   "start": 754.37,
   "end": 755.49,
   "text": "ונולד להם בן,"
  },
  {
   "start": 756.31,
   "end": 757.29,
   "text": "קראו לו יצחק,"
  },
  {
   "start": 760.04,
   "end": 760.62,
   "text": "איציקיל."
  },
  {
   "start": 761.54,
   "end": 763.22,
   "text": "ולקחו את יצחק לחיידר."
  },
  {
   "start": 764.26,
   "end": 767.52,
   "text": "כשהוא גדל קצת, הילד, הם לקחו אותו לחיידר ללמוד תורה."
  },
  {
   "start": 768.22,
   "end": 770.4,
   "text": "ואני הייתי המלמד בחדר."
  },
  {
   "start": 771.28,
   "end": 772.92,
   "text": "אני הייתי המלמד של איציקיל."
  },
  {
   "start": 775.6,
   "end": 776.88,
   "text": "והיו לנו שם ילדים,"
  },
  {
   "start": 781.74,
   "end": 783.68,
   "text": "ואיציקיל הדאיג אותי מאוד."
  },
  {
   "start": 784.28,
   "end": 785.18,
   "text": "אתה יודע למה?"
  },
  {
   "start": 786.1,
   "end": 795.66,
   "text": "כי כל יום אחר הצהריים הוא היה נעלם למספר שעות ואחר כך חוזר."
  },
  {
   "start": 796.74,
   "end": 797.96,
   "text": "ואני הייתי כל כך מודאג,"
  },
  {
   "start": 798.92,
   "end": 801.18,
   "text": "אז יום אחד תפסתי אותו ואמרתי לו איציקיל,"
  },
  {
   "start": 801.72,
   "end": 805.0,
   "text": "איציקיל, איציקיל שלי, תגיד לי איפה אתה הולך."
  },
  {
   "start": 806.28,
   "end": 808.62,
   "text": "והילד נושא את עיניו הטהורות,"
  },
  {
   "start": 809.18,
   "end": 813.74,
   "text": "מסתכל בי ולא עונה מאומה."
  },
  {
   "start": 814.4,
   "end": 816.38,
   "text": "ואמרו לו, איציקל תגיד לי איפה אני מודאג,"
  },
  {
   "start": 816.88,
   "end": 817.76,
   "text": "לא יוצאים מפה,"
  },
  {
   "start": 818.24,
   "end": 819.8,
   "text": "מה אתה הולך, לאן אתה הולך,"
  },
  {
   "start": 820.52,
   "end": 821.36,
   "text": "מה קורה לך?"
  },
  {
   "start": 822.26,
   "end": 824.0,
   "text": "ואיציקל לא מספר לי כלום,"
  },
  {
   "start": 825.14,
   "end": 826.3,
   "text": "ככה יום ועוד יום."
  },
  {
   "start": 827.68,
   "end": 828.2,
   "text": "לא יכלתי,"
  },
  {
   "start": 829.08,
   "end": 830.0,
   "text": "לא יכלתי להתאפק."
  },
  {
   "start": 831.16,
   "end": 835.92,
   "text": "באתי יום אחד, תפסתי אותו, אמרתי לו, איציקל אתה תגיד לי, איציקל אם אתה לא תגיד אני אכה אותך."
  },
  {
   "start": 837.24,
   "end": 840.2,
   "text": "והוא לא אמר, רק הביט בי בעיניים הטהורות שלו."
  },
  {
   "start": 841.12,
   "end": 842.0,
   "text": "ואני הכיתי אותו,"
  },
  {
   "start": 842.98,
   "end": 843.4,
   "text": "והכיתי,"
  },
  {
   "start": 844.28,
   "end": 846.22,
   "text": "והוא סבל בדממה ושתק,"
  },
  {
   "start": 847.0,
   "end": 848.34,
   "text": "ולא אמר מילה,"
  },
  {
   "start": 851.62,
   "end": 853.24,
   "text": "ולמחרת שוב הוא נעלם,"
  },
  {
   "start": 853.66,
   "end": 856.46,
   "text": "וכשהוא חזר אני חיכיתי לו, והיכיתי אותו,"
  },
  {
   "start": 857.36,
   "end": 858.84,
   "text": "והוא לא אמר מילה,"
  },
  {
   "start": 859.48,
   "end": 861.58,
   "text": "וכך כשזה נמשך מספר ימים,"
  },
  {
   "start": 862.44,
   "end": 864.54,
   "text": "לא ידעתי מה לעשות,"
  },
  {
   "start": 865.06,
   "end": 866.82,
   "text": "אמרתי אני חייב לבדוק מה קורה פה."
  },
  {
   "start": 867.66,
   "end": 870.48,
   "text": "ביקשתי מחבר שלי, תעשה לי טובה, תשמור לי פה."
  },
  {
   "start": 871.24,
   "end": 873.2,
   "text": "אני רוצה לבדוק מה קורה עם איציקל שלי."
  },
  {
   "start": 873.86,
   "end": 875.2,
   "text": "לאן הוא נעלם, לאן הוא הולך?"
  },
  {
   "start": 876.2,
   "end": 879.72,
   "text": "והתחלתי לעקוב אחריו ואז ראיתי אותו"
  },
  {
   "start": 882.11,
   "end": 883.89,
   "text": "בשעות אחרי הצהריים הולך,"
  },
  {
   "start": 884.47,
   "end": 885.35,
   "text": "כאילו הולך להתפנות."
  },
  {
   "start": 886.53,
   "end": 887.03,
   "text": "אבל אז הוא מתחמק,"
  },
  {
   "start": 887.91,
   "end": 894.47,
   "text": "יוצא החוצה ומתחת לגדר היה שם איזה פרצה קטנה, הוא"
  },
  {
   "start": 895.59,
   "end": 896.57,
   "text": "יצא משם החוצה"
  },
  {
   "start": 897.75,
   "end": 898.59,
   "text": "ואני אחריו."
  },
  {
   "start": 900.09,
   "end": 902.13,
   "text": "כמה מטרים אחריו פוסע בשקט."
  },
  {
   "start": 902.97,
   "end": 903.79,
   "text": "איפה איציקל הולך?"
  },
  {
   "start": 904.43,
   "end": 909.63,
   "text": "ואיציקל רץ, הוא רץ אל היער, אל היער הסמוך והלב התחיל לדפוק."
  },
  {
   "start": 910.45,
   "end": 912.31,
   "text": "להלום בחוזקה."
  },
  {
   "start": 912.79,
   "end": 914.67,
   "text": "איציקל, מה אתה עושה? איציקל, לאן אתה הולך?"
  },
  {
   "start": 916.27,
   "end": 917.07,
   "text": "ואיציקל הולך ליער."
  },
  {
   "start": 918.85,
   "end": 920.65,
   "text": "שניות מספר אחר כך הוא נעלם לי ביער."
  },
  {
   "start": 922.56,
   "end": 923.94,
   "text": "איבדתי אותו, אני מתחיל לחפש."
  },
  {
   "start": 924.32,
   "end": 924.98,
   "text": "איפה הוא?"
  },
  {
   "start": 925.36,
   "end": 926.46,
   "text": "ואז אני שומע קולות."
  },
  {
   "start": 927.24,
   "end": 929.34,
   "text": "התחלתי ללכת לכיוון הקולות,"
  },
  {
   "start": 931.46,
   "end": 934.0,
   "text": "עד שהגעתי למעין קרחת יער,"
  },
  {
   "start": 934.62,
   "end": 936.02,
   "text": "ושם נעצרתי."
  },
  {
   "start": 937.36,
   "end": 939.12,
   "text": "אתה יודע מה אני ראיתי שם?"
  },
  {
   "start": 940.9,
   "end": 941.28,
   "text": "שם,"
  },
  {
   "start": 942.1,
   "end": 947.63,
   "text": "בלב קרחת היער ישב איציקיל שלי,"
  },
  {
   "start": 948.25,
   "end": 949.63,
   "text": "איציקיל הילד,"
  },
  {
   "start": 950.17,
   "end": 951.31,
   "text": "הילד הטהור הזה,"
  },
  {
   "start": 952.19,
   "end": 953.27,
   "text": "ישב על הרצפה,"
  },
  {
   "start": 954.73,
   "end": 959.93,
   "text": "מתחתיו היה קן של נמלים עוקצניות, נמלים עוקצות הבשר,"
  },
  {
   "start": 960.29,
   "end": 963.63,
   "text": "והנמלים טיפסו לו על הבשר ועקצו אותו,"
  },
  {
   "start": 964.39,
   "end": 966.13,
   "text": "והוא בעיניים עצומות"
  },
  {
   "start": 966.97,
   "end": 971.47,
   "text": "נושא את הפנים שלו אל השמיים וזועק,"
  },
  {
   "start": 971.47,
   "end": 978.33,
   "text": "שמע ישראל, אדוני אלוהינו, אדוני אחד."
  },
  {
   "start": 980.28,
   "end": 983.12,
   "text": "עד היום אני לא אשכח את המראה הזה."
  },
  {
   "start": 983.8,
   "end": 984.38,
   "text": "ואני חזרתי."
  },
  {
   "start": 986.48,
   "end": 987.32,
   "text": "חזרתי לחדר."
  },
  {
   "start": 988.68,
   "end": 989.1,
   "text": "הבנתי,"
  },
  {
   "start": 989.76,
   "end": 991.4,
   "text": "איציקיל לא ילד רגיל."
  },
  {
   "start": 992.84,
   "end": 994.72,
   "text": "איציקיל ילד מיוחד."
  },
  {
   "start": 998.01,
   "end": 999.35,
   "text": "חזרתי לחדר."
  },
  {
   "start": 1000.73,
   "end": 1001.71,
   "text": "ושתקתי."
  },
  {
   "start": 1002.83,
   "end": 1005.03,
   "text": "וכשהוא חזר איציקיל שלי."
  },
  {
   "start": 1006.49,
   "end": 1007.71,
   "text": "יותר לא הכאתי אותו,"
  },
  {
   "start": 1008.37,
   "end": 1010.55,
   "text": "יותר לא שאלתי אותו לאן הוא נעלם."
  },
  {
   "start": 1012.31,
   "end": 1013.97,
   "text": "רק בשקט הייתי עוקב אחריו,"
  },
  {
   "start": 1015.05,
   "end": 1016.13,
   "text": "אחרי איציקל שלי."
  },
  {
   "start": 1017.33,
   "end": 1019.69,
   "text": "ככה שנים טיפחתי את איציקל שלי,"
  },
  {
   "start": 1020.35,
   "end": 1024.47,
   "text": "ועקבתי, ידעתי שאיציקל יגדל ויהיה משהו."
  },
  {
   "start": 1024.97,
   "end": 1026.75,
   "text": "הוא יהיה משהו, לא ילד רגיל."
  },
  {
   "start": 1029.06,
   "end": 1035.3,
   "text": "ועם השנים עזבתי את ליקוב ועברתי לכאן לעיר הזאת,"
  },
  {
   "start": 1035.3,
   "end": 1041.4,
   "text": "ואז כל הזמן הייתי עוקב, מה עם איציקל?"
  },
  {
   "start": 1043.4,
   "end": 1045.84,
   "text": "ונודע לי שהוא ישב בלובלין,"
  },
  {
   "start": 1048.86,
   "end": 1052.34,
   "text": "והנה שמעתי שהוא מתפרסם בכל העולם כחוזה מלובלין."
  },
  {
   "start": 1060.38,
   "end": 1068.62,
   "text": "והמלמד הישיש, הרבה הישיש, החל לבכות ואמר לו, תדע לך,"
  },
  {
   "start": 1072.18,
   "end": 1073.2,
   "text": "תדע לך,"
  },
  {
   "start": 1074.24,
   "end": 1075.26,
   "text": "יהודי יקר,"
  },
  {
   "start": 1076.66,
   "end": 1078.26,
   "text": "אני יושב, אין לי, אין לי כסף."
  },
  {
   "start": 1080.0,
   "end": 1083.73,
   "text": "אין לי כיף, בקושי יש לי מה לאכול."
  },
  {
   "start": 1084.53,
   "end": 1085.51,
   "text": "אני אדם מבוגר,"
  },
  {
   "start": 1086.39,
   "end": 1086.85,
   "text": "חולה,"
  },
  {
   "start": 1087.41,
   "end": 1088.27,
   "text": "קשה לי ללכת."
  },
  {
   "start": 1088.99,
   "end": 1090.59,
   "text": "ללובלין אני לא יכול להגיע."
  },
  {
   "start": 1091.33,
   "end": 1095.39,
   "text": "אני כבר בשנים האחרונות מתפלל בורא עולם."
  },
  {
   "start": 1095.93,
   "end": 1096.79,
   "text": "תן לי אפשרות,"
  },
  {
   "start": 1098.17,
   "end": 1099.85,
   "text": "לפני שאני הולך לעולמי,"
  },
  {
   "start": 1100.17,
   "end": 1103.07,
   "text": "לפגוש פעם אחת את איציקל שלי."
  },
  {
   "start": 1103.41,
   "end": 1106.61,
   "text": "פעם אחת לפגוש אותו, לראות אותו."
  },
  {
   "start": 1107.79,
   "end": 1110.05,
   "text": "להיפגש איתו עם החוזה בלובלין."
  },
  {
   "start": 1111.98,
   "end": 1115.06,
   "text": "להגיד לו לבקש ממנו סליחה על שהכאתי אותו."
  },
  {
   "start": 1116.2,
   "end": 1117.32,
   "text": "ואני אגיד לך עוד משהו,"
  },
  {
   "start": 1120.2,
   "end": 1121.8,
   "text": "בחצי שנה האחרונה,"
  },
  {
   "start": 1122.58,
   "end": 1125.48,
   "text": "למרות שהרופאים אמרו לי אסור לך,"
  },
  {
   "start": 1126.34,
   "end": 1127.62,
   "text": "הרופאים אסרו עליי,"
  },
  {
   "start": 1128.62,
   "end": 1130.96,
   "text": "אני התחלתי לצום פעמיים בשבוע,"
  },
  {
   "start": 1132.32,
   "end": 1135.8,
   "text": "ובכולי בקשה בורא עולם, כולי תפילה בורא עולם,"
  },
  {
   "start": 1136.32,
   "end": 1138.52,
   "text": "אני מבקש לפני שאני מת,"
  },
  {
   "start": 1139.08,
   "end": 1141.02,
   "text": "תן לי לראות את איציק,"
  },
  {
   "start": 1141.78,
   "end": 1165.43,
   "text": "תן לי לראות אותו ולו פעם אחת לפני שאני אמות פעם. קם החוזה מלובלין קם החוזה מלובלין ואמר לו"
  },
  {
   "start": 1166.01,
   "end": 1167.91,
   "text": "אתה לא צריך להגיע ללובלין."
  },
  {
   "start": 1168.85,
   "end": 1185.9,
   "text": "לובלין בא אליך רבא קדוש רבא יקר החוזה לפניך החוזה מלובלין לפניך רבא אני זה איציקאל"
  },
  {
   "start": 1185.9,
   "end": 1193.99,
   "text": "אני זה איציקי, והמלמד הישיש התעלף."
  },
  {
   "start": 1198.9,
   "end": 1199.84,
   "text": "החוזה העיר אותו."
  },
  {
   "start": 1201.92,
   "end": 1205.18,
   "text": "את אותה שבת הם עשו ביחד, שניהם."
  },
  {
   "start": 1206.3,
   "end": 1207.4,
   "text": "מלמד ישיש,"
  },
  {
   "start": 1208.04,
   "end": 1209.24,
   "text": "שתפילתו התגשמה,"
  },
  {
   "start": 1210.76,
   "end": 1211.8,
   "text": "ורבי קדוש,"
  },
  {
   "start": 1216.62,
   "end": 1218.86,
   "text": "המלמד הרבה היה כל כך שמח,"
  },
  {
   "start": 1220.12,
   "end": 1221.5,
   "text": "כל כך מאושר."
  },
  {
   "start": 1223.4,
   "end": 1225.52,
   "text": "במוצאי שבת הם נפרדו."
  },
  {
   "start": 1229.12,
   "end": 1232.3,
   "text": "פנה החוזה מלובלין אל התלמידים שלו ואמר להם, תשמעו,"
  },
  {
   "start": 1232.8,
   "end": 1234.14,
   "text": "בואו אני אלמד לכם מוסר,"
  },
  {
   "start": 1235.04,
   "end": 1238.26,
   "text": "מוסר של חיים, דרך של חיים שלמה,"
  },
  {
   "start": 1241.56,
   "end": 1242.9,
   "text": "דרך של חיים שלמה,"
  },
  {
   "start": 1251.34,
   "end": 1252.12,
   "text": "את כל הדרך."
  },
  {
   "start": 1253.96,
   "end": 1257.24,
   "text": "בורא עולם דאג לנו לעשות, סיבב את העגלון,"
  },
  {
   "start": 1257.76,
   "end": 1262.94,
   "text": "סיבב את המרכבה הזו, סיבב אותנו כדי שנגיע,"
  },
  {
   "start": 1263.42,
   "end": 1269.6,
   "text": "כי אותו מלמד הרבה שלי מתפלל לפני השם יתברך בקשה לפני המוות."
  },
  {
   "start": 1272.59,
   "end": 1278.43,
   "text": "הכל, כל תנועה היא מושגחת, וכל תפילה היא נשמעת."
  },
  {
   "start": 1279.61,
   "end": 1282.69,
   "text": "והם עלו על המרכבה והמשיכו בדרכם."
  },
  {
   "start": 1286.82,
   "end": 1289.32,
   "text": "אחרי שעה של רכיבה,"
  },
  {
   "start": 1290.06,
   "end": 1293.48,
   "text": "לפתח חוזה מלובלין אמר לה, העגלון תעצור."
  },
  {
   "start": 1294.24,
   "end": 1297.24,
   "text": "העגלון עצר, אמר לו, תסתובב אחורה."
  },
  {
   "start": 1298.2,
   "end": 1298.88,
   "text": "סע חזרה,"
  },
  {
   "start": 1299.76,
   "end": 1300.94,
   "text": "חזרה לעיר, מהר."
  },
  {
   "start": 1303.41,
   "end": 1306.05,
   "text": "חזרה לעיר שממנה יצאנו."
  },
  {
   "start": 1307.63,
   "end": 1308.77,
   "text": "והם התחילו לדאור חזרה,"
  },
  {
   "start": 1323.17,
   "end": 1324.01,
   "text": "וכשהם הגיעו,"
  },
  {
   "start": 1327.12,
   "end": 1328.04,
   "text": "כשהם הגיעו לעיר,"
  },
  {
   "start": 1334.69,
   "end": 1338.67,
   "text": "הם הספיקו להצטרף למסע,"
  },
  {
   "start": 1339.93,
   "end": 1343.63,
   "text": "מסע ההלוויה של המלמד,"
  },
  {
   "start": 1345.98,
   "end": 1350.52,
   "text": "של המלמד הישיש שיצא לדרכו,"
  },
  {
   "start": 1353.74,
   "end": 1362.08,
   "text": "שדקות מספר עם צאת השבת הוא נפטר מן העולם בפניו."
  },
  {
   "start": 1363.12,
   "end": 1364.82,
   "text": "הוא זכה לראות את איציקל שלו,"
  },
  {
   "start": 1369.53,
   "end": 1371.85,
   "text": "והם ליוו אותו, החוזה מלובלין,"
  },
  {
   "start": 1372.27,
   "end": 1381.98,
   "text": "את העשרה מתלמידיו הקדושים מלווים יהודי ישיש עם בקשה,"
  },
  {
   "start": 1382.84,
   "end": 1385.18,
   "text": "בקשה פשוטה,"
  },
  {
   "start": 1391.73,
   "end": 1398.22,
   "text": "והחוזה פוסע בדממה אחרי הרבה שלו דמעה עבורו דמעה,"
  },
  {
   "start": 1406.1,
   "end": 1414.73,
   "text": "וכל התלמידים אחרי החוזה מלובלין עם ראש מורכן מלווים את הרבה,"
  },
  {
   "start": 1416.62,
   "end": 1418.74,
   "text": "את הרבה הישיש, את המלמד הישיש,"
  },
  {
   "start": 1418.74,
   "end": 1427.77,
   "text": "יהודי פשוט שביקש וקיבל."
  }
 ]
}