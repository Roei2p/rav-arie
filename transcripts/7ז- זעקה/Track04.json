{
 "disc": "7ז- זעקה",
 "track": "Track04",
 "duration": 1211.16,
 "segments": [
  {
   "start": 2.75,
   "end": 6.77,
   "text": "הוא היה בן למשפחת תלמידי חכמים מפוארת."
  },
  {
   "start": 12.18,
   "end": 12.78,
   "text": "זה לא היה קל"
  },
  {
   "start": 14.3,
   "end": 16.04,
   "text": "להיות בן למשפחה הזאת,"
  },
  {
   "start": 18.69,
   "end": 19.67,
   "text": "כי לצערו הרב"
  },
  {
   "start": 21.87,
   "end": 23.01,
   "text": "הוא היה חסר כישרון."
  },
  {
   "start": 25.5,
   "end": 27.14,
   "text": "משהו בהבנה אצלו היה לקוי."
  },
  {
   "start": 28.14,
   "end": 29.56,
   "text": "אפילו להתפלל היה לו קשה."
  },
  {
   "start": 32.72,
   "end": 33.62,
   "text": "וציפו ממנו."
  },
  {
   "start": 34.92,
   "end": 36.04,
   "text": "ציפו ממנו ביותר."
  },
  {
   "start": 40.27,
   "end": 41.23,
   "text": "הבושה, הצער,"
  },
  {
   "start": 42.09,
   "end": 42.87,
   "text": "היו חונקים אותו."
  },
  {
   "start": 49.21,
   "end": 50.93,
   "text": "החברה, החברה הייתה לועגת."
  },
  {
   "start": 51.91,
   "end": 53.11,
   "text": "והוא היה מצטנף לו בפינה,"
  },
  {
   "start": 54.43,
   "end": 56.29,
   "text": "פשוט שלא ירגישו בו,"
  },
  {
   "start": 57.03,
   "end": 58.07,
   "text": "להיבלע שם בשקט."
  },
  {
   "start": 64.92,
   "end": 65.64,
   "text": "הוא הצליח,"
  },
  {
   "start": 66.56,
   "end": 67.96,
   "text": "לאט לאט פשוט התעלמו ממנו,"
  },
  {
   "start": 68.98,
   "end": 72.04,
   "text": "למעט זוג עיניים שעקב אחריו ללא הרף."
  },
  {
   "start": 74.58,
   "end": 75.42,
   "text": "זוג עיניים מודאג."
  },
  {
   "start": 78.19,
   "end": 80.43,
   "text": "אימא שלו ראתה את הכל,"
  },
  {
   "start": 81.25,
   "end": 82.21,
   "text": "ראתה את הקשיים."
  },
  {
   "start": 83.95,
   "end": 86.09,
   "text": "חשה על הבשר שלה את הלעג,"
  },
  {
   "start": 87.55,
   "end": 89.17,
   "text": "את הבושה שהוא מרגיש."
  },
  {
   "start": 91.07,
   "end": 93.91,
   "text": "הייתה מביטה בו ובוכה ללא קול."
  },
  {
   "start": 95.89,
   "end": 99.03,
   "text": "הוא הרגיש כשהיה רואה את אמא בוכה שזה משהו קשור אליו,"
  },
  {
   "start": 103.63,
   "end": 106.03,
   "text": "אבל היא לא אמרה לו כלום, רק עודדה."
  },
  {
   "start": 107.99,
   "end": 108.87,
   "text": "ככה הבאה לו הילדות."
  },
  {
   "start": 110.33,
   "end": 110.97,
   "text": "השנים עוברות,"
  },
  {
   "start": 111.89,
   "end": 113.19,
   "text": "כולם בבית גדלים,"
  },
  {
   "start": 113.87,
   "end": 117.93,
   "text": "כל החברים מתבגרים, כולם נישאים, מקימים בית."
  },
  {
   "start": 119.17,
   "end": 120.79,
   "text": "בחגים באים עם הילדים,"
  },
  {
   "start": 121.95,
   "end": 123.53,
   "text": "ורק הוא עדיין לא נשוי."
  },
  {
   "start": 125.96,
   "end": 131.28,
   "text": "לא פשוט למצוא שידוך לאדם שאין לו, אין לו מה להציע."
  },
  {
   "start": 137.69,
   "end": 139.19,
   "text": "הוא היה מכונס בתוך עצמו."
  },
  {
   "start": 142.25,
   "end": 142.67,
   "text": "מאימא,"
  },
  {
   "start": 143.83,
   "end": 147.11,
   "text": "מאימא הוא למד שיעור גדול וחשוב אחד."
  },
  {
   "start": 148.27,
   "end": 149.15,
   "text": "את זה הוא הצליח להבין."
  },
  {
   "start": 150.05,
   "end": 151.03,
   "text": "לדבר עם השם."
  },
  {
   "start": 153.3,
   "end": 153.68,
   "text": "וכך,"
  },
  {
   "start": 154.46,
   "end": 155.58,
   "text": "שאף אחד לא היה רואה."
  },
  {
   "start": 157.1,
   "end": 157.62,
   "text": "בלילות"
  },
  {
   "start": 158.5,
   "end": 160.6,
   "text": "הוא היה יושב ומדבר עם השם."
  },
  {
   "start": 164.77,
   "end": 167.43,
   "text": "לפעמים מתחת לשמיכה הגוף שלו היה"
  },
  {
   "start": 167.97,
   "end": 168.91,
   "text": "רועד מבכי."
  },
  {
   "start": 170.11,
   "end": 172.29,
   "text": "פונה לשם בורא עולם, תן לי גם."
  },
  {
   "start": 173.15,
   "end": 174.77,
   "text": "תן לי גם להקים בית בורא עולם."
  },
  {
   "start": 175.39,
   "end": 177.23,
   "text": "בורא עולם, תן לי לא לבייש את ההורים שלי."
  },
  {
   "start": 179.43,
   "end": 180.77,
   "text": "בורא עולם, אני רוצה גם אני"
  },
  {
   "start": 182.09,
   "end": 184.01,
   "text": "ללמוד את התורה שלך, ואני לא יכול."
  },
  {
   "start": 186.11,
   "end": 187.53,
   "text": "וכך יום אחרי יום,"
  },
  {
   "start": 188.53,
   "end": 190.55,
   "text": "שנה אחרי שנה הוא מדבר עם השם."
  },
  {
   "start": 191.37,
   "end": 194.21,
   "text": "הוא לא רואה תוצאות, אבל הוא לא מתייאש."
  },
  {
   "start": 195.55,
   "end": 197.97,
   "text": "משהו בו פשוט נותן לו כוח, לא נותן לו"
  },
  {
   "start": 199.15,
   "end": 203.25,
   "text": "להתייאש, את זה לפחות, את זה לפחות הוא יכול, לא להתייאש."
  },
  {
   "start": 204.35,
   "end": 206.15,
   "text": "אתם יודעים מה? אולי היה לו כישרון אחד."
  },
  {
   "start": 207.21,
   "end": 208.19,
   "text": "לא להתייאש."
  },
  {
   "start": 224.58,
   "end": 226.56,
   "text": "אברהם, מה יהיה עם השידוך? אמא פנתה אליו."
  },
  {
   "start": 230.4,
   "end": 232.76,
   "text": "אברהם, אני רוצה למצוא לך שידוך."
  },
  {
   "start": 233.96,
   "end": 237.04,
   "text": "שמעתי על נערה, נערה פשוטה ממזריץ'."
  },
  {
   "start": 239.47,
   "end": 240.11,
   "text": "אתה מוכן?"
  },
  {
   "start": 242.33,
   "end": 243.03,
   "text": "והוא היה מוכן."
  },
  {
   "start": 243.79,
   "end": 244.75,
   "text": "הוא היה מוכן לכל."
  },
  {
   "start": 246.53,
   "end": 248.59,
   "text": "אמא לא הייתה, היא לא ידעה כמה הוא מוכן,"
  },
  {
   "start": 249.21,
   "end": 251.09,
   "text": "כמה הוא מוכן לתת ולוותר."
  },
  {
   "start": 251.67,
   "end": 254.53,
   "text": "כדי לראות את אימא מחייכת,"
  },
  {
   "start": 255.99,
   "end": 260.42,
   "text": "מחייכת בגללו,"
  },
  {
   "start": 261.24,
   "end": 262.04,
   "text": "שמחה ממנו."
  },
  {
   "start": 267.32,
   "end": 267.76,
   "text": "וכך,"
  },
  {
   "start": 270.85,
   "end": 272.41,
   "text": "ימים מספר לפני החתונה,"
  },
  {
   "start": 273.67,
   "end": 275.63,
   "text": "המשפחה נוסעת למזריץ',"
  },
  {
   "start": 277.66,
   "end": 279.42,
   "text": "בדרך הם חונים באכסניה."
  },
  {
   "start": 281.02,
   "end": 283.74,
   "text": "אחיו הגדול של אברהם בא, לוקח אותו,"
  },
  {
   "start": 284.82,
   "end": 287.76,
   "text": "ומלמד אותו את ברכת המזון,"
  },
  {
   "start": 288.7,
   "end": 292.46,
   "text": "לברך כמו שצריך את ברכת המזון כמנהג המקום."
  },
  {
   "start": 294.98,
   "end": 295.78,
   "text": "במזריץ',"
  },
  {
   "start": 296.48,
   "end": 300.26,
   "text": "האח ידע שהחתן צריך לברך את ברכת המזון."
  },
  {
   "start": 301.06,
   "end": 301.8,
   "text": "ככה מכבדים אותו."
  },
  {
   "start": 302.72,
   "end": 305.14,
   "text": "לפחות את זה שאברהם תדע, לפחות את זה."
  },
  {
   "start": 306.14,
   "end": 307.04,
   "text": "כבר לא תורה,"
  },
  {
   "start": 309.45,
   "end": 313.45,
   "text": "אבל לפחות לברך ברכת המזון, תדע כמו שצריך."
  },
  {
   "start": 314.61,
   "end": 315.63,
   "text": "והוא יושב מלמד אותו."
  },
  {
   "start": 317.31,
   "end": 317.81,
   "text": "מלמד אותו."
  },
  {
   "start": 318.81,
   "end": 320.91,
   "text": "לימוד ארוך,"
  },
  {
   "start": 321.61,
   "end": 322.35,
   "text": "מתיש,"
  },
  {
   "start": 330.87,
   "end": 332.51,
   "text": "זמן מה אחר כך הם מגיעים למזריץ',"
  },
  {
   "start": 335.59,
   "end": 336.69,
   "text": "סעודה משפחתית,"
  },
  {
   "start": 337.65,
   "end": 339.39,
   "text": "משפחה מאוד מכובדת עם החתן"
  },
  {
   "start": 340.49,
   "end": 341.57,
   "text": "ומשפחה של הכלה."
  },
  {
   "start": 343.47,
   "end": 344.75,
   "text": "וכשמסתיים האוכל,"
  },
  {
   "start": 347.1,
   "end": 348.76,
   "text": "מזמינים את החתן לברך."
  },
  {
   "start": 350.94,
   "end": 353.22,
   "text": "הכלה, מהפינה שלה שם מביטה בהערצה,"
  },
  {
   "start": 354.88,
   "end": 360.28,
   "text": "במשודח שלה ואימא של אברהם,"
  },
  {
   "start": 361.08,
   "end": 362.44,
   "text": "מביטה בפחד מוסתר,"
  },
  {
   "start": 363.58,
   "end": 365.64,
   "text": "והשפתיים שלה ממלמלות תפילה."
  },
  {
   "start": 370.33,
   "end": 371.25,
   "text": "ואברהם קם,"
  },
  {
   "start": 373.64,
   "end": 374.42,
   "text": "אדון כולו."
  },
  {
   "start": 376.12,
   "end": 377.24,
   "text": "ניצב שותק,"
  },
  {
   "start": 382.07,
   "end": 383.03,
   "text": "המילים לא יוצאות."
  },
  {
   "start": 384.19,
   "end": 385.59,
   "text": "הוא רוצה, הוא לא יכול."
  },
  {
   "start": 389.31,
   "end": 391.09,
   "text": "והחתן לא מצליח לברך."
  },
  {
   "start": 394.74,
   "end": 395.9,
   "text": "רחש בקהל."
  },
  {
   "start": 397.16,
   "end": 397.8,
   "text": "והחתן"
  },
  {
   "start": 398.96,
   "end": 399.96,
   "text": "כופה על עומדו."
  },
  {
   "start": 408.22,
   "end": 408.64,
   "text": "האחים"
  },
  {
   "start": 409.4,
   "end": 410.1,
   "text": "של אברהם"
  },
  {
   "start": 413.53,
   "end": 414.95,
   "text": "מביטים בו מבוישים."
  },
  {
   "start": 416.25,
   "end": 418.59,
   "text": "ואז קם האח הגדול,"
  },
  {
   "start": 419.21,
   "end": 420.89,
   "text": "זה שלימד אותו ברכת המזון."
  },
  {
   "start": 422.07,
   "end": 424.95,
   "text": "קם, הוא לא יכול לשאת את הבושה."
  },
  {
   "start": 426.21,
   "end": 430.78,
   "text": "הוא קם, הרים את היד,"
  },
  {
   "start": 433.17,
   "end": 434.57,
   "text": "וציל של סתירה"
  },
  {
   "start": 435.49,
   "end": 441.11,
   "text": "נשמע בחלל החדר וסתר לאברהם על לחיו."
  },
  {
   "start": 443.05,
   "end": 443.61,
   "text": "ואברהם,"
  },
  {
   "start": 444.55,
   "end": 445.97,
   "text": "הכל התפרץ לו באחת."
  },
  {
   "start": 451.42,
   "end": 457.82,
   "text": "הוא פנה ופשוט ברח, יצא בריצה מהחדר."
  },
  {
   "start": 458.64,
   "end": 459.18,
   "text": "רץ,"
  },
  {
   "start": 459.9,
   "end": 461.5,
   "text": "רץ מהבושה, מהסתירה."
  },
  {
   "start": 463.28,
   "end": 466.14,
   "text": "רץ, כדי שלא ירו בדמעות שלו, בבכי שלו."
  },
  {
   "start": 467.76,
   "end": 468.82,
   "text": "והוא רץ אל היער,"
  },
  {
   "start": 471.58,
   "end": 473.94,
   "text": "חוצה את בתי העיירה לכיוון היער,"
  },
  {
   "start": 480.24,
   "end": 481.34,
   "text": "שם ביער."
  },
  {
   "start": 482.36,
   "end": 487.92,
   "text": "הוא מרגיש מוגן, מרגיש בטוח, רחוק מקרבן בני אדם, שלא ילעגו לו."
  },
  {
   "start": 488.4,
   "end": 489.32,
   "text": "מה הוא יכול לעשות?"
  },
  {
   "start": 490.24,
   "end": 493.88,
   "text": "שם ביער הוא יכול לדבר עם ה'."
  },
  {
   "start": 495.54,
   "end": 497.96,
   "text": "שם ביער הוא מרגיש את הקדוש ברוך הוא,"
  },
  {
   "start": 502.13,
   "end": 505.11,
   "text": "ואז הוא נעמד לו במעבה היער."
  },
  {
   "start": 506.47,
   "end": 507.13,
   "text": "והחל,"
  },
  {
   "start": 507.83,
   "end": 510.33,
   "text": "אברהם החל לזעוק ריבונו של עולם,"
  },
  {
   "start": 511.03,
   "end": 514.57,
   "text": "ריבונו של עולם אני כל כך רוצה לגרום לך נחת."
  },
  {
   "start": 515.17,
   "end": 519.79,
   "text": "ריבונו של עולם אני כל כך רוצה לגרום נחת לאבא שלי, לאמא שלי."
  },
  {
   "start": 519.79,
   "end": 525.67,
   "text": "בורא עולם אני רוצה לעבוד אותך, ללמוד את התורה שלך, בורא עולם."
  },
  {
   "start": 532.6,
   "end": 533.86,
   "text": "והוא נפל לרצפה,"
  },
  {
   "start": 535.3,
   "end": 536.28,
   "text": "גועה בבכי,"
  },
  {
   "start": 538.75,
   "end": 540.13,
   "text": "בכי של שנים,"
  },
  {
   "start": 541.29,
   "end": 543.63,
   "text": "אותו בכי שמתחת לשמיכה,"
  },
  {
   "start": 544.71,
   "end": 548.13,
   "text": "אותו בכי שהוא היה ילד קטן והשפילו אותו החברים."
  },
  {
   "start": 551.45,
   "end": 552.63,
   "text": "והוא בכה ובכה,"
  },
  {
   "start": 554.21,
   "end": 557.55,
   "text": "עד שנרדם מרוב עייפות."
  },
  {
   "start": 580.33,
   "end": 587.81,
   "text": "הוא חש תנועה מסבך הסיכים שמימינו הייתה תנועה."
  },
  {
   "start": 589.49,
   "end": 590.25,
   "text": "דמות התקרבה,"
  },
  {
   "start": 591.01,
   "end": 592.09,
   "text": "הוא אימץ את העיניים שלו."
  },
  {
   "start": 596.88,
   "end": 597.96,
   "text": "הדמות מתקרבת,"
  },
  {
   "start": 599.0,
   "end": 599.46,
   "text": "קרוב,"
  },
  {
   "start": 600.68,
   "end": 605.3,
   "text": "וככל שהדמות התקרבה הוא גילה שזו לא דמות מאיימת,"
  },
  {
   "start": 606.54,
   "end": 608.5,
   "text": "זו דמות טובה, טהורה,"
  },
  {
   "start": 609.96,
   "end": 610.7,
   "text": "של סבא,"
  },
  {
   "start": 611.4,
   "end": 614.88,
   "text": "סבא זקן, עם פנים מהירות,"
  },
  {
   "start": 615.86,
   "end": 617.66,
   "text": "עם פנים מבהיקות מאור,"
  },
  {
   "start": 620.03,
   "end": 622.73,
   "text": "בא ומחייך ואומר לו, אברהם,"
  },
  {
   "start": 623.79,
   "end": 624.75,
   "text": "אברהם בני,"
  },
  {
   "start": 625.47,
   "end": 626.17,
   "text": "אברהם."
  },
  {
   "start": 627.79,
   "end": 634.88,
   "text": "אברהם אל תדאג, שנים של תפילות אבל הן נשאו פרי."
  },
  {
   "start": 636.54,
   "end": 637.88,
   "text": "אברהם אתה תקבל,"
  },
  {
   "start": 638.56,
   "end": 644.19,
   "text": "אברהם אתה תקבל חוכמה, ייפתחו בחיליך שערי החוכמה,"
  },
  {
   "start": 646.79,
   "end": 650.35,
   "text": "אבל אברהם, אסור לך לגלות לאף אחד."
  },
  {
   "start": 651.03,
   "end": 659.67,
   "text": "אסור לך לפתוח את הפה שלך בדברי תורה עד לרגע שאתה תראה אותי."
  },
  {
   "start": 661.72,
   "end": 662.34,
   "text": "אתה תלך,"
  },
  {
   "start": 665.95,
   "end": 671.31,
   "text": "ומחר בבוקר אתה החתן צריך לשאת דרשה בבית הכנסת."
  },
  {
   "start": 672.93,
   "end": 674.91,
   "text": "אתה תעלה לתת את הדרשה,"
  },
  {
   "start": 676.55,
   "end": 679.29,
   "text": "אבל אל תפתח אותה עד שתראה אותי."
  },
  {
   "start": 680.01,
   "end": 683.53,
   "text": "כשתראה אותי בבית הכנסת, אז תפתח את הפה,"
  },
  {
   "start": 686.52,
   "end": 698.5,
   "text": "אז יאירו עיניך במאור התורה מיד אחרי החתונה."
  },
  {
   "start": 700.16,
   "end": 701.44,
   "text": "אתה תצטרך ללכת"
  },
  {
   "start": 702.36,
   "end": 705.44,
   "text": "אל ישיבה וללמוד שם תורה,"
  },
  {
   "start": 706.78,
   "end": 712.4,
   "text": "לשבת ולרכוש את התורה בכוחות עצמך."
  },
  {
   "start": 715.26,
   "end": 718.5,
   "text": "ואברהם חש איך הוא מנענע את ראשו."
  },
  {
   "start": 720.96,
   "end": 722.22,
   "text": "הוא חש איך משהו עובר,"
  },
  {
   "start": 723.66,
   "end": 724.5,
   "text": "עובר את פניו,"
  },
  {
   "start": 728.16,
   "end": 728.96,
   "text": "עובר את ראשו."
  },
  {
   "start": 739.34,
   "end": 740.26,
   "text": "הוא פתח את העיניים."
  },
  {
   "start": 742.64,
   "end": 744.06,
   "text": "הלחות, הטל,"
  },
  {
   "start": 744.84,
   "end": 745.64,
   "text": "על העלים."
  },
  {
   "start": 746.4,
   "end": 747.16,
   "text": "מאיר אותו."
  },
  {
   "start": 751.45,
   "end": 752.61,
   "text": "כולו היה רטוב מהטל."
  },
  {
   "start": 753.79,
   "end": 754.41,
   "text": "זה היה חלום."
  },
  {
   "start": 756.75,
   "end": 757.87,
   "text": "הוא חזר אל האכסניה."
  },
  {
   "start": 759.97,
   "end": 760.67,
   "text": "איש לא דיבר איתו."
  },
  {
   "start": 762.29,
   "end": 763.83,
   "text": "הייתה אווירה כבדה וטעונה."
  },
  {
   "start": 765.41,
   "end": 766.41,
   "text": "כל המשפחה שותקת."
  },
  {
   "start": 767.31,
   "end": 767.45,
   "text": "רק אמא."
  },
  {
   "start": 768.63,
   "end": 772.13,
   "text": "רק אמא יושבת לה ומתפללת על הבן שלה."
  },
  {
   "start": 786.76,
   "end": 787.68,
   "text": "אברהם ידע,"
  },
  {
   "start": 791.21,
   "end": 791.65,
   "text": "ידע,"
  },
  {
   "start": 791.65,
   "end": 799.37,
   "text": "שהחלום לא היה חלום שב, משהו בתוכו אמר לו את זה."
  },
  {
   "start": 800.31,
   "end": 801.49,
   "text": "כך הגיע לו יום החתונה,"
  },
  {
   "start": 802.57,
   "end": 803.43,
   "text": "בוקר החתונה,"
  },
  {
   "start": 804.25,
   "end": 804.97,
   "text": "בבית כנסת,"
  },
  {
   "start": 805.71,
   "end": 806.43,
   "text": "תפילת שחרית."
  },
  {
   "start": 807.85,
   "end": 808.77,
   "text": "אברהם נכנס,"
  },
  {
   "start": 809.83,
   "end": 810.51,
   "text": "מתפלל."
  },
  {
   "start": 811.75,
   "end": 813.25,
   "text": "מביט סביבו, הוא לא רואה את המשפחה."
  },
  {
   "start": 814.47,
   "end": 815.33,
   "text": "הם התביישו לבוא,"
  },
  {
   "start": 815.91,
   "end": 817.37,
   "text": "התפללו בבית כנסת במניין אחר."
  },
  {
   "start": 819.87,
   "end": 820.45,
   "text": "בסוף התפילה"
  },
  {
   "start": 822.37,
   "end": 822.81,
   "text": "עולה על"
  },
  {
   "start": 823.23,
   "end": 823.87,
   "text": "עולה על הבמה"
  },
  {
   "start": 825.59,
   "end": 826.31,
   "text": "וממתין."
  },
  {
   "start": 828.82,
   "end": 829.72,
   "text": "כולם מסתכלים עליו,"
  },
  {
   "start": 830.9,
   "end": 832.52,
   "text": "מתיישבים במקומות וממתינים."
  },
  {
   "start": 834.26,
   "end": 835.1,
   "text": "עוד דקה עוברת"
  },
  {
   "start": 835.74,
   "end": 836.34,
   "text": "ועוד דקה,"
  },
  {
   "start": 837.76,
   "end": 839.0,
   "text": "ואברהם לא יודע מה לעשות,"
  },
  {
   "start": 842.5,
   "end": 844.76,
   "text": "ואז נפתחת לה הדלת."
  },
  {
   "start": 846.96,
   "end": 847.6,
   "text": "נכנס אדם."
  },
  {
   "start": 848.7,
   "end": 849.0,
   "text": "זה הוא."
  },
  {
   "start": 849.8,
   "end": 850.88,
   "text": "זה האיש מהחלום."
  },
  {
   "start": 852.5,
   "end": 853.06,
   "text": "מביט בו."
  },
  {
   "start": 854.68,
   "end": 857.24,
   "text": "בעיניים כל כך מהירות."
  },
  {
   "start": 858.2,
   "end": 863.68,
   "text": "ואברהם מתחיל, אברהם מתחיל בדברי תורה,"
  },
  {
   "start": 867.89,
   "end": 868.87,
   "text": "שטף של מילים,"
  },
  {
   "start": 869.79,
   "end": 871.53,
   "text": "ללא שליטה יוצא מפיו,"
  },
  {
   "start": 872.31,
   "end": 874.59,
   "text": "רעיונות על רעיונות, בניינים על בניינים,"
  },
  {
   "start": 875.67,
   "end": 877.25,
   "text": "ולאט לאט מתאספים אנשים,"
  },
  {
   "start": 877.73,
   "end": 881.05,
   "text": "מתפעלים, באים רבנים, באים תלמידי חכמים,"
  },
  {
   "start": 881.71,
   "end": 884.51,
   "text": "כולם נסערים, כולם נרגשים,"
  },
  {
   "start": 891.49,
   "end": 893.11,
   "text": "ולפתע תכונה ליד הדלת."
  },
  {
   "start": 898.82,
   "end": 901.24,
   "text": "המשפחה הגיעה, היא באה,"
  },
  {
   "start": 901.62,
   "end": 905.16,
   "text": "הם באים האחים נכנסים ולא מבינים מה קורה,"
  },
  {
   "start": 905.78,
   "end": 907.2,
   "text": "האח שלהם."
  },
  {
   "start": 907.94,
   "end": 919.0,
   "text": "זה שלא יודע לברך ברכת המזון עומד קבל עם ועדה על במה ודברי תורה מאירים כנתינתם בסיני."
  },
  {
   "start": 920.08,
   "end": 934.25,
   "text": "חוצבי להבות חודרי לבבות נשפכים כמעיין נובע מפיו ואח הבכור מחביר."
  },
  {
   "start": 934.25,
   "end": 959.37,
   "text": "ואבא לא מאמין וכולם מתפעלים אילו יחדש תלמיד חכם עצום חדש נגלה לעולם היהודי ולא רחוק משם"
  },
  {
   "start": 964.1,
   "end": 966.32,
   "text": "מאחורי וילון באזהרה"
  },
  {
   "start": 967.5,
   "end": 967.92,
   "text": "תנועה"
  },
  {
   "start": 968.6,
   "end": 969.36,
   "text": "ליד הוילון"
  },
  {
   "start": 971.92,
   "end": 972.72,
   "text": "אברהם שומע"
  },
  {
   "start": 974.68,
   "end": 975.54,
   "text": "קול חרישי"
  },
  {
   "start": 976.72,
   "end": 980.28,
   "text": "קול בכי חרישי מגיע לאוזניים שלו"
  },
  {
   "start": 981.74,
   "end": 982.98,
   "text": "בכי כל כך מוכר,"
  },
  {
   "start": 984.62,
   "end": 986.74,
   "text": "בכי שמלווה אותו מהילדות,"
  },
  {
   "start": 988.02,
   "end": 989.14,
   "text": "בכי של אימא,"
  },
  {
   "start": 990.12,
   "end": 993.34,
   "text": "של האימא שבכתה ובוכה על הילד שלה,"
  },
  {
   "start": 994.6,
   "end": 1000.3,
   "text": "שמתפללת לשם שנים בורא עולם, תרחם על הילד שלי, זה הילד שלי,"
  },
  {
   "start": 1002.69,
   "end": 1006.09,
   "text": "בן חכם ישמח אב ובן כסיל תוגת אמו,"
  },
  {
   "start": 1008.28,
   "end": 1009.54,
   "text": "כשהילד קשה לו,"
  },
  {
   "start": 1010.06,
   "end": 1011.4,
   "text": "איזה תוגה זו לאימא,"
  },
  {
   "start": 1018.23,
   "end": 1021.45,
   "text": "והבכי הזה נוסך בו כוחות מחודשים."
  },
  {
   "start": 1023.13,
   "end": 1023.97,
   "text": "והוא ממשיך,"
  },
  {
   "start": 1024.67,
   "end": 1025.83,
   "text": "והוא מדהים את כולם."
  },
  {
   "start": 1027.09,
   "end": 1028.29,
   "text": "ובתום הדרשה,"
  },
  {
   "start": 1029.41,
   "end": 1031.67,
   "text": "כל בית הכנסת קם לכבודו."
  },
  {
   "start": 1033.8,
   "end": 1035.78,
   "text": "תלמידי חכמים, רבנים,"
  },
  {
   "start": 1039.32,
   "end": 1041.82,
   "text": "זהו גאון של ממש, כולם מהללים."
  },
  {
   "start": 1042.86,
   "end": 1043.54,
   "text": "ואימא,"
  },
  {
   "start": 1044.36,
   "end": 1047.88,
   "text": "אימא מרשה לעצמה אחרי שנים לחייך,"
  },
  {
   "start": 1048.5,
   "end": 1049.46,
   "text": "לשמוח,"
  },
  {
   "start": 1049.98,
   "end": 1051.02,
   "text": "קצת נחת."
  },
  {
   "start": 1052.36,
   "end": 1053.44,
   "text": "תפילות של שנים"
  },
  {
   "start": 1055.34,
   "end": 1056.44,
   "text": "לא שבות ריקם."
  },
  {
   "start": 1058.61,
   "end": 1060.19,
   "text": "נערכה חתונה מפוארת."
  },
  {
   "start": 1061.41,
   "end": 1063.91,
   "text": "אחרי החתונה הוא הלך ללמוד."
  },
  {
   "start": 1066.58,
   "end": 1067.82,
   "text": "מוריי ורבותיי,"
  },
  {
   "start": 1068.38,
   "end": 1070.82,
   "text": "לימים אותו יהודי,"
  },
  {
   "start": 1071.38,
   "end": 1072.34,
   "text": "אותו אברהם,"
  },
  {
   "start": 1074.6,
   "end": 1075.64,
   "text": "אותו אברהם,"
  },
  {
   "start": 1076.54,
   "end": 1078.98,
   "text": "אברהם של המשפחה, אותו אברהם,"
  },
  {
   "start": 1079.76,
   "end": 1088.21,
   "text": "לימים התפרסם בכל תפוצות ישראל,"
  },
  {
   "start": 1089.09,
   "end": 1094.01,
   "text": "כגאון המפורסם, רבי אברהם אייביש מפרנקפורט."
  },
  {
   "start": 1095.05,
   "end": 1097.11,
   "text": "רבי אברהם אייביש מפרנקפורט."
  },
  {
   "start": 1098.37,
   "end": 1099.57,
   "text": "רבה של פרנקפורט."
  },
  {
   "start": 1102.9,
   "end": 1105.48,
   "text": "ואם תשאלו מי זה האיש הזקן שבא לו בחלום,"
  },
  {
   "start": 1107.85,
   "end": 1111.95,
   "text": "מי זה אותו שליח לפתוח בפניו את שערי התורה,"
  },
  {
   "start": 1114.32,
   "end": 1120.6,
   "text": "אז רבי אברהם אייביש מפרנקפורט היה חותם על ההסכמות שלו. היו באים אליו,"
  },
  {
   "start": 1121.86,
   "end": 1124.24,
   "text": "ואותו אחד שלו ידע ברכת המזון."
  },
  {
   "start": 1125.04,
   "end": 1126.28,
   "text": "תראו מה זה כוח של תפילה."
  },
  {
   "start": 1127.24,
   "end": 1129.84,
   "text": "באו, אתה יכול לתת לי כבוד הרב הסכמה על הספר?"
  },
  {
   "start": 1130.8,
   "end": 1131.7,
   "text": "והרב הגאון,"
  },
  {
   "start": 1132.46,
   "end": 1136.46,
   "text": "רבי אברהם אייביש, היה חותם על ההסכמות שלו."
  },
  {
   "start": 1137.18,
   "end": 1137.98,
   "text": "אתם יודעים איך היה כותב?"
  },
  {
   "start": 1138.96,
   "end": 1141.92,
   "text": "אברהם בן אברהם."
  },
  {
   "start": 1144.36,
   "end": 1145.84,
   "text": "זו הייתה החתימה שלי."
  },
  {
   "start": 1146.44,
   "end": 1147.88,
   "text": "אברהם בן אברהם."
  },
  {
   "start": 1161.58,
   "end": 1162.74,
   "text": "כוח של תפילה."
  },
  {
   "start": 1163.34,
   "end": 1164.88,
   "text": "שנים של תפילה, לא דקה."
  },
  {
   "start": 1166.4,
   "end": 1167.66,
   "text": "גם לא יום, גם לא שנה."
  },
  {
   "start": 1167.66,
   "end": 1173.21,
   "text": "אבל תראו איזה מהפך, תראו איזו עוצמה,"
  },
  {
   "start": 1174.63,
   "end": 1177.21,
   "text": "כוח של זעקה, כוח של תפילה,"
  },
  {
   "start": 1178.09,
   "end": 1180.03,
   "text": "של ילד, של אמא,"
  },
  {
   "start": 1181.74,
   "end": 1185.82,
   "text": "שברגע המתאים מסתיים לו התיקון,"
  },
  {
   "start": 1187.06,
   "end": 1190.94,
   "text": "ונפתחים להם שערי התורה, שערי האורה,"
  },
  {
   "start": 1191.7,
   "end": 1193.3,
   "text": "שערים של קדושה וטהרה."
  }
 ]
}