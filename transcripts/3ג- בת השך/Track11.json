{
 "disc": "3ג- בת השך",
 "track": "Track11",
 "duration": 339.216,
 "segments": [
  {
   "start": 0.68,
   "end": 2.42,
   "text": "זו הייתה מסכת החיים המופלאה"
  },
  {
   "start": 2.98,
   "end": 6.26,
   "text": "של רבי שבתאי כהן והבת שלו, אסתר."
  },
  {
   "start": 7.24,
   "end": 11.74,
   "text": "מסכת חיים שנמשכה על פני ימים ושנים אל מול רוחות ושערות,"
  },
  {
   "start": 12.32,
   "end": 13.32,
   "text": "עד שסוף-סוף,"
  },
  {
   "start": 14.32,
   "end": 19.56,
   "text": "סוף-סוף האב והבת נפגשו ותמו להם שנות הייסורים והבדידות."
  },
  {
   "start": 20.5,
   "end": 21.66,
   "text": "אבל אנחנו צריכים לדעת,"
  },
  {
   "start": 22.3,
   "end": 25.08,
   "text": "צריכים לחרות את זה בלב שלנו,"
  },
  {
   "start": 25.66,
   "end": 29.58,
   "text": "שכמו מסכת החיים הזו של אבא והבת שלו,"
  },
  {
   "start": 30.08,
   "end": 33.64,
   "text": "יש היום מסכת חיים דומה בין אבא לבת,"
  },
  {
   "start": 34.4,
   "end": 37.72,
   "text": "בין אבא שבשמיים לבת שלו היחידה,"
  },
  {
   "start": 38.2,
   "end": 39.32,
   "text": "כנסת ישראל,"
  },
  {
   "start": 39.84,
   "end": 40.56,
   "text": "עם ישראל,"
  },
  {
   "start": 41.2,
   "end": 45.22,
   "text": "בין אבא שמחכה שנים לילדים שלו שיחזרו אליו,"
  },
  {
   "start": 45.76,
   "end": 47.02,
   "text": "שימצאו את אבא."
  },
  {
   "start": 47.78,
   "end": 48.5,
   "text": "והיום,"
  },
  {
   "start": 49.36,
   "end": 50.48,
   "text": "היום אותה בת,"
  },
  {
   "start": 51.22,
   "end": 52.8,
   "text": "אותה כנסת ישראל,"
  },
  {
   "start": 53.38,
   "end": 57.22,
   "text": "עם ישראל, כולנו נמצאים במצב מיוחד,"
  },
  {
   "start": 58.02,
   "end": 59.44,
   "text": "במצב שונה,"
  },
  {
   "start": 59.92,
   "end": 61.6,
   "text": "במצב אולי מסוכן,"
  },
  {
   "start": 62.12,
   "end": 69.66,
   "text": "כמו אונייה קטנה שמטלטלת לה בלב האוקיינוס הענק בין גלי הים המתנפצים ומתפוצצים סביבה,"
  },
  {
   "start": 70.16,
   "end": 72.68,
   "text": "מאיימים להטביע אותה, לשבור אותה,"
  },
  {
   "start": 73.34,
   "end": 75.5,
   "text": "איך היא תצליח לעבור את הים הגדול הזה?"
  },
  {
   "start": 76.42,
   "end": 79.96,
   "text": "האם יש לה סיכוי כלשהו להגיע אי פעם לחוף מבטחים,"
  },
  {
   "start": 80.3,
   "end": 82.58,
   "text": "לשקט, לשלווה, לשלום?"
  },
  {
   "start": 83.54,
   "end": 87.24,
   "text": "כן, אם יש לה רב חובל שכולם נשמעים אליו,"
  },
  {
   "start": 87.82,
   "end": 90.0,
   "text": "הוא יוביל אותם לחוף מבטחים."
  },
  {
   "start": 90.9,
   "end": 94.26,
   "text": "עם הגלים, כנגד הגלים, הוא יוביל אותם."
  },
  {
   "start": 95.16,
   "end": 95.88,
   "text": "ואתם יודעים,"
  },
  {
   "start": 96.9,
   "end": 97.74,
   "text": "היום אותה בת,"
  },
  {
   "start": 98.44,
   "end": 99.12,
   "text": "אותה כנסת ישראל,"
  },
  {
   "start": 100.56,
   "end": 104.84,
   "text": "אנחנו כולנו נמצאים במצב מאוד מאוד מיוחד,"
  },
  {
   "start": 106.2,
   "end": 108.46,
   "text": "מאוד מאוד אולי, הייתי אומר, מסוכן."
  },
  {
   "start": 109.22,
   "end": 109.92,
   "text": "היום עם ישראל,"
  },
  {
   "start": 111.0,
   "end": 111.92,
   "text": "וזה כולנו,"
  },
  {
   "start": 113.0,
   "end": 116.28,
   "text": "בין שומרים תורה ומצוות, בין לא שומרים תורה ומצוות,"
  },
  {
   "start": 116.5,
   "end": 118.54,
   "text": "לא משנה, כולנו עם אחד,"
  },
  {
   "start": 119.14,
   "end": 121.42,
   "text": "כולנו נמצאים באותה ספינה,"
  },
  {
   "start": 121.92,
   "end": 123.26,
   "text": "ספינת היהודים."
  },
  {
   "start": 124.16,
   "end": 129.82,
   "text": "וספינת היהודים מיטלטלת לה בלב הים הגדול, בלב העולם הגדול."
  },
  {
   "start": 130.84,
   "end": 135.74,
   "text": "מסביב גלים שמנסים לנפץ ולהפוך ולשבור ולהטביע."
  },
  {
   "start": 136.88,
   "end": 141.78,
   "text": "מסביב בעולם כל מיני מדינות, 850 מיליון מוסלמים,"
  },
  {
   "start": 142.5,
   "end": 144.58,
   "text": "עוד כמה מיליונים של אנטישמים,"
  },
  {
   "start": 145.46,
   "end": 150.46,
   "text": "שמחכים ורוצים להפיל את אותה ספינה נפלאה,"
  },
  {
   "start": 151.04,
   "end": 152.88,
   "text": "את העם הקטן והנפלא הזה,"
  },
  {
   "start": 153.26,
   "end": 155.94,
   "text": "את העם שלנו, אותנו, אותך, אותי,"
  },
  {
   "start": 156.44,
   "end": 156.72,
   "text": "אותך,"
  },
  {
   "start": 157.82,
   "end": 158.54,
   "text": "את כולנו,"
  },
  {
   "start": 159.32,
   "end": 159.82,
   "text": "ואיך"
  },
  {
   "start": 160.36,
   "end": 161.46,
   "text": "נוכל לשרוד?"
  },
  {
   "start": 162.32,
   "end": 166.42,
   "text": "האם יש לנו באמת סיכוי לצאת אי פעם מהמצב הזה?"
  },
  {
   "start": 167.62,
   "end": 168.54,
   "text": "יש לנו סיכוי,"
  },
  {
   "start": 169.26,
   "end": 170.58,
   "text": "כי יש לנו רב חובל,"
  },
  {
   "start": 171.48,
   "end": 172.92,
   "text": "כי יש לנו אבא שבשמיים,"
  },
  {
   "start": 173.54,
   "end": 177.26,
   "text": "כי יש לנו את מלך מלכי המלכים הקדוש ברוך הוא, שאוהב אותנו"
  },
  {
   "start": 177.94,
   "end": 181.62,
   "text": "וממתין לנו רק כשנפנה את העיניים למעלה אליו."
  },
  {
   "start": 182.88,
   "end": 184.04,
   "text": "רק כשנמצא אותו,"
  },
  {
   "start": 184.48,
   "end": 185.8,
   "text": "רק כשנסיר את כל הקשיים,"
  },
  {
   "start": 185.9,
   "end": 186.4,
   "text": "את כל המחיצות,"
  },
  {
   "start": 186.92,
   "end": 189.74,
   "text": "את כל המפריעים בינינו לבין אבא שבשמיים."
  },
  {
   "start": 190.58,
   "end": 191.88,
   "text": "וזה כל כך פשוט,"
  },
  {
   "start": 192.86,
   "end": 194.94,
   "text": "פשוט לדלג מעל כל הקשיים היומיומיים,"
  },
  {
   "start": 195.36,
   "end": 197.26,
   "text": "להסתכל רק לאבא שבשמיים,"
  },
  {
   "start": 197.74,
   "end": 199.68,
   "text": "לפתוח את הפה, את הפה שלנו,"
  },
  {
   "start": 200.36,
   "end": 201.26,
   "text": "שנועד בשביל זה,"
  },
  {
   "start": 201.78,
   "end": 203.78,
   "text": "נועד בשביל לדבר לאבא שבשמיים,"
  },
  {
   "start": 204.44,
   "end": 211.52,
   "text": "שנועד בשביל לפנות לאבא שבשמיים בדיבור פשוט, כמו שילד מדבר לאבא שלו."
  },
  {
   "start": 212.22,
   "end": 219.72,
   "text": "הרבה פעמים קשה לנו לפנות לאבא שבשמיים, אנחנו חושבים, הרי הוא, איך נפנה אליו? אבל זו פנייה כמו ילד שמדבר לאבא שלו,"
  },
  {
   "start": 220.24,
   "end": 221.28,
   "text": "וזה כל כך קל."
  },
  {
   "start": 221.84,
   "end": 225.06,
   "text": "וככה נוכל לפנות, וככה נוכל לפתוח במסע,"
  },
  {
   "start": 225.58,
   "end": 229.3,
   "text": "במסע יהודי, במסע מדהים אל אבא שבשמיים."
  },
  {
   "start": 229.7,
   "end": 237.2,
   "text": "נוכל להצטרף אל מסע למעשה שמתחיל ממרגלות הר סיני ועד הגאולה השלמה ועד הגאולה השלמה שהיא קרובה."
  },
  {
   "start": 237.62,
   "end": 240.4,
   "text": "נוכל להתחיל את המסע, אתם יודעים איפה להתחיל את המסע?"
  },
  {
   "start": 240.86,
   "end": 241.64,
   "text": "מהלב,"
  },
  {
   "start": 242.4,
   "end": 243.66,
   "text": "מהלב שלנו."
  },
  {
   "start": 245.18,
   "end": 246.44,
   "text": "נתחיל בדיבור לשם,"
  },
  {
   "start": 247.04,
   "end": 250.56,
   "text": "בלפנות לשם כמו ילד שפונה לאבא שלו."
  },
  {
   "start": 251.46,
   "end": 255.34,
   "text": "יש לנו הרבה פעמים קשיים, יש הרבה קשיים בעולם, ולא מבינים שהפתרון הוא פשוט."
  },
  {
   "start": 256.34,
   "end": 259.88,
   "text": "לפנות לאבא שבשמיים בצורה פשוטה,"
  },
  {
   "start": 260.42,
   "end": 264.68,
   "text": "בתפילה לשם, להתחיל להתפלל לאבא שבשמיים,"
  },
  {
   "start": 266.06,
   "end": 269.2,
   "text": "לדעת שרק הוא יכול לעזור לי,"
  },
  {
   "start": 269.78,
   "end": 272.14,
   "text": "ואני פונה רק אליו, ואני מתפלל רק אליו."
  },
  {
   "start": 273.18,
   "end": 275.42,
   "text": "ואחר כך אפשר להתחיל גם לצעוד קדימה,"
  },
  {
   "start": 277.04,
   "end": 277.76,
   "text": "אל העתיד,"
  },
  {
   "start": 278.08,
   "end": 281.48,
   "text": "להתחיל לצעוד קדימה ולפתוח שער אחרי שער,"
  },
  {
   "start": 282.46,
   "end": 284.94,
   "text": "ואז נראה איך נפתחים בפנינו השערים,"
  },
  {
   "start": 285.56,
   "end": 286.7,
   "text": "שערי תפילה,"
  },
  {
   "start": 287.52,
   "end": 288.9,
   "text": "שערי תורה,"
  },
  {
   "start": 289.7,
   "end": 291.0,
   "text": "שערי חסד,"
  },
  {
   "start": 291.56,
   "end": 293.24,
   "text": "שערי שמחה ואהבה,"
  },
  {
   "start": 294.12,
   "end": 295.64,
   "text": "וכך שער אחרי שער,"
  },
  {
   "start": 297.08,
   "end": 299.7,
   "text": "שער אחרי שער, צעד אחרי צעד,"
  },
  {
   "start": 300.32,
   "end": 301.2,
   "text": "מתקרבים,"
  },
  {
   "start": 301.58,
   "end": 307.62,
   "text": "עולים על המסלול בו צועדים וצעדו אבותינו קדושים וטהורים, עם ישראל קדוש,"
  },
  {
   "start": 308.46,
   "end": 309.84,
   "text": "בדרך אל הגאולה השלמה,"
  },
  {
   "start": 310.38,
   "end": 311.0,
   "text": "אל עולם,"
  },
  {
   "start": 311.48,
   "end": 314.08,
   "text": "עולם מושלם, אל עולם הנצח,"
  },
  {
   "start": 314.9,
   "end": 315.94,
   "text": "אל עולם ימות משיח."
  },
  {
   "start": 316.88,
   "end": 317.52,
   "text": "בואו יחד"
  },
  {
   "start": 318.22,
   "end": 319.02,
   "text": "נעלה על הרכבת."
  },
  {
   "start": 319.8,
   "end": 322.3,
   "text": "היא כבר התחילה לנסוע, היא כבר התחילה להתקדם."
  },
  {
   "start": 322.8,
   "end": 327.64,
   "text": "בואו נצטרף למסע יהודי של מעשה החל עוד הרבה הרבה שנים אחורה,"
  },
  {
   "start": 328.32,
   "end": 330.88,
   "text": "למרגלות הר סיני, והוא ממשיך עד היום."
  },
  {
   "start": 331.32,
   "end": 332.58,
   "text": "בואו נשמע לנשמה."
  },
  {
   "start": 333.36,
   "end": 336.7,
   "text": "בואו, בואו ניתן ללב לנגן את ניגון האמונה."
  },
  {
   "start": 337.16,
   "end": 337.94,
   "text": "אוהבים אתכם."
  },
  {
   "start": 338.4,
   "end": 339.06,
   "text": "אוהבים אתכם."
  }
 ]
}