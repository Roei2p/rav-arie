{
 "disc": "5ה- השרשרת",
 "track": "Track01",
 "duration": 1331.16,
 "segments": [
  {
   "start": 3.02,
   "end": 3.86,
   "text": "השאלה הראשונה"
  },
  {
   "start": 5.5,
   "end": 8.8,
   "text": "שבורא עולם שואל את האדם,"
  },
  {
   "start": 9.56,
   "end": 10.62,
   "text": "את האדם הראשון,"
  },
  {
   "start": 13.19,
   "end": 17.47,
   "text": "אייכה, היכן אתה?"
  },
  {
   "start": 21.03,
   "end": 24.87,
   "text": "מה פתאום השם יתברך, מלך מלכי המלכים,"
  },
  {
   "start": 25.41,
   "end": 27.95,
   "text": "הקדוש ברוך הוא, זה שברא את העולם,"
  },
  {
   "start": 28.31,
   "end": 35.05,
   "text": "הוא לא יודע איפה האדם הראשון אחרי החטא הקדמון, הוא שואל אותו, אייכה?"
  },
  {
   "start": 35.87,
   "end": 36.81,
   "text": "מה, הוא לא יודע איפה הוא?"
  },
  {
   "start": 39.28,
   "end": 51.4,
   "text": "אלא צריך לדעת השאלה ששאל השם יתברך את אדם הראשון זו שאלה שמופנית לא רק לאדם הראשון אלא לכל אחד ואחת."
  },
  {
   "start": 53.41,
   "end": 54.63,
   "text": "כי כשהאדם חטא,"
  },
  {
   "start": 55.13,
   "end": 56.63,
   "text": "כשהאדם אכל מעץ הדעת,"
  },
  {
   "start": 57.75,
   "end": 58.65,
   "text": "אז מה הוא אמר למעשה?"
  },
  {
   "start": 59.11,
   "end": 60.13,
   "text": "הוא אמר, האישה גרמה לי."
  },
  {
   "start": 61.31,
   "end": 63.09,
   "text": "והאישה טענה, הנחש שכנע אותי."
  },
  {
   "start": 64.41,
   "end": 66.93,
   "text": "והקדוש ברוך הוא שואל, אייכה,"
  },
  {
   "start": 67.63,
   "end": 69.93,
   "text": "היכן האני שלך?"
  },
  {
   "start": 70.45,
   "end": 71.41,
   "text": "היכן אתה?"
  },
  {
   "start": 71.99,
   "end": 72.99,
   "text": "למה נגררת?"
  },
  {
   "start": 73.55,
   "end": 74.95,
   "text": "איפה העצמיות שלך?"
  },
  {
   "start": 75.51,
   "end": 78.29,
   "text": "איפה הנשמה הטהורה שנתתי לך?"
  },
  {
   "start": 78.61,
   "end": 79.85,
   "text": "איפה הייחודיות שלך?"
  },
  {
   "start": 80.25,
   "end": 81.73,
   "text": "איפה האני שלך?"
  },
  {
   "start": 82.33,
   "end": 83.65,
   "text": "איפה האני שלך?"
  },
  {
   "start": 85.71,
   "end": 86.33,
   "text": "זה היקר."
  },
  {
   "start": 87.11,
   "end": 89.59,
   "text": "זה מה שברא העולם נשאל ושואל אותנו."
  },
  {
   "start": 90.33,
   "end": 91.43,
   "text": "יהודי, יהודייה,"
  },
  {
   "start": 92.13,
   "end": 92.97,
   "text": "איפה אתם?"
  },
  {
   "start": 94.13,
   "end": 97.91,
   "text": "איפה הייחוד שלך, שלך כיהודים?"
  },
  {
   "start": 98.33,
   "end": 99.81,
   "text": "כבניי המיוחדים,"
  },
  {
   "start": 105.25,
   "end": 109.87,
   "text": "וזו השאלה שכל אחד ואחד צריכים לענות עליה."
  },
  {
   "start": 121.51,
   "end": 122.03,
   "text": "בואו יחד"
  },
  {
   "start": 122.63,
   "end": 124.91,
   "text": "נתחזק ונלמד מי אנחנו."
  },
  {
   "start": 126.77,
   "end": 130.21,
   "text": "מי אנחנו ומה זה אומר לגבינו,"
  },
  {
   "start": 132.67,
   "end": 134.35,
   "text": "כי אנחנו צריכים לדעת היום."
  },
  {
   "start": 136.03,
   "end": 143.59,
   "text": "כש-850 מיליון מוסלמים מקיפים אותנו בטווח הקרוב והרחוק,"
  },
  {
   "start": 143.67,
   "end": 146.87,
   "text": "ומיליארד ומאתיים מיליון מוסלמים בכל העולם."
  },
  {
   "start": 148.43,
   "end": 149.69,
   "text": "כמה אנטישמים יש,"
  },
  {
   "start": 150.03,
   "end": 152.37,
   "text": "כמה אנשים שרוצים שלא נהיה פה בעולם."
  },
  {
   "start": 153.49,
   "end": 156.31,
   "text": "חייבים, חייבים לעצמנו, חייבים לילדים שלנו,"
  },
  {
   "start": 156.95,
   "end": 159.55,
   "text": "חייבים לכולנו תשובה מי אנחנו באמת."
  },
  {
   "start": 160.27,
   "end": 162.11,
   "text": "בואו נכיר, בואו נלמד,"
  },
  {
   "start": 162.41,
   "end": 164.81,
   "text": "בואו נפתח את תעודת הזהות שלנו האמיתית,"
  },
  {
   "start": 165.87,
   "end": 170.01,
   "text": "שבו חתום בחותמת של דם יהודי,"
  },
  {
   "start": 170.77,
   "end": 172.93,
   "text": "יהודייה, נשמות טהורות."
  },
  {
   "start": 173.47,
   "end": 187.23,
   "text": "והוא נכיר את עצמנו בעזרת השם יתברך 600 שנה אחורה."
  },
  {
   "start": 189.23,
   "end": 193.24,
   "text": "לפני כ-600 שנה בספרד"
  },
  {
   "start": 194.1,
   "end": 195.52,
   "text": "היה נשיא שקראו לו פרדיננד."
  },
  {
   "start": 196.42,
   "end": 199.22,
   "text": "הוא התחתן עם מלכה שקוראים לה איזבלה, מלכת פורטוגל."
  },
  {
   "start": 201.34,
   "end": 202.4,
   "text": "ויחד הם חברו,"
  },
  {
   "start": 206.48,
   "end": 208.06,
   "text": "יחד עם מוסד הכנסייה"
  },
  {
   "start": 209.48,
   "end": 210.04,
   "text": "בראשות"
  },
  {
   "start": 210.78,
   "end": 214.68,
   "text": "הכומר השטני טורקוומדה,"
  },
  {
   "start": 214.68,
   "end": 219.36,
   "text": "לארגן את גירוש יהודי ספרד ופורטוגל."
  },
  {
   "start": 220.58,
   "end": 222.3,
   "text": "להנציר פרדינד היה לו שר חצר יהודי,"
  },
  {
   "start": 223.94,
   "end": 224.98,
   "text": "עמנואל דלה גולאר."
  },
  {
   "start": 230.1,
   "end": 231.04,
   "text": "אותו שר החצר,"
  },
  {
   "start": 231.86,
   "end": 232.52,
   "text": "עמנואל,"
  },
  {
   "start": 233.76,
   "end": 234.58,
   "text": "הייתה לו את הברירה"
  },
  {
   "start": 235.82,
   "end": 236.98,
   "text": "לצאת לגירוש,"
  },
  {
   "start": 237.62,
   "end": 240.06,
   "text": "להפסיד את כל הנכסים שלו, את כל המעמד, את כל היוקרה,"
  },
  {
   "start": 242.76,
   "end": 245.66,
   "text": "או להמיר את דתו."
  },
  {
   "start": 247.34,
   "end": 248.72,
   "text": "הוא העדיף להיות מגורש,"
  },
  {
   "start": 249.44,
   "end": 250.3,
   "text": "לאבד את הכל."
  },
  {
   "start": 251.32,
   "end": 255.04,
   "text": "וכשהנסיף רדינן שומע את זה, הוא לא מוכן לוותר על שר החצר שלו."
  },
  {
   "start": 255.7,
   "end": 258.0,
   "text": "והוא בא ואומר, תראה, אתה, אני לא אתן לך להיות מגורש."
  },
  {
   "start": 258.38,
   "end": 258.9,
   "text": "אתה לא מגורש."
  },
  {
   "start": 259.68,
   "end": 261.36,
   "text": "אתה או שאתה ממיר את הדת שלך,"
  },
  {
   "start": 262.5,
   "end": 263.7,
   "text": "או שאני אעלה אותך על המוקד."
  },
  {
   "start": 267.56,
   "end": 268.54,
   "text": "ואימא אותו שר,"
  },
  {
   "start": 269.08,
   "end": 273.54,
   "text": "אותו שר חצר רבי עמנואל לא מוכן לוותר על היהדות שלו."
  },
  {
   "start": 276.19,
   "end": 277.19,
   "text": "והנסיך לא מבין"
  },
  {
   "start": 278.13,
   "end": 280.45,
   "text": "מה מניע את היהודי הזה, מה אתה רוצה?"
  },
  {
   "start": 281.05,
   "end": 281.43,
   "text": "חבל לך."
  },
  {
   "start": 282.31,
   "end": 284.75,
   "text": "יש לך כל כך עוצמה בידיים, מעמד נפלא,"
  },
  {
   "start": 284.91,
   "end": 291.07,
   "text": "כסף, הכל. אתה מאבד את הכל, וגם אתה מוכן להישרף בשביל להישאר יהודי. מה זה משנה?"
  },
  {
   "start": 294.98,
   "end": 296.42,
   "text": "הנסיך פרדינד לא מבין את זה."
  },
  {
   "start": 297.0,
   "end": 298.58,
   "text": "הוא יודע שהוא בעצמו לא היה עושה את זה."
  },
  {
   "start": 299.68,
   "end": 301.34,
   "text": "אבל עמנואל, השר החצר, הולך."
  },
  {
   "start": 302.32,
   "end": 304.68,
   "text": "הולך אל המוקד, מעדיף למות."
  },
  {
   "start": 305.48,
   "end": 307.14,
   "text": "ובדרך שהוא מגיע לפני המוקד,"
  },
  {
   "start": 307.8,
   "end": 310.12,
   "text": "עוצר את התהלוכה הזאת, תהלוכת המוות, הנסיך."
  },
  {
   "start": 310.78,
   "end": 311.42,
   "text": "והוא אומר, תשמע,"
  },
  {
   "start": 312.32,
   "end": 312.92,
   "text": "תשמע, השר,"
  },
  {
   "start": 313.84,
   "end": 314.66,
   "text": "השר עמנואל,"
  },
  {
   "start": 315.6,
   "end": 317.48,
   "text": "אני נותן לך צ'אנס אחרון, סיכוי אחרון."
  },
  {
   "start": 318.02,
   "end": 318.26,
   "text": "בוא,"
  },
  {
   "start": 318.88,
   "end": 321.02,
   "text": "בוא תחזור חזרה, בוא תמיר את הדעת."
  },
  {
   "start": 321.44,
   "end": 322.34,
   "text": "למה אתה הולך למות?"
  },
  {
   "start": 327.81,
   "end": 330.19,
   "text": "לא חבל על הילדים שלך שיאבדו את אבא שלהם?"
  },
  {
   "start": 330.69,
   "end": 332.03,
   "text": "למה? למה אתה עושה את זה?"
  },
  {
   "start": 335.43,
   "end": 337.03,
   "text": "ואז לפתע שר החצר צעק"
  },
  {
   "start": 337.67,
   "end": 338.57,
   "text": "השלשלת!"
  },
  {
   "start": 339.19,
   "end": 339.89,
   "text": "השלשלת!"
  },
  {
   "start": 340.55,
   "end": 341.39,
   "text": "השלשלת!"
  },
  {
   "start": 343.45,
   "end": 348.81,
   "text": "והנסיך פרדיננד וכל מי שהיה שם חשבו שנטרפה עליו דעתו מהלחץ, מהפחד, מהמוות."
  },
  {
   "start": 351.38,
   "end": 353.68,
   "text": "הנסיך בכל אופן שואל אותו, תגידי, מה אתה מתכוון?"
  },
  {
   "start": 354.56,
   "end": 359.86,
   "text": "ואז אמר לו שר החצר בצורה פשוטה, הגיונית."
  },
  {
   "start": 361.9,
   "end": 363.72,
   "text": "אמר לו שר החצר היהודי, אמר לו, תדע לך,"
  },
  {
   "start": 365.12,
   "end": 365.9,
   "text": "השלשלת."
  },
  {
   "start": 367.04,
   "end": 370.24,
   "text": "אתה רואה שאני לא קשור בשום שלשלת, תחשב על איזה שלשלת אני מדבר,"
  },
  {
   "start": 370.78,
   "end": 375.08,
   "text": "אבל אני מחובר לשלשלת זהב של אלפי שנים,"
  },
  {
   "start": 375.74,
   "end": 379.02,
   "text": "של אברהם, יצחק, יעקב,"
  },
  {
   "start": 379.4,
   "end": 383.08,
   "text": "משה, אהרון, דוד, שלמה,"
  },
  {
   "start": 383.62,
   "end": 385.56,
   "text": "שמואל,"
  },
  {
   "start": 388.26,
   "end": 389.26,
   "text": "רבי עקיבא,"
  },
  {
   "start": 389.96,
   "end": 391.58,
   "text": "רבן יוחנן בן זכאי,"
  },
  {
   "start": 392.18,
   "end": 393.84,
   "text": "אמוראים אבאי רבא,"
  },
  {
   "start": 394.92,
   "end": 398.96,
   "text": "שושלת שלמה של עם ישראל, שושלת זהב."
  },
  {
   "start": 400.68,
   "end": 401.4,
   "text": "ואם אני אתנתק,"
  },
  {
   "start": 403.24,
   "end": 407.36,
   "text": "אני מתנתק מהשלשלת, אני לא יכול, אתה מבין? אני חוליה בשלשלת."
  },
  {
   "start": 408.74,
   "end": 411.32,
   "text": "אני חלק מהשלשלת הזהב של עם ישראל."
  },
  {
   "start": 414.14,
   "end": 415.78,
   "text": "אני לא אדם רגיל, אני יהודי."
  },
  {
   "start": 416.32,
   "end": 420.22,
   "text": "השלשלת, אני חלק משלשלת הזהב של עם ישראל."
  },
  {
   "start": 420.8,
   "end": 421.78,
   "text": "והנשיא פרדיננד"
  },
  {
   "start": 422.62,
   "end": 425.9,
   "text": "בפה פאור עוקב אחרי שר החצר היהודי שלו,"
  },
  {
   "start": 426.8,
   "end": 427.5,
   "text": "הגדול,"
  },
  {
   "start": 428.3,
   "end": 429.56,
   "text": "העצום הזה בעל עוצמה,"
  },
  {
   "start": 432.47,
   "end": 436.61,
   "text": "איך הוא הולך אל המוקד, נכנס ומת,"
  },
  {
   "start": 437.15,
   "end": 438.07,
   "text": "מת על קידוש השם,"
  },
  {
   "start": 439.87,
   "end": 441.01,
   "text": "מת על היהדות שלו,"
  },
  {
   "start": 441.37,
   "end": 444.03,
   "text": "כי הוא מבין שהוא חלק מעם קדוש,"
  },
  {
   "start": 444.35,
   "end": 445.43,
   "text": "חלק מעם נפלא."
  },
  {
   "start": 456.43,
   "end": 457.11,
   "text": "ואנחנו,"
  },
  {
   "start": 458.03,
   "end": 460.07,
   "text": "אנחנו היום שייכים,"
  },
  {
   "start": 460.73,
   "end": 462.79,
   "text": "גם אנחנו, חוליה אחרונה בשלשלת,"
  },
  {
   "start": 464.49,
   "end": 466.87,
   "text": "שהתחילה מאברהם אבינו,"
  },
  {
   "start": 467.91,
   "end": 469.01,
   "text": "המשיכה במשה,"
  },
  {
   "start": 469.55,
   "end": 470.35,
   "text": "ברבי עקיבא,"
  },
  {
   "start": 471.03,
   "end": 472.45,
   "text": "באותו שר חצר יהודי,"
  },
  {
   "start": 473.37,
   "end": 474.25,
   "text": "רבי עמנואל,"
  },
  {
   "start": 475.63,
   "end": 476.75,
   "text": "וממשיכה עד היום."
  },
  {
   "start": 478.29,
   "end": 480.85,
   "text": "ואנחנו החוליה האחרונה בשלשלת כרגע,"
  },
  {
   "start": 481.77,
   "end": 485.43,
   "text": "והשם שלנו חרוט באותיות של קידוש לבנה."
  },
  {
   "start": 486.25,
   "end": 488.03,
   "text": "השם שלך, השם שלך,"
  },
  {
   "start": 488.41,
   "end": 490.51,
   "text": "השם שלי, של כולנו, רשום."
  },
  {
   "start": 497.59,
   "end": 500.15,
   "text": "ושלשלת הזהב שלנו היא שלשלת אמיתית."
  },
  {
   "start": 500.81,
   "end": 503.73,
   "text": "כולה זהב טהור, נצח נצחים."
  },
  {
   "start": 518.1,
   "end": 519.1,
   "text": "בואו בעזרת השם"
  },
  {
   "start": 520.94,
   "end": 521.34,
   "text": "ניגע"
  },
  {
   "start": 522.32,
   "end": 523.9,
   "text": "ניגע בנקודה הפנימית של יהודי."
  },
  {
   "start": 525.38,
   "end": 526.36,
   "text": "בואו בעזרת השם"
  },
  {
   "start": 529.24,
   "end": 533.62,
   "text": "בואו נפליג אל אחד מהמבחנים הקשים ביותר שהיו"
  },
  {
   "start": 535.24,
   "end": 535.84,
   "text": "בשנים האחרונות."
  },
  {
   "start": 538.62,
   "end": 544.0,
   "text": "זה היה באחד ממחנות המוות."
  },
  {
   "start": 546.17,
   "end": 548.29,
   "text": "של הגרמנים במלחמת העולם השנייה."
  },
  {
   "start": 550.05,
   "end": 554.69,
   "text": "זה היה דקות לפני תום המלחמה,"
  },
  {
   "start": 556.59,
   "end": 558.15,
   "text": "לפני כניעתה של גרמניה,"
  },
  {
   "start": 559.37,
   "end": 564.59,
   "text": "כשבאופק אתה שומע את הצבאות המשחררים, צבאות הברית,"
  },
  {
   "start": 565.81,
   "end": 569.29,
   "text": "מתקרבים, ריח של חופש נישא באוויר."
  },
  {
   "start": 570.85,
   "end": 571.45,
   "text": "אבל אז,"
  },
  {
   "start": 580.22,
   "end": 582.72,
   "text": "אז מגיעה שעת המבחן האמיתי."
  },
  {
   "start": 584.02,
   "end": 585.06,
   "text": "לפתע מפקד המחנה,"
  },
  {
   "start": 585.38,
   "end": 590.62,
   "text": "קורא לכל, לכל היהודים החוצה אל מסדר."
  },
  {
   "start": 591.82,
   "end": 595.02,
   "text": "מסדר שאותו לא ישכחו כל ימי חייהם."
  },
  {
   "start": 595.34,
   "end": 596.32,
   "text": "מסדר אחרון."
  },
  {
   "start": 597.26,
   "end": 598.46,
   "text": "וכשכולם נאספים,"
  },
  {
   "start": 598.98,
   "end": 599.94,
   "text": "כשכולם עומדים,"
  },
  {
   "start": 601.14,
   "end": 602.7,
   "text": "הוא לפתע מיישיר מבט,"
  },
  {
   "start": 603.1,
   "end": 603.92,
   "text": "מיישיר מבט"
  },
  {
   "start": 605.1,
   "end": 607.0,
   "text": "אל אחד מהיהודים המיוחדים שהיו שם."
  },
  {
   "start": 607.94,
   "end": 609.2,
   "text": "זה היה רב של אחת הקהילות"
  },
  {
   "start": 611.28,
   "end": 614.52,
   "text": "ששרד כל השנים האלה במחנות."
  },
  {
   "start": 615.72,
   "end": 619.28,
   "text": "שהצליח לשמור על היהדות שלו בדרך לא בדרך,"
  },
  {
   "start": 620.02,
   "end": 622.26,
   "text": "שעשה את כל המצים מאסר נפש."
  },
  {
   "start": 624.06,
   "end": 632.95,
   "text": "והגרמני הזה ידע שזוהי מלחמה לא בין גרמניה רק ליהודים,"
  },
  {
   "start": 633.85,
   "end": 635.71,
   "text": "מלחמה בין אור לחושך."
  },
  {
   "start": 638.62,
   "end": 640.02,
   "text": "וכשהחושך החל לשקוע,"
  },
  {
   "start": 640.6,
   "end": 642.56,
   "text": "הוא מנסה בכוחות האחרונים שלו,"
  },
  {
   "start": 643.1,
   "end": 647.86,
   "text": "לנתק את השרשרת הזאת, את הרצף הזה של יהודי מאבותיו."
  },
  {
   "start": 649.28,
   "end": 650.7,
   "text": "משורשיו מאבא שבשמיים."
  },
  {
   "start": 651.4,
   "end": 653.32,
   "text": "הוא פנה אל היהודי הזה ואמר לו, תשי, תקשיב,"
  },
  {
   "start": 654.14,
   "end": 654.42,
   "text": "יהודי,"
  },
  {
   "start": 655.84,
   "end": 657.54,
   "text": "אני מכיר אותך, שמתי לב אליך."
  },
  {
   "start": 658.74,
   "end": 659.56,
   "text": "שנים אתה במחנות."
  },
  {
   "start": 660.54,
   "end": 664.52,
   "text": "שרדת והצלחת להחזיק מעמד. ראיתי איך שמרת על היהדות שלך."
  },
  {
   "start": 665.46,
   "end": 668.02,
   "text": "איך לא אכלת מהמאכלות שלנו."
  },
  {
   "start": 670.32,
   "end": 672.68,
   "text": "וידעתי דבר אחד ואני יודע דבר אחד, מה החזיק אותך?"
  },
  {
   "start": 673.46,
   "end": 675.04,
   "text": "מה אתה נתן לך את הכוח לשרוד?"
  },
  {
   "start": 675.5,
   "end": 676.24,
   "text": "הידיעה הזאת,"
  },
  {
   "start": 676.96,
   "end": 678.5,
   "text": "שיום אחד, אולי היום הזה יגיע."
  },
  {
   "start": 678.92,
   "end": 688.86,
   "text": "יום השחרור, יום החופש, שאז תצא אל העולם החופשי ותדע שלא עזבת את הקדוש ברוך הוא, שהצלחת לשמור"
  },
  {
   "start": 690.52,
   "end": 695.02,
   "text": "על הדרך של אבותיך, שהצלחת לשמור על הדרך של אבותיך."
  },
  {
   "start": 698.91,
   "end": 700.29,
   "text": "לכן אני פונה אליך עכשיו."
  },
  {
   "start": 701.53,
   "end": 702.97,
   "text": "עכשיו זו שעת המבחן האמיתית."
  },
  {
   "start": 703.99,
   "end": 704.15,
   "text": "הנה."
  },
  {
   "start": 705.69,
   "end": 707.65,
   "text": "כבר מרחוק אתה שומע את הצבאות המשחררים."
  },
  {
   "start": 708.81,
   "end": 709.89,
   "text": "הם קרבים לכאן."
  },
  {
   "start": 710.41,
   "end": 712.49,
   "text": "בעוד אולי שעה, אולי פחות, הם יגיעו לכאן,"
  },
  {
   "start": 713.17,
   "end": 714.17,
   "text": "ואתה תהיה חופשי."
  },
  {
   "start": 715.09,
   "end": 715.53,
   "text": "אז עכשיו,"
  },
  {
   "start": 716.49,
   "end": 717.53,
   "text": "עכשיו אני פונה אליך,"
  },
  {
   "start": 718.47,
   "end": 725.04,
   "text": "והגרמני האכזרי הזה, הוציא בשר טמא,"
  },
  {
   "start": 727.42,
   "end": 727.86,
   "text": "הערים אותו,"
  },
  {
   "start": 729.42,
   "end": 731.62,
   "text": "ופנה אל היהודי ואמר לו, עכשיו,"
  },
  {
   "start": 732.54,
   "end": 733.4,
   "text": "או שאתה אוכל"
  },
  {
   "start": 735.04,
   "end": 736.26,
   "text": "את הבשר הטמא הזה,"
  },
  {
   "start": 739.11,
   "end": 744.55,
   "text": "או שמספר דקות לפני השחרור, לפני מה שחלמת עליו, מה שחיכית לו,"
  },
  {
   "start": 746.72,
   "end": 754.31,
   "text": "ואז הוא שלף מתכת מבהיקה הבהיקה לנוכח פני היהודי."
  },
  {
   "start": 756.15,
   "end": 757.15,
   "text": "או שאני יורד בך למוות."
  },
  {
   "start": 760.75,
   "end": 764.73,
   "text": "והיהודי ניצל את הדממה."
  },
  {
   "start": 765.69,
   "end": 767.77,
   "text": "ההדממה מהקפיאת אדם שהסתרה מסביב."
  },
  {
   "start": 770.05,
   "end": 777.44,
   "text": "והשאיר מבט נחוש אל הגרמני. איזו שעת מבחן. איזה קושי."
  },
  {
   "start": 779.1,
   "end": 782.0,
   "text": "שאני מוחקה לרדת הזה."
  },
  {
   "start": 784.07,
   "end": 795.16,
   "text": "ועכשיו הוא הולך למסור את היקר לו. היהודי השאיר את מבטו."
  },
  {
   "start": 797.51,
   "end": 799.49,
   "text": "היהודי פנה אל הגרמני ואמר לו,"
  },
  {
   "start": 800.19,
   "end": 800.55,
   "text": "תדע לך,"
  },
  {
   "start": 801.43,
   "end": 802.07,
   "text": "אני יהודי"
  },
  {
   "start": 802.87,
   "end": 803.93,
   "text": "ואשאר יהודי,"
  },
  {
   "start": 805.45,
   "end": 808.67,
   "text": "ולא אוכל בשר טמא."
  },
  {
   "start": 809.25,
   "end": 809.81,
   "text": "בא גרמני,"
  },
  {
   "start": 810.71,
   "end": 811.53,
   "text": "פן אבי רציני,"
  },
  {
   "start": 812.39,
   "end": 813.31,
   "text": "מבט חמור סבל."
  },
  {
   "start": 814.55,
   "end": 815.69,
   "text": "הוא אומר לו, אני אהרוג אותך."
  },
  {
   "start": 816.57,
   "end": 817.35,
   "text": "והיהודי הזה,"
  },
  {
   "start": 818.21,
   "end": 819.17,
   "text": "היהודי הגדול הזה,"
  },
  {
   "start": 819.75,
   "end": 821.35,
   "text": "היהודי הקדוש והטהור הזה,"
  },
  {
   "start": 822.13,
   "end": 824.81,
   "text": "לא זז כהוא זה מהדרך,"
  },
  {
   "start": 825.09,
   "end": 828.81,
   "text": "מהדרך, מהמשעול המופלא הזה בו צעדו אבותיו."
  },
  {
   "start": 830.29,
   "end": 832.63,
   "text": "והגרמני מרים את האקדח,"
  },
  {
   "start": 836.18,
   "end": 839.18,
   "text": "וירייה פילחה את חלל האוויר."
  },
  {
   "start": 847.23,
   "end": 847.95,
   "text": "היהודי צנח,"
  },
  {
   "start": 859.58,
   "end": 860.5,
   "text": "והגרמני,"
  },
  {
   "start": 861.08,
   "end": 861.82,
   "text": "אדום כולו,"
  },
  {
   "start": 862.68,
   "end": 863.66,
   "text": "מבושה,"
  },
  {
   "start": 865.72,
   "end": 869.52,
   "text": "יודע שהפסיד את המערכה, את המערכה האמיתית, המערכה הנצרית."
  },
  {
   "start": 870.54,
   "end": 871.18,
   "text": "פנה במהירות,"
  },
  {
   "start": 873.92,
   "end": 875.4,
   "text": "כמעט רץ,"
  },
  {
   "start": 876.36,
   "end": 876.82,
   "text": "בורח,"
  },
  {
   "start": 879.93,
   "end": 880.53,
   "text": "ממש בורח,"
  },
  {
   "start": 881.05,
   "end": 894.08,
   "text": "הצריף שלו דקות ספורות"
  },
  {
   "start": 895.38,
   "end": 896.16,
   "text": "לפני השחרור"
  },
  {
   "start": 898.72,
   "end": 899.74,
   "text": "מגלה יהודי"
  },
  {
   "start": 904.29,
   "end": 904.99,
   "text": "שהוא מוכן"
  },
  {
   "start": 906.63,
   "end": 909.39,
   "text": "למסור גם את החופש שלו, גם את הכל,"
  },
  {
   "start": 911.05,
   "end": 912.59,
   "text": "עבור היקר באמת מכל,"
  },
  {
   "start": 913.85,
   "end": 914.69,
   "text": "שרשרת הנצח."
  },
  {
   "start": 915.87,
   "end": 916.85,
   "text": "עוד יהודי יצטרף,"
  },
  {
   "start": 917.85,
   "end": 920.39,
   "text": "עוד יהודי שומר על החוליה הזו."
  },
  {
   "start": 925.09,
   "end": 929.53,
   "text": "ואם מישהו חושב שהוא יפסיד אולי,"
  },
  {
   "start": 931.65,
   "end": 934.21,
   "text": "אז בואו נעבור לחלק השני,"
  },
  {
   "start": 934.25,
   "end": 936.21,
   "text": "של הסיפור הזה,"
  },
  {
   "start": 937.27,
   "end": 942.31,
   "text": "של הסיפור שאינו נקבע וכפי הנראה לא ייגמר."
  },
  {
   "start": 953.7,
   "end": 954.86,
   "text": "שנים אחר כך,"
  },
  {
   "start": 955.76,
   "end": 956.72,
   "text": "בארץ ישראל,"
  },
  {
   "start": 957.96,
   "end": 959.54,
   "text": "בלב עיר גדולה בגוש דן,"
  },
  {
   "start": 960.24,
   "end": 962.14,
   "text": "חוזרנה לחברה מצליח הפיתה."
  },
  {
   "start": 965.04,
   "end": 966.52,
   "text": "הוא מצפה לארוחת צהריים,"
  },
  {
   "start": 971.17,
   "end": 977.04,
   "text": "אבל אז הוא מגלה להפתעתו שאשתו לא הצליחה להכין ארוחת צהריים,"
  },
  {
   "start": 977.72,
   "end": 979.12,
   "text": "והיא פונה אליו ומבקשת ממנו."
  },
  {
   "start": 980.4,
   "end": 982.06,
   "text": "אני הייתי כל כך בלחץ כל היום,"
  },
  {
   "start": 983.3,
   "end": 983.76,
   "text": "רד למטה,"
  },
  {
   "start": 984.34,
   "end": 985.76,
   "text": "אל המסעדה שם ממול,"
  },
  {
   "start": 986.52,
   "end": 987.14,
   "text": "ותקנה,"
  },
  {
   "start": 988.18,
   "end": 989.58,
   "text": "תקנה לך ולי אוכל."
  },
  {
   "start": 990.74,
   "end": 991.54,
   "text": "גם אני עוד לא אכלתי."
  },
  {
   "start": 994.28,
   "end": 995.6,
   "text": "והוא יורד למסעדה הקרובה,"
  },
  {
   "start": 996.54,
   "end": 999.28,
   "text": "נכנס וממתין בתור."
  },
  {
   "start": 1010.06,
   "end": 1013.88,
   "text": "הוא לא יכול להסביר מה עורר אותו לזה, מה קרה."
  },
  {
   "start": 1019.81,
   "end": 1020.09,
   "text": "כך,"
  },
  {
   "start": 1022.34,
   "end": 1022.94,
   "text": "באמצע,"
  },
  {
   "start": 1023.94,
   "end": 1024.94,
   "text": "באמצע המסעדה,"
  },
  {
   "start": 1027.26,
   "end": 1028.14,
   "text": "אותו מנהל חברה,"
  },
  {
   "start": 1029.82,
   "end": 1032.48,
   "text": "שנראה ששום דבר לא יכול להסעיר אותו, להטריד אותו."
  },
  {
   "start": 1037.86,
   "end": 1040.92,
   "text": "לפתע עולות בו כל מיני תמונות מן העבר,"
  },
  {
   "start": 1043.68,
   "end": 1046.94,
   "text": "זיכרונות עמומים שלאט-לאט"
  },
  {
   "start": 1047.74,
   "end": 1050.18,
   "text": "נהפכים לברורים ובהירים יותר."
  },
  {
   "start": 1054.82,
   "end": 1055.5,
   "text": "הוא נזכר"
  },
  {
   "start": 1059.14,
   "end": 1063.1,
   "text": "בשנות ילדותו איך כשהוא היה ילד קטן,"
  },
  {
   "start": 1065.9,
   "end": 1066.52,
   "text": "אימא שלו,"
  },
  {
   "start": 1067.8,
   "end": 1072.22,
   "text": "אימא שלו הייתה נוהגת לפני השינה לספר לו,"
  },
  {
   "start": 1073.78,
   "end": 1074.5,
   "text": "לספר לו"
  },
  {
   "start": 1075.42,
   "end": 1076.18,
   "text": "על סבא,"
  },
  {
   "start": 1077.02,
   "end": 1078.26,
   "text": "על הסבא הגדול שלו."
  },
  {
   "start": 1082.46,
   "end": 1085.64,
   "text": "והוא זכר איך אמא סיפרה, הוא זכר איך אמא סיפרה על סבא,"
  },
  {
   "start": 1086.8,
   "end": 1088.02,
   "text": "איך סבא שלו עמד,"
  },
  {
   "start": 1092.53,
   "end": 1094.11,
   "text": "שרד כל השואה האיומה,"
  },
  {
   "start": 1097.1,
   "end": 1102.73,
   "text": "ושעה קלה לפני השחרור הוא עומד מול גרמני,"
  },
  {
   "start": 1104.37,
   "end": 1105.53,
   "text": "מול סמל החושך,"
  },
  {
   "start": 1109.51,
   "end": 1111.05,
   "text": "והגרמני דורש ממנו"
  },
  {
   "start": 1112.87,
   "end": 1113.15,
   "text": "בוא,"
  },
  {
   "start": 1114.55,
   "end": 1116.09,
   "text": "בוא תאכל בשר טמא,"
  },
  {
   "start": 1116.77,
   "end": 1118.93,
   "text": "בוא תוותר על עקרונות היהדות שלך."
  },
  {
   "start": 1122.75,
   "end": 1126.15,
   "text": "הסבא הגדול שלו לא זז כהוא זה."
  },
  {
   "start": 1126.85,
   "end": 1129.35,
   "text": "הוא כולו עם הקדוש ברוך הוא."
  },
  {
   "start": 1129.99,
   "end": 1133.03,
   "text": "הוא כולו ממשיך את דרך אבותיו."
  },
  {
   "start": 1134.15,
   "end": 1135.75,
   "text": "הוא חלק מהשרשרת."
  },
  {
   "start": 1138.28,
   "end": 1140.9,
   "text": "והגרמני מרים את האקדח"
  },
  {
   "start": 1141.68,
   "end": 1143.44,
   "text": "והורג את הסבא שלו."
  },
  {
   "start": 1147.16,
   "end": 1148.8,
   "text": "והוא נזכר איך כילד,"
  },
  {
   "start": 1149.56,
   "end": 1152.44,
   "text": "כל פעם שהוא היה שומע את הסיפור הוא היה בוכה."
  },
  {
   "start": 1153.44,
   "end": 1157.16,
   "text": "הוא היה מתרגש מחדש, הוא היה אומר, אמא, תספרי לי עוד פעם."
  },
  {
   "start": 1158.82,
   "end": 1160.52,
   "text": "הוא כל כך היה גאה בסבא שלו,"
  },
  {
   "start": 1161.14,
   "end": 1163.38,
   "text": "הוא כל כך רצה להיות כמו הסבא."
  },
  {
   "start": 1166.93,
   "end": 1167.49,
   "text": "אבא שלי,"
  },
  {
   "start": 1169.29,
   "end": 1169.99,
   "text": "סבא שלי,"
  },
  {
   "start": 1171.57,
   "end": 1176.49,
   "text": "מת שם על קידוש השם כדי לא לאכול בשר טמא."
  },
  {
   "start": 1181.84,
   "end": 1185.92,
   "text": "סבא שלי מת שם על קידוש השם כדי לא לאכול בשר טמא, ואני,"
  },
  {
   "start": 1186.7,
   "end": 1189.22,
   "text": "ואני עומד פה במסעדה, פה ממתין,"
  },
  {
   "start": 1190.16,
   "end": 1193.1,
   "text": "והרי זו מסעדה שמוכרת בשר טמא."
  },
  {
   "start": 1194.28,
   "end": 1195.9,
   "text": "אני הולך לשלם על זה עוד."
  },
  {
   "start": 1197.1,
   "end": 1206.19,
   "text": "אני מרצון עומד פה להתחבר אל סבא,"
  },
  {
   "start": 1206.67,
   "end": 1208.43,
   "text": "אל שרשרת הזהב עלו וגאו בו."
  },
  {
   "start": 1209.37,
   "end": 1211.71,
   "text": "ולפתע הוא יצא מהתור."
  },
  {
   "start": 1212.65,
   "end": 1214.69,
   "text": "כך, סתם בצהרי היום,"
  },
  {
   "start": 1215.97,
   "end": 1217.05,
   "text": "אדם שקול והגיוני"
  },
  {
   "start": 1217.69,
   "end": 1219.11,
   "text": "קם ואומר אני יהודי,"
  },
  {
   "start": 1221.74,
   "end": 1224.64,
   "text": "ויהודי לא אוכל בשר טמא."
  },
  {
   "start": 1225.46,
   "end": 1227.24,
   "text": "סבא שלי מת על זה."
  },
  {
   "start": 1228.8,
   "end": 1232.1,
   "text": "ואני אתחבר לסבא, אתחבר לעם ישראל."
  },
  {
   "start": 1232.82,
   "end": 1234.2,
   "text": "אני חוזר אל השרשרת."
  },
  {
   "start": 1234.98,
   "end": 1240.42,
   "text": "החוליה שלי לא תתנתק מעם ישראל, כך הלב שלו אמר."
  },
  {
   "start": 1241.74,
   "end": 1243.46,
   "text": "הוא יצא החוצה מהמסעדה."
  },
  {
   "start": 1244.38,
   "end": 1246.04,
   "text": "הוא לא חזר יותר אל המסעדה."
  },
  {
   "start": 1246.98,
   "end": 1247.72,
   "text": "ולא רק זה,"
  },
  {
   "start": 1249.24,
   "end": 1250.8,
   "text": "אלא הוא לא חזר יותר אחורה,"
  },
  {
   "start": 1251.62,
   "end": 1252.74,
   "text": "מאז הוא התקדם קדימה."
  },
  {
   "start": 1253.76,
   "end": 1254.42,
   "text": "אותו נכד,"
  },
  {
   "start": 1255.14,
   "end": 1259.58,
   "text": "של אותו סבא מופלא חזר אל אבא שבשמיים,"
  },
  {
   "start": 1260.2,
   "end": 1261.24,
   "text": "חזר בתשובה שלמה,"
  },
  {
   "start": 1262.14,
   "end": 1264.26,
   "text": "הוא ורעייתו וכל משפחתו."
  },
  {
   "start": 1265.78,
   "end": 1266.46,
   "text": "ולא רק זה,"
  },
  {
   "start": 1267.76,
   "end": 1272.84,
   "text": "הוא הלך והקים את אחד מארגוני התשובה הגדולים בארץ."
  },
  {
   "start": 1273.84,
   "end": 1279.16,
   "text": "הוא היה עד היום אחד מהמנופים הגדולים של תנועת התשובה בארץ."
  },
  {
   "start": 1282.71,
   "end": 1285.89,
   "text": "הסבא שם לא מת."
  },
  {
   "start": 1286.87,
   "end": 1288.07,
   "text": "הסבא חי לנצח."
  },
  {
   "start": 1289.83,
   "end": 1293.19,
   "text": "אם הסבא היה נשאר בחיים, היה מוותר על העיקרון שלו."
  },
  {
   "start": 1293.67,
   "end": 1296.41,
   "text": "היה לו מתחבר לשרשרת הזהב בכל מחיר."
  },
  {
   "start": 1296.95,
   "end": 1299.45,
   "text": "לא יודע היכן הנכד שלו היה היום."
  },
  {
   "start": 1300.67,
   "end": 1302.45,
   "text": "הסבא נראה לכאורה מת."
  },
  {
   "start": 1303.05,
   "end": 1307.93,
   "text": "לא הסבא התחבר לשרשרת הזהב וחיבר באבותות של אהבה,"
  },
  {
   "start": 1308.45,
   "end": 1312.61,
   "text": "באבותות של אמונה, את הנכד ואת הנין ואת הבנים"
  },
  {
   "start": 1312.61,
   "end": 1319.33,
   "text": "של הנינים ואת העם ישראל אל השרשרת השרשרת השרשרת"
  },
  {
   "start": 1321.64,
   "end": 1325.1,
   "text": "שרשרת של אמונה שרשרת סרוקה בשושנים"
  }
 ]
}