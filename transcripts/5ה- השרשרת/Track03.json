{
 "disc": "5ה- השרשרת",
 "track": "Track03",
 "duration": 1421.184,
 "segments": [
  {
   "start": 1.56,
   "end": 2.48,
   "text": "בואו, בעזרת השם,"
  },
  {
   "start": 3.32,
   "end": 4.0,
   "text": "לכמה דקות."
  },
  {
   "start": 8.2,
   "end": 10.16,
   "text": "בואו לכמה דקות נצא מהמציאות שלנו."
  },
  {
   "start": 11.12,
   "end": 11.74,
   "text": "בואו נתחזק"
  },
  {
   "start": 12.44,
   "end": 17.84,
   "text": "מילדה בת 11. שכל העולם שלה יתרסק לנגד עיניה,"
  },
  {
   "start": 19.48,
   "end": 21.82,
   "text": "ונתנו לה את האפשרות לקנות לה את העולם הזה,"
  },
  {
   "start": 22.54,
   "end": 24.82,
   "text": "לאפשר לה חיים טובים יותר, שקטים יותר."
  },
  {
   "start": 26.9,
   "end": 28.42,
   "text": "ורק דבר אחד דרשו ממנה,"
  },
  {
   "start": 29.8,
   "end": 31.04,
   "text": "להתנתק מהשרשרת,"
  },
  {
   "start": 32.62,
   "end": 34.02,
   "text": "להתנתק מהשלשלת."
  },
  {
   "start": 36.59,
   "end": 37.05,
   "text": "זה היה בחורף"
  },
  {
   "start": 38.19,
   "end": 38.99,
   "text": "שנת תשד,"
  },
  {
   "start": 40.41,
   "end": 42.05,
   "text": "ילדה בשם פרלה אדלשטיין,"
  },
  {
   "start": 43.87,
   "end": 49.9,
   "text": "שוכבת לה בכפר נוצרי בפולין,"
  },
  {
   "start": 50.64,
   "end": 51.8,
   "text": "מתהפכת במיטתה."
  },
  {
   "start": 53.42,
   "end": 55.78,
   "text": "בעלי הבית שנתנו לה מחסה ישנו בשלווה,"
  },
  {
   "start": 56.64,
   "end": 57.26,
   "text": "אפילו לה היא בשמחה,"
  },
  {
   "start": 58.04,
   "end": 63.4,
   "text": "ומחר יהיה טקס ההטבלה של היהודייה הקטנה שתיקרא מעכשיו,"
  },
  {
   "start": 64.12,
   "end": 66.26,
   "text": "ממחר, פרנצ'יסקה מרינובסקה,"
  },
  {
   "start": 67.26,
   "end": 68.38,
   "text": "נוצרייה קתולית."
  },
  {
   "start": 70.46,
   "end": 71.56,
   "text": "הם היו רגועים שלווים,"
  },
  {
   "start": 73.02,
   "end": 73.74,
   "text": "אבל פרלה,"
  },
  {
   "start": 74.94,
   "end": 75.78,
   "text": "פרלה שכבה."
  },
  {
   "start": 77.2,
   "end": 78.6,
   "text": "שכבה ככה מביטה בלילה,"
  },
  {
   "start": 79.44,
   "end": 80.62,
   "text": "בלילה עטור הכוכבים,"
  },
  {
   "start": 81.4,
   "end": 82.54,
   "text": "ולפתע הכוכבים נראו לה"
  },
  {
   "start": 83.92,
   "end": 85.7,
   "text": "כמו הפנים של אבא,"
  },
  {
   "start": 86.34,
   "end": 86.8,
   "text": "של אמא,"
  },
  {
   "start": 87.64,
   "end": 88.24,
   "text": "אבא ואמא,"
  },
  {
   "start": 89.38,
   "end": 90.94,
   "text": "שנרצחו בידי הנאצים,"
  },
  {
   "start": 92.16,
   "end": 95.84,
   "text": "שמתוך שבעת ילדיהם נותרה לה רק פרלה."
  },
  {
   "start": 99.17,
   "end": 100.09,
   "text": "וכך היא נרדמה לה."
  },
  {
   "start": 102.47,
   "end": 102.87,
   "text": "ואז,"
  },
  {
   "start": 103.83,
   "end": 104.61,
   "text": "אז שהיא נרדמה,"
  },
  {
   "start": 106.84,
   "end": 107.52,
   "text": "היא רואה אותו."
  },
  {
   "start": 108.96,
   "end": 109.5,
   "text": "היא רואה אותו"
  },
  {
   "start": 110.42,
   "end": 111.5,
   "text": "מבין הערפילים,"
  },
  {
   "start": 112.58,
   "end": 113.2,
   "text": "את אבא שלה."
  },
  {
   "start": 114.62,
   "end": 114.92,
   "text": "אבא?"
  },
  {
   "start": 116.66,
   "end": 117.06,
   "text": "אבא."
  },
  {
   "start": 118.3,
   "end": 120.0,
   "text": "חולצתו הייתה ספוגה בדם."
  },
  {
   "start": 122.06,
   "end": 122.8,
   "text": "מצעד המוות"
  },
  {
   "start": 124.62,
   "end": 131.5,
   "text": "שהוא השתתף בו נתן את אותותיו בפניו,"
  },
  {
   "start": 134.3,
   "end": 135.86,
   "text": "והחולצה שהייתה ספוגה בדם"
  },
  {
   "start": 137.1,
   "end": 138.3,
   "text": "מאותם פצעי מוות"
  },
  {
   "start": 139.0,
   "end": 141.92,
   "text": "שהוא נפגע כשירו בו למוות."
  },
  {
   "start": 143.2,
   "end": 145.42,
   "text": "עדיין אותה חולצה הייתה עליו."
  },
  {
   "start": 146.7,
   "end": 148.84,
   "text": "אבא בא, בא אל הבת שלו האהובה."
  },
  {
   "start": 149.8,
   "end": 150.38,
   "text": "היחידה,"
  },
  {
   "start": 150.96,
   "end": 153.2,
   "text": "היחידה שנשארה מהמשפחה."
  },
  {
   "start": 156.48,
   "end": 158.24,
   "text": "ואבא לא אמר דבר."
  },
  {
   "start": 159.9,
   "end": 161.6,
   "text": "הוא רק ליטף אותה ברוך."
  },
  {
   "start": 162.62,
   "end": 164.22,
   "text": "הוא רק ליטף אותה בחום."
  },
  {
   "start": 164.76,
   "end": 166.0,
   "text": "עטף אותה באהבה."
  },
  {
   "start": 170.31,
   "end": 170.81,
   "text": "אחר כך"
  },
  {
   "start": 171.79,
   "end": 172.43,
   "text": "הוא אמר,"
  },
  {
   "start": 173.19,
   "end": 173.81,
   "text": "אמר משפט."
  },
  {
   "start": 175.25,
   "end": 175.83,
   "text": "ילדתי,"
  },
  {
   "start": 177.05,
   "end": 178.39,
   "text": "ילדתי, ביקשתי ממך"
  },
  {
   "start": 178.97,
   "end": 181.11,
   "text": "שלא תשכחי שאת יהודייה."
  },
  {
   "start": 183.27,
   "end": 183.81,
   "text": "את יודעת,"
  },
  {
   "start": 184.45,
   "end": 185.77,
   "text": "הם הרגו את כולנו."
  },
  {
   "start": 186.71,
   "end": 190.33,
   "text": "את היחידה מכל המשפחה שנשארת."
  },
  {
   "start": 191.23,
   "end": 194.79,
   "text": "את היחידה מכל המשפחה, הם הרגו את כולנו."
  },
  {
   "start": 199.07,
   "end": 200.37,
   "text": "פרלה פרצה בבכי."
  },
  {
   "start": 201.23,
   "end": 201.53,
   "text": "אבא,"
  },
  {
   "start": 202.23,
   "end": 204.61,
   "text": "אבא לעולם, אבל לעולם אני לא אתנצר, אבא."
  },
  {
   "start": 205.45,
   "end": 207.75,
   "text": "אבא, אני מבטיחה, אני לא אשכח שאני יהודייה."
  },
  {
   "start": 226.58,
   "end": 227.54,
   "text": "לפנות בוקר"
  },
  {
   "start": 229.04,
   "end": 231.48,
   "text": "קפצה מן החלון דמות קטנה ושברית"
  },
  {
   "start": 232.68,
   "end": 233.4,
   "text": "של ילדה."
  },
  {
   "start": 235.3,
   "end": 238.4,
   "text": "ילדה קטנה שנחושה להישאר יהודייה."
  },
  {
   "start": 240.0,
   "end": 242.42,
   "text": "ילדה קטנה שנחושה להיות חלק."
  },
  {
   "start": 243.62,
   "end": 244.72,
   "text": "חוליה מן השלשלת."
  },
  {
   "start": 251.55,
   "end": 254.49,
   "text": "ילדה קטנה בת 11. מול כל העולם."
  },
  {
   "start": 255.45,
   "end": 256.71,
   "text": "כנגד כל סיכוי,"
  },
  {
   "start": 257.37,
   "end": 257.49,
   "text": "רצה,"
  },
  {
   "start": 258.49,
   "end": 259.37,
   "text": "רצה על היהדות שלה."
  },
  {
   "start": 261.98,
   "end": 265.28,
   "text": "פרלה אדלשטיין שהטה ביערות זמן מה,"
  },
  {
   "start": 265.94,
   "end": 267.02,
   "text": "אוכלת שורשים,"
  },
  {
   "start": 267.88,
   "end": 269.32,
   "text": "ניזונה מעלים ממה שיש."
  },
  {
   "start": 274.55,
   "end": 278.55,
   "text": "וכששעטו צריעות רוסיה ושטפו את פולין,"
  },
  {
   "start": 279.41,
   "end": 279.77,
   "text": "לפתע,"
  },
  {
   "start": 280.31,
   "end": 283.47,
   "text": "באמצע הכביש, עמדה לה דמות קטנה,"
  },
  {
   "start": 284.21,
   "end": 289.19,
   "text": "עטופה במעיל בלוי וקרוע מול גדודי הטנקים,"
  },
  {
   "start": 294.0,
   "end": 295.14,
   "text": "והם אספו אותה."
  },
  {
   "start": 296.24,
   "end": 297.28,
   "text": "פרלה ניצחה."
  },
  {
   "start": 298.36,
   "end": 300.34,
   "text": "פרלה אדלשטיין ניצולה."
  },
  {
   "start": 301.1,
   "end": 302.66,
   "text": "שמרה על היהדות שלה."
  },
  {
   "start": 306.32,
   "end": 310.56,
   "text": "פרלה אדלשטיין היא חלק מהשרשרת המופלאה הזאת"
  },
  {
   "start": 311.2,
   "end": 312.32,
   "text": "של עם ישראל."
  },
  {
   "start": 328.6,
   "end": 329.02,
   "text": "הם הגיעו"
  },
  {
   "start": 330.06,
   "end": 330.9,
   "text": "בבוקר יום אחד."
  },
  {
   "start": 332.18,
   "end": 334.16,
   "text": "שני זרים מסתובבים ממקום למקום."
  },
  {
   "start": 336.34,
   "end": 336.86,
   "text": "מאוחר יותר,"
  },
  {
   "start": 338.7,
   "end": 339.9,
   "text": "בעקבות השניים האלה,"
  },
  {
   "start": 340.8,
   "end": 341.8,
   "text": "באו קבוצת חיילים,"
  },
  {
   "start": 343.22,
   "end": 351.66,
   "text": "זו התקופה של הצאר ניקולאי שנתן את הפקודה האיומה הזאת לחטוף ילדים קטנים לצבא הרוסי."
  },
  {
   "start": 352.64,
   "end": 357.58,
   "text": "בגיל 7-10 נחטפים ילדים שנים שנים"
  },
  {
   "start": 358.5,
   "end": 359.1,
   "text": "לצבא הרוסי."
  },
  {
   "start": 359.76,
   "end": 360.86,
   "text": "אבל לפני אותם שנים"
  },
  {
   "start": 361.64,
   "end": 364.24,
   "text": "שהם אמורים לשרת בצבא הרוסי, הם עוברים תהליך מכאיב."
  },
  {
   "start": 364.82,
   "end": 368.28,
   "text": "עושים את כל המאמצים כדי פשוט להפוך אותם"
  },
  {
   "start": 369.1,
   "end": 370.04,
   "text": "לגויים מן השורה."
  },
  {
   "start": 370.96,
   "end": 372.9,
   "text": "וכשהחיילים הגיעו,"
  },
  {
   "start": 379.47,
   "end": 379.79,
   "text": "אז אמא,"
  },
  {
   "start": 380.39,
   "end": 381.97,
   "text": "אמא החביאה את דוד,"
  },
  {
   "start": 382.81,
   "end": 383.71,
   "text": "בנה היתום."
  },
  {
   "start": 385.89,
   "end": 387.29,
   "text": "זה הבן היחיד שנשאר לה."
  },
  {
   "start": 388.97,
   "end": 389.43,
   "text": "בעלה מת"
  },
  {
   "start": 391.43,
   "end": 392.29,
   "text": "והשאיר לה את דוד,"
  },
  {
   "start": 392.95,
   "end": 393.89,
   "text": "והיא חייבת לשמור עליו."
  },
  {
   "start": 395.07,
   "end": 395.79,
   "text": "היא מחביאה אותו,"
  },
  {
   "start": 396.83,
   "end": 399.77,
   "text": "אבל שינו את מספר אחר כך החוטפים פורצים פנימה."
  },
  {
   "start": 400.97,
   "end": 401.71,
   "text": "נשמעים קולות מאבק,"
  },
  {
   "start": 402.89,
   "end": 404.85,
   "text": "ודוד, שהיה כל כך קשור לאמא,"
  },
  {
   "start": 405.85,
   "end": 407.69,
   "text": "יצא בהיסטריה מהמקום שלו, אמא,"
  },
  {
   "start": 408.35,
   "end": 408.63,
   "text": "אמא."
  },
  {
   "start": 410.09,
   "end": 410.51,
   "text": "אבל אמא,"
  },
  {
   "start": 411.45,
   "end": 412.39,
   "text": "אמא הייתה שכובה,"
  },
  {
   "start": 413.05,
   "end": 413.75,
   "text": "ללא הכרה."
  },
  {
   "start": 414.73,
   "end": 420.17,
   "text": "היא נלחמה כמו לביאה פצועה על מנת לא לתת לחוטפים לקחת את הבן שלה,"
  },
  {
   "start": 420.73,
   "end": 421.41,
   "text": "את דוד שלה."
  },
  {
   "start": 422.65,
   "end": 423.29,
   "text": "אבל זה לא עזר."
  },
  {
   "start": 424.35,
   "end": 425.51,
   "text": "הוא יצא ממקום מחבואו"
  },
  {
   "start": 426.37,
   "end": 427.55,
   "text": "ולמעשה נתפס."
  },
  {
   "start": 429.39,
   "end": 430.93,
   "text": "וכך הוא מובל לקרון מעצר."
  },
  {
   "start": 434.17,
   "end": 439.35,
   "text": "בדרך מלוות אותו כל אותן זעקות ויללות ההורים שהילדים שלהם נלקחו מאיתם."
  },
  {
   "start": 441.45,
   "end": 443.17,
   "text": "והוא מוכנס לקרון מעצר עם עוד כמה,"
  },
  {
   "start": 444.45,
   "end": 445.63,
   "text": "עשרות ילדים כמותו,"
  },
  {
   "start": 446.97,
   "end": 448.55,
   "text": "כולם בוכים, כולם צורחים,"
  },
  {
   "start": 449.53,
   "end": 451.71,
   "text": "וזעקת האמהות והאבות"
  },
  {
   "start": 452.61,
   "end": 454.03,
   "text": "מגיעה עד לב השמיים."
  },
  {
   "start": 456.05,
   "end": 459.73,
   "text": "לפתע דוד רואה מבעד להמון את דמותה של אימא,"
  },
  {
   "start": 461.35,
   "end": 462.47,
   "text": "עדיין עם כתמי הדם,"
  },
  {
   "start": 463.43,
   "end": 464.51,
   "text": "עד עם המבט השבור,"
  },
  {
   "start": 465.31,
   "end": 465.83,
   "text": "מביטה בו,"
  },
  {
   "start": 466.53,
   "end": 467.67,
   "text": "מנופפת לו לשלום,"
  },
  {
   "start": 468.47,
   "end": 470.13,
   "text": "פותחת את כף ידה לשלום,"
  },
  {
   "start": 470.99,
   "end": 473.53,
   "text": "אבל אז כף ידה לפתעם"
  },
  {
   "start": 474.95,
   "end": 475.53,
   "text": "נהפכת לאגרוף,"
  },
  {
   "start": 477.23,
   "end": 479.95,
   "text": "אגרוף שמסמן דוד, תחזיק דוד,"
  },
  {
   "start": 480.71,
   "end": 482.63,
   "text": "דוד תחזיק, תחזיק חזק,"
  },
  {
   "start": 485.73,
   "end": 486.67,
   "text": "דוד תחזיק חזק,"
  },
  {
   "start": 487.41,
   "end": 488.13,
   "text": "תחזיק מעמד."
  },
  {
   "start": 490.11,
   "end": 491.63,
   "text": "עוד שנייה והיא נעלמת מעיניו,"
  },
  {
   "start": 493.35,
   "end": 494.79,
   "text": "וכך עם עוד עשרות ילדים,"
  },
  {
   "start": 495.51,
   "end": 497.75,
   "text": "הוא מובל אל המחנה הצבאי,"
  },
  {
   "start": 499.53,
   "end": 500.99,
   "text": "אל מסגרת חיים חדשה,"
  },
  {
   "start": 501.59,
   "end": 502.85,
   "text": "מסגרת חיים מכאיבה,"
  },
  {
   "start": 517.93,
   "end": 520.63,
   "text": "אורח חיים חדש קיבלת בניהם מכות ועינויים."
  },
  {
   "start": 522.27,
   "end": 522.81,
   "text": "הניסיון,"
  },
  {
   "start": 524.03,
   "end": 525.21,
   "text": "הניסיון הגדול ביותר"
  },
  {
   "start": 526.57,
   "end": 527.97,
   "text": "שעמד בפני החיילים,"
  },
  {
   "start": 528.99,
   "end": 529.59,
   "text": "זה היה איך,"
  },
  {
   "start": 530.71,
   "end": 532.95,
   "text": "איך הם מצליחים לשבור את הילדים האלה,"
  },
  {
   "start": 533.99,
   "end": 536.31,
   "text": "שלפתע גילו עקשנות שאתה לא יודע מאיפה,"
  },
  {
   "start": 536.85,
   "end": 537.69,
   "text": "אתה לא יודע מאיפה היא נובעת."
  },
  {
   "start": 538.57,
   "end": 539.87,
   "text": "דוד,"
  },
  {
   "start": 540.49,
   "end": 541.15,
   "text": "באופן טבעי,"
  },
  {
   "start": 542.23,
   "end": 546.13,
   "text": "באופן טבעי הוא נהפך שם למעין ראש קבוצת הילדים."
  },
  {
   "start": 546.85,
   "end": 548.39,
   "text": "הוא היה תומך בהם, מעודד אותם,"
  },
  {
   "start": 548.75,
   "end": 551.31,
   "text": "משמש כתף לילדים שבוכים,"
  },
  {
   "start": 551.83,
   "end": 554.91,
   "text": "בא לילות הים, מדבר איתם דברי תורה, מדבר איתם על אמונה."
  },
  {
   "start": 555.81,
   "end": 557.41,
   "text": "הרבה הרבה דוד לפני שאבא נפטר."
  },
  {
   "start": 558.49,
   "end": 561.35,
   "text": "אבא, שהיה הרב של העיר, הרב של העיירה,"
  },
  {
   "start": 563.52,
   "end": 566.76,
   "text": "הקנה הרבה לדוד, ודוד עכשיו, את כל מה שהוא למד"
  },
  {
   "start": 567.62,
   "end": 569.28,
   "text": "מאבא לפני שהוא נפטר מהאוויר,"
  },
  {
   "start": 569.84,
   "end": 572.76,
   "text": "מהאוויר הלאה, כאילו כל השנים שהוא הספיק"
  },
  {
   "start": 573.7,
   "end": 574.8,
   "text": "לטעום מאבא שלו,"
  },
  {
   "start": 575.32,
   "end": 576.46,
   "text": "היו צריכות למעשה"
  },
  {
   "start": 580.45,
   "end": 581.19,
   "text": "לבוא עכשיו"
  },
  {
   "start": 582.07,
   "end": 582.85,
   "text": "אל ביטויין."
  },
  {
   "start": 585.35,
   "end": 593.95,
   "text": "אבל עד מהרה מפקדת המחנה קלטה שדוד משמש כמעין ראש קבוצה שכל הילדים מעריצים אותו."
  },
  {
   "start": 594.81,
   "end": 596.61,
   "text": "ואז ידעו כולם שאם הם ישברו את דוד,"
  },
  {
   "start": 597.47,
   "end": 599.17,
   "text": "אז עשרות ילדים יצטרפו אליו."
  },
  {
   "start": 600.49,
   "end": 600.83,
   "text": "לכן,"
  },
  {
   "start": 601.73,
   "end": 604.85,
   "text": "החלו בריכוז מאמצים כבד לשבור את הרוח של דוד."
  },
  {
   "start": 606.45,
   "end": 610.09,
   "text": "ודוד רחוק מהבית, בלב הטומאה, עם לחץ היום."
  },
  {
   "start": 610.73,
   "end": 612.73,
   "text": "ומצד שני, יש הבטחות."
  },
  {
   "start": 613.09,
   "end": 615.05,
   "text": "תראה, תהיה מאושר אם תתנצר."
  },
  {
   "start": 615.51,
   "end": 618.63,
   "text": "אתה תצליח, אנחנו ניתן לך הכל, ניתן לך אוכל כמו שצריך, נתנהג אליך,"
  },
  {
   "start": 618.95,
   "end": 620.31,
   "text": "תקבל הכל מה שאתה רוצה."
  },
  {
   "start": 620.69,
   "end": 622.21,
   "text": "ויום יום, דקה דקה."
  },
  {
   "start": 623.25,
   "end": 625.01,
   "text": "רגע השבירה היה עניין של זמן."
  },
  {
   "start": 625.45,
   "end": 626.61,
   "text": "דוד היה בסך הכל ילד."
  },
  {
   "start": 627.71,
   "end": 631.27,
   "text": "הוא לא היה מסוגל לסבול את הכל, זה היה מעל הטבע."
  },
  {
   "start": 632.09,
   "end": 633.33,
   "text": "ויום אחד,"
  },
  {
   "start": 633.97,
   "end": 634.51,
   "text": "יום אחד,"
  },
  {
   "start": 636.11,
   "end": 636.89,
   "text": "יום אחד הרגע,"
  },
  {
   "start": 637.51,
   "end": 638.09,
   "text": "הרגע הגיע."
  },
  {
   "start": 639.65,
   "end": 641.43,
   "text": "העינויים רק גברו וגברו וגברו,"
  },
  {
   "start": 642.37,
   "end": 646.01,
   "text": "והכומר שעמד בצד והבטיח ניסים ונפלאות,"
  },
  {
   "start": 647.03,
   "end": 648.23,
   "text": "כל אלה הסווייט שלהם."
  },
  {
   "start": 649.35,
   "end": 649.45,
   "text": "טוב,"
  },
  {
   "start": 650.13,
   "end": 652.31,
   "text": "טוב, אני רוצה לחשוב כמה ימים על האפשרות הזו."
  },
  {
   "start": 653.57,
   "end": 655.07,
   "text": "פלט מתוך כאב."
  },
  {
   "start": 657.8,
   "end": 659.62,
   "text": "הם לא יכלו להסתיר את החיוך על הפנים שלהם."
  },
  {
   "start": 660.72,
   "end": 663.16,
   "text": "תקבל שלושה ימים ותחשוב טוב."
  },
  {
   "start": 664.06,
   "end": 665.26,
   "text": "שלושה ימים,"
  },
  {
   "start": 666.82,
   "end": 668.68,
   "text": "שלושה ימים, תזכור את זה."
  },
  {
   "start": 673.56,
   "end": 673.98,
   "text": "הרוסים,"
  },
  {
   "start": 674.94,
   "end": 676.06,
   "text": "הם הכינו בימה גדולה."
  },
  {
   "start": 677.1,
   "end": 678.86,
   "text": "הם הזמנו גנרלים ואנשי כבוד."
  },
  {
   "start": 679.74,
   "end": 680.66,
   "text": "מחר בבוקר,"
  },
  {
   "start": 682.1,
   "end": 683.2,
   "text": "טקס המרת הדת"
  },
  {
   "start": 683.82,
   "end": 688.9,
   "text": "של אחד מראשי הילדים היהודים העקשנים האלה."
  },
  {
   "start": 716.5,
   "end": 724.58,
   "text": "דוד רדום שוכב עייף ורדום."
  },
  {
   "start": 725.68,
   "end": 726.0,
   "text": "והנה,"
  },
  {
   "start": 727.42,
   "end": 728.06,
   "text": "הנה הוא שוב."
  },
  {
   "start": 729.22,
   "end": 730.58,
   "text": "הוא שוב נמצא בעיירה שלו."
  },
  {
   "start": 732.5,
   "end": 733.06,
   "text": "הנה הוא רואה,"
  },
  {
   "start": 734.0,
   "end": 734.66,
   "text": "תוך כדי חלום,"
  },
  {
   "start": 735.84,
   "end": 737.16,
   "text": "את העיירה על יד הנהר,"
  },
  {
   "start": 740.25,
   "end": 741.59,
   "text": "והנה הוא קופץ אל הנהר,"
  },
  {
   "start": 742.63,
   "end": 743.25,
   "text": "שוחל לו,"
  },
  {
   "start": 744.85,
   "end": 745.47,
   "text": "כמו אז,"
  },
  {
   "start": 748.03,
   "end": 749.13,
   "text": "כמו בימים הטובים."
  },
  {
   "start": 750.55,
   "end": 751.09,
   "text": "אבל לפתע,"
  },
  {
   "start": 751.69,
   "end": 754.21,
   "text": "לפתע הוא מרגיש שהוא שוקע במים, הוא טובע."
  },
  {
   "start": 755.49,
   "end": 756.07,
   "text": "אין איש,"
  },
  {
   "start": 756.55,
   "end": 759.23,
   "text": "הוא רוצה לצעוק לעזרה, אבל אף אחד לא ישמע, אין אף אחד."
  },
  {
   "start": 759.81,
   "end": 762.55,
   "text": "מה הוא עושה? הוא מתאמץ, אבל הוא לא מצליח."
  },
  {
   "start": 763.71,
   "end": 764.09,
   "text": "ולפתע,"
  },
  {
   "start": 765.09,
   "end": 766.47,
   "text": "לפתע הוא רואה משהו מולו."
  },
  {
   "start": 768.29,
   "end": 769.31,
   "text": "הוא מסתכל טוב,"
  },
  {
   "start": 770.03,
   "end": 771.01,
   "text": "הוא רואה שרשרת,"
  },
  {
   "start": 771.99,
   "end": 773.13,
   "text": "שרשרת ארוכה."
  },
  {
   "start": 773.93,
   "end": 776.57,
   "text": "קצה אחד קשור ומחובר אל האדמה,"
  },
  {
   "start": 777.99,
   "end": 782.01,
   "text": "והקצה השני של השלשלת הזאת"
  },
  {
   "start": 782.79,
   "end": 784.41,
   "text": "נמצא עתה לידו."
  },
  {
   "start": 787.35,
   "end": 788.49,
   "text": "שלשלת של זהב."
  },
  {
   "start": 789.65,
   "end": 790.17,
   "text": "הוא תפס,"
  },
  {
   "start": 790.85,
   "end": 793.57,
   "text": "הוא תפס בשלשלת, נאחז בה בכל כוחותיו."
  },
  {
   "start": 794.55,
   "end": 797.73,
   "text": "זו האפשרות היחידה להינצל."
  },
  {
   "start": 799.35,
   "end": 800.45,
   "text": "על מה? במוחו מחשבה."
  },
  {
   "start": 801.83,
   "end": 803.55,
   "text": "ואז הוא שם לב"
  },
  {
   "start": 804.27,
   "end": 806.77,
   "text": "שהשלשלת בנויה מחוליות."
  },
  {
   "start": 807.55,
   "end": 809.49,
   "text": "חוליה ועוד חוליה."
  },
  {
   "start": 810.03,
   "end": 811.73,
   "text": "חוליה ועוד חוליה."
  },
  {
   "start": 812.63,
   "end": 817.15,
   "text": "ואז הוא גם רואה שבכל חוליה חרוט שם."
  },
  {
   "start": 818.59,
   "end": 819.55,
   "text": "והשמות מוכרים."
  },
  {
   "start": 820.33,
   "end": 821.09,
   "text": "הוא רואה שם,"
  },
  {
   "start": 821.09,
   "end": 825.19,
   "text": "באופק מנצנצת לה החוליה הראשונה,"
  },
  {
   "start": 825.93,
   "end": 827.93,
   "text": "עליה חרוט אברהם."
  },
  {
   "start": 828.89,
   "end": 830.55,
   "text": "החוליה השנייה, יצחק,"
  },
  {
   "start": 831.21,
   "end": 832.25,
   "text": "יעקב,"
  },
  {
   "start": 834.44,
   "end": 836.42,
   "text": "רואה עוד חוליות, משה רבנו,"
  },
  {
   "start": 837.32,
   "end": 838.96,
   "text": "רבי שמעון בר יוחאי,"
  },
  {
   "start": 839.84,
   "end": 841.3,
   "text": "הארי הקדוש,"
  },
  {
   "start": 842.0,
   "end": 846.34,
   "text": "האלשיך הקדוש, הבעל שם טוב, הגאון,"
  },
  {
   "start": 851.68,
   "end": 853.46,
   "text": "וכך חוליה אחרי חוליה,"
  },
  {
   "start": 854.38,
   "end": 855.38,
   "text": "והנה קרוב אליו,"
  },
  {
   "start": 855.96,
   "end": 856.68,
   "text": "הוא רואה חוליה,"
  },
  {
   "start": 857.36,
   "end": 859.08,
   "text": "רשום שם השם של אבא,"
  },
  {
   "start": 859.62,
   "end": 860.54,
   "text": "של אבא שלו."
  },
  {
   "start": 862.2,
   "end": 864.4,
   "text": "וליד זה עוד חוליה, השם של אמא שלו,"
  },
  {
   "start": 864.92,
   "end": 866.94,
   "text": "זאת שזעקה לו תחזיק חזק."
  },
  {
   "start": 869.1,
   "end": 869.6,
   "text": "ואז,"
  },
  {
   "start": 870.6,
   "end": 872.12,
   "text": "אז הוא מביט בחוליה האחרונה,"
  },
  {
   "start": 872.86,
   "end": 873.62,
   "text": "במה שהוא יחזיק."
  },
  {
   "start": 876.38,
   "end": 877.88,
   "text": "ואתם יודעים מה הוא ראה שם?"
  },
  {
   "start": 878.94,
   "end": 882.24,
   "text": "הוא ראה את השם שלו חרוט עליה."
  },
  {
   "start": 885.18,
   "end": 885.88,
   "text": "ואז הוא רואה,"
  },
  {
   "start": 887.18,
   "end": 887.72,
   "text": "הוא רואה איך"
  },
  {
   "start": 888.6,
   "end": 889.28,
   "text": "לאט-לאט"
  },
  {
   "start": 890.16,
   "end": 891.4,
   "text": "מתחילה החולייה האחרונה,"
  },
  {
   "start": 891.92,
   "end": 893.68,
   "text": "זו עם השם שלו, להיפתח,"
  },
  {
   "start": 894.4,
   "end": 895.64,
   "text": "להישמט מהשרשרת."
  },
  {
   "start": 896.56,
   "end": 897.0,
   "text": "עוד מעט,"
  },
  {
   "start": 897.58,
   "end": 898.7,
   "text": "עוד מעט וי נפרדת לה,"
  },
  {
   "start": 899.2,
   "end": 900.22,
   "text": "נפרדת לה מן השלשלת,"
  },
  {
   "start": 900.98,
   "end": 902.64,
   "text": "משרשרת הזהב הנפלאה הזו."
  },
  {
   "start": 905.04,
   "end": 905.54,
   "text": "השלשלת,"
  },
  {
   "start": 906.42,
   "end": 907.0,
   "text": "השלשלת,"
  },
  {
   "start": 907.64,
   "end": 908.98,
   "text": "אני חלק מהשלשלת!"
  },
  {
   "start": 909.48,
   "end": 909.92,
   "text": "הוא שמע,"
  },
  {
   "start": 910.44,
   "end": 913.22,
   "text": "שמע דוד את עצמו צועק, אני חלק מהשלשלת!"
  },
  {
   "start": 915.96,
   "end": 917.08,
   "text": "ואז הוא התעורר באחת,"
  },
  {
   "start": 918.28,
   "end": 920.68,
   "text": "מבוהל ושטוף זיעה."
  },
  {
   "start": 927.0,
   "end": 927.74,
   "text": "למחרת בבוקר,"
  },
  {
   "start": 929.42,
   "end": 930.38,
   "text": "טקס רב רושם,"
  },
  {
   "start": 931.18,
   "end": 932.76,
   "text": "מלא באר והדר, אורחים."
  },
  {
   "start": 934.28,
   "end": 935.2,
   "text": "מרכז הטקס,"
  },
  {
   "start": 938.74,
   "end": 939.32,
   "text": "מובל,"
  },
  {
   "start": 943.19,
   "end": 943.63,
   "text": "מובל,"
  },
  {
   "start": 945.15,
   "end": 945.61,
   "text": "דוד,"
  },
  {
   "start": 946.71,
   "end": 948.13,
   "text": "אל מול שורת הגנרלים."
  },
  {
   "start": 951.44,
   "end": 954.98,
   "text": "מרים את העיניים, רואה את כל הילדים, החברים שלו,"
  },
  {
   "start": 955.84,
   "end": 957.12,
   "text": "אלה שהעריצו אותו כל כך,"
  },
  {
   "start": 958.16,
   "end": 959.88,
   "text": "אלה שהתחזקו ממנו כל כך מביטים בו,"
  },
  {
   "start": 960.38,
   "end": 960.8,
   "text": "במבט,"
  },
  {
   "start": 961.36,
   "end": 962.62,
   "text": "במבט שלא מאמינים."
  },
  {
   "start": 962.98,
   "end": 965.08,
   "text": "וכולם ממתינים."
  },
  {
   "start": 966.26,
   "end": 966.68,
   "text": "דממה"
  },
  {
   "start": 967.84,
   "end": 968.94,
   "text": "חותכת את חלל האוויר."
  },
  {
   "start": 973.17,
   "end": 973.97,
   "text": "כולם מחכים."
  },
  {
   "start": 975.31,
   "end": 976.85,
   "text": "כולם מצפים ממנו."
  },
  {
   "start": 981.52,
   "end": 982.5,
   "text": "ואז דוד מתקרב."
  },
  {
   "start": 991.06,
   "end": 992.88,
   "text": "הוא נשען בידו על שולחן הכבוד."
  },
  {
   "start": 993.48,
   "end": 994.32,
   "text": "כולם מביטים בו."
  },
  {
   "start": 995.12,
   "end": 997.1,
   "text": "ואז נשמע הקול שלו, יציב ורגוע."
  },
  {
   "start": 997.72,
   "end": 999.54,
   "text": "זו התשובה לשלושת הימים."
  },
  {
   "start": 1000.58,
   "end": 1002.08,
   "text": "זה עבור שלושת הימים."
  },
  {
   "start": 1002.86,
   "end": 1006.08,
   "text": "ובתנועה חדה ומפתיעה הוא שולף גרזן מאי שם."
  },
  {
   "start": 1007.04,
   "end": 1008.36,
   "text": "הגרזן ירד באחת,"
  },
  {
   "start": 1011.68,
   "end": 1016.12,
   "text": "מקצץ שלוש מאצבעותיו."
  },
  {
   "start": 1019.71,
   "end": 1020.71,
   "text": "זו התשובה,"
  },
  {
   "start": 1023.08,
   "end": 1023.88,
   "text": "אני יהודי,"
  },
  {
   "start": 1024.74,
   "end": 1025.92,
   "text": "אני אשאר יהודי,"
  },
  {
   "start": 1027.1,
   "end": 1028.22,
   "text": "ממלמל דוד ומתעלף."
  },
  {
   "start": 1031.9,
   "end": 1032.82,
   "text": "המהומה הייתה רבה."
  },
  {
   "start": 1034.24,
   "end": 1035.02,
   "text": "הלם אחז את כולם."
  },
  {
   "start": 1039.24,
   "end": 1041.38,
   "text": "שורת הגנרלים מתוסכלת מבוישת."
  },
  {
   "start": 1043.34,
   "end": 1044.12,
   "text": "לא מאמינים."
  },
  {
   "start": 1044.86,
   "end": 1045.96,
   "text": "ילד קטן."
  },
  {
   "start": 1048.22,
   "end": 1050.22,
   "text": "קטע לעצמו את האצבעות,"
  },
  {
   "start": 1052.16,
   "end": 1053.84,
   "text": "ובלבד לא להצטרף"
  },
  {
   "start": 1061.47,
   "end": 1062.89,
   "text": "ולהמיר את הדת שלו."
  },
  {
   "start": 1070.28,
   "end": 1071.22,
   "text": "הילדים היהודים"
  },
  {
   "start": 1072.64,
   "end": 1074.9,
   "text": "הביטו במחזה בתדהמה."
  },
  {
   "start": 1077.3,
   "end": 1078.7,
   "text": "עוד חוליה התחברה לה"
  },
  {
   "start": 1079.42,
   "end": 1080.82,
   "text": "אל שרשרת הזהב."
  },
  {
   "start": 1081.88,
   "end": 1082.62,
   "text": "ואתם יודעים מה?"
  },
  {
   "start": 1084.12,
   "end": 1085.6,
   "text": "הסיפור הזה, המקרה הזה,"
  },
  {
   "start": 1086.66,
   "end": 1088.4,
   "text": "על הנער הזה, הגבורה שלו,"
  },
  {
   "start": 1090.1,
   "end": 1091.02,
   "text": "האמונה שלו,"
  },
  {
   "start": 1091.66,
   "end": 1094.16,
   "text": "הסיפור הזה הגיע עד ארמון הצאר ניקולאי,"
  },
  {
   "start": 1094.84,
   "end": 1098.3,
   "text": "וכשניקולאי שמע את זה, עם כל האכזריות שלו, עם כל הרשעות,"
  },
  {
   "start": 1098.76,
   "end": 1102.26,
   "text": "הוא הבין, כל עוד קיימים יהודים כאלה,"
  },
  {
   "start": 1102.86,
   "end": 1103.64,
   "text": "אין לי סיכוי."
  },
  {
   "start": 1117.4,
   "end": 1118.58,
   "text": "מה ייתן לנו את הכוח"
  },
  {
   "start": 1119.36,
   "end": 1121.76,
   "text": "לשמור על הגחלת היהודית שתבער בנו?"
  },
  {
   "start": 1123.02,
   "end": 1126.32,
   "text": "מה ייתן לנו את הכוח להחזיק מעמד בעולם כזה מטורף?"
  },
  {
   "start": 1129.48,
   "end": 1131.22,
   "text": "בעולם כל כך מלא תאוות?"
  },
  {
   "start": 1132.9,
   "end": 1135.12,
   "text": "בעולם כל כך מלא אינטרסים?"
  },
  {
   "start": 1136.22,
   "end": 1137.56,
   "text": "שרשרת הזהב,"
  },
  {
   "start": 1138.92,
   "end": 1143.12,
   "text": "נדע שאנחנו שייכים לשלשלת נפלאה."
  },
  {
   "start": 1144.46,
   "end": 1147.08,
   "text": "ואתה חוליה נוצצת"
  },
  {
   "start": 1147.62,
   "end": 1148.46,
   "text": "בשלשלת הזאת."
  },
  {
   "start": 1149.38,
   "end": 1152.64,
   "text": "ואת חוליה נוצצת בשלשלת הזאת."
  },
  {
   "start": 1153.22,
   "end": 1154.2,
   "text": "שלשלת של אמת."
  },
  {
   "start": 1156.71,
   "end": 1161.95,
   "text": "אשרינו ואשר חלקנו שזכינו להתחבר לשלשלת מופלאה כזאת."
  },
  {
   "start": 1181.42,
   "end": 1183.1,
   "text": "דלי שאתה מוריד לבור,"
  },
  {
   "start": 1183.72,
   "end": 1184.94,
   "text": "כמה שהבור יהיה עמוק,"
  },
  {
   "start": 1185.56,
   "end": 1192.32,
   "text": "כמה שהוא יהיה בתהום, כל זמן שהדלי קשור בחבל ניתן לעלות אותו."
  },
  {
   "start": 1193.62,
   "end": 1195.54,
   "text": "ואפילו שהדלי ירד לתהום,"
  },
  {
   "start": 1196.62,
   "end": 1199.18,
   "text": "כל זמן שהוא קשור לחבל, הוא יעלה."
  },
  {
   "start": 1200.4,
   "end": 1201.3,
   "text": "יהיה מה שיהיה."
  },
  {
   "start": 1202.16,
   "end": 1205.16,
   "text": "העיקר שיהיה קשור לחבל, לא משנה איזה חבל."
  },
  {
   "start": 1205.74,
   "end": 1208.48,
   "text": "כל הזמן שאתה קשור לחבל,"
  },
  {
   "start": 1209.04,
   "end": 1212.88,
   "text": "לשולשלת של עם ישראל, יעלו אותך."
  },
  {
   "start": 1213.58,
   "end": 1215.4,
   "text": "כי בעזרת החבל אפשר לעלות."
  },
  {
   "start": 1216.1,
   "end": 1217.7,
   "text": "ככה צריכים לדעת, כל יהודי"
  },
  {
   "start": 1218.32,
   "end": 1219.6,
   "text": "רק תהיה מחובר."
  },
  {
   "start": 1220.36,
   "end": 1224.22,
   "text": "אל תוותר על זה, לא לנתק, לא להתנתק מעם ישראל."
  },
  {
   "start": 1225.36,
   "end": 1227.06,
   "text": "כל הזמן להיות דבק בשם יתברך."
  },
  {
   "start": 1227.76,
   "end": 1229.58,
   "text": "כל הזמן להשתדל, גם כשאני נופל,"
  },
  {
   "start": 1230.04,
   "end": 1231.18,
   "text": "לקום אני עם השם יתברך."
  },
  {
   "start": 1232.48,
   "end": 1234.64,
   "text": "נשתדל לקיים מצוות כמה שאפשר."
  },
  {
   "start": 1235.42,
   "end": 1239.96,
   "text": "נפלתי, ירדתי, לא משנה, לאחוז במה שיש. עוד מצווה פה, הרווחתי פה."
  },
  {
   "start": 1240.9,
   "end": 1242.3,
   "text": "כל מצווה זאת מחזק."
  },
  {
   "start": 1243.34,
   "end": 1245.88,
   "text": "את השלשלת שלנו, את החוליה שלנו."
  },
  {
   "start": 1246.9,
   "end": 1250.74,
   "text": "כי אנחנו צריכים לדעת, כל יהודי וכל יהודייה צריכים לדעת מי אנחנו."
  },
  {
   "start": 1251.1,
   "end": 1253.48,
   "text": "אנחנו הבנים של השם יתברך."
  },
  {
   "start": 1255.42,
   "end": 1257.66,
   "text": "בנים של בני מלך מלכה, מלכים הקדוש ברוך הוא."
  },
  {
   "start": 1258.48,
   "end": 1261.94,
   "text": "אנחנו בני ישראל, אנחנו בנים של אברהם, יצחק, יעקב. אתם יודעים מי זה יעקב?"
  },
  {
   "start": 1262.7,
   "end": 1263.26,
   "text": "אתם יודעים מי זה יעקב?"
  },
  {
   "start": 1264.04,
   "end": 1269.24,
   "text": "יעקב זה זה, אותו אחד עצום וגדול כשהיה בדרך אל לבן. בואו נראה מי זה אבא שלנו."
  },
  {
   "start": 1270.12,
   "end": 1273.42,
   "text": "מי זה יעקב? בני ישראל, בני יעקב,"
  },
  {
   "start": 1273.84,
   "end": 1277.42,
   "text": "כשהיה בדרך אל לבן שוכב לישון במקום הקדוש בעולם,"
  },
  {
   "start": 1278.32,
   "end": 1279.16,
   "text": "והוא לא יודע את זה."
  },
  {
   "start": 1280.02,
   "end": 1281.64,
   "text": "והוא חולם חלום נבואי,"
  },
  {
   "start": 1282.48,
   "end": 1286.02,
   "text": "ומראים לו את כל מה שיעשה לבני ישראל,"
  },
  {
   "start": 1286.36,
   "end": 1288.76,
   "text": "שיעשה לנו, כל מה שיעבור עלינו מראים לו."
  },
  {
   "start": 1289.38,
   "end": 1294.88,
   "text": "הוא יושב ומתפלל עבורנו שנעבור את הכל באמונה שלא נבייש את הפירמה."
  },
  {
   "start": 1295.62,
   "end": 1299.04,
   "text": "תראו איזה עוצמה, בואו נבין את המחצב ממנו נשאבנו,"
  },
  {
   "start": 1299.12,
   "end": 1300.2,
   "text": "ממנו נעצבנו."
  },
  {
   "start": 1300.58,
   "end": 1303.14,
   "text": "מה זה להיות זרעור של יעקב אבינו עליו השלום?"
  },
  {
   "start": 1304.16,
   "end": 1305.38,
   "text": "אז אסור לבייש את הפירמה."
  },
  {
   "start": 1305.92,
   "end": 1308.72,
   "text": "כי כל אחד בבחינת יעקב, כי כל אחת היא בבחינת רחל."
  },
  {
   "start": 1309.76,
   "end": 1310.94,
   "text": "רחל אימנו!"
  },
  {
   "start": 1312.6,
   "end": 1315.7,
   "text": "אמא רחל שבוכה על הילדים שלה,"
  },
  {
   "start": 1316.14,
   "end": 1319.24,
   "text": "שמצילה את כל עם ישראל, האמא הגדולה, כל אישה היא ככה."
  },
  {
   "start": 1321.12,
   "end": 1323.14,
   "text": "כולנו שרשרת הזהב של עם ישראל."
  },
  {
   "start": 1323.94,
   "end": 1324.66,
   "text": "אז אסור לנו."
  },
  {
   "start": 1325.32,
   "end": 1326.6,
   "text": "אסור לנו לבייש את הפירמה."
  },
  {
   "start": 1326.6,
   "end": 1329.46,
   "text": "אסור לנו, אנחנו צריכים לדעת,"
  },
  {
   "start": 1330.34,
   "end": 1331.28,
   "text": "לדעת להתחזק,"
  },
  {
   "start": 1332.62,
   "end": 1336.42,
   "text": "לדעת לא לוותר גם ברגעים הקשים ביותר, גם בקשיים,"
  },
  {
   "start": 1337.22,
   "end": 1340.56,
   "text": "גם כשאתה מרגיש שהכל הכל נגדך, הכל הכל לא הולך,"
  },
  {
   "start": 1341.22,
   "end": 1342.36,
   "text": "אז, אז,"
  },
  {
   "start": 1342.94,
   "end": 1343.68,
   "text": "אז לדעת,"
  },
  {
   "start": 1344.26,
   "end": 1344.98,
   "text": "מי אני?"
  },
  {
   "start": 1346.54,
   "end": 1351.46,
   "text": "אני צריך להתחזק כמו יוסף, גם יוסף אפילו היה צדיק גדול, אבל תבינו את המעמד שהוא היה."
  },
  {
   "start": 1352.24,
   "end": 1355.14,
   "text": "לבד בלי אבא, בלי אמא, בלי כלום, יושב לו בארץ זרה."
  },
  {
   "start": 1355.54,
   "end": 1356.66,
   "text": "ומה מחזיק אותו?"
  },
  {
   "start": 1357.84,
   "end": 1358.34,
   "text": "אני לא יכול."
  },
  {
   "start": 1359.18,
   "end": 1360.42,
   "text": "אני שייך לשרשרת."
  },
  {
   "start": 1361.14,
   "end": 1363.44,
   "text": "שייך לאברהם, ליצחק, ליעקב."
  },
  {
   "start": 1364.16,
   "end": 1364.78,
   "text": "אני לא יכול!"
  },
  {
   "start": 1365.82,
   "end": 1367.08,
   "text": "אני חלק מהשרשרת!"
  },
  {
   "start": 1369.42,
   "end": 1371.64,
   "text": "ויוסף צועק את זה לנו!"
  },
  {
   "start": 1372.34,
   "end": 1374.16,
   "text": "אני חלק מהשרשרת!"
  },
  {
   "start": 1376.94,
   "end": 1378.72,
   "text": "אז בואו בעזרת השם נתחבר."
  },
  {
   "start": 1379.74,
   "end": 1383.12,
   "text": "בואו נתחבר לסבא וסבתא שלנו בשמיים שבוכים עלינו,"
  },
  {
   "start": 1383.9,
   "end": 1386.04,
   "text": "שמתפללים על הילדים שלהם,"
  },
  {
   "start": 1386.74,
   "end": 1395.86,
   "text": "שרוצים, כל אחד צריך לדעת, כל אחד ישמע עליך בשמיים נשמות שבוכות ומתחננות ושמחות. כל מצווה שהוא עושה, אומרים, הנה, הנה, הנה, היא עשתה מצווה,"
  },
  {
   "start": 1396.18,
   "end": 1402.72,
   "text": "הנה הוא עשה מצווה, איזה יופי! איזה שמחה בשמיים היא עשתה מצווה! הנה היא עומדת בניסיון, הנה הוא עומד בניסיון!"
  },
  {
   "start": 1403.54,
   "end": 1404.62,
   "text": "ככה צריך להסתכל?"
  },
  {
   "start": 1405.12,
   "end": 1405.88,
   "text": "זו האמת!"
  },
  {
   "start": 1406.72,
   "end": 1407.36,
   "text": "זו האמת!"
  },
  {
   "start": 1409.36,
   "end": 1410.48,
   "text": "ועם הידיעה הזאת,"
  },
  {
   "start": 1411.26,
   "end": 1412.42,
   "text": "עם ההבנה הזאת,"
  },
  {
   "start": 1413.24,
   "end": 1415.16,
   "text": "בעזרת השם יהיה לנו הרבה הרבה כוח"
  },
  {
   "start": 1415.16,
   "end": 1416.24,
   "text": "להתגבר"
  }
 ]
}