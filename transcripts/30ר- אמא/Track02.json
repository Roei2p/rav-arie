{
 "disc": "30ר- אמא",
 "track": "Track02",
 "duration": 772.104,
 "segments": [
  {
   "start": 10.6,
   "end": 14.42,
   "text": "זה קרה כאן בארץ ישראל זמן קצר אחרי קום המדינה."
  },
  {
   "start": 15.4,
   "end": 16.2,
   "text": "מגיעה משלחת"
  },
  {
   "start": 16.78,
   "end": 20.8,
   "text": "של המוסד לביון ולתפקידים מיוחדים של מדינת ישראל."
  },
  {
   "start": 21.56,
   "end": 24.32,
   "text": "מגיעים אל הרב קנמן, הרב מיפונוביץ',"
  },
  {
   "start": 24.98,
   "end": 26.96,
   "text": "עם בקשה לא שגרתית."
  },
  {
   "start": 29.12,
   "end": 38.18,
   "text": "הם אומרים לרב, יש בידינו מידע שאחרי השואה הסתובבו באירופה כ-200 ילדים שאיבדו את ההורים שלהם. 200 ילדים יהודים."
  },
  {
   "start": 38.7,
   "end": 44.32,
   "text": "אותם 200 ילדים יהודים נאספו על ידי אב מנזר באיטליה והם נמצאים שם."
  },
  {
   "start": 44.88,
   "end": 47.98,
   "text": "ילדים קטנים שגדלו כבר מספר שנים במנזר"
  },
  {
   "start": 48.68,
   "end": 49.88,
   "text": "כנוצרים לכל דבר."
  },
  {
   "start": 50.98,
   "end": 52.5,
   "text": "ואנחנו רוצים להוציא אותם משם,"
  },
  {
   "start": 53.4,
   "end": 56.72,
   "text": "רוצים להביא אותם חזרה הביתה, חזרה לארץ."
  },
  {
   "start": 59.88,
   "end": 62.76,
   "text": "איטליה מוכנה לשתף איתנו פעולה,"
  },
  {
   "start": 63.94,
   "end": 67.9,
   "text": "אבל אב המנזר לא כל כך מתלהב לעזור לנו"
  },
  {
   "start": 68.8,
   "end": 72.18,
   "text": "ולדעת מי מבין כל היהודים במגזר יהודי,"
  },
  {
   "start": 74.4,
   "end": 76.68,
   "text": "את זה אנחנו לא יודעים כל כך."
  },
  {
   "start": 77.24,
   "end": 78.98,
   "text": "את זה אנחנו רוצים שהרב יעזור לנו."
  },
  {
   "start": 79.36,
   "end": 81.16,
   "text": "נציג התורה, נציג היהדות אולי."
  },
  {
   "start": 82.0,
   "end": 84.46,
   "text": "הרב אולי ידע יותר טוב מאיתנו מי יהיה יהודי."
  },
  {
   "start": 85.12,
   "end": 86.9,
   "text": "לרב כהנמן לא היו הרבה ברירות."
  },
  {
   "start": 88.04,
   "end": 89.22,
   "text": "הוא הסכים, וכך"
  },
  {
   "start": 89.82,
   "end": 90.94,
   "text": "הוא יוצא לאיטליה."
  },
  {
   "start": 92.28,
   "end": 96.48,
   "text": "באיטליה מתלווה אליו נספח דיפלומטי של מדינת ישראל ושל איטליה,"
  },
  {
   "start": 96.96,
   "end": 98.28,
   "text": "והם בדרך למנזר."
  },
  {
   "start": 101.95,
   "end": 107.43,
   "text": "הרב מקנרמן עוד לא הספיק להתאושש מהטיסה, וכבר הוא מוצא את עצמו מול אב המנזר."
  },
  {
   "start": 108.81,
   "end": 109.87,
   "text": "ואב המנזר,"
  },
  {
   "start": 111.31,
   "end": 113.19,
   "text": "אב המנזר פונה לרב ואומר לו,"
  },
  {
   "start": 114.91,
   "end": 117.19,
   "text": "כבוד הרב, חבל על הכרטיס נסיעה."
  },
  {
   "start": 118.03,
   "end": 120.33,
   "text": "חבל על הזמן שבזבזת."
  },
  {
   "start": 123.3,
   "end": 124.62,
   "text": "לטענתך יש כאן"
  },
  {
   "start": 125.32,
   "end": 126.96,
   "text": "כ-200 ילדים יהודים."
  },
  {
   "start": 127.74,
   "end": 130.22,
   "text": "אם אתה חושב שאני אעזור לך, אתה טועה."
  },
  {
   "start": 130.76,
   "end": 135.16,
   "text": "אם אתה חושב שאני יאמר ויסכים לזה, אתה טועה."
  },
  {
   "start": 137.93,
   "end": 138.73,
   "text": "איך תדע?"
  },
  {
   "start": 140.79,
   "end": 145.51,
   "text": "נגיד שבין הילדים של המנזר פה זה ילדים שאספנו מכל אירופה."
  },
  {
   "start": 145.83,
   "end": 147.13,
   "text": "נגיד שיש שם גם יהודים."
  },
  {
   "start": 147.53,
   "end": 148.17,
   "text": "איך תדע?"
  },
  {
   "start": 148.65,
   "end": 150.07,
   "text": "איך תוציא את אותם יהודים?"
  },
  {
   "start": 150.63,
   "end": 151.49,
   "text": "מה תאמר לי? ברית מילה?"
  },
  {
   "start": 152.25,
   "end": 153.25,
   "text": "יש לנו פה מוסלמים,"
  },
  {
   "start": 154.11,
   "end": 156.83,
   "text": "יש לנו פה גם נוצרים שעושים את העמי בריאות ברית מילה."
  },
  {
   "start": 157.93,
   "end": 159.79,
   "text": "זה לא ראייה, זה לא הוכחה."
  },
  {
   "start": 160.75,
   "end": 163.81,
   "text": "תבין, אנחנו אספנו ילדים בגיל שנתיים,"
  },
  {
   "start": 164.87,
   "end": 166.07,
   "text": "בגיל שנה וחצי."
  },
  {
   "start": 166.75,
   "end": 168.39,
   "text": "יש ילדים שלא ידעו לדבר."
  },
  {
   "start": 169.11,
   "end": 178.01,
   "text": "אתה חושב שאחרי שנים פה במנזר אתה תוכל לומר לי מי יהודי? הילדים האלה יזכרו שהם יהודים בכלל?"
  },
  {
   "start": 178.71,
   "end": 179.49,
   "text": "אב המנזר"
  },
  {
   "start": 180.41,
   "end": 182.87,
   "text": "חייך ואמר לרב מיפונוביץ'"
  },
  {
   "start": 183.63,
   "end": 186.63,
   "text": "חבל לך על הזמן, תחזור הביתה."
  },
  {
   "start": 188.27,
   "end": 189.17,
   "text": "אין לך סיכוי."
  },
  {
   "start": 190.29,
   "end": 191.73,
   "text": "ואין לי כוונה לעזור לך."
  },
  {
   "start": 197.24,
   "end": 198.32,
   "text": "נסתררה דומייה."
  },
  {
   "start": 199.8,
   "end": 200.76,
   "text": "הרב מיפונוביץ'"
  },
  {
   "start": 201.62,
   "end": 204.24,
   "text": "פנה לריבונו של עולם והתחיל להתפלל לך ראשית."
  },
  {
   "start": 205.6,
   "end": 206.84,
   "text": "ואז הוא אמר לאב המנזר,"
  },
  {
   "start": 208.66,
   "end": 209.28,
   "text": "אתה יודע מה?"
  },
  {
   "start": 210.5,
   "end": 213.18,
   "text": "תן לי חמש דקות."
  },
  {
   "start": 213.9,
   "end": 216.82,
   "text": "חמש דקות עם כל הילדים של המנזר."
  },
  {
   "start": 217.34,
   "end": 218.84,
   "text": "עם כל הילדים שאספת."
  },
  {
   "start": 219.9,
   "end": 221.72,
   "text": "ואני אוציא לך את הילדים היהודים."
  },
  {
   "start": 222.36,
   "end": 224.36,
   "text": "אני אוציא לך את 200 הילדים היהודים."
  },
  {
   "start": 224.96,
   "end": 228.64,
   "text": "אב המנזר הסתכל כלא מאמין,"
  },
  {
   "start": 229.54,
   "end": 231.78,
   "text": "אמר לרב, אתה בטוח מה שאתה אומר?"
  },
  {
   "start": 232.96,
   "end": 234.9,
   "text": "כבוד הרב, אתה מבין מה שאתה אומר?"
  },
  {
   "start": 236.8,
   "end": 240.08,
   "text": "והרב כהנמן ממשיך ואומר לו, תן לי חמש דקות."
  },
  {
   "start": 241.74,
   "end": 244.54,
   "text": "חייך אב המנזר ואמר, חמש דקות, בבקשה."
  },
  {
   "start": 246.89,
   "end": 247.57,
   "text": "בבקשה?"
  },
  {
   "start": 249.99,
   "end": 252.35,
   "text": "טוב, אמר הרב כהנמן, מתי?"
  },
  {
   "start": 252.77,
   "end": 254.17,
   "text": "מתי אני יכול לפגוש את כל הילדים?"
  },
  {
   "start": 255.07,
   "end": 257.69,
   "text": "אמר לו אב המנזר, עוד מעט ארוחת צהריים."
  },
  {
   "start": 258.19,
   "end": 260.63,
   "text": "בארוחת צהריים כל הילדים באים לאכול."
  },
  {
   "start": 261.07,
   "end": 262.57,
   "text": "תיכנס לאולם חדר האוכל,"
  },
  {
   "start": 263.15,
   "end": 264.47,
   "text": "יש לך חמש דקות,"
  },
  {
   "start": 265.07,
   "end": 265.73,
   "text": "תזכור."
  },
  {
   "start": 267.17,
   "end": 267.63,
   "text": "לא יותר."
  },
  {
   "start": 271.92,
   "end": 278.74,
   "text": "צהריים. אולם חדר האוכל במנזר היה מלא מפה לפה."
  },
  {
   "start": 280.06,
   "end": 281.8,
   "text": "והרב כהנמן נכנס."
  },
  {
   "start": 282.96,
   "end": 283.78,
   "text": "באולם שם"
  },
  {
   "start": 284.88,
   "end": 286.5,
   "text": "היו כל הילדים,"
  },
  {
   "start": 287.4,
   "end": 289.66,
   "text": "יותר מאלף ילדים היו שם."
  },
  {
   "start": 290.2,
   "end": 295.28,
   "text": "אם רק נדמה לנגד עינינו אולם עם אלף ילדים,"
  },
  {
   "start": 297.6,
   "end": 299.14,
   "text": "איך אתה יכול לזהות?"
  },
  {
   "start": 299.74,
   "end": 303.42,
   "text": "איך אתה יכול להוציא מתוכם 200 ילדים?"
  },
  {
   "start": 304.18,
   "end": 305.8,
   "text": "והרב מיפונוביץ' עומד,"
  },
  {
   "start": 306.78,
   "end": 310.56,
   "text": "סוקר במבטו את כל אולם חדר האוכל הענק,"
  },
  {
   "start": 311.3,
   "end": 313.4,
   "text": "ומתפלל אל השם, בואו העולם תעזור לי."
  },
  {
   "start": 314.54,
   "end": 320.5,
   "text": "ואז הרב מיפונוביץ' פנה אל מרכז אולם חדר האוכל."
  },
  {
   "start": 321.32,
   "end": 322.62,
   "text": "עמד במרכז,"
  },
  {
   "start": 323.7,
   "end": 326.4,
   "text": "נשא עיניו לשמיים ואמר,"
  },
  {
   "start": 327.66,
   "end": 329.92,
   "text": "הוא אמר משפט אחד,"
  },
  {
   "start": 330.48,
   "end": 331.8,
   "text": "שמע ישראל,"
  },
  {
   "start": 332.42,
   "end": 335.14,
   "text": "אדוני, אלוהינו,"
  },
  {
   "start": 335.94,
   "end": 337.1,
   "text": "אדוני,"
  },
  {
   "start": 337.7,
   "end": 343.77,
   "text": "אחד, הרב ניפונוביץ' פתח את פיו הקדוש ואמר,"
  },
  {
   "start": 344.85,
   "end": 348.31,
   "text": "הוא זעק פסוק אחד,"
  },
  {
   "start": 349.39,
   "end": 351.25,
   "text": "פסוק נצחי אחד,"
  },
  {
   "start": 351.79,
   "end": 353.75,
   "text": "שמע ישראל,"
  },
  {
   "start": 354.71,
   "end": 358.29,
   "text": "אדוני, אלוהינו,"
  },
  {
   "start": 359.47,
   "end": 367.91,
   "text": "אדוני, אחד לפתח."
  },
  {
   "start": 368.33,
   "end": 372.71,
   "text": "כמאתיים ילדים ניתקו מהשולחנות,"
  },
  {
   "start": 374.09,
   "end": 377.93,
   "text": "ניתקו מהשולחנות באחת, ורצו אליו."
  },
  {
   "start": 378.43,
   "end": 383.45,
   "text": "רצו אליו כשהם צועקים מאמה, מאמה, ותופסים לו בבגדים."
  },
  {
   "start": 383.97,
   "end": 389.51,
   "text": "מאמה, מאמה, ותופסים לו בבגדים, כי נאחזים בחיים."
  },
  {
   "start": 392.56,
   "end": 395.36,
   "text": "הרב ניפונוביץ' פקח את עיניו,"
  },
  {
   "start": 395.82,
   "end": 399.92,
   "text": "הביט באב המנזר שהיה חיוור כמו סיד,"
  },
  {
   "start": 401.0,
   "end": 406.35,
   "text": "ואמר לו, הדין שלי, את אלה אני לוקח."
  },
  {
   "start": 407.03,
   "end": 408.79,
   "text": "אלה ה-200 ילדים יהודים."
  },
  {
   "start": 414.41,
   "end": 416.67,
   "text": "הוא לא יכול להוציא מילה מפיו,"
  },
  {
   "start": 417.13,
   "end": 423.05,
   "text": "פשוט עמד חיוור עם פה פעור וחסר אונים לחלוטין."
  },
  {
   "start": 424.53,
   "end": 427.11,
   "text": "והרב מיפונוביץ' לקח את הילדים."
  },
  {
   "start": 434.47,
   "end": 435.71,
   "text": "זמן מה אחר כך,"
  },
  {
   "start": 436.45,
   "end": 438.29,
   "text": "נמל התעופה שם באיטליה."
  },
  {
   "start": 439.51,
   "end": 442.93,
   "text": "הרב מיפונוביץ' מעלה את הילדים אל המטוס,"
  },
  {
   "start": 444.37,
   "end": 446.03,
   "text": "ואז הוא שומע לפתע קריאה למטה."
  },
  {
   "start": 446.95,
   "end": 448.71,
   "text": "הוא מסתובב, הוא רואה את אב המנזר."
  },
  {
   "start": 449.69,
   "end": 450.89,
   "text": "אב המנזר אומר, כבוד הרב,"
  },
  {
   "start": 451.51,
   "end": 452.79,
   "text": "אני רוצה לדבר איתך רגע."
  },
  {
   "start": 453.25,
   "end": 457.39,
   "text": "אמר לו הרב יפונוביץ', רגע, רגע, קודם כל אני מעלה את כל הילדים, מה שבטוח."
  },
  {
   "start": 458.73,
   "end": 460.99,
   "text": "והוא העלה את כל הילדים אל המטוס."
  },
  {
   "start": 462.29,
   "end": 464.23,
   "text": "אחרי זה הוא יורד חזרה ואומר לו, כן."
  },
  {
   "start": 465.85,
   "end": 469.35,
   "text": "השאיר מבט אליו עב המנזר ואמר לו, תגיד לי, כבוד הרב,"
  },
  {
   "start": 469.77,
   "end": 472.57,
   "text": "תדע לך, אני לא מאמין בטריקים."
  },
  {
   "start": 473.79,
   "end": 474.43,
   "text": "אני לא מאמין."
  },
  {
   "start": 476.62,
   "end": 477.64,
   "text": "אני אדם לוגי."
  },
  {
   "start": 478.08,
   "end": 480.2,
   "text": "תגיד לי, איך עשית את זה?"
  },
  {
   "start": 481.0,
   "end": 482.74,
   "text": "תסביר לי איך עשית את זה."
  },
  {
   "start": 483.0,
   "end": 488.74,
   "text": "איך בפחות מחמש דקות הוצאת לי את המאתיים ילדים יהודים,"
  },
  {
   "start": 489.44,
   "end": 491.22,
   "text": "אחרי שנים שהם פה במנזר,"
  },
  {
   "start": 492.22,
   "end": 516.24,
   "text": "אחרי שלימדנו אותם כל כך הרבה, הרי הם לא יודעים בכלל שהם יהודים. איך עשית את זה? תסביר לי. והרב מפווה מנזר ואמר לו, הוצאתי אותם,"
  },
  {
   "start": 516.94,
   "end": 517.74,
   "text": "אני אסביר לך."
  },
  {
   "start": 518.58,
   "end": 519.82,
   "text": "כשאני עמדתי שם,"
  },
  {
   "start": 521.58,
   "end": 525.9,
   "text": "התפללתי לשם, תן לי רעיון איך להוציא אותם."
  },
  {
   "start": 525.9,
   "end": 529.7,
   "text": "ואז הקדוש ברוך הוא הפסיק לרעיון."
  },
  {
   "start": 530.4,
   "end": 533.32,
   "text": "אני אמרתי, מה אני יכול לעשות?"
  },
  {
   "start": 534.24,
   "end": 540.46,
   "text": "מה אני יכול לעשות כדי להזכיר לילדים האלה את אמא שלהם?"
  },
  {
   "start": 542.24,
   "end": 546.26,
   "text": "אמרתי, אם יש משהו שילד לעולם לא שוכח,"
  },
  {
   "start": 546.86,
   "end": 549.44,
   "text": "שטבוע בנשמה שלו,"
  },
  {
   "start": 550.78,
   "end": 551.84,
   "text": "בנפש שלו,"
  },
  {
   "start": 553.48,
   "end": 554.6,
   "text": "זו אמא שלו."
  },
  {
   "start": 555.6,
   "end": 556.54,
   "text": "זה בית אימא."
  },
  {
   "start": 558.45,
   "end": 560.75,
   "text": "אמרתי, מה אני יכול לעשות כדי להזכיר את אימא?"
  },
  {
   "start": 561.55,
   "end": 585.09,
   "text": "ואז נזכרתי שאצלנו כל אימא לפני שהילד היה הולך לישון לא משנה באיזה גילו שנתיים שנה יומיים לא משנה מבין לא מבין כל אימא לפני שהילד היה הולך לישון הייתה רוחנת ובפנים מחייכות הייתה אומרת שמע ישראל"
  },
  {
   "start": 585.95,
   "end": 594.55,
   "text": "אדוני אלוהינו, אדוני אחד, שכל ילד ישן עם שמע ישראל,"
  },
  {
   "start": 595.11,
   "end": 598.81,
   "text": "כל אמא הייתה רוחנת ובפנים מחייכות,"
  },
  {
   "start": 599.23,
   "end": 600.73,
   "text": "פנים של אמא,"
  },
  {
   "start": 601.65,
   "end": 603.11,
   "text": "של חום של אמא,"
  },
  {
   "start": 604.07,
   "end": 606.07,
   "text": "הייתה אומרת שמע ישראל,"
  },
  {
   "start": 607.91,
   "end": 610.97,
   "text": "השם אלוקינו, השם אחד."
  },
  {
   "start": 611.63,
   "end": 613.75,
   "text": "ועם זה הילד היה הולך לשון."
  },
  {
   "start": 615.09,
   "end": 620.11,
   "text": "אז אני עמדתי במרכז חדר האוכל וצעקתי שמע ישראל"
  },
  {
   "start": 620.11,
   "end": 627.15,
   "text": "וכשצעקתי שמע ישראל ראית מה שקרה?"
  },
  {
   "start": 627.85,
   "end": 634.35,
   "text": "הילדים האלה ניתקו מהשולחנות ורצו כשהם צועקים מאמא מאמא"
  },
  {
   "start": 635.03,
   "end": 642.07,
   "text": "מאמא ביידיש זה אמא הם צעקו אמא וכי אני אמא שלהם"
  },
  {
   "start": 642.07,
   "end": 645.87,
   "text": "אלא זה הזכיר להם את איבא שלהם,"
  },
  {
   "start": 646.39,
   "end": 648.59,
   "text": "את האימא הקדושה שלהם."
  },
  {
   "start": 649.21,
   "end": 651.01,
   "text": "תדע לך, אב המנזר,"
  },
  {
   "start": 651.43,
   "end": 654.55,
   "text": "תדע לך ותזכור טוב, עם המנזר."
  },
  {
   "start": 655.21,
   "end": 657.19,
   "text": "אתם לקחתם את האימהות האלה,"
  },
  {
   "start": 657.99,
   "end": 660.99,
   "text": "לקחתם מהילדים האלה את האימהות שלהם,"
  },
  {
   "start": 661.65,
   "end": 662.53,
   "text": "הרגתם אותם,"
  },
  {
   "start": 663.27,
   "end": 668.07,
   "text": "שחטתם אותם, התעללתם בהם, רצחתם אותם,"
  },
  {
   "start": 669.23,
   "end": 671.57,
   "text": "אבל זה את הגוף שלהם,"
  },
  {
   "start": 672.65,
   "end": 674.99,
   "text": "את הגוף הצלחתם לקחת."
  },
  {
   "start": 676.11,
   "end": 676.89,
   "text": "אבל תאימא,"
  },
  {
   "start": 677.49,
   "end": 679.45,
   "text": "תא נשמה של אימא,"
  },
  {
   "start": 679.81,
   "end": 683.37,
   "text": "תרוח של אימא הקדושה של עם ישראל,"
  },
  {
   "start": 683.75,
   "end": 686.01,
   "text": "את האימהות האלה לא ניצחתם."
  },
  {
   "start": 686.47,
   "end": 688.29,
   "text": "האימהות האלה זה נצח."
  },
  {
   "start": 688.93,
   "end": 693.25,
   "text": "האימהות אלה השרישו לילדים שלהם את ההמשכיות,"
  },
  {
   "start": 693.63,
   "end": 695.57,
   "text": "את העוצמה שלהם."
  },
  {
   "start": 695.89,
   "end": 697.35,
   "text": "את זה אי אפשר לנצח."
  },
  {
   "start": 698.17,
   "end": 701.33,
   "text": "כי אימא יהודיה אי אפשר לנצח."
  },
  {
   "start": 701.57,
   "end": 705.61,
   "text": "אימא זה עוצמה, אימא זה נצח."
  },
  {
   "start": 707.13,
   "end": 709.09,
   "text": "את זה אי אפשר לנצח,"
  },
  {
   "start": 709.77,
   "end": 711.59,
   "text": "את זה אי אפשר לנצח."
  },
  {
   "start": 711.93,
   "end": 714.11,
   "text": "האימהות האלה ניצחו אתכם,"
  },
  {
   "start": 714.63,
   "end": 717.89,
   "text": "והילדים האלה חוזרים איתי הביתה."
  },
  {
   "start": 721.62,
   "end": 726.2,
   "text": "חזרו לארץ ישראל, אל דרך אימא שלהם,"
  },
  {
   "start": 728.23,
   "end": 736.82,
   "text": "והם היום איתנו, בנושא,"
  },
  {
   "start": 737.42,
   "end": 737.8,
   "text": "אולי,"
  },
  {
   "start": 738.08,
   "end": 743.78,
   "text": "החשוב והנערץ של כל יהודי ויהודי,"
  },
  {
   "start": 744.64,
   "end": 747.68,
   "text": "המושג הנפלא הזה של אמא."
  },
  {
   "start": 749.52,
   "end": 752.14,
   "text": "התפקיד המפואר הזה של אמא,"
  },
  {
   "start": 752.58,
   "end": 753.86,
   "text": "את התפקיד הנפלא הזה,"
  },
  {
   "start": 754.26,
   "end": 757.96,
   "text": "זכתה בת ישראל, אותו יהלום מופלא,"
  },
  {
   "start": 758.26,
   "end": 760.7,
   "text": "ביתו של מלך מלכי המלאכים הקדוש ברוך הוא,"
  },
  {
   "start": 761.16,
   "end": 763.96,
   "text": "לשאת בגאון והדר."
  },
  {
   "start": 764.36,
   "end": 766.06,
   "text": "היום נדבר על אמא."
  },
  {
   "start": 766.06,
   "end": 768.72,
   "text": "לא פחות ולא יותר."
  }
 ]
}