{
 "disc": "30ר- אמא",
 "track": "Track03",
 "duration": 842.184,
 "segments": [
  {
   "start": 5.99,
   "end": 7.69,
   "text": "אמא, מה זה אמא?"
  },
  {
   "start": 8.65,
   "end": 9.71,
   "text": "מה זה כוח של אמא?"
  },
  {
   "start": 11.21,
   "end": 12.23,
   "text": "אתם יודעים, עם ישראל,"
  },
  {
   "start": 12.93,
   "end": 14.97,
   "text": "עם ישראל כולו ראה עליות,"
  },
  {
   "start": 16.23,
   "end": 17.15,
   "text": "ראה גם מורדות."
  },
  {
   "start": 18.73,
   "end": 23.19,
   "text": "אחד הרגעים הקשים ביותר היה בתום תקופת בית המקדש הראשון."
  },
  {
   "start": 24.77,
   "end": 25.83,
   "text": "תקופה של חורבן."
  },
  {
   "start": 26.73,
   "end": 28.61,
   "text": "תקופה של כאב וצער."
  },
  {
   "start": 29.93,
   "end": 30.93,
   "text": "ובתקופה כזאת"
  },
  {
   "start": 31.89,
   "end": 34.45,
   "text": "נוצצה לה דמותה המופלאה של אמא."
  },
  {
   "start": 36.25,
   "end": 42.88,
   "text": "כדאי שכל בת ישראל תדע, שכל אחת תדע את העוצמה האמיתית שגלומה בה,"
  },
  {
   "start": 43.86,
   "end": 48.82,
   "text": "שהיא מסתובבת, שהיא הולכת לכל מקום שהיא הולכת, תדע כמה היא שווה,"
  },
  {
   "start": 49.4,
   "end": 53.48,
   "text": "כמה היא יקרה, יהלום נפלא של השם יתברך."
  },
  {
   "start": 55.53,
   "end": 56.73,
   "text": "אז בואו בעזרת השם,"
  },
  {
   "start": 57.17,
   "end": 59.13,
   "text": "בואו נניע את גלגלי ההיסטוריה קצת אחורה,"
  },
  {
   "start": 59.81,
   "end": 61.79,
   "text": "להכיר את המהות המופלאה הזאת של אמא,"
  },
  {
   "start": 63.11,
   "end": 66.01,
   "text": "איך היא הטביעה את חותמה על כל עם ישראל."
  },
  {
   "start": 66.73,
   "end": 68.15,
   "text": "מכאן נלמד ונשאב כוח,"
  },
  {
   "start": 68.79,
   "end": 69.11,
   "text": "איך האימהות,"
  },
  {
   "start": 71.25,
   "end": 72.19,
   "text": "אתם בנות ישראל,"
  },
  {
   "start": 74.9,
   "end": 75.48,
   "text": "תשפיעו"
  },
  {
   "start": 76.48,
   "end": 78.06,
   "text": "כוח לכל עם ישראל."
  },
  {
   "start": 79.54,
   "end": 81.52,
   "text": "כל עם ישראל למעשה זקוק לכם."
  },
  {
   "start": 84.26,
   "end": 85.76,
   "text": "בואו נניע את גלגלי ההיסטוריה אחורה,"
  },
  {
   "start": 87.22,
   "end": 90.92,
   "text": "אל תקופת בית המקדש הראשון, או יותר נכון, חורבן בית המקדש."
  },
  {
   "start": 92.8,
   "end": 94.24,
   "text": "בתום החורבן,"
  },
  {
   "start": 94.88,
   "end": 96.14,
   "text": "הכיבוש של ירושלים,"
  },
  {
   "start": 96.94,
   "end": 99.82,
   "text": "מתנהל לו מסע, מצעד של מוות,"
  },
  {
   "start": 100.5,
   "end": 101.7,
   "text": "מירושלים לבבל."
  },
  {
   "start": 102.24,
   "end": 102.94,
   "text": "עם ישראל,"
  },
  {
   "start": 103.52,
   "end": 107.12,
   "text": "נלקח בשבי, צער, כאב, יתמות."
  },
  {
   "start": 108.6,
   "end": 114.66,
   "text": "מי ילמד זכות על עם ישראל גשם בשמיים."
  },
  {
   "start": 116.22,
   "end": 116.76,
   "text": "הנשמות"
  },
  {
   "start": 117.36,
   "end": 121.04,
   "text": "של מנהיגי העם, מנהיגי האומה העברית, אברהם,"
  },
  {
   "start": 121.6,
   "end": 122.22,
   "text": "יצחק"
  },
  {
   "start": 122.94,
   "end": 123.7,
   "text": "ויעקב"
  },
  {
   "start": 124.62,
   "end": 128.12,
   "text": "קמים ובאים לפני כיסא הכבוד,"
  },
  {
   "start": 128.86,
   "end": 131.28,
   "text": "מבקשים ומתחננים על העם ישראל."
  },
  {
   "start": 131.98,
   "end": 134.32,
   "text": "אברהם, אבי האומה העברית,"
  },
  {
   "start": 135.32,
   "end": 143.7,
   "text": "פונה ומתחנן ולא מצליח לשנות את רוע הגזירה כי עם ישראל חטא כל כך,"
  },
  {
   "start": 145.54,
   "end": 146.94,
   "text": "פגם כל כך."
  },
  {
   "start": 149.08,
   "end": 149.84,
   "text": "יצחק,"
  },
  {
   "start": 150.68,
   "end": 152.02,
   "text": "יצחק עולה תמימה,"
  },
  {
   "start": 153.1,
   "end": 154.14,
   "text": "מנסה את חלקו,"
  },
  {
   "start": 155.56,
   "end": 156.46,
   "text": "וגם הוא לא מצליח."
  },
  {
   "start": 157.92,
   "end": 158.44,
   "text": "יעקב,"
  },
  {
   "start": 160.26,
   "end": 162.5,
   "text": "אשתם יושב אוהלים, עמוד התורה."
  },
  {
   "start": 163.76,
   "end": 164.98,
   "text": "פונה ומתחנן."
  },
  {
   "start": 166.7,
   "end": 169.3,
   "text": "פונה ומבקש על עם ישראל,"
  },
  {
   "start": 173.22,
   "end": 174.52,
   "text": "וגם הוא לא מצליח."
  },
  {
   "start": 179.66,
   "end": 184.0,
   "text": "משה, הרועה הנאמן מנסה אף הוא,"
  },
  {
   "start": 187.74,
   "end": 189.14,
   "text": "וגם הוא לא מצליח."
  },
  {
   "start": 191.78,
   "end": 192.18,
   "text": "ואז,"
  },
  {
   "start": 193.88,
   "end": 197.12,
   "text": "כשנדמה שאין יותר סיכוי,"
  },
  {
   "start": 198.12,
   "end": 202.16,
   "text": "עם ישראל יוצא לדרך שחס וחלילה אולי לא יחזור משם?"
  },
  {
   "start": 203.34,
   "end": 204.64,
   "text": "נראה לכאורה שאין סיכוי,"
  },
  {
   "start": 205.48,
   "end": 210.58,
   "text": "אין מה שיכול לעורר רחמים על העם ישראל."
  },
  {
   "start": 215.67,
   "end": 218.07,
   "text": "אז למטה, בכדור הארץ,"
  },
  {
   "start": 218.93,
   "end": 221.51,
   "text": "עוברים עם ישראל במצעד המוות,"
  },
  {
   "start": 222.55,
   "end": 223.65,
   "text": "על יד בית לחם,"
  },
  {
   "start": 227.08,
   "end": 228.46,
   "text": "קבר של אימא גדולה,"
  },
  {
   "start": 229.62,
   "end": 231.94,
   "text": "קבר של האימא הגדולה של עם ישראל,"
  },
  {
   "start": 233.04,
   "end": 234.02,
   "text": "קבר רחל,"
  },
  {
   "start": 240.0,
   "end": 241.08,
   "text": "למעלה בשמיים."
  },
  {
   "start": 242.94,
   "end": 244.52,
   "text": "קול ברמה נשמע,"
  },
  {
   "start": 245.24,
   "end": 246.12,
   "text": "שם למעלה,"
  },
  {
   "start": 246.98,
   "end": 248.42,
   "text": "בבית דין של מעלה,"
  },
  {
   "start": 249.16,
   "end": 253.16,
   "text": "שם למעלה מול כיסא הכבוד קול ברמה נשמע,"
  },
  {
   "start": 255.02,
   "end": 257.24,
   "text": "נשמע קול, קול שונה,"
  },
  {
   "start": 260.69,
   "end": 263.71,
   "text": "קול נהי בכי תמרורים,"
  },
  {
   "start": 264.41,
   "end": 265.43,
   "text": "קול של בכי."
  },
  {
   "start": 267.01,
   "end": 273.29,
   "text": "אמא רחל, הנשמה של האמא של עם ישראל, היא מתעוררת לה."
  },
  {
   "start": 274.27,
   "end": 276.17,
   "text": "אמא רחל באה עם בכי,"
  },
  {
   "start": 277.03,
   "end": 279.25,
   "text": "עם נהים, תמרורים,"
  },
  {
   "start": 279.75,
   "end": 281.93,
   "text": "היא באה עם בכי של אימא בלי הסברים,"
  },
  {
   "start": 282.75,
   "end": 285.51,
   "text": "רק עם בכי של אימא אני אימא שלהם,"
  },
  {
   "start": 285.83,
   "end": 286.87,
   "text": "והם הילדים,"
  },
  {
   "start": 287.19,
   "end": 290.55,
   "text": "הילדים שלנו, הילדים שלך, אבא שבשמיים,"
  },
  {
   "start": 290.87,
   "end": 296.79,
   "text": "והיא רק בוכה ובוכה ובוכה בכי של אימא, אימא זה רגש,"
  },
  {
   "start": 297.19,
   "end": 298.15,
   "text": "אימא זה לא דיבורים,"
  },
  {
   "start": 298.45,
   "end": 299.31,
   "text": "זה רגש,"
  },
  {
   "start": 299.63,
   "end": 303.79,
   "text": "זה עוצמה שנובעת מהלב, אימא זה כולה נתינה,"
  },
  {
   "start": 303.79,
   "end": 308.83,
   "text": "והבכי הזה והעוצמה האמהית הזאת"
  },
  {
   "start": 311.71,
   "end": 313.37,
   "text": "את שערי הרחמים"
  },
  {
   "start": 314.81,
   "end": 322.05,
   "text": "עד לכך שמורה עולם אומר מנעי קולך מבכי ועינייך מדמעה"
  },
  {
   "start": 327.32,
   "end": 330.16,
   "text": "מורה עולם רואה שרחל מענה להנחם"
  },
  {
   "start": 330.72,
   "end": 336.16,
   "text": "מנסים להרגיע אותה והיא אומרת לא זה הילדים שלי אני בוכה אימא שלי בוכה"
  },
  {
   "start": 337.12,
   "end": 338.88,
   "text": "אני חייבת להגן על הילדים"
  },
  {
   "start": 338.88,
   "end": 355.06,
   "text": "מורה עולם אומר מנעי קולך מבכי ועיניך מפקי יש שכר לפעולתך ושבו פנים לגבולם"
  },
  {
   "start": 355.58,
   "end": 359.14,
   "text": "ריבונו של עולם מלך מלכי המלאכים הקדוש ברוך הוא"
  },
  {
   "start": 359.78,
   "end": 371.6,
   "text": "כשרחל באה ובוכה וגם כשמנסים לנחם אותה היא לא מוכנה להנחם היא לא מוכנה שום הסברים שום טיעונים שום כלום אני רוצה את הילדים שלי"
  },
  {
   "start": 372.5,
   "end": 375.68,
   "text": "בורא עולם כל כך שמח זה מה שהוא רצה לשמוע."
  },
  {
   "start": 376.6,
   "end": 381.48,
   "text": "את הכוח הזה הוא רצה לעורר כוח של אימא של רגש של לב."
  },
  {
   "start": 384.32,
   "end": 387.4,
   "text": "והכוח הזה, העוצמה האדירה הזו,"
  },
  {
   "start": 390.11,
   "end": 394.03,
   "text": "מזכה את כל עם ישראל לחזור חזרה."
  },
  {
   "start": 394.41,
   "end": 395.95,
   "text": "ושבו בנים לגבולם,"
  },
  {
   "start": 396.83,
   "end": 401.37,
   "text": "ועם ישראל שבעים שנה אחר כך חוזר אל ארץ ישראל."
  },
  {
   "start": 402.65,
   "end": 420.22,
   "text": "כוח של אימא ברמה נשמע."
  },
  {
   "start": 421.56,
   "end": 423.74,
   "text": "קול בכי נשמע שם במרומי שמיים."
  },
  {
   "start": 424.96,
   "end": 426.36,
   "text": "נהי בכי תמרורים."
  },
  {
   "start": 427.4,
   "end": 430.74,
   "text": "בכי של אמא, ללא הסברים, ללא שאלות."
  },
  {
   "start": 431.36,
   "end": 433.36,
   "text": "אמא, פשוט כל-כולה רגש,"
  },
  {
   "start": 433.8,
   "end": 435.0,
   "text": "כל-כולה עוצמה,"
  },
  {
   "start": 435.44,
   "end": 437.18,
   "text": "עוצמה של הגנה על הילדים שלה."
  },
  {
   "start": 438.28,
   "end": 439.6,
   "text": "רחל מבכה על בניה,"
  },
  {
   "start": 440.32,
   "end": 441.52,
   "text": "נענה להנחם."
  },
  {
   "start": 442.9,
   "end": 445.76,
   "text": "והתגובה שם בשמיים לא מאחרת לבוא."
  },
  {
   "start": 446.32,
   "end": 447.78,
   "text": "מנעי קולך מבכי."
  },
  {
   "start": 448.8,
   "end": 450.86,
   "text": "מול בכי של אמא אי אפשר לעמוד."
  },
  {
   "start": 451.78,
   "end": 452.84,
   "text": "ועינייך מדמעה."
  },
  {
   "start": 453.72,
   "end": 456.62,
   "text": "דמעות של אמא על הילדים שלה אינן חוזרות ריקם."
  },
  {
   "start": 457.96,
   "end": 459.78,
   "text": "כי יש שכר לפעולתך."
  },
  {
   "start": 460.32,
   "end": 463.62,
   "text": "מול מסירות הנפש של אמא אי אפשר לעמוד."
  },
  {
   "start": 464.36,
   "end": 466.1,
   "text": "ושבו בנים לגבולם."
  },
  {
   "start": 466.54,
   "end": 467.9,
   "text": "בזכותך, אמא רחל,"
  },
  {
   "start": 468.32,
   "end": 473.02,
   "text": "כל עם ישראל יחזור תוך שבעים שנה בסך הכל לארץ ישראל,"
  },
  {
   "start": 473.42,
   "end": 474.64,
   "text": "ויבנה את בית המקדש השני."
  },
  {
   "start": 476.28,
   "end": 477.1,
   "text": "זהו כוח של אמא."
  },
  {
   "start": 478.0,
   "end": 481.9,
   "text": "אמא, אמא מגדלת ומגוננת ומעצבת את הילדים שלה."
  },
  {
   "start": 483.94,
   "end": 486.3,
   "text": "כל בת ישראל יש לך את הכוח הזה, כוח של אמא,"
  },
  {
   "start": 486.96,
   "end": 490.32,
   "text": "לגדל, לגונן, לעצב את הילדים,"
  },
  {
   "start": 490.64,
   "end": 493.06,
   "text": "את הילדים שלך, את הילדים של עם ישראל."
  },
  {
   "start": 493.88,
   "end": 496.64,
   "text": "והקדוש ברוך הוא שומע את רחל,"
  },
  {
   "start": 497.7,
   "end": 502.84,
   "text": "במידה כנגד מידה, מגדל, מגונן ועונה לה לתחינותיה."
  },
  {
   "start": 507.2,
   "end": 508.06,
   "text": "אבל זה עוד לא נגמר."
  },
  {
   "start": 510.88,
   "end": 514.88,
   "text": "חלפו להם שנים אלפיים ארץ ישראל."
  },
  {
   "start": 516.38,
   "end": 517.18,
   "text": "ראש ישיבת מיר,"
  },
  {
   "start": 518.56,
   "end": 522.1,
   "text": "הגאון הגדול רבי חיים לייב שמולביץ', זכר צדיק לברכה,"
  },
  {
   "start": 523.16,
   "end": 526.14,
   "text": "עושה את דרכו עם תלמידיו לבית לחם"
  },
  {
   "start": 527.26,
   "end": 528.24,
   "text": "אל קבר רחל."
  },
  {
   "start": 530.51,
   "end": 532.83,
   "text": "שם בקבר רחל הוא ניצב לו בראש תלמידיו,"
  },
  {
   "start": 533.85,
   "end": 534.75,
   "text": "מרכין ראשו"
  },
  {
   "start": 537.4,
   "end": 539.18,
   "text": "ובוכה עבור כלל ישראל."
  },
  {
   "start": 542.34,
   "end": 544.7,
   "text": "שם אל מול הקבר של האמא הגדולה,"
  },
  {
   "start": 545.24,
   "end": 546.58,
   "text": "הוא מתחנן ואומר,"
  },
  {
   "start": 547.26,
   "end": 548.5,
   "text": "אמא רחל."
  },
  {
   "start": 549.24,
   "end": 554.16,
   "text": "ריבונו של עולם אמר לך, רחל, רחל, מן העיק הולך מפחי,"
  },
  {
   "start": 554.82,
   "end": 556.1,
   "text": "ועינייך מדמעה."
  },
  {
   "start": 557.58,
   "end": 559.68,
   "text": "ואני חיים הקטן אומר לך,"
  },
  {
   "start": 560.36,
   "end": 563.28,
   "text": "אמא רחל, תבקי אמא,"
  },
  {
   "start": 563.8,
   "end": 564.48,
   "text": "תבקי,"
  },
  {
   "start": 565.12,
   "end": 567.18,
   "text": "תבקי אמא על עם ישראל,"
  },
  {
   "start": 567.66,
   "end": 569.74,
   "text": "שיסתיימו כבר הצרות שלנו,"
  },
  {
   "start": 570.56,
   "end": 571.62,
   "text": "שלא יהיו עוד פיגועים,"
  },
  {
   "start": 571.62,
   "end": 591.03,
   "text": "לא יהיו יתומים ואלמנות עניים ומובטלים חולים וסובלים ועקרות שלא יהיה עוד כאב וצער תבקיא אמא"
  },
  {
   "start": 591.89,
   "end": 601.56,
   "text": "תבקיא הגאון הגדול עם כל ישיבת מיר ידעו לאן ללכת לאמא"
  },
  {
   "start": 602.68,
   "end": 608.46,
   "text": "להפעיל רחמים בשמיים דרך עוצמה אדירה ושמעים"
  },
  {
   "start": 610.34,
   "end": 618.1,
   "text": "כך כלל ישראל לאורך שנות אלפיים נשאה עיניים מלאות תקווה וערצה"
  },
  {
   "start": 618.8,
   "end": 623.86,
   "text": "אל דמות עטורת הוד שבנתה את האומה היהודית כל השנים,"
  },
  {
   "start": 627.09,
   "end": 631.83,
   "text": "אותה אמא שחינכה ועיצבה את נזר הבריאה,"
  },
  {
   "start": 633.59,
   "end": 642.01,
   "text": "את האדם שמשהו קרה לפתע מוצאת את עצמה."
  },
  {
   "start": 643.03,
   "end": 646.57,
   "text": "בת ישראל קדושה בונה לה צורת חיים אחרת."
  },
  {
   "start": 647.47,
   "end": 652.61,
   "text": "שבה לפתע היא מקדישה את מירב הזמן ותשומת הלב למחשב,"
  },
  {
   "start": 654.47,
   "end": 655.75,
   "text": "למשרד,"
  },
  {
   "start": 657.19,
   "end": 658.25,
   "text": "לקריירה,"
  },
  {
   "start": 659.67,
   "end": 660.69,
   "text": "לכל הסובב."
  },
  {
   "start": 662.53,
   "end": 662.73,
   "text": "אבל,"
  },
  {
   "start": 663.37,
   "end": 664.23,
   "text": "אבל שם,"
  },
  {
   "start": 664.77,
   "end": 665.69,
   "text": "שם מאחור,"
  },
  {
   "start": 666.63,
   "end": 668.67,
   "text": "נותרות להם זוג עיניים יתומות,"
  },
  {
   "start": 669.43,
   "end": 673.01,
   "text": "שזקוקות יותר מכל דבר אחר"
  },
  {
   "start": 674.07,
   "end": 675.25,
   "text": "לאמא שתדריך,"
  },
  {
   "start": 675.83,
   "end": 676.69,
   "text": "אימא שתוביל,"
  },
  {
   "start": 677.33,
   "end": 678.39,
   "text": "אימא שתגונן,"
  },
  {
   "start": 679.11,
   "end": 681.03,
   "text": "אימא שתקדיש מהזמן שלה,"
  },
  {
   "start": 682.09,
   "end": 683.21,
   "text": "את רוב הזמן שלה,"
  },
  {
   "start": 683.83,
   "end": 687.35,
   "text": "שתמסור את עצמה עבור היקר מכל באמת,"
  },
  {
   "start": 687.85,
   "end": 688.91,
   "text": "עבור הילדים שלה,"
  },
  {
   "start": 689.61,
   "end": 691.75,
   "text": "עבור העתיד של כל עם ישראל,"
  },
  {
   "start": 692.63,
   "end": 705.41,
   "text": "עבור שיא התחכום והאינטליגנציה, ייעלם מחשב,"
  },
  {
   "start": 706.19,
   "end": 708.67,
   "text": "ולו המחשב היוקרתי ביותר."
  },
  {
   "start": 711.56,
   "end": 712.84,
   "text": "איש כמעט לא יתרגש,"
  },
  {
   "start": 712.84,
   "end": 715.76,
   "text": "אבל כאשר נעלם אדם,"
  },
  {
   "start": 716.8,
   "end": 719.86,
   "text": "מדינה שלמה עומדת על הרגליים."
  },
  {
   "start": 720.52,
   "end": 722.5,
   "text": "כולם יודעים שהאדם כל כך חשוב,"
  },
  {
   "start": 723.82,
   "end": 725.78,
   "text": "ותפקיד כל כך רם מעלה."
  },
  {
   "start": 726.78,
   "end": 732.24,
   "text": "לבנות אדם כל כך חשוב, אסור לנו להפקיר."
  },
  {
   "start": 733.32,
   "end": 734.48,
   "text": "צריך לדעת את האמת,"
  },
  {
   "start": 735.22,
   "end": 737.06,
   "text": "שום גן או מעון,"
  },
  {
   "start": 737.74,
   "end": 740.2,
   "text": "וכל הגנים והמעונות טובים,"
  },
  {
   "start": 740.84,
   "end": 744.2,
   "text": "אבל שום גן או מעון לא יכול להיות תחליף לאימא."
  },
  {
   "start": 746.85,
   "end": 749.33,
   "text": "בשום גן או מעון אין את המתכון המיוחד הזה,"
  },
  {
   "start": 749.97,
   "end": 754.13,
   "text": "שגורם להצמחת מנהיג או מנהיגה, המתכון שלא נס לחו,"
  },
  {
   "start": 754.75,
   "end": 759.91,
   "text": "דמעות של אימא, אכפתיות והקרבה של אישה לפרי בטנה."
  },
  {
   "start": 764.16,
   "end": 766.26,
   "text": "ואין הכוונה חלילה שאישה,"
  },
  {
   "start": 767.34,
   "end": 768.52,
   "text": "אם היא צריכה, לא תעבוד."
  },
  {
   "start": 771.46,
   "end": 772.76,
   "text": "בלי צריכה לדעת כל אישה,"
  },
  {
   "start": 775.12,
   "end": 778.94,
   "text": "שיש לה את התפקיד הנעלה ביותר שאפשר לצפות."
  },
  {
   "start": 779.26,
   "end": 789.32,
   "text": "כל בת ישראל,"
  },
  {
   "start": 790.52,
   "end": 792.88,
   "text": "על כל צעד ושעל שאת עושה בעולם הזה."
  },
  {
   "start": 794.0,
   "end": 795.32,
   "text": "תדעי שמצפים ממך,"
  },
  {
   "start": 798.48,
   "end": 799.5,
   "text": "שכל מה שתעשי,"
  },
  {
   "start": 800.62,
   "end": 802.66,
   "text": "את משפיעה על הילדים שלך,"
  },
  {
   "start": 805.46,
   "end": 806.4,
   "text": "לפני שהם נולדים,"
  },
  {
   "start": 807.34,
   "end": 810.36,
   "text": "בזמן שהם נולדים, אחרי שהם נולדים."
  },
  {
   "start": 811.2,
   "end": 812.86,
   "text": "את אימא, את מנהיגה,"
  },
  {
   "start": 814.92,
   "end": 816.28,
   "text": "אסור לך לשכוח את זה."
  },
  {
   "start": 817.46,
   "end": 819.78,
   "text": "כל מעשה שאת עושה משפיע."
  },
  {
   "start": 820.78,
   "end": 822.04,
   "text": "משפיע על העתיד שלך,"
  },
  {
   "start": 822.4,
   "end": 823.86,
   "text": "על העתיד של הילדים שלך,"
  },
  {
   "start": 824.26,
   "end": 826.1,
   "text": "על העתיד של עם ישראל."
  },
  {
   "start": 827.32,
   "end": 830.96,
   "text": "כל כך הרבה אחריות על כתפיים של אמא."
  }
 ]
}