{
 "disc": "30ר- אמא",
 "track": "Track08",
 "duration": 407.16,
 "segments": [
  {
   "start": 0.24,
   "end": 12.55,
   "text": "בת ישראל חשובה."
  },
  {
   "start": 14.13,
   "end": 17.33,
   "text": "נשמה קדושה, הטי בבקשה אוזן."
  },
  {
   "start": 18.25,
   "end": 19.09,
   "text": "משה רבנו."
  },
  {
   "start": 19.69,
   "end": 25.27,
   "text": "משה רבנו היה גואלם של ישראל, הנביא הגדול ביותר שקם בהיסטוריה העולמית."
  },
  {
   "start": 26.53,
   "end": 29.59,
   "text": "היו לו מספר שמות שהוא נקרא בהם,"
  },
  {
   "start": 31.27,
   "end": 33.93,
   "text": "ודווקא הוא נקרא בשם שנתנה לו הבת של פרעה,"
  },
  {
   "start": 34.93,
   "end": 35.71,
   "text": "משה."
  },
  {
   "start": 36.71,
   "end": 37.05,
   "text": "למה?"
  },
  {
   "start": 37.81,
   "end": 38.55,
   "text": "כי זה השם"
  },
  {
   "start": 39.25,
   "end": 40.79,
   "text": "של האישה שגידלה אותו,"
  },
  {
   "start": 42.23,
   "end": 45.43,
   "text": "שמסרה נפש עבורו, שעיצבה אותו."
  },
  {
   "start": 46.77,
   "end": 47.37,
   "text": "אז זה השם"
  },
  {
   "start": 48.43,
   "end": 52.29,
   "text": "שנישא בפי כל, משה, זכתה לעולם הבא,"
  },
  {
   "start": 52.93,
   "end": 55.05,
   "text": "להיכל שלם בעולם הבא."
  },
  {
   "start": 55.71,
   "end": 58.15,
   "text": "רק על זה שהיא גידלה בן כמו משה רבנו,"
  },
  {
   "start": 58.69,
   "end": 62.21,
   "text": "שמואל, הנביא הגדול של עם ישראל,"
  },
  {
   "start": 63.39,
   "end": 64.67,
   "text": "אומר ספר הספרים,"
  },
  {
   "start": 65.51,
   "end": 66.83,
   "text": "היה עוטה את המעיל,"
  },
  {
   "start": 67.37,
   "end": 69.13,
   "text": "מעיל מיוחד של אמא שלו."
  },
  {
   "start": 69.81,
   "end": 70.65,
   "text": "עם המעיל הזה,"
  },
  {
   "start": 71.19,
   "end": 72.49,
   "text": "זה המעיל שאמא תפרה לו."
  },
  {
   "start": 73.01,
   "end": 76.21,
   "text": "הוא היה מסתובב והולך, מזכה את כל עם ישראל."
  },
  {
   "start": 77.41,
   "end": 78.55,
   "text": "מחובר לאמא שלו."
  },
  {
   "start": 79.51,
   "end": 80.31,
   "text": "דוד המלך,"
  },
  {
   "start": 80.85,
   "end": 83.67,
   "text": "מלך המשיח, מלך ישראל, חי וקיים."
  },
  {
   "start": 84.25,
   "end": 85.65,
   "text": "הייתה לו ילדות קשה."
  },
  {
   "start": 86.31,
   "end": 89.35,
   "text": "מוזר הייתי לאחיי, נוכרי לבני אמי,"
  },
  {
   "start": 89.83,
   "end": 90.67,
   "text": "ורק אמא שלו,"
  },
  {
   "start": 91.33,
   "end": 92.57,
   "text": "נצוות בתדיאל."
  },
  {
   "start": 93.71,
   "end": 95.81,
   "text": "אמא שלו הייתה איתו, תומכת בו,"
  },
  {
   "start": 96.35,
   "end": 97.53,
   "text": "מטפחת אותו."
  },
  {
   "start": 98.11,
   "end": 100.63,
   "text": "גם כשהוא היה נשלח למרעה כרועה פשוט,"
  },
  {
   "start": 101.13,
   "end": 102.59,
   "text": "מי שהייתה מקבלת אותו בבית,"
  },
  {
   "start": 102.97,
   "end": 104.17,
   "text": "זו הייתה אמא שלו."
  },
  {
   "start": 104.81,
   "end": 105.51,
   "text": "אמא שלו."
  },
  {
   "start": 105.93,
   "end": 107.61,
   "text": "והוא זכה להיות מלך."
  },
  {
   "start": 108.25,
   "end": 110.25,
   "text": "היא גידלה את מלך ישראל."
  },
  {
   "start": 112.91,
   "end": 116.33,
   "text": "החפץ חיים גדול ישראל מופלא לפני כשבעים וחמש שנה."
  },
  {
   "start": 117.13,
   "end": 119.69,
   "text": "כשמסרו לו את התהילים של אמא שלו,"
  },
  {
   "start": 120.51,
   "end": 121.67,
   "text": "עיניו זלגו דמעות."
  },
  {
   "start": 122.89,
   "end": 127.45,
   "text": "הוא תפס את ספר התהילים הישן של אמא שלו ואמר,"
  },
  {
   "start": 128.13,
   "end": 131.25,
   "text": "אתם חושבים שנהייתי החפץ חיים בזכותי?"
  },
  {
   "start": 132.33,
   "end": 158.61,
   "text": "אם נהייתי משהו זה בזכות אמא שלי שישבה ושפכה דמעות בספר התהילים הזה שישראל מאיר שלה יצא יהודי כשר שישראל מאיר שלה יצא יהודי אוהב את השם והיום כשהגאולה בפתח מי מאותם האימהות שיבנו את בית המקדש השלישי?"
  },
  {
   "start": 159.11,
   "end": 162.95,
   "text": "מי תזכה להיות ממשיכת דרכן של האימהות הקדושות?"
  },
  {
   "start": 163.71,
   "end": 169.45,
   "text": "של עם ישראל שטבעו את חותמן בעולם כולו לעולמי עד?"
  },
  {
   "start": 172.24,
   "end": 172.94,
   "text": "מי זאת?"
  },
  {
   "start": 173.6,
   "end": 174.38,
   "text": "זו את."
  },
  {
   "start": 175.8,
   "end": 175.96,
   "text": "את."
  },
  {
   "start": 177.22,
   "end": 178.32,
   "text": "בת ישראל,"
  },
  {
   "start": 179.02,
   "end": 182.2,
   "text": "אימא בפוטנציה, אימא מופלאה."
  },
  {
   "start": 185.0,
   "end": 192.12,
   "text": "יש היום אלפי ועשרות אלפי עיניים של ילדים שזקוקים לאימא,"
  },
  {
   "start": 192.66,
   "end": 194.52,
   "text": "שתוליך אותם במי שעולה החיים,"
  },
  {
   "start": 195.26,
   "end": 196.62,
   "text": "שתראה להם את הדרך,"
  },
  {
   "start": 197.32,
   "end": 199.18,
   "text": "שתיתן להם את מה ששום אדם,"
  },
  {
   "start": 199.94,
   "end": 203.72,
   "text": "שום אדם בעולם לא יכול לעשות יותר טוב ממך."
  },
  {
   "start": 205.02,
   "end": 206.22,
   "text": "אהבה של אמא,"
  },
  {
   "start": 207.14,
   "end": 208.62,
   "text": "את זה רק את יכולה לתת."
  },
  {
   "start": 209.82,
   "end": 212.66,
   "text": "תשומת לב של אמא, חינוך של אמא."
  },
  {
   "start": 214.85,
   "end": 215.53,
   "text": "אז תגידי לי,"
  },
  {
   "start": 216.35,
   "end": 217.25,
   "text": "איפה את אמא?"
  },
  {
   "start": 218.35,
   "end": 219.17,
   "text": "איפה את אמא?"
  },
  {
   "start": 220.19,
   "end": 221.47,
   "text": "לילדים שלך."
  },
  {
   "start": 222.31,
   "end": 223.63,
   "text": "בשבילהם,"
  },
  {
   "start": 224.65,
   "end": 225.83,
   "text": "בשביל כל עם ישראל,"
  },
  {
   "start": 226.59,
   "end": 228.83,
   "text": "יותר מכל בשבילך."
  },
  {
   "start": 242.22,
   "end": 244.78,
   "text": "יש היום עשרות אלפי עיניים יתומות"
  },
  {
   "start": 245.5,
   "end": 248.76,
   "text": "של ילדים שזקוקים יותר מכל אימא,"
  },
  {
   "start": 249.46,
   "end": 250.2,
   "text": "לאימא שלהם."
  },
  {
   "start": 251.58,
   "end": 256.92,
   "text": "ויש כאלו שמאורות החיים השכיחו להם את התפקיד החשוב הזה,"
  },
  {
   "start": 257.3,
   "end": 259.14,
   "text": "את האוצר היקר ביותר בעולם."
  },
  {
   "start": 260.46,
   "end": 262.66,
   "text": "הן משאירות בידיים אחרות"
  },
  {
   "start": 263.6,
   "end": 270.11,
   "text": "ויוצאות להם לחפש כאחראית על קופסה מתחתית ושמה מחשב,"
  },
  {
   "start": 270.73,
   "end": 272.73,
   "text": "או על כל מוצר זה או אחר,"
  },
  {
   "start": 273.41,
   "end": 275.23,
   "text": "כמדפיסה מסמך זה או אחר,"
  },
  {
   "start": 276.51,
   "end": 277.77,
   "text": "כפקידה כאן או שם."
  },
  {
   "start": 279.79,
   "end": 280.95,
   "text": "כמה מחשב שווה,"
  },
  {
   "start": 281.85,
   "end": 283.21,
   "text": "כמה דף נייר שווה,"
  },
  {
   "start": 283.91,
   "end": 286.41,
   "text": "וכמה ילד או ילדה שווים."
  },
  {
   "start": 291.25,
   "end": 293.15,
   "text": "פרנסה זה נפלא,"
  },
  {
   "start": 293.83,
   "end": 294.23,
   "text": "זה טוב,"
  },
  {
   "start": 298.44,
   "end": 301.66,
   "text": "אבל שההגשמה העצמית"
  },
  {
   "start": 302.2,
   "end": 303.7,
   "text": "תהיה פרנסה?"
  },
  {
   "start": 306.22,
   "end": 308.64,
   "text": "שהייעוד בעולם יהיה תלוש משכורת?"
  },
  {
   "start": 309.86,
   "end": 310.86,
   "text": "זה אסור שיקרה."
  },
  {
   "start": 311.56,
   "end": 314.36,
   "text": "זה אובדן של התפקיד החשוב ביותר,"
  },
  {
   "start": 314.96,
   "end": 315.34,
   "text": "אמא."
  },
  {
   "start": 317.1,
   "end": 319.28,
   "text": "ובשמיים כל כך אוהבים,"
  },
  {
   "start": 319.82,
   "end": 323.1,
   "text": "כל כך ממתינים, מצפים בכליון עיניים."
  },
  {
   "start": 324.48,
   "end": 324.88,
   "text": "לך,"
  },
  {
   "start": 325.72,
   "end": 326.86,
   "text": "לך כן את,"
  },
  {
   "start": 327.5,
   "end": 327.92,
   "text": "אמא."
  },
  {
   "start": 328.68,
   "end": 330.24,
   "text": "תודה לך ששמעת לנו."
  },
  {
   "start": 331.14,
   "end": 332.14,
   "text": "אמא יקרה,"
  },
  {
   "start": 333.1,
   "end": 334.7,
   "text": "לך מוקדשים הדברים האלה,"
  },
  {
   "start": 335.36,
   "end": 339.44,
   "text": "שיוצאים מלב של ילדים שגדלו על ידי אמא,"
  },
  {
   "start": 340.06,
   "end": 341.84,
   "text": "ומתחננים ומבקשים,"
  },
  {
   "start": 342.48,
   "end": 342.8,
   "text": "אמא,"
  },
  {
   "start": 343.42,
   "end": 346.1,
   "text": "קומי, התנערי כי בא עורך."
  },
  {
   "start": 347.78,
   "end": 349.68,
   "text": "עוז והדר לבושה,"
  },
  {
   "start": 350.4,
   "end": 352.0,
   "text": "ותשחק ליום אחרון."
  },
  {
   "start": 354.1,
   "end": 356.62,
   "text": "עוז והדר לבושה של אמא,"
  },
  {
   "start": 357.34,
   "end": 358.44,
   "text": "זה הלבוש שלך,"
  },
  {
   "start": 358.96,
   "end": 361.52,
   "text": "זה האופנה שלעולם לא תחלוף,"
  },
  {
   "start": 362.14,
   "end": 376.27,
   "text": "זה התכשיטים המופלאים שלך עוז והדר לבושה עוז והדר לבושה ותשחק ליום אחרון אמא אמא"
  }
 ]
}