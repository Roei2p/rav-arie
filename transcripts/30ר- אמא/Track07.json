{
 "disc": "30ר- אמא",
 "track": "Track07",
 "duration": 528.168,
 "segments": [
  {
   "start": 12.13,
   "end": 13.23,
   "text": "אמא זו תורה."
  },
  {
   "start": 14.59,
   "end": 15.61,
   "text": "אמא זו תורה."
  },
  {
   "start": 16.17,
   "end": 17.13,
   "text": "תורה של התנהגות."
  },
  {
   "start": 18.23,
   "end": 20.55,
   "text": "תורה של מידות של דרך ארץ."
  },
  {
   "start": 20.89,
   "end": 23.07,
   "text": "תורה של צניעות ואצילות."
  },
  {
   "start": 23.89,
   "end": 26.41,
   "text": "אמא זו דרגה גבוהה."
  },
  {
   "start": 27.17,
   "end": 29.99,
   "text": "מאמא מצפים ליותר."
  },
  {
   "start": 32.12,
   "end": 35.76,
   "text": "ולכן גם כוח תפילה של אמא זה משהו מיוחד."
  },
  {
   "start": 37.04,
   "end": 38.04,
   "text": "גם לטווח ארוך."
  },
  {
   "start": 38.72,
   "end": 43.08,
   "text": "גם כשהיא לא מתכוונת אולי כל כך."
  },
  {
   "start": 44.06,
   "end": 46.32,
   "text": "כוח תפילה של אמא"
  },
  {
   "start": 47.12,
   "end": 48.46,
   "text": "זה משהו מיוחד."
  },
  {
   "start": 49.9,
   "end": 51.5,
   "text": "סיפר הרב ברוך הימן,"
  },
  {
   "start": 52.12,
   "end": 53.72,
   "text": "מזכה הרבים מירושלים."
  },
  {
   "start": 55.3,
   "end": 61.34,
   "text": "בתקופת ממשלת בן-גוריון היה שר חינוך ושמו זלמן ארן."
  },
  {
   "start": 62.8,
   "end": 64.5,
   "text": "אשתו הייתה עם שרידי מסורת."
  },
  {
   "start": 66.02,
   "end": 66.42,
   "text": "כלומר,"
  },
  {
   "start": 67.02,
   "end": 68.94,
   "text": "מה שהיא זכרה מהבית"
  },
  {
   "start": 70.52,
   "end": 72.4,
   "text": "זה את אמא מדליקה נרות שבת."
  },
  {
   "start": 73.14,
   "end": 73.9,
   "text": "ערב שבת,"
  },
  {
   "start": 75.04,
   "end": 77.02,
   "text": "ועל זה היא שברה כל ערב שבת."
  },
  {
   "start": 77.7,
   "end": 79.0,
   "text": "היא הייתה מדליקה נרות שבת,"
  },
  {
   "start": 79.9,
   "end": 80.94,
   "text": "והייתה מתפללת"
  },
  {
   "start": 81.64,
   "end": 82.54,
   "text": "על הילדים שלה."
  },
  {
   "start": 83.58,
   "end": 84.86,
   "text": "שהילדים שלה יהיו כמו,"
  },
  {
   "start": 86.12,
   "end": 90.24,
   "text": "יהיו כמו האדם שבעלה הריץ בן-גוריון."
  },
  {
   "start": 91.74,
   "end": 93.56,
   "text": "זה מה שהיא ספגה בבית מבעלה,"
  },
  {
   "start": 94.08,
   "end": 97.18,
   "text": "ועל זה התפללה באותה תקופה."
  },
  {
   "start": 98.18,
   "end": 105.36,
   "text": "בן גוריון שרצה לשכנע את הציבור ששומר תורה ומצוות בצדקת דרכו."
  },
  {
   "start": 107.02,
   "end": 110.48,
   "text": "הוא ביקש להיפגש עם המנהיג שמסמל את היהדות,"
  },
  {
   "start": 111.5,
   "end": 112.68,
   "text": "ואמרו לו, כן, יש,"
  },
  {
   "start": 113.3,
   "end": 114.04,
   "text": "יש מנהיג כזה."
  },
  {
   "start": 114.72,
   "end": 118.56,
   "text": "יש יהודי גדול תורה, קוראים לו החזון איש."
  },
  {
   "start": 118.94,
   "end": 120.72,
   "text": "ובן גוריון אמר, אני רוצה להיפגש איתו,"
  },
  {
   "start": 121.34,
   "end": 124.58,
   "text": "אני אשכנע אותו בצדקת דרכי."
  },
  {
   "start": 128.22,
   "end": 129.88,
   "text": "והוא נפגש פגישה היסטורית."
  },
  {
   "start": 130.68,
   "end": 131.66,
   "text": "עם החזון איש."
  },
  {
   "start": 133.82,
   "end": 135.0,
   "text": "הוא אמר לחזון איש,"
  },
  {
   "start": 136.58,
   "end": 138.46,
   "text": "תראה כבוד הרב, אנחנו הקמנו מדינה,"
  },
  {
   "start": 139.72,
   "end": 141.14,
   "text": "מדינה חדשה, מדינה מתקדמת."
  },
  {
   "start": 143.04,
   "end": 144.22,
   "text": "ואני חושב אולי,"
  },
  {
   "start": 145.1,
   "end": 145.9,
   "text": "אולי כדאי,"
  },
  {
   "start": 146.72,
   "end": 152.06,
   "text": "שהיהדות תפנה לנו קצת דרך מה אתה אומר כבוד הרב."
  },
  {
   "start": 152.76,
   "end": 153.76,
   "text": "בכל אופן אנחנו צעירים,"
  },
  {
   "start": 154.56,
   "end": 155.6,
   "text": "חדשים, מתקדמים."
  },
  {
   "start": 158.32,
   "end": 159.9,
   "text": "חייך החזון איש ואמר,"
  },
  {
   "start": 160.56,
   "end": 162.56,
   "text": "ראש הממשלה אפשר לשאול אותך שאלה?"
  },
  {
   "start": 164.08,
   "end": 165.3,
   "text": "בן-גוריון אמר כן,"
  },
  {
   "start": 166.66,
   "end": 169.84,
   "text": "והחזון איש אמר לו, יש לי שאלה, אני רוצה שתשפוט אתה."
  },
  {
   "start": 172.7,
   "end": 177.24,
   "text": "יש נהר גדול שמפריד בין שני חלקים של עיר,"
  },
  {
   "start": 178.06,
   "end": 180.1,
   "text": "וכדי לעבור את הנהר בנו גשר,"
  },
  {
   "start": 180.92,
   "end": 182.34,
   "text": "אבל בנו גשר צר,"
  },
  {
   "start": 183.2,
   "end": 186.16,
   "text": "גשר שיש בו מעבר לאדם אחד."
  },
  {
   "start": 189.65,
   "end": 190.45,
   "text": "בגשר הזה,"
  },
  {
   "start": 191.25,
   "end": 192.87,
   "text": "מצד אחד של הגשר מתקדם"
  },
  {
   "start": 194.77,
   "end": 195.71,
   "text": "בחור צעיר,"
  },
  {
   "start": 196.71,
   "end": 200.79,
   "text": "לבוש מרנסי ספורט, נעלי ספורט בריצה כלילה,"
  },
  {
   "start": 201.45,
   "end": 203.85,
   "text": "מתקרב אל עבר הגשר, אל צדו האחד של הגשר."
  },
  {
   "start": 204.65,
   "end": 205.43,
   "text": "מהצד השני,"
  },
  {
   "start": 206.19,
   "end": 208.25,
   "text": "מתקרב אל צדו השני אדם,"
  },
  {
   "start": 210.11,
   "end": 210.95,
   "text": "בא בשנים,"
  },
  {
   "start": 211.65,
   "end": 212.49,
   "text": "מבוגר,"
  },
  {
   "start": 213.47,
   "end": 215.09,
   "text": "נושא איתו משא כבד,"
  },
  {
   "start": 217.21,
   "end": 218.97,
   "text": "פוסע לו אט-אט בכבדות,"
  },
  {
   "start": 219.55,
   "end": 220.75,
   "text": "כי המשא כבד,"
  },
  {
   "start": 221.57,
   "end": 224.45,
   "text": "ושניהם יחדיו מגיעים בעת ובעונה אחת"
  },
  {
   "start": 225.03,
   "end": 226.33,
   "text": "אל שני צדי הגשר."
  },
  {
   "start": 227.01,
   "end": 231.69,
   "text": "יאמר לי ראש הממשלה מי צריך לפנות דרך למי?"
  },
  {
   "start": 232.61,
   "end": 241.69,
   "text": "הבחור הצעיר והספורטיבי והקליל שאין לו שום מסע על כתפיו או האדם המבוגר"
  },
  {
   "start": 243.07,
   "end": 244.01,
   "text": "עם המסע הכבד?"
  },
  {
   "start": 246.94,
   "end": 247.84,
   "text": "אמר ראש הממשלה"
  },
  {
   "start": 249.46,
   "end": 254.54,
   "text": "ודאי שהצעיר צריך לפנות דרך אל המבוגר."
  },
  {
   "start": 255.22,
   "end": 260.2,
   "text": "זו לא שאלה פשוט וברור שהצעיר צריך לפנות דרך"
  },
  {
   "start": 260.74,
   "end": 264.84,
   "text": "בפני המבוגר שנושא איתו מסע."
  },
  {
   "start": 269.5,
   "end": 271.2,
   "text": "חייך חזון איש ואמר,"
  },
  {
   "start": 271.82,
   "end": 276.02,
   "text": "ראש הממשלה ישמעו אוזניך מה שפיך מדבר."
  },
  {
   "start": 278.69,
   "end": 280.01,
   "text": "אתה בא ואתה אומר לי,"
  },
  {
   "start": 281.61,
   "end": 285.21,
   "text": "יש מדינה צעירה, הקמנו מדינה צעירה חדשה,"
  },
  {
   "start": 286.87,
   "end": 294.07,
   "text": "ואנחנו נושאים איתנו אומה קדושה של 3,300 שנה של היסטוריה,"
  },
  {
   "start": 294.67,
   "end": 295.61,
   "text": "של מסורת,"
  },
  {
   "start": 296.15,
   "end": 302.21,
   "text": "של אור לגויים, של משא כבד, של ספרים, של גדולי ישראל,"
  },
  {
   "start": 302.87,
   "end": 313.33,
   "text": "של נהרות של דם, של מסירות נפש של יהודים שמסרו את עצמם, שנהרגו ונטבחו לשמור על היהדות שלהם,"
  },
  {
   "start": 313.79,
   "end": 315.89,
   "text": "לשמור על האותנטיות שלהם,"
  },
  {
   "start": 316.31,
   "end": 320.51,
   "text": "על הקדושה שלהם, על היהדות שלהם, להישאר עם ישראל הקדוש."
  },
  {
   "start": 322.98,
   "end": 325.08,
   "text": "מי צריך לפנות דרך למי?"
  },
  {
   "start": 326.08,
   "end": 330.38,
   "text": "הצעיר ללא המסע, ללא ההיסטוריה המפוארת,"
  },
  {
   "start": 331.42,
   "end": 334.28,
   "text": "או המבוגר עם הניסיון,"
  },
  {
   "start": 334.84,
   "end": 335.6,
   "text": "עם החוכמה,"
  },
  {
   "start": 337.18,
   "end": 338.46,
   "text": "עם העבר המפואר."
  },
  {
   "start": 339.56,
   "end": 340.64,
   "text": "ועם עבר מפואר"
  },
  {
   "start": 341.96,
   "end": 344.94,
   "text": "אפשר לשאוף לעתיד מזהיר."
  },
  {
   "start": 346.22,
   "end": 348.54,
   "text": "למי שיש עבר, יש לו גם הווה,"
  },
  {
   "start": 349.08,
   "end": 351.02,
   "text": "והוא יכול להביט קדימה אל העתיד."
  },
  {
   "start": 352.76,
   "end": 353.84,
   "text": "כבוד ראש הממשלה,"
  },
  {
   "start": 354.52,
   "end": 356.94,
   "text": "מי צריך לפנות דרך בפני מי."
  },
  {
   "start": 358.48,
   "end": 359.96,
   "text": "וראש הממשלה בן-גוריון"
  },
  {
   "start": 360.7,
   "end": 361.52,
   "text": "הודה על האמת,"
  },
  {
   "start": 363.98,
   "end": 365.44,
   "text": "וכשהוא חזר חזרה,"
  },
  {
   "start": 366.38,
   "end": 367.18,
   "text": "הוא היה כל כך נפעם."
  },
  {
   "start": 369.28,
   "end": 370.62,
   "text": "הוא אמר לכל השרים,"
  },
  {
   "start": 370.96,
   "end": 373.32,
   "text": "וביניהם היה שר החינוך זלמן ארן,"
  },
  {
   "start": 373.96,
   "end": 375.8,
   "text": "אמר להם, תדעו לכם מה אני הלכתי,"
  },
  {
   "start": 376.54,
   "end": 378.94,
   "text": "וחשבתי שאני אפגוש רב,"
  },
  {
   "start": 379.56,
   "end": 381.02,
   "text": "ציפיתי לפגוש רב,"
  },
  {
   "start": 381.56,
   "end": 383.36,
   "text": "ופגשתי מלאך."
  },
  {
   "start": 383.36,
   "end": 387.3,
   "text": "לא פגשתי היום אדם, פגשתי מלאך."
  },
  {
   "start": 390.7,
   "end": 394.64,
   "text": "באותו ערב שזלמן ארן חזר הביתה,"
  },
  {
   "start": 395.22,
   "end": 401.86,
   "text": "סיפר לאשתו באיזו הערצה דיבר בן-גוריון על אותה אישיות מופלאה,"
  },
  {
   "start": 402.46,
   "end": 403.04,
   "text": "אותו רב,"
  },
  {
   "start": 403.58,
   "end": 404.96,
   "text": "קדוש בשם החזון איש,"
  },
  {
   "start": 408.89,
   "end": 409.59,
   "text": "ערב שבת."
  },
  {
   "start": 410.95,
   "end": 415.65,
   "text": "עומדת לה אשתו של זלמן ארן מול נרות שבת,"
  },
  {
   "start": 416.65,
   "end": 418.27,
   "text": "ומתפללת על הילדים שלה."
  },
  {
   "start": 419.99,
   "end": 421.61,
   "text": "ואז היא עושה חשבון, היא אומרת,"
  },
  {
   "start": 422.67,
   "end": 425.53,
   "text": "אם עד עכשיו התפללתי שהילדים יהיו כמו בן גוריון,"
  },
  {
   "start": 426.45,
   "end": 431.63,
   "text": "ובן גוריון מעריץ אישיות כמו החזון איש,"
  },
  {
   "start": 432.37,
   "end": 435.55,
   "text": "אז אני אתפלל שהילדים שלי יהיו כמו החזון איש."
  },
  {
   "start": 436.41,
   "end": 437.73,
   "text": "והיא התחילה להתפלל,"
  },
  {
   "start": 438.09,
   "end": 439.71,
   "text": "היא לא מכירה את החזון איש,"
  },
  {
   "start": 440.07,
   "end": 442.75,
   "text": "לא ראתה אותו עד אז, לא שמעה עליו,"
  },
  {
   "start": 443.19,
   "end": 449.03,
   "text": "אבל היא התחילה להתפלל בתפילה של אימא פשוטה שהילדים שלה יהיו כמו החזון איש."
  },
  {
   "start": 449.59,
   "end": 450.53,
   "text": "תפילה של אימא,"
  },
  {
   "start": 450.95,
   "end": 451.83,
   "text": "אולי בלי כוונה,"
  },
  {
   "start": 451.95,
   "end": 452.61,
   "text": "בלי ידיעה,"
  },
  {
   "start": 452.87,
   "end": 454.65,
   "text": "מתוך תמימות ופשיטות."
  },
  {
   "start": 455.35,
   "end": 456.99,
   "text": "מתוך תמימות ופשיטות."
  },
  {
   "start": 457.89,
   "end": 459.15,
   "text": "אבל תפילה של אימא,"
  },
  {
   "start": 462.71,
   "end": 464.29,
   "text": "סיים רבי ברוך הימן ואמר,"
  },
  {
   "start": 465.11,
   "end": 467.05,
   "text": "שואלים אותי לפעמים מה סיבת ההצלחה שלי,"
  },
  {
   "start": 467.55,
   "end": 469.85,
   "text": "מה מקור הכוח שלי לזכות את הרבים."
  },
  {
   "start": 470.83,
   "end": 471.81,
   "text": "צריך לדעת שהאישה,"
  },
  {
   "start": 472.33,
   "end": 476.57,
   "text": "אותה אישה ששינתה את התפילה שלה והתפללה על הילדים שלה,"
  },
  {
   "start": 477.39,
   "end": 478.95,
   "text": "שיצאו כמו החזון איש,"
  },
  {
   "start": 479.63,
   "end": 481.23,
   "text": "התפילה לא שבה ריקם."
  },
  {
   "start": 482.53,
   "end": 483.57,
   "text": "אני או הנכד שלה,"
  },
  {
   "start": 485.01,
   "end": 487.63,
   "text": "של אותה סבתא מופלאה,"
  },
  {
   "start": 487.95,
   "end": 490.13,
   "text": "של אותה אמא שהתפלאה אל הילדים שלה."
  },
  {
   "start": 491.69,
   "end": 493.27,
   "text": "חלק אולי יצאו כמו בן גוריון,"
  },
  {
   "start": 493.79,
   "end": 498.61,
   "text": "אבל חלק יצאו או משתדלים ללכת בדרכו של החזון איש."
  },
  {
   "start": 501.04,
