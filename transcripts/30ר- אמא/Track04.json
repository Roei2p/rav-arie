{
 "disc": "30ר- אמא",
 "track": "Track04",
 "duration": 521.184,
 "segments": [
  {
   "start": 8.2,
   "end": 15.42,
   "text": "משלחת של יהודים נשואי פנים היא קרבה לה אל פרדס חנה."
  },
  {
   "start": 17.5,
   "end": 25.56,
   "text": "רבי חיים לוין כיהן כרבה של פרדס חנה והם פנו אליו בבקשה להגיש את מועמדותו"
  },
  {
   "start": 26.4,
   "end": 28.84,
   "text": "כדי שהוא יוכל להיבחר לרב של ירושלים."
  },
  {
   "start": 29.28,
   "end": 37.18,
   "text": "הם פנו אליו ואמרו לו כבוד הרב אם הרב מציג את מועמדותו אנחנו מבטיחים לו שמרבית הסיכויים שהרב נבחר"
  },
  {
   "start": 41.16,
   "end": 43.1,
   "text": "והרב רבי חיים לוין התבונן,"
  },
  {
   "start": 44.9,
   "end": 47.52,
   "text": "חשב ואמר להם, אני רוצה לראות את הרשימה של המועמדים."
  },
  {
   "start": 48.68,
   "end": 51.02,
   "text": "ואז הם ערינו את הרשימה, הוא מסתכל, מביט ברשימה,"
  },
  {
   "start": 52.24,
   "end": 54.2,
   "text": "ושם ברשימה עיניו נעצרו מתבוננות בשם,"
  },
  {
   "start": 55.26,
   "end": 56.4,
   "text": "שם שהבזיק אל מול עיניו."
  },
  {
   "start": 57.2,
   "end": 57.64,
   "text": "ואז הוא אמר,"
  },
  {
   "start": 58.72,
   "end": 59.34,
   "text": "לא בא בחשבון."
  },
  {
   "start": 60.1,
   "end": 62.98,
   "text": "אני מסיר את המועמדות שלי לרבנות ירושלים."
  },
  {
   "start": 66.97,
   "end": 67.93,
   "text": "וכולם הופתעו."
  },
  {
   "start": 68.87,
   "end": 69.57,
   "text": "אבל הרב למה?"
  },
  {
   "start": 70.21,
   "end": 72.67,
   "text": "אבל הרב, אם הרב יגיש את המועמדות שלו,"
  },
  {
   "start": 72.67,
   "end": 75.27,
   "text": "והרב יבחר, למה הרב מסיר את המועמדות?"
  },
  {
   "start": 76.41,
   "end": 78.33,
   "text": "והם לחצו, הם רוצים תשובה."
  },
  {
   "start": 80.03,
   "end": 81.95,
   "text": "רבי חיים לוין אמר,"
  },
  {
   "start": 83.29,
   "end": 85.05,
   "text": "זכורני כשהייתי ילד קטן,"
  },
  {
   "start": 86.09,
   "end": 88.17,
   "text": "הייתי הולך עם אבא שלי אל הכותל המערבי."
  },
  {
   "start": 89.87,
   "end": 91.31,
   "text": "לפעמים קצת אחרי חצות,"
  },
  {
   "start": 92.47,
   "end": 93.59,
   "text": "או קצת לפני חצות,"
  },
  {
   "start": 94.01,
   "end": 95.07,
   "text": "היינו הולכים לכותל,"
  },
  {
   "start": 95.39,
   "end": 97.89,
   "text": "שם אבא היה נוהג להתפלל בבחיות על עם ישראל."
  },
  {
   "start": 99.11,
   "end": 99.99,
   "text": "ואני הייתי מלווה אותו."
  },
  {
   "start": 102.44,
   "end": 103.3,
   "text": "ולילה אחד,"
  },
  {
   "start": 104.48,
   "end": 107.62,
   "text": "לילה אחד בשיא הכפור הירושלמי,"
  },
  {
   "start": 108.36,
   "end": 108.72,
   "text": "שלג."
  },
  {
   "start": 111.13,
   "end": 113.99,
   "text": "אבא ואני פוסעים להם בסמטאות המובילות אל הכותל,"
  },
  {
   "start": 114.93,
   "end": 116.79,
   "text": "ואז אבא נעצר לפתע."
  },
  {
   "start": 117.67,
   "end": 118.97,
   "text": "שם, בפינה,"
  },
  {
   "start": 119.65,
   "end": 120.57,
   "text": "בפינת הסמטה,"
  },
  {
   "start": 121.41,
   "end": 121.93,
   "text": "מתחת"
  },
  {
   "start": 122.71,
   "end": 123.97,
   "text": "לפנס רחוב."
  },
  {
   "start": 125.19,
   "end": 125.83,
   "text": "ישבה לה דמות,"
  },
  {
   "start": 129.11,
   "end": 129.91,
   "text": "דמות קטנה,"
  },
  {
   "start": 132.59,
   "end": 137.09,
   "text": "ותפרה לה לאור הפנס."
  },
  {
   "start": 137.89,
   "end": 138.33,
   "text": "ואבא,"
  },
  {
   "start": 138.91,
   "end": 139.87,
   "text": "אבו ואני התקרבנו."
  },
  {
   "start": 143.21,
   "end": 146.15,
   "text": "הייתה זו צעירה יהודייה,"
  },
  {
   "start": 147.09,
   "end": 147.59,
   "text": "אלמנה,"
  },
  {
   "start": 149.05,
   "end": 151.87,
   "text": "שהתפרנסה כתופרת."
  },
  {
   "start": 152.93,
   "end": 156.11,
   "text": "באותה תקופה המצב הכלכלי היה קשה מאוד."
  },
  {
   "start": 156.97,
   "end": 160.11,
   "text": "גרביים לא היה כמו היום שאפשר לקנות חדשות,"
  },
  {
   "start": 161.25,
   "end": 162.51,
   "text": "אז כשאדם היה נקרע לו,"
  },
  {
   "start": 163.11,
   "end": 164.99,
   "text": "הגרביים היה לוקח אותם לתופרת,"
  },
  {
   "start": 165.91,
   "end": 166.61,
   "text": "ותמורת"
  },
  {
   "start": 167.81,
   "end": 170.79,
   "text": "מעות ספורות היא הייתה מתקנת"
  },
  {
   "start": 170.83,
   "end": 172.87,
   "text": "את הגרביים."
  },
  {
   "start": 173.65,
   "end": 176.75,
   "text": "אותה אישה צעירה הייתה מתפרנסת כתופרת גרביים."
  },
  {
   "start": 179.91,
   "end": 181.93,
   "text": "וכך היא יושבת לה שעת לילה מאוחרת"
  },
  {
   "start": 182.57,
   "end": 184.93,
   "text": "ותופרת לה גרביים"
  },
  {
   "start": 186.09,
   "end": 187.63,
   "text": "לאור מנורת הרחוב."
  },
  {
   "start": 189.09,
   "end": 191.83,
   "text": "והקור והשלג מקפיאים לה את האצבעות."
  },
  {
   "start": 194.02,
   "end": 194.52,
   "text": "והמחט"
  },
  {
   "start": 195.4,
   "end": 202.02,
   "text": "שנאחזה בידיים כבר קפואות מדי פעם הייתה דוקרת לה את היד."
  },
  {
   "start": 202.64,
   "end": 203.86,
   "text": "וזרזיף של דם"
  },
  {
   "start": 206.04,
   "end": 210.64,
   "text": "סוללו נתיב באגודל שלה,"
  },
  {
   "start": 211.36,
   "end": 212.68,
   "text": "אבל היא במסירות נפש."
  },
  {
   "start": 213.76,
   "end": 217.14,
   "text": "נחושה בדעתה הייתה תופרת ותופרת ותופרת,"
  },
  {
   "start": 217.46,
   "end": 219.2,
   "text": "ואבא כשראה את המחזה המרטיט הזה,"
  },
  {
   "start": 219.86,
   "end": 221.74,
   "text": "הוא אמר לה, בת ישראל קדושה,"
  },
  {
   "start": 222.88,
   "end": 223.4,
   "text": "מה את עושה?"
  },
  {
   "start": 224.2,
   "end": 225.4,
   "text": "מה את עושה בשעה כזאת?"
  },
  {
   "start": 226.38,
   "end": 229.5,
   "text": "לכי הביתה בשביל מה את יושבת כאן ותופרת לאור הרחוב."
  },
  {
   "start": 230.98,
   "end": 233.78,
   "text": "ואותה אישה הרימה עיניים,"
  },
  {
   "start": 234.76,
   "end": 236.7,
   "text": "עיניים, עיניים דומעות."
  },
  {
   "start": 237.8,
   "end": 239.42,
   "text": "אל אבא ואמרה לו, כבוד הרב,"
  },
  {
   "start": 240.46,
   "end": 242.18,
   "text": "כבוד הרב, אני אישה אלמנה."
  },
  {
   "start": 244.3,
   "end": 246.32,
   "text": "המצב הכלכלי קשה בבית."
  },
  {
   "start": 247.54,
   "end": 247.76,
   "text": "הרב,"
  },
  {
   "start": 248.84,
   "end": 251.54,
   "text": "כבוד הרב שידע לו אם הייתי תופרת עכשיו,"
  },
  {
   "start": 252.44,
   "end": 253.64,
   "text": "כדי שיהיה לי מה לאכול,"
  },
  {
   "start": 255.22,
   "end": 258.26,
   "text": "לא הייתי תופרת, הייתי הולכת הביתה ונשארת רעבה."
  },
  {
   "start": 259.52,
   "end": 260.18,
   "text": "אבל הרב,"
  },
  {
   "start": 261.0,
   "end": 266.18,
   "text": "אני יושבת פה ותופרת לאור תאורת הרחוב כי אין לי תאורה בבית,"
  },
  {
   "start": 266.76,
   "end": 270.2,
   "text": "ואני חייבת לתפור ולתפור. אתה יודע למה, כבוד הרב,"
  },
  {
   "start": 270.94,
   "end": 271.56,
   "text": "יש לי ילד,"
  },
  {
   "start": 272.54,
   "end": 279.28,
   "text": "ואני תופרת כדי שיהיה לי כסף לשלם לתלמוד תורה, לשלם למלמד שילמד אותו תורה,"
  },
  {
   "start": 279.8,
   "end": 282.88,
   "text": "כדי שהבן שלי אולי פעם יהיה תלמיד חכם."
  },
  {
   "start": 283.28,
   "end": 285.22,
   "text": "בגלל זה אני תופרת ואני חייבת,"
  },
  {
   "start": 285.56,
   "end": 292.82,
   "text": "חייבת עוד ועוד, עוד מערות, עוד טרוטה ועוד טרוטה, כדי שהבן שלי יזכה להיות תלמיד חכם."
  },
  {
   "start": 307.25,
   "end": 309.01,
   "text": "איזה כאב שם בסמטה."
  },
  {
   "start": 309.75,
   "end": 311.99,
   "text": "לראות אימא בוכייה על הבן שלה."
  },
  {
   "start": 313.41,
   "end": 314.45,
   "text": "אמרה אותה אימא,"
  },
  {
   "start": 315.53,
   "end": 315.99,
   "text": "רבי,"
  },
  {
   "start": 316.61,
   "end": 318.63,
   "text": "כבוד הרב, אם זה היה בשבילי,"
  },
  {
   "start": 321.44,
   "end": 322.44,
   "text": "לא הייתי עושה את זה."
  },
  {
   "start": 323.2,
   "end": 324.64,
   "text": "אני עושה את זה בשביל הבן שלי."
  },
  {
   "start": 326.12,
   "end": 327.22,
   "text": "והיא המשיכה לתפור,"
  },
  {
   "start": 328.16,
   "end": 329.42,
   "text": "תופרת ותופרת,"
  },
  {
   "start": 332.06,
   "end": 337.68,
   "text": "כשדמעה מלוכה מצטרפת לה אל טיפות הדם."
  },
  {
   "start": 338.46,
   "end": 339.56,
   "text": "וביחד טובים,"
  },
  {
   "start": 340.26,
   "end": 346.02,
   "text": "סיפור מסכת חיים של אימא צעירה שנותנת את הכל"
  },
  {
   "start": 346.56,
   "end": 349.02,
   "text": "בשביל הילד שלה, שיהיה בן תורה,"
  },
  {
   "start": 349.52,
   "end": 353.84,
   "text": "שיהיה תלמיד חכם."
  },
  {
   "start": 354.18,
   "end": 355.04,
   "text": "לב של אימא."
  },
  {
   "start": 357.12,
   "end": 358.32,
   "text": "ואתם שואלים אותי,"
  },
  {
   "start": 359.12,
   "end": 364.24,
   "text": "אתם שואלים אותי למה אני הסרתי את המועמדות שלי לרבנות של ירושלים?"
  },
  {
   "start": 365.8,
   "end": 368.04,
   "text": "ברשימת המועמדים שהגשתם לי"
  },
  {
   "start": 370.31,
   "end": 372.99,
   "text": "יש שם את השם רבי בצלאל ז'ולטי."
  },
  {
   "start": 375.12,
   "end": 381.8,
   "text": "רבי בצלאל ז'ולטי זה הבן של אותה תופרת אלמנה שתפרה בדם ובדמעות,"
  },
  {
   "start": 382.52,
   "end": 383.96,
   "text": "כדי שהבן שלה,"
  },
  {
   "start": 384.46,
   "end": 386.62,
   "text": "כדי שהבן שלה יהיה תלמיד חכם."
  },
  {
   "start": 387.58,
   "end": 389.42,
   "text": "אני יכול להתחרות עם הכל,"
  },
  {
   "start": 390.38,
   "end": 395.46,
   "text": "אבל עם שתיל מפואר שהושקע בדמעות של אימא,"
  },
  {
   "start": 396.68,
   "end": 402.52,
   "text": "אלמנה שיושבת ותופרת בכפור הירושלמי כדי שהבן שלה יהיה תלמיד חכם,"
  },
  {
   "start": 403.0,
   "end": 404.74,
   "text": "מול זה אי אפשר לעמוד!"
  },
  {
   "start": 411.16,
   "end": 414.96,
   "text": "ורבי בצלאל ז'ולטי היה הרב של ירושלים."
  },
  {
   "start": 416.06,
   "end": 425.36,
   "text": "אותה אמא צעירה שישבה ומסרה את כל-כולה לבן שלה,"
  },
  {
   "start": 426.08,
   "end": 427.16,
   "text": "לילד שלה,"
  },
  {
   "start": 428.2,
   "end": 430.1,
   "text": "שילמד, שיצליח,"
  },
  {
   "start": 432.34,
   "end": 434.48,
   "text": "זכתה והבן שלה"
  },
  {
   "start": 435.36,
   "end": 436.42,
   "text": "עלה ותעלה."
  },
  {
   "start": 443.87,
   "end": 445.21,
   "text": "כוח של אמא,"
  },
  {
   "start": 445.21,
   "end": 449.19,
   "text": "כוח שטמון בכל אחת ואחת,"
  },
  {
   "start": 453.59,
   "end": 455.31,
   "text": "גם עד שאת הולכת לעבודה."
  },
  {
   "start": 456.45,
   "end": 459.67,
   "text": "הקריירה האמיתית אצלך בבית,"
  },
  {
   "start": 460.49,
   "end": 462.29,
   "text": "והעבודה זו רק פרנסה."
  },
  {
   "start": 464.55,
   "end": 466.45,
   "text": "יש לך כל כך הרבה מה לתת,"
  },
  {
   "start": 467.41,
   "end": 468.91,
   "text": "כל כך הרבה מה להשפיע."
  },
  {
   "start": 472.15,
   "end": 473.87,
   "text": "עוז והדר לבושה,"
  },
  {
   "start": 474.69,
   "end": 475.57,
   "text": "ותשחק ליום אחרון."
  },
  {
   "start": 476.99,
   "end": 479.17,
   "text": "יש אישה שיכולה להתלבש במיטב האופנה,"
  },
  {
   "start": 479.67,
   "end": 480.85,
   "text": "ויש אישה שעונדת,"
  },
  {
   "start": 481.85,
   "end": 484.95,
   "text": "ומתלבשת לא רק בבגדים נעים,"
  },
  {
   "start": 485.71,
   "end": 487.13,
   "text": "אלא בעוז והדר."
  },
  {
   "start": 487.65,
   "end": 490.87,
   "text": "בעוז והדר! עוז והדר לבושה!"
  },
  {
   "start": 491.45,
   "end": 493.29,
   "text": "ותשחק ליום אחרון,"
  },
  {
   "start": 493.63,
   "end": 496.85,
   "text": "והלבוש הזה מלווה אותה בעולם הבא."
  },
  {
   "start": 497.67,
   "end": 499.37,
   "text": "בעולם תחיית המתים,"
  },
  {
   "start": 499.67,
   "end": 501.23,
   "text": "בעולם ימות משיח,"
  },
  {
   "start": 501.57,
   "end": 504.33,
   "text": "בעולם הבא, לנצח נצחים,"
  },
  {
   "start": 504.63,
   "end": 506.73,
   "text": "עם מפעל חיים אמיתי,"
  },
  {
   "start": 507.27,
   "end": 509.37,
   "text": "מפעל חיים של נשמות."
  },
  {
   "start": 509.37,
   "end": 516.61,
   "text": "אשריכם בנות ישראל שזכיתם למעלה הזאת אימא אימא"
  }
 ]
}