{
 "disc": "30ר- אמא",
 "track": "Track06",
 "duration": 391.152,
 "segments": [
  {
   "start": 11.82,
   "end": 12.3,
   "text": "כל אישה,"
  },
  {
   "start": 13.6,
   "end": 15.0,
   "text": "כל אישה בכל גיל,"
  },
  {
   "start": 16.22,
   "end": 17.04,
   "text": "חייבת,"
  },
  {
   "start": 17.66,
   "end": 21.98,
   "text": "חייבת לדעת שהיא תהיה יום אחד אימא,"
  },
  {
   "start": 22.68,
   "end": 23.62,
   "text": "וזה כל כך חשוב,"
  },
  {
   "start": 24.36,
   "end": 29.78,
   "text": "ויהיו לילדים משלה שיהיו זקוקים אך ורק לה."
  },
  {
   "start": 31.74,
   "end": 36.16,
   "text": "שום תחליף בעולם לא היה ולא יהיה לאימא,"
  },
  {
   "start": 38.68,
   "end": 38.98,
   "text": "רק היא,"
  },
  {
   "start": 41.43,
   "end": 43.71,
   "text": "ואז היא חייבת להחליט במה היא בוחרת,"
  },
  {
   "start": 44.47,
   "end": 45.73,
   "text": "בעולם של דמיון,"
  },
  {
   "start": 46.69,
   "end": 47.61,
   "text": "של אכזבות,"
  },
  {
   "start": 48.51,
   "end": 49.87,
   "text": "של הנאות רגעיות,"
  },
  {
   "start": 50.91,
   "end": 56.07,
   "text": "או במציאות של להיות אימא מוקפת בילדים שלה,"
  },
  {
   "start": 56.81,
   "end": 62.21,
   "text": "שהיא מקרינה כלפיהם חום ואהבה וסופגת מהם הרבה הרבה נחת."
  },
  {
   "start": 63.73,
   "end": 64.15,
   "text": "ואז,"
  },
  {
   "start": 65.21,
   "end": 67.71,
   "text": "כשהילדים שלך יתבגרו,"
  },
  {
   "start": 68.63,
   "end": 70.29,
   "text": "תגלה עולם מלא חום ואהבה,"
  },
  {
   "start": 71.37,
   "end": 73.25,
   "text": "מוקפת בנכדים ונינים,"
  },
  {
   "start": 76.14,
   "end": 81.14,
   "text": "כשבאותו זמן בחלק אחר של העולם תשב אשת קריירה"
  },
  {
   "start": 82.12,
   "end": 85.88,
   "text": "קרירה ובודדה בחיק הפנסיה שלה,"
  },
  {
   "start": 86.66,
   "end": 88.22,
   "text": "לבד, לבד."
  },
  {
   "start": 89.24,
   "end": 89.94,
   "text": "מה עדיף?"
  },
  {
   "start": 90.52,
   "end": 94.06,
   "text": "מה עדיף לאכול עוגת קרם במסעדה יוקרתית,"
  },
  {
   "start": 94.74,
   "end": 95.38,
   "text": "או לאכול"
  },
  {
   "start": 96.78,
   "end": 98.18,
   "text": "קערה של נחת"
  },
  {
   "start": 99.1,
   "end": 100.8,
   "text": "בחיק משפחה חמה ואוהבת?"
  },
  {
   "start": 101.8,
   "end": 104.7,
   "text": "בת ישראל את אימא, אל תאבדי את זה."
  },
  {
   "start": 105.4,
   "end": 107.08,
   "text": "בורא עולם נתן לך מתנה,"
  },
  {
   "start": 107.72,
   "end": 108.42,
   "text": "אל תאבדי אותה."
  },
  {
   "start": 109.4,
   "end": 112.72,
   "text": "אימא זו מציאות, אימא זו מחויבות."
  },
  {
   "start": 113.34,
   "end": 117.3,
   "text": "מחויבות לערכים, לצניעות, לדוגמה אישית."
  },
  {
   "start": 118.06,
   "end": 118.78,
   "text": "לזה את,"
  },
  {
   "start": 119.46,
   "end": 126.78,
   "text": "את ורק את מסוגלת להתעלות ולזכות בעולם הזה ולעולם הבא."
  },
  {
   "start": 128.6,
   "end": 131.26,
   "text": "כי עיני כולם נשואות אלייך."
  },
  {
   "start": 132.28,
   "end": 136.32,
   "text": "אל אותה דמות זוהרת ומופלאה, אימא."
  },
  {
   "start": 139.54,
   "end": 141.8,
   "text": "כמה השפעה יש לאימא על ילד."
  },
  {
   "start": 142.58,
   "end": 144.3,
   "text": "אתם יודעים רבי יצחק קוטנר,"
  },
  {
   "start": 145.42,
   "end": 146.88,
   "text": "בעל הפחד יצחק,"
  },
  {
   "start": 148.14,
   "end": 149.94,
   "text": "אחד מגדולי ישראל המיוחדים,"
  },
  {
   "start": 150.88,
   "end": 152.38,
   "text": "סיפר איך כשהיה ילד,"
  },
  {
   "start": 153.46,
   "end": 154.96,
   "text": "נטעה בו אהבת התורה."
  },
  {
   "start": 156.02,
   "end": 158.94,
   "text": "התלמידים הרבים שהיו לו, היו כל פעם שואלים אותו,"
  },
  {
   "start": 159.64,
   "end": 162.92,
   "text": "כבוד הרב, איך יש לך כל כך הרבה אהבת תורה?"
  },
  {
   "start": 163.5,
   "end": 167.84,
   "text": "איך התעלית וגדלת להיות דמות נערצת ומופלאה בעינינו?"
  },
  {
   "start": 169.56,
   "end": 170.28,
   "text": "והוא סיפר להם."
  },
  {
   "start": 172.14,
   "end": 172.6,
   "text": "הוא אמר להם,"
  },
  {
   "start": 173.22,
   "end": 175.9,
   "text": "המצב הכלכלי אצלנו בבית כשהייתי ילד"
  },
  {
   "start": 176.66,
   "end": 177.36,
   "text": "היה קשה."
  },
  {
   "start": 179.06,
   "end": 180.56,
   "text": "והם חסכו וחסכו,"
  },
  {
   "start": 182.12,
   "end": 183.84,
   "text": "וכל דבר היה עולה יקר."
  },
  {
   "start": 185.54,
   "end": 189.7,
   "text": "והם חיו ממש בעוני מוחלט."
  },
  {
   "start": 189.7,
   "end": 193.4,
   "text": "ועברו שנים וסוף סוף"
  },
  {
   "start": 194.26,
   "end": 201.94,
   "text": "שנה אחת אימא סוף סוף קנתה אימא שמלת חג חדשה לחג הקרבי בה."
  },
  {
   "start": 202.94,
   "end": 204.48,
   "text": "היא הייתה כל כך נרגשת."
  },
  {
   "start": 205.46,
   "end": 207.06,
   "text": "אבא היה כל כך שמח."
  },
  {
   "start": 207.88,
   "end": 209.14,
   "text": "כולם ציפו לחג."
  },
  {
   "start": 209.7,
   "end": 212.38,
   "text": "איך אימא תכבד את החג בבגד חדש,"
  },
  {
   "start": 212.9,
   "end": 216.54,
   "text": "בשמלה של חג, ששנים חסכו עבורה."
  },
  {
   "start": 217.06,
   "end": 218.14,
   "text": "היא לא פתחה לשום אירוע."
  },
  {
   "start": 218.76,
   "end": 221.1,
   "text": "היא לא פתחה לשום דבר את אותה שמלה חדשה,"
  },
  {
   "start": 221.74,
   "end": 222.32,
   "text": "רק לחג."
  },
  {
   "start": 225.52,
   "end": 228.24,
   "text": "יום אחד, יצחק הקטן חוזר,"
  },
  {
   "start": 228.64,
   "end": 231.14,
   "text": "חוזר מהתלמוד תורה כל כך מאושר."
  },
  {
   "start": 231.7,
   "end": 235.4,
   "text": "הוא סיים לראשונה בחייו מסכת בגמרא."
  },
  {
   "start": 235.74,
   "end": 236.5,
   "text": "הוא בא הביתה,"
  },
  {
   "start": 237.16,
   "end": 238.06,
   "text": "ואמר אימא,"
  },
  {
   "start": 238.38,
   "end": 240.24,
   "text": "אימא, סיימנו מסכת ברכות."
  },
  {
   "start": 240.58,
   "end": 243.18,
   "text": "אימא, לראשונה בחיי סיימתי מסכת."
  },
  {
   "start": 243.62,
   "end": 245.28,
   "text": "הסיימתי את מסכת ברכות."
  },
  {
   "start": 246.76,
   "end": 247.64,
   "text": "ואימא הבאת בו."
  },
  {
   "start": 248.34,
   "end": 251.08,
   "text": "הוא לא ישכח את המבט מלא הערצה של אימא."
  },
  {
   "start": 252.28,
   "end": 255.48,
   "text": "בני, יצחק, סיימת מסכת?"
  },
  {
   "start": 255.8,
   "end": 257.62,
   "text": "אוי, אני ממש שמחה, אמרה אימא."
  },
  {
   "start": 258.1,
   "end": 260.1,
   "text": "היום אנחנו נעשה יום טוב,"
  },
  {
   "start": 260.78,
   "end": 262.58,
   "text": "היום יהיה לנו חג בבית."
  },
  {
   "start": 263.36,
   "end": 264.34,
   "text": "והיא הזדרזה,"
  },
  {
   "start": 265.0,
   "end": 267.22,
   "text": "ואספה מכל מה שהיה בבית,"
  },
  {
   "start": 267.6,
   "end": 270.0,
   "text": "מהמעט פירורים שהיו בבית,"
  },
  {
   "start": 270.34,
   "end": 272.04,
   "text": "ואפתה עוגה קטנה,"
  },
  {
   "start": 272.88,
   "end": 274.38,
   "text": "ארוחה חגיגית."
  },
  {
   "start": 275.02,
   "end": 277.4,
   "text": "והיא רצה, רצה אל העבודה, אל אבא,"
  },
  {
   "start": 277.8,
   "end": 281.78,
   "text": "לספר לו בוא מוקדם, היום תבוא מוקדם, יש ארוחה חגיגית, יום טוב."
  },
  {
   "start": 282.86,
   "end": 284.3,
   "text": "יצחק סיים מסכת"
  },
  {
   "start": 284.94,
   "end": 291.6,
   "text": "וכל הבית לבש חג ואבא בא הביתה ושמח גם הוא וישבנו וחיכינו לאימא."
  },
  {
   "start": 292.78,
   "end": 293.22,
   "text": "ואז,"
  },
  {
   "start": 294.0,
   "end": 298.02,
   "text": "אז אני נשאתי את עיניי וראיתי את אימא שלי,"
  },
  {
   "start": 298.4,
   "end": 300.0,
   "text": "את האימא האהובה שלי."
  },
  {
   "start": 301.48,
   "end": 305.92,
   "text": "היא לבשה שמלת חג חדשה,"
  },
  {
   "start": 306.08,
   "end": 309.66,
   "text": "את אותה שמלה שהיא לא העזה לפתוח לשום אירוע."
  },
  {
   "start": 310.42,
   "end": 322.27,
   "text": "אמא פתחה בשבילי ודמעות קטנות של אושר התגלגלו במורד לחיי."
  },
  {
   "start": 322.77,
   "end": 332.61,
   "text": "אמא לבשה עבורי את שמלת החג כאות שמחה ואושר על שסיימתי מסכת."
  },
  {
   "start": 334.55,
   "end": 339.71,
   "text": "אתם לא יודעים כמה אהבת תורה החדירה אמא בי."
  },
  {
   "start": 340.17,
   "end": 343.79,
   "text": "ערך השמלה שלה אי אפשר להבין,"
  },
  {
   "start": 344.41,
   "end": 346.01,
   "text": "אי אפשר לתאר."
  },
  {
   "start": 347.63,
   "end": 349.67,
   "text": "אל תיטוש תורת אמך."
  },
  {
   "start": 350.29,
   "end": 355.03,
   "text": "אומרת התורה הקדושה אומר ריבונו של עולם, אל תיטוש תורת אמך."
  },
  {
   "start": 356.09,
   "end": 358.99,
   "text": "יש תורה שניתנה בהר סיני,"
  },
  {
   "start": 359.79,
   "end": 365.63,
   "text": "ויש תורה מיוחדת, תורתה של אמא,"
  },
  {
   "start": 366.51,
   "end": 367.63,
   "text": "תורת אם."
  },
  {
   "start": 368.75,
   "end": 370.35,
   "text": "תורת אם זו האווירה,"
  },
  {
   "start": 371.13,
   "end": 371.95,
   "text": "זו ההתנהגות,"
  },
  {
   "start": 372.63,
   "end": 380.05,
   "text": "זו מסירות הנפש והחיים והחום שאימא מרעיפה לילדים שלה."
  },
  {
   "start": 380.67,
   "end": 381.59,
   "text": "זו תורה מיוחדת."
  },
  {
   "start": 382.33,
   "end": 387.71,
   "text": "זו תורה שנלמדת ונחרטת לעד בקרב נפש הילדים."
  }
 ]
}