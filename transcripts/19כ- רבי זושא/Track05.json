{
 "disc": "19כ- רבי זושא",
 "track": "Track05",
 "duration": 840.168,
 "segments": [
  {
   "start": 13.49,
   "end": 16.15,
   "text": "רבי זושה מהניפוליס סיפר לבעלה תניא,"
  },
  {
   "start": 16.53,
   "end": 17.91,
   "text": "לרבי שניאור זלמן מלאדי."
  },
  {
   "start": 19.35,
   "end": 19.93,
   "text": "בעלה תניא."
  },
  {
   "start": 21.45,
   "end": 22.57,
   "text": "וכך סיפר רבי זושה."
  },
  {
   "start": 23.19,
   "end": 25.43,
   "text": "אמר אחי רבי אלימלך מליז'נסק"
  },
  {
   "start": 26.45,
   "end": 31.67,
   "text": "ישב בחדר הסמוך למגיד ממזריץ', אז שלמדנו אצל המגיד,"
  },
  {
   "start": 32.77,
   "end": 35.13,
   "text": "ולפתע הוא שומע את המגיד קורא לו."
  },
  {
   "start": 39.35,
   "end": 40.71,
   "text": "הוא נכנס אל הקודש פנימה."
  },
  {
   "start": 42.51,
   "end": 44.61,
   "text": "המגיד פנה אליו ואמר לו, שומע אתה מיילך."
  },
  {
   "start": 45.37,
   "end": 48.79,
   "text": "כך הוא קרא לירביל מלך מלז'נסק, מלך."
  },
  {
   "start": 49.25,
   "end": 50.23,
   "text": "שומע, אתה מלך?"
  },
  {
   "start": 50.91,
   "end": 55.17,
   "text": "שומע מה שאומרים למעלה בשמיים במטיבתא דרכיאה?"
  },
  {
   "start": 56.67,
   "end": 58.73,
   "text": "שמה בפמלייה של מעלה מה אומרים?"
  },
  {
   "start": 60.07,
   "end": 66.07,
   "text": "אומרים, אהבת ישראל זאת אומרת לאהוב את הרשע הכי גמור כמו את הצדיק הכי גמור."
  },
  {
   "start": 67.45,
   "end": 73.43,
   "text": "ככה אמר המגיד והמשיך ובכוחו של הצדיק לעורר כל נשמה,"
  },
  {
   "start": 74.13,
   "end": 75.99,
   "text": "אבל כל נשמה נמצאת בעולם,"
  },
  {
   "start": 76.31,
   "end": 77.61,
   "text": "ולהכניס בת הכוח הזה,"
  },
  {
   "start": 78.03,
   "end": 79.55,
   "text": "את היכולת לעשות תשובה."
  },
  {
   "start": 81.89,
   "end": 84.19,
   "text": "ומניין של החבורה שלכם,"
  },
  {
   "start": 85.29,
   "end": 88.01,
   "text": "של החבורה הקדושה של פה, של התלמידים שפה,"
  },
  {
   "start": 88.65,
   "end": 89.57,
   "text": "יש בהם כוח,"
  },
  {
   "start": 90.11,
   "end": 92.29,
   "text": "אפילו רשע גמור להחזיר אותו בתשובה."
  },
  {
   "start": 96.08,
   "end": 98.32,
   "text": "שומע מה שאומרים למעלה מיילך,"
  },
  {
   "start": 98.7,
   "end": 101.54,
   "text": "שומע מה שאומרים למעלה בשמיים, מיילך!"
  },
  {
   "start": 102.58,
   "end": 104.0,
   "text": "למעלה בשמיים אומרים."
  },
  {
   "start": 104.0,
   "end": 111.36,
   "text": "אהבת ישראל זה אומר, זאת אומרת לאהוב את הרשע הכי גמור כמו שאוהבים את הצדיק הכי גמור."
  },
  {
   "start": 114.5,
   "end": 124.8,
   "text": "בבוקר סיפר את זה רבי אלימלך לחברו הקדושה וכולם החלו ללמוד את הנושא בעניין בעלי התשובה."
  },
  {
   "start": 126.12,
   "end": 136.75,
   "text": "תוך כדי שהם לומדים נכנס לפתע איזה מישהו מבחוץ זר והקשיב לדברים שלהם, ללימוד שלהם."
  },
  {
   "start": 137.45,
   "end": 141.35,
   "text": "לפתע הלכה לפרוץ בצחוק, והתחיל לצעוק עליהם ולהשתולל."
  },
  {
   "start": 143.54,
   "end": 143.94,
   "text": "והם,"
  },
  {
   "start": 144.74,
   "end": 146.66,
   "text": "אותם תלמידים קדושים וטהורים,"
  },
  {
   "start": 147.44,
   "end": 150.32,
   "text": "החלו להתפלל בהתעוררות, החלו לבכות."
  },
  {
   "start": 151.6,
   "end": 153.3,
   "text": "כשהם מתעלמים לגמרי ממנו,"
  },
  {
   "start": 154.0,
   "end": 157.74,
   "text": "מתפללים, בוכים על אותה נשמה אומללה."
  },
  {
   "start": 158.72,
   "end": 162.18,
   "text": "והאיש המשיך להשתולל ולהתיח דברים קשים בהם,"
  },
  {
   "start": 162.56,
   "end": 163.62,
   "text": "דברים קשים ביהדות."
  },
  {
   "start": 167.34,
   "end": 170.4,
   "text": "אבל הם המשיכו להתפלל, הם המשיכו לבכות."
  },
  {
   "start": 172.69,
   "end": 173.83,
   "text": "מקץ כמה דקות הוא יצא,"
  },
  {
   "start": 175.9,
   "end": 176.64,
   "text": "אבל זה לא נגמר."
  },
  {
   "start": 177.86,
   "end": 181.5,
   "text": "לא עברו כמה ימים מאותו מקרה לא מובן,"
  },
  {
   "start": 182.04,
   "end": 183.4,
   "text": "מאותו מקרה לא ברור."
  },
  {
   "start": 184.82,
   "end": 188.06,
   "text": "והאיש נעשה לבעל תשובה גמור."
  },
  {
   "start": 190.68,
   "end": 191.9,
   "text": "למדנו, אומר רבי זושה,"
  },
  {
   "start": 192.5,
   "end": 193.26,
   "text": "מה זו אהבת ישראל."
  },
  {
   "start": 195.42,
   "end": 197.52,
   "text": "איך אפשר לקרב רחוקים על ידי אהבה?"
  },
  {
   "start": 199.42,
   "end": 202.14,
   "text": "זה מה שרבי זושה לא מלמד אותנו, כמה קשה לנו,"
  },
  {
   "start": 202.84,
   "end": 205.18,
   "text": "בדור שלנו, באמת לרכוש אהבת ישראל."
  },
  {
   "start": 206.1,
   "end": 208.48,
   "text": "יחידים אולי בעם ישראל מגיעים לדרגות,"
  },
  {
   "start": 209.0,
   "end": 210.14,
   "text": "אבל כמה זה קשה לנו."
  },
  {
   "start": 210.74,
   "end": 213.02,
   "text": "עד לכך שהיום קשה לנו לפעמים ללמד זכות על עצמנו."
  },
  {
   "start": 213.46,
   "end": 215.24,
   "text": "לא רק על השני, אלא על עצמנו."
  },
  {
   "start": 217.43,
   "end": 218.15,
   "text": "חייבים להתחזק."
  },
  {
   "start": 218.81,
   "end": 219.99,
   "text": "כולנו לקבל על עצמנו."
  },
  {
   "start": 220.77,
   "end": 222.93,
   "text": "כולנו בואו לעזרת השם בואו נקבל על עצמנו."
  },
  {
   "start": 224.23,
   "end": 225.07,
   "text": "גם אני כולנו."
  },
  {
   "start": 225.89,
   "end": 227.29,
   "text": "אהבת ישראל באמת."
  },
  {
   "start": 227.81,
   "end": 231.03,
   "text": "נשתדל, נשתדל, לפחות נשתדל. נהיה בבחינת משתדלים."
  },
  {
   "start": 231.53,
   "end": 235.03,
   "text": "נגיע לחצי דרגה, ברוך השם, ל... כלומר,"
  },
  {
   "start": 235.11,
   "end": 241.17,
   "text": "מאפס עד עשר, חצי, ברוך השם, נגיע לאחד, נגיע לשתיים, ברוך השם, משהו."
  },
  {
   "start": 246.32,
   "end": 249.4,
   "text": "אתם יודעים, רבי זושי יום אחד הגיע לעיר בר שבאוקראינה."
  },
  {
   "start": 250.76,
   "end": 254.22,
   "text": "שם זה היה עיר שאף אחד לא היה נכנס אליה."
  },
  {
   "start": 255.06,
   "end": 258.18,
   "text": "עיר שאין ריח של יהדות שם."
  },
  {
   "start": 259.7,
   "end": 262.7,
   "text": "אז בעיר הזאת היו שם מספר אנשים שזיהו אותו,"
  },
  {
   "start": 263.36,
   "end": 265.88,
   "text": "והוא התצנף לו באיזה פינה במלון שם יושב בשקט."
  },
  {
   "start": 266.66,
   "end": 267.28,
   "text": "אבל זיהו אותו."
  },
  {
   "start": 267.28,
   "end": 270.06,
   "text": "הלכו שם בני העיר,"
  },
  {
   "start": 270.68,
   "end": 271.8,
   "text": "שלחו לו נבחרת,"
  },
  {
   "start": 274.26,
   "end": 275.02,
   "text": "רביעיית"
  },
  {
   "start": 275.9,
   "end": 278.46,
   "text": "הלוחמים כנגד יהדות הגדולה ביותר."
  },
  {
   "start": 280.0,
   "end": 282.06,
   "text": "אלה מצאו ככה את כל אחד מהם,"
  },
  {
   "start": 284.32,
   "end": 285.76,
   "text": "והם באו לו בכוונה שם,"
  },
  {
   "start": 286.52,
   "end": 287.44,
   "text": "יושבים לידו,"
  },
  {
   "start": 288.42,
   "end": 289.4,
   "text": "וצוחקים,"
  },
  {
   "start": 289.9,
   "end": 290.86,
   "text": "ומבזים,"
  },
  {
   "start": 291.22,
   "end": 292.44,
   "text": "ומשחקים קלפים,"
  },
  {
   "start": 292.76,
   "end": 294.62,
   "text": "ועושים כל מיני דברים, העיקר להפריע לו."
  },
  {
   "start": 296.16,
   "end": 297.2,
   "text": "לפתע קאמרא בי זושא,"
  },
  {
   "start": 298.0,
   "end": 299.54,
   "text": "והתחיל לבכות."
  },
  {
   "start": 300.24,
   "end": 301.04,
   "text": "אמר, אוי זושה,"
  },
  {
   "start": 301.62,
   "end": 302.8,
   "text": "תיזכר בחטאים שלך,"
  },
  {
   "start": 303.5,
   "end": 304.84,
   "text": "תיזכר מי אתה באמת."
  },
  {
   "start": 306.3,
   "end": 307.66,
   "text": "מה אתה חושב, לא רואים אותך?"
  },
  {
   "start": 308.26,
   "end": 310.18,
   "text": "יודעים שעשית ככה, והתחיל לפרט,"
  },
  {
   "start": 310.82,
   "end": 311.46,
   "text": "חטאים."
  },
  {
   "start": 312.8,
   "end": 314.08,
   "text": "והרביעייה הזאתי,"
  },
  {
   "start": 315.06,
   "end": 316.94,
   "text": "הנבחרת הזאת של החוטאים,"
  },
  {
   "start": 317.64,
   "end": 318.62,
   "text": "יחלה לשמוע,"
  },
  {
   "start": 319.28,
   "end": 324.04,
   "text": "ולאט לאט מתחוור להם שרבי זושה מפרט להם את החטאים שלהם,"
  },
  {
   "start": 324.48,
   "end": 326.34,
   "text": "את מה שהם עושים בחדרי חדרים,"
  },
  {
   "start": 326.78,
   "end": 329.1,
   "text": "את מה שהם עושים והחושבים שאף אחד לא יודע,"
  },
  {
   "start": 329.42,
   "end": 330.4,
   "text": "את זה הוא פירט להם."
  },
  {
   "start": 331.06,
   "end": 332.0,
   "text": "ולזה הם לא ציפו."
  },
  {
   "start": 332.56,
   "end": 334.26,
   "text": "היו רגעים ארוכים של מבוכה."
  },
  {
   "start": 336.1,
   "end": 337.24,
   "text": "ואז הוא פרץ בבכי."
  },
  {
   "start": 338.42,
   "end": 341.1,
   "text": "והבכי הזה קרע להם את הלב."
  },
  {
   "start": 341.78,
   "end": 343.26,
   "text": "יהודי בוכה עליי,"
  },
  {
   "start": 344.08,
   "end": 348.26,
   "text": "יהודי שאכפת לו ממני יותר משלי אכפת מעצמי."
  },
  {
   "start": 350.87,
   "end": 352.71,
   "text": "וככה רבי זושה ממשיך בשלו,"
  },
  {
   "start": 353.35,
   "end": 355.71,
   "text": "מדבר, מפרט החטאים ובוכה."
  },
  {
   "start": 357.19,
   "end": 360.11,
   "text": "וכל דקה שעוברת עוד קליפה שרה לה,"
  },
  {
   "start": 360.65,
   "end": 361.85,
   "text": "ועוד מחסום נופל,"
  },
  {
   "start": 362.97,
   "end": 364.43,
   "text": "והלב שלהם נמס כמים,"
  },
  {
   "start": 365.05,
   "end": 366.89,
   "text": "והעיניים שלהם נתמלאות בדמעות."
  },
  {
   "start": 371.14,
   "end": 371.92,
   "text": "מחרת בבוקר"
  },
  {
   "start": 372.74,
   "end": 377.14,
   "text": "קמו להם צעירי בני העיר, באו והתקבצו לראות מה נשאר מאותו רבי זושה."
  },
  {
   "start": 380.28,
   "end": 380.7,
   "text": "והנה,"
  },
  {
   "start": 381.92,
   "end": 383.5,
   "text": "לפתע יוצאים להם מהמלון,"
  },
  {
   "start": 384.64,
   "end": 387.76,
   "text": "ארבעת ראשי האגודה נגד כפייה דתית בעיר בר,"
  },
  {
   "start": 388.68,
   "end": 389.78,
   "text": "עם ראש מושפל,"
  },
  {
   "start": 390.54,
   "end": 391.54,
   "text": "עם עיניים נפוחות מבכי,"
  },
  {
   "start": 392.94,
   "end": 394.02,
   "text": "כבר לא אותה הליכה,"
  },
  {
   "start": 395.0,
   "end": 396.14,
   "text": "נפוחה מגאווה."
  },
  {
   "start": 397.42,
   "end": 397.98,
   "text": "אלא יהודים,"
  },
  {
   "start": 398.66,
   "end": 399.46,
   "text": "יהודים קדושים,"
  },
  {
   "start": 400.06,
   "end": 400.94,
   "text": "חוזרים בתשובה."
  },
  {
   "start": 401.84,
   "end": 404.14,
   "text": "ועיר בר נאלמה דום,"
  },
  {
   "start": 406.92,
   "end": 408.38,
   "text": "אמר רבי זושה בעניפולי."
  },
  {
   "start": 409.78,
   "end": 410.16,
   "text": "תדעו לכם,"
  },
  {
   "start": 411.3,
   "end": 414.82,
   "text": "מכל עבירה נברא מלאך מקטרג."
  },
  {
   "start": 416.0,
   "end": 417.62,
   "text": "אבל מלאך מקטרג,"
  },
  {
   "start": 418.08,
   "end": 421.18,
   "text": "שנברא מיהודי, לעולם הוא לא שלם."
  },
  {
   "start": 421.52,
   "end": 422.3,
   "text": "תמיד הוא פגום,"
  },
  {
   "start": 422.78,
   "end": 425.72,
   "text": "תמיד חסר לו איזה איבר מסוים. אתם יודעים למה?"
  },
  {
   "start": 426.2,
   "end": 428.76,
   "text": "כי יהודי, אפילו שהוא עושה עבירה,"
  },
  {
   "start": 429.26,
   "end": 431.04,
   "text": "הוא לא עושה אותה בלב שלם."
  },
  {
   "start": 431.78,
   "end": 433.92,
   "text": "הוא לא עושה אותה באמת מכל הלב."
  },
  {
   "start": 434.6,
   "end": 436.64,
   "text": "בפנים הנשמה כואבת."
  },
  {
   "start": 437.32,
   "end": 439.68,
   "text": "בפנים זה קצת מפריע לו."
  },
  {
   "start": 440.28,
   "end": 442.86,
   "text": "ולכן גם מאחר שהעבירה לא שלמה,"
  },
  {
   "start": 443.3,
   "end": 444.68,
   "text": "המלאך המקטרג לא שלם."
  },
  {
   "start": 445.66,
   "end": 446.38,
   "text": "ככה זה יהודי."
  },
  {
   "start": 447.32,
   "end": 448.04,
   "text": "ככה זה יהודי."
  },
  {
   "start": 450.1,
   "end": 452.24,
   "text": "מצווה הוא יכול לקיים בשלמות עבירה,"
  },
  {
   "start": 452.76,
   "end": 453.62,
   "text": "יהודי לא עושה בשלמות."
  },
  {
   "start": 453.62,
   "end": 498.09,
   "text": "רבי זושה יושב"
  },
  {
   "start": 498.75,
   "end": 499.87,
   "text": "על יד הנהר ולומד."
  },
  {
   "start": 504.8,
   "end": 505.62,
   "text": "לפתע מגיע אליו פיני."
  },
  {
   "start": 506.88,
   "end": 507.62,
   "text": "פיני היה סבל."
  },
  {
   "start": 508.48,
   "end": 509.76,
   "text": "פיני היה עם ארץ גמור."
  },
  {
   "start": 511.0,
   "end": 512.36,
   "text": "רחוק מתורה ומצוות."
  },
  {
   "start": 512.88,
   "end": 513.66,
   "text": "הוא בא כולו זועם."
  },
  {
   "start": 514.24,
   "end": 514.8,
   "text": "כבוד הרב!"
  },
  {
   "start": 515.62,
   "end": 516.1,
   "text": "כבוד הרב!"
  },
  {
   "start": 516.98,
   "end": 518.88,
   "text": "פרנסי העיר, העשירים של העיר,"
  },
  {
   "start": 519.28,
   "end": 520.84,
   "text": "נכבדי העיר, החרימו לי."
  },
  {
   "start": 522.88,
   "end": 530.7,
   "text": "החרימו לי את הפרנסה שלי. הם לא מוכנים שאני, שאני אהיה סבל עד שאני אעשה תשובה. מה קורה פה?"
  },
  {
   "start": 530.86,
   "end": 532.24,
   "text": "הם לא נותנים לי לעבוד, הם לא נותנים לי להתפרנס."
  },
  {
   "start": 536.85,
   "end": 539.17,
   "text": "אני לא חייב להם כלום! ככה הוא זורם וצועק."
  },
  {
   "start": 540.97,
   "end": 543.81,
   "text": "רבי זושה מרים את הראש שלו מהספר."
  },
  {
   "start": 544.73,
   "end": 547.19,
   "text": "נו, פיני, ועשית כבר תשובה?"
  },
  {
   "start": 548.29,
   "end": 549.65,
   "text": "מה אתם רוצים ממני?"
  },
  {
   "start": 551.59,
   "end": 553.03,
   "text": "רבי זושה המשיך ללמוד."
  },
  {
   "start": 555.31,
   "end": 556.41,
   "text": "עשית כבר תשובה?"
  },
  {
   "start": 559.9,
   "end": 560.72,
   "text": "פניו הדהימו."
  },
  {
   "start": 564.9,
   "end": 567.24,
   "text": "רק יהודי יכול להיות כל כך אכזרי."
  },
  {
   "start": 568.14,
   "end": 570.2,
   "text": "רק יהודים יכולים להיות כל כך אכזרי."
  },
  {
   "start": 570.2,
   "end": 573.78,
   "text": "אם הכומר היה מרחם עליי, הכומר היה מרחם עליי כבר."
  },
  {
   "start": 575.12,
   "end": 576.72,
   "text": "כשהוא גמר את המשפט,"
  },
  {
   "start": 577.62,
   "end": 578.72,
   "text": "כשהוא גמר את המשפט,"
  },
  {
   "start": 579.3,
   "end": 580.28,
   "text": "קפץ רבי זושה."
  },
  {
   "start": 580.94,
   "end": 581.64,
   "text": "אוי ואבוי."
  },
  {
   "start": 582.2,
   "end": 584.1,
   "text": "אוי ואבוי, אוי לראשו של זושה."
  },
  {
   "start": 584.64,
   "end": 589.6,
   "text": "זושה גרם ליהודי להוציא מפיו דברים לא טובים על עם ישראל הקדוש."
  },
  {
   "start": 590.2,
   "end": 593.78,
   "text": "זושה גרם ליהודי להוציא דברים לא טובים על עם ישראל."
  },
  {
   "start": 597.56,
   "end": 602.0,
   "text": "ופיני נותר עומד המון לנוכח התגובה על מה ששמע."
  },
  {
   "start": 603.0,
   "end": 604.14,
   "text": "רק עכשיו הוא הבין,"
  },
  {
   "start": 604.8,
   "end": 607.82,
   "text": "הוא הבין כמה חשוב מה שהוא מוציא מהפה שלו,"
  },
  {
   "start": 608.58,
   "end": 611.02,
   "text": "כמה חשוב לו לדבר על עם ישראל,"
  },
  {
   "start": 611.66,
   "end": 614.82,
   "text": "כשהוא ראה איך הדברים חודרים אל רבי זושה,"
  },
  {
   "start": 615.38,
   "end": 616.78,
   "text": "ורבי זושה קפץ כולו,"
  },
  {
   "start": 617.56,
   "end": 622.08,
   "text": "ותוך כדי שהוא קופץ מכאב הוא מעד ונפל אל תוך הנהר,"
  },
  {
   "start": 626.63,
   "end": 627.83,
   "text": "זושה לא ידעה לשחות."
  },
  {
   "start": 629.17,
   "end": 630.25,
   "text": "פיניס זעק לעזרה,"
  },
  {
   "start": 631.17,
   "end": 633.49,
   "text": "אנשים שעברו מרחוק קפצו אל הנהר,"
  },
  {
   "start": 634.73,
   "end": 635.71,
   "text": "וברגע האחרון,"
  },
  {
   "start": 636.31,
   "end": 637.27,
   "text": "משו את רבי זושה,"
  },
  {
   "start": 640.08,
   "end": 641.26,
   "text": "כבר חסר הכרה,"
  },
  {
   "start": 642.18,
   "end": 643.14,
   "text": "אבל עדיין חי."
  },
  {
   "start": 646.07,
   "end": 646.69,
   "text": "בבית,"
  },
  {
   "start": 647.89,
   "end": 650.01,
   "text": "בבית שכב לו רבי זושה."
  },
  {
   "start": 651.73,
   "end": 653.35,
   "text": "ממלמל, אוי לזושה."
  },
  {
   "start": 654.17,
   "end": 655.01,
   "text": "אוי לזושה."
  },
  {
   "start": 655.91,
   "end": 658.99,
   "text": "זושה גרם ליהודי להוציא מפיו דברים לא טובים על עם ישראל."
  },
  {
   "start": 662.17,
   "end": 666.7,
   "text": "כך הוא ממלמל שעות ארוכות."
  },
  {
   "start": 668.32,
   "end": 669.0,
   "text": "שעת ערב,"
  },
  {
   "start": 670.02,
   "end": 671.86,
   "text": "כשכולם חזרו הביתה,"
  },
  {
   "start": 672.86,
   "end": 673.74,
   "text": "יצא פיני,"
  },
  {
   "start": 674.52,
   "end": 677.56,
   "text": "מאפלו לי את החדר, שם הוא התחבא, שם הוא הסתתר,"
  },
  {
   "start": 678.36,
   "end": 679.84,
   "text": "והתקרב למיטת הרב."
  },
  {
   "start": 687.73,
   "end": 689.13,
   "text": "טיעוד של הרב על כל יהודי."
  },
  {
   "start": 692.22,
   "end": 692.5,
   "text": "רבי,"
  },
  {
   "start": 693.9,
   "end": 695.04,
   "text": "הרב ירחם עליי."
  },
  {
   "start": 696.28,
   "end": 697.84,
   "text": "הרב, גם אני רוצה לחזור בתשובה."
  },
  {
   "start": 698.8,
   "end": 699.68,
   "text": "הרב, אני רוצה תשובה."
  },
  {
   "start": 703.08,
   "end": 703.7,
   "text": "רבי זושה,"
  },
  {
   "start": 704.72,
   "end": 706.16,
   "text": "פתח את פיו הקדוש ואמר,"
  },
  {
   "start": 707.34,
   "end": 708.82,
   "text": "כבודו רוצה פרנסה, לא?"
  },
  {
   "start": 709.58,
   "end": 712.02,
   "text": "לא, לא, לא, לא צריך פרנסה, צריך תשובה."
  },
  {
   "start": 712.74,
   "end": 713.86,
   "text": "אני רוצה תשובה קודם."
  },
  {
   "start": 716.0,
   "end": 716.82,
   "text": "אמר רבי זושה,"
  },
  {
   "start": 717.32,
   "end": 717.8,
   "text": "תשובה,"
  },
  {
   "start": 718.44,
   "end": 719.86,
   "text": "תשובה זה לשוב עד השם."
  },
  {
   "start": 720.6,
   "end": 727.32,
   "text": "תשובה זה לנקות את הנשמה ולהתקרב עימה כשהיא זכה וצחה לאבא שבשמיים."
  },
  {
   "start": 728.44,
   "end": 730.5,
   "text": "להביא נשמה טהורה לאבא שבשמיים."
  },
  {
   "start": 732.22,
   "end": 732.76,
   "text": "אני רוצה,"
  },
  {
   "start": 733.94,
   "end": 736.44,
   "text": "אני מעוניין, כן, כבוד הרב, זה מה שאני רוצה."
  },
  {
   "start": 739.13,
   "end": 740.49,
   "text": "חייך רבי זושה ואמר,"
  },
  {
   "start": 741.33,
   "end": 742.71,
   "text": "אם ככה אתה דומה לזושה,"
  },
  {
   "start": 743.37,
   "end": 745.59,
   "text": "גם זושה מלא חטאים, מלא עוונות."
  },
  {
   "start": 746.05,
   "end": 748.31,
   "text": "בוא יחד, בוא יחד נחזור בתשובה."
  },
  {
   "start": 752.55,
   "end": 754.41,
   "text": "אחז רבי זושה בידו של פיני,"
  },
  {
   "start": 754.95,
   "end": 760.37,
   "text": "ויחד הם ישבו על הארץ ועסקו בבכייה ובתשובה."
  },
  {
   "start": 764.44,
   "end": 769.9,
   "text": "למחרת בבוקר פיני עזב את ביתו של רבי זושה,"
  },
  {
   "start": 772.05,
   "end": 773.39,
   "text": "אבל לא רק את ביתו של רבי זושה,"
  },
  {
   "start": 773.95,
   "end": 775.41,
   "text": "פיני עזב את המקצוע שלו,"
  },
  {
   "start": 775.85,
   "end": 777.05,
   "text": "פיני עזב את הסבלות,"
  },
  {
   "start": 777.61,
   "end": 779.29,
   "text": "פיני הצטרף לבית המדרש,"
  },
  {
   "start": 781.37,
   "end": 784.87,
   "text": "וזכה הוא והצאצאים שלו לחסות בצל השם."
  },
  {
   "start": 784.87,
   "end": 790.33,
   "text": "כל ימיהם היו עוסקים בתורה ויראת שמיים ומצוות."
  }
 ]
}