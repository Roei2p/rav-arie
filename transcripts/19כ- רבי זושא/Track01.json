{
 "disc": "19כ- רבי זושא",
 "track": "Track01",
 "duration": 1391.16,
 "segments": [
  {
   "start": 41.97,
   "end": 42.85,
   "text": "בבית משפחת"
  },
  {
   "start": 43.77,
   "end": 44.63,
   "text": "רבי אליעזר"
  },
  {
   "start": 46.03,
   "end": 46.63,
   "text": "ורעייתו"
  },
  {
   "start": 47.45,
   "end": 48.67,
   "text": "מרים לבית ליפמן."
  },
  {
   "start": 50.56,
   "end": 51.26,
   "text": "הם פתחו את הדלת,"
  },
  {
   "start": 52.38,
   "end": 53.7,
   "text": "זו הייתה חבורת קבצנים,"
  },
  {
   "start": 56.7,
   "end": 57.46,
   "text": "הם ערכו אותם."
  },
  {
   "start": 58.7,
   "end": 60.78,
   "text": "משפחת ליפמן הייתה ידועה כבעלת חסד"
  },
  {
   "start": 62.6,
   "end": 63.38,
   "text": "מעין כמותה."
  },
  {
   "start": 64.9,
   "end": 65.52,
   "text": "ובמיוחד,"
  },
  {
   "start": 66.2,
   "end": 66.68,
   "text": "במיוחד,"
  },
  {
   "start": 67.9,
   "end": 74.44,
   "text": "רבי אליעזר העניק יחס מיוחד לקבצן שהיה בפינה, שכוח שם,"
  },
  {
   "start": 74.84,
   "end": 77.02,
   "text": "מוכה שחין, כולו פצעים,"
  },
  {
   "start": 78.18,
   "end": 79.14,
   "text": "בעל מראה חולני."
  },
  {
   "start": 82.14,
   "end": 86.1,
   "text": "היו לו את כל הסממנים שגורמים לאנשים להתרחק מהם."
  },
  {
   "start": 87.8,
   "end": 92.46,
   "text": "אבל רבי אליעזר ראה, הרגיש את הכאב,"
  },
  {
   "start": 93.6,
   "end": 96.78,
   "text": "את המצוקה של אותו קבצן, והעניק לו יחס מיוחד."
  },
  {
   "start": 98.88,
   "end": 102.06,
   "text": "לפעמים, אתם יודעים, יש מצווה מיוחדת, שבכוח שלה,"
  },
  {
   "start": 102.78,
   "end": 105.98,
   "text": "בכוח שלה אתה יכול פתאום לזכות לאוצרות."
  },
  {
   "start": 108.65,
   "end": 112.67,
   "text": "לשפע רוחני או גשמי מיוחד."
  },
  {
   "start": 115.24,
   "end": 117.34,
   "text": "כשהקבצן פנה ללכת,"
  },
  {
   "start": 119.34,
   "end": 120.0,
   "text": "הוא הסתובב,"
  },
  {
   "start": 120.72,
   "end": 122.62,
   "text": "ואז העיניים שלו הבזיקו באור מיוחד,"
  },
  {
   "start": 124.89,
   "end": 125.31,
   "text": "והוא אמר"
  },
  {
   "start": 126.49,
   "end": 127.39,
   "text": "לרבי אליעזר ורעייתו,"
  },
  {
   "start": 131.38,
   "end": 133.04,
   "text": "בזכות המעשים שלכם,"
  },
  {
   "start": 134.0,
   "end": 138.4,
   "text": "בזכות הדאגה שלכם הכנה לכל יהודי וגם ליהודי כמוני,"
  },
  {
   "start": 138.98,
   "end": 139.86,
   "text": "אני מברך אתכם"
  },
  {
   "start": 140.72,
   "end": 144.38,
   "text": "שייוולדו לכם בנים כמוני."
  },
  {
   "start": 151.36,
   "end": 154.36,
   "text": "אברך אתכם, שייוולדו לכם בנים כמוני."
  },
  {
   "start": 157.85,
   "end": 165.36,
   "text": "למשפחת ליפמן נולדו אברהם,"
  },
  {
   "start": 167.98,
   "end": 168.48,
   "text": "נתן,"
  },
  {
   "start": 169.88,
   "end": 173.44,
   "text": "לימים אב בדין סטוצ'ין, רבי אברהם."
  },
  {
   "start": 174.4,
   "end": 175.82,
   "text": "הבן השלישי היה אלימלך,"
  },
  {
   "start": 176.5,
   "end": 183.54,
   "text": "לימים רבי אלימלך מליז'נסק והבן הרביעי זושה משולם זיסל,"
  },
  {
   "start": 183.54,
   "end": 189.12,
   "text": "רבי זושה מהאניפולי, מי היה אותו קבצן?"
  },
  {
   "start": 189.7,
   "end": 192.13,
   "text": "היא לא יודעת."
  },
  {
   "start": 193.77,
   "end": 196.79,
   "text": "אבל רבי אלימלך, רבי זושה,"
  },
  {
   "start": 197.81,
   "end": 201.83,
   "text": "כל הילדים גדלו בבית, בית פשוט,"
  },
  {
   "start": 202.29,
   "end": 202.83,
   "text": "אבל עם הרבה,"
  },
  {
   "start": 203.17,
   "end": 204.25,
   "text": "עם הרבה יראת שמיים,"
  },
  {
   "start": 204.59,
   "end": 205.65,
   "text": "עם הרבה קדושה,"
  },
  {
   "start": 206.09,
   "end": 207.45,
   "text": "עם הרבה חום ואהבה."
  },
  {
   "start": 209.01,
   "end": 210.67,
   "text": "את זה אי אפשר לקנות לא בכסף,"
  },
  {
   "start": 212.51,
   "end": 213.87,
   "text": "לא באמצעים חומריים."
  },
  {
   "start": 217.08,
   "end": 218.68,
   "text": "אבא יושב ומקריא תהילים,"
  },
  {
   "start": 219.86,
   "end": 222.22,
   "text": "ואימא, שלא ידעה לקרוא, הייתה חוזרת,"
  },
  {
   "start": 223.52,
   "end": 225.4,
   "text": "חוזרת אחריו בשמחה."
  },
  {
   "start": 228.1,
   "end": 230.18,
   "text": "לימים סיפר רבי אלימלך מליז'נסק"
  },
  {
   "start": 232.43,
   "end": 235.51,
   "text": "על הבית שהוא גדל, אמר, אימא, אימא לא ידעה לקרוא בסידור."
  },
  {
   "start": 236.33,
   "end": 237.99,
   "text": "את ברכות השחר ידעה בעל פה,"
  },
  {
   "start": 239.03,
   "end": 243.33,
   "text": "אבל במקום שבו עמדה אימא ואמרה את ברכות השחר,"
  },
  {
   "start": 243.91,
   "end": 246.75,
   "text": "שרתה השכינה הקדושה בכבודה ובעצמה."
  },
  {
   "start": 247.41,
   "end": 250.43,
   "text": "במקום שבו עמדה אימא ואמרה את ברכות השחר,"
  },
  {
   "start": 250.93,
   "end": 275.44,
   "text": "שרתה השכינה הקדושה כפטרו ברבות הימים והשאירו אחריהם"
  },
  {
   "start": 276.54,
   "end": 278.1,
   "text": "עושר, עושר גדול."
  },
  {
   "start": 278.8,
   "end": 280.32,
   "text": "הם הצליחו, היה להם ברכה גם גשמית."
  },
  {
   "start": 282.44,
   "end": 287.74,
   "text": "רבי אברהם, הבן הגדול, קיבל את הכסף המזומן על פי הירושה."
  },
  {
   "start": 289.5,
   "end": 290.62,
   "text": "הבן השני, רבי נתן,"
  },
  {
   "start": 291.88,
   "end": 292.26,
   "text": "קיבל"
  },
  {
   "start": 293.28,
   "end": 295.84,
   "text": "שדות ובתים שהיה בבעלותם."
  },
  {
   "start": 296.8,
   "end": 299.22,
   "text": "רבי אלימלך קיבל תכשיטים וכלי בית."
  },
  {
   "start": 300.14,
   "end": 303.06,
   "text": "ורבי זושה, אותו זושה הבן האחרון,"
  },
  {
   "start": 303.66,
   "end": 304.68,
   "text": "קיבל את החובות."
  },
  {
   "start": 305.52,
   "end": 306.4,
   "text": "הוא היה צריך ללכת"
  },
  {
   "start": 308.22,
   "end": 311.44,
   "text": "ולאסוף לגבות את כל החובות מבעלי החוב שהיו להם,"
  },
  {
   "start": 311.76,
   "end": 313.02,
   "text": "והיו להם הרבה בעלי חוב."
  },
  {
   "start": 315.2,
   "end": 319.16,
   "text": "אבל זושה שלנו לא יכל ללכת ולגבות חובות."
  },
  {
   "start": 319.86,
   "end": 323.26,
   "text": "הוא לא יכל לצער יהודי, ללכת לעמוד לו."
  },
  {
   "start": 324.3,
   "end": 325.68,
   "text": "כנושה אני לא מסוגל."
  },
  {
   "start": 326.78,
   "end": 327.64,
   "text": "אז הוא עזב את הכל,"
  },
  {
   "start": 328.18,
   "end": 330.08,
   "text": "את כל הרכוש, את הכל, ויתר על הכל."
  },
  {
   "start": 330.54,
   "end": 330.98,
   "text": "נסע,"
  },
  {
   "start": 331.96,
   "end": 334.12,
   "text": "נסע לדוד שלו רבי פיילט,"
  },
  {
   "start": 335.24,
   "end": 337.98,
   "text": "שהיה משמש בקודש אצל המגיד הקדוש ממזריץ',"
  },
  {
   "start": 338.6,
   "end": 340.52,
   "text": "נסע ונהפך לתלמיד המגיד,"
  },
  {
   "start": 353.41,
   "end": 354.55,
   "text": "כך חולפות להם השנים."
  },
  {
   "start": 355.87,
   "end": 358.91,
   "text": "רבי אלימלך גודל בתורה,"
  },
  {
   "start": 360.01,
   "end": 363.83,
   "text": "שמעו יוצא בכל העולם כתלמיד חכם עצום מאין כמותו."
  },
  {
   "start": 370.57,
   "end": 371.45,
   "text": "יום אחד מגיע,"
  },
  {
   "start": 373.77,
   "end": 374.49,
   "text": "נווד עני,"
  },
  {
   "start": 376.74,
   "end": 377.64,
   "text": "קרוע בגדים,"
  },
  {
   "start": 383.44,
   "end": 384.54,
   "text": "זושה, האח הקטן,"
  },
  {
   "start": 386.68,
   "end": 388.12,
   "text": "כשראו אותו במצב שלו,"
  },
  {
   "start": 389.34,
   "end": 390.48,
   "text": "שלחו אותו אל האופה."
  },
  {
   "start": 392.2,
   "end": 394.48,
   "text": "שכרו לו דירה בבית האופה, שם הוא יוכל לגור,"
  },
  {
   "start": 395.0,
   "end": 396.7,
   "text": "אולי לעבוד גם קצת, בבית האופה."
  },
  {
   "start": 399.52,
   "end": 400.72,
   "text": "אולי יצא ממנו משהו."
  },
  {
   "start": 401.7,
   "end": 403.86,
   "text": "במקום ללכת וללמוד, הלך להסתובב בעולם."
  },
  {
   "start": 406.85,
   "end": 407.57,
   "text": "טוב שעת לילה,"
  },
  {
   "start": 408.23,
   "end": 410.01,
   "text": "בבית האופה לא ישנים כל כך טוב."
  },
  {
   "start": 411.73,
   "end": 415.51,
   "text": "כי מהחדר, שם הם שם שכרו, החדר שבו גר לו זושה,"
  },
  {
   "start": 417.39,
   "end": 417.61,
   "text": "האח"
  },
  {
   "start": 418.83,
   "end": 420.31,
   "text": "של הצדיק רבי אלימלך,"
  },
  {
   "start": 421.15,
   "end": 424.57,
   "text": "נשמעים כל הלילה קולות,"
  },
  {
   "start": 426.13,
   "end": 426.87,
   "text": "קולות של בכי,"
  },
  {
   "start": 428.09,
   "end": 429.13,
   "text": "שאחרי כמה זמן מתחלפות,"
  },
  {
   "start": 430.47,
   "end": 433.91,
   "text": "מתחלפים להם בקולות של שיר ושמחה,"
  },
  {
   "start": 435.53,
   "end": 436.71,
   "text": "ובני הבית לא ישנים."
  },
  {
   "start": 438.21,
   "end": 440.03,
   "text": "הלכו, התלוננו, אמרו רבי אלימלך,"
  },
  {
   "start": 440.65,
   "end": 442.63,
   "text": "אח שלך, אני לא יודע, אי אפשר לארח אותו,"
  },
  {
   "start": 443.85,
   "end": 444.85,
   "text": "אי אפשר שיגור אצלנו,"
  },
  {
   "start": 445.45,
   "end": 446.15,
   "text": "אי אפשר לסבול כך."
  },
  {
   "start": 447.41,
   "end": 448.09,
   "text": "מאוד משונה."
  },
  {
   "start": 449.03,
   "end": 450.79,
   "text": "אמר רבי אלימלך טוב, בואו תביאו אותו אליי."
  },
  {
   "start": 454.94,
   "end": 457.24,
   "text": "וככה הוא עבר לגור אצל רבי אלימלך."
  },
  {
   "start": 462.13,
   "end": 464.21,
   "text": "בבית רבי אלימלך, ערב שבת,"
  },
  {
   "start": 465.47,
   "end": 468.37,
   "text": "היה מנהג ככה לשחוט את העופות, היה בא השוחט"
  },
  {
   "start": 469.61,
   "end": 471.25,
   "text": "המוחזק ככה כירה שמיים"
  },
  {
   "start": 472.31,
   "end": 474.17,
   "text": "של העיירה שהיה באה בשמחה,"
  },
  {
   "start": 475.27,
   "end": 476.93,
   "text": "בגאון ובהדר ושוחט את העופות."
  },
  {
   "start": 481.54,
   "end": 482.26,
   "text": "גם ערב שבת"
  },
  {
   "start": 483.9,
   "end": 484.14,
   "text": "הזה"
  },
  {
   "start": 485.28,
   "end": 486.8,
   "text": "הוא הגיע לשם לשחוט את העופות."
  },
  {
   "start": 488.94,
   "end": 490.08,
   "text": "חזר, אבל אז לפתע."
  },
  {
   "start": 493.61,
   "end": 498.07,
   "text": "זושה יצא מהפינה בו ישב בשקט ומלמל לו תהילים,"
  },
  {
   "start": 499.01,
   "end": 500.61,
   "text": "ואמר, סליחה, אתה השוחט?"
  },
  {
   "start": 501.33,
   "end": 502.33,
   "text": "אני רוצה לראות את הסכין."
  },
  {
   "start": 504.17,
   "end": 507.81,
   "text": "ורבי אלימלך מתפלא, אחי יודע לבדוק סכין, ממתי?"
  },
  {
   "start": 508.49,
   "end": 509.35,
   "text": "הרי הוא לא יודע כלל תורה."
  },
  {
   "start": 510.55,
   "end": 511.21,
   "text": "אבל רבי זושה"
  },
  {
   "start": 511.97,
   "end": 513.57,
   "text": "היה החלטי, אני רוצה לראות את הסכין."
  },
  {
   "start": 515.57,
   "end": 516.09,
   "text": "והשוחט,"
  },
  {
   "start": 518.19,
   "end": 520.89,
   "text": "שהיה חדור בשמחה,"
  },
  {
   "start": 520.89,
   "end": 522.85,
   "text": "חדור בגאווה במקצוע שלו."
  },
  {
   "start": 524.01,
   "end": 526.29,
   "text": "בטוח ביראת שמיים שלו הוציא את הסכין,"
  },
  {
   "start": 527.03,
   "end": 527.59,
   "text": "אמר בבקשה."
  },
  {
   "start": 529.65,
   "end": 533.85,
   "text": "וזושה רבי זושה בודק את הסכין ואומר פגום,"
  },
  {
   "start": 534.59,
   "end": 535.07,
   "text": "פגום."
  },
  {
   "start": 538.38,
   "end": 539.38,
   "text": "והשוחט נרתע."
  },
  {
   "start": 540.02,
   "end": 540.72,
   "text": "מה פגום?"
  },
  {
   "start": 542.81,
   "end": 550.58,
   "text": "הלך השוחט וישב ועבד על הסכין,"
  },
  {
   "start": 551.06,
   "end": 559.46,
   "text": "חוזר חזרה הנה ושוב פגום והשוחט לא יודע מה לעשות."
  },
  {
   "start": 560.38,
   "end": 561.3,
   "text": "הלך וסידר עוד פעם,"
  },
  {
   "start": 562.06,
   "end": 564.18,
   "text": "ובא אליו, אבל הפעם כבר מתוך כאב,"
  },
  {
   "start": 564.7,
   "end": 567.92,
   "text": "ככה אתה עושה לי לפני רבי אלימלך,"
  },
  {
   "start": 568.68,
   "end": 570.8,
   "text": "לפני כולם אתה תוציא לי כל כך,"
  },
  {
   "start": 571.36,
   "end": 572.38,
   "text": "כל כך יליצר מה זה?"
  },
  {
   "start": 573.18,
   "end": 574.52,
   "text": "השוחט פשוט התחיל להוריד דמעות,"
  },
  {
   "start": 575.14,
   "end": 576.14,
   "text": "אמר לו נו תגיד עכשיו,"
  },
  {
   "start": 576.86,
   "end": 578.56,
   "text": "יש לך עוד משהו להגיד על הסכין הזאת?"
  },
  {
   "start": 579.72,
   "end": 580.3,
   "text": "וכולו ככה"
  },
  {
   "start": 581.5,
   "end": 581.92,
   "text": "התחיל לבכות,"
  },
  {
   "start": 583.2,
   "end": 584.3,
   "text": "בכה בשברון לב,"
  },
  {
   "start": 590.97,
   "end": 593.27,
   "text": "ואז רבי זושל מסתכל ואומר לו, או,"
  },
  {
   "start": 593.89,
   "end": 594.75,
   "text": "זו סכין ראויה."
  },
  {
   "start": 598.9,
   "end": 600.92,
   "text": "והשוחט שחט והסתלק לו."
  },
  {
   "start": 602.52,
   "end": 603.56,
   "text": "רבי אלימלך היה המום,"
  },
  {
   "start": 604.34,
   "end": 606.96,
   "text": "הוא קרא לאחיו ואמר לו, תגיד לי,"
  },
  {
   "start": 609.18,
   "end": 611.56,
   "text": "מאיפה אתה יודע שהסכין פגומה?"
  },
  {
   "start": 612.6,
   "end": 616.12,
   "text": "שאתה אמרת שזה פגום, שזה לא כשר, מאיפה?"
  },
  {
   "start": 622.65,
   "end": 624.15,
   "text": "ענה לו רבי זושה,"
  },
  {
   "start": 624.87,
   "end": 625.89,
   "text": "אמר לו, אחי היקר,"
  },
  {
   "start": 626.53,
   "end": 628.79,
   "text": "אחי אהובי, הסכין הייתה מצוינת."
  },
  {
   "start": 630.11,
   "end": 630.75,
   "text": "השוחט,"
  },
  {
   "start": 632.07,
   "end": 633.77,
   "text": "הלב שלו היה פגום,"
  },
  {
   "start": 634.77,
   "end": 637.07,
   "text": "הלב שלו היה פגום במידת הגאווה."
  },
  {
   "start": 639.31,
   "end": 640.45,
   "text": "בגלל זה אני אמרתי פגום."
  },
  {
   "start": 641.25,
   "end": 643.57,
   "text": "רק כשהוא בא, מתוך שברון הלב,"
  },
  {
   "start": 644.77,
   "end": 646.77,
   "text": "מתוך כניעה לשם יתברך,"
  },
  {
   "start": 647.33,
   "end": 649.69,
   "text": "מתוך הבנה שהוא האחד שעושה את רצון השם,"
  },
  {
   "start": 649.99,
   "end": 652.91,
   "text": "שגם השחיטה שלו תלויה בשם יתברך."
  },
  {
   "start": 653.21,
   "end": 654.47,
   "text": "בפעם האחרונה שהוא בא,"
  },
  {
   "start": 654.85,
   "end": 656.31,
   "text": "הוא יתפלל לפני כן לשם גם."
  },
  {
   "start": 657.25,
   "end": 660.87,
   "text": "בעולם שלא יהיה לי בושה, בעולם תעשה לי טובה שהסכין תהיה בסדר."
  },
  {
   "start": 661.75,
   "end": 665.45,
   "text": "לא רק המעשה כשר, אחי היקר,"
  },
  {
   "start": 666.31,
   "end": 668.27,
   "text": "גם המחשבה צריכה להיות כשרה,"
  },
  {
   "start": 668.87,
   "end": 670.13,
   "text": "גם הלב צריך להיות כשר."
  },
  {
   "start": 672.33,
   "end": 674.55,
   "text": "רבי אלימלך הביט באחיו,"
  },
  {
   "start": 676.98,
   "end": 681.38,
   "text": "מתחיל להבין שאחיו לא כל כך פשוט"
  },
  {
   "start": 682.2,
   "end": 683.08,
   "text": "כמו שהוא נראה."
  },
  {
   "start": 695.66,
   "end": 697.24,
   "text": "שואל לו רבי זושה מהניפולי,"
  },
  {
   "start": 697.88,
   "end": 698.58,
   "text": "רבי זושה,"
  },
  {
   "start": 699.2,
   "end": 699.76,
   "text": "אצל אחיו,"
  },
  {
   "start": 700.38,
   "end": 701.22,
   "text": "רבי אלימלך."
  },
  {
   "start": 703.06,
   "end": 703.82,
   "text": "ולאט לאט,"
  },
  {
   "start": 704.8,
   "end": 717.82,
   "text": "רבי אלימלך מבין ולומד מאחיו את עבודת השם המיוחדת,"
  },
  {
   "start": 719.12,
   "end": 721.12,
   "text": "עבודת השם מיוחדת של יהודי פשוט."
  },
  {
   "start": 734.68,
   "end": 738.18,
   "text": "בזושה אין תורה, בזושה אין דעת ואין תבונה,"
  },
  {
   "start": 738.84,
   "end": 739.6,
   "text": "אומר רבי זושה."
  },
  {
   "start": 740.42,
   "end": 746.2,
   "text": "לכן זושה עובד קשה ומתנהג משונה כעבד לשרת את בורא העולם."
  },
  {
   "start": 746.8,
   "end": 752.06,
   "text": "אבל אתה אלימלך, אתה אחי, אתה מלך, אתה תלמיד חכם גדול, יש לך תורה, יש לך דעת."
  },
  {
   "start": 752.6,
   "end": 757.72,
   "text": "אתה יכול להיות מהיושבים ראשונה בהיכל של המלך, אם רק תרצה, אם רק תרצה."
  },
  {
   "start": 772.32,
   "end": 775.26,
   "text": "אך רבי אלימלך מצטרף לאחיו,"
  },
  {
   "start": 776.92,
   "end": 778.74,
   "text": "ומתחילים במסע של נדודים,"
  },
  {
   "start": 779.54,
   "end": 780.36,
   "text": "מסע של גלות."
  },
  {
   "start": 782.58,
   "end": 782.88,
   "text": "גלות"
  },
  {
   "start": 783.66,
   "end": 786.9,
   "text": "זה ללכת ולהסתובב בכל קהילות ישראל, בכל המקומות."
  },
  {
   "start": 787.48,
   "end": 788.72,
   "text": "לא לישון במקום אחד,"
  },
  {
   "start": 789.78,
   "end": 792.18,
   "text": "לא לשחוט במקום אחד יותר מ-24 שעות,"
  },
  {
   "start": 792.48,
   "end": 797.08,
   "text": "לא לישון במיתה ככה במזרון, נחנוכות,"
  },
  {
   "start": 797.64,
   "end": 802.3,
   "text": "לא לאכול מאכלים ערבים לחך,"
  },
  {
   "start": 802.76,
   "end": 803.58,
   "text": "הכל פשיטות,"
  },
  {
   "start": 804.22,
   "end": 806.18,
   "text": "הכל בקשיים, כדי לכפר על האבנות"
  },
  {
   "start": 807.24,
   "end": 808.94,
   "text": "לא רק שלהם, של כל עם ישראל."
  },
  {
   "start": 810.72,
   "end": 812.08,
   "text": "וככה הם עוברים בין שדות"
  },
  {
   "start": 813.7,
   "end": 814.72,
   "text": "קוצים מסביב,"
  },
  {
   "start": 815.76,
   "end": 818.32,
   "text": "הרוח מכה בעורפם,"
  },
  {
   "start": 819.88,
   "end": 821.64,
   "text": "פוסעים להם שני יהודים,"
  },
  {
   "start": 824.28,
   "end": 828.52,
   "text": "שאורם מתחיל להתנוצץ לו בעולם מהאחים הקדושים,"
  },
  {
   "start": 829.06,
   "end": 831.68,
   "text": "רבי אלימלך מליז'נסק ורבי זושה."
  },
  {
   "start": 832.6,
   "end": 836.38,
   "text": "הם נעים ונדים, מדי פעם אוכלים ומדי פעם ישנים,"
  },
  {
   "start": 840.35,
   "end": 846.37,
   "text": "כשהמטרה שלהם לכפר לכל עם ישראל שיושב לו בגלות ורוצה כבר להגיע לארץ ישראל."
  },
  {
   "start": 848.27,
   "end": 854.76,
   "text": "המטרה שלהם לקרב רחוקים על ידי תזכורת בעדינות,"
  },
  {
   "start": 858.74,
   "end": 860.48,
   "text": "וכך בכל מקום שהם עוברים,"
  },
  {
   "start": 861.18,
   "end": 862.46,
   "text": "מאורים את הלבבות,"
  },
  {
   "start": 863.04,
   "end": 866.2,
   "text": "מלהיטים את הנשמות, ואלפי נשמות עושות תשובה."
  },
  {
   "start": 869.98,
   "end": 874.74,
   "text": "הגלות לא קלה, רצופה ניסיונות, רצופה ייסורים, אבל הם נחושים בדרכם להמשיך."
  },
  {
   "start": 876.4,
   "end": 879.6,
   "text": "שני יהודים שנושאים את מסע ישראל על גבם."
  },
  {
   "start": 882.94,
   "end": 884.1,
   "text": "הם הגיעו לכפר אחד."
  },
  {
   "start": 885.46,
   "end": 887.46,
   "text": "יום אחד הגיעו לאיזה כפר מתאכסנים שם,"
  },
  {
   "start": 888.96,
   "end": 890.62,
   "text": "ולפנות בוקר יצאו לדרכם."
  },
  {
   "start": 893.59,
   "end": 896.95,
   "text": "הם יוצאים והם לא יודעים שבמקום שהם התאכסנו,"
  },
  {
   "start": 896.95,
   "end": 898.63,
   "text": "התאכסנו, התחוללם מהומה."
  },
  {
   "start": 899.23,
   "end": 900.95,
   "text": "התברר שבלילה גנבו משם רכוש."
  },
  {
   "start": 905.49,
   "end": 908.71,
   "text": "והחשד נפל על מי? על שתי היהודים האלה,"
  },
  {
   "start": 910.23,
   "end": 911.93,
   "text": "שלפנות בוקר כבר יצאו לדרכם."
  },
  {
   "start": 913.61,
   "end": 914.61,
   "text": "התפתח מרדף,"
  },
  {
   "start": 916.05,
   "end": 917.69,
   "text": "ומאחר שהם לא בורחים משום דבר,"
  },
  {
   "start": 917.99,
   "end": 919.95,
   "text": "הולכים פשוט להם במעלה השביל,"
  },
  {
   "start": 922.1,
   "end": 923.52,
   "text": "תוך זמן קצר הם נתפסו."
  },
  {
   "start": 924.44,
   "end": 926.54,
   "text": "היכן הרכוש? שאלו אותם."
  },
  {
   "start": 927.32,
   "end": 927.7,
   "text": "מה הם יגידו?"
  },
  {
   "start": 928.36,
   "end": 929.44,
   "text": "שותקים, לא מבינים."
  },
  {
   "start": 930.4,
   "end": 931.32,
   "text": "היכן הרכוש?"
  },
  {
   "start": 933.78,
   "end": 934.22,
   "text": "שתיקה."
  },
  {
   "start": 935.48,
   "end": 938.52,
   "text": "תפסו אותם והיכו אותם מכות."
  },
  {
   "start": 939.42,
   "end": 940.36,
   "text": "איזה מכות."
  },
  {
   "start": 941.2,
   "end": 941.84,
   "text": "איזה כאב."
  },
  {
   "start": 943.48,
   "end": 945.68,
   "text": "והם סובלים ושותקים."
  },
  {
   "start": 949.18,
   "end": 951.3,
   "text": "זמן מה אחר כך השאירו אותם מוטלים בדרך."
  },
  {
   "start": 953.61,
   "end": 954.53,
   "text": "שותתי דם."
  },
  {
   "start": 959.91,
   "end": 960.95,
   "text": "קם רבי זושה."
  },
  {
   "start": 961.95,
   "end": 963.81,
   "text": "ניגש לרבי אלימלך ואומן לו תראה, אחי."
  },
  {
   "start": 964.77,
   "end": 965.73,
   "text": "אנחנו שלא גנבנו,"
  },
  {
   "start": 966.33,
   "end": 967.23,
   "text": "קיבלנו מכות כאלו."
  },
  {
   "start": 969.03,
   "end": 970.53,
   "text": "אנחנו לא גנבנו, לא עשינו כלום,"
  },
  {
   "start": 970.97,
   "end": 972.89,
   "text": "וקיבלנו מכות שכאלו."
  },
  {
   "start": 973.93,
   "end": 977.67,
   "text": "אוי ואבוי, מה יקבלו הגנבים האמיתיים בבית דין של מעלה?"
  },
  {
   "start": 981.02,
   "end": 983.52,
   "text": "תראה איזה צער יהיה לאותם גנבים אמיתיים."
  },
  {
   "start": 984.4,
   "end": 989.92,
   "text": "כמה אנחנו צריכים ללכת ולהמשיך להסתובב כדי לכפר על החטאים שלא יהיה צער לעם ישראל,"
  },
  {
   "start": 990.24,
   "end": 992.96,
   "text": "לנשמות של עם ישראל שיגיעו למעלה לשמיים."
  },
  {
   "start": 993.96,
   "end": 994.8,
   "text": "אם אנחנו,"
  },
  {
   "start": 995.44,
   "end": 997.12,
   "text": "שלא חטאנו, קיבלנו"
  },
  {
   "start": 998.66,
   "end": 1000.9,
   "text": "כל כך כואב, כמה יקבלו אלה?"
  },
  {
   "start": 1001.42,
   "end": 1003.12,
   "text": "בוא אחי, בוא בוא, בוא נמשיך."
  },
  {
   "start": 1003.52,
   "end": 1005.08,
   "text": "בואו נמשיך לכפר על עם ישראל."
  },
  {
   "start": 1005.88,
   "end": 1006.54,
   "text": "איזה ראייה,"
  },
  {
   "start": 1008.96,
   "end": 1009.74,
   "text": "איזו נשמה."
  },
  {
   "start": 1012.9,
   "end": 1013.92,
   "text": "פעם אחת הם הגיעו לפונדק."
  },
  {
   "start": 1015.66,
   "end": 1018.8,
   "text": "בעל הפונדק היהודי אמר להם, תעשו לי טובה."
  },
  {
   "start": 1020.62,
   "end": 1024.6,
   "text": "אמר לשתי הקבצנים, תראו, מקום אחר פה להיות, אין לכם פה, הכל גויים מסביב."
  },
  {
   "start": 1025.3,
   "end": 1028.08,
   "text": "אני יכול לתת לכם שמה, אתם רואים באח, יש מקום שם ליד האח."
  },
  {
   "start": 1029.1,
   "end": 1031.84,
   "text": "תהיו שמה, תשנו שמה, אבל תצטופפו שלא יראו אתכם."
  },
  {
   "start": 1032.7,
   "end": 1035.94,
   "text": "כי באמצע הלילה ככה, נכנסים לפה הרבה פעמים חברות של גויים,"
  },
  {
   "start": 1036.36,
   "end": 1037.1,
   "text": "ומתחילים לשתות."
  },
  {
   "start": 1037.88,
   "end": 1040.82,
   "text": "ואז הם ייתקלו ביהודי, השם ירחם, מה הם יעשו?"
  },
  {
   "start": 1041.56,
   "end": 1045.26,
   "text": "אז עדיף שלא יראו אתכם, פשוט תתחבאו שמה בחסות החשיכה, תישנו שמה בשקט."
  },
  {
   "start": 1050.94,
   "end": 1052.6,
   "text": "האחים הקדושים קיבלו את ההצעה,"
  },
  {
   "start": 1053.64,
   "end": 1054.96,
   "text": "נשכבו שם ליד האח."
  },
  {
   "start": 1056.16,
   "end": 1062.28,
   "text": "רבי זושה התעקש על זה שרבי אלימלך יהיה ליד האח קרוב יותר, שכי שם חם יותר, והוא אחיו הגדול,"
  },
  {
   "start": 1062.66,
   "end": 1063.3,
   "text": "שיהיה לו חם."
  },
  {
   "start": 1063.82,
   "end": 1064.92,
   "text": "הוא ישב קצת מבחוץ יותר."
  },
  {
   "start": 1066.1,
   "end": 1066.92,
   "text": "וככה הם נחים,"
  },
  {
   "start": 1068.18,
   "end": 1070.64,
   "text": "לקראת חצות נכנסת חבורה של גויים,"
  },
  {
   "start": 1071.3,
   "end": 1074.96,
   "text": "מתחילים לשתות ושותים ושותים"
  },
  {
   "start": 1077.95,
   "end": 1082.87,
   "text": "ומבין החליפות היפות והנימוסים מתחיל להתפרץ החיית אדם"
  },
  {
   "start": 1084.29,
   "end": 1087.49,
   "text": "ומחפשים משהו לפרוק את היצרים שלהם"
  },
  {
   "start": 1088.53,
   "end": 1089.59,
   "text": "ואז אחד שם לב"
  },
  {
   "start": 1090.83,
   "end": 1091.89,
   "text": "אחד שם לב שם בפינה"
  },
  {
   "start": 1092.71,
   "end": 1094.55,
   "text": "יש איזו דמות שוכבת לה מוטלת לה"
  },
  {
   "start": 1096.52,
   "end": 1098.98,
   "text": "ומתקרב יהודי"
  },
  {
   "start": 1100.5,
   "end": 1102.0,
   "text": "יש פה יהודי הוא קורא"
  },
  {
   "start": 1102.0,
   "end": 1104.28,
   "text": "וכל הגויים עטינו"
  },
  {
   "start": 1106.08,
   "end": 1106.8,
   "text": "אל הטרף."
  },
  {
   "start": 1107.82,
   "end": 1108.88,
   "text": "הם תפסו את רבי זושה"
  },
  {
   "start": 1110.06,
   "end": 1111.68,
   "text": "שישב קצת יותר בחוץ,"
  },
  {
   "start": 1112.58,
   "end": 1115.44,
   "text": "הרימו אותו והביאו אותו למרכז הרחבה,"
  },
  {
   "start": 1118.89,
   "end": 1119.59,
   "text": "הוציאו שוט"
  },
  {
   "start": 1121.39,
   "end": 1122.49,
   "text": "מאיזשהו מקום"
  },
  {
   "start": 1123.57,
   "end": 1125.73,
   "text": "ואמרו לו עכשיו אנא יהודי אתה תרקוד לנו"
  },
  {
   "start": 1126.57,
   "end": 1128.49,
   "text": "והתחילו להכות אותו"
  },
  {
   "start": 1129.07,
   "end": 1129.87,
   "text": "ולהרקיד אותו"
  },
  {
   "start": 1130.93,
   "end": 1134.21,
   "text": "וזושה רוקד, רבי זושה רוקד עוצם עיניים"
  },
  {
   "start": 1134.67,
   "end": 1135.43,
   "text": "ורוקד,"
  },
  {
   "start": 1137.21,
   "end": 1139.59,
   "text": "והוא מכוון לכפרת עם ישראל,"
  },
  {
   "start": 1141.43,
   "end": 1143.61,
   "text": "ומקבל עליו את הדין באהבה,"
  },
  {
   "start": 1144.25,
   "end": 1145.33,
   "text": "ומרקידים אותו,"
  },
  {
   "start": 1145.67,
   "end": 1149.25,
   "text": "והוא רוקד ורוקד ורוקד ככה שלושת רבעי שעה,"
  },
  {
   "start": 1149.69,
   "end": 1150.95,
   "text": "והם צוהלים הגויים,"
  },
  {
   "start": 1154.43,
   "end": 1158.06,
   "text": "אך השלושת רבעי שעה כבר הספיק להם,"
  },
  {
   "start": 1159.32,
   "end": 1159.76,
   "text": "אז הם הפסיקו,"
  },
  {
   "start": 1160.82,
   "end": 1163.62,
   "text": "ורבי זושה גרר את עצמו אל הפינה שם באח."
  },
  {
   "start": 1165.14,
   "end": 1166.1,
   "text": "רבי אלימלך אומר לו,"
  },
  {
   "start": 1166.9,
   "end": 1167.7,
   "text": "בוא, בוא אחי,"
  },
  {
   "start": 1167.88,
   "end": 1170.56,
   "text": "בוא, אתה תיכנס קרוב לאח, ושאם הם יבואו עוד פעם,"
  },
  {
   "start": 1171.64,
   "end": 1172.46,
   "text": "אז הם ייקחו אותי."
  },
  {
   "start": 1174.12,
   "end": 1175.36,
   "text": "שלא ייקחו אותך עוד פעם."
  },
  {
   "start": 1176.2,
   "end": 1177.26,
   "text": "רבי זושה לא מוכן."
  },
  {
   "start": 1178.9,
   "end": 1179.5,
   "text": "לא, לא, לא."
  },
  {
   "start": 1180.14,
   "end": 1184.3,
   "text": "אלימלך, אם לזושה מגיע לקבל מכות ולרקוד,"
  },
  {
   "start": 1184.74,
   "end": 1185.9,
   "text": "אז זושה יקבל מכות."
  },
  {
   "start": 1187.26,
   "end": 1189.14,
   "text": "אם לי מגיע לקבל מכות, אז אני אקבל."
  },
  {
   "start": 1189.82,
   "end": 1190.78,
   "text": "לא יעזור כלום."
  },
  {
   "start": 1191.58,
   "end": 1192.88,
   "text": "ואם לא מגיע לי, אני לא אקבל."
  },
  {
   "start": 1196.55,
   "end": 1197.73,
   "text": "עוברות להם שעתיים,"
  },
  {
   "start": 1198.31,
   "end": 1200.15,
   "text": "ושוב אותם חבורה שטויים יותר,"
  },
  {
   "start": 1200.55,
   "end": 1201.83,
   "text": "ניגשים עוד פעם אל האח,"
  },
  {
   "start": 1202.43,
   "end": 1203.95,
   "text": "ועוד פעם מרמים את רבי זושה,"
  },
  {
   "start": 1204.69,
   "end": 1207.69,
   "text": "ועוד פעם הוא רוקד שלושת רבעי שעה"
  },
  {
   "start": 1208.47,
   "end": 1210.65,
   "text": "לכל מצלות השיכורים האלה."
  },
  {
   "start": 1212.17,
   "end": 1213.07,
   "text": "איזו אכזריות."
  },
  {
   "start": 1215.39,
   "end": 1220.07,
   "text": "אתה יכול לגדל כלבים חתולים, לשמור על דולפינים,"
  },
  {
   "start": 1220.83,
   "end": 1222.45,
   "text": "אבל לשמור על המין האנושי,"
  },
  {
   "start": 1223.01,
   "end": 1226.01,
   "text": "להתייחס בכבוד לבני אדם."
  },
  {
   "start": 1228.33,
   "end": 1231.87,
   "text": "המרחק הוא עצום מאוד. איך זה ייתכן? איזה אבסורד."
  },
  {
   "start": 1234.64,
   "end": 1240.4,
   "text": "והגויים האלה מתעללים ברבי זושה."
  },
  {
   "start": 1241.6,
   "end": 1242.78,
   "text": "ומקץ חצי שעה,"
  },
  {
   "start": 1244.34,
   "end": 1246.4,
   "text": "שוב רבי זושה גורר את עצמו אל האח."
  },
  {
   "start": 1247.26,
   "end": 1253.3,
   "text": "והפעם רבי אלימלך עומד על דעתו, אומר לו רבי זושה, אני אחיך הגדול, אתה חייב לשמוע לי. אני אומר לך,"
  },
  {
   "start": 1254.32,
   "end": 1255.16,
   "text": "אתה תהיה בחוץ."
  },
  {
   "start": 1255.68,
   "end": 1258.22,
   "text": "אתה תהיה קרוב לאח ואני אהיה בחוץ, לא יעזור כלום."
  },
  {
   "start": 1259.46,
   "end": 1261.84,
   "text": "ורבי זושה אין לו ברירה, גזירה של אח גדול."
  },
  {
   "start": 1262.64,
   "end": 1263.64,
   "text": "אז הוא נכנס לכיוון האח."
  },
  {
   "start": 1265.74,
   "end": 1266.2,
   "text": "יושב לו."
  },
  {
   "start": 1268.89,
   "end": 1272.87,
   "text": "זמן קצר אחר כך שוב ניגש אחד מהחבורה של השיכורים,"
  },
  {
   "start": 1276.26,
   "end": 1279.92,
   "text": "רואה את הגוף של רבי אלימלך ששוכב לו מחוץ,"
  },
  {
   "start": 1280.74,
   "end": 1282.88,
   "text": "הוא מסתכל, אומר, טוב, אותך כבר ארקדנו מספיק,"
  },
  {
   "start": 1283.48,
   "end": 1285.96,
   "text": "מסתכל פתאום, בפנים הוא רואה עוד גוף,"
  },
  {
   "start": 1287.16,
   "end": 1288.8,
   "text": "שוב של רבי זושה, רק הוא לא יודע."
  },
  {
   "start": 1289.72,
   "end": 1293.2,
   "text": "הנה, יש פה מישהו, עוד מישהו, בפנים, לא שמנו לב אליו, קום, קום, יהודי!"
  },
  {
   "start": 1293.6,
   "end": 1294.6,
   "text": "ומקים שוב,"
  },
  {
   "start": 1295.58,
   "end": 1297.58,
   "text": "מקים שוב את רבי זושה."
  },
  {
   "start": 1300.18,
   "end": 1303.52,
   "text": "אדי האלכוהול שלו לא מאפשרים לו לזהות שזה אותו אדם."
  },
  {
   "start": 1304.08,
   "end": 1305.76,
   "text": "ושוב הם מרימים את רבי זושה,"
  },
  {
   "start": 1306.22,
   "end": 1308.2,
   "text": "ושוב שמים אותו במרכז הרחבה,"
  },
  {
   "start": 1308.68,
   "end": 1315.98,
   "text": "ושוב מרקידים אותו לצלילי ניגון השוטה איום,"
  },
  {
   "start": 1317.24,
   "end": 1318.84,
   "text": "ניגון הכאב של יהודי,"
  },
  {
   "start": 1320.16,
   "end": 1322.18,
   "text": "של כל עם ישראל לאורך שנים של גלות,"
  },
  {
   "start": 1322.76,
   "end": 1326.08,
   "text": "של פוגרומים, של פיגועים, של כאב."
  },
  {
   "start": 1326.08,
   "end": 1329.44,
   "text": "ורבי זושה סמל היהודי,"
  },
  {
   "start": 1329.96,
   "end": 1331.16,
   "text": "סמל היהודי הנצחי,"
  },
  {
   "start": 1331.64,
   "end": 1332.98,
   "text": "סמל היהודי המנצח,"
  },
  {
   "start": 1333.84,
   "end": 1337.74,
   "text": "עוצם עיניים ומקבל עליו באהבה את הדין."
  },
  {
   "start": 1339.08,
   "end": 1340.04,
   "text": "וכשהוא חוזר,"
  },
  {
   "start": 1340.72,
   "end": 1341.8,
   "text": "גורר את עצמו בקושי,"
  },
  {
   "start": 1344.56,
   "end": 1349.92,
   "text": "פנה רבי זושה אל אחיו ואמר לו אלי מלך, לא אמרתי לך אלי מלך,"
  },
  {
   "start": 1350.38,
   "end": 1353.24,
   "text": "אם לזושה מגיע לקבל מכות ולרקוד,"
  },
  {
   "start": 1353.78,
   "end": 1357.3,
   "text": "אז זושה יקבל לא יעזור כלום, יהיה בפנים, יהיה בחוץ."
  },
  {
   "start": 1357.58,
   "end": 1362.84,
   "text": "אם לזושה נפסק לקבל מכות, אם ליהודי נפסק משהו לא יעזור כלום."
  },
  {
   "start": 1363.36,
   "end": 1366.56,
   "text": "בחוץ, בפנים, איפה שתהיה, צריך לקבל את זה באהבה."
  },
  {
   "start": 1368.26,
   "end": 1369.4,
   "text": "וקמו שניהם,"
  },
  {
   "start": 1370.36,
   "end": 1373.14,
   "text": "והחלו להתפלל בהתלהבות."
  }
 ]
}