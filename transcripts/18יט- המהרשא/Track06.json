{
 "disc": "18יט- המהרשא",
 "track": "Track06",
 "duration": 697.176,
 "segments": [
  {
   "start": 0.62,
   "end": 7.76,
   "text": "שמו של המהרשה נישא בפי כול."
  },
  {
   "start": 8.6,
   "end": 13.08,
   "text": "מכל המקומות מגיעים יהודים אל הרב הגדול לקבל ברכה,"
  },
  {
   "start": 13.7,
   "end": 14.1,
   "text": "עצה,"
  },
  {
   "start": 14.76,
   "end": 15.12,
   "text": "חיזוק,"
  },
  {
   "start": 15.96,
   "end": 19.52,
   "text": "וברכותיו של המהרשה אינם שוות רקם."
  },
  {
   "start": 20.12,
   "end": 21.0,
   "text": "רוח של חיות,"
  },
  {
   "start": 21.72,
   "end": 22.7,
   "text": "רוח של שמחה,"
  },
  {
   "start": 23.36,
   "end": 24.52,
   "text": "רוח של קדושה,"
  },
  {
   "start": 25.32,
   "end": 27.2,
   "text": "מפעימה את הלבבות היהודים."
  },
  {
   "start": 28.52,
   "end": 32.3,
   "text": "בין האנשים שנעמדו להם בתור הארוך,"
  },
  {
   "start": 32.92,
   "end": 35.58,
   "text": "שהשתרך לו שם בבית המהרשה."
  },
  {
   "start": 36.6,
   "end": 42.56,
   "text": "בלטו זוג שכל משך ההמתנה ישבו וקראו תהילים בחרדת קודש."
  },
  {
   "start": 43.58,
   "end": 46.44,
   "text": "וכשהגיע תורם להיכנס אל הקודש פנימה,"
  },
  {
   "start": 47.04,
   "end": 48.18,
   "text": "הם נכנסו בזהירות,"
  },
  {
   "start": 49.08,
   "end": 51.12,
   "text": "כאילו מנסים כמה שפחות להפריע לרב."
  },
  {
   "start": 52.98,
   "end": 53.64,
   "text": "כבוד הרב,"
  },
  {
   "start": 54.34,
   "end": 56.66,
   "text": "מזה עשרים שנה אנחנו נשואים,"
  },
  {
   "start": 57.6,
   "end": 58.28,
   "text": "ועדיין"
  },
  {
   "start": 58.88,
   "end": 60.6,
   "text": "לא זכינו לפרי בטן."
  },
  {
   "start": 60.6,
   "end": 63.4,
   "text": "המילים נאמרו בפשטות,"
  },
  {
   "start": 64.48,
   "end": 65.16,
   "text": "אבל העיניים,"
  },
  {
   "start": 66.0,
   "end": 66.98,
   "text": "העיניים אמרו את הכל."
  },
  {
   "start": 68.4,
   "end": 70.64,
   "text": "העיניים סיפרו סיפור כאוב"
  },
  {
   "start": 71.24,
   "end": 73.84,
   "text": "של עשרות שנות ציפייה,"
  },
  {
   "start": 74.62,
   "end": 74.92,
   "text": "שנות"
  },
  {
   "start": 75.52,
   "end": 75.98,
   "text": "תפילה,"
  },
  {
   "start": 76.86,
   "end": 77.64,
   "text": "שנות בדידות."
  },
  {
   "start": 79.62,
   "end": 80.26,
   "text": "אמר שעה,"
  },
  {
   "start": 81.62,
   "end": 85.48,
   "text": "שאב את כל הכאב שלהם, עצם את עיניו,"
  },
  {
   "start": 86.48,
   "end": 90.26,
   "text": "ואחר מספר דקות פתח אותם ואמר,"
  },
  {
   "start": 91.08,
   "end": 92.78,
   "text": "אני אברך אתכם בבן,"
  },
  {
   "start": 93.92,
   "end": 96.68,
   "text": "אבל תצטרכו להיות חזקים."
  },
  {
   "start": 97.72,
   "end": 99.54,
   "text": "אתם חייבים להיות חזקים,"
  },
  {
   "start": 100.62,
   "end": 102.64,
   "text": "אמר ולא הוסיף."
  },
  {
   "start": 104.7,
   "end": 105.66,
   "text": "שנה אחר כך"
  },
  {
   "start": 106.62,
   "end": 108.14,
   "text": "נולד בן בשעה טובה"
  },
  {
   "start": 109.56,
   "end": 110.6,
   "text": "למשפחה המאושרת."
  },
  {
   "start": 112.28,
   "end": 115.14,
   "text": "משה קינד האבא היה מאושר ושמח."
  },
  {
   "start": 116.0,
   "end": 117.44,
   "text": "לא רק שנולד לו בן,"
  },
  {
   "start": 118.08,
   "end": 120.62,
   "text": "במקביל גם העסקים שלו החלו לפרוח."
  },
  {
   "start": 121.64,
   "end": 124.7,
   "text": "עבור הבן הזה כדאי לדאוג לעתיד טוב."
  },
  {
   "start": 125.36,
   "end": 125.78,
   "text": "וכך,"
  },
  {
   "start": 126.66,
   "end": 127.26,
   "text": "לאט-לאט,"
  },
  {
   "start": 128.24,
   "end": 132.54,
   "text": "החל משה קינד להיכנס יותר ויותר אל עולם החומר."
  },
  {
   "start": 133.32,
   "end": 136.14,
   "text": "נדמה ששום דבר לא יפריע לו בדרכו."
  },
  {
   "start": 136.88,
   "end": 137.34,
   "text": "כך הוא חשב,"
  },
  {
   "start": 140.7,
   "end": 141.8,
   "text": "אבל יש מי שחשב אחרת."
  },
  {
   "start": 143.46,
   "end": 145.18,
   "text": "יום של חורף קר וגשום"
  },
  {
   "start": 145.94,
   "end": 147.58,
   "text": "ליווה את משה בדרכו לביתו."
  },
  {
   "start": 148.58,
   "end": 150.86,
   "text": "במשך כל אותו יום הוא חש חוסר מנוחה."
  },
  {
   "start": 151.58,
   "end": 152.88,
   "text": "הוא לא יכול להסביר למה."
  },
  {
   "start": 153.86,
   "end": 154.74,
   "text": "היה בו איזה חוסר שקט,"
  },
  {
   "start": 155.62,
   "end": 159.68,
   "text": "שככל שהוא קרב לביתו הלך וגדל, הלך והתעצם."
  },
  {
   "start": 160.56,
   "end": 161.32,
   "text": "כשקרב אל הבית"
  },
  {
   "start": 162.02,
   "end": 165.96,
   "text": "וראה את אנשי המשטרה ואת התגודדות הציבור הנאספים,"
  },
  {
   "start": 166.94,
   "end": 169.38,
   "text": "גל של חרדה עפף אותו."
  },
  {
   "start": 170.0,
   "end": 170.56,
   "text": "וזיעה קרה,"
  },
  {
   "start": 171.42,
   "end": 172.56,
   "text": "ירדה לה במורד גבו."
  },
  {
   "start": 173.66,
   "end": 174.5,
   "text": "בנך נחטף!"
  },
  {
   "start": 175.36,
   "end": 177.46,
   "text": "אמר מפקד המשטרה בקול מתכתי."
  },
  {
   "start": 178.24,
   "end": 179.48,
   "text": "אם יהיה לנו פרטים נוספים,"
  },
  {
   "start": 180.18,
   "end": 181.62,
   "text": "נשמח ליצור עמך קשר."
  },
  {
   "start": 183.46,
   "end": 186.16,
   "text": "משה חש שהכול מסתובב סביבו."
  },
  {
   "start": 187.66,
   "end": 188.84,
   "text": "בהבזק של שנייה,"
  },
  {
   "start": 189.46,
   "end": 190.62,
   "text": "עולמו חרב עליו."
  },
  {
   "start": 191.96,
   "end": 193.76,
   "text": "והוא נפל, מתעלף."
  },
  {
   "start": 196.56,
   "end": 196.9,
   "text": "מאז,"
  },
  {
   "start": 197.58,
   "end": 199.18,
   "text": "מאז אותו יאמר ונמהר,"
  },
  {
   "start": 200.02,
   "end": 202.12,
   "text": "נטש משה קינד את כל עסקיו,"
  },
  {
   "start": 202.86,
   "end": 205.26,
   "text": "והחל מחפש בכל מקום אפשרי"
  },
  {
   "start": 205.98,
   "end": 206.92,
   "text": "אחר הבן שלו,"
  },
  {
   "start": 207.66,
   "end": 208.44,
   "text": "בנו יחידו,"
  },
  {
   "start": 209.42,
   "end": 210.16,
   "text": "אבל ללא הועיל,"
  },
  {
   "start": 210.84,
   "end": 214.24,
   "text": "מרדכי נעלם כאילו בלעה אותו האדמה."
  },
  {
   "start": 218.31,
   "end": 219.75,
   "text": "כך עברו להם חמש שנים."
  },
  {
   "start": 220.79,
   "end": 221.49,
   "text": "בעיר קרקה"
  },
  {
   "start": 222.29,
   "end": 227.59,
   "text": "חוזר משה קינד לביתו בתום מסע נוסף של חיפושים עקרים."
  },
  {
   "start": 229.67,
   "end": 233.45,
   "text": "משה פנתה אליו אשתו בקול ניחר."
  },
  {
   "start": 234.35,
   "end": 235.61,
   "text": "הפעם אני עומדת על כך."
  },
  {
   "start": 236.53,
   "end": 239.13,
   "text": "הולכים לאוסטריה, אל המארשה,"
  },
  {
   "start": 239.71,
   "end": 241.31,
   "text": "אל הרב שבירך אותנו."
  },
  {
   "start": 242.41,
   "end": 245.15,
   "text": "עם השנים התרחקנו מיהדות,"
  },
  {
   "start": 246.17,
   "end": 248.29,
   "text": "התקררנו בעבודת השם,"
  },
  {
   "start": 249.39,
   "end": 252.25,
   "text": "שכחנו את כל הטובה שהשם יתברך עשה לנו,"
  },
  {
   "start": 253.05,
   "end": 253.73,
   "text": "ותראה,"
  },
  {
   "start": 254.49,
   "end": 255.65,
   "text": "תראה לאן הגענו."
  },
  {
   "start": 257.01,
   "end": 257.21,
   "text": "בוא,"
  },
  {
   "start": 257.87,
   "end": 258.87,
   "text": "בוא נלך אל הרב."
  },
  {
   "start": 259.73,
   "end": 261.99,
   "text": "כבר חמש שנים שאני מתחננת בפניך."
  },
  {
   "start": 262.83,
   "end": 264.17,
   "text": "בכל העולם היית,"
  },
  {
   "start": 264.93,
   "end": 266.45,
   "text": "רק באוסטריה לא."
  },
  {
   "start": 267.25,
   "end": 268.17,
   "text": "הפעם אני לא מוותרת,"
  },
  {
   "start": 269.51,
   "end": 270.75,
   "text": "הפעם אנחנו הולכים."
  },
  {
   "start": 272.98,
   "end": 275.44,
   "text": "משה קינד ישב מול רעייתו,"
  },
  {
   "start": 276.22,
   "end": 276.94,
   "text": "ולראשונה,"
  },
  {
   "start": 277.66,
   "end": 281.02,
   "text": "לראשונה מאז שנחטף ונעלה מרדכי הבן שלו,"
  },
  {
   "start": 281.8,
   "end": 284.54,
   "text": "הוא הרשה לעצמו לבכות."
  },
  {
   "start": 285.94,
   "end": 287.46,
   "text": "בכי של שברון לב,"
  },
  {
   "start": 288.56,
   "end": 290.12,
   "text": "בכי של חוסר אונים."
  },
  {
   "start": 291.66,
   "end": 294.86,
   "text": "הדרך לאוסטריה נפתחה"
  },
  {
   "start": 297.03,
   "end": 297.87,
   "text": "שבוע אחר כך."
  },
  {
   "start": 299.23,
   "end": 299.87,
   "text": "משה קינד"
  },
  {
   "start": 300.89,
   "end": 301.81,
   "text": "עומד מול הרב,"
  },
  {
   "start": 302.81,
   "end": 303.77,
   "text": "מול המערשה,"
  },
  {
   "start": 305.77,
   "end": 307.07,
   "text": "כשבעיניו דמעות"
  },
  {
   "start": 308.45,
   "end": 309.41,
   "text": "ובקול רועד"
  },
  {
   "start": 310.03,
   "end": 312.21,
   "text": "הוא מספר את כל הקורות אותו."
  },
  {
   "start": 313.61,
   "end": 315.77,
   "text": "הרב היה מהורהר במשך דקות ארוכות."
  },
  {
   "start": 316.93,
   "end": 319.83,
   "text": "משה כבר חשב שהרב אולי שכח מקיומו,"
  },
  {
   "start": 320.81,
   "end": 324.65,
   "text": "כשלפתע הרים המערשה את עיניו והביט בו במבט חודר,"
  },
  {
   "start": 326.39,
   "end": 326.71,
   "text": "מבט"
  },
  {
   "start": 327.37,
   "end": 328.97,
   "text": "שגרם למשה לחוש חרדה,"
  },
  {
   "start": 329.77,
   "end": 330.27,
   "text": "חרדה,"
  },
  {
   "start": 331.19,
   "end": 332.37,
   "text": "חרדת קודש."
  },
  {
   "start": 334.52,
   "end": 336.94,
   "text": "ואז אמרשה לקח פתק,"
  },
  {
   "start": 337.78,
   "end": 338.5,
   "text": "פתק קטן,"
  },
  {
   "start": 339.16,
   "end": 340.16,
   "text": "נייר קטן,"
  },
  {
   "start": 340.92,
   "end": 341.9,
   "text": "רשם בו משהו."
  },
  {
   "start": 343.0,
   "end": 343.5,
   "text": "אחר כך"
  },
  {
   "start": 344.06,
   "end": 347.34,
   "text": "הוא הדליג אפרור ושרף את הנייר."
  },
  {
   "start": 349.32,
   "end": 351.0,
   "text": "משנשרף הנייר כולו,"
  },
  {
   "start": 352.06,
   "end": 354.02,
   "text": "פנה אמרשה קצרות אל משה,"
  },
  {
   "start": 354.66,
   "end": 356.02,
   "text": "האבא המודאג, ואמר לו,"
  },
  {
   "start": 357.08,
   "end": 357.86,
   "text": "חזור הביתה,"
  },
  {
   "start": 358.72,
   "end": 360.58,
   "text": "הבן שלך בדרך."
  },
  {
   "start": 363.99,
   "end": 365.59,
   "text": "ביתו של משה אמה אנשים."
  },
  {
   "start": 366.57,
   "end": 368.01,
   "text": "כולם ממתינים דרוכים."
  },
  {
   "start": 369.07,
   "end": 371.11,
   "text": "המארש״ג אונדור אמר הוא בדרך."
  },
  {
   "start": 372.51,
   "end": 373.29,
   "text": "כולם מחכים."
  },
  {
   "start": 374.59,
   "end": 377.23,
   "text": "וההמתנה, ההמתנה הייתה ארוכה ומייגעת."
  },
  {
   "start": 378.17,
   "end": 380.21,
   "text": "עת עת החלו פורשים האנשים לבתיהם."
  },
  {
   "start": 381.03,
   "end": 382.95,
   "text": "מותירים את הזוג לבד."
  },
  {
   "start": 384.01,
   "end": 388.93,
   "text": "והייאוש החל מכרסם בלב ההורים היגעים שנותרו לבדם."
  },
  {
   "start": 391.25,
   "end": 392.97,
   "text": "עברו מספר שעות נוספות."
  },
  {
   "start": 394.25,
   "end": 394.61,
   "text": "ואז,"
  },
  {
   "start": 395.55,
   "end": 396.19,
   "text": "כשחשבו"
  },
  {
   "start": 397.01,
   "end": 398.21,
   "text": "שכבר אין סיכוי,"
  },
  {
   "start": 399.17,
   "end": 401.79,
   "text": "לפתע נשמעו דפיקות בדלת."
  },
  {
   "start": 402.77,
   "end": 404.51,
   "text": "לפתע נשמעו דפיקות בדלת."
  },
  {
   "start": 405.71,
   "end": 406.15,
   "text": "משה קינד"
  },
  {
   "start": 406.89,
   "end": 408.45,
   "text": "פסע בזהירות אל הדלת,"
  },
  {
   "start": 409.31,
   "end": 410.55,
   "text": "הושיט את ידו אל הידית,"
  },
  {
   "start": 411.53,
   "end": 411.79,
   "text": "לחץ,"
  },
  {
   "start": 412.73,
   "end": 414.13,
   "text": "פתח אותה לרווחה."
  },
  {
   "start": 415.43,
   "end": 416.07,
   "text": "מרדכי,"
  },
  {
   "start": 416.85,
   "end": 419.13,
   "text": "הבן שלהם, עמד בפתח,"
  },
  {
   "start": 420.05,
   "end": 420.99,
   "text": "בוגר יותר,"
  },
  {
   "start": 421.77,
   "end": 422.89,
   "text": "אבל אותו מרדכי,"
  },
  {
   "start": 424.01,
   "end": 426.13,
   "text": "ולפתע נשמע בכי,"
  },
  {
   "start": 427.21,
   "end": 428.15,
   "text": "בכי חנוק,"
  },
  {
   "start": 429.43,
   "end": 434.35,
   "text": "בכי של אמא שחיכתה לפן של הבנה היחידה,"
  },
  {
   "start": 434.99,
   "end": 436.57,
   "text": "פרץ לו לחלל האוויר."
  },
  {
   "start": 438.65,
   "end": 441.33,
   "text": "וההתרגשות והדמעות"
  },
  {
   "start": 442.25,
   "end": 443.61,
   "text": "חברו להם יחדיו,"
  },
  {
   "start": 444.69,
   "end": 447.29,
   "text": "מנגנות להם את ניגון הנשמה."
  },
  {
   "start": 449.88,
   "end": 450.5,
   "text": "יותר מאוחר"
  },
  {
   "start": 451.44,
   "end": 453.5,
   "text": "סיפר מרדכי מה קרה."
  },
  {
   "start": 454.16,
   "end": 456.56,
   "text": "הוא סיפר שהוא נחטף על ידי חבורת נוודים"
  },
  {
   "start": 457.44,
   "end": 458.78,
   "text": "שעברה לה באזור."
  },
  {
   "start": 460.28,
   "end": 463.6,
   "text": "איך במשך זמן רב הפעילו עליו לחצים להמיר את דתו,"
  },
  {
   "start": 464.52,
   "end": 465.6,
   "text": "ומשלא הצליחו,"
  },
  {
   "start": 466.34,
   "end": 467.76,
   "text": "הפכו אותו למשרת שלהם."
  },
  {
   "start": 469.08,
   "end": 470.36,
   "text": "ככה שנים חלפו להם,"
  },
  {
   "start": 471.0,
   "end": 473.9,
   "text": "הוא כבר איבד תקווה לחזור הביתה."
  },
  {
   "start": 475.18,
   "end": 475.66,
   "text": "אבל אז"
  },
  {
   "start": 477.58,
   "end": 479.18,
   "text": "הופיע לו בחלום,"
  },
  {
   "start": 480.12,
   "end": 481.2,
   "text": "רב יהודי,"
  },
  {
   "start": 482.08,
   "end": 483.02,
   "text": "הדור פנים,"
  },
  {
   "start": 484.04,
   "end": 488.44,
   "text": "שהורה לו לקום ולעזוב הכול ולחזור הביתה."
  },
  {
   "start": 489.76,
   "end": 493.54,
   "text": "ואני שמעתי את עצמי אומר אל הרב, אבל אני לא יודע את הדרך הביתה."
  },
  {
   "start": 494.96,
   "end": 495.88,
   "text": "והרב ענה לי,"
  },
  {
   "start": 496.66,
   "end": 497.74,
   "text": "מחר תצא לדרך,"
  },
  {
   "start": 498.82,
   "end": 499.88,
   "text": "ואני אהיה איתך."
  },
  {
   "start": 501.0,
   "end": 502.04,
   "text": "ואל תחשוש,"
  },
  {
   "start": 502.76,
   "end": 504.34,
   "text": "ברגע שתגיע לקצה הרחוב,"
  },
  {
   "start": 505.0,
   "end": 505.78,
   "text": "תביט אחורה,"
  },
  {
   "start": 506.26,
   "end": 507.0,
   "text": "אל הבית הזה,"
  },
  {
   "start": 507.78,
   "end": 510.24,
   "text": "של החבורה שהחזיקו אותך, שחטפו אותך,"
  },
  {
   "start": 511.0,
   "end": 511.82,
   "text": "ותראה מה יהיה."
  },
  {
   "start": 515.78,
   "end": 516.32,
   "text": "למחרת,"
  },
  {
   "start": 517.26,
   "end": 518.58,
   "text": "בלי שאיש יחוש בכך,"
  },
  {
   "start": 519.62,
   "end": 520.78,
   "text": "יצאתי מהבית."
  },
  {
   "start": 521.66,
   "end": 523.84,
   "text": "פסעתי במהירות עד צה הרחוב,"
  },
  {
   "start": 525.28,
   "end": 526.24,
   "text": "והסתכלתי אחורה."
  },
  {
   "start": 527.08,
   "end": 528.5,
   "text": "פחדתי אולי הם רודפים אחריי,"
  },
  {
   "start": 529.78,
   "end": 533.58,
   "text": "והנה לתדהמתי ראיתי לפתע"
  },
  {
   "start": 534.24,
   "end": 537.48,
   "text": "לשון של אש פורצת לה מתוך הבית"
  },
  {
   "start": 538.38,
   "end": 541.5,
   "text": "ופשוט שורפת ומכלה את הכל,"
  },
  {
   "start": 541.88,
   "end": 542.66,
   "text": "את הבית,"
  },
  {
   "start": 543.18,
   "end": 546.08,
   "text": "על יושביו ועל כל מה שיש בו."
  },
  {
   "start": 548.12,
   "end": 550.64,
   "text": "ללא שהיות פתחתי במנוסה,"
  },
  {
   "start": 551.42,
   "end": 552.16,
   "text": "כשכל הדרך"
  },
  {
   "start": 552.94,
   "end": 556.6,
   "text": "אני חש בעזרה משמיים,"
  },
  {
   "start": 557.34,
   "end": 559.08,
   "text": "אני חש כאילו הדרך ידועה לי,"
  },
  {
   "start": 559.64,
   "end": 561.06,
   "text": "כאילו אני מכיר את הדרך,"
  },
  {
   "start": 561.88,
   "end": 563.04,
   "text": "וככה אני רץ-רץ"
  },
  {
   "start": 563.96,
   "end": 566.58,
   "text": "עד שהגעתי ממש לכאן,"
  },
  {
   "start": 567.36,
   "end": 568.46,
   "text": "ממש ליד הדלת."
  },
  {
   "start": 571.01,
   "end": 571.93,
   "text": "ההורים המושערים"
  },
  {
   "start": 572.73,
   "end": 576.17,
   "text": "ביקשו מהבן שלהם, תאר לנו איך נראה"
  },
  {
   "start": 576.79,
   "end": 577.33,
   "text": "הרב"
  },
  {
   "start": 577.97,
   "end": 579.37,
   "text": "שהופיע לך בחלום."
  },
  {
   "start": 580.39,
   "end": 583.15,
   "text": "ומרדכי קינד, הבן שחזר הביתה,"
  },
  {
   "start": 583.75,
   "end": 584.65,
   "text": "תיאר במדויק"
  },
  {
   "start": 585.39,
   "end": 586.35,
   "text": "את טוהר פניו"
  },
  {
   "start": 587.31,
   "end": 588.81,
   "text": "של רבי שמואל אידליס,"
  },
  {
   "start": 589.91,
   "end": 590.95,
   "text": "המהרשע הקדוש."
  },
  {
   "start": 595.68,
   "end": 596.96,
   "text": "שנים רבות אחר כך"
  },
  {
   "start": 596.96,
   "end": 604.52,
   "text": "היה משה קינד חוזר ומספר לנכדים שלו את סיפורה של המשפחה שלהם."
  },
  {
   "start": 606.2,
   "end": 610.26,
   "text": "שממשפחה שקצת התקררה לה בעבודת השם,"
  },
  {
   "start": 611.6,
   "end": 615.24,
   "text": "הפכה למשפחה שכל-כולה תורה ויראת שמיים."
  },
  {
   "start": 616.16,
   "end": 620.42,
   "text": "משפחה שחשה על בשרה מהו כוח של תורה ויראת שמיים."
  },
  {
   "start": 621.58,
   "end": 625.4,
   "text": "משפחה שכל-כולה דבקות בה' יתברך."
  },
  {
   "start": 627.65,
   "end": 628.63,
   "text": "זהו כוח התורה,"
  },
  {
   "start": 629.39,
   "end": 630.47,
   "text": "כוח של דבקות,"
  },
  {
   "start": 631.51,
   "end": 632.15,
   "text": "בשם יתברך,"
  },
  {
   "start": 632.73,
   "end": 638.79,
   "text": "של המהרשע הקדוש שמותיר אחריו לנו דרך של דבקות,"
  },
  {
   "start": 639.43,
   "end": 640.39,
   "text": "דרך של תורה."
  },
  {
   "start": 641.73,
   "end": 643.25,
   "text": "כי אם המהרשע הצליח"
  },
  {
   "start": 644.03,
   "end": 645.23,
   "text": "להחזיר בן,"
  },
  {
   "start": 646.13,
   "end": 649.27,
   "text": "בן שחטפו אותו לפני שנים,"
  },
  {
   "start": 650.57,
   "end": 653.25,
   "text": "הוא בא ללמד את כולנו שכל אחד,"
  },
  {
   "start": 654.05,
   "end": 654.75,
   "text": "אתה, את,"
  },
  {
   "start": 655.47,
   "end": 656.35,
   "text": "כולנו יחד,"
  },
  {
   "start": 656.97,
   "end": 660.55,
   "text": "יכולים להחזיר בן לפחות אחד,"
  },
  {
   "start": 661.47,
   "end": 662.23,
   "text": "אותנו,"
  },
  {
   "start": 662.87,
   "end": 664.39,
   "text": "אותנו אל אבא שבשמיים,"
  },
  {
   "start": 665.11,
   "end": 667.29,
   "text": "אל אבא שמחכה לילדים שלו,"
  },
  {
   "start": 667.69,
   "end": 672.47,
   "text": "שאומר אני רוצה לקחת אתכם ולהרים אתכם מעל פני העולם,"
  },
  {
   "start": 673.07,
   "end": 675.95,
   "text": "כי אתם בשבילי הפנים החשובים,"
  },
  {
   "start": 676.69,
   "end": 678.05,
   "text": "רק תהיו קשורים אליי,"
  },
  {
   "start": 678.69,
   "end": 683.93,
   "text": "ואז תרגישו ותבינו מה קורה כשקשורים למעלה,"
  },
  {
   "start": 684.63,
   "end": 686.25,
   "text": "תראו שפשוט אי אפשר,"
  },
  {
   "start": 686.35,
   "end": 689.99,
   "text": "לפה למטה, רק עולים ומתעלים."
  }
 ]
}