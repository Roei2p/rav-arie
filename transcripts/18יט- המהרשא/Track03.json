{
 "disc": "18יט- המהרשא",
 "track": "Track03",
 "duration": 321.12,
 "segments": [
  {
   "start": 2.0,
   "end": 7.31,
   "text": "רבי יהודה הלוי היה יהודי מיוחד."
  },
  {
   "start": 8.09,
   "end": 10.11,
   "text": "הוא היה מצאצאי רבי יהודה החסיד."
  },
  {
   "start": 11.15,
   "end": 11.99,
   "text": "זה שנים רבות"
  },
  {
   "start": 12.63,
   "end": 17.71,
   "text": "שהוא ורעייתו מצפים שהשם יזכה אותם בילדים,"
  },
  {
   "start": 18.47,
   "end": 19.31,
   "text": "ועדיין הם לא זוכים."
  },
  {
   "start": 20.33,
   "end": 21.27,
   "text": "ורבי יהודה הלוי"
  },
  {
   "start": 21.91,
   "end": 23.47,
   "text": "הוא משמש מקור של שמחה,"
  },
  {
   "start": 25.47,
   "end": 27.95,
   "text": "מקור של אמונה שם בעיר קרקע."
  },
  {
   "start": 29.87,
   "end": 30.75,
   "text": "גיטל רעייתו,"
  },
  {
   "start": 31.15,
   "end": 33.79,
   "text": "אף היא כולה אומרת אמונה,"
  },
  {
   "start": 34.57,
   "end": 37.55,
   "text": "והנה מגיעה לה שנת שטו,"
  },
  {
   "start": 38.43,
   "end": 40.69,
   "text": "1555 למניינם."
  },
  {
   "start": 41.95,
   "end": 43.21,
   "text": "ובעלה ישועה"
  },
  {
   "start": 43.97,
   "end": 46.35,
   "text": "נולד להם בשעה טובה, בן."
  },
  {
   "start": 47.73,
   "end": 49.81,
   "text": "הם קראו לו שמואל אליעזר."
  },
  {
   "start": 51.89,
   "end": 53.85,
   "text": "הם ריפדו אותו בחום ואהבה,"
  },
  {
   "start": 54.65,
   "end": 55.13,
   "text": "והילד,"
  },
  {
   "start": 55.91,
   "end": 56.93,
   "text": "הוא לא נשאר חייו."
  },
  {
   "start": 57.69,
   "end": 58.69,
   "text": "היה בו רצון עז,"
  },
  {
   "start": 59.35,
   "end": 60.59,
   "text": "כיסופים אדירים,"
  },
  {
   "start": 61.05,
   "end": 62.45,
   "text": "להתחבר אל השם יתברך."
  },
  {
   "start": 63.91,
   "end": 66.33,
   "text": "ואם הדרך להתחבר אל השם יתברך"
  },
  {
   "start": 67.09,
   "end": 68.95,
   "text": "עוברת דרך התורה הקדושה,"
  },
  {
   "start": 69.97,
   "end": 71.29,
   "text": "אז בדרך הזו שמואל פוסע."
  },
  {
   "start": 72.99,
   "end": 73.25,
   "text": "בחוץ"
  },
  {
   "start": 73.93,
   "end": 74.55,
   "text": "קל יותר,"
  },
  {
   "start": 75.51,
   "end": 77.09,
   "text": "אבל בפנים, בתורה,"
  },
  {
   "start": 77.73,
   "end": 78.01,
   "text": "טוב יותר."
  },
  {
   "start": 79.11,
   "end": 80.27,
   "text": "להיות יהודי זה לא פשוט,"
  },
  {
   "start": 81.05,
   "end": 81.59,
   "text": "זה לא קל,"
  },
  {
   "start": 82.21,
   "end": 83.03,
   "text": "אבל זה כדאי."
  },
  {
   "start": 83.79,
   "end": 84.83,
   "text": "כך שמואל חשב"
  },
  {
   "start": 85.61,
   "end": 86.29,
   "text": "וכך שמואל גדל."
  },
  {
   "start": 87.89,
   "end": 88.51,
   "text": "יום אביבי,"
  },
  {
   "start": 89.19,
   "end": 89.65,
   "text": "שנת"
  },
  {
   "start": 91.05,
   "end": 91.53,
   "text": "ש״ל,"
  },
  {
   "start": 92.71,
   "end": 93.79,
   "text": "רגע הפרידה הגיעה,"
  },
  {
   "start": 95.29,
   "end": 96.41,
   "text": "רגע של שמחה,"
  },
  {
   "start": 97.45,
   "end": 100.87,
   "text": "בו הורים שולחים את בנם אהובם למקום של תורה,"
  },
  {
   "start": 101.79,
   "end": 102.93,
   "text": "עם צרור של בגדים,"
  },
  {
   "start": 103.85,
   "end": 104.59,
   "text": "מעט מזון,"
  },
  {
   "start": 105.49,
   "end": 105.99,
   "text": "אבל עם חבילה,"
  },
  {
   "start": 106.83,
   "end": 108.89,
   "text": "חבילה גדולה ועצומה של תפילות."
  },
  {
   "start": 109.73,
   "end": 111.79,
   "text": "כל אלו מלווים את הילד שמואל"
  },
  {
   "start": 112.47,
   "end": 114.11,
   "text": "בדרכו אל מעוזה של התורה,"
  },
  {
   "start": 114.85,
   "end": 115.85,
   "text": "שהייתה אז בעיר פוזנה."
  },
  {
   "start": 118.65,
   "end": 118.81,
   "text": "פוזנה,"
  },
  {
   "start": 119.91,
   "end": 120.69,
   "text": "עיר של תורה,"
  },
  {
   "start": 121.63,
   "end": 123.15,
   "text": "עיר שופעת תלמידי חכמים."
  },
  {
   "start": 124.53,
   "end": 126.21,
   "text": "שם שמואל אליעזר הצעיר,"
  },
  {
   "start": 126.87,
   "end": 128.77,
   "text": "בעזרת כוח ההתמדה העצום שלו,"
  },
  {
   "start": 129.57,
   "end": 130.81,
   "text": "הוא עולה מעלה-מעלה"
  },
  {
   "start": 131.37,
   "end": 132.43,
   "text": "במסילות התורה והיראה."
  },
  {
   "start": 135.74,
   "end": 137.16,
   "text": "אחת הדמויות המיוחדות"
  },
  {
   "start": 137.7,
   "end": 139.2,
   "text": "שעיטרה את העיר פוזנה"
  },
  {
   "start": 140.14,
   "end": 140.9,
   "text": "הייתה דמותה של עדל,"
  },
  {
   "start": 142.5,
   "end": 143.3,
   "text": "אלמנה עשירה,"
  },
  {
   "start": 144.2,
   "end": 145.2,
   "text": "שלמרות הכסף"
  },
  {
   "start": 145.9,
   "end": 146.94,
   "text": "היא רצתה דבר אחד,"
  },
  {
   "start": 148.02,
   "end": 148.32,
   "text": "תורה."
  },
  {
   "start": 149.18,
   "end": 150.18,
   "text": "היא רצתה קדושה,"
  },
  {
   "start": 150.88,
   "end": 151.58,
   "text": "והיא לא רק רצתה,"
  },
  {
   "start": 152.62,
   "end": 153.08,
   "text": "היא גם עשתה."
  },
  {
   "start": 154.16,
   "end": 156.48,
   "text": "גברת עדל השקיעה את מיטב כספה"
  },
  {
   "start": 157.12,
   "end": 158.12,
   "text": "בהחזקת תורה,"
  },
  {
   "start": 158.92,
   "end": 160.68,
   "text": "בגמילות חסד לנזקקים."
  },
  {
   "start": 161.72,
   "end": 162.38,
   "text": "וכשעדל,"
  },
  {
   "start": 163.12,
   "end": 164.34,
   "text": "שלה הייתה בת יחידה,"
  },
  {
   "start": 165.52,
   "end": 167.58,
   "text": "כשהגיע זמנה של אותה בת להקים בית,"
  },
  {
   "start": 168.42,
   "end": 172.64,
   "text": "היא חיפשה עבורה חתן שכל-כולו תורה."
  },
  {
   "start": 173.44,
   "end": 175.94,
   "text": "כך לא פלא שכל המבטים"
  },
  {
   "start": 176.78,
   "end": 178.02,
   "text": "נישאו אל עבר בחור אחד,"
  },
  {
   "start": 179.3,
   "end": 181.32,
   "text": "שבה זה לא מכבר לעיר פוזנא,"
  },
  {
   "start": 182.34,
   "end": 182.56,
   "text": "מקרקע,"
  },
  {
   "start": 183.52,
   "end": 184.44,
   "text": "מתמיד גדול,"
  },
  {
   "start": 185.14,
   "end": 186.64,
   "text": "אוהב השם מאין כמותו,"
  },
  {
   "start": 187.92,
   "end": 189.22,
   "text": "הבחור שמואל אליעזר."
  },
  {
   "start": 190.78,
   "end": 191.2,
   "text": "ואכן,"
  },
  {
   "start": 192.02,
   "end": 195.18,
   "text": "לא עברו הימים והם הקימו בית נפלא,"
  },
  {
   "start": 195.72,
   "end": 196.66,
   "text": "בית מלא אורה,"
  },
  {
   "start": 197.5,
   "end": 198.6,
   "text": "בית מלא תורה."
  },
  {
   "start": 199.86,
   "end": 200.06,
   "text": "שם,"
  },
  {
   "start": 201.24,
   "end": 202.26,
   "text": "שם נתגלה הסוד שלו."
  },
  {
   "start": 203.9,
   "end": 205.26,
   "text": "שמואל אליעזר היה נוהג"
  },
  {
   "start": 205.92,
   "end": 207.54,
   "text": "לגדל את שערות ראשו,"
  },
  {
   "start": 208.54,
   "end": 209.34,
   "text": "ואיש לא ידע מדוע."
  },
  {
   "start": 210.86,
   "end": 211.44,
   "text": "שם זה התגלה."
  },
  {
   "start": 213.06,
   "end": 216.96,
   "text": "שמואל אליעזר רצה להיות קשור כל הזמן אל השם יתברך."
  },
  {
   "start": 218.3,
   "end": 219.66,
   "text": "והוא ידע שהאמצעי לזה"
  },
  {
   "start": 220.98,
   "end": 221.46,
   "text": "זה תורה."
  },
  {
   "start": 222.66,
   "end": 223.56,
   "text": "אבל לימוד תורה,"
  },
  {
   "start": 224.68,
   "end": 225.54,
   "text": "לפחות בהתחלה,"
  },
  {
   "start": 226.7,
   "end": 228.44,
   "text": "מצריך יגיעה, מצריך מאמץ."
  },
  {
   "start": 230.46,
   "end": 231.24,
   "text": "לעתים אתה עייף,"
  },
  {
   "start": 232.6,
   "end": 233.34,
   "text": "לעתים אתה מנומנם."
  },
  {
   "start": 236.62,
   "end": 237.54,
   "text": "אבל שמואל אליעזר,"
  },
  {
   "start": 238.46,
   "end": 240.58,
   "text": "מאז ילדותו הוא מגדל את שערותיו,"
  },
  {
   "start": 241.52,
   "end": 243.0,
   "text": "כי כשהם היו ארוכות הים,"
  },
  {
   "start": 244.04,
   "end": 245.0,
   "text": "הוא החל לקושר אותם,"
  },
  {
   "start": 246.0,
   "end": 246.96,
   "text": "קושר אותם למעלה,"
  },
  {
   "start": 248.6,
   "end": 250.7,
   "text": "כך שאם ראשו יצנח"
  },
  {
   "start": 251.26,
   "end": 252.1,
   "text": "באמצע הלימוד,"
  },
  {
   "start": 252.96,
   "end": 253.7,
   "text": "מיד הוא יתעורר"
  },
  {
   "start": 254.52,
   "end": 255.8,
   "text": "וימשיך בעבודתו הקדושה."
  },
  {
   "start": 258.48,
   "end": 258.9,
   "text": "גאונות,"
  },
  {
   "start": 259.62,
   "end": 260.1,
   "text": "חוכמה,"
  },
  {
   "start": 260.78,
   "end": 262.24,
   "text": "זיכרון, כוח,"
  },
  {
   "start": 263.06,
   "end": 263.88,
   "text": "וכל אלו,"
  },
  {
   "start": 265.08,
   "end": 265.78,
   "text": "אלו מתנות משמיים."
  },
  {
   "start": 268.22,
   "end": 270.3,
   "text": "אבל רצון, יראת שמיים,"
  },
  {
   "start": 270.86,
   "end": 271.7,
   "text": "ושוב רצון,"
  },
  {
   "start": 272.48,
   "end": 273.16,
   "text": "זה תלוי בי,"
  },
  {
   "start": 273.84,
   "end": 274.34,
   "text": "כך הוא חשב,"
  },
  {
   "start": 275.28,
   "end": 275.82,
   "text": "כך הוא ידע."
  },
  {
   "start": 276.74,
   "end": 278.46,
   "text": "אבל לא מספיק לומר שאני רוצה,"
  },
  {
   "start": 278.88,
   "end": 279.52,
   "text": "צריך לעשות,"
  },
  {
   "start": 279.94,
   "end": 280.68,
   "text": "להשתדל,"
  },
  {
   "start": 281.0,
   "end": 281.58,
   "text": "להתאמץ,"
  },
  {
   "start": 281.98,
   "end": 282.72,
   "text": "להתמיד,"
  },
  {
   "start": 283.38,
   "end": 284.1,
   "text": "גם כשקשה."
  },
  {
   "start": 286.28,
   "end": 288.08,
   "text": "אבל שמואל אליעזר ידע דבר אחד,"
  },
  {
   "start": 289.02,
   "end": 291.94,
   "text": "יש הרבה כישרונים שמסתובבים להם ברחובות."
  },
  {
   "start": 293.32,
   "end": 295.8,
   "text": "אם יהודי רוצה לגדול כמו שצריך,"
  },
  {
   "start": 296.56,
   "end": 300.2,
   "text": "נדרש רצון אמיתי ומאמצים גדולים."
  },
  {
   "start": 301.1,
   "end": 301.7,
   "text": "ואז מגיע"
  },
  {
   "start": 302.38,
   "end": 303.0,
   "text": "מגיעה אותה,"
  },
  {
   "start": 303.7,
   "end": 304.72,
   "text": "אותה עזרה משמיים."
  },
  {
   "start": 306.1,
   "end": 307.42,
   "text": "הוא פשוט קשר את עצמו"
  },
  {
   "start": 308.4,
   "end": 309.06,
   "text": "אל התורה,"
  },
  {
   "start": 310.04,
   "end": 310.92,
   "text": "אל השם יתברך,"
  },
  {
   "start": 312.06,
   "end": 313.48,
   "text": "וכשקשורים למעלה,"
  },
  {
   "start": 314.22,
   "end": 315.02,
   "text": "לא נופלים למטה."
  }
 ]
}