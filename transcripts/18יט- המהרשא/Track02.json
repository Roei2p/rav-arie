{
 "disc": "18יט- המהרשא",
 "track": "Track02",
 "duration": 925.176,
 "segments": [
  {
   "start": 3.55,
   "end": 7.39,
   "text": "קיץ, שנת שין מאוזן, העיירה רע נסטוב,"
  },
  {
   "start": 8.31,
   "end": 14.75,
   "text": "לבשה חג, שדות התבואה המקיפים את העיירה הניבו יבול רב ומבורך."
  },
  {
   "start": 15.63,
   "end": 19.45,
   "text": "וזו הייתה סיבה של ממש לכל בני הקהילה היהודית"
  },
  {
   "start": 20.09,
   "end": 23.53,
   "text": "להודות לקדוש ברוך הוא, למלך מלכי המלכים,"
  },
  {
   "start": 24.23,
   "end": 27.79,
   "text": "שזיכה אותם לעוד שנה, עוד שנה של שפע,"
  },
  {
   "start": 28.69,
   "end": 30.73,
   "text": "עוד שנה של ברכה."
  },
  {
   "start": 33.57,
   "end": 38.73,
   "text": "ובכל השמחה והעמולה אולי איש לא היה שם לב לאותה דמות"
  },
  {
   "start": 39.29,
   "end": 41.37,
   "text": "שפסעה לה שם בקצה העיירה,"
  },
  {
   "start": 42.17,
   "end": 44.95,
   "text": "אלמלא ילד אחד מילדי העיירה,"
  },
  {
   "start": 45.59,
   "end": 50.29,
   "text": "שלרגע קט הביט המום בדמות המוזרה שהתקרבה אליו."
  },
  {
   "start": 51.53,
   "end": 52.59,
   "text": "השערות של האיש,"
  },
  {
   "start": 53.47,
   "end": 55.73,
   "text": "השערות של האיש היו הארוכות ביותר"
  },
  {
   "start": 56.37,
   "end": 57.45,
   "text": "שהוא ראה מימיו,"
  },
  {
   "start": 58.41,
   "end": 59.83,
   "text": "ודקות מספר אחר כך"
  },
  {
   "start": 60.41,
   "end": 61.61,
   "text": "כבר הקיפו את האיש,"
  },
  {
   "start": 62.39,
   "end": 63.33,
   "text": "כל ילדי העיירה,"
  },
  {
   "start": 63.99,
   "end": 66.19,
   "text": "כשהם מלווים אותו ברעמי צחוק,"
  },
  {
   "start": 66.61,
   "end": 69.17,
   "text": "מלווים בהשמעת קולות מלגלגים."
  },
  {
   "start": 70.31,
   "end": 71.49,
   "text": "הילדים של רנסטוב"
  },
  {
   "start": 72.17,
   "end": 74.39,
   "text": "לא היו רגילים למראות שכאלה."
  },
  {
   "start": 75.21,
   "end": 77.27,
   "text": "שבוע ימים התגורר הזר ברנסטוב."
  },
  {
   "start": 78.07,
   "end": 79.05,
   "text": "איש לא ידע מי הוא,"
  },
  {
   "start": 79.69,
   "end": 80.85,
   "text": "איש לא ידע מה הוא."
  },
  {
   "start": 81.43,
   "end": 82.71,
   "text": "במיוחד שהזר,"
  },
  {
   "start": 83.37,
   "end": 85.47,
   "text": "הזר המסתורי כמעט ולא דיבר."
  },
  {
   "start": 86.13,
   "end": 91.01,
   "text": "מרבית היום הוא הרבה להסתגר בחדר ששכר באכסניה של העיירה."
  },
  {
   "start": 91.61,
   "end": 97.67,
   "text": "היו כאלו שסיפרו שגם בלילה לא קווי האור בחדרו."
  },
  {
   "start": 99.49,
   "end": 103.21,
   "text": "התעלומה סביב היהודי הזר יכלה להימשך לעד,"
  },
  {
   "start": 104.33,
   "end": 108.11,
   "text": "אבל בשמיים כנראה חשבו אחרת."
  },
  {
   "start": 113.08,
   "end": 116.02,
   "text": "דוד נדל, דוד נדל היה הגבאי של רנסטוב."
  },
  {
   "start": 116.7,
   "end": 118.94,
   "text": "הכל חשו כי לשף על הברכה"
  },
  {
   "start": 119.52,
   "end": 122.14,
   "text": "להם זכו יש חלק גדול לר,"
  },
  {
   "start": 122.86,
   "end": 124.4,
   "text": "רבי דוד הגבאי הקדוש."
  },
  {
   "start": 125.36,
   "end": 125.86,
   "text": "כל לילה"
  },
  {
   "start": 126.52,
   "end": 129.38,
   "text": "אחרי שאחרון המתפללים היה עוזב,"
  },
  {
   "start": 130.22,
   "end": 133.74,
   "text": "רבי דוד היה סוגר את דלתות בית המדרש אחריו,"
  },
  {
   "start": 134.76,
   "end": 135.84,
   "text": "ואיש לא שם לב"
  },
  {
   "start": 136.94,
   "end": 140.96,
   "text": "שדוד בעצמו נשאר בבית המדרש,"
  },
  {
   "start": 141.98,
   "end": 142.56,
   "text": "לבד."
  },
  {
   "start": 143.68,
   "end": 147.66,
   "text": "בזמן שכל בני העיירה היו נמים את שנתם,"
  },
  {
   "start": 148.62,
   "end": 151.3,
   "text": "רבי דוד היה פותח את ספר התהילים שלו,"
  },
  {
   "start": 152.2,
   "end": 155.96,
   "text": "ובדמעות היה קורא את המזמורים."
  },
  {
   "start": 157.02,
   "end": 160.38,
   "text": "תוך שהוא מקיף את התיבה שם בבית הכנסת."
  },
  {
   "start": 161.52,
   "end": 162.06,
   "text": "כל לילה"
  },
  {
   "start": 162.64,
   "end": 163.78,
   "text": "שבע הקפות,"
  },
  {
   "start": 164.72,
   "end": 165.62,
   "text": "כשבכל הקפה"
  },
  {
   "start": 166.38,
   "end": 170.28,
   "text": "הוא היה זועק בתפילה אל הקדוש ברוך הוא,"
  },
  {
   "start": 170.84,
   "end": 172.56,
   "text": "אבא, אבא שבשמיים,"
  },
  {
   "start": 173.34,
   "end": 176.24,
   "text": "שמור נעלה על הקהילה היהודית"
  },
  {
   "start": 176.98,
   "end": 178.28,
   "text": "ברע נסטוב."
  },
  {
   "start": 179.32,
   "end": 179.96,
   "text": "איש לא ידע,"
  },
  {
   "start": 180.92,
   "end": 184.76,
   "text": "איש לא ידע, איש לא שם לב לרבי דוד,"
  },
  {
   "start": 185.54,
   "end": 186.3,
   "text": "עד אותו זמן,"
  },
  {
   "start": 187.18,
   "end": 191.28,
   "text": "עד אותו לילה בו רבי דוד נעל את דלתות בית המדרש,"
  },
  {
   "start": 192.24,
   "end": 193.0,
   "text": "כמו כל לילה,"
  },
  {
   "start": 193.74,
   "end": 198.12,
   "text": "והחל בהקפות עם ספר התהילים כהרגלו בקודש."
  },
  {
   "start": 199.9,
   "end": 200.22,
   "text": "ואז,"
  },
  {
   "start": 201.02,
   "end": 202.04,
   "text": "בהקפה הרביעית,"
  },
  {
   "start": 203.26,
   "end": 205.44,
   "text": "עייפות נוראה החלה אופפת אותו."
  },
  {
   "start": 206.58,
   "end": 207.32,
   "text": "הוא התיישב,"
  },
  {
   "start": 208.18,
   "end": 210.44,
   "text": "ומיד נעצמו עיניו,"
  },
  {
   "start": 211.52,
   "end": 212.36,
   "text": "והוא נרדם."
  },
  {
   "start": 213.74,
   "end": 214.04,
   "text": "לפתע,"
  },
  {
   "start": 214.8,
   "end": 215.84,
   "text": "לפתע עיניו נפקחו,"
  },
  {
   "start": 216.78,
   "end": 217.54,
   "text": "הוא הביט סביבו,"
  },
  {
   "start": 218.3,
   "end": 219.46,
   "text": "חש במשהו מוזר,"
  },
  {
   "start": 220.68,
   "end": 222.3,
   "text": "אז כפה גופו מפחד."
  },
  {
   "start": 223.8,
   "end": 224.1,
   "text": "שם,"
  },
  {
   "start": 225.24,
   "end": 226.7,
   "text": "שם על בימת בית הכנסת,"
  },
  {
   "start": 227.68,
   "end": 228.9,
   "text": "עמד לו אדם,"
  },
  {
   "start": 229.88,
   "end": 230.6,
   "text": "אדם גבוה,"
  },
  {
   "start": 231.58,
   "end": 232.56,
   "text": "אדם לא מוכר."
  },
  {
   "start": 234.26,
   "end": 235.4,
   "text": "הוא היה גבוה מאוד,"
  },
  {
   "start": 236.14,
   "end": 240.18,
   "text": "לבוש בגדים הדורים שמעולם הוא לא ראה כמותם."
  },
  {
   "start": 241.2,
   "end": 243.04,
   "text": "דוד חש בפחד וביראה,"
  },
  {
   "start": 244.6,
   "end": 245.58,
   "text": "ממלאים את גופו."
  },
  {
   "start": 246.94,
   "end": 249.0,
   "text": "והאדם פנה אליו."
  },
  {
   "start": 250.16,
   "end": 256.36,
   "text": "פנה אליו ושאל היכן מתגורר הרב שמואל בן רבי יהודה הלוי."
  },
  {
   "start": 257.62,
   "end": 260.02,
   "text": "ורבי דוד ענה בקול מפוחד,"
  },
  {
   "start": 260.62,
   "end": 262.24,
   "text": "אני לא מכיר יהודי בשם כזה."
  },
  {
   "start": 263.56,
   "end": 265.68,
   "text": "ואז הוא שאל שוב,"
  },
  {
   "start": 266.32,
   "end": 267.58,
   "text": "כאילו לא שמע."
  },
  {
   "start": 268.6,
   "end": 272.44,
   "text": "היכן מתגורר הרב שמואל בן רבי יהודה הלוי."
  },
  {
   "start": 272.44,
   "end": 281.82,
   "text": "הקול הסמכותי הזה הדהד בראשו של רבי דוד וגרם לו לאמץ את ראשו עד כאב בניסיון להיזכר במי מדובר,"
  },
  {
   "start": 282.5,
   "end": 282.88,
   "text": "מי זה?"
  },
  {
   "start": 284.22,
   "end": 284.62,
   "text": "ואז,"
  },
  {
   "start": 285.46,
   "end": 286.84,
   "text": "אז הבזיק במוחו דבר מה?"
  },
  {
   "start": 287.94,
   "end": 292.86,
   "text": "אולי, אולי כבודו מתכוון לזר שמתארח אצלנו בעיירה?"
  },
  {
   "start": 294.34,
   "end": 295.78,
   "text": "זה עם הסערות הארוכות,"
  },
  {
   "start": 297.34,
   "end": 299.96,
   "text": "אם אליו כוונת אדוני,"
  },
  {
   "start": 300.24,
   "end": 304.46,
   "text": "אז הוא מתאכסן באכסניה של חיים פרנק."
  },
  {
   "start": 306.24,
   "end": 311.8,
   "text": "הוא ראה הבעה של שביעות רצון מתפשטת לה על פני האדם שעמד על הבימה."
  },
  {
   "start": 313.34,
   "end": 314.1,
   "text": "והוא החל לנוע."
  },
  {
   "start": 314.92,
   "end": 317.62,
   "text": "רבי דוד רצה לקום, רצה לשאול,"
  },
  {
   "start": 317.94,
   "end": 319.88,
   "text": "רצה לדעת, רצה להבין."
  },
  {
   "start": 321.0,
   "end": 321.5,
   "text": "אבל אז,"
  },
  {
   "start": 322.68,
   "end": 323.18,
   "text": "שוב"
  },
  {
   "start": 324.64,
   "end": 326.02,
   "text": "מעטה של עייפות"
  },
  {
   "start": 327.34,
   "end": 328.06,
   "text": "אפף אותו,"
  },
  {
   "start": 328.06,
   "end": 330.3,
   "text": "והוא נרדם."
  },
  {
   "start": 331.78,
   "end": 332.46,
   "text": "כשהוא התעורר,"
  },
  {
   "start": 333.66,
   "end": 334.18,
   "text": "הוא היה לבד,"
  },
  {
   "start": 335.38,
   "end": 336.34,
   "text": "בבית המדרש."
  },
  {
   "start": 337.32,
   "end": 337.96,
   "text": "הוא רץ לבדוק,"
  },
  {
   "start": 338.58,
   "end": 339.34,
   "text": "לבדוק את הדלתות."
  },
  {
   "start": 340.38,
   "end": 341.1,
   "text": "הכל היה נעול."
  },
  {
   "start": 342.34,
   "end": 343.24,
   "text": "מאיפה הוא נכנס?"
  },
  {
   "start": 343.8,
   "end": 344.22,
   "text": "מי הוא?"
  },
  {
   "start": 344.92,
   "end": 345.66,
   "text": "מה קורה כאן?"
  },
  {
   "start": 347.12,
   "end": 350.4,
   "text": "שאלות רבות נקרו ממוחו של רבי דוד,"
  },
  {
   "start": 351.28,
   "end": 353.3,
   "text": "אבל לא היה מי שיענה על כך."
  },
  {
   "start": 356.0,
   "end": 357.22,
   "text": "למחרת בלילה,"
  },
  {
   "start": 358.1,
   "end": 359.6,
   "text": "רבי דוד כבר לא לקח סיכון."
  },
  {
   "start": 360.78,
   "end": 363.14,
   "text": "הוא פשוט בדק את כל הדלתות, את כל החלונות,"
  },
  {
   "start": 364.0,
   "end": 366.08,
   "text": "ונעל היטב היטב את בית המדרש."
  },
  {
   "start": 368.0,
   "end": 369.44,
   "text": "דקות מספר אחר חצות,"
  },
  {
   "start": 370.64,
   "end": 372.64,
   "text": "החל רבי דוד מקיף את הבמה."
  },
  {
   "start": 373.98,
   "end": 377.68,
   "text": "הוא הגיע אל ההקפה החמישית עם ספר התהילים שלו."
  },
  {
   "start": 379.34,
   "end": 381.94,
   "text": "שוב הוא חש בגלי העייפות שתוקפים אותו."
  },
  {
   "start": 382.38,
   "end": 385.0,
   "text": "הוא נלחם, נלחם בכל כוחו בעייפות,"
  },
  {
   "start": 385.4,
   "end": 387.88,
   "text": "בתשישות שהשתלטה לה על גופו."
  },
  {
   "start": 388.56,
   "end": 389.92,
   "text": "אבל הוא, הוא לא יכל להם."
  },
  {
   "start": 390.24,
   "end": 392.48,
   "text": "הוא פשוט נרדם."
  },
  {
   "start": 394.12,
   "end": 394.86,
   "text": "הוא פתח את עיניו,"
  },
  {
   "start": 395.94,
   "end": 396.76,
   "text": "מביט סביבותיו,"
  },
  {
   "start": 397.54,
   "end": 398.14,
   "text": "הכל נעול."
  },
  {
   "start": 398.88,
   "end": 400.08,
   "text": "הוא רצה להירגע, אבל,"
  },
  {
   "start": 400.62,
   "end": 403.72,
   "text": "אבל שוב הוא חש תחושה מוזרה,"
  },
  {
   "start": 404.48,
   "end": 405.88,
   "text": "תחושה שהוא לא לבד."
  },
  {
   "start": 407.14,
   "end": 407.68,
   "text": "הוא הסתובב,"
  },
  {
   "start": 408.46,
   "end": 409.58,
   "text": "ואז הוא קפץ אחורה,"
  },
  {
   "start": 410.24,
   "end": 411.52,
   "text": "קפץ אחורה בתדהמה."
  },
  {
   "start": 412.72,
   "end": 412.96,
   "text": "שם,"
  },
  {
   "start": 413.78,
   "end": 415.36,
   "text": "שם בקרבת היכל הקודש,"
  },
  {
   "start": 416.32,
   "end": 417.86,
   "text": "עמדה לה דמות,"
  },
  {
   "start": 418.66,
   "end": 419.4,
   "text": "דמות של אדם,"
  },
  {
   "start": 420.24,
   "end": 421.28,
   "text": "לא זו של אתמול,"
  },
  {
   "start": 421.96,
   "end": 422.64,
   "text": "מישהו אחר."
  },
  {
   "start": 424.36,
   "end": 427.74,
   "text": "היה זה האדם המיוחד ביותר שהוא ראה מימיו."
  },
  {
   "start": 428.72,
   "end": 430.34,
   "text": "היה בו הכל, קדושה,"
  },
  {
   "start": 431.06,
   "end": 434.04,
   "text": "נועם, תקיפות, סמכותיות,"
  },
  {
   "start": 435.62,
   "end": 437.84,
   "text": "ויותר מכל, העיניים שלו,"
  },
  {
   "start": 438.5,
   "end": 440.5,
   "text": "העיניים שלו שידרו עוצמה."
  },
  {
   "start": 440.84,
   "end": 445.82,
   "text": "היכן מתגורר הרב שמואל בן רבי יהודה הלוי."
  },
  {
   "start": 446.98,
   "end": 448.58,
   "text": "רבי דוד שמע את עצמו עונה,"
  },
  {
   "start": 449.7,
   "end": 451.52,
   "text": "אחר כך עוד הספיק לראות את הדמות"
  },
  {
   "start": 452.4,
   "end": 453.62,
   "text": "מתרחקת ממנו,"
  },
  {
   "start": 454.14,
   "end": 459.22,
   "text": "נעה לכיוון הדלתות הנעולות של בית המדרש והעלתה"
  },
  {
   "start": 460.22,
   "end": 461.06,
   "text": "עפפה אותו."
  },
  {
   "start": 462.2,
   "end": 462.78,
   "text": "הוא נרדם."
  },
  {
   "start": 464.22,
   "end": 467.86,
   "text": "כשהתעורר לא היה כבר איש בבית המדרש."
  },
  {
   "start": 468.76,
   "end": 469.46,
   "text": "הוא רץ אל הדלתות,"
  },
  {
   "start": 471.38,
   "end": 472.66,
   "text": "אבל הן היו נעולות."
  },
  {
   "start": 478.25,
   "end": 478.79,
   "text": "למחרת,"
  },
  {
   "start": 479.81,
   "end": 482.73,
   "text": "למחרת שם רבי דוד את פעמיו אל בית המדרש,"
  },
  {
   "start": 483.39,
   "end": 485.19,
   "text": "כשכל-כולו אומר נחישות."
  },
  {
   "start": 487.15,
   "end": 488.79,
   "text": "הוא המתין בציפייה דרוכה"
  },
  {
   "start": 489.45,
   "end": 490.35,
   "text": "לרדת הלילה."
  },
  {
   "start": 491.91,
   "end": 495.03,
   "text": "אחרון הלומדים עזב את בית המדרש."
  },
  {
   "start": 496.11,
   "end": 497.71,
   "text": "הדלתות היו נעולות,"
  },
  {
   "start": 498.83,
   "end": 500.33,
   "text": "ורבי דוד החל בהקפות"
  },
  {
   "start": 500.95,
   "end": 501.75,
   "text": "סביב התיבה."
  },
  {
   "start": 502.77,
   "end": 503.39,
   "text": "הקפה אחת,"
  },
  {
   "start": 504.65,
   "end": 505.15,
   "text": "שנייה,"
  },
  {
   "start": 506.39,
   "end": 506.85,
   "text": "שלישית,"
  },
  {
   "start": 508.29,
   "end": 509.01,
   "text": "רביעית."
  },
  {
   "start": 510.47,
   "end": 511.29,
   "text": "כלום לא קרה."
  },
  {
   "start": 512.13,
   "end": 512.79,
   "text": "חמישית,"
  },
  {
   "start": 514.25,
   "end": 514.99,
   "text": "שישית."
  },
  {
   "start": 516.51,
   "end": 518.51,
   "text": "והנה, הוא חש בעייפות,"
  },
  {
   "start": 519.29,
   "end": 521.01,
   "text": "היא שוב באה ומשתלטת עליו."
  },
  {
   "start": 522.37,
   "end": 523.51,
   "text": "הוא מנסה להילחם בה,"
  },
  {
   "start": 524.43,
   "end": 525.15,
   "text": "אף על ללא הצלחה."
  },
  {
   "start": 526.45,
   "end": 529.09,
   "text": "רבי דוד נרדם גם בפעם הזו,"
  },
  {
   "start": 533.43,
   "end": 535.19,
   "text": "הוא כבר ידע את ההרגשה הזאת."
  },
  {
   "start": 535.91,
   "end": 536.77,
   "text": "הוא הביט אל הבימה,"
  },
  {
   "start": 537.53,
   "end": 539.77,
   "text": "ואכן הייתה שם דמות,"
  },
  {
   "start": 540.91,
   "end": 541.83,
   "text": "דמות לא מוכרת,"
  },
  {
   "start": 542.75,
   "end": 544.97,
   "text": "שונה גם מאלו שהיו בלילות הקודמים."
  },
  {
   "start": 546.65,
   "end": 548.25,
   "text": "אבל הפעם רבי דוד לא שתק."
  },
  {
   "start": 549.53,
   "end": 552.41,
   "text": "מכבודו הוא זעק לעבר הבימה."
  },
  {
   "start": 558.53,
   "end": 559.75,
   "text": "אבל היהודי הישיש,"
  },
  {
   "start": 560.39,
   "end": 561.79,
   "text": "בעל סבר הפנים הטובות,"
  },
  {
   "start": 562.55,
   "end": 564.13,
   "text": "שהביט אליו מעל הבימה,"
  },
  {
   "start": 565.25,
   "end": 565.89,
   "text": "לא ענה,"
  },
  {
   "start": 566.79,
   "end": 568.17,
   "text": "אלא החזיר בשאלה."
  },
  {
   "start": 569.53,
   "end": 572.65,
   "text": "היכן מתגורר הרב שמואל בן רבי יהודה הלוי?"
  },
  {
   "start": 573.79,
   "end": 574.23,
   "text": "רבי דוד"
  },
  {
   "start": 575.51,
   "end": 576.41,
   "text": "הפעם לא התכוון לוותר."
  },
  {
   "start": 578.21,
   "end": 583.09,
   "text": "הוא שאל וחזר ושאל מה קורה כאן, מי אתה?"
  },
  {
   "start": 583.99,
   "end": 585.27,
   "text": "מי אלו שבאו לפניך?"
  },
  {
   "start": 586.03,
   "end": 587.43,
   "text": "מי זה הרב שמואל?"
  },
  {
   "start": 588.41,
   "end": 589.41,
   "text": "נסתררה תממה"
  },
  {
   "start": 590.25,
   "end": 591.47,
   "text": "ורבי דוד ניצל,"
  },
  {
   "start": 592.05,
   "end": 594.77,
   "text": "ניצל את זה למלמל תפילה חרישית לשם יתברך."
  },
  {
   "start": 596.55,
   "end": 601.85,
   "text": "היהודי הישיש הביט ברבי דוד בשתיקה ואז אמר"
  },
  {
   "start": 602.97,
   "end": 605.01,
   "text": "אתה רוצה לדעת מה קורה כאן?"
  },
  {
   "start": 606.01,
   "end": 611.09,
   "text": "תדע לך, כל לילה אתה מתפלל על בני העיירה שלך,"
  },
  {
   "start": 611.57,
   "end": 612.39,
   "text": "על עם ישראל."
  },
  {
   "start": 612.75,
   "end": 616.51,
   "text": "אכפת לך מהבנים של הקדוש ברוך הוא."
  },
  {
   "start": 617.59,
   "end": 618.61,
   "text": "זו זכות גדולה"
  },
  {
   "start": 619.33,
   "end": 621.31,
   "text": "שעמדה לך בלילות האחרונים."
  },
  {
   "start": 622.69,
   "end": 625.23,
   "text": "אתה יודע מי הופיע מולך בלילה הראשון?"
  },
  {
   "start": 625.69,
   "end": 630.17,
   "text": "מיהו אותו אדם גבע קומה משכמו ומעלה?"
  },
  {
   "start": 631.31,
   "end": 634.95,
   "text": "היה זה המלך הראשון של עם ישראל."
  },
  {
   "start": 635.85,
   "end": 655.39,
   "text": "שאול המלך בכבודו ובעצמו ורבי דוד החוויר כולו ובלילה השני אתה יודע מי הופיע מולך אדם אדם מופלא יחיד ומיוחד היה זה לא פחות ולא יותר דוד המלך"
  },
  {
   "start": 657.05,
   "end": 657.59,
   "text": "רבי דוד"
  },
  {
   "start": 658.47,
   "end": 661.29,
   "text": "הוא החל למלמל מה הם עושים כאן"
  },
  {
   "start": 662.21,
   "end": 668.07,
   "text": "אמר לו אותו אדם שהיה לו פחות ולא יותר מאשר אליהו הנביא."
  },
  {
   "start": 668.87,
   "end": 670.13,
   "text": "אמר לו אליהו הנביא,"
  },
  {
   "start": 670.71,
   "end": 672.47,
   "text": "תדע לך, רבי דוד נדל,"
  },
  {
   "start": 673.43,
   "end": 684.33,
   "text": "שמאז מותם של שאול ודוד מלכי ישראל דנו אותם בשמיים על המרדף של שאול אחרי דוד."
  },
  {
   "start": 685.41,
   "end": 688.83,
   "text": "הרי אין דבר נעלם מאת השם יתברך,"
  },
  {
   "start": 689.67,
   "end": 692.45,
   "text": "ועל כל דקה, על כל דקה במרדף הזה,"
  },
  {
   "start": 693.07,
   "end": 696.53,
   "text": "דנו אותם אם זה היה לשם שמיים או לא,"
  },
  {
   "start": 697.05,
   "end": 698.89,
   "text": "לפני שנים רבות הכל נסתיים."
  },
  {
   "start": 700.15,
   "end": 702.07,
   "text": "חוץ מפרט אחד שנותר,"
  },
  {
   "start": 703.11,
   "end": 704.35,
   "text": "כי הנה הדור הזה,"
  },
  {
   "start": 705.19,
   "end": 706.09,
   "text": "הדור הזה זכה,"
  },
  {
   "start": 706.81,
   "end": 712.93,
   "text": "נמצא אדם אחד שמתאים לשמש דיין בדין הזה."
  },
  {
   "start": 714.33,
   "end": 717.27,
   "text": "זהו רבי שמואל בן רבי יהודה הלוי,"
  },
  {
   "start": 718.13,
   "end": 718.77,
   "text": "שבדור הזה,"
  },
  {
   "start": 719.55,
   "end": 720.15,
   "text": "בגלות הזאת,"
  },
  {
   "start": 720.93,
   "end": 724.47,
   "text": "הוא מחובר וקשרו כל כך אל השם יתברך,"
  },
  {
   "start": 725.51,
   "end": 727.79,
   "text": "קשרו כל כך אל התורה הקדושה,"
  },
  {
   "start": 728.85,
   "end": 731.59,
   "text": "עד שזכה לדרגות גבוהות מאוד."
  },
  {
   "start": 733.11,
   "end": 736.83,
   "text": "זהו גאון הדור, המהרשע, שכל לילה"
  },
  {
   "start": 737.57,
   "end": 739.59,
   "text": "קושר את השערות שלו,"
  },
  {
   "start": 740.59,
   "end": 741.97,
   "text": "על מנת ששום דבר,"
  },
  {
   "start": 742.69,
   "end": 743.25,
   "text": "גם לא עייפות,"
  },
  {
   "start": 744.73,
   "end": 745.69,
   "text": "יפריעו לו,"
  },
  {
   "start": 746.45,
   "end": 750.17,
   "text": "ינתקו את הקשר הזה בין יהודי לאבא שבשמיים."
  },
  {
   "start": 751.89,
   "end": 757.77,
   "text": "אז בפעם הראשונה ירד שאול לטעון את טענותיו בפניו."
  },
  {
   "start": 759.31,
   "end": 763.65,
   "text": "למחרת בא דוד והשמיע אף הוא את דבריו,"
  },
  {
   "start": 764.87,
   "end": 770.69,
   "text": "ועתה אני נשלחתי להביא את פסק הדין אל בית דין של מעלה."
  },
  {
   "start": 771.89,
   "end": 773.99,
   "text": "ועכשיו אולי תאמר לי סוף סוף"
  },
  {
   "start": 774.57,
   "end": 776.35,
   "text": "היכן המהרשם מתגורר?"
  },
  {
   "start": 777.53,
   "end": 779.23,
   "text": "סיים אליהו הנביא את דבריו,"
  },
  {
   "start": 780.33,
   "end": 781.41,
   "text": "ורבי דוד נדל"
  },
  {
   "start": 782.57,
   "end": 785.39,
   "text": "לא נשאר אלא למלמל תשובה נרגשת,"
  },
  {
   "start": 786.03,
   "end": 787.91,
   "text": "מעולה בדמעות,"
  },
  {
   "start": 788.93,
   "end": 790.41,
   "text": "דמעות של שמחה,"
  },
  {
   "start": 791.03,
   "end": 792.87,
   "text": "דמעות של טוהר."
  },
  {
   "start": 802.25,
   "end": 807.21,
   "text": "למחרת כינס רבי דוד נדל את כל בני העיירה רנסטוב"
  },
  {
   "start": 807.75,
   "end": 808.61,
   "text": "אל בית המדרש."
  },
  {
   "start": 808.61,
   "end": 815.83,
   "text": "הוא עלה על הבימה והחל מספר אחת לאחת את כל הקורות אותו."
  },
  {
   "start": 817.29,
   "end": 821.57,
   "text": "התפרצויות של בכי והתרגשות ליוו את דבריו,"
  },
  {
   "start": 822.87,
   "end": 824.09,
   "text": "ושעה אחר כך"
  },
  {
   "start": 824.77,
   "end": 831.97,
   "text": "עשו כל בני העיירה את דרכם אל האכסניה לפגוש את המהרשה הקדוש."
  },
  {
   "start": 833.65,
   "end": 834.21,
   "text": "אבל שם,"
  },
  {
   "start": 835.17,
   "end": 840.71,
   "text": "שם כבר לא היה איש לבד מפתק קטן ובו תודה וברכה"
  },
  {
   "start": 841.51,
   "end": 842.31,
   "text": "לבני העיר,"
  },
  {
   "start": 843.67,
   "end": 844.43,
   "text": "כשלמטה,"
  },
  {
   "start": 845.23,
   "end": 846.21,
   "text": "בתחתית הפתק,"
  },
  {
   "start": 846.89,
   "end": 853.79,
   "text": "נכתב החותם באהבה שמואל אליעזר אידליס,"
  },
  {
   "start": 855.25,
   "end": 856.05,
   "text": "המהרשה."
  },
  {
   "start": 864.38,
   "end": 864.98,
   "text": "והיום,"
  },
  {
   "start": 866.04,
   "end": 869.84,
   "text": "היום אנו עוסקים ביהודי גדול שהסוד העיקרי שלו"
  },
  {
   "start": 870.68,
   "end": 874.52,
   "text": "היה הקשר אל השם יתברך, אל התורה הקדושה,"
  },
  {
   "start": 875.28,
   "end": 878.82,
   "text": "קשר חזק ואמיץ שהפך את כל חייו"
  },
  {
   "start": 879.78,
   "end": 881.14,
   "text": "לחיזוק אמיתי,"
  },
  {
   "start": 881.78,
   "end": 883.44,
   "text": "לדבקות בשם יתברך."
  },
  {
   "start": 884.6,
   "end": 884.84,
   "text": "וכך,"
  },
  {
   "start": 885.86,
   "end": 887.42,
   "text": "כשקשורים כל כך למעלה,"
  },
  {
   "start": 888.04,
   "end": 889.3,
   "text": "לא רק שלא נופלים למטה,"
  },
  {
   "start": 890.16,
   "end": 892.88,
   "text": "אלא גם מתעללים למעלה, למעלה."
  },
  {
   "start": 894.06,
   "end": 898.46,
   "text": "ואת זה כל אחד מאיתנו יכול, כל אחד מאיתנו צריך."
  },
  {
   "start": 899.46,
   "end": 905.54,
   "text": "היום נצא בעקבות אחד מגדולי המפרשים וענקי הרוח שקמו לעם ישראל."
  },
  {
   "start": 906.3,
   "end": 912.3,
   "text": "היום כולנו נפסק קדימה בעקבות המערשע רבי שמואל אידליס,"
  },
  {
   "start": 912.66,
   "end": 916.0,
   "text": "זכר צדיק וקדוש לברכה."
  }
 ]
}