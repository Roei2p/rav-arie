{
 "disc": "18יט- המהרשא",
 "track": "Track05",
 "duration": 292.176,
 "segments": [
  {
   "start": 6.87,
   "end": 8.63,
   "text": "שנת שפה."
  },
  {
   "start": 9.51,
   "end": 12.45,
   "text": "המהרשע עבר לעיר הגדולה, אוסטריה."
  },
  {
   "start": 13.49,
   "end": 16.35,
   "text": "מאות תלמידים חברו להם סביב הרב,"
  },
  {
   "start": 17.09,
   "end": 19.67,
   "text": "שקשר את עצמו אל הקדוש ברוך הוא ואל תורתו הקדושה."
  },
  {
   "start": 21.01,
   "end": 21.49,
   "text": "כל לילה"
  },
  {
   "start": 22.21,
   "end": 28.11,
   "text": "המהרשע רחון סביב ספריו הקדושים ולומד מתוכם באהבה וסיפוק."
  },
  {
   "start": 29.13,
   "end": 31.45,
   "text": "כל לילה, אפילו בפסח,"
  },
  {
   "start": 32.15,
   "end": 36.57,
   "text": "מיד אחרי עריכת הסדר הוא היה שוקע בעולמה של תורה."
  },
  {
   "start": 37.85,
   "end": 40.39,
   "text": "כל זה היה למעט לילה אחד,"
  },
  {
   "start": 41.53,
   "end": 41.99,
   "text": "הלילה,"
  },
  {
   "start": 42.61,
   "end": 43.73,
   "text": "הלילה של הגויים."
  },
  {
   "start": 44.57,
   "end": 50.23,
   "text": "בלילה הזה היה עוסק המהרשה בעיסוק שונה מכל לילה."
  },
  {
   "start": 50.83,
   "end": 56.65,
   "text": "הוא פשוט היה יושב וסופר ומחשב את כספי הצדקה"
  },
  {
   "start": 57.29,
   "end": 59.45,
   "text": "אותם יפריש לעניי העיר."
  },
  {
   "start": 60.43,
   "end": 61.17,
   "text": "איש לא ידע למה."
  },
  {
   "start": 62.27,
   "end": 64.41,
   "text": "אבל כך היה נוהג המהרשע הקדוש"
  },
  {
   "start": 65.15,
   "end": 67.07,
   "text": "כל שנה באותו לילה."
  },
  {
   "start": 75.36,
   "end": 75.96,
   "text": "לילה אחד,"
  },
  {
   "start": 77.04,
   "end": 78.76,
   "text": "בזמן שהמהרשע היה עוסק"
  },
  {
   "start": 79.84,
   "end": 81.58,
   "text": "בחישוב כספי הצדקה,"
  },
  {
   "start": 82.76,
   "end": 83.54,
   "text": "באותו זמן,"
  },
  {
   "start": 84.36,
   "end": 85.88,
   "text": "בחלק אחר של העיר אוסטריה"
  },
  {
   "start": 86.68,
   "end": 89.5,
   "text": "מתרקמת לה עלילה שפלה ונפשעת"
  },
  {
   "start": 90.34,
   "end": 91.56,
   "text": "כנגד רבה של אוסטריה."
  },
  {
   "start": 93.12,
   "end": 95.32,
   "text": "גוי אנטישמי בשם איוואן"
  },
  {
   "start": 95.32,
   "end": 100.62,
   "text": "מספר בלהט לחוקרי המשטרה על כך שהרב של אוסטריה,"
  },
  {
   "start": 101.32,
   "end": 106.66,
   "text": "זה שמפורסם כל כך בשקידתו העצומה בתורת ישראל,"
  },
  {
   "start": 107.34,
   "end": 109.08,
   "text": "בלילה הזה הוא לא לומד,"
  },
  {
   "start": 109.66,
   "end": 110.96,
   "text": "הוא מתעסק בכספים."
  },
  {
   "start": 111.92,
   "end": 112.42,
   "text": "ולמה?"
  },
  {
   "start": 113.8,
   "end": 115.2,
   "text": "הוא מחפש כספים"
  },
  {
   "start": 116.54,
   "end": 120.54,
   "text": "כדי שיהיה לו כסף לעשות את המהפכה היהודית כנגדנו הגויים,"
  },
  {
   "start": 121.26,
   "end": 122.3,
   "text": "כדי לפגוע בנו."
  },
  {
   "start": 123.6,
   "end": 124.52,
   "text": "כך סיפר איוון"
  },
  {
   "start": 125.78,
   "end": 133.6,
   "text": "לא פלא שחוקרי המשטרה הסכימו להתלוות להם אל איוון בשעת לילה מאוחרת"
  },
  {
   "start": 134.36,
   "end": 136.24,
   "text": "לכיוון ביתו של המהרשה."
  },
  {
   "start": 137.28,
   "end": 138.56,
   "text": "איוון כל כך שמח."
  },
  {
   "start": 139.18,
   "end": 141.08,
   "text": "הוא כבר ראה בעיני רוחו את הכסף"
  },
  {
   "start": 141.74,
   "end": 143.56,
   "text": "שהוא יקבל מהכומר תומאס"
  },
  {
   "start": 144.6,
   "end": 147.48,
   "text": "אחרי מאסרו של המהרשה."
  },
  {
   "start": 148.68,
   "end": 150.48,
   "text": "הכומר תומאס שהגיע לאוסטריה,"
  },
  {
   "start": 151.44,
   "end": 156.64,
   "text": "שהלהיב את כל השומעים שלו בהטפות שלו כנגד יהודים, כנגד עם ישראל."
  },
  {
   "start": 157.78,
   "end": 164.04,
   "text": "איוון חש כל כך גאווה גדולה כשהוא נבחר להיות השליח לפגוע ברב של אוסטריה."
  },
  {
   "start": 169.74,
   "end": 171.02,
   "text": "הם התקדמו להם בשקט,"
  },
  {
   "start": 172.24,
   "end": 173.32,
   "text": "בחסות החשיכה,"
  },
  {
   "start": 174.42,
   "end": 175.92,
   "text": "אל עבר חלונו המואר"
  },
  {
   "start": 177.26,
   "end": 178.72,
   "text": "של הרב של אוסטריה,"
  },
  {
   "start": 179.54,
   "end": 180.26,
   "text": "של המהרשה,"
  },
  {
   "start": 181.02,
   "end": 181.36,
   "text": "צעד"
  },
  {
   "start": 182.52,
   "end": 182.86,
   "text": "ועוד צעד."
  },
  {
   "start": 185.12,
   "end": 185.58,
   "text": "באותו רגע,"
  },
  {
   "start": 187.04,
   "end": 188.32,
   "text": "בחדרו של המהרשע"
  },
  {
   "start": 188.96,
   "end": 189.5,
   "text": "קורה משהו."
  },
  {
   "start": 190.68,
   "end": 196.6,
   "text": "לפתע נפל לו בקול רעש ספר מערמת הספרים שהייתה בשולחנו."
  },
  {
   "start": 197.5,
   "end": 198.3,
   "text": "המהרשע קם,"
  },
  {
   "start": 199.2,
   "end": 200.04,
   "text": "הרים את הספר,"
  },
  {
   "start": 200.7,
   "end": 202.52,
   "text": "כשהוא מלטף אותו באצבעותיו."
  },
  {
   "start": 203.66,
   "end": 206.54,
   "text": "הוא פתח את הספר ללמוד בו קצת,"
  },
  {
   "start": 207.16,
   "end": 209.34,
   "text": "הרי לא ייתכן שספר ייפול לרצפה"
  },
  {
   "start": 210.28,
   "end": 212.08,
   "text": "ואני לא אלמד בו לכבד אותו."
  },
  {
   "start": 212.86,
   "end": 215.7,
   "text": "אחר כך אני אחזור להמשיך לספור את כספי הצדקה,"
  },
  {
   "start": 216.3,
   "end": 217.52,
   "text": "כך חשב לו המהרשע,"
  },
  {
   "start": 218.72,
   "end": 220.06,
   "text": "וכך באמצע הלילה"
  },
  {
   "start": 220.82,
   "end": 223.06,
   "text": "המהרשע שוקע בלימוד קצר"
  },
  {
   "start": 224.08,
   "end": 225.24,
   "text": "בספר שנפל."
  },
  {
   "start": 227.46,
   "end": 228.72,
   "text": "שניות ספורות אחר כך,"
  },
  {
   "start": 229.8,
   "end": 230.74,
   "text": "מבעד לחלון,"
  },
  {
   "start": 231.52,
   "end": 232.9,
   "text": "מביטים חוקרי המשטרה,"
  },
  {
   "start": 233.84,
   "end": 234.4,
   "text": "ואיוון,"
  },
  {
   "start": 235.38,
   "end": 239.76,
   "text": "ברב הלומד בעיון נפלא ממש, כמדי לילה בלילה."
  },
  {
   "start": 241.04,
   "end": 241.88,
   "text": "השוטרים מביטים"
  },
  {
   "start": 242.54,
   "end": 248.28,
   "text": "אחר כך הם מביטים באיוון שניצב המום כולו, לא ייתכן הוא ממלמל."
  },
  {
   "start": 249.3,
   "end": 250.48,
   "text": "משהו מדהים קרה כאן."
  },
  {
   "start": 251.7,
   "end": 251.98,
   "text": "המבט,"
  },
  {
   "start": 252.86,
   "end": 254.84,
   "text": "המבט הקר בעיניים של השוטרים,"
  },
  {
   "start": 255.4,
   "end": 258.1,
   "text": "הבהיר לאיוון שהוא ישלם ביוקר."
  },
  {
   "start": 260.47,
   "end": 263.61,
   "text": "שבוע אחר כך נשפט ונאסר איוון"
  },
  {
   "start": 264.35,
   "end": 268.33,
   "text": "בעוון הטרדת עובדי ציבור והסתה."
  },
  {
   "start": 269.33,
   "end": 270.75,
   "text": "איוון לקח הכל בחשבון,"
  },
  {
   "start": 271.57,
   "end": 272.47,
   "text": "למעט דבר אחד."
  },
  {
   "start": 273.49,
   "end": 275.29,
   "text": "דבר אחד הוא לא לקח בחשבון,"
  },
  {
   "start": 276.01,
   "end": 277.77,
   "text": "את זה שהתורה הקדושה"
  },
  {
   "start": 278.43,
   "end": 284.69,
   "text": "תבוא ותעמוד כחומת מגן ותשמור על אהובה ואוהבה,"
  },
  {
   "start": 285.67,
   "end": 286.37,
   "text": "את זה איוון"
  },
  {
   "start": 287.19,
   "end": 288.61,
   "text": "לא יכל לקחת בחשבון."
  }
 ]
}