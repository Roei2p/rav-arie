{
 "disc": "18יט- המהרשא",
 "track": "Track01",
 "duration": 221.184,
 "segments": [
  {
   "start": 2.81,
   "end": 4.89,
   "text": "חלק משגרת החיים של פרימישלן"
  },
  {
   "start": 5.57,
   "end": 8.25,
   "text": "הייתה אותה דרך ארוכה אל המקווה."
  },
  {
   "start": 9.07,
   "end": 10.61,
   "text": "הייתה בעצם דרך קצרה יותר,"
  },
  {
   "start": 11.67,
   "end": 13.09,
   "text": "אבל המקווה היה ממוקם"
  },
  {
   "start": 13.77,
   "end": 15.27,
   "text": "באמצעו של הר תלול."
  },
  {
   "start": 16.17,
   "end": 20.03,
   "text": "ואם בזמן רגיל היה קשה מאוד לטפס על ההר,"
  },
  {
   "start": 20.51,
   "end": 21.81,
   "text": "הרי שבתקופת החורף"
  },
  {
   "start": 22.41,
   "end": 24.09,
   "text": "היה זה פשוט בלתי אפשרי."
  },
  {
   "start": 24.77,
   "end": 26.83,
   "text": "שכבת שלג כיסתה את ההר,"
  },
  {
   "start": 27.53,
   "end": 32.01,
   "text": "כך שמי שרק ניסה לטפס על ההר החליק מיד למטה."
  },
  {
   "start": 33.11,
   "end": 34.29,
   "text": "לכן בפרימישלן"
  },
  {
   "start": 35.05,
   "end": 40.29,
   "text": "כולם נהגו לעשות את כל הדרך העוקפת את ההר ולהגיע אל המקווה."
  },
  {
   "start": 42.05,
   "end": 44.75,
   "text": "אבל היה, היה פלא שם בפרימישלן."
  },
  {
   "start": 46.69,
   "end": 47.19,
   "text": "כל בוקר,"
  },
  {
   "start": 48.17,
   "end": 49.71,
   "text": "כמעין דבר שבשגרה,"
  },
  {
   "start": 50.39,
   "end": 52.15,
   "text": "עשתה את דרכה דמות מופלאה"
  },
  {
   "start": 52.85,
   "end": 54.07,
   "text": "בקלילות מדהימה אל המקווה."
  },
  {
   "start": 55.13,
   "end": 55.97,
   "text": "הייתה זו דמותו"
  },
  {
   "start": 56.61,
   "end": 58.63,
   "text": "של הרב הקדוש רבי מאיר מפרימישלן."
  },
  {
   "start": 60.43,
   "end": 61.03,
   "text": "בוקר אחד,"
  },
  {
   "start": 62.37,
   "end": 64.51,
   "text": "עקבו מספר זוגות עיניים חוקרות"
  },
  {
   "start": 65.51,
   "end": 67.31,
   "text": "אחר דמותו של רבי מאיר מפרימישלם."
  },
  {
   "start": 68.41,
   "end": 70.35,
   "text": "הייתה זו חבורה של בחורים צעירים."
  },
  {
   "start": 71.27,
   "end": 73.73,
   "text": "הם שמעו על הפלא ובאו לראות."
  },
  {
   "start": 75.51,
   "end": 75.87,
   "text": "והנה,"
  },
  {
   "start": 76.55,
   "end": 80.35,
   "text": "אחרי שראו בבוא עיניהם איך הרב מטפס בקלות על ההר,"
  },
  {
   "start": 81.31,
   "end": 82.21,
   "text": "אמרו לעצמם,"
  },
  {
   "start": 82.85,
   "end": 84.57,
   "text": "אם הרב יכול לעשות את זה,"
  },
  {
   "start": 85.29,
   "end": 85.95,
   "text": "בטח שגם אנחנו."
  },
  {
   "start": 87.47,
   "end": 91.39,
   "text": "ולמחרת בבוקר הם החלו מטפסים בצלע ההר."
  },
  {
   "start": 93.05,
   "end": 93.75,
   "text": "והטיפוס"
  },
  {
   "start": 94.85,
   "end": 95.95,
   "text": "לא ארך זמן רב."
  },
  {
   "start": 97.09,
   "end": 98.35,
   "text": "דקות מספר אחר כך"
  },
  {
   "start": 99.03,
   "end": 101.95,
   "text": "הם שכבו בתחתית ההר, נאנקים מכאבים"
  },
  {
   "start": 102.53,
   "end": 103.63,
   "text": "אחרי שהחליקו מטה."
  },
  {
   "start": 106.66,
   "end": 108.3,
   "text": "כשהכאבים כבר חלפו להם,"
  },
  {
   "start": 109.38,
   "end": 112.0,
   "text": "הופיעו אותם בחורים במעונו של הרב מפרי משלן."
  },
  {
   "start": 113.32,
   "end": 114.96,
   "text": "הם ביקשו לשאול שאלה אחת."
  },
  {
   "start": 116.24,
   "end": 119.56,
   "text": "על ההר הזה אי אפשר לטפס."
  },
  {
   "start": 120.16,
   "end": 120.34,
   "text": "הרב,"
  },
  {
   "start": 121.06,
   "end": 122.64,
   "text": "דבר אחד אנחנו מבקשים לדעת,"
  },
  {
   "start": 123.5,
   "end": 123.72,
   "text": "איך"
  },
  {
   "start": 124.24,
   "end": 126.04,
   "text": "הרב עושה את זה?"
  },
  {
   "start": 130.1,
   "end": 132.24,
   "text": "במעונו של הרב נסתערה דממה,"
  },
  {
   "start": 133.7,
   "end": 135.38,
   "text": "ואז הוא הרים את עיניו הטהורות"
  },
  {
   "start": 136.7,
   "end": 138.48,
   "text": "ואמר משפט אחד,"
  },
  {
   "start": 140.18,
   "end": 140.6,
   "text": "יהודי"
  },
  {
   "start": 141.52,
   "end": 142.48,
   "text": "צריך לדעת,"
  },
  {
   "start": 143.56,
   "end": 145.08,
   "text": "כשקשורים למעלה"
  },
  {
   "start": 146.04,
   "end": 147.62,
   "text": "לא נופלים למטה."
  },
  {
   "start": 149.44,
   "end": 151.1,
   "text": "כאשר יהודי קשור למעלה,"
  },
  {
   "start": 152.16,
   "end": 153.7,
   "text": "קשור לאביו שבשמיים,"
  },
  {
   "start": 154.7,
   "end": 156.8,
   "text": "מובטח לו שלא ייפול למטה."
  },
  {
   "start": 157.94,
   "end": 159.36,
   "text": "ולא רק במעלה ההר,"
  },
  {
   "start": 160.34,
   "end": 161.9,
   "text": "גם במקומות הקשים ביותר."
  },
  {
   "start": 162.98,
   "end": 164.76,
   "text": "גם שם, במעלה החיים,"
  },
  {
   "start": 165.88,
   "end": 167.16,
   "text": "כשקשורים למעלה"
  },
  {
   "start": 167.92,
   "end": 168.92,
   "text": "אל השם יתברך,"
  },
  {
   "start": 169.7,
   "end": 170.52,
   "text": "לא נופלים למטה."
  },
  {
   "start": 171.96,
   "end": 175.86,
   "text": "ואותה חבורת צעירים לא שכחו לעולם"
  },
  {
   "start": 176.78,
   "end": 179.6,
   "text": "את השיעור שם בפרי משלן."
  },
  {
   "start": 181.4,
   "end": 182.58,
   "text": "כשקשורים למעלה"
  },
  {
   "start": 183.42,
   "end": 184.32,
   "text": "לא נופלים למטה."
  },
  {
   "start": 185.7,
   "end": 186.56,
   "text": "היום נצטרף"
  },
  {
   "start": 187.4,
   "end": 188.4,
   "text": "ליהודי מיוחד,"
  },
  {
   "start": 189.48,
   "end": 190.8,
   "text": "יהודי שכל חייו"
  },
  {
   "start": 191.4,
   "end": 192.3,
   "text": "היה קשור למעלה."
  },
  {
   "start": 193.72,
   "end": 199.0,
   "text": "בואו נכיר מה עושה קשר נפלא בין יהודי לשם יתברך,"
  },
  {
   "start": 200.24,
   "end": 201.86,
   "text": "בין יהודי לתורה הקדושה,"
  },
  {
   "start": 203.02,
   "end": 205.38,
   "text": "וקשר כזה כל אחד יכול לבנות,"
  },
  {
   "start": 206.36,
   "end": 206.56,
   "text": "אתה,"
  },
  {
   "start": 207.36,
   "end": 207.5,
   "text": "את,"
  },
  {
   "start": 208.38,
   "end": 209.02,
   "text": "כולנו יחד."
  }
 ]
}