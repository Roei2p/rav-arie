{
 "disc": "18יט- המהרשא",
 "track": "Track04",
 "duration": 343.152,
 "segments": [
  {
   "start": 3.33,
   "end": 4.23,
   "text": "במגילת יוחסין"
  },
  {
   "start": 4.93,
   "end": 6.93,
   "text": "של הרב יוסף לוינשטיין, זצ״ל,"
  },
  {
   "start": 7.91,
   "end": 9.23,
   "text": "אב בדין של העיר סרוצק,"
  },
  {
   "start": 10.21,
   "end": 10.75,
   "text": "נכתב"
  },
  {
   "start": 11.65,
   "end": 12.79,
   "text": "ויהי לה לבן."
  },
  {
   "start": 13.71,
   "end": 15.03,
   "text": "למרת עדל האלמנה,"
  },
  {
   "start": 15.91,
   "end": 16.49,
   "text": "מפוזנא"
  },
  {
   "start": 17.21,
   "end": 18.19,
   "text": "היה בן מיוחד."
  },
  {
   "start": 19.49,
   "end": 20.79,
   "text": "זה לא היה ממש הבן שלה,"
  },
  {
   "start": 21.81,
   "end": 22.77,
   "text": "זה היה החתן שלה,"
  },
  {
   "start": 24.05,
   "end": 24.89,
   "text": "שמואל אליעזר."
  },
  {
   "start": 25.99,
   "end": 28.65,
   "text": "אבל עבורה הוא היה כמו בן ממש."
  },
  {
   "start": 29.63,
   "end": 32.59,
   "text": "עוד כשהיה צעיר לימים, היא השקיעה בו הכל."
  },
  {
   "start": 33.53,
   "end": 34.33,
   "text": "כי מרת עדל"
  },
  {
   "start": 35.31,
   "end": 36.15,
   "text": "אהבה תורה,"
  },
  {
   "start": 37.07,
   "end": 41.51,
   "text": "ומצידו חש הכרת הטוב גדולה לחותנת הצדקת שלו."
  },
  {
   "start": 42.61,
   "end": 42.85,
   "text": "וכך,"
  },
  {
   "start": 43.85,
   "end": 44.67,
   "text": "כשעברו ימים,"
  },
  {
   "start": 45.41,
   "end": 47.35,
   "text": "והוא התפרסם בכל קהילות ישראל,"
  },
  {
   "start": 48.29,
   "end": 50.91,
   "text": "היו באים לקבל, לקבל ממנו המלצות."
  },
  {
   "start": 51.87,
   "end": 52.43,
   "text": "הוא היה חותם,"
  },
  {
   "start": 53.53,
   "end": 55.63,
   "text": "שמואל אידליס,"
  },
  {
   "start": 56.63,
   "end": 57.29,
   "text": "שמואל"
  },
  {
   "start": 58.19,
   "end": 59.01,
   "text": "של עדל."
  },
  {
   "start": 60.09,
   "end": 61.15,
   "text": "להזכיר לעצמו ולכולם,"
  },
  {
   "start": 63.67,
   "end": 65.61,
   "text": "שזה הרבה בזכותה."
  },
  {
   "start": 66.85,
   "end": 68.47,
   "text": "וכך זוכה אותה עדל"
  },
  {
   "start": 69.19,
   "end": 76.61,
   "text": "להיכלל בשמו של אחד מענקי המפרשים שקמו לעם היהודי,"
  },
  {
   "start": 77.97,
   "end": 80.21,
   "text": "ממורנו הרב שמואל אליעזר אידליס,"
  },
  {
   "start": 82.77,
   "end": 84.21,
   "text": "הלו הוא המהרשה."
  },
  {
   "start": 86.33,
   "end": 86.55,
   "text": "יום אחד,"
  },
  {
   "start": 87.55,
   "end": 89.89,
   "text": "יום אחד שבשולחן שלפני המהרשה"
  },
  {
   "start": 90.77,
   "end": 92.27,
   "text": "הונח מגש עם אוכל חם,"
  },
  {
   "start": 93.73,
   "end": 96.01,
   "text": "הרים אמר שעה את ראשו מאימא ספר ואמר,"
  },
  {
   "start": 98.39,
   "end": 99.01,
   "text": "יהי רצון,"
  },
  {
   "start": 99.87,
   "end": 100.37,
   "text": "וכמו,"
  },
  {
   "start": 100.97,
   "end": 102.67,
   "text": "כמו שאת דואגת לאחיות אותי,"
  },
  {
   "start": 103.81,
   "end": 104.81,
   "text": "השם יחיה אותך,"
  },
  {
   "start": 105.69,
   "end": 108.37,
   "text": "ויוסיף לך שנות חיים לפחות"
  },
  {
   "start": 109.25,
   "end": 110.19,
   "text": "עד מאה שנה."
  },
  {
   "start": 111.71,
   "end": 113.41,
   "text": "דקות מספר אחר כך,"
  },
  {
   "start": 114.05,
   "end": 116.05,
   "text": "מעזרה יצאה לדמות נרגשת כולה."
  },
  {
   "start": 117.31,
   "end": 118.27,
   "text": "הייתה זו מרת עדל."
  },
  {
   "start": 119.25,
   "end": 121.39,
   "text": "כל יום היא הייתה עוזבת את כל העסקים שלה,"
  },
  {
   "start": 122.23,
   "end": 126.69,
   "text": "והייתה טורחת במו ידיה להכין לחתנה הגדול מטעמים,"
  },
  {
   "start": 127.67,
   "end": 129.71,
   "text": "אוכל, כדי שיהיה לו כוח ללמוד תורה."
  },
  {
   "start": 131.07,
   "end": 131.47,
   "text": "כל הכסף,"
  },
  {
   "start": 132.17,
   "end": 135.59,
   "text": "כל הרכוש, לא שווה רגע אחד של תורה, כך היא אמרה,"
  },
  {
   "start": 136.11,
   "end": 137.37,
   "text": "רגע של עסק התורה,"
  },
  {
   "start": 138.05,
   "end": 139.65,
   "text": "ואני זוכה ליטול בכך חלק,"
  },
  {
   "start": 140.27,
   "end": 141.33,
   "text": "זה יותר מהכל."
  },
  {
   "start": 142.15,
   "end": 142.55,
   "text": "ועתה,"
  },
  {
   "start": 143.41,
   "end": 144.61,
   "text": "כשיצאה מן העזרה,"
  },
  {
   "start": 145.57,
   "end": 146.93,
   "text": "אחרי ששמעה את הברכה"
  },
  {
   "start": 147.69,
   "end": 148.65,
   "text": "של המהרשה,"
  },
  {
   "start": 149.35,
   "end": 150.83,
   "text": "היא התקשתה להסתיר את דמעותיה."
  },
  {
   "start": 151.87,
   "end": 153.41,
   "text": "דמעות חמות של התרגשות,"
  },
  {
   "start": 154.09,
   "end": 154.91,
   "text": "של שמחה,"
  },
  {
   "start": 155.77,
   "end": 157.31,
   "text": "שבכל העולם כולו"
  },
  {
   "start": 158.17,
   "end": 161.91,
   "text": "אי אפשר למצוא זעקות וטהורות כאלו."
  },
  {
   "start": 170.97,
   "end": 172.07,
   "text": "שנה וחצי אחר כך,"
  },
  {
   "start": 173.45,
   "end": 174.27,
   "text": "מרת עדל"
  },
  {
   "start": 175.19,
   "end": 176.93,
   "text": "שוכבת לה במיטתה חולה,"
  },
  {
   "start": 177.69,
   "end": 180.37,
   "text": "ומיום ליום מצבה הולך ומחמיר,"
  },
  {
   "start": 181.39,
   "end": 183.63,
   "text": "עד שהגיע אותו יום מר,"
  },
  {
   "start": 184.95,
   "end": 185.59,
   "text": "ולרופאים,"
  },
  {
   "start": 186.75,
   "end": 187.67,
   "text": "לרופאים לא נשאר,"
  },
  {
   "start": 188.51,
   "end": 189.71,
   "text": "אלא לקבוע את מותה."
  },
  {
   "start": 191.49,
   "end": 193.79,
   "text": "מסביב כולם בכו."
  },
  {
   "start": 194.95,
   "end": 196.53,
   "text": "אי אפשר היה לעצור את הכאב."
  },
  {
   "start": 200.22,
   "end": 200.56,
   "text": "אבל אז,"
  },
  {
   "start": 201.58,
   "end": 202.58,
   "text": "אז הראה דבר מדהים."
  },
  {
   "start": 203.66,
   "end": 205.06,
   "text": "לנגד עיני הסובבים"
  },
  {
   "start": 205.86,
   "end": 208.56,
   "text": "החלה מרת עדל לנוע."
  },
  {
   "start": 209.94,
   "end": 212.7,
   "text": "לא להאמין, דקות מספר אחר כך"
  },
  {
   "start": 213.68,
   "end": 215.64,
   "text": "נפקחו עיניה של מרת עדל"
  },
  {
   "start": 216.68,
   "end": 217.94,
   "text": "והיא חזרה לחיים,"
  },
  {
   "start": 218.92,
   "end": 219.8,
   "text": "פלאי פלאים."
  },
  {
   "start": 221.2,
   "end": 222.08,
   "text": "הרופאים העמומים,"
  },
  {
   "start": 223.08,
   "end": 225.08,
   "text": "הם לא ידעו את נפשם מרוב תדהמה."
  },
  {
   "start": 226.34,
   "end": 227.66,
   "text": "ימים מספר אחר כך"
  },
  {
   "start": 228.22,
   "end": 231.08,
   "text": "היא כבר התאוששה וקמה על רגליה כבתחילה."
  },
  {
   "start": 232.96,
   "end": 233.56,
   "text": "אבל באוויר,"
  },
  {
   "start": 234.54,
   "end": 235.92,
   "text": "באוויר נותרה החידה,"
  },
  {
   "start": 236.64,
   "end": 237.96,
   "text": "נותרה השאלה הגדולה,"
  },
  {
   "start": 238.58,
   "end": 239.06,
   "text": "מה קרה?"
  },
  {
   "start": 240.1,
   "end": 241.36,
   "text": "הרי את לא היית בין החיים."
  },
  {
   "start": 242.6,
   "end": 243.26,
   "text": "איך עזרת?"
  },
  {
   "start": 244.52,
   "end": 245.7,
   "text": "כולם רצו לדעת,"
  },
  {
   "start": 246.76,
   "end": 247.54,
   "text": "ולבסוף"
  },
  {
   "start": 248.66,
   "end": 249.1,
   "text": "היא גם סיפרה."
  },
  {
   "start": 251.12,
   "end": 251.8,
   "text": "וכך היא סיפרה,"
  },
  {
   "start": 252.78,
   "end": 253.56,
   "text": "מה שקרה זה"
  },
  {
   "start": 254.48,
   "end": 255.5,
   "text": "שנשמתי אכן,"
  },
  {
   "start": 256.24,
   "end": 257.04,
   "text": "אכן עלתה לה,"
  },
  {
   "start": 257.7,
   "end": 259.64,
   "text": "עלתה לה אל גנזי מרומים."
  },
  {
   "start": 260.76,
   "end": 263.32,
   "text": "כבר היה ברור שאיני בין החיים."
  },
  {
   "start": 265.02,
   "end": 265.36,
   "text": "אבל אז,"
  },
  {
   "start": 266.4,
   "end": 268.32,
   "text": "שם בפתח של שערי השמיים,"
  },
  {
   "start": 269.28,
   "end": 272.12,
   "text": "לפתע נשמע קול, קול אדיר שאמר,"
  },
  {
   "start": 272.86,
   "end": 274.26,
   "text": "אי אפשר לקבל אותה כאן."
  },
  {
   "start": 274.96,
   "end": 276.06,
   "text": "הרי המהרשע,"
  },
  {
   "start": 276.62,
   "end": 278.68,
   "text": "הרי המהרשע בכבודו ובעצמו,"
  },
  {
   "start": 279.5,
   "end": 281.7,
   "text": "אמר שתחיה עד גיל מאה השנים,"
  },
  {
   "start": 282.74,
   "end": 284.9,
   "text": "אז אין רשות לדון אותה."
  },
  {
   "start": 285.52,
   "end": 290.34,
   "text": "צריך להחזיר אותה לעולם לחיות עד גיל מאה השנה."
  },
  {
   "start": 291.3,
   "end": 292.34,
   "text": "אמר שע בירך אותה,"
  },
  {
   "start": 293.5,
   "end": 294.62,
   "text": "אז אין לנו מה לעשות,"
  },
  {
   "start": 295.48,
   "end": 296.48,
   "text": "היא צריכה לחזור."
  },
  {
   "start": 297.62,
   "end": 299.36,
   "text": "כך אמר הקול ונשתתק."
  },
  {
   "start": 301.04,
   "end": 303.62,
   "text": "ומיד אחר כך חשתי איך הנשמה שלי"
  },
  {
   "start": 304.24,
   "end": 305.36,
   "text": "שבה במהירות אל הגוף."
  },
  {
   "start": 306.78,
   "end": 308.2,
   "text": "מרת אדלסיימה את סיפורה,"
  },
  {
   "start": 309.24,
   "end": 310.5,
   "text": "וכל הנוכחים נרעדו."
  },
  {
   "start": 311.42,
   "end": 312.5,
   "text": "הם הביטו בה הערצה,"
  },
  {
   "start": 313.54,
   "end": 314.34,
   "text": "במרת עדל,"
  },
  {
   "start": 315.38,
   "end": 318.7,
   "text": "זו ששנים כנגד כל השיקולים העסקיים,"
  },
  {
   "start": 319.34,
   "end": 320.68,
   "text": "כנגד כל העולם הזה,"
  },
  {
   "start": 321.32,
   "end": 321.94,
   "text": "היא בחרה לה"
  },
  {
   "start": 322.66,
   "end": 323.82,
   "text": "בתורה הקדושה ובלומדיה."
  },
  {
   "start": 326.04,
   "end": 329.86,
   "text": "והנה אחר שנים היא זוכה לחתן כל כך גדול,"
  },
  {
   "start": 330.4,
   "end": 333.08,
   "text": "עד שבעולמות של מעלה"
  },
  {
   "start": 333.72,
   "end": 334.9,
   "text": "דבריו נשמעים."
  },
  {
   "start": 335.9,
   "end": 337.88,
   "text": "ועוצמה כל כך אדירה"
  },
  {
   "start": 338.62,
   "end": 339.7,
   "text": "אי אפשר לקנות"
  },
  {
   "start": 340.38,
   "end": 341.9,
   "text": "בעד שום הון שבעולם."
  }
 ]
}