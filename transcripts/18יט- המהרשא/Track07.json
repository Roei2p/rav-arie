{
 "disc": "18יט- המהרשא",
 "track": "Track07",
 "duration": 898.2,
 "segments": [
  {
   "start": 7.1,
   "end": 8.32,
   "text": "ענן שחור וקודר,"
  },
  {
   "start": 9.3,
   "end": 9.76,
   "text": "מעיב"
  },
  {
   "start": 10.58,
   "end": 11.18,
   "text": "על שמי אוסטריה."
  },
  {
   "start": 13.5,
   "end": 16.76,
   "text": "שנים רבות התקיימו הלוויות בשקט ושלווה,"
  },
  {
   "start": 17.78,
   "end": 19.1,
   "text": "עד שיום אחד הוא הופיע."
  },
  {
   "start": 20.28,
   "end": 22.8,
   "text": "כולם קראו לו הכומר תומאס."
  },
  {
   "start": 23.34,
   "end": 25.24,
   "text": "ידעו שהוא בשליחות מן הוותיקן הנוצרי,"
  },
  {
   "start": 26.04,
   "end": 27.6,
   "text": "אבל איש לא ידע עליו מאומה."
  },
  {
   "start": 28.38,
   "end": 29.58,
   "text": "הוא היה אפוף מסתורין,"
  },
  {
   "start": 30.52,
   "end": 32.04,
   "text": "ועד מהרה הכומר תומאס"
  },
  {
   "start": 32.76,
   "end": 36.12,
   "text": "החל מפלס לו דרך אל ראשות הכנסייה של אוסטריה."
  },
  {
   "start": 36.62,
   "end": 37.78,
   "text": "איש לא עמד בדרכו."
  },
  {
   "start": 38.64,
   "end": 39.62,
   "text": "כולם פחדו ממנו."
  },
  {
   "start": 40.66,
   "end": 42.72,
   "text": "הם חשו את האווירה המאיימת שסביבו,"
  },
  {
   "start": 43.56,
   "end": 45.18,
   "text": "ועד מהרה גם נוכחו כולם"
  },
  {
   "start": 45.78,
   "end": 48.78,
   "text": "שלכומר תומאס יש כוחות של טומאה,"
  },
  {
   "start": 49.38,
   "end": 52.58,
   "text": "שבאמצעותם הוא יכול לפגוע בכל מי שעומד מולו."
  },
  {
   "start": 53.7,
   "end": 54.64,
   "text": "והכומר תומאס?"
  },
  {
   "start": 55.34,
   "end": 56.5,
   "text": "הוא לא ישב בחיבוק ידיים."
  },
  {
   "start": 57.94,
   "end": 62.2,
   "text": "בחדרו הפרטי הוא השלים בניית פעמוני כנסייה חדשים."
  },
  {
   "start": 62.2,
   "end": 67.42,
   "text": "הוא החליף את הפעמונים הקיימים בפעמונים חדשים,"
  },
  {
   "start": 67.88,
   "end": 68.52,
   "text": "מיוחדים,"
  },
  {
   "start": 69.34,
   "end": 70.12,
   "text": "שהביא עימו."
  },
  {
   "start": 71.36,
   "end": 73.58,
   "text": "וכך ישב לו הכומר תומאס,"
  },
  {
   "start": 74.08,
   "end": 81.68,
   "text": "ובחיוך מעוות על פניו המתין להלוויה הראשונה של היהודים שתצא מתישהו."
  },
  {
   "start": 84.13,
   "end": 87.03,
   "text": "מסע ההלוויה התנהל לו לאיתו."
  },
  {
   "start": 87.95,
   "end": 89.21,
   "text": "משפחת יצחק החייט"
  },
  {
   "start": 89.93,
   "end": 93.35,
   "text": "ליוו את אביהם מיקירם בדרכו האחרונה."
  },
  {
   "start": 97.05,
   "end": 101.93,
   "text": "כשלפתע פעמוני הכנסייה שם בדרך אל בית הקברות"
  },
  {
   "start": 102.53,
   "end": 105.35,
   "text": "החלו מצלצלים ומצלצלים."
  },
  {
   "start": 106.35,
   "end": 106.91,
   "text": "חד עין,"
  },
  {
   "start": 107.49,
   "end": 110.57,
   "text": "אם היה מתבונן על הכנסייה היה רואה צללית שם,"
  },
  {
   "start": 111.15,
   "end": 113.59,
   "text": "שם למעלה בחלון, בחלון העליון,"
  },
  {
   "start": 114.25,
   "end": 116.15,
   "text": "צלליתו של הכומר תומאס,"
  },
  {
   "start": 116.65,
   "end": 121.65,
   "text": "שפניו להטו להם באש של שנאה כשהוא ממלמל מילים לא ברורות."
  },
  {
   "start": 122.71,
   "end": 125.21,
   "text": "השיירה הגיעה ליד הכנסייה,"
  },
  {
   "start": 127.36,
   "end": 127.82,
   "text": "ואז,"
  },
  {
   "start": 129.18,
   "end": 129.56,
   "text": "ואז זה קרה."
  },
  {
   "start": 130.52,
   "end": 134.32,
   "text": "לפתע נעמדו כל משתתפי ההלוויה קפואים."
  },
  {
   "start": 135.2,
   "end": 136.92,
   "text": "במקום להמשיך ישר אל בית הקברות,"
  },
  {
   "start": 137.76,
   "end": 139.04,
   "text": "הם החלו פונים שמאלה"
  },
  {
   "start": 139.76,
   "end": 141.38,
   "text": "אל עבר שערי הכנסייה,"
  },
  {
   "start": 142.02,
   "end": 144.8,
   "text": "כאילו כוח, כוח של רשע השתלט עליהם,"
  },
  {
   "start": 145.62,
   "end": 147.76,
   "text": "ומוליכם אל תוך הכנסייה."
  },
  {
   "start": 149.92,
   "end": 151.1,
   "text": "יומיים אחר כך"
  },
  {
   "start": 152.76,
   "end": 154.06,
   "text": "התפשטה לה השמועה"
  },
  {
   "start": 155.0,
   "end": 157.7,
   "text": "על קבוצת המלווים של יצחק החייט"
  },
  {
   "start": 158.78,
   "end": 162.7,
   "text": "שהצטרפו אל הכנסייה והמירו את דתם."
  },
  {
   "start": 163.68,
   "end": 165.14,
   "text": "אי אפשר היה לדבר איתם."
  },
  {
   "start": 166.34,
   "end": 168.08,
   "text": "הם פשוט נראו כמנותקים,"
  },
  {
   "start": 169.18,
   "end": 170.36,
   "text": "מנותקים מהעולם,"
  },
  {
   "start": 173.86,
   "end": 174.78,
   "text": "שבוע מאוחר יותר."
  },
  {
   "start": 176.36,
   "end": 180.72,
   "text": "בעת שהלוויית שלמה חלבן יצאה לדרכה,"
  },
  {
   "start": 181.86,
   "end": 182.16,
   "text": "שוב,"
  },
  {
   "start": 183.16,
   "end": 185.84,
   "text": "שוב נשמעו צלצולי פעמוני הכנסייה,"
  },
  {
   "start": 186.64,
   "end": 189.66,
   "text": "וגם הפעם איש לא שב מן ההלוויה."
  },
  {
   "start": 190.86,
   "end": 192.96,
   "text": "מאז באוסטריה, אם היה מסע הלוויה,"
  },
  {
   "start": 193.84,
   "end": 197.08,
   "text": "הוא היה יוצא לדרך ארוכה שעוקפת את הכנסייה."
  },
  {
   "start": 198.04,
   "end": 200.9,
   "text": "שעות רבות של הליכה, אבל לא הייתה ברירה אחרת."
  },
  {
   "start": 202.4,
   "end": 206.08,
   "text": "מאז אותו יום חיו תושבי אוסטריה בצל הפחד,"
  },
  {
   "start": 206.96,
   "end": 207.42,
   "text": "כששם"
  },
  {
   "start": 208.12,
   "end": 209.9,
   "text": "בכנסייה יושב לו הכומר תומאס"
  },
  {
   "start": 210.82,
   "end": 213.0,
   "text": "והוגד תוכניות שטניות נוספות."
  },
  {
   "start": 214.64,
   "end": 218.74,
   "text": "לא יהיה יהודי אחד בעולם שיתחמק ממנו, כך הוא חשב."
  },
  {
   "start": 219.44,
   "end": 222.52,
   "text": "לא אנוח ולא אשקוט עד שאנצח את כולם,"
  },
  {
   "start": 223.06,
   "end": 223.7,
   "text": "כך הוא הבטיח."
  },
  {
   "start": 224.82,
   "end": 227.6,
   "text": "והפחד שרר באוסטריה."
  },
  {
   "start": 235.5,
   "end": 236.28,
   "text": "מוצאי שבת,"
  },
  {
   "start": 237.36,
   "end": 238.32,
   "text": "ה' בכסלו"
  },
  {
   "start": 239.2,
   "end": 240.56,
   "text": "שנת ש״ב,"
  },
  {
   "start": 241.48,
   "end": 243.06,
   "text": "שעת לילה מאוחרת באוסטריה."
  },
  {
   "start": 244.46,
   "end": 248.24,
   "text": "אבל תושבי היהודים של אוסטריה לא ישנים."
  },
  {
   "start": 249.0,
   "end": 253.5,
   "text": "רובם ככולם מתגודדים סביב הבית של רבם הנערץ והאהוב,"
  },
  {
   "start": 254.28,
   "end": 254.9,
   "text": "המהרשע."
  },
  {
   "start": 255.74,
   "end": 260.96,
   "text": "המערשה שבגיל 76 חש שהגיע זמנו להיפטר מן העולם"
  },
  {
   "start": 261.56,
   "end": 264.92,
   "text": "ולהשיב את נשמתו הטהורה לאבא שבשמיים."
  },
  {
   "start": 266.42,
   "end": 268.84,
   "text": "והוא מבקש מהקרובים שלו,"
  },
  {
   "start": 269.76,
   "end": 271.94,
   "text": "מבניו, הרב משולם זלמן,"
  },
  {
   "start": 272.52,
   "end": 274.3,
   "text": "רבי יהודה לייב, הרב אברהם,"
  },
  {
   "start": 275.4,
   "end": 279.48,
   "text": "שהיו להם מסביב למיתתו לקרוא לראשי הקהל."
  },
  {
   "start": 281.04,
   "end": 284.7,
   "text": "וראשי הקהל נחפזים להם לבוא"
  },
  {
   "start": 285.8,
   "end": 289.84,
   "text": "עומדים ליד מיטת המהרשה ומתקשים להסתיר את דמעותיהם."
  },
  {
   "start": 290.78,
   "end": 295.92,
   "text": "הם לא יכלו לדמיין איך העולם ייראה ללא המהרשה."
  },
  {
   "start": 297.06,
   "end": 299.42,
   "text": "והמהרשה בשעותיו האחרונות,"
  },
  {
   "start": 300.28,
   "end": 303.58,
   "text": "כשמעטה של הוד והדר קדושים מעטר את פניו,"
  },
  {
   "start": 304.24,
   "end": 305.32,
   "text": "אמר בקול שקט,"
  },
  {
   "start": 306.36,
   "end": 307.44,
   "text": "מבקש אני מכם"
  },
  {
   "start": 308.12,
   "end": 309.7,
   "text": "שמסע ההלוויה שלי"
  },
  {
   "start": 310.54,
   "end": 313.14,
   "text": "ילך בדרך המקורית לבית הקברות,"
  },
  {
   "start": 314.14,
   "end": 315.2,
   "text": "בדרך הקצרה,"
  },
  {
   "start": 316.16,
   "end": 319.46,
   "text": "כמו ששנים היו מלווים נפטרים באוסטרה."
  },
  {
   "start": 322.93,
   "end": 326.19,
   "text": "מבט של חרדה התפשט על פני הסובבים."
  },
  {
   "start": 327.09,
   "end": 330.65,
   "text": "כולם ידעו את הסכנה המרחפת שם בדרך לבית הקברות."
  },
  {
   "start": 332.01,
   "end": 336.13,
   "text": "והרי במסע ההלוויה של המהרשה כל בני העיר השתתפו,"
  },
  {
   "start": 337.07,
   "end": 338.55,
   "text": "ומי יודע מה היו התוצאות."
  },
  {
   "start": 340.01,
   "end": 343.97,
   "text": "אבל קולו של המהרשה קטע את מחשבות הפחד של כולם,"
  },
  {
   "start": 344.87,
   "end": 346.05,
   "text": "ומבקש אני מכם,"
  },
  {
   "start": 346.75,
   "end": 347.73,
   "text": "המשיך אמרשה,"
  },
  {
   "start": 348.53,
   "end": 352.11,
   "text": "שעל המיטה שלי יונחו הספרים שחיברתי,"
  },
  {
   "start": 352.81,
   "end": 357.25,
   "text": "חידושי ההלכות על השס וחידושי האגדות על השס."
  },
  {
   "start": 358.11,
   "end": 361.33,
   "text": "את אלו תשימו על מיטתי בעת הלוויה."
  },
  {
   "start": 362.27,
   "end": 363.01,
   "text": "וכשתגיעו,"
  },
  {
   "start": 363.59,
   "end": 367.61,
   "text": "כשתגיעו עם מסע ההלוויה מול הכנסייה הטמעה הזאת,"
  },
  {
   "start": 368.47,
   "end": 372.07,
   "text": "תעצרו ותניחו את מיטתי על הקרקע."
  },
  {
   "start": 372.07,
   "end": 377.03,
   "text": "פשוט תעמדו שם ותמתינו."
  },
  {
   "start": 378.97,
   "end": 387.03,
   "text": "שעה אחר כך אמרשה פתח את עיניו הטהורות והחל בקול שקט וחלוש,"
  },
  {
   "start": 388.27,
   "end": 389.29,
   "text": "עורך וידוי."
  },
  {
   "start": 390.59,
   "end": 393.39,
   "text": "אמרשה עושה תשובה לפני מותו."
  },
  {
   "start": 394.77,
   "end": 401.11,
   "text": "אחר כך הוא החל מתפלל בשברון לב על כל עם ישראל בכל מקום שהם."
  },
  {
   "start": 403.07,
   "end": 403.79,
   "text": "ועתה,"
  },
  {
   "start": 404.35,
   "end": 405.75,
   "text": "ברגעים אלו של אמת,"
  },
  {
   "start": 406.55,
   "end": 409.91,
   "text": "הבינו הכול את מקור כוחו המופלא של המהרשע."
  },
  {
   "start": 410.71,
   "end": 411.37,
   "text": "הוא פשוט"
  },
  {
   "start": 411.95,
   "end": 412.93,
   "text": "רצה את השם."
  },
  {
   "start": 413.99,
   "end": 416.55,
   "text": "ולא רק רצה, אלא גם או עשה את הכול"
  },
  {
   "start": 417.53,
   "end": 418.61,
   "text": "כדי להתחבר אל השם."
  },
  {
   "start": 419.75,
   "end": 420.57,
   "text": "גם כשקשה,"
  },
  {
   "start": 421.35,
   "end": 422.47,
   "text": "ואולי בעיקר כשקשה,"
  },
  {
   "start": 423.45,
   "end": 424.49,
   "text": "כשלכאורה אין חשק,"
  },
  {
   "start": 424.89,
   "end": 425.75,
   "text": "כשעייפים,"
  },
  {
   "start": 426.05,
   "end": 428.39,
   "text": "כשלא הולך כל כך, כשלא רואים תוצאות."
  },
  {
   "start": 429.11,
   "end": 431.15,
   "text": "המהרשע כל הזמן היה קשור אל השם,"
  },
  {
   "start": 431.73,
   "end": 432.39,
   "text": "בכל מצב,"
  },
  {
   "start": 433.11,
   "end": 435.93,
   "text": "עד לכך שגם, גם בדקות האחרונות לחייו,"
  },
  {
   "start": 436.71,
   "end": 437.67,
   "text": "אמרשה היה מקושר"
  },
  {
   "start": 438.21,
   "end": 439.47,
   "text": "למי שאמר והיה עולם,"
  },
  {
   "start": 440.27,
   "end": 442.13,
   "text": "למלך מלאכי המלאכים הקדוש ברוך הוא,"
  },
  {
   "start": 442.65,
   "end": 444.13,
   "text": "ולוחש בכל הסובב אותו."
  },
  {
   "start": 444.73,
   "end": 447.31,
   "text": "ודבר כזה רוכשים רק בעמל,"
  },
  {
   "start": 448.01,
   "end": 448.87,
   "text": "רק ביגיעה,"
  },
  {
   "start": 449.55,
   "end": 450.33,
   "text": "רק בדבקות."
  },
  {
   "start": 452.6,
   "end": 455.46,
   "text": "אמרשה התיישב במיטתו,"
  },
  {
   "start": 456.0,
   "end": 458.08,
   "text": "הוא הושיט את ידו הימנית לפניו,"
  },
  {
   "start": 458.66,
   "end": 461.6,
   "text": "בקול רם וצלול הוא קרא,"
  },
  {
   "start": 462.12,
   "end": 463.44,
   "text": "שמע ישראל,"
  },
  {
   "start": 464.16,
   "end": 466.34,
   "text": "ומשסיים אחד,"
  },
  {
   "start": 467.08,
   "end": 468.56,
   "text": "קפוא הכל עלום דם."
  },
  {
   "start": 469.6,
   "end": 471.28,
   "text": "העולם כולו נדם,"
  },
  {
   "start": 471.92,
   "end": 478.68,
   "text": "כשנשמתו הטהורה של המהרשה נוסקת לאל על אל שמי מרומים,"
  },
  {
   "start": 479.62,
   "end": 481.74,
   "text": "הבכי פרץ לו באחת."
  },
  {
   "start": 482.6,
   "end": 487.28,
   "text": "מעתה העולם יהיה עולם ללא המהרשה."
  },
  {
   "start": 494.01,
   "end": 494.61,
   "text": "יום ראשון,"
  },
  {
   "start": 495.51,
   "end": 496.21,
   "text": "ה' כסלו,"
  },
  {
   "start": 497.17,
   "end": 498.89,
   "text": "העיר אוסטריה אבלה,"
  },
  {
   "start": 499.69,
   "end": 501.59,
   "text": "ומסע ההלוויה של המהרשה,"
  },
  {
   "start": 502.23,
   "end": 503.33,
   "text": "רבה של אוסטריה,"
  },
  {
   "start": 503.99,
   "end": 504.73,
   "text": "יוצא לדרך."
  },
  {
   "start": 506.83,
   "end": 507.07,
   "text": "שם,"
  },
  {
   "start": 507.73,
   "end": 508.99,
   "text": "בחלון העליון,"
  },
  {
   "start": 509.59,
   "end": 510.89,
   "text": "במרומי הכנסייה,"
  },
  {
   "start": 511.45,
   "end": 514.69,
   "text": "סופג כפיים בשמחה שטנית הכומר תומאס,"
  },
  {
   "start": 516.01,
   "end": 517.21,
   "text": "כשהוא בוחן בסיפוק"
  },
  {
   "start": 517.93,
   "end": 524.41,
   "text": "את מסע ההלוויה הארוך-ארוך שמתקרב לו לאיתו לכיוון הכנסייה."
  },
  {
   "start": 528.19,
   "end": 535.79,
   "text": "מסע הלוויה העצום החל מתקרב אל הכנסייה ואז החלו פעמוני הכנסייה מצלצלים."
  },
  {
   "start": 536.95,
   "end": 537.87,
   "text": "פעמוני המלווים,"
  },
  {
   "start": 538.45,
   "end": 539.43,
   "text": "היהודים נחרדו,"
  },
  {
   "start": 539.89,
   "end": 541.91,
   "text": "תלמידי המהרשעה פרצו בבכי מהר."
  },
  {
   "start": 542.57,
   "end": 543.41,
   "text": "מצד אחד רוצים,"
  },
  {
   "start": 543.87,
   "end": 548.87,
   "text": "רוצים לקיים את בקשת רבם הגדול ומצד שני החשש האיום, הפחד הזה,"
  },
  {
   "start": 549.47,
   "end": 550.03,
   "text": "מה יקרה?"
  },
  {
   "start": 551.61,
   "end": 555.63,
   "text": "מה עוד שהצלצולים האלו פשוט החלו חודרים למוחם,"
  },
  {
   "start": 556.17,
   "end": 558.21,
   "text": "קודחים להם בתוך מחשבותיהם,"
  },
  {
   "start": 558.75,
   "end": 561.19,
   "text": "וככל שמנסים להיפטר מהם אי אפשר."
  },
  {
   "start": 563.45,
   "end": 564.19,
   "text": "בחלון העליון"
  },
  {
   "start": 564.85,
   "end": 566.23,
   "text": "עמד הכומר תומאס."
  },
  {
   "start": 566.93,
   "end": 567.71,
   "text": "פניו מיוזעות."
  },
  {
   "start": 568.61,
   "end": 568.85,
   "text": "הפעם,"
  },
  {
   "start": 569.47,
   "end": 571.35,
   "text": "הפעם הוא הפעיל את מלוא עוצמת כוחותיו,"
  },
  {
   "start": 572.15,
   "end": 573.85,
   "text": "ואיש לא יוכל לעמוד כנגדו."
  },
  {
   "start": 574.65,
   "end": 576.55,
   "text": "זהו סופה של קהילת אוסטריה."
  },
  {
   "start": 577.31,
   "end": 578.03,
   "text": "כך הוא היה בטוח."
  },
  {
   "start": 579.19,
   "end": 580.49,
   "text": "בינתיים ראשוני המלווים,"
  },
  {
   "start": 580.99,
   "end": 582.27,
   "text": "נושאי מיטת המערשה,"
  },
  {
   "start": 582.71,
   "end": 584.45,
   "text": "מגיעים להם אל מול הכנסייה."
  },
  {
   "start": 585.25,
   "end": 588.25,
   "text": "כמו שהרב ביקש, הם נעצרו על עומדם,"
  },
  {
   "start": 588.95,
   "end": 594.4,
   "text": "מניחים את מיטת המהרשה על הק... נסתררה דממה."
  },
  {
   "start": 595.44,
   "end": 598.58,
   "text": "מהחלון העליון נשתקפה לה דמותו של הכומר תומאס,"
  },
  {
   "start": 599.5,
   "end": 600.04,
   "text": "וממול,"
  },
  {
   "start": 600.88,
   "end": 601.5,
   "text": "שם על הקרקע,"
  },
  {
   "start": 602.5,
   "end": 603.18,
   "text": "שכובה לה,"
  },
  {
   "start": 603.88,
   "end": 606.16,
   "text": "גופת המהרשה נחה על מיטתה."
  },
  {
   "start": 607.8,
   "end": 611.18,
   "text": "לפתע נשמעה רחש של תדהמה ופחד."
  },
  {
   "start": 612.64,
   "end": 616.08,
   "text": "הלא יאומן החל מתרחש לנגד עיניהם."
  },
  {
   "start": 616.9,
   "end": 619.54,
   "text": "גופת המהרשה החלה לנוע."
  },
  {
   "start": 621.6,
   "end": 622.9,
   "text": "הכל עצרו את נשימתם."
  },
  {
   "start": 624.68,
   "end": 625.16,
   "text": "המהרשה,"
  },
  {
   "start": 625.88,
   "end": 628.34,
   "text": "שהיה שכוב לפני רגע"
  },
  {
   "start": 628.86,
   "end": 629.76,
   "text": "ללא רוח חיים,"
  },
  {
   "start": 630.78,
   "end": 636.98,
   "text": "קם לו ונתיישב במיטתו כשהוא לוקח את חיבוריו הקדושים,"
  },
  {
   "start": 637.52,
   "end": 639.0,
   "text": "את הספרים אשר הוא כתב,"
  },
  {
   "start": 639.58,
   "end": 641.6,
   "text": "חידושי ההלכות והאגדות על השס."
  },
  {
   "start": 643.16,
   "end": 644.12,
   "text": "הוא פותח אותם"
  },
  {
   "start": 645.04,
   "end": 646.14,
   "text": "ומעיין בהם"
  },
  {
   "start": 646.76,
   "end": 647.64,
   "text": "לעיני כולם."
  },
  {
   "start": 648.64,
   "end": 649.42,
   "text": "אמר שעה,"
  },
  {
   "start": 650.4,
   "end": 651.94,
   "text": "שוב חזר ללמוד,"
  },
  {
   "start": 652.92,
   "end": 655.04,
   "text": "שוב חזר אל התורה הקדושה,"
  },
  {
   "start": 655.74,
   "end": 656.82,
   "text": "גם אחרי מותו."
  },
  {
   "start": 658.0,
   "end": 661.32,
   "text": "הקשר שוב חזר, שוב התהדק,"
  },
  {
   "start": 662.18,
   "end": 668.0,
   "text": "ובכנסייה שממול צלצולי הפעמונים מהדהדים להם ביתר שאת."
  },
  {
   "start": 668.88,
   "end": 670.88,
   "text": "הכומר תומאס משתולל לו בחדרו בטירוף,"
  },
  {
   "start": 671.58,
   "end": 673.66,
   "text": "מפעיל את כל הכוחות שהכיר ולמד,"
  },
  {
   "start": 674.34,
   "end": 677.64,
   "text": "גם כאלו שהוא שמר לזמנים מיוחדים."
  },
  {
   "start": 679.22,
   "end": 679.96,
   "text": "ואילו למטה,"
  },
  {
   "start": 680.86,
   "end": 683.48,
   "text": "המהרשע מעיין בספריו הקדושים,"
  },
  {
   "start": 684.22,
   "end": 686.32,
   "text": "מחובר כולו לבוראו,"
  },
  {
   "start": 686.78,
   "end": 688.38,
   "text": "כולו לקדוש ברוך הוא,"
  },
  {
   "start": 688.78,
   "end": 690.3,
   "text": "כולו אצל השם יתברך."
  },
  {
   "start": 691.24,
   "end": 692.64,
   "text": "וכך הוא החל מדפדף"
  },
  {
   "start": 693.32,
   "end": 694.56,
   "text": "בספרים שלפניו,"
  },
  {
   "start": 695.32,
   "end": 695.6,
   "text": "דף"
  },
  {
   "start": 696.42,
   "end": 697.4,
   "text": "ועוד דף."
  },
  {
   "start": 698.44,
   "end": 699.38,
   "text": "וראה זה פלא,"
  },
  {
   "start": 700.3,
   "end": 700.98,
   "text": "כל דף"
  },
  {
   "start": 701.68,
   "end": 703.04,
   "text": "שמעביר המהרשע"
  },
  {
   "start": 704.34,
   "end": 708.48,
   "text": "מחולל כמין זעזוע לכל בניין הכנסייה האדיר שממולו,"
  },
  {
   "start": 709.4,
   "end": 710.32,
   "text": "והבניין כולו"
  },
  {
   "start": 711.06,
   "end": 712.64,
   "text": "החל שוקע בקרקע."
  },
  {
   "start": 713.98,
   "end": 716.48,
   "text": "סנטימטר אחר סנטימטר,"
  },
  {
   "start": 717.24,
   "end": 717.84,
   "text": "כל דף"
  },
  {
   "start": 718.68,
   "end": 720.26,
   "text": "גורם לבניין לשקוע מטה."
  },
  {
   "start": 721.14,
   "end": 722.04,
   "text": "מבעד לחלונות"
  },
  {
   "start": 722.64,
   "end": 726.2,
   "text": "ניתן היה לראות את אנשי הכנסייה מבועדים, מפוחדים,"
  },
  {
   "start": 726.86,
   "end": 730.56,
   "text": "כשהם רואים למול עיניהם איך בניין הכנסייה שלהם,"
  },
  {
   "start": 731.06,
   "end": 732.16,
   "text": "כשהם בתוכו,"
  },
  {
   "start": 732.82,
   "end": 733.7,
   "text": "שוקע שלב"
  },
  {
   "start": 734.42,
   "end": 735.26,
   "text": "ועוד שלב"
  },
  {
   "start": 735.98,
   "end": 739.12,
   "text": "אל האדמה הבולעת אותו אל קרבה."
  },
  {
   "start": 740.12,
   "end": 742.32,
   "text": "צעקותיהם נשמעו בכל הסביבה,"
  },
  {
   "start": 743.92,
   "end": 746.66,
   "text": "והמהרשע בשלווה עילאית"
  },
  {
   "start": 747.5,
   "end": 748.94,
   "text": "מדפדף בספר"
  },
  {
   "start": 749.58,
   "end": 749.96,
   "text": "דף"
  },
  {
   "start": 750.82,
   "end": 751.5,
   "text": "ועודף"
  },
  {
   "start": 752.34,
   "end": 757.3,
   "text": "כשהכנסייה נבלעת לה באדמה סנטימטר"
  },
  {
   "start": 757.96,
   "end": 760.12,
   "text": "ועוד סנטימטר פנימה"
  },
  {
   "start": 760.7,
   "end": 762.3,
   "text": "מטה אל האדמה."
  },
  {
   "start": 763.98,
   "end": 764.62,
   "text": "הכומר תומאס,"
  },
  {
   "start": 765.42,
   "end": 766.2,
   "text": "שונא היהודים,"
  },
  {
   "start": 766.92,
   "end": 769.06,
   "text": "הביט במבט מפוחד סביבותיו."
  },
  {
   "start": 769.98,
   "end": 773.82,
   "text": "הוא שישב רק לפני זמן קצר במרומי הכנסייה,"
  },
  {
   "start": 774.14,
   "end": 775.14,
   "text": "בחלון העליון,"
  },
  {
   "start": 775.44,
   "end": 777.1,
   "text": "עם תוכניות לפגוע בכולם,"
  },
  {
   "start": 777.48,
   "end": 779.2,
   "text": "להזיק לכל היהודים בעולם."
  },
  {
   "start": 780.28,
   "end": 780.62,
   "text": "לפתע,"
  },
  {
   "start": 781.72,
   "end": 783.38,
   "text": "במבט מבוהל חסר אונים,"
  },
  {
   "start": 784.18,
   "end": 785.3,
   "text": "הוא מתבונן כפוא"
  },
  {
   "start": 786.08,
   "end": 789.84,
   "text": "איך הוא שוקע יחד עם בניין הכנסייה,"
  },
  {
   "start": 790.66,
   "end": 791.56,
   "text": "אל תוך הקרקע."
  },
  {
   "start": 794.08,
   "end": 796.82,
   "text": "זעקות הזעם של הכומר תומאס"
  },
  {
   "start": 797.46,
   "end": 799.6,
   "text": "נבלעו להם במעבי האדמה."
  },
  {
   "start": 800.62,
   "end": 803.72,
   "text": "עוד רגעים מועטים ונסתיים הכל."
  },
  {
   "start": 804.76,
   "end": 805.16,
   "text": "בשטח"
  },
  {
   "start": 805.78,
   "end": 808.08,
   "text": "בו עמדה הכנסייה נותר רק"
  },
  {
   "start": 808.6,
   "end": 810.46,
   "text": "קצה צריח של הכנסייה"
  },
  {
   "start": 811.1,
   "end": 812.3,
   "text": "כמעין עדות אילמת."
  },
  {
   "start": 813.42,
   "end": 815.32,
   "text": "תזכורת לכל העולם"
  },
  {
   "start": 816.3,
   "end": 820.7,
   "text": "על הגורל של מי שפוגע בבניו של ריבונו של עולם."
  },
  {
   "start": 821.78,
   "end": 823.58,
   "text": "מול כל כוחות הרשע והטומאה,"
  },
  {
   "start": 824.46,
   "end": 829.58,
   "text": "ניצב לו יהודי קדוש שכל חייו היה קשור אל השם ולתורתו,"
  },
  {
   "start": 830.44,
   "end": 832.56,
   "text": "ואת זה אי אפשר לנתק,"
  },
  {
   "start": 833.74,
   "end": 836.0,
   "text": "את זה אי אפשר לנצח."
  },
  {
   "start": 837.36,
   "end": 840.94,
   "text": "אמרשה הגיע אל הדף האחרון,"
  },
  {
   "start": 842.18,
   "end": 842.74,
   "text": "ואז"
  },
  {
   "start": 843.52,
   "end": 845.66,
   "text": "הוא סגר לאיתו את הספר."
  },
  {
   "start": 847.2,
   "end": 847.9,
   "text": "נשכב"
  },
  {
   "start": 848.88,
   "end": 851.58,
   "text": "חזרה על מיטתו,"
  },
  {
   "start": 852.44,
   "end": 853.3,
   "text": "עצם את עיניו,"
  },
  {
   "start": 854.3,
   "end": 855.54,
   "text": "ובשלווה עילאית"
  },
  {
   "start": 856.32,
   "end": 857.56,
   "text": "נפרד סופית"
  },
  {
   "start": 858.4,
   "end": 859.08,
   "text": "מן העולם,"
  },
  {
   "start": 860.24,
   "end": 861.66,
   "text": "כשעתה הכל יודעים."
  },
  {
   "start": 863.1,
   "end": 865.12,
   "text": "עד כמה הייתה גדולתו של המהרשה,"
  },
  {
   "start": 866.16,
   "end": 867.12,
   "text": "היהודי שכל חייו,"
  },
  {
   "start": 868.12,
   "end": 869.34,
   "text": "על אף הקשיים והניסיונות,"
  },
  {
   "start": 870.26,
   "end": 871.72,
   "text": "קשר את עצמו אל השם יתברך,"
  },
  {
   "start": 872.44,
   "end": 875.72,
   "text": "וכל חייו היו מסכת של התעלות רוחנית וקדושה,"
  },
  {
   "start": 875.72,
   "end": 881.28,
   "text": "כי כשקשורים למעלה לעולם לא נופלים למטה."
  }
 ]
}