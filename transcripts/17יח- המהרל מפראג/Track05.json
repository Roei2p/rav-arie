{
 "disc": "17יח- המהרל מפראג",
 "track": "Track05",
 "duration": 920.16,
 "segments": [
  {
   "start": 5.47,
   "end": 6.25,
   "text": "דוקטור משה מוריצי,"
  },
  {
   "start": 7.53,
   "end": 8.67,
   "text": "בנו של הקצב של פראג,"
  },
  {
   "start": 9.63,
   "end": 10.35,
   "text": "ומשפחתו"
  },
  {
   "start": 11.07,
   "end": 13.53,
   "text": "עוררו צער גדול בלב יהודי פראג. הם היו רחוקים מיהדות."
  },
  {
   "start": 15.45,
   "end": 18.43,
   "text": "הבית שלהם היה יותר בקרוב לנוצרים מאשר בקרבת היהודים."
  },
  {
   "start": 19.87,
   "end": 24.05,
   "text": "וכאשר עד דכך, כאשר נכפתה על היהודים גזירה חדשה של הכומר תדאוס,"
  },
  {
   "start": 24.85,
   "end": 27.53,
   "text": "לשבת ולהשתתף בדרשות של הכומר כל יום ראשון."
  },
  {
   "start": 28.75,
   "end": 31.57,
   "text": "אז כל היהודים אטמו את האוזניים שלהם בצמר גפן,"
  },
  {
   "start": 33.35,
   "end": 34.87,
   "text": "אטמו את הלב שלהם בברזל,"
  },
  {
   "start": 35.89,
   "end": 38.29,
   "text": "אבל משפחת דוקטור מוריצי, היא לא, לא הבינה."
  },
  {
   "start": 39.55,
   "end": 42.41,
   "text": "למה? למה צמר גפן? מה זה משנה? מה, מה, מה יכול להשפיע?"
  },
  {
   "start": 43.65,
   "end": 46.87,
   "text": "מה יכול להשפיע? למה אתם כאלה ישר מפחדים? מה קרה?"
  },
  {
   "start": 47.27,
   "end": 47.85,
   "text": "שידבר!"
  },
  {
   "start": 50.37,
   "end": 53.11,
   "text": "וככה ישבה לה בתם היחידה, אולגה,"
  },
  {
   "start": 54.27,
   "end": 57.71,
   "text": "בילדותה סופגת אך ורק טומאה. יהדות היא לא קיבלה."
  },
  {
   "start": 59.27,
   "end": 61.55,
   "text": "הדרשות היחידות שלהם זה היה של הכומר, תדאוס."
  },
  {
   "start": 62.61,
   "end": 64.91,
   "text": "פלג שהיא בגרה, שהיא רוצה לצאת"
  },
  {
   "start": 65.89,
   "end": 68.01,
   "text": "מהתווית הזאת של להיות יהודייה."
  },
  {
   "start": 69.17,
   "end": 71.19,
   "text": "היא רצה להיות כמו כולם, כמו כל החברות הגויות שלה."
  },
  {
   "start": 74.46,
   "end": 76.32,
   "text": "ובאמת, כשהיא דיברה עם החברות אמרו לה, בואי,"
  },
  {
   "start": 76.7,
   "end": 78.12,
   "text": "קומר תדאוס יסדר לך"
  },
  {
   "start": 79.44,
   "end": 81.7,
   "text": "איך להמיר את הדת בצורה הכי מהירה והכי נוחה."
  },
  {
   "start": 82.68,
   "end": 84.62,
   "text": "אולגה אמרה להם, טוב, אני אדבר קודם כל עם אבא ואמא,"
  },
  {
   "start": 84.7,
   "end": 85.8,
   "text": "ישמח אותם על הידיעה,"
  },
  {
   "start": 85.94,
   "end": 86.82,
   "text": "בטח הם יהיו מאושרים."
  },
  {
   "start": 87.98,
   "end": 91.34,
   "text": "היא באה ודיברה עם אבא שלה ואימא שלה, הייתה בטוחה שהם ישמחו,"
  },
  {
   "start": 92.72,
   "end": 94.14,
   "text": "אבל היא ציפתה אולי להרבה דברים."
  },
  {
   "start": 94.42,
   "end": 96.22,
   "text": "לתגובה של אבא שלה היא בטוח לא ציפתה."
  },
  {
   "start": 97.3,
   "end": 100.3,
   "text": "הוא התחיל להשתולל מכעס. איזה זעם, איזה צעקות."
  },
  {
   "start": 101.08,
   "end": 102.3,
   "text": "איזה כינויים הוא קרא לה."
  },
  {
   "start": 102.82,
   "end": 103.66,
   "text": "אי אפשר היה לעצור אותו."
  },
  {
   "start": 105.8,
   "end": 109.86,
   "text": "והיא לא מבינה, מה אתה רוצה? הרי כל החיים שלי אתה דאגת שאני אהיה קרובה לזה. מה אתה רוצה?"
  },
  {
   "start": 114.8,
   "end": 115.5,
   "text": "שבועיים אחר כך,"
  },
  {
   "start": 116.62,
   "end": 117.04,
   "text": "ליל הסדר."
  },
  {
   "start": 118.42,
   "end": 120.88,
   "text": "דוקטור משה מוריץ, את רעייתו עשו חשבון נפש."
  },
  {
   "start": 121.28,
   "end": 122.26,
   "text": "הם הבינו את הטעות שלהם,"
  },
  {
   "start": 122.94,
   "end": 124.04,
   "text": "את הריחוק שלהם מהיהדות."
  },
  {
   "start": 125.14,
   "end": 126.54,
   "text": "ובפעם הראשונה בחיים שלהם,"
  },
  {
   "start": 127.38,
   "end": 129.64,
   "text": "הם החליטו לעשות סדר בבית."
  },
  {
   "start": 131.14,
   "end": 131.86,
   "text": "ליל סדר בבית."
  },
  {
   "start": 133.0,
   "end": 135.62,
   "text": "והם ממתינים לבת שלהם, לאולגה, ממתינים וממתינים."
  },
  {
   "start": 138.67,
   "end": 139.17,
   "text": "בינתיים,"
  },
  {
   "start": 140.79,
   "end": 142.93,
   "text": "במנזר שם אצל הכומר תדאוס,"
  },
  {
   "start": 143.55,
   "end": 145.59,
   "text": "אולגה מתקבלת בשמחה גדולה"
  },
  {
   "start": 146.93,
   "end": 151.49,
   "text": "על ידי הכומר תדאוס. כמה הוא מחכה, מחכה הרי, כמה דרשות הוא נתן כדי..."
  },
  {
   "start": 152.23,
   "end": 157.89,
   "text": "ויהודי אחד אפילו לא מתייחס אליו, ופתאום בא לו יהודייה על מגע של כסף, אני רוצה להתנצר."
  },
  {
   "start": 161.38,
   "end": 163.6,
   "text": "אולגה קיבלה חדר צר בקצה המנזר."
  },
  {
   "start": 164.26,
   "end": 166.5,
   "text": "מדי פעם היו מובאים לאוכל לשתייה ושתייה,"
  },
  {
   "start": 166.92,
   "end": 167.94,
   "text": "היא הייתה אוכלת שותה,"
  },
  {
   "start": 168.44,
   "end": 170.58,
   "text": "ופתאום ההכרה שלה הייתה מתערפלת והייתה נרדמת."
  },
  {
   "start": 171.6,
   "end": 174.36,
   "text": "למה? כי תדאוס תכנן לה עוד תוכניות."
  },
  {
   "start": 176.28,
   "end": 178.1,
   "text": "והוא שם לה סמים באוכל,"
  },
  {
   "start": 179.62,
   "end": 180.96,
   "text": "כדי שתהיה כל הזמן תחת שליטתו."
  },
  {
   "start": 183.22,
   "end": 188.8,
   "text": "ואז אחרי כמה ימים תדאוס מתחיל להפעיל לחץ על אולגה. הוא אומר לה, תקשיבי, בחוץ היהודים כבר לא אוהבים אותך, כולם שמעו על זה."
  },
  {
   "start": 189.46,
   "end": 191.54,
   "text": "התפרסם שאת הלכת להמיר את דתך."
  },
  {
   "start": 192.6,
   "end": 194.78,
   "text": "אנחנו, אם אני לא אעזור לך, אין לך חיים בכלל."
  },
  {
   "start": 196.52,
   "end": 204.02,
   "text": "אמר לה, תקשיבי, את צריכה לספר מה שאני אגיד לך. יבוא לך כשאת הלכי להתנצר, יבוא לך השמן הגדול,"
  },
  {
   "start": 204.96,
   "end": 207.62,
   "text": "והוא יבוא וישאל אותך, תגידי לי למה החלטת להתנצר,"
  },
  {
   "start": 208.42,
   "end": 209.18,
   "text": "ואת תגידי לו"
  },
  {
   "start": 210.54,
   "end": 211.82,
   "text": "מה שאני אגיד לך."
  },
  {
   "start": 212.5,
   "end": 214.48,
   "text": "והתחילה לפחד, מה אתה רוצה ממני?"
  },
  {
   "start": 215.88,
   "end": 218.8,
   "text": "והוא הפריח אותה להגיד את מה שהוא רוצה."
  },
  {
   "start": 218.8,
   "end": 224.58,
   "text": "הוא אמר לה, תגידי שאת ראית את שני עוזרי הרב, אחד ענק אילם"
  },
  {
   "start": 226.28,
   "end": 227.52,
   "text": "ואחד עם זקן לבן,"
  },
  {
   "start": 228.18,
   "end": 229.82,
   "text": "ובידיים שלהם כוסות עם דם."
  },
  {
   "start": 232.68,
   "end": 235.9,
   "text": "באים לאבא שלך ואומרים לו, תשים את זה בבצק של המצות."
  },
  {
   "start": 237.38,
   "end": 239.34,
   "text": "ואבא שלך שאל, מה, מה זה? של מי הדם הזה?"
  },
  {
   "start": 240.12,
   "end": 241.1,
   "text": "ואז הם אמרו, זה של ריטה."
  },
  {
   "start": 241.78,
   "end": 242.48,
   "text": "ריטה הבחורה,"
  },
  {
   "start": 243.24,
   "end": 244.94,
   "text": "זאת שעבדה כעוזרת"
  },
  {
   "start": 246.32,
   "end": 247.02,
   "text": "בבית הכוהנים,"
  },
  {
   "start": 251.23,
   "end": 253.29,
   "text": "ונעלמה כבר מזה שבועיים."
  },
  {
   "start": 256.09,
   "end": 261.75,
   "text": "ואת תגידי שאת שמעת אותם אומרים שהם לקחו את הדם הזה להשתמש בבצק למצות ומכריכים בשם הרב,"
  },
  {
   "start": 262.95,
   "end": 264.03,
   "text": "בשם המהרל מפראג,"
  },
  {
   "start": 264.77,
   "end": 266.29,
   "text": "מכריכים את אבא שלך למהול את זה בבצק."
  },
  {
   "start": 274.35,
   "end": 276.49,
   "text": "כשבאו לערוך את טקס המרת הדת של אולגה,"
  },
  {
   "start": 278.31,
   "end": 280.49,
   "text": "שאל אותה חשמן הכנסייה, למה את רוצה למיר דתך?"
  },
  {
   "start": 281.97,
   "end": 282.57,
   "text": "והיא סיפרה לו."
  },
  {
   "start": 283.25,
   "end": 285.31,
   "text": "היא סיפרה לו בקול רועד מפחד ואימה."
  },
  {
   "start": 286.75,
   "end": 291.89,
   "text": "וכשהיא גמרה לספר, כתב אישום נורא ואיום נכתב והובא אל המהרל."
  },
  {
   "start": 292.53,
   "end": 294.55,
   "text": "שני שליחים"
  },
  {
   "start": 296.55,
   "end": 297.43,
   "text": "מטעם המשטרה"
  },
  {
   "start": 298.77,
   "end": 300.43,
   "text": "מסרו את כתב האישום אל המהר״ל,"
  },
  {
   "start": 301.55,
   "end": 301.99,
   "text": "והוא קרע"
  },
  {
   "start": 303.93,
   "end": 304.87,
   "text": "הנהן בראשו,"
  },
  {
   "start": 308.36,
   "end": 311.26,
   "text": "דקות מספר אחר כך יצאו שליחים מטעם המהר״ל,"
  },
  {
   "start": 311.94,
   "end": 312.88,
   "text": "יצאו למשימה חשאית,"
  },
  {
   "start": 314.22,
   "end": 317.78,
   "text": "בעוד הרב עומד ונושא את קולו בבכי לקדוש ברוך הוא,"
  },
  {
   "start": 318.4,
   "end": 318.92,
   "text": "מתפלל,"
  },
  {
   "start": 319.54,
   "end": 320.14,
   "text": "מתפלל,"
  },
  {
   "start": 320.56,
   "end": 321.16,
   "text": "מתפלל."
  },
  {
   "start": 323.58,
   "end": 324.02,
   "text": "השליחים,"
  },
  {
   "start": 324.94,
   "end": 327.38,
   "text": "השליחים מצאו בינתיים את מה שהם חיפשו, פלאי פלאות."
  },
  {
   "start": 328.0,
   "end": 330.36,
   "text": "תפילתו של המהר״ל הניבה תוצאות לא להאמין."
  },
  {
   "start": 331.12,
   "end": 334.34,
   "text": "ממש משמיים נמצא בפראג קבצן נודד,"
  },
  {
   "start": 334.68,
   "end": 335.68,
   "text": "חירש ואילם,"
  },
  {
   "start": 336.14,
   "end": 337.0,
   "text": "שדומה קצת"
  },
  {
   "start": 337.64,
   "end": 338.46,
   "text": "ליוסף הגולם."
  },
  {
   "start": 340.8,
   "end": 342.04,
   "text": "המהר״ל לקח את הקבצן,"
  },
  {
   "start": 343.06,
   "end": 343.8,
   "text": "אמר לו בוא בבקשה."
  },
  {
   "start": 345.02,
   "end": 347.28,
   "text": "הם לקחו אותו למער״ל, נתן לו אוכל ושתייה,"
  },
  {
   "start": 347.7,
   "end": 348.92,
   "text": "ואחר כך אמרו בבקשה בוא תשכב."
  },
  {
   "start": 349.54,
   "end": 350.66,
   "text": "נתן לו לשכב במיטה של הגולם."
  },
  {
   "start": 352.56,
   "end": 353.4,
   "text": "ואף אחד לא מבין למה."
  },
  {
   "start": 357.67,
   "end": 358.35,
   "text": "חצות הלילה."
  },
  {
   "start": 361.26,
   "end": 363.02,
   "text": "דפיקות בדלת."
  },
  {
   "start": 364.12,
   "end": 368.3,
   "text": "באים שוטרים לעצור את רבי אברהם חיים, עוזר המהרל,"
  },
  {
   "start": 368.9,
   "end": 369.94,
   "text": "ואת השמש האילם,"
  },
  {
   "start": 370.64,
   "end": 371.6,
   "text": "הידוע בשם יוסף."
  },
  {
   "start": 373.72,
   "end": 375.76,
   "text": "ומפנים אותם והם עוצרים את רבי אברהם חיים,"
  },
  {
   "start": 376.24,
   "end": 377.62,
   "text": "וניגשים למיטה של הגולם,"
  },
  {
   "start": 378.3,
   "end": 380.18,
   "text": "ועוצרים את הקבצן החרש אילם."
  },
  {
   "start": 381.54,
   "end": 384.7,
   "text": "והקבצן החרש אילם לא יכול להסביר להם, הוא לא הגולם, מה אתם רוצים ממנו? הוא לא מבין."
  },
  {
   "start": 386.66,
   "end": 387.3,
   "text": "עצרו את שניהם."
  },
  {
   "start": 388.18,
   "end": 391.1,
   "text": "כשהמשפט כנגד שניהם נקבע לעוד חודש ימים."
  },
  {
   "start": 400.38,
   "end": 401.76,
   "text": "מועד המשפט קרב ובא."
  },
  {
   "start": 404.41,
   "end": 406.03,
   "text": "רחבת בית המשפט הייתה המקום"
  },
  {
   "start": 406.67,
   "end": 411.61,
   "text": "בו התכנס המשפט כדי לאכלס את כל מאות ואלפי הצופים שבאו לראות."
  },
  {
   "start": 414.13,
   "end": 416.11,
   "text": "אבל ההרחבה התמלאה ברבבות בני אדם."
  },
  {
   "start": 417.45,
   "end": 418.71,
   "text": "זה נהפך למשפט ראווה."
  },
  {
   "start": 419.65,
   "end": 425.27,
   "text": "המהרל בינתיים כולו עסוק בתפילות. הוא הכריז כי יום המשפט יהיה יום של תענית בכל קהילת פראג."
  },
  {
   "start": 426.29,
   "end": 427.29,
   "text": "סליחות, קבלות,"
  },
  {
   "start": 432.38,
   "end": 432.94,
   "text": "והמשפט התחיל."
  },
  {
   "start": 433.94,
   "end": 436.28,
   "text": "רבי אברהם חיים לא מודה,"
  },
  {
   "start": 438.54,
   "end": 440.1,
   "text": "הקבצן האילם שנלקח בטעות,"
  },
  {
   "start": 441.18,
   "end": 445.36,
   "text": "כאילו יוסף הגולם, וכולם חושבים שהוא יוסף הגולם, מסמן שלא מבין מה רוצים ממנו."
  },
  {
   "start": 446.58,
   "end": 447.26,
   "text": "באמת הוא לא מבין."
  },
  {
   "start": 449.58,
   "end": 450.66,
   "text": "ואז מקימים את אולגה,"
  },
  {
   "start": 451.34,
   "end": 452.08,
   "text": "את אולגה המומרת."
  },
  {
   "start": 453.26,
   "end": 454.24,
   "text": "היא בקושי מדברת."
  },
  {
   "start": 455.44,
   "end": 461.44,
   "text": "בקול בוכים היא מספרת, אותה אולגה המסכנה שנכנסה למלכודת, שחיפשה לה חיים אחרים,"
  },
  {
   "start": 461.74,
   "end": 463.48,
   "text": "אבל מצאה לה חיים ארורים."
  },
  {
   "start": 464.44,
   "end": 471.5,
   "text": "היא מספרת את מה שהכומר תדאוס שעומד לידה ומביט בה במבט קטלני"
  },
  {
   "start": 473.58,
   "end": 474.76,
   "text": "דאג שהיא תגיד."
  },
  {
   "start": 475.46,
   "end": 478.62,
   "text": "היא לא חורגת מכל מה שהוא אילץ אותה להגיד שום מילה."
  },
  {
   "start": 480.28,
   "end": 482.34,
   "text": "השופט והקהל מזורזעים אומרים,"
  },
  {
   "start": 482.78,
   "end": 483.18,
   "text": "תגידי לי,"
  },
  {
   "start": 483.64,
   "end": 489.42,
   "text": "את יכולה לזהות את השניים שבאו עם כוסות אחרי שרצחו את ריטה ובאו לאבא שלך?"
  },
  {
   "start": 489.86,
   "end": 490.94,
   "text": "האם הם נמצאים פה?"
  },
  {
   "start": 491.74,
   "end": 493.98,
   "text": "תדאוס נועץ במבט מאיים."
  },
  {
   "start": 495.68,
   "end": 497.16,
   "text": "והיא בלט ברעי נענה כן,"
  },
  {
   "start": 497.84,
   "end": 502.04,
   "text": "כן, ונפלה תחתיה כשהכרתה מתערפדת לה מהסמים"
  },
  {
   "start": 503.32,
   "end": 504.1,
   "text": "בהם הולעטה."
  },
  {
   "start": 527.89,
   "end": 529.41,
   "text": "הרעש שבחוץ הלך וגבר"
  },
  {
   "start": 530.21,
   "end": 531.15,
   "text": "אל במת המשפט,"
  },
  {
   "start": 531.99,
   "end": 533.39,
   "text": "שעמדה לה ברחבת בית המשפט,"
  },
  {
   "start": 534.83,
   "end": 535.71,
   "text": "שעטה לה עגלה,"
  },
  {
   "start": 536.61,
   "end": 538.35,
   "text": "נהוגה בידי אדם גדול וחסון."
  },
  {
   "start": 539.65,
   "end": 542.99,
   "text": "העגלון הזה לא התייחס להמון שמולו, הוא פרץ עם העגלה פנימה."
  },
  {
   "start": 544.05,
   "end": 545.61,
   "text": "ורק הבמה עצרה אותו."
  },
  {
   "start": 548.5,
   "end": 551.18,
   "text": "ואז הוא קפץ מן העגלה,"
  },
  {
   "start": 551.78,
   "end": 552.66,
   "text": "יוסף הגולם."
  },
  {
   "start": 553.74,
   "end": 557.22,
   "text": "ולתדהמת כל הניצבים, לפליאת כל השופטים,"
  },
  {
   "start": 558.5,
   "end": 561.18,
   "text": "קמה ויצאה לה מן העגלה דמות,"
  },
  {
   "start": 562.74,
   "end": 562.94,
   "text": "ריטה."
  },
  {
   "start": 564.54,
   "end": 565.92,
   "text": "זו הנרצחת לכאורה,"
  },
  {
   "start": 567.44,
   "end": 569.36,
   "text": "חיה בריאה ושלמה."
  },
  {
   "start": 571.79,
   "end": 574.81,
   "text": "דממת הלם נסתררה לה בהרחבה עמוסה אדם."
  },
  {
   "start": 577.89,
   "end": 579.45,
   "text": "לפתע נשמע קולו של המהרל,"
  },
  {
   "start": 580.47,
   "end": 585.31,
   "text": "האם אתם עוד רוצים להמשיך בהצגה הזו כשהנרצחת חיה ובריאה?"
  },
  {
   "start": 585.93,
   "end": 587.83,
   "text": "לא נרצחה ולא קרה כלום?"
  },
  {
   "start": 595.64,
   "end": 596.6,
   "text": "והמשפט נסגר."
  },
  {
   "start": 597.72,
   "end": 601.28,
   "text": "המהר״ל הודה לה' על הכל והגולם שמילא את השליחות שלו"
  },
  {
   "start": 603.72,
   "end": 605.56,
   "text": "לאתר את ריטה בבית הוריה שבווינה"
  },
  {
   "start": 607.0,
   "end": 607.7,
   "text": "נח לו בצד."
  },
  {
   "start": 610.83,
   "end": 612.23,
   "text": "הכומר תדאוס היה בלחץ."
  },
  {
   "start": 612.93,
   "end": 614.15,
   "text": "עשרות עיניים מאשימות"
  },
  {
   "start": 614.77,
   "end": 615.41,
   "text": "נישאו אליו."
  },
  {
   "start": 618.12,
   "end": 620.36,
   "text": "מאיפה ידעתי שהיהודייה הזאת משקרת כל כך טוב?"
  },
  {
   "start": 620.94,
   "end": 623.08,
   "text": "הצביעה על אולגה שעמדה לה חיוורת ובוכייה."
  },
  {
   "start": 624.96,
   "end": 625.82,
   "text": "זה כבר היה מוגזם."
  },
  {
   "start": 626.76,
   "end": 629.98,
   "text": "שקרן, אתה אילצת אותי, צווחה אולגה בהיסטריה."
  },
  {
   "start": 631.26,
   "end": 632.3,
   "text": "והיא התמוטטה שוב."
  },
  {
   "start": 635.1,
   "end": 635.98,
   "text": "כשהיא התעוררה,"
  },
  {
   "start": 636.76,
   "end": 639.72,
   "text": "היא נדהמה לשמוע כי דנו אותה לשש שנות מאסר בפועל,"
  },
  {
   "start": 643.44,
   "end": 644.52,
   "text": "והיא אפילו לא ידעה למי לבכות,"
  },
  {
   "start": 645.62,
   "end": 646.18,
   "text": "למי לפנות,"
  },
  {
   "start": 646.84,
   "end": 647.66,
   "text": "למי להתפלל."
  },
  {
   "start": 649.14,
   "end": 649.28,
   "text": "רק מלמלה."
  },
  {
   "start": 650.62,
   "end": 651.0,
   "text": "חטאתי."
  },
  {
   "start": 651.68,
   "end": 652.36,
   "text": "טעיתי."
  },
  {
   "start": 652.82,
   "end": 653.62,
   "text": "אני האשמה."
  },
  {
   "start": 654.28,
   "end": 654.86,
   "text": "אני האשמה."
  },
  {
   "start": 660.75,
   "end": 664.49,
   "text": "מבעד למסך דמעותיה היא ראתה לפתע את דמותו הגבוהה"
  },
  {
   "start": 665.43,
   "end": 666.03,
   "text": "של הרבי"
  },
  {
   "start": 666.77,
   "end": 667.57,
   "text": "רבי יהודה ליבו"
  },
  {
   "start": 668.83,
   "end": 670.67,
   "text": "ניגשת אל חבר השופטים"
  },
  {
   "start": 671.37,
   "end": 673.63,
   "text": "והרב מבקש להקל בעונש שלה,"
  },
  {
   "start": 674.49,
   "end": 675.75,
   "text": "של אולגה זו המומרת."
  },
  {
   "start": 679.15,
   "end": 684.13,
   "text": "היא לא הבינה אצילות נפש כזאת אם מעולם נתקלה שמישהו אכפת לו ממנה."
  },
  {
   "start": 686.07,
   "end": 686.59,
   "text": "והשופטים,"
  },
  {
   "start": 687.43,
   "end": 688.53,
   "text": "הפלא ופלא הסכימו"
  },
  {
   "start": 689.41,
   "end": 694.15,
   "text": "והיא קיבלה, במקום שש שנות מאסר, שנת מאסר אחת בפועל."
  },
  {
   "start": 707.21,
   "end": 709.11,
   "text": "שנת המאסר עם עבודה מסיבית"
  },
  {
   "start": 709.85,
   "end": 711.39,
   "text": "שינו את חייה של אולגה."
  },
  {
   "start": 712.69,
   "end": 714.29,
   "text": "בתום השנה היא יצאה מהכלא."
  },
  {
   "start": 715.19,
   "end": 716.93,
   "text": "כבר לא נערה מבולבלת והיסטרית,"
  },
  {
   "start": 717.65,
   "end": 719.57,
   "text": "אלא נערה שיודעת בדיוק מה היא רוצה מעצמה."
  },
  {
   "start": 724.02,
   "end": 725.24,
   "text": "עם החינוך שהיא קיבלה,"
  },
  {
   "start": 726.06,
   "end": 726.98,
   "text": "עם הילדות שלה,"
  },
  {
   "start": 728.42,
   "end": 731.68,
   "text": "זאת שהרחיקה אותה כל כך הרבה מיהדות, אולגה רצתה דבר אחד,"
  },
  {
   "start": 732.56,
   "end": 733.02,
   "text": "לשוב"
  },
  {
   "start": 734.02,
   "end": 737.02,
   "text": "והפעם להתחיל חיים חדשים, להיות יהודייה."
  },
  {
   "start": 738.08,
   "end": 738.84,
   "text": "אבל יהודייה אמיתית,"
  },
  {
   "start": 739.4,
   "end": 740.66,
   "text": "כמו שיהודייה צריכה להיות."
  },
  {
   "start": 749.97,
   "end": 754.47,
   "text": "לצערי היא למדה שאין כמו היהדות, אבל בדרך הקשה היא למדה את זה."
  },
  {
   "start": 756.07,
   "end": 757.67,
   "text": "שערי הכלא נסגרו מאחריה,"
  },
  {
   "start": 761.72,
   "end": 763.32,
   "text": "ולפתע היא חשה פחד בלב."
  },
  {
   "start": 764.6,
   "end": 765.02,
   "text": "לאן היא תפנה?"
  },
  {
   "start": 767.44,
   "end": 768.92,
   "text": "איך היא תתחיל דף חדש,"
  },
  {
   "start": 769.84,
   "end": 771.06,
   "text": "דף יהודי חדש?"
  },
  {
   "start": 773.57,
   "end": 774.69,
   "text": "היא הרימה את העיניים שלה,"
  },
  {
   "start": 776.97,
   "end": 777.35,
   "text": "והנה,"
  },
  {
   "start": 778.05,
   "end": 778.79,
   "text": "בצד השני,"
  },
  {
   "start": 779.97,
   "end": 780.99,
   "text": "מעבר לשביל,"
  },
  {
   "start": 782.15,
   "end": 783.89,
   "text": "עמדה לה אישה והביטה בה."
  },
  {
   "start": 785.77,
   "end": 786.61,
   "text": "פרלה הרבנית,"
  },
  {
   "start": 789.17,
   "end": 790.17,
   "text": "אשת המהרל,"
  },
  {
   "start": 792.52,
   "end": 793.88,
   "text": "סימנה לה לבוא איתה אליה,"
  },
  {
   "start": 796.52,
   "end": 797.4,
   "text": "ואולגה התקרבה."
  },
  {
   "start": 801.22,
   "end": 801.76,
   "text": "שלום אולגה,"
  },
  {
   "start": 802.96,
   "end": 804.86,
   "text": "הרבה, אני שמחים כל כך שהשתחררת."
  },
  {
   "start": 819.08,
   "end": 819.32,
   "text": "ואולגה,"
  },
  {
   "start": 820.94,
   "end": 824.82,
   "text": "הביטה בה אישה שהיה אכפת לה ממנה."
  },
  {
   "start": 826.34,
   "end": 826.98,
   "text": "אם תרצי אולגה,"
  },
  {
   "start": 827.5,
   "end": 830.12,
   "text": "תוכלי לבוא ולהתגורר אצלנו."
  },
  {
   "start": 832.1,
   "end": 833.1,
   "text": "תקבלי אוכל חם,"
  },
  {
   "start": 834.9,
   "end": 835.68,
   "text": "מיטה נוחה,"
  },
  {
   "start": 836.96,
   "end": 837.68,
   "text": "ואפשרות"
  },
  {
   "start": 838.48,
   "end": 839.52,
   "text": "להתחיל מההתחלה,"
  },
  {
   "start": 840.34,
   "end": 841.34,
   "text": "להיות אולגה אמיתית,"
  },
  {
   "start": 842.58,
   "end": 843.72,
   "text": "בת ישראל כשרה."
  },
  {
   "start": 863.85,
   "end": 865.65,
   "text": "בעיניה של אולגה בצבצו דמעות,"
  },
  {
   "start": 868.5,
   "end": 869.74,
   "text": "ושתיהן התרחקו יחד"
  },
  {
   "start": 870.66,
   "end": 871.18,
   "text": "ממבנה הכלא."
  },
  {
   "start": 872.76,
   "end": 873.82,
   "text": "פרוסות להן חבוקות,"
  },
  {
   "start": 875.38,
   "end": 876.46,
   "text": "רבנית מבוגרת וצדקת,"
  },
  {
   "start": 878.18,
   "end": 887.78,
   "text": "ובת ישראל שעתה מקבלת האפשרות שלה להתעלות ולעלות במסילה"
  },
  {
   "start": 888.6,
   "end": 889.6,
   "text": "העולה לשמיים."
  },
  {
   "start": 894.26,
   "end": 906.23,
   "text": "בחורה שלא קיבלה צ'אנס מההורים שלה מקבלת עכשיו את הסיכוי שלה מהמהר״ל מפראג ומרעייתו הרבנית"
  },
  {
   "start": 906.97,
   "end": 908.49,
   "text": "שידעו לדאוג לכל עם ישראל,"
  },
  {
   "start": 910.13,
   "end": 912.79,
   "text": "גם לנדכאים ביותר, גם לרחוקים ביותר."
  }
 ]
}