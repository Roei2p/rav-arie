{
 "disc": "17יח- המהרל מפראג",
 "track": "Track02",
 "duration": 761.184,
 "segments": [
  {
   "start": 3.77,
   "end": 4.35,
   "text": "עם ישראל."
  },
  {
   "start": 5.47,
   "end": 6.55,
   "text": "עם ישראל נרדף ומוכה."
  },
  {
   "start": 7.45,
   "end": 8.55,
   "text": "עלילות דם, פוגרומים,"
  },
  {
   "start": 9.35,
   "end": 10.49,
   "text": "אינקוויזיציה בספרד."
  },
  {
   "start": 11.51,
   "end": 12.69,
   "text": "האינקוויזיציה משתוללת."
  },
  {
   "start": 13.77,
   "end": 14.47,
   "text": "ובפוזנא."
  },
  {
   "start": 15.77,
   "end": 19.75,
   "text": "בפוזנא יושב ילד קטן שקוראים לו יהודה ליבו."
  },
  {
   "start": 21.61,
   "end": 24.11,
   "text": "יושב בחדר שלו ובוכה,"
  },
  {
   "start": 25.19,
   "end": 26.15,
   "text": "ובוכה על מה?"
  },
  {
   "start": 26.81,
   "end": 27.85,
   "text": "לא על שלקחו לו את הגלידה,"
  },
  {
   "start": 28.89,
   "end": 30.35,
   "text": "לא על שאני לא יודע מה עשו לו."
  },
  {
   "start": 31.53,
   "end": 32.73,
   "text": "בוכה על העם שלו."
  },
  {
   "start": 33.95,
   "end": 42.87,
   "text": "ילד קטן רואה את הכאב של עם ישראל, שומע את הכאב של עם ישראל ובוכה ומתפלל השם."
  },
  {
   "start": 44.41,
   "end": 46.55,
   "text": "בפוזנא גודלת לה נשמה מיוחדת,"
  },
  {
   "start": 47.09,
   "end": 50.93,
   "text": "נשמה רגישה לכאב של עם ישראל, לבני ישראל, לבנות ישראל."
  },
  {
   "start": 54.92,
   "end": 55.86,
   "text": "וכך אותה נשמה,"
  },
  {
   "start": 56.38,
   "end": 66.61,
   "text": "אותה נשמה קדושה ורגישה שנמצאת בגופו של יהודה ליבו שגודל וצומח ועד מהרה אין מי שילמד אותו,"
  },
  {
   "start": 66.99,
   "end": 68.19,
   "text": "אין מי שיכול ללמד אותו."
  },
  {
   "start": 69.09,
   "end": 73.81,
   "text": "גאון מופלג בנגלה, בנסתר, ואף גם בחוכמת הטבע,"
  },
  {
   "start": 74.53,
   "end": 75.39,
   "text": "היה גאון גדול."
  },
  {
   "start": 77.47,
   "end": 79.09,
   "text": "ולאט לאט הוא נהפך לגאון גדול,"
  },
  {
   "start": 79.85,
   "end": 80.61,
   "text": "קדוש ומנהיג."
  },
  {
   "start": 84.14,
   "end": 84.72,
   "text": "ולעולם,"
  },
  {
   "start": 85.48,
   "end": 85.98,
   "text": "לעולם,"
  },
  {
   "start": 86.94,
   "end": 90.2,
   "text": "רבי יהודה ליבו לא שוכח את עם ישראל, את העם שלו."
  },
  {
   "start": 91.02,
   "end": 94.18,
   "text": "כל הזמן הוא מתפלל על עם ישראל, כל הזמן הוא בוכה להשם יתברך."
  },
  {
   "start": 95.36,
   "end": 97.64,
   "text": "בוכה להשם יתברך על העם שלו,"
  },
  {
   "start": 98.68,
   "end": 100.04,
   "text": "על הילדים, על הילדות של הקדוש ברוך הוא."
  },
  {
   "start": 101.64,
   "end": 104.06,
   "text": "וכך הוא נהיה המהר״ל מפראג."
  },
  {
   "start": 113.42,
   "end": 117.12,
   "text": "רבי יהודה ליבו יושב בפוזנא ובוכה על עם ישראל,"
  },
  {
   "start": 117.9,
   "end": 119.38,
   "text": "לומד תורה ובוכה על עם ישראל."
  },
  {
   "start": 120.08,
   "end": 121.46,
   "text": "ובינתיים בצד השני בפראג"
  },
  {
   "start": 122.94,
   "end": 125.06,
   "text": "נמצא שם שמואל רייך, העשיר של העיר פראג."
  },
  {
   "start": 125.94,
   "end": 127.38,
   "text": "נדיב איש חסד עצום."
  },
  {
   "start": 128.2,
   "end": 128.82,
   "text": "הבת שלו היחידה,"
  },
  {
   "start": 129.78,
   "end": 130.18,
   "text": "פנינה,"
  },
  {
   "start": 132.31,
   "end": 133.03,
   "text": "פנינה פרלה,"
  },
  {
   "start": 134.05,
   "end": 137.69,
   "text": "הייתה אשת חיל, נבונה, אשת חסד, כישרונית במעשיה."
  },
  {
   "start": 139.05,
   "end": 140.23,
   "text": "ועכשיו הגיע זמן השידוך שלה."
  },
  {
   "start": 140.71,
   "end": 142.61,
   "text": "וכשהגיע הזמן השידוך התחילו לזרום הצעות."
  },
  {
   "start": 143.09,
   "end": 145.35,
   "text": "את כולם היא דוחה אבל, את כולם היא דוחה."
  },
  {
   "start": 145.81,
   "end": 148.17,
   "text": "ושמואל רייך עצמו בעצמו הוא דוחה,"
  },
  {
   "start": 148.51,
   "end": 148.89,
   "text": "הוא לא מוכן."
  },
  {
   "start": 149.51,
   "end": 153.59,
   "text": "למה הוא יודע? הוא מחפש משהו מיוחד עבור הבת שלו. מגיע לה יותר, מגיע לה יותר."
  },
  {
   "start": 154.95,
   "end": 157.01,
   "text": "יום אחד מביא לו איזה ידיד נעורים"
  },
  {
   "start": 158.33,
   "end": 162.13,
   "text": "את שמו של בחור צעיר שיושב לו בפוזנא."
  },
  {
   "start": 163.55,
   "end": 165.33,
   "text": "אבל השמש שלו מתחילה להעיר בכל העולם."
  },
  {
   "start": 166.77,
   "end": 167.51,
   "text": "רבי יהודה ליבו,"
  },
  {
   "start": 168.75,
   "end": 170.37,
   "text": "איזה משהו פנימי אמר לשמואל רייך,"
  },
  {
   "start": 170.53,
   "end": 173.71,
   "text": "צריך ללכת לברר, ללכת ולהתחקות אחרי הבחור הזה."
  },
  {
   "start": 174.55,
   "end": 175.49,
   "text": "והוא הלך והתחיל לעקוב אחריו."
  },
  {
   "start": 175.99,
   "end": 178.27,
   "text": "הוא נסע מיוחד לפרוזנא לעקוב אחרי הבחור."
  },
  {
   "start": 180.93,
   "end": 183.17,
   "text": "וכשהוא ראה את מה שהוא ראה, ראה איך הוא לומד,"
  },
  {
   "start": 183.89,
   "end": 186.35,
   "text": "ראה את יראת שמיים שלו, ראה את הקדושה שלו."
  },
  {
   "start": 189.05,
   "end": 194.29,
   "text": "באמת זמן קצר אחר כך נחה לה הצעת שיתוך בבית עורי רבי יהודה ליבו."
  },
  {
   "start": 197.07,
   "end": 199.63,
   "text": "האירוסים נעשו לשיווית רצון כל הצדדים."
  },
  {
   "start": 200.69,
   "end": 202.93,
   "text": "ולא היה משהו שיפריע לאושר הזה."
  },
  {
   "start": 206.5,
   "end": 208.76,
   "text": "נראה ששום דבר לא יכול להפריע לאושר,"
  },
  {
   "start": 214.0,
   "end": 214.6,
   "text": "כך נדמה היה."
  },
  {
   "start": 215.82,
   "end": 216.66,
   "text": "פראג עלתה בלהבות."
  },
  {
   "start": 217.9,
   "end": 218.76,
   "text": "גם ביתו המפואר"
  },
  {
   "start": 219.36,
   "end": 220.36,
   "text": "של שמואל רייך,"
  },
  {
   "start": 220.9,
   "end": 222.2,
   "text": "על כל הרכוש שלו נשרף כולו."
  },
  {
   "start": 223.34,
   "end": 224.78,
   "text": "ושמואל נותר מול הבית שלו,"
  },
  {
   "start": 225.48,
   "end": 227.66,
   "text": "או יותר נכון, מול מה שנשאר מהבית שלו."
  },
  {
   "start": 228.3,
   "end": 230.44,
   "text": "כל הרכוש שלו, כל הכסף ירד לטמיון."
  },
  {
   "start": 233.97,
   "end": 234.73,
   "text": "ביתו פנינה פרלה"
  },
  {
   "start": 236.09,
   "end": 238.29,
   "text": "הביטה גם היא בשרידים העשנים."
  },
  {
   "start": 244.88,
   "end": 245.7,
   "text": "לא היה זמן לחשוב."
  },
  {
   "start": 246.68,
   "end": 249.34,
   "text": "רעש והעמולה נוראים נשמעו מתקרבים לעברם."
  },
  {
   "start": 251.08,
   "end": 253.08,
   "text": "קבוצות של גויים מוסתים על ידי הכמרים."
  },
  {
   "start": 257.16,
   "end": 258.42,
   "text": "הכמרים לא בזבזו את הזמן."
  },
  {
   "start": 259.06,
   "end": 261.72,
   "text": "בכנסייה הם אמרו, מי הצית את האש בפראג?"
  },
  {
   "start": 262.14,
   "end": 264.4,
   "text": "מי שרף את הבתים בפראג? כמובן היהודים."
  },
  {
   "start": 265.38,
   "end": 267.12,
   "text": "כל מה שקורה, היהודים אשמים, זה ברור."
  },
  {
   "start": 268.34,
   "end": 270.66,
   "text": "וקבוצות של גויים מתקרבים"
  },
  {
   "start": 273.95,
   "end": 274.87,
   "text": "אל הרובע היהודי."
  },
  {
   "start": 275.71,
   "end": 278.53,
   "text": "ושמואל רייך שעומד עכשיו מול אובדן כל רכושו,"
  },
  {
   "start": 280.01,
   "end": 281.29,
   "text": "לא היה לו זמן לחשוב, התחיל לברוח."
  },
  {
   "start": 281.81,
   "end": 282.33,
   "text": "לנוס,"
  },
  {
   "start": 282.95,
   "end": 284.95,
   "text": "על הדבר היחיד שעוד נותר לו ולמשפחתו,"
  },
  {
   "start": 285.39,
   "end": 286.15,
   "text": "על החיים שלהם."
  },
  {
   "start": 289.7,
   "end": 290.48,
   "text": "הם ברחו משם"
  },
  {
   "start": 291.5,
   "end": 292.44,
   "text": "ועדיין נשארו בחיים."
  },
  {
   "start": 305.08,
   "end": 310.0,
   "text": "שמואל רייך ומשפחתו שרדו בפראג בשביל הקשרים של שמואל רייך עם מספר ידידים בצמרת השלטון,"
  },
  {
   "start": 310.8,
   "end": 312.26,
   "text": "אבל שמואל עצמו נהפך לעני,"
  },
  {
   "start": 313.84,
   "end": 314.3,
   "text": "שהחל"
  },
  {
   "start": 315.4,
   "end": 317.34,
   "text": "בגב שכוח, בראש מושפל,"
  },
  {
   "start": 317.92,
   "end": 321.5,
   "text": "להיאבק על השגת מנת אוכל איומית לבני המשפחה שלו."
  },
  {
   "start": 342.19,
   "end": 345.29,
   "text": "יום אחד, ערב אחד, הוא פנה, פנה לבת שלו."
  },
  {
   "start": 346.37,
   "end": 346.75,
   "text": "בתי היקרה,"
  },
  {
   "start": 347.97,
   "end": 348.55,
   "text": "קשה לומר,"
  },
  {
   "start": 349.99,
   "end": 358.1,
   "text": "אבל קשרי הנירוסים בהם באנו עם אותו רבי יהודה ליבו,"
  },
  {
   "start": 358.72,
   "end": 359.64,
   "text": "זה כשהיינו עשירים,"
  },
  {
   "start": 361.02,
   "end": 364.02,
   "text": "אז הבטחתי שאני אוכל לתת לו ללמוד ולתמוך בכם,"
  },
  {
   "start": 364.54,
   "end": 365.52,
   "text": "אבל עכשיו השתנה המצב,"
  },
  {
   "start": 366.36,
   "end": 367.36,
   "text": "ואני לא יכול למלא את התנאים."
  },
  {
   "start": 369.36,
   "end": 369.86,
   "text": "ואז,"
  },
  {
   "start": 371.56,
   "end": 374.22,
   "text": "בפנינה פרל החלה בוכה,"
  },
  {
   "start": 375.66,
   "end": 378.66,
   "text": "אבל שמואל אבה המשיך, הוא היה חייב להמשיך, חייב להגיד את זה."
  },
  {
   "start": 379.4,
   "end": 384.0,
   "text": "אבל עכשיו, בתי היקרה, לקשר האירוסין הזה אין תוקף."
  },
  {
   "start": 390.36,
   "end": 392.9,
   "text": "ובתו הצדקת פנינה נשפרה."
  },
  {
   "start": 402.0,
   "end": 402.44,
   "text": "האיגרת,"
  },
  {
   "start": 403.1,
   "end": 404.56,
   "text": "האיגרת מבית שמואל רייך,"
  },
  {
   "start": 405.3,
   "end": 406.28,
   "text": "הגיעה לרבי ליבו."
  },
  {
   "start": 407.02,
   "end": 413.29,
   "text": "הוא קרא וקרא וכתב להם תשובה."
  },
  {
   "start": 416.3,
   "end": 417.36,
   "text": "המברק שהגיעה"
  },
  {
   "start": 419.02,
   "end": 419.96,
   "text": "הקפיץ את פנינה פרלה"
  },
  {
   "start": 420.86,
   "end": 421.66,
   "text": "ואת ההורים שלה."
  },
  {
   "start": 423.6,
   "end": 426.32,
   "text": "פנינה פתחה את המכתב ביד רועדת."
  },
  {
   "start": 429.95,
   "end": 430.69,
   "text": "במכתב היה כתוב,"
  },
  {
   "start": 431.51,
   "end": 431.81,
   "text": "מדוע?"
  },
  {
   "start": 432.53,
   "end": 432.85,
   "text": "למה?"
  },
  {
   "start": 433.77,
   "end": 435.07,
   "text": "למה לבטל את השידוך?"
  },
  {
   "start": 436.57,
   "end": 439.97,
   "text": "למה אתם חושבים שאני צריך לבטל את השידוך?"
  },
  {
   "start": 441.67,
   "end": 446.21,
   "text": "יש רק לאחוז בביטחון ואמונה שעוד יגיעו ימים טובים."
  },
  {
   "start": 447.67,
   "end": 449.97,
   "text": "אבל אני רוצה להמשיך בשידוך."
  },
  {
   "start": 450.63,
   "end": 451.37,
   "text": "אני לא מבטל אותו."
  },
  {
   "start": 452.47,
   "end": 454.19,
   "text": "אני מעוניין בפנינה פרלה."
  },
  {
   "start": 456.98,
   "end": 461.04,
   "text": "ופנינה פרלה ישבה לה על הכיסא שבסלום ובכתה."
  },
  {
   "start": 462.7,
   "end": 464.62,
   "text": "אבל הפעם בכי של אושר,"
  },
  {
   "start": 465.92,
   "end": 466.72,
   "text": "בכי של הקלה,"
  },
  {
   "start": 467.54,
   "end": 471.56,
   "text": "בכי של תודה לשם על שזכתה לחתן עם לב כל כך גדול,"
  },
  {
   "start": 472.56,
   "end": 473.82,
   "text": "לב כל כך מבין."
  },
  {
   "start": 476.81,
   "end": 477.87,
   "text": "הרי הוא יכול למצוא לו"
  },
  {
   "start": 479.71,
   "end": 480.59,
   "text": "כלה עשירה,"
  },
  {
   "start": 481.19,
   "end": 482.61,
   "text": "כלה שתדאג לו לחיים נוחים."
  },
  {
   "start": 483.97,
   "end": 486.09,
   "text": "אבל רבי יהודה ליבו לא ראה את החיים ככה."
  },
  {
   "start": 488.22,
   "end": 490.28,
   "text": "רבי יהודה ליבו חיפש מידות,"
  },
  {
   "start": 490.72,
   "end": 492.56,
   "text": "חיפש בנייה של בית יהודי,"
  },
  {
   "start": 493.7,
   "end": 494.9,
   "text": "חיפש נאמנות."
  },
  {
   "start": 495.96,
   "end": 497.44,
   "text": "וגם כשהמצב קשה,"
  },
  {
   "start": 498.64,
   "end": 499.5,
   "text": "בת ישראל,"
  },
  {
   "start": 500.84,
   "end": 508.93,
   "text": "לעזור אותה ברגעים כאלה? חס וחלילה."
  },
  {
   "start": 509.29,
   "end": 510.25,
   "text": "קשר הנאמנות"
  },
  {
   "start": 512.31,
   "end": 518.07,
   "text": "החל להיבנות בין פנינה פרלה לרבי יהודה ליבו."
  },
  {
   "start": 522.27,
   "end": 524.21,
   "text": "המצב קשה היה אצל שמואל רייך,"
  },
  {
   "start": 524.79,
   "end": 527.23,
   "text": "ופנינה מבקשת מאבא"
  },
  {
   "start": 527.91,
   "end": 530.97,
   "text": "תן לי את האפשרות קצת ללכת למכור קצת בייגלה,"
  },
  {
   "start": 531.59,
   "end": 532.63,
   "text": "קצת לחמניות,"
  },
  {
   "start": 533.27,
   "end": 535.77,
   "text": "שאני אוכל גם אני להביא פרנסה קצת הביתה, כמה."
  },
  {
   "start": 536.89,
   "end": 539.65,
   "text": "כל, כל, כל, כל סכום שאני אביא זה כבר טוב."
  },
  {
   "start": 541.27,
   "end": 542.23,
   "text": "ופנינה פרלה,"
  },
  {
   "start": 543.13,
   "end": 546.49,
   "text": "זאת שהייתה רגילה להיות בבית עשירים,"
  },
  {
   "start": 547.15,
   "end": 548.07,
   "text": "מוכרת לחם,"
  },
  {
   "start": 549.15,
   "end": 552.95,
   "text": "כדי שיהיה כמה, כמה אגורות תוכל להביא הביתה."
  },
  {
   "start": 556.1,
   "end": 558.08,
   "text": "ויום אחד עובר חייל,"
  },
  {
   "start": 560.37,
   "end": 561.27,
   "text": "רכוב על סוס,"
  },
  {
   "start": 562.09,
   "end": 565.51,
   "text": "ורואה את המוכרת לחם שמה, היהודייה רואה את הלחם, הבייגלה שמה,"
  },
  {
   "start": 565.93,
   "end": 568.61,
   "text": "משום מה משך את העיניים שלו, אתה לא יכול להסביר למה, לא יכול להבין למה."
  },
  {
   "start": 569.17,
   "end": 570.51,
   "text": "הוא פשוט הרים את הכידון שלו,"
  },
  {
   "start": 571.11,
   "end": 573.23,
   "text": "תקע אותו באחד הבייגלה,"
  },
  {
   "start": 575.66,
   "end": 576.5,
   "text": "ולקח אותו איתו"
  },
  {
   "start": 577.82,
   "end": 578.9,
   "text": "לפני הפרלה זעמה."
  },
  {
   "start": 579.96,
   "end": 582.56,
   "text": "אתה תיקח לי את המעט שנשאר לי,"
  },
  {
   "start": 583.04,
   "end": 584.76,
   "text": "את מה שאני מוכר כדי להביא קצת"
  },
  {
   "start": 585.3,
   "end": 588.56,
   "text": "כמה אגורות הביתה שיהיה קצת אולי בדל של חיוך לאימא שלי."
  },
  {
   "start": 589.4,
   "end": 591.08,
   "text": "גם את זה אתם רוצים לקחת את זה?"
  },
  {
   "start": 593.44,
   "end": 594.72,
   "text": "ובחוצפה יהודית"
  },
  {
   "start": 595.48,
   "end": 600.94,
   "text": "היא קמה לה ועוצרת את הסוס ואומרת לו,"
  },
  {
   "start": 601.46,
   "end": 603.78,
   "text": "אתה לא תיקח את זה, אתה תשלם על הבייגלה."
  },
  {
   "start": 605.54,
   "end": 607.94,
   "text": "החייל מסתכל מזרוזה או לא יודע מה."
  },
  {
   "start": 609.54,
   "end": 612.34,
   "text": "את מנסה לעצור אותי, אתה תשלם את הבייגלה."
  },
  {
   "start": 614.0,
   "end": 615.8,
   "text": "עמדה פנינה פרלה נחושה בדעתה."
  },
  {
   "start": 618.99,
   "end": 619.89,
   "text": "החייל עמד נבוך,"
  },
  {
   "start": 621.19,
   "end": 621.55,
   "text": "תפס"
  },
  {
   "start": 622.47,
   "end": 624.59,
   "text": "בה הוקפץ הוא היה איזה כרית."
  },
  {
   "start": 625.11,
   "end": 627.31,
   "text": "כלומר, לקחי את הכרית הזאת, זה שלל של המלחמה."
  },
  {
   "start": 628.83,
   "end": 630.09,
   "text": "קחי את זה בתור שכר."
  },
  {
   "start": 631.41,
   "end": 636.83,
   "text": "וזרק לה על הרצפה והדיר את סוסו וברח מהמקום."
  },
  {
   "start": 638.45,
   "end": 639.43,
   "text": "מה היית עושה עם כרית כזאת?"
  },
  {
   "start": 640.53,
   "end": 641.29,
   "text": "היא לקחה את הכרית."
  },
  {
   "start": 643.01,
   "end": 643.99,
   "text": "הכרית הייתה כבדה."
  },
  {
   "start": 647.5,
   "end": 648.84,
   "text": "בערב כשהיא חזרה הביתה,"
  },
  {
   "start": 649.72,
   "end": 651.82,
   "text": "סיפרה את כל הסיפור והניחה את הכרית."
  },
  {
   "start": 653.04,
   "end": 653.68,
   "text": "שמואל רייך"
  },
  {
   "start": 654.76,
   "end": 655.94,
   "text": "גם הוא חש שהכרית כבדה."
  },
  {
   "start": 658.36,
   "end": 660.92,
   "text": "הוא לקח סכין ופתח את הכרית."
  },
  {
   "start": 662.06,
   "end": 664.26,
   "text": "ועל השולחן הדל בבית שלהם"
  },
  {
   "start": 666.8,
   "end": 670.1,
   "text": "נפלו להם והתנוצצו להם מטבעות זהב."
  },
  {
   "start": 672.1,
   "end": 674.24,
   "text": "עוצר בתוך הכרית."
  },
  {
   "start": 683.64,
   "end": 686.74,
   "text": "שמואל רייך חזר להיות עשיר."
  },
  {
   "start": 688.28,
   "end": 692.64,
   "text": "פנינה קיבלה משמיים את השכר שהיה ראוי לה."
  },
  {
   "start": 697.46,
   "end": 697.98,
   "text": "ובפראג,"
  },
  {
   "start": 698.72,
   "end": 706.07,
   "text": "בשנת ש״ד התקיימה לה החתונה בין רבי יהודה ליבו"
  },
  {
   "start": 707.21,
   "end": 708.39,
   "text": "לבין בחירת ליבו"
  },
  {
   "start": 709.41,
   "end": 710.95,
   "text": "הקלה החסודה והצנועה"
  },
  {
   "start": 712.15,
   "end": 712.87,
   "text": "פנינה פרלה,"
  },
  {
   "start": 716.98,
   "end": 717.58,
   "text": "ששניהם"
  },
  {
   "start": 719.92,
   "end": 722.88,
   "text": "זכו להקים בית יהודי"
  },
  {
   "start": 723.56,
   "end": 724.72,
   "text": "שמושתת על נאמנות,"
  },
  {
   "start": 725.58,
   "end": 726.34,
   "text": "מושתת על מידות,"
  },
  {
   "start": 727.06,
   "end": 728.22,
   "text": "מושתת על אהבת אמת,"
  },
  {
   "start": 729.04,
   "end": 731.86,
   "text": "מושתת על יראת שמיים, על דבקות בשם יתברך."
  },
  {
   "start": 732.88,
   "end": 733.64,
   "text": "וכל חייה,"
  },
  {
   "start": 734.32,
   "end": 734.9,
   "text": "כל חייה,"
  },
  {
   "start": 735.8,
   "end": 739.52,
   "text": "היא הצהירה אמונים להשם יתברך שהיא תיתן לבעלה,"
  },
  {
   "start": 739.88,
   "end": 741.1,
   "text": "לבעלה לגדול בתורה,"
  },
  {
   "start": 741.46,
   "end": 743.16,
   "text": "לבעלה להנהיג את עם ישראל."
  },
  {
   "start": 743.62,
   "end": 746.66,
   "text": "ובאמת כל ימי חייהם היא הייתה זו שמאחור,"
  },
  {
   "start": 747.2,
   "end": 750.74,
   "text": "היא הייתה המנוע שדוחף את המהרל מפראג,"
  },
  {
   "start": 752.58,
   "end": 755.3,
   "text": "ואפשרה לו להגיע לשיאים כאלה גבוהים."
  }
 ]
}