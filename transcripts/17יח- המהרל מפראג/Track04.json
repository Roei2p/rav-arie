{
 "disc": "17יח- המהרל מפראג",
 "track": "Track04",
 "duration": 419.16,
 "segments": [
  {
   "start": 1.28,
   "end": 2.32,
   "text": "הוא ידע שיש לו למי לפנות."
  },
  {
   "start": 4.4,
   "end": 5.78,
   "text": "מרדכי היה מראשי הקהילה היהודית,"
  },
  {
   "start": 6.64,
   "end": 7.34,
   "text": "עשיר גדול,"
  },
  {
   "start": 8.38,
   "end": 10.72,
   "text": "וידוע בפראג כאדם טוב שהיה עוזר לכל אדם."
  },
  {
   "start": 11.74,
   "end": 12.4,
   "text": "אז הוא פנה למרדכי,"
  },
  {
   "start": 12.86,
   "end": 14.04,
   "text": "סיפר לו על השיפוצים שעשה,"
  },
  {
   "start": 14.32,
   "end": 17.52,
   "text": "על ההרחבה, על מה שהוא תוכנית הרחבת היקף שיש לו,"
  },
  {
   "start": 18.78,
   "end": 20.74,
   "text": "ועל החובות שהוא שקע בהם, והוא מבקש הלוואה."
  },
  {
   "start": 22.12,
   "end": 23.84,
   "text": "עם מועד פירעון קבוע, הוא יפרט הכל."
  },
  {
   "start": 25.16,
   "end": 26.74,
   "text": "מרדכי נענה והלווה לו סכום עתק."
  },
  {
   "start": 29.14,
   "end": 29.62,
   "text": "ועכשיו?"
  },
  {
   "start": 31.68,
   "end": 36.5,
   "text": "כמה שנים אחר כך מועד השבת הכסף קרב ואין לו כסף לבעל המסעדה להחזיר."
  },
  {
   "start": 37.84,
   "end": 41.2,
   "text": "הצפי שלו היה הרבה יותר ורוד ממה שקרה במציאות."
  },
  {
   "start": 42.78,
   "end": 46.6,
   "text": "במציאות הרווחים לא כל כך היו מסעירים,"
  },
  {
   "start": 47.58,
   "end": 48.6,
   "text": "אם נגיד בלשון עדינה."
  },
  {
   "start": 50.26,
   "end": 51.92,
   "text": "ועתה אין לו כסף להחזיר את ההלוואה."
  },
  {
   "start": 53.42,
   "end": 54.16,
   "text": "ערב טוב, יוהן."
  },
  {
   "start": 55.04,
   "end": 55.62,
   "text": "הקול הקפיץ אותו."
  },
  {
   "start": 57.12,
   "end": 59.4,
   "text": "הקול הזה היה שייך לתדאוס,"
  },
  {
   "start": 60.24,
   "end": 60.92,
   "text": "הכומר של פראג,"
  },
  {
   "start": 62.1,
   "end": 63.36,
   "text": "שונא היהודים המושבע."
  },
  {
   "start": 64.56,
   "end": 66.4,
   "text": "מה הוא רוצה ממני? חלפה מחשבה במוחו."
  },
  {
   "start": 67.9,
   "end": 68.66,
   "text": "והכומר בא,"
  },
  {
   "start": 69.4,
   "end": 69.92,
   "text": "והוא אמר לו, תראה,"
  },
  {
   "start": 71.16,
   "end": 72.34,
   "text": "הרי יש לך חובות, יש לך צרות."
  },
  {
   "start": 74.99,
   "end": 75.53,
   "text": "איך תפרע?"
  },
  {
   "start": 76.05,
   "end": 80.47,
   "text": "איך תפרע את הכסף? הרי כולם יודעים שאתה משקוע בחובות, ואתה חייב גם למרדכי שמה, עשו מעתק."
  },
  {
   "start": 81.19,
   "end": 81.39,
   "text": "איך?"
  },
  {
   "start": 82.05,
   "end": 82.99,
   "text": "איך תיפטר מהכסף?"
  },
  {
   "start": 83.85,
   "end": 84.43,
   "text": "מה תעשה?"
  },
  {
   "start": 84.87,
   "end": 87.17,
   "text": "הרי כל משפט שיהיה, אם הוא ירצה לתבוע אותך, הוא ינצח."
  },
  {
   "start": 88.37,
   "end": 89.73,
   "text": "אבל יש דרך אחת שאתה יכול..."
  },
  {
   "start": 91.57,
   "end": 93.69,
   "text": "להצליח בה ולהיפטר מהחוב."
  },
  {
   "start": 97.7,
   "end": 98.9,
   "text": "ובעל המסעדה שאל איך."
  },
  {
   "start": 100.82,
   "end": 101.72,
   "text": "יוהן שאל איך."
  },
  {
   "start": 102.92,
   "end": 103.86,
   "text": "אמר לו, אם תיפטר,"
  },
  {
   "start": 104.72,
   "end": 106.0,
   "text": "אם תיפטר ממרדכי."
  },
  {
   "start": 107.62,
   "end": 108.72,
   "text": "בוא ניתן לך הצעה."
  },
  {
   "start": 109.84,
   "end": 112.9,
   "text": "אתה תארגן גופה של ילד נוצרי."
  },
  {
   "start": 114.36,
   "end": 117.76,
   "text": "והגופה הזאת תדאג שהיא תונח בפתח הבית של מרדכי."
  },
  {
   "start": 118.92,
   "end": 119.78,
   "text": "והשאר,"
  },
  {
   "start": 121.02,
   "end": 123.66,
   "text": "כבר אני ארגן."
  },
  {
   "start": 124.02,
   "end": 128.82,
   "text": "לא יהיה לו סיכוי לא לו ולכל היהודים ואתה תינצל מכל החובות שלך."
  },
  {
   "start": 134.04,
   "end": 135.66,
   "text": "יוהן, במצב שהוא היה נמצא,"
  },
  {
   "start": 137.18,
   "end": 138.5,
   "text": "לא היה נראות לו ברירות אחרות."
  },
  {
   "start": 152.16,
   "end": 154.88,
   "text": "העגלון הגוי שהסתובב בלילה"
  },
  {
   "start": 155.92,
   "end": 157.94,
   "text": "בה רובע היהודי לא משך תשומת לב."
  },
  {
   "start": 159.48,
   "end": 160.84,
   "text": "הוא חיפש את הבית של מרדכי."
  },
  {
   "start": 163.11,
   "end": 164.81,
   "text": "כעבור מספר דקות הוא הגיע אל הבית"
  },
  {
   "start": 166.93,
   "end": 169.45,
   "text": "והמתין בשקט בחוץ לרדת הלילה."
  },
  {
   "start": 175.24,
   "end": 175.8,
   "text": "הלילה ירד,"
  },
  {
   "start": 178.89,
   "end": 180.85,
   "text": "והגוי מתקרב אל ביתו של מרדכי."
  },
  {
   "start": 182.09,
   "end": 182.73,
   "text": "הוא לא שם לב"
  },
  {
   "start": 183.65,
   "end": 184.65,
   "text": "שעל חומות הגטו"
  },
  {
   "start": 185.51,
   "end": 189.99,
   "text": "עומדת לה דמות שסוקרת את כל רחובות הגטו היהודי."
  },
  {
   "start": 193.53,
   "end": 194.99,
   "text": "הגוי מתקרב אל ביתו של מרדכי,"
  },
  {
   "start": 198.55,
   "end": 199.81,
   "text": "והוא לא שם לב שאותה דמות"
  },
  {
   "start": 202.16,
   "end": 202.96,
   "text": "רצה לעברו."
  },
  {
   "start": 213.32,
   "end": 215.9,
   "text": "לפתע צץ לפניו אדם."
  },
  {
   "start": 218.32,
   "end": 220.86,
   "text": "עומדת לפניו דמות ענקית של אדם."
  },
  {
   "start": 222.0,
   "end": 222.72,
   "text": "דמות מפחידה."
  },
  {
   "start": 226.08,
   "end": 226.98,
   "text": "הוא רוצה להזיז אותה,"
  },
  {
   "start": 228.44,
   "end": 230.14,
   "text": "אבל אז אותה דמות מתחילה להכות אותו."
  },
  {
   "start": 231.34,
   "end": 231.9,
   "text": "והגוי הזה,"
  },
  {
   "start": 233.36,
   "end": 234.26,
   "text": "שגם הוא היה חזק מאוד,"
  },
  {
   "start": 235.0,
   "end": 235.86,
   "text": "מתחיל להילחם."
  },
  {
   "start": 238.27,
   "end": 239.79,
   "text": "הוא עולה מימין ומשמאל,"
  },
  {
   "start": 240.93,
   "end": 241.61,
   "text": "אבל הוא לא מצליח."
  },
  {
   "start": 242.91,
   "end": 243.41,
   "text": "הדמות הזאת,"
  },
  {
   "start": 244.45,
   "end": 246.63,
   "text": "שהצלצה לה באמצע הלילה, יש לה כוח אדירים,"
  },
  {
   "start": 247.41,
   "end": 249.63,
   "text": "והיא מכה אותו מכות עגונות."
  },
  {
   "start": 253.89,
   "end": 254.67,
   "text": "הגוי מתנגד,"
  },
  {
   "start": 255.57,
   "end": 256.49,
   "text": "אבל הוא מוכה קשות."
  },
  {
   "start": 261.23,
   "end": 264.91,
   "text": "ואז הדמות"
  },
  {
   "start": 266.25,
   "end": 272.84,
   "text": "יוסף הגולם קושר אותו וסותם לו את הפה"
  },
  {
   "start": 275.66,
   "end": 281.46,
   "text": "והוא מרים את הגוי וזורק אותו אל תוך העגלה."
  },
  {
   "start": 283.36,
   "end": 285.72,
   "text": "שם בעגלה שוכבת לה נבלתו של בעל חיים,"
  },
  {
   "start": 286.5,
   "end": 287.0,
   "text": "של חזיר."
  },
  {
   "start": 288.96,
   "end": 289.96,
   "text": "ואז הוא קושר את הגוי"
  },
  {
   "start": 291.12,
   "end": 299.84,
   "text": "אל הנבלה והעגלה יוצאת לדרכה עם עגלון חדש,"
  },
  {
   "start": 300.48,
   "end": 301.08,
   "text": "הגולם מפראג."
  },
  {
   "start": 308.18,
   "end": 310.74,
   "text": "מבניין המשטרה של פראג יצאו להם, האנס וקרל,"
  },
  {
   "start": 311.76,
   "end": 314.04,
   "text": "שני שוטרי סיור לתחילת הסיור הלילי שלהם."
  },
  {
   "start": 315.2,
   "end": 318.64,
   "text": "פתאום הם שמים לב איזו עגלה, עגלה חשודה,"
  },
  {
   "start": 319.18,
   "end": 320.36,
   "text": "עומדת לה ליד התחנה."
  },
  {
   "start": 321.92,
   "end": 322.72,
   "text": "הם שומעים קולות,"
  },
  {
   "start": 323.8,
   "end": 324.64,
   "text": "מתקרבים,"
  },
  {
   "start": 327.29,
   "end": 328.97,
   "text": "מגלים פצוע,"
  },
  {
   "start": 329.59,
   "end": 330.13,
   "text": "קשור."
  },
  {
   "start": 331.39,
   "end": 332.27,
   "text": "הם מזעיקים עזרה,"
  },
  {
   "start": 332.95,
   "end": 334.59,
   "text": "באים רופאים, באים עוד שוטרים,"
  },
  {
   "start": 335.69,
   "end": 338.03,
   "text": "והעגלה עם הפצוע מוכנסת למקום מואר."
  },
  {
   "start": 338.63,
   "end": 339.15,
   "text": "מי אתה?"
  },
  {
   "start": 341.91,
   "end": 342.91,
   "text": "שואלים השוטרים."
  },
  {
   "start": 344.19,
   "end": 344.71,
   "text": "תקפו אותי."
  },
  {
   "start": 345.87,
   "end": 346.85,
   "text": "תקפו אותי, מי אתה?"
  },
  {
   "start": 347.43,
   "end": 349.01,
   "text": "אני טבח מהמסעדה של יוהאן."
  },
  {
   "start": 350.57,
   "end": 352.91,
   "text": "אני מוליך בשר ותקפו אותי."
  },
  {
   "start": 356.51,
   "end": 357.25,
   "text": "הקצין החוקר"
  },
  {
   "start": 358.99,
   "end": 359.75,
   "text": "הופך את הנבלה,"
  },
  {
   "start": 361.29,
   "end": 361.81,
   "text": "ולפתע,"
  },
  {
   "start": 362.91,
   "end": 363.55,
   "text": "מתוך הנבלה,"
  },
  {
   "start": 366.3,
   "end": 368.38,
   "text": "גופה של ילד מתבוססת בדם,"
  },
  {
   "start": 371.63,
   "end": 372.79,
   "text": "מתגלגלת להחוצה."
  },
  {
   "start": 379.4,
   "end": 380.2,
   "text": "הטבח נעצר."
  },
  {
   "start": 381.98,
   "end": 382.98,
   "text": "במעצר הוא מספר"
  },
  {
   "start": 383.8,
   "end": 385.88,
   "text": "איך יוהאן רצה להיפטר מהאויב שלו,"
  },
  {
   "start": 386.9,
   "end": 387.96,
   "text": "וארגן עלילת דם."
  },
  {
   "start": 399.99,
   "end": 400.85,
   "text": "הוא נתפס,"
  },
  {
   "start": 401.69,
   "end": 402.59,
   "text": "יוהאן נתפס,"
  },
  {
   "start": 403.57,
   "end": 404.17,
   "text": "והיהודים,"
  },
  {
   "start": 405.07,
   "end": 405.85,
   "text": "היהודים ניצלו."
  }
 ]
}