{
 "disc": "17יח- המהרל מפראג",
 "track": "Track01",
 "duration": 1031.112,
 "segments": [
  {
   "start": 7.75,
   "end": 9.43,
   "text": "וורמייזה שבגרמניה."
  },
  {
   "start": 10.95,
   "end": 12.01,
   "text": "יהודי בשם רבי חיים"
  },
  {
   "start": 12.83,
   "end": 15.31,
   "text": "לומד עם שלושת בניו המחוננים."
  },
  {
   "start": 16.41,
   "end": 16.95,
   "text": "לומד תורה."
  },
  {
   "start": 19.08,
   "end": 21.24,
   "text": "בתום הלימוד, כבר שעת ערב מאוחרת,"
  },
  {
   "start": 22.82,
   "end": 25.46,
   "text": "כל הבנים יושבים ממתינים דרוכים."
  },
  {
   "start": 26.6,
   "end": 28.9,
   "text": "הערב ייקבע עתידם."
  },
  {
   "start": 30.48,
   "end": 35.14,
   "text": "הערב יוכרע גורלם."
  },
  {
   "start": 37.66,
   "end": 40.24,
   "text": "הם לפני מספר ימים ביקשו מאבא, ביקשו מאמא,"
  },
  {
   "start": 40.82,
   "end": 42.4,
   "text": "לאפשר להם לעבור לפולין,"
  },
  {
   "start": 43.16,
   "end": 43.84,
   "text": "ללמוד תורה,"
  },
  {
   "start": 45.4,
   "end": 47.16,
   "text": "לתת דרור לכישוריהם,"
  },
  {
   "start": 48.74,
   "end": 50.84,
   "text": "ללכת וללמוד ולגדול בתורה,"
  },
  {
   "start": 51.82,
   "end": 52.52,
   "text": "בישיבה"
  },
  {
   "start": 53.5,
   "end": 56.0,
   "text": "של רבי שלמה לוריא הגדול המהרשל,"
  },
  {
   "start": 59.34,
   "end": 61.54,
   "text": "ועתי מחכים בכיליון עיניים"
  },
  {
   "start": 64.16,
   "end": 67.56,
   "text": "לשמוע מה אומר אבא, מה אומרת אמא."
  },
  {
   "start": 70.04,
   "end": 72.26,
   "text": "עיניו של רבך עם האבא"
  },
  {
   "start": 73.8,
   "end": 76.44,
   "text": "היו שמחות מצד אחד ועצובות מאידך."
  },
  {
   "start": 78.42,
   "end": 80.42,
   "text": "הוא אמר להם, תקשיבו, בניי היקרים, בניי האהובים,"
  },
  {
   "start": 81.02,
   "end": 82.16,
   "text": "בחנו את כל האפשרויות."
  },
  {
   "start": 86.39,
   "end": 87.77,
   "text": "ישבנו אמא שלכם ואני."
  },
  {
   "start": 88.89,
   "end": 90.39,
   "text": "אתם יודעים שאמא כל חייה."
  },
  {
   "start": 91.15,
   "end": 94.29,
   "text": "אמא שלכם הצדקת מתפללת לבנים צדיקים בני תורה."
  },
  {
   "start": 95.55,
   "end": 97.59,
   "text": "אבל לשלוח את כולכם לפולין אי אפשר."
  },
  {
   "start": 99.17,
   "end": 100.79,
   "text": "לפיכך החלטנו"
  },
  {
   "start": 101.95,
   "end": 103.99,
   "text": "שאחד מכם יישאר כאן איתנו."
  },
  {
   "start": 108.06,
   "end": 108.62,
   "text": "הם נדרכו."
  },
  {
   "start": 111.93,
   "end": 112.21,
   "text": "מי זה?"
  },
  {
   "start": 112.83,
   "end": 113.29,
   "text": "מי יישאר?"
  },
  {
   "start": 116.22,
   "end": 116.74,
   "text": "והמשיך"
  },
  {
   "start": 117.82,
   "end": 118.84,
   "text": "רבי חיים ואמר,"
  },
  {
   "start": 118.88,
   "end": 121.16,
   "text": "הבן הבכור בצלאל,"
  },
  {
   "start": 121.84,
   "end": 122.86,
   "text": "בצלאל יישאר עמנו"
  },
  {
   "start": 123.96,
   "end": 125.82,
   "text": "ושני הבנים האחרים אתם טיסו לפולין."
  },
  {
   "start": 127.46,
   "end": 127.88,
   "text": "האחים"
  },
  {
   "start": 128.92,
   "end": 132.52,
   "text": "ששפר עליהם גורליו התאמצו להסתיר את השמחה שלהם"
  },
  {
   "start": 133.24,
   "end": 136.04,
   "text": "כי לא היה נעים להם אם ראו את אחיהם הבכור,"
  },
  {
   "start": 137.12,
   "end": 138.58,
   "text": "איך הוא משפיל את ראשו בשתיקה,"
  },
  {
   "start": 141.3,
   "end": 142.98,
   "text": "אך כאב לו האובדן,"
  },
  {
   "start": 144.8,
   "end": 147.16,
   "text": "ההפסד של העלייה בתורה שהוא יכול לעלות,"
  },
  {
   "start": 147.68,
   "end": 148.46,
   "text": "שיכול להתעלות,"
  },
  {
   "start": 148.88,
   "end": 151.02,
   "text": "שיכול להתקדם ונמנע ממנו."
  },
  {
   "start": 152.9,
   "end": 155.82,
   "text": "לא היה לו דבר שהוא כל כך אהב בחייו כמו התורה,"
  },
  {
   "start": 156.98,
   "end": 157.64,
   "text": "ועכשיו כמו"
  },
  {
   "start": 158.7,
   "end": 159.84,
   "text": "שמו לו מחסום."
  },
  {
   "start": 167.7,
   "end": 168.18,
   "text": "בצלאל,"
  },
  {
   "start": 169.1,
   "end": 169.66,
   "text": "אמר האבא,"
  },
  {
   "start": 170.4,
   "end": 171.32,
   "text": "אני יודע שאתה מצטער,"
  },
  {
   "start": 172.94,
   "end": 173.82,
   "text": "אבל אנחנו מבקשים ממך,"
  },
  {
   "start": 174.54,
   "end": 176.16,
   "text": "מבקשים ממך להשתדל בשבילנו."
  },
  {
   "start": 177.08,
   "end": 178.8,
   "text": "חסד, כיבוד הורים,"
  },
  {
   "start": 179.38,
   "end": 180.66,
   "text": "אין מי שיעזור לנו בבית."
  },
  {
   "start": 181.24,
   "end": 182.48,
   "text": "אין מי שיעזור לנו בבית."
  },
  {
   "start": 185.75,
   "end": 186.13,
   "text": "אבא,"
  },
  {
   "start": 187.11,
   "end": 188.53,
   "text": "אבא אמר בצלאל בהתרגשות"
  },
  {
   "start": 190.25,
   "end": 192.59,
   "text": "אני אשאר עמכם, כמו שביקשתם."
  },
  {
   "start": 193.55,
   "end": 195.93,
   "text": "אם זהו רצון השם, את זה אני אעשה."
  },
  {
   "start": 196.91,
   "end": 197.23,
   "text": "ו..."
  },
  {
   "start": 199.01,
   "end": 200.09,
   "text": "והוא לא יכל להתאפק."
  },
  {
   "start": 203.2,
   "end": 204.74,
   "text": "הוא רץ במהירות אל החדר שלו,"
  },
  {
   "start": 205.42,
   "end": 206.62,
   "text": "כדי שלא יראו אותו בוכה."
  },
  {
   "start": 213.97,
   "end": 215.25,
   "text": "כדי שלא יראו אותו בוכה."
  },
  {
   "start": 216.39,
   "end": 218.81,
   "text": "קול בכי נשמע מפינת החדר."
  },
  {
   "start": 220.33,
   "end": 220.77,
   "text": "אמא,"
  },
  {
   "start": 221.53,
   "end": 227.55,
   "text": "אימא שבוכה על שאין לה אפשרות לתת לבן שלה את מה שחשקה נפשו."
  },
  {
   "start": 228.57,
   "end": 233.73,
   "text": "אימא שבוכה שהיא לא יכולה לאפשר לבן שלה לגדול בתורה."
  },
  {
   "start": 234.49,
   "end": 254.61,
   "text": "יש כאב גדול יותר מזה מאחיו של בצלאל"
  },
  {
   "start": 256.05,
   "end": 257.25,
   "text": "עושים חיל בישיבה בפולין."
  },
  {
   "start": 260.42,
   "end": 262.86,
   "text": "ובצלאל, בצלאל שהיה המוכשר מביניהם,"
  },
  {
   "start": 264.98,
   "end": 265.52,
   "text": "היה בעל"
  },
  {
   "start": 266.26,
   "end": 266.82,
   "text": "הכישורים"
  },
  {
   "start": 268.34,
   "end": 269.18,
   "text": "הגדולים ביותר"
  },
  {
   "start": 269.98,
   "end": 272.18,
   "text": "הוא דווקא זה שנשאר בבית,"
  },
  {
   "start": 273.32,
   "end": 274.64,
   "text": "מקיים מצוות כיבוד הורים,"
  },
  {
   "start": 275.5,
   "end": 278.38,
   "text": "ובערבים לומד תורה עם אבא שלו בשמחה."
  },
  {
   "start": 281.35,
   "end": 281.85,
   "text": "הוא ויתר"
  },
  {
   "start": 283.49,
   "end": 284.47,
   "text": "לשם שמיים נטו."
  },
  {
   "start": 287.8,
   "end": 288.34,
   "text": "אבל את התורה,"
  },
  {
   "start": 289.12,
   "end": 289.96,
   "text": "את אהבת התורה,"
  },
  {
   "start": 291.18,
   "end": 292.12,
   "text": "הוא לא מפסיק לרגע."
  },
  {
   "start": 294.12,
   "end": 294.52,
   "text": "וככה,"
  },
  {
   "start": 295.12,
   "end": 295.98,
   "text": "כך עוברות להם השנים."
  },
  {
   "start": 300.52,
   "end": 300.94,
   "text": "יום אחד,"
  },
  {
   "start": 303.27,
   "end": 305.09,
   "text": "מגיע מברק אל ביתו של רב חיים."
  },
  {
   "start": 305.09,
   "end": 309.19,
   "text": "שני הבנים אחרי שנים חוזרים מפולין מהישיבה לביקור"
  },
  {
   "start": 312.48,
   "end": 313.5,
   "text": "וההכנות בבית,"
  },
  {
   "start": 316.18,
   "end": 317.7,
   "text": "ההכנות בבית היו בעיצומן."
  },
  {
   "start": 321.04,
   "end": 322.64,
   "text": "כולם עסוקים, כולם מוכנים,"
  },
  {
   "start": 323.62,
   "end": 325.94,
   "text": "כולם דרוכים, מתי יבואו, מתי יבואו שני הבנים?"
  },
  {
   "start": 327.2,
   "end": 328.54,
   "text": "לפתע נשמע קולו של העגלון,"
  },
  {
   "start": 331.56,
   "end": 331.84,
   "text": "שלום,"
  },
  {
   "start": 332.82,
   "end": 333.24,
   "text": "שלום רב,"
  },
  {
   "start": 334.22,
   "end": 343.87,
   "text": "הבאתי לכם ההורים הנרגשים,"
  },
  {
   "start": 344.47,
   "end": 346.35,
   "text": "שחיכו כל כך הרבה ימים מאז המברק,"
  },
  {
   "start": 347.05,
   "end": 351.78,
   "text": "יצאו החוצה במרוצה ופגשו את הילדים שלהם."
  },
  {
   "start": 352.76,
   "end": 356.02,
   "text": "את הפגישה אי אפשר לתאר במילים, אני לא אכפיר במילים לתאר."
  },
  {
   "start": 356.86,
   "end": 357.6,
   "text": "איזו שמחה,"
  },
  {
   "start": 358.3,
   "end": 358.6,
   "text": "איזה חיבוקים."
  },
  {
   "start": 360.62,
   "end": 361.1,
   "text": "בצלאל,"
  },
  {
   "start": 361.66,
   "end": 363.2,
   "text": "בצלאל האח הגדול אף גם הוא יצא החוצה."
  },
  {
   "start": 364.78,
   "end": 365.92,
   "text": "מביט, רואה את שני אחיו בגרו,"
  },
  {
   "start": 367.18,
   "end": 368.64,
   "text": "בחורי ישיבה של ממש."
  },
  {
   "start": 372.77,
   "end": 373.97,
   "text": "ההתרגשות הייתה עצומה."
  },
  {
   "start": 376.95,
   "end": 378.03,
   "text": "המשפחה המאוחדת"
  },
  {
   "start": 378.61,
   "end": 379.63,
   "text": "ישבה נרגשת"
  },
  {
   "start": 380.43,
   "end": 381.87,
   "text": "סביב השולחן המשפחתי,"
  },
  {
   "start": 382.69,
   "end": 383.07,
   "text": "ביחד,"
  },
  {
   "start": 383.75,
   "end": 384.27,
   "text": "כולם,"
  },
  {
   "start": 385.21,
   "end": 386.29,
   "text": "אחרי כל כך הרבה שנים,"
  },
  {
   "start": 401.47,
   "end": 403.79,
   "text": "בצלאל ישב והביט באחיו."
  },
  {
   "start": 405.29,
   "end": 406.55,
   "text": "בני תורה של ממש."
  },
  {
   "start": 407.51,
   "end": 409.21,
   "text": "הסגנון הדיבור שלהם, ההתנהגות,"
  },
  {
   "start": 409.91,
   "end": 412.73,
   "text": "הייתה של בחורים שחסו בצל התורה הקדושה,"
  },
  {
   "start": 415.32,
   "end": 416.46,
   "text": "ומבלי משים ככה,"
  },
  {
   "start": 417.28,
   "end": 418.2,
   "text": "בלי שאף אחד רואה,"
  },
  {
   "start": 419.4,
   "end": 424.96,
   "text": "התגנבה לה דמעה קלה וחלה מתגלגלת לה במורד לחיו."
  },
  {
   "start": 427.92,
   "end": 428.64,
   "text": "איש לא שם לב,"
  },
  {
   "start": 430.42,
   "end": 431.52,
   "text": "למעט אבא."
  },
  {
   "start": 433.18,
   "end": 434.1,
   "text": "רב חיים שראה"
  },
  {
   "start": 437.68,
   "end": 441.0,
   "text": "ראה את העיניים הנוצצות של בצלאל,"
  },
  {
   "start": 441.66,
   "end": 442.36,
   "text": "לא מקנאה,"
  },
  {
   "start": 444.6,
   "end": 445.6,
   "text": "לא מקנאה."
  },
  {
   "start": 447.06,
   "end": 448.46,
   "text": "לפתע הרב חיים האבא קם,"
  },
  {
   "start": 448.92,
   "end": 450.22,
   "text": "דפק על השולחן ואמר,"
  },
  {
   "start": 450.86,
   "end": 451.44,
   "text": "בצלאל,"
  },
  {
   "start": 452.12,
   "end": 452.8,
   "text": "בני אהובי,"
  },
  {
   "start": 453.62,
   "end": 455.5,
   "text": "תדע לך, מסירות הנפש שלך,"
  },
  {
   "start": 456.38,
   "end": 460.92,
   "text": "ההקרבה שלך, החסד שעשית ואתה עושה איתנו,"
  },
  {
   "start": 461.62,
   "end": 463.64,
   "text": "בזכות כל אלו אני מברך אותך,"
  },
  {
   "start": 464.4,
   "end": 468.44,
   "text": "שתזכה לבנים, שיעירו את כל העולם היהודי,"
  },
  {
   "start": 469.06,
   "end": 474.98,
   "text": "לבנים שירבטו לך את הדרך לגן עדן בתורה וחסד."
  },
  {
   "start": 497.17,
   "end": 500.41,
   "text": "לפעמים אנחנו רואים דברים לכאורה לא הגיוניים."
  },
  {
   "start": 501.23,
   "end": 502.07,
   "text": "הרי בצלאל,"
  },
  {
   "start": 502.77,
   "end": 506.61,
   "text": "בצלאל הוא המוכשר ביותר. הוא זה שראוי ללכת ללמוד בישיבה,"
  },
  {
   "start": 507.41,
   "end": 508.59,
   "text": "והוא נשאר בבית."
  },
  {
   "start": 509.25,
   "end": 510.63,
   "text": "ואתה שואל את עצמך, יש צדק?"
  },
  {
   "start": 511.21,
   "end": 512.87,
   "text": "עוצרים לו, עוצרים לו את הקידום,"
  },
  {
   "start": 513.19,
   "end": 513.91,
   "text": "עוצרים לו את המסלול,"
  },
  {
   "start": 514.45,
   "end": 515.15,
   "text": "עוצרים לו את הדרך."
  },
  {
   "start": 517.72,
   "end": 518.92,
   "text": "אבל אנחנו חושבים כך,"
  },
  {
   "start": 519.68,
   "end": 521.8,
   "text": "ויושב במרומים וחושב אחרת."
  },
  {
   "start": 523.48,
   "end": 526.0,
   "text": "ואנחנו לא תמיד מבינים, לא תמיד רואים,"
  },
  {
   "start": 526.82,
   "end": 529.18,
   "text": "איך למעשה מי שהולך בדרך השם,"
  },
  {
   "start": 529.84,
   "end": 530.46,
   "text": "בסוף הוא מרוויח."
  },
  {
   "start": 531.08,
   "end": 532.12,
   "text": "אבל בסוף הוא מרוויח."
  },
  {
   "start": 532.76,
   "end": 533.62,
   "text": "בדרך אתה לא רואה."
  },
  {
   "start": 536.46,
   "end": 538.24,
   "text": "כשהאבא ברך את בצלאל,"
  },
  {
   "start": 538.68,
   "end": 539.56,
   "text": "ברך אותו בבנים,"
  },
  {
   "start": 540.1,
   "end": 541.38,
   "text": "שיעירו את העולם."
  },
  {
   "start": 542.94,
   "end": 544.3,
   "text": "אף אחד עדיין לא ראה את הסוף,"
  },
  {
   "start": 548.26,
   "end": 550.38,
   "text": "אבל היום, כשאנחנו רואים מי יצא,"
  },
  {
   "start": 551.5,
   "end": 553.84,
   "text": "אלו ילדים נולדו לבצלאל."
  },
  {
   "start": 554.88,
   "end": 556.48,
   "text": "יודעים שהדרש שלו בגן עדן סלולה,"
  },
  {
   "start": 558.48,
   "end": 560.12,
   "text": "כי יש דברים שלא תמיד אנחנו מבינים."
  },
  {
   "start": 561.5,
   "end": 564.58,
   "text": "אבל צריך לדעת שמסירות נפש, שחסד,"
  },
  {
   "start": 565.38,
   "end": 566.78,
   "text": "של ללכת בדרך השם,"
  },
  {
   "start": 567.76,
   "end": 568.76,
   "text": "לעולם אתה לא מפסיד."
  },
  {
   "start": 569.6,
   "end": 570.42,
   "text": "תמיד אתה מרוויח."
  },
  {
   "start": 571.58,
   "end": 572.18,
   "text": "אולי לא בהתחלה,"
  },
  {
   "start": 573.28,
   "end": 573.9,
   "text": "אולי לא באמצע,"
  },
  {
   "start": 574.56,
   "end": 575.2,
   "text": "אבל בסוף"
  },
  {
   "start": 579.2,
   "end": 579.88,
   "text": "יצא לגדל,"
  },
  {
   "start": 581.12,
   "end": 581.8,
   "text": "נשא אישה,"
  },
  {
   "start": 583.2,
   "end": 584.36,
   "text": "ונדו להם שלושה ילדים."
  },
  {
   "start": 586.1,
   "end": 587.04,
   "text": "כל שלושת הילדים"
  },
  {
   "start": 587.66,
   "end": 592.56,
   "text": "כולם צמחו להיות גדולי ישראל בדיוק כפי הברכה שהוא קיבל, ויותר."
  },
  {
   "start": 593.42,
   "end": 594.66,
   "text": "כולם גדולי ישראל."
  },
  {
   "start": 595.3,
   "end": 596.82,
   "text": "יותר מאוחר, בלית ברירה,"
  },
  {
   "start": 597.68,
   "end": 601.96,
   "text": "עזבו רבי בצלאל ומשפחתו את ורומייזה, עיר הולדתו,"
  },
  {
   "start": 602.48,
   "end": 607.88,
   "text": "בגלל פרעות שהיו ביהודים, היה תקופה קשה לעם ישראל. כל זמן פרעות, עלילות דם, פוגרומים,"
  },
  {
   "start": 608.28,
   "end": 609.88,
   "text": "רציחות, ממש היה קשה."
  },
  {
   "start": 610.62,
   "end": 613.52,
   "text": "והם נאלצו, בעקב גזירת גירוש, לעבור לפוזנה."
  },
  {
   "start": 615.76,
   "end": 617.82,
   "text": "ואז הם שם התאקלמו בקהילה של פוזנה."
  },
  {
   "start": 620.78,
   "end": 623.32,
   "text": "כך זה נמשך עד שנת רע ב,"
  },
  {
   "start": 628.15,
   "end": 628.45,
   "text": "ערב פסח."
  },
  {
   "start": 630.27,
   "end": 632.05,
   "text": "שנת רע ב,"
  },
  {
   "start": 634.66,
   "end": 635.08,
   "text": "כולם,"
  },
  {
   "start": 636.3,
   "end": 639.2,
   "text": "כלומר כולם זה כל הקהילה היהודית עסוקים בהכנות לחג."
  },
  {
   "start": 641.06,
   "end": 641.62,
   "text": "חג הפסח."
  },
  {
   "start": 644.91,
   "end": 645.73,
   "text": "גם במנזר,"
  },
  {
   "start": 646.47,
   "end": 647.99,
   "text": "במנזר הסמוך בפוזנא,"
  },
  {
   "start": 649.31,
   "end": 650.85,
   "text": "התנהלו ההכנות בקתחתנות."
  },
  {
   "start": 653.85,
   "end": 654.17,
   "text": "למה?"
  },
  {
   "start": 654.85,
   "end": 655.65,
   "text": "לא לחג הפסח."
  },
  {
   "start": 656.51,
   "end": 658.61,
   "text": "לארגן עלילת דם כנגד היהודים."
  },
  {
   "start": 660.17,
   "end": 670.19,
   "text": "לצורך כך נזכר בריון גוי שיכור שתפקידו היה לרצוח ילד נוצרי ואת גופתו לשתול בבית"
  },
  {
   "start": 670.83,
   "end": 672.61,
   "text": "של אחד מחשובי הקהילה היהודית."
  },
  {
   "start": 673.87,
   "end": 674.21,
   "text": "ואז,"
  },
  {
   "start": 675.07,
   "end": 676.15,
   "text": "אז שתימצא הגופה,"
  },
  {
   "start": 676.93,
   "end": 680.89,
   "text": "יהיה זהות לתחילת פרעות ורציחות ביהודים."
  },
  {
   "start": 683.28,
   "end": 687.78,
   "text": "הבריון קיבל סכום כסף התחלתי וההבטחה שיהיה לו מקום בגן עדן"
  },
  {
   "start": 688.72,
   "end": 689.28,
   "text": "אם הוא יצליח"
  },
  {
   "start": 691.0,
   "end": 691.6,
   "text": "במשימה."
  },
  {
   "start": 692.38,
   "end": 693.76,
   "text": "והוא יצא לדרכו,"
  },
  {
   "start": 694.52,
   "end": 695.36,
   "text": "משחרר לטרף."
  },
  {
   "start": 700.53,
   "end": 701.15,
   "text": "ליל הסדר."
  },
  {
   "start": 701.73,
   "end": 703.81,
   "text": "ליל הסדר בבית משפחת רבי בצלאל בפוזנא."
  },
  {
   "start": 704.75,
   "end": 707.29,
   "text": "רבי בצלאל תפס לו מעמד נכבד מאוד בקהילה."
  },
  {
   "start": 708.37,
   "end": 709.27,
   "text": "כולם אהבו אותו,"
  },
  {
   "start": 709.83,
   "end": 710.93,
   "text": "כולם כיבדו אותו."
  },
  {
   "start": 712.59,
   "end": 715.41,
   "text": "ליל הסדר שפע שמחה, שפע קדושה,"
  },
  {
   "start": 718.12,
   "end": 719.86,
   "text": "והנה כך באמצע הסדר, לפתע,"
  },
  {
   "start": 720.54,
   "end": 721.54,
   "text": "באמצע קריאת האגדה,"
  },
  {
   "start": 722.6,
   "end": 726.76,
   "text": "אשתו הרבנית של רבי בצלאל נאנקת לה מכאבים."
  },
  {
   "start": 728.12,
   "end": 730.16,
   "text": "אבל לא סתם כאבים, צירים."
  },
  {
   "start": 731.52,
   "end": 735.4,
   "text": "צירי לידה שהולכים ונהיים דחופים."
  },
  {
   "start": 738.0,
   "end": 740.56,
   "text": "הזעקה שפרצה מגרונה הייתה האות."
  },
  {
   "start": 741.18,
   "end": 744.86,
   "text": "רבי בצלאל הבין, אין זמן, הוא נבהל, הוא רץ החוצה."
  },
  {
   "start": 745.92,
   "end": 746.96,
   "text": "אני הולך להזעיק את המילדת."
  },
  {
   "start": 752.14,
   "end": 753.18,
   "text": "בצלאל יצא בריצה,"
  },
  {
   "start": 753.86,
   "end": 754.3,
   "text": "אין זמן."
  },
  {
   "start": 755.12,
   "end": 755.44,
   "text": "אני חייב,"
  },
  {
   "start": 756.2,
   "end": 756.78,
   "text": "חייב להזעיק"
  },
  {
   "start": 757.86,
   "end": 759.3,
   "text": "את המילדת לפני שיהיה מאוחר."
  },
  {
   "start": 761.9,
   "end": 763.48,
   "text": "בחוץ הלילה עטף את רחובות פוזנא."
  },
  {
   "start": 763.48,
   "end": 766.48,
   "text": "רבי צלע בצלאל רץ בכל כוחו,"
  },
  {
   "start": 767.4,
   "end": 768.18,
   "text": "רץ ורץ,"
  },
  {
   "start": 769.14,
   "end": 769.64,
   "text": "ולפתע,"
  },
  {
   "start": 770.48,
   "end": 771.12,
   "text": "לפתע לפניו,"
  },
  {
   "start": 772.2,
   "end": 772.88,
   "text": "פסעה לדמות,"
  },
  {
   "start": 773.8,
   "end": 774.06,
   "text": "דמות מגודלת,"
  },
  {
   "start": 776.28,
   "end": 777.22,
   "text": "נושאת שק,"
  },
  {
   "start": 778.1,
   "end": 780.12,
   "text": "ובתוכו סוד אפל ונורא."
  },
  {
   "start": 781.84,
   "end": 783.0,
   "text": "זה היה בריון הגוי,"
  },
  {
   "start": 784.4,
   "end": 787.32,
   "text": "שהצליח ורצח ילד, ילד נוצרי,"
  },
  {
   "start": 787.8,
   "end": 788.7,
   "text": "בפקודת הכומר,"
  },
  {
   "start": 788.7,
   "end": 794.48,
   "text": "ועכשיו היה בדרכו אל הבית של רבי בצלאל"
  },
  {
   "start": 795.54,
   "end": 797.56,
   "text": "להניח את הגופה בחצר שלו."
  },
  {
   "start": 800.08,
   "end": 803.88,
   "text": "והפריון הזה פתאום רואה את בצלאל רץ לעברו,"
  },
  {
   "start": 804.4,
   "end": 805.16,
   "text": "רץ לכיוון שלו."
  },
  {
   "start": 806.44,
   "end": 808.54,
   "text": "הם יודעים עליי, הוא חשב, הם יודעים עליי,"
  },
  {
   "start": 809.28,
   "end": 811.16,
   "text": "וחש בפחד פתאומי שלא עופק את ליבו."
  },
  {
   "start": 811.98,
   "end": 812.52,
   "text": "זעקרה,"
  },
  {
   "start": 814.68,
   "end": 815.18,
   "text": "והוא פנה,"
  },
  {
   "start": 816.32,
   "end": 817.18,
   "text": "והחל לברוח,"
  },
  {
   "start": 818.28,
   "end": 818.92,
   "text": "ובורח."
  },
  {
   "start": 819.74,
   "end": 820.52,
   "text": "ובצלאל רץ"
  },
  {
   "start": 821.68,
   "end": 823.76,
   "text": "והוא בטוח שהוא רץ אחריו, הוא בורח."
  },
  {
   "start": 824.82,
   "end": 825.74,
   "text": "והגוי רץ עם השק,"
  },
  {
   "start": 827.2,
   "end": 828.2,
   "text": "ובצלאל רץ אחריו."
  },
  {
   "start": 835.19,
   "end": 835.87,
   "text": "שוטרי פוזנא"
  },
  {
   "start": 836.65,
   "end": 838.93,
   "text": "שעסקו בסיורים בלילות,"
  },
  {
   "start": 841.65,
   "end": 843.91,
   "text": "אותו גוי שרץ עם השק עליו רואה תשומת לב."
  },
  {
   "start": 844.47,
   "end": 845.33,
   "text": "הם חשדו משהו קורה."
  },
  {
   "start": 846.31,
   "end": 847.37,
   "text": "הם הצטרפו אף הם למרדף,"
  },
  {
   "start": 848.03,
   "end": 849.49,
   "text": "כולם רודפים אחרי הבריון הרוצח,"
  },
  {
   "start": 853.94,
   "end": 855.68,
   "text": "ועד מהרה הוא היה מוטל על הרצפה,"
  },
  {
   "start": 857.38,
   "end": 857.88,
   "text": "כבול באזיקים."
  },
  {
   "start": 862.14,
   "end": 863.22,
   "text": "השוטרים פתחו את השק"
  },
  {
   "start": 866.38,
   "end": 866.98,
   "text": "בתקופת ילד"
  },
  {
   "start": 869.26,
   "end": 870.42,
   "text": "בצבצה לה ויצאה."
  },
  {
   "start": 872.34,
   "end": 875.64,
   "text": "גודל הזוועה נתגלתה לעיני השוטרים הנדהמים."
  },
  {
   "start": 879.04,
   "end": 884.2,
   "text": "ילד שנרצח על לא עוול בכפו בגלל שנאה,"
  },
  {
   "start": 884.72,
   "end": 885.7,
   "text": "שנאה עזה ליהודים."
  },
  {
   "start": 888.44,
   "end": 892.26,
   "text": "דבר כזה יכל לחולל מהלומת מוות לקהילה היהודית בפוזנה."
  },
  {
   "start": 894.28,
   "end": 896.04,
   "text": "קהילת פוזנה ניצלה בורח פלא."
  },
  {
   "start": 897.08,
   "end": 900.08,
   "text": "בינתיים רבי בצלאל ממשיך פריצה שלו ובכלל לא רץ אחרי הבריון."
  },
  {
   "start": 901.0,
   "end": 905.14,
   "text": "הוא ראה שהוא בורח ממנו, ראה שתופסים אותו, והוא ממשיך כבר בריצה עכשיו."
  },
  {
   "start": 907.38,
   "end": 910.4,
   "text": "מספר רגעים אחר כך הוא חזר לכיוון הבית שלו עם המיילדת."
  },
  {
   "start": 912.48,
   "end": 913.88,
   "text": "וזמן קצר אחר כך"
  },
  {
   "start": 915.8,
   "end": 918.46,
   "text": "פישרה לו המיילדת שנולד לו בן."
  },
  {
   "start": 921.22,
   "end": 924.34,
   "text": "נולד לו ילד שבלידה שלו"
  },
  {
   "start": 924.96,
   "end": 926.42,
   "text": "הוא הציל את כל קהילת פוזנה."
  },
  {
   "start": 928.12,
   "end": 929.46,
   "text": "ילד שבלידה שלו"
  },
  {
   "start": 930.42,
   "end": 931.12,
   "text": "הוא גרם."
  },
  {
   "start": 933.42,
   "end": 936.2,
   "text": "לתפיסת רוצח ולהצלת"
  },
  {
   "start": 937.26,
   "end": 938.8,
   "text": "אלפים של יהודים."
  },
  {
   "start": 942.1,
   "end": 945.6,
   "text": "לילד הוא קרא בשם יהודה ליבו לייב."
  },
  {
   "start": 951.87,
   "end": 958.74,
   "text": "ואכן, בצלאל זכה לא רק לשלושה ילדים מיוחדים, גדולי ישראל,"
  },
  {
   "start": 959.62,
   "end": 960.94,
   "text": "אלא הוא זכה בזכות החסד,"
  },
  {
   "start": 961.76,
   "end": 963.04,
   "text": "בזכות כיבוד ההורים,"
  },
  {
   "start": 963.58,
   "end": 965.3,
   "text": "בזכות הוויתור לאחים שלו."
  },
  {
   "start": 966.34,
   "end": 967.6,
   "text": "הוא זכה לנשמה,"
  },
  {
   "start": 968.32,
   "end": 969.22,
   "text": "נשמה מיוחדת,"
  },
  {
   "start": 970.14,
   "end": 973.04,
   "text": "שחוצבה מגבהים עצומים,"
  },
  {
   "start": 987.12,
   "end": 988.02,
   "text": "וילד גדל,"
  },
  {
   "start": 989.62,
   "end": 990.3,
   "text": "וגדל,"
  },
  {
   "start": 991.38,
   "end": 992.68,
   "text": "והתעצם בתורה,"
  },
  {
   "start": 993.88,
   "end": 996.22,
   "text": "בנגלה ובנסתר."
  },
  {
   "start": 998.12,
   "end": 999.84,
   "text": "והוא נהיה לאותה דמות פלאית,"
  },
  {
   "start": 1002.64,
   "end": 1005.3,
   "text": "ששמה התפרסם מקצה העולם ועד קצהו,"
  },
  {
   "start": 1006.76,
   "end": 1008.0,
   "text": "בשם המהרל מפראג,"
  },
  {
   "start": 1012.61,
   "end": 1015.95,
   "text": "שיום-יום פטירתו עם ההילולה שלו בחי באלול."
  },
  {
   "start": 1018.07,
   "end": 1025.86,
   "text": "אותו מהרל מפראג שזכה להגן על עם ישראל,"
  },
  {
   "start": 1026.84,
   "end": 1028.62,
   "text": "שזכה להציל את נשמות ישראל."
  }
 ]
}