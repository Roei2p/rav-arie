{
 "disc": "17יח- המהרל מפראג",
 "track": "Track03",
 "duration": 690.192,
 "segments": [
  {
   "start": 1.68,
   "end": 3.5,
   "text": "ישנה שיטת לימוד,"
  },
  {
   "start": 4.72,
   "end": 7.36,
   "text": "שיטת לימוד בתורה מיוחדת וחלקה,"
  },
  {
   "start": 8.02,
   "end": 10.54,
   "text": "לימוד עיוני ועמוק שנקראת שיטת המהר״ל,"
  },
  {
   "start": 11.78,
   "end": 12.94,
   "text": "על שם המהר״ל מפראג."
  },
  {
   "start": 14.7,
   "end": 15.48,
   "text": "אחד מתלמידיו,"
  },
  {
   "start": 17.42,
   "end": 21.02,
   "text": "מעשרות תלמידיו, היה דוגמה רבי יום-טוב,"
  },
  {
   "start": 23.54,
   "end": 24.9,
   "text": "בעלתו שפות יום-טוב,"
  },
  {
   "start": 27.48,
   "end": 28.74,
   "text": "רבי יום-טוב ליפמן-הלר."
  },
  {
   "start": 31.93,
   "end": 35.33,
   "text": "המהר״ל הקים חברותות של משניות, שעד אז כמעט לא למדו משניות,"
  },
  {
   "start": 36.09,
   "end": 39.23,
   "text": "וכך עד היום אנשים לומדים משניות כל יום ביומו."
  },
  {
   "start": 40.69,
   "end": 44.09,
   "text": "המהרל מפראג היה ממקימי ומתומכי החברה קדישא."
  },
  {
   "start": 46.07,
   "end": 46.89,
   "text": "היו לו ספרים רבים,"
  },
  {
   "start": 47.13,
   "end": 47.63,
   "text": "גור אריה,"
  },
  {
   "start": 47.75,
   "end": 48.05,
   "text": "גבורת השם,"
  },
  {
   "start": 48.41,
   "end": 48.79,
   "text": "דרך חיים,"
  },
  {
   "start": 48.87,
   "end": 50.19,
   "text": "נתיבות עולם ועוד רבים."
  },
  {
   "start": 51.05,
   "end": 55.65,
   "text": "המהרל מפראג יום אחד הוזמן, איזו עוצמה היה לו, הוזמן לוויכוח פומבי עם חכמי אומות העולם."
  },
  {
   "start": 56.31,
   "end": 56.77,
   "text": "מה היה העימות?"
  },
  {
   "start": 57.59,
   "end": 60.97,
   "text": "המהרל מפראג מול 300 מדענים וכמרים."
  },
  {
   "start": 61.95,
   "end": 63.11,
   "text": "300, לא פחות."
  },
  {
   "start": 64.03,
   "end": 68.69,
   "text": "300 כמרים ומדענים יושבים, והמהר״ל צריך להתמודד איתם."
  },
  {
   "start": 70.15,
   "end": 71.65,
   "text": "המהר״ל נשא תפילה לשם יתברך."
  },
  {
   "start": 71.97,
   "end": 73.89,
   "text": "בוא עולם תעזור לי, תהיה איתי בוא העולם."
  },
  {
   "start": 74.21,
   "end": 75.65,
   "text": "התפלל והתפלל בדמעות."
  },
  {
   "start": 78.28,
   "end": 81.24,
   "text": "ואחרי זה ניגש לעימות. העימות יתקיים בהיכל האקדמיה בפראג."
  },
  {
   "start": 82.58,
   "end": 83.76,
   "text": "המהר״ל עומד בודד"
  },
  {
   "start": 84.44,
   "end": 87.02,
   "text": "מול 300 כמרים ומדענים,"
  },
  {
   "start": 87.82,
   "end": 88.74,
   "text": "והעימות מתחיל."
  },
  {
   "start": 89.32,
   "end": 89.86,
   "text": "מאיזה עימות?"
  },
  {
   "start": 91.9,
   "end": 92.7,
   "text": "הם שואלים,"
  },
  {
   "start": 93.5,
   "end": 93.98,
   "text": "והוא עונה."
  },
  {
   "start": 94.64,
   "end": 96.66,
   "text": "הם מתקיפים והוא מסביר"
  },
  {
   "start": 97.34,
   "end": 101.36,
   "text": "ועל כל דבר ודבר הוא עונה להם בהיגיון ורהיטות"
  },
  {
   "start": 102.9,
   "end": 104.58,
   "text": "וכך מקץ שעות ארוכות"
  },
  {
   "start": 105.22,
   "end": 106.22,
   "text": "הסתיים העימות"
  },
  {
   "start": 107.64,
   "end": 111.24,
   "text": "ודמותו הגבוהה של המהר״ל עושה את דרכה החוצה"
  },
  {
   "start": 112.1,
   "end": 114.6,
   "text": "שלוש מאות כמרים ומדענים לא יכלו לו"
  },
  {
   "start": 115.36,
   "end": 116.74,
   "text": "לגאון הגדול היהודי"
  },
  {
   "start": 117.62,
   "end": 119.6,
   "text": "שלוש מאות כמרים ומדענים"
  },
  {
   "start": 121.12,
   "end": 122.0,
   "text": "לא יכלו לו"
  },
  {
   "start": 122.52,
   "end": 124.02,
   "text": "הוא היכה אותם שוק על ירך"
  },
  {
   "start": 127.81,
   "end": 131.05,
   "text": "עד לכך שקיסר אוסטריה באותה תקופה יקראו לו רודולף השני."
  },
  {
   "start": 131.81,
   "end": 135.07,
   "text": "אמרו לו תדע לך המהרל מפראג החכם היהודי הזה של פראג"
  },
  {
   "start": 135.87,
   "end": 137.81,
   "text": "זה משהו מיוחד כנראה הוא מעל לטבע."
  },
  {
   "start": 138.97,
   "end": 140.03,
   "text": "כדאי לך להיפגש איתו."
  },
  {
   "start": 144.39,
   "end": 146.07,
   "text": "וכנראה יש לו חוכמה גם בכוחות נסתרים."
  },
  {
   "start": 147.53,
   "end": 148.39,
   "text": "אתה חייב להיפגש איתו."
  },
  {
   "start": 149.37,
   "end": 150.59,
   "text": "ולראשונה אולי"
  },
  {
   "start": 152.07,
   "end": 155.21,
   "text": "מזה מאות שנים קיסר אוסטריה בא להיפגש עם יהודי."
  },
  {
   "start": 157.61,
   "end": 162.21,
   "text": "ובמפגש ביניהם יצא הקיסר מתפעל מהאישיות מהחוכמה של המהרל."
  },
  {
   "start": 162.23,
   "end": 167.31,
   "text": "מפראג וסגרר גם הכלה לכל יהודי אוסטריה."
  },
  {
   "start": 168.99,
   "end": 170.37,
   "text": "אותו דבר אוטומטית הקיסר הוריד"
  },
  {
   "start": 170.85,
   "end": 174.45,
   "text": "הרבה מהגזרות שלו כנגד היהודים אבל בכל אופן עברה תקופה"
  },
  {
   "start": 175.39,
   "end": 180.39,
   "text": "ולחץ כבד שהיה מופעל יום יום על הקיסר רודולף השני מצד אשתו, מצד גמרים,"
  },
  {
   "start": 180.97,
   "end": 182.45,
   "text": "מצד כולם, מצד כל השרים שלו."
  },
  {
   "start": 184.23,
   "end": 189.61,
   "text": "נשא פרי כל יום לחצו עליו בוא תגזור גזירת גירוש על יהודי אוסטריה נמאס לנו לראות אותם."
  },
  {
   "start": 191.17,
   "end": 192.21,
   "text": "בסוף לא היה ברירה הוא הלך"
  },
  {
   "start": 192.39,
   "end": 198.35,
   "text": "לקח מסמך שנתנו לו וחתם על המסמך תוך חצי שנה גירוש לכל יהודי אוסטריה."
  },
  {
   "start": 199.17,
   "end": 201.31,
   "text": "גירוש לעזוב את הבית. לאן? לא היה ארץ ישראל."
  },
  {
   "start": 202.05,
   "end": 203.31,
   "text": "לשום מקום. לאן?"
  },
  {
   "start": 204.15,
   "end": 208.67,
   "text": "לאן ילכו ילדים, ילדות? לאן ילכו נערים, נערות?"
  },
  {
   "start": 209.39,
   "end": 211.93,
   "text": "נשים, גברים, זקנים, זקנות? לאן?"
  },
  {
   "start": 213.63,
   "end": 214.41,
   "text": "לא היה המקום."
  },
  {
   "start": 216.76,
   "end": 217.82,
   "text": "והקיסר חתם."
  },
  {
   "start": 219.4,
   "end": 220.08,
   "text": "אבל בפראג"
  },
  {
   "start": 220.64,
   "end": 221.6,
   "text": "שכן המהרל,"
  },
  {
   "start": 222.24,
   "end": 224.92,
   "text": "והמהרל ברוח הקודש כי ידע את כל הנעשה."
  },
  {
   "start": 226.56,
   "end": 227.86,
   "text": "הוא ישב בכורסה שלו,"
  },
  {
   "start": 229.12,
   "end": 233.38,
   "text": "וכמו אז, כשהילד קטן והיה בוכה על הכאבים של עם ישראל,"
  },
  {
   "start": 234.14,
   "end": 235.2,
   "text": "גם עכשיו הוא ישב"
  },
  {
   "start": 236.16,
   "end": 237.52,
   "text": "ובכה ובכה."
  },
  {
   "start": 238.26,
   "end": 241.14,
   "text": "ולבסוף אמר ריבונו של עולם, אין לי ברירה."
  },
  {
   "start": 242.3,
   "end": 245.04,
   "text": "אין לי ברירה, אבל למען עם ישראל אני אעשה את זה."
  },
  {
   "start": 245.58,
   "end": 249.66,
   "text": "ריבונו של עולם, אתה יודע שאין לי ברירה, אבל למען עם ישראל, לא לכבודי, לא כבדת אבא."
  },
  {
   "start": 250.34,
   "end": 251.14,
   "text": "אני אעשה את זה."
  },
  {
   "start": 252.6,
   "end": 252.88,
   "text": "לילה,"
  },
  {
   "start": 253.82,
   "end": 254.74,
   "text": "שעת לילה מאוחרת."
  },
  {
   "start": 255.7,
   "end": 257.6,
   "text": "הקיסר רודולף השני מתהפך במיטתו,"
  },
  {
   "start": 258.22,
   "end": 259.1,
   "text": "נדודי שינה."
  },
  {
   "start": 260.38,
   "end": 262.4,
   "text": "טוב, כדאי אולי שאצל לטייל עד שהוא יוכל לישון."
  },
  {
   "start": 262.94,
   "end": 263.56,
   "text": "ככה הוא חשב לו."
  },
  {
   "start": 264.5,
   "end": 267.1,
   "text": "התחיל לטייל בגן שלו, איזה גן נהדר היה לו, מטייל"
  },
  {
   "start": 268.26,
   "end": 269.86,
   "text": "בין הדקלים, בין העצי הפרי,"
  },
  {
   "start": 271.1,
   "end": 272.26,
   "text": "עד שככה מבלי משים"
  },
  {
   "start": 273.4,
   "end": 274.26,
   "text": "פתאום מגיע אל העורבה,"
  },
  {
   "start": 275.48,
   "end": 281.54,
   "text": "ובאמצע העורבה הוא רואה את המרכבה המלכותית נחה ועומדת לה כאילו ממתינה לו."
  },
  {
   "start": 282.52,
   "end": 286.34,
   "text": "אז אמר לגלון, טוב בוא נעלה לטיול, יצא לטיול במרכבה"
  },
  {
   "start": 288.08,
   "end": 288.9,
   "text": "ככה מטייל בפראג"
  },
  {
   "start": 290.84,
   "end": 292.8,
   "text": "משמאלו, נהר המולדובה"
  },
  {
   "start": 293.96,
   "end": 297.82,
   "text": "הבהיק למולו בלילה ככה, בלילה היפה הזה של פראג, לילה עטור כוכבים"
  },
  {
   "start": 298.8,
   "end": 300.02,
   "text": "והוא החליט לסחוט בנהר"
  },
  {
   "start": 301.0,
   "end": 303.24,
   "text": "אמר להם, תעצרו שנייה, אני רוצה להיכנס לסחוט קצת"
  },
  {
   "start": 305.8,
   "end": 306.34,
   "text": "והמלך"
  },
  {
   "start": 309.07,
   "end": 310.95,
   "text": "נכנס למים, פשט את הגליה ונכנס למים"
  },
  {
   "start": 312.07,
   "end": 313.47,
   "text": "הוא כל כך נהנה מהשהות במים"
  },
  {
   "start": 315.23,
   "end": 316.27,
   "text": "ככה נשאר שעה ארוכה,"
  },
  {
   "start": 317.17,
   "end": 317.93,
   "text": "וכשיצא,"
  },
  {
   "start": 320.06,
   "end": 321.82,
   "text": "הוא לא מצא לא מרכבה ולא כלום."
  },
  {
   "start": 323.71,
   "end": 324.55,
   "text": "הוא נותר בודד,"
  },
  {
   "start": 325.75,
   "end": 327.03,
   "text": "רק בגדי הרחצה עליו."
  },
  {
   "start": 329.5,
   "end": 330.62,
   "text": "אין מרכבה, אין כלום."
  },
  {
   "start": 333.98,
   "end": 334.94,
   "text": "כך עבר עליו הלילה."
  },
  {
   "start": 335.7,
   "end": 337.64,
   "text": "בבוקר הוא התחיל לחפש את הדרך שלו חזרה לארמון."
  },
  {
   "start": 339.38,
   "end": 343.36,
   "text": "הוא עובר לאנשים, אומר להם, תשמעו, אתם יכולים להביא אותי לחזרה לארמון, אני הקיסר אודולפוס, השני."
  },
  {
   "start": 345.96,
   "end": 347.3,
   "text": "הוא התחיל לקבל מכות מהאנשים,"
  },
  {
   "start": 348.68,
   "end": 349.28,
   "text": "התחילו לפגוע בו."
  },
  {
   "start": 349.88,
   "end": 352.94,
   "text": "אתה שותה, אתה מתבייש לדבר ככה? אתה הקיסר?"
  },
  {
   "start": 355.14,
   "end": 364.06,
   "text": "אתה מזלזל בקיסר שלנו והיו מכים אותו ופוגעים בו ולמרות שהוא נראה דומה לקיסר אבל חשבו שבגלל שהוא דומה לקיסר הוא נכנס לאותו שיגעון גדלות"
  },
  {
   "start": 365.28,
   "end": 366.32,
   "text": "שהוא חושב שהוא הקיסר"
  },
  {
   "start": 368.06,
   "end": 371.62,
   "text": "וככה מסתובב לו הקיסר עני מחזר על הפתחים"
  },
  {
   "start": 372.34,
   "end": 373.9,
   "text": "שערותיו גודלות פרא"
  },
  {
   "start": 374.72,
   "end": 376.46,
   "text": "הפנים שלו מתחילות שזובות"
  },
  {
   "start": 377.32,
   "end": 379.4,
   "text": "והוא מחפש את הדרך לממלכה"
  },
  {
   "start": 381.2,
   "end": 382.26,
   "text": "הוא איבד את הדרך"
  },
  {
   "start": 382.26,
   "end": 384.34,
   "text": "יום אחד,"
  },
  {
   "start": 385.24,
   "end": 385.98,
   "text": "אחרי זמן ארוך,"
  },
  {
   "start": 386.8,
   "end": 387.56,
   "text": "הוא הגיע אל פראג."
  },
  {
   "start": 388.76,
   "end": 390.12,
   "text": "הוא הגיע אל מול הממלכה שלו,"
  },
  {
   "start": 390.72,
   "end": 391.32,
   "text": "אל מול הארמון."
  },
  {
   "start": 392.5,
   "end": 393.06,
   "text": "אבל איך הוא ייכנס?"
  },
  {
   "start": 394.32,
   "end": 395.5,
   "text": "מי ייתן לו להיכנס ולהסביר?"
  },
  {
   "start": 396.96,
   "end": 399.14,
   "text": "כולם אומרים שהקיסר רודולף נמצא בפנים."
  },
  {
   "start": 401.98,
   "end": 404.8,
   "text": "ברוב תסכול וייאוש הוא ישב על אבן והתחיל לבכות."
  },
  {
   "start": 406.94,
   "end": 410.78,
   "text": "פתאום הוא שומע מרגיש איזו נגיעה קטנה בכתף ושומע רעש."
  },
  {
   "start": 411.34,
   "end": 411.98,
   "text": "מרים את הראש,"
  },
  {
   "start": 412.86,
   "end": 413.56,
   "text": "הוא איזה אדם זקן."
  },
  {
   "start": 414.32,
   "end": 415.94,
   "text": "אומר לו, תגיד לי, בחור צעיר, למה אתה בוכה?"
  },
  {
   "start": 416.78,
   "end": 417.56,
   "text": "ספר לי, מה קרה?"
  },
  {
   "start": 420.38,
   "end": 421.14,
   "text": "הוא התחיל לספר לו,"
  },
  {
   "start": 421.88,
   "end": 422.62,
   "text": "ומסתכל עליו,"
  },
  {
   "start": 423.36,
   "end": 425.0,
   "text": "מחכה ללעג שהוא יספוג,"
  },
  {
   "start": 426.58,
   "end": 427.16,
   "text": "והזקן,"
  },
  {
   "start": 427.86,
   "end": 428.66,
   "text": "הזקן מאמין לו."
  },
  {
   "start": 429.96,
   "end": 430.42,
   "text": "שומע,"
  },
  {
   "start": 431.02,
   "end": 432.28,
   "text": "וכשהוא גמר לדבר, הוא אמר לו, תגיד לי,"
  },
  {
   "start": 433.06,
   "end": 434.92,
   "text": "למה אתה לא הולך למהר״ל מפראג?"
  },
  {
   "start": 435.74,
   "end": 436.22,
   "text": "אתה בפראג."
  },
  {
   "start": 437.02,
   "end": 439.24,
   "text": "לך למהר״ל, הוא יגיד לך מה לעשות."
  },
  {
   "start": 443.48,
   "end": 444.14,
   "text": "הקיסר אודולף"
  },
  {
   "start": 445.16,
   "end": 446.5,
   "text": "השני הלך למהר״ל."
  },
  {
   "start": 450.16,
   "end": 451.8,
   "text": "אמר לו המהר״ל, אתה צודק."
  },
  {
   "start": 452.8,
   "end": 456.44,
   "text": "נכון, על הכיסא שלך יושב זר כפיל שדומה לך,"
  },
  {
   "start": 456.96,
   "end": 457.96,
   "text": "ואף אחד לא מרגיש בזה."
  },
  {
   "start": 459.28,
   "end": 460.34,
   "text": "כשאתה שואל מה תעשה,"
  },
  {
   "start": 461.18,
   "end": 463.36,
   "text": "אתה עכשיו צריך לשבת ולערוב ליד הארמון,"
  },
  {
   "start": 464.02,
   "end": 467.98,
   "text": "ותמתין עד שאותו קיסר מדומה יצא לסחוט בנהר."
  },
  {
   "start": 469.96,
   "end": 473.14,
   "text": "ואז, כשהוא יצא לסחוט, אתה תקפוץ, תלבש את הבגדים שלו,"
  },
  {
   "start": 473.5,
   "end": 476.2,
   "text": "תיכנס למרכבה ותיתן הוראות במקומו,"
  },
  {
   "start": 476.74,
   "end": 477.84,
   "text": "ותחזור לבית שלך."
  },
  {
   "start": 479.62,
   "end": 480.14,
   "text": "עיני רודולף,"
  },
  {
   "start": 481.12,
   "end": 481.24,
   "text": "אורו,"
  },
  {
   "start": 482.7,
   "end": 484.32,
   "text": "אמר לו המהר״ל, אבל קודם אתה צריך להסתפר."
  },
  {
   "start": 486.08,
   "end": 488.54,
   "text": "והמהר״ל סיפר אותו וגזל את הציפורניים שלו."
  },
  {
   "start": 489.32,
   "end": 489.62,
   "text": "תגיד לי,"
  },
  {
   "start": 490.44,
   "end": 494.8,
   "text": "כבוד הרב, איך אני יכול להודות לך? איך אני אוכל להודות לך על זה? אם אני חוזר לשלטון, איך אני מודה לך?"
  },
  {
   "start": 495.78,
   "end": 497.26,
   "text": "המהר״ל לקח את הציפורניים,"
  },
  {
   "start": 498.04,
   "end": 498.92,
   "text": "לקח את השיער שלו,"
  },
  {
   "start": 499.52,
   "end": 501.06,
   "text": "הכניס אותם לכד קטן קטן."
  },
  {
   "start": 501.8,
   "end": 502.86,
   "text": "אמר לו, קח את הכד הזה,"
  },
  {
   "start": 504.16,
   "end": 505.42,
   "text": "אתה תזכור את הכד הזה,"
  },
  {
   "start": 506.68,
   "end": 508.28,
   "text": "תזכור, אל תשכח אותו כל החיים."
  },
  {
   "start": 508.96,
   "end": 511.18,
   "text": "ואתה כבר תדע איך לגמול,"
  },
  {
   "start": 511.7,
   "end": 514.22,
   "text": "איך לגמול לי טובה, אלא איך להחזיר לי טובה."
  },
  {
   "start": 517.14,
   "end": 517.88,
   "text": "והמלך אמר תודה,"
  },
  {
   "start": 519.16,
   "end": 519.6,
   "text": "ויצא."
  },
  {
   "start": 521.42,
   "end": 523.08,
   "text": "הוא יושב ממתין ליד הארמון,"
  },
  {
   "start": 523.64,
   "end": 527.16,
   "text": "באותו היום יוצא הכפיל, הקיסר המדומה, לשחות."
  },
  {
   "start": 529.4,
   "end": 532.0,
   "text": "והוא עוקב אחריו, וכשהקיסר נכנס,"
  },
  {
   "start": 533.16,
   "end": 534.24,
   "text": "החילופים בוצעו בה,"
  },
  {
   "start": 534.78,
   "end": 537.1,
   "text": "ובוצעו בהצלחה. הוא לבש את הבגדים של הקיסר,"
  },
  {
   "start": 537.48,
   "end": 539.7,
   "text": "ניגש לעגלה קדימה, נוסעים חזרה הביתה."
  },
  {
   "start": 540.9,
   "end": 541.38,
   "text": "והגיע."
  },
  {
   "start": 542.32,
   "end": 543.44,
   "text": "דבר ראשון שהוא עשה,"
  },
  {
   "start": 544.44,
   "end": 546.04,
   "text": "הוציא פסק דין מוות על הכפיל."
  },
  {
   "start": 554.77,
   "end": 555.43,
   "text": "דבר שני,"
  },
  {
   "start": 556.01,
   "end": 560.07,
   "text": "החליט לבטל את הגזירה על היהודים כאות תודה למהר״ל מפראג."
  },
  {
   "start": 566.61,
   "end": 566.89,
   "text": "לפתע,"
  },
  {
   "start": 567.53,
   "end": 568.43,
   "text": "לפתע זז לו הקיסר."
  },
  {
   "start": 569.67,
   "end": 570.85,
   "text": "הוא התעורר משנתו מזיע."
  },
  {
   "start": 574.19,
   "end": 575.29,
   "text": "חלום נורא חלמתי."
  },
  {
   "start": 576.95,
   "end": 577.73,
   "text": "הכל היה חלום."
  },
  {
   "start": 579.25,
   "end": 579.97,
   "text": "הכל היה חלום."
  },
  {
   "start": 585.79,
   "end": 586.25,
   "text": "בבוקר,"
  },
  {
   "start": 587.03,
   "end": 587.69,
   "text": "המלך קם."
  },
  {
   "start": 588.79,
   "end": 589.61,
   "text": "טוב, הכל היה חלום."
  },
  {
   "start": 590.63,
   "end": 591.49,
   "text": "עושה שתי פסיעות"
  },
  {
   "start": 592.55,
   "end": 593.17,
   "text": "וכופה על עומדו."
  },
  {
   "start": 594.43,
   "end": 597.09,
   "text": "שם, על השולחן, בחדר,"
  },
  {
   "start": 597.85,
   "end": 598.33,
   "text": "נח לו"
  },
  {
   "start": 599.11,
   "end": 599.89,
   "text": "כד קטן,"
  },
  {
   "start": 600.83,
   "end": 602.53,
   "text": "בדיוק כמו שהמהר״ל נתן לו."
  },
  {
   "start": 603.45,
   "end": 604.47,
   "text": "הוא מתקרב אליו לאט,"
  },
  {
   "start": 605.11,
   "end": 605.61,
   "text": "בפחד,"
  },
  {
   "start": 606.37,
   "end": 607.17,
   "text": "מרים את הכד,"
  },
  {
   "start": 607.89,
   "end": 608.99,
   "text": "מציץ לתוכו,"
  },
  {
   "start": 615.18,
   "end": 616.64,
   "text": "וצבחה נמלטה מפיו."
  },
  {
   "start": 617.82,
   "end": 619.86,
   "text": "בתוך הכד היו הסערות שלו,"
  },
  {
   "start": 620.54,
   "end": 622.44,
   "text": "בתוך הכד היו הציפורניים שלו."
  },
  {
   "start": 624.72,
   "end": 625.12,
   "text": "מה קורה כאן?"
  },
  {
   "start": 626.02,
   "end": 627.5,
   "text": "זה חלום או מציאות?"
  },
  {
   "start": 637.08,
   "end": 641.2,
   "text": "השרים של הקיסר אמרו לו, אתה חלמת חלום הרגיל, בסך הכל יום עבר."
  },
  {
   "start": 645.32,
   "end": 648.24,
   "text": "אבל הציפורניים והשיער, אף אחד לא יכול להסביר."
  },
  {
   "start": 650.62,
   "end": 652.28,
   "text": "פנה הקיסר רודולף למהר״ל מפראג,"
  },
  {
   "start": 655.04,
   "end": 655.36,
   "text": "תגיד לי,"
  },
  {
   "start": 656.86,
   "end": 659.0,
   "text": "כבוד הרב, מה קורה כאן? זה חלום ומציאות."
  },
  {
   "start": 665.24,
   "end": 666.94,
   "text": "הביט בו המהר״ל מפראג,"
  },
  {
   "start": 667.84,
   "end": 669.5,
   "text": "ואמר לו, אדוני הקיסר,"
  },
  {
   "start": 670.46,
   "end": 670.72,
   "text": "הפעם"
  },
  {
   "start": 671.58,
   "end": 673.12,
   "text": "הפעם זה נגמר בגדר של חלום,"
  },
  {
   "start": 675.95,
   "end": 676.65,
   "text": "אמר המהר״ל,"
  },
  {
   "start": 677.51,
   "end": 678.75,
   "text": "ויהדות פראג ניצלה."
  },
  {
   "start": 679.79,
   "end": 686.05,
   "text": "כי בורא עולם מלך מלכי המלכים הקדוש ברוך הוא דאג להביא לתא אדם הנכון במקום הנכון"
  },
  {
   "start": 687.39,
   "end": 688.01,
   "text": "ולהציל"
  },
  {
   "start": 688.93,
   "end": 689.19,
   "text": "קהילה שלמה."
  }
 ]
}