{
 "disc": "28צ- הרוגי מלכות",
 "track": "Track01",
 "duration": 1471.152,
 "segments": [
  {
   "start": 34.19,
   "end": 50.57,
   "text": "כי עליך הורגנו כל היום מהדברים שהם סימני דרך, ציוני דרך"
  },
  {
   "start": 52.31,
   "end": 53.17,
   "text": "בעם ישראל."
  },
  {
   "start": 54.11,
   "end": 58.81,
   "text": "זו אותה מסירות נפש של גדולי עולם, של צדיקים וקדושים עבורנו אנו."
  },
  {
   "start": 61.96,
   "end": 68.53,
   "text": "אחד מאותו תוואי של מסירות נפש זה מדרש אלה אזכרה."
  },
  {
   "start": 72.72,
   "end": 73.44,
   "text": "אומר המדרש,"
  },
  {
   "start": 74.08,
   "end": 76.86,
   "text": "כשברא הקדוש ברוך הוא את האילנות,"
  },
  {
   "start": 77.7,
   "end": 80.42,
   "text": "את העצים, הם היו מתגאים בקומה שלהם,"
  },
  {
   "start": 81.38,
   "end": 83.22,
   "text": "מגביהים עצמם למעלה למעלה."
  },
  {
   "start": 86.52,
   "end": 90.12,
   "text": "אבל כיוון שנברא על ידי הקדוש ברוך הוא הברזל,"
  },
  {
   "start": 94.13,
   "end": 97.31,
   "text": "היו משפילים עצמם ואומרים, אוי לנו,"
  },
  {
   "start": 98.45,
   "end": 101.41,
   "text": "שכבר ברא הקדוש ברוך הוא דבר שיכרות."
  },
  {
   "start": 104.84,
   "end": 105.38,
   "text": "אותו דבר,"
  },
  {
   "start": 106.14,
   "end": 108.04,
   "text": "אחרי חורבן בית המקדש,"
  },
  {
   "start": 108.84,
   "end": 110.8,
   "text": "בשנים הראשונות אחרי חורבן הבית,"
  },
  {
   "start": 111.64,
   "end": 112.6,
   "text": "היו עשירי הדור"
  },
  {
   "start": 113.84,
   "end": 115.3,
   "text": "מתגאים ואומרים,"
  },
  {
   "start": 116.08,
   "end": 117.94,
   "text": "מה הפסדנו בזה שנחרב הבית?"
  },
  {
   "start": 119.02,
   "end": 124.06,
   "text": "הרי יש בינינו תלמידי חכמים שמדריכים את העולם בתורה, מצוות."
  },
  {
   "start": 124.88,
   "end": 125.32,
   "text": "לא נורא."
  },
  {
   "start": 126.0,
   "end": 129.02,
   "text": "אפשר להסתדר גם בלי בית המקדש, המצב שלנו בסדר."
  },
  {
   "start": 130.64,
   "end": 134.8,
   "text": "ראה הקדוש ברוך הוא שצריך לעורר את עם ישראל."
  },
  {
   "start": 136.34,
   "end": 137.68,
   "text": "מיד נתן הקדוש ברוך הוא,"
  },
  {
   "start": 138.32,
   "end": 139.78,
   "text": "בלב הקיסר של רומי,"
  },
  {
   "start": 140.8,
   "end": 141.38,
   "text": "ללמוד,"
  },
  {
   "start": 142.56,
   "end": 143.5,
   "text": "ללמוד את התורה."
  },
  {
   "start": 145.48,
   "end": 147.94,
   "text": "הוא לקח מספר חכמים,"
  },
  {
   "start": 148.84,
   "end": 151.9,
   "text": "מספר זקנים, ואמר להם, בואו, אני רוצה שתלמדו אותי את התורה הקדושה שלכם."
  },
  {
   "start": 153.44,
   "end": 156.12,
   "text": "והם התחילו לשבת ללמד, הם בהתחלה חשבו, טוב, אולי באמת,"
  },
  {
   "start": 156.74,
   "end": 157.58,
   "text": "עצם זה שהוא ילמד,"
  },
  {
   "start": 158.2,
   "end": 160.54,
   "text": "הוא ככה יתקרב לעם ישראל,"
  },
  {
   "start": 161.52,
   "end": 163.18,
   "text": "ואולי יהיה לנו יותר קל."
  },
  {
   "start": 166.48,
   "end": 169.56,
   "text": "והוא לומד ספר בראשית, פרשת בראשית,"
  },
  {
   "start": 172.39,
   "end": 174.63,
   "text": "גומר את ספר בראשית מבראשית עד ויחי,"
  },
  {
   "start": 175.75,
   "end": 176.99,
   "text": "מתחיל את ספר שמות,"
  },
  {
   "start": 180.34,
   "end": 181.84,
   "text": "עד שהוא מגיע לפרשת"
  },
  {
   "start": 182.7,
   "end": 183.42,
   "text": "משפטים."
  },
  {
   "start": 185.38,
   "end": 186.7,
   "text": "בפרשת משפטים,"
  },
  {
   "start": 187.5,
   "end": 189.18,
   "text": "ברגע שהוא הגיע בלימוד שלו,"
  },
  {
   "start": 189.78,
   "end": 190.38,
   "text": "לפסוק"
  },
  {
   "start": 191.02,
   "end": 194.0,
   "text": "וגונב איש ומחרו מות יומת,"
  },
  {
   "start": 195.42,
   "end": 197.4,
   "text": "מיד נעצר."
  },
  {
   "start": 201.12,
   "end": 203.54,
   "text": "למחרת הוא מורה לעבדים שלו"
  },
  {
   "start": 204.32,
   "end": 208.44,
   "text": "למלא את פלטרו בנעליים,"
  },
  {
   "start": 218.12,
   "end": 219.32,
   "text": "ושולח לקרוא,"
  },
  {
   "start": 219.86,
   "end": 223.28,
   "text": "תביאו לי את העשרה הגדולים ביותר בעם ישראל,"
  },
  {
   "start": 224.16,
   "end": 228.66,
   "text": "מי הם העשרה החכמים הגדולים ביותר של עם ישראל, גדולי הדור?"
  },
  {
   "start": 230.04,
   "end": 232.48,
   "text": "אנחנו רוצים לשאול אותם שאלה."
  },
  {
   "start": 233.14,
   "end": 234.7,
   "text": "תביאו את הגדולים שבכם."
  },
  {
   "start": 236.96,
   "end": 239.3,
   "text": "ועם ישראל שלח את עשרת"
  },
  {
   "start": 241.48,
   "end": 244.5,
   "text": "התלמידי חכמים ענקי האומה הישראלית."
  },
  {
   "start": 245.72,
   "end": 246.5,
   "text": "הם באו לפניו."
  },
  {
   "start": 247.4,
   "end": 249.74,
   "text": "הוא הושיב אותם בקתדרות של זהב"
  },
  {
   "start": 250.84,
   "end": 251.7,
   "text": "ואמר להם,"
  },
  {
   "start": 252.42,
   "end": 255.26,
   "text": "עומק הדין יש לי לשאול מכם."
  },
  {
   "start": 255.94,
   "end": 258.86,
   "text": "אתם יודעים מה הוא אמר להם? עומק הדין. אתם יודעים מה זה עומק הדין?"
  },
  {
   "start": 259.58,
   "end": 260.3,
   "text": "בלי רחמים,"
  },
  {
   "start": 260.88,
   "end": 261.82,
   "text": "בלי לימוד זכות,"
  },
  {
   "start": 262.44,
   "end": 263.38,
   "text": "בלי חנינה."
  },
  {
   "start": 264.2,
   "end": 265.38,
   "text": "דין לגמרי."
  },
  {
   "start": 265.76,
   "end": 269.06,
   "text": "עומק הדין יש לי לשאול מכם. את זה מה שאני רוצה, תענו לי."
  },
  {
   "start": 271.56,
   "end": 275.36,
   "text": "ואל תענו לי רק דין, אמת ומשפט."
  },
  {
   "start": 276.04,
   "end": 278.18,
   "text": "בלי רחמים, בלי זכויות, בלי כלום."
  },
  {
   "start": 279.8,
   "end": 280.88,
   "text": "אמרו לו, כן, תאמר."
  },
  {
   "start": 283.11,
   "end": 284.61,
   "text": "אמר להם, תגידו לי,"
  },
  {
   "start": 285.63,
   "end": 293.31,
   "text": "אם יש אדם יהודי שגונב את אחד מהאחים שלו היהודים, איזה ילד יהודי,"
  },
  {
   "start": 294.81,
   "end": 298.55,
   "text": "ומוכר אותו לגוי,"
  },
  {
   "start": 299.45,
   "end": 300.51,
   "text": "מה הדין שלו?"
  },
  {
   "start": 303.54,
   "end": 304.04,
   "text": "אמרו לו,"
  },
  {
   "start": 304.76,
   "end": 305.96,
   "text": "התורה שלנו אמרה,"
  },
  {
   "start": 307.28,
   "end": 308.84,
   "text": "גונב איש ומכרו,"
  },
  {
   "start": 309.6,
   "end": 310.24,
   "text": "מות יומת."
  },
  {
   "start": 313.94,
   "end": 315.38,
   "text": "קם הקיסר של רומי."
  },
  {
   "start": 315.38,
   "end": 320.72,
   "text": "הפנה אצבע מאשימה אליהם ואמר להם, אם ככה,"
  },
  {
   "start": 321.38,
   "end": 323.42,
   "text": "אתם כולכם חייבים איתה."
  },
  {
   "start": 327.73,
   "end": 328.37,
   "text": "אמרו לו, למה?"
  },
  {
   "start": 334.75,
   "end": 335.67,
   "text": "למדתי את התורה שלכם."
  },
  {
   "start": 337.89,
   "end": 339.37,
   "text": "בספר בראשית למדתי"
  },
  {
   "start": 340.49,
   "end": 342.35,
   "text": "על אותו יוסף הצדיק"
  },
  {
   "start": 342.89,
   "end": 345.05,
   "text": "שעשרת אחיו מכרו אותו."
  },
  {
   "start": 346.45,
   "end": 347.81,
   "text": "וכשאני למדתי, אמרתי,"
  },
  {
   "start": 348.85,
   "end": 349.95,
   "text": "אם הם היו בחיים,"
  },
  {
   "start": 350.83,
   "end": 352.41,
   "text": "הייתי תופס אותם ודן אותם."
  },
  {
   "start": 353.33,
   "end": 355.01,
   "text": "למה הם מכרו את האח שלהם,"
  },
  {
   "start": 356.43,
   "end": 357.01,
   "text": "אבל הם לא בחיים."
  },
  {
   "start": 359.25,
   "end": 361.79,
   "text": "וכשהגעתי לגונב איש ומחרו,"
  },
  {
   "start": 362.51,
   "end": 364.51,
   "text": "ידעתי שהפסק דין שלהם זה מוות."
  },
  {
   "start": 365.55,
   "end": 366.85,
   "text": "רציתי לשמוע את זה מכם."
  },
  {
   "start": 368.13,
   "end": 369.99,
   "text": "ועכשיו שהאחים לא בחיים,"
  },
  {
   "start": 370.79,
   "end": 373.25,
   "text": "אני אקח אתכם, עשרה חכמים,"
  },
  {
   "start": 373.89,
   "end": 377.09,
   "text": "עשרה גדולי ישראל, כנגד עשרת האחים,"
  },
  {
   "start": 378.31,
   "end": 382.03,
   "text": "ואתם תשלמו את העוון של האבות שלכם."
  },
  {
   "start": 383.21,
   "end": 387.21,
   "text": "לא ראיתי בשום מקום שעשרת השבטים הקדושים נענשו."
  },
  {
   "start": 391.48,
   "end": 394.02,
   "text": "הביטו בו עשרת מאורי האומה."
  },
  {
   "start": 394.66,
   "end": 396.2,
   "text": "היו להם כוחות רוחניים עצומים."
  },
  {
   "start": 396.78,
   "end": 400.98,
   "text": "הם שלטו בכל מחמני התורה, פשט, רמז, דרש, סוד."
  },
  {
   "start": 401.84,
   "end": 404.42,
   "text": "הם יכלו להילחם כנדו, יכלו אולי לפגוע בו."
  },
  {
   "start": 406.3,
   "end": 409.26,
   "text": "אבל הם ידעו שמה שהם צריכים לברר זה רק דבר אחד,"
  },
  {
   "start": 409.78,
   "end": 412.74,
   "text": "אם זו גזירה משמיים, אם זה רצון השם,"
  },
  {
   "start": 413.28,
   "end": 413.74,
   "text": "זה מה שנעשה."
  },
  {
   "start": 414.86,
   "end": 415.78,
   "text": "אז הם אמרו לו, תן לנו,"
  },
  {
   "start": 416.18,
   "end": 417.52,
   "text": "תן לנו זמן שלושה ימים."
  },
  {
   "start": 418.26,
   "end": 419.7,
   "text": "אם נמצא זכות על עצמנו,"
  },
  {
   "start": 420.34,
   "end": 420.8,
   "text": "הוא מוטב,"
  },
  {
   "start": 421.4,
   "end": 423.14,
   "text": "ואם לא, תעשה מה שאתה רוצה."
  },
  {
   "start": 426.41,
   "end": 427.01,
   "text": "אמר להם, בסדר,"
  },
  {
   "start": 427.63,
   "end": 429.17,
   "text": "אני מסכים לתת לכם שלושה ימים."
  },
  {
   "start": 430.97,
   "end": 431.65,
   "text": "והם יצאו מלפניו."
  },
  {
   "start": 437.29,
   "end": 438.13,
   "text": "כשהם יצאו,"
  },
  {
   "start": 438.75,
   "end": 440.71,
   "text": "הם פנו אל רבי ישמעאל כהן גדול."
  },
  {
   "start": 441.89,
   "end": 444.53,
   "text": "תזכיר את השם הגדול, תעלה לרקיעה,"
  },
  {
   "start": 445.15,
   "end": 448.75,
   "text": "ותחקור האם נגזרה גזירה מאת השם יתברך."
  },
  {
   "start": 453.36,
   "end": 458.16,
   "text": "ותיהר רבי ישמעאל בן אלישע כהן גדול את עצמו"
  },
  {
   "start": 459.12,
   "end": 461.62,
   "text": "בטבילה וקידושין,"
  },
  {
   "start": 464.96,
   "end": 468.3,
   "text": "נתעטף בטלית ובתפילין,"
  },
  {
   "start": 469.72,
   "end": 473.08,
   "text": "והזכיר את השם המפורש בפירושו."
  },
  {
   "start": 475.26,
   "end": 475.66,
   "text": "מיד,"
  },
  {
   "start": 479.4,
   "end": 480.9,
   "text": "מיד נשאו הרוח,"
  },
  {
   "start": 481.72,
   "end": 482.68,
   "text": "והביא אותו למעלה,"
  },
  {
   "start": 483.34,
   "end": 483.94,
   "text": "למעלה,"
  },
  {
   "start": 484.52,
   "end": 485.94,
   "text": "עד הרקיעה השישי,"
  },
  {
   "start": 489.17,
   "end": 490.01,
   "text": "ברכי השישי"
  },
  {
   "start": 491.27,
   "end": 491.85,
   "text": "פגש בו"
  },
  {
   "start": 492.57,
   "end": 493.75,
   "text": "גבריאל המלאך."
  },
  {
   "start": 495.21,
   "end": 497.75,
   "text": "ראה אותו גבריאל המלאך ואמר לו,"
  },
  {
   "start": 498.59,
   "end": 499.25,
   "text": "אתה הוא ישמעאל,"
  },
  {
   "start": 500.47,
   "end": 505.31,
   "text": "אתה הוא ישמעאל שקונך בורא עולם משתבח בך בכל יום,"
  },
  {
   "start": 505.81,
   "end": 510.27,
   "text": "שיש לו עבד בארץ שדומה לקלסתר פניו."
  },
  {
   "start": 512.21,
   "end": 514.17,
   "text": "אתה אותו יהודי שבורא עולם"
  },
  {
   "start": 515.05,
   "end": 521.15,
   "text": "אומר שיש לו עבד שמאיר את העולם בקלסתר פניו."
  },
  {
   "start": 522.01,
   "end": 522.97,
   "text": "אמר לו, אני הוא."
  },
  {
   "start": 524.69,
   "end": 524.99,
   "text": "אני הוא."
  },
  {
   "start": 526.25,
   "end": 527.85,
   "text": "אמר לו, תגיד לי, למה עלית לכאן?"
  },
  {
   "start": 529.11,
   "end": 530.01,
   "text": "מה אתה עושה כאן?"
  },
  {
   "start": 531.27,
   "end": 535.77,
   "text": "אמר לו, לפי שמלכות הרשעה גזרה גזירה עלינו,"
  },
  {
   "start": 536.43,
   "end": 539.65,
   "text": "רוצים לאבד מאיתנו עשרה חכמי ישראל,"
  },
  {
   "start": 540.05,
   "end": 541.89,
   "text": "עשרה גדולי ישראל."
  },
  {
   "start": 542.51,
   "end": 546.09,
   "text": "עלידי לברר אם הגזירה היא מאת הקדוש ברוך הוא."
  },
  {
   "start": 548.35,
   "end": 549.73,
   "text": "אמר לו המלאך גבריאל,"
  },
  {
   "start": 550.97,
   "end": 555.19,
   "text": "ואם היא גזירה לא חתומה, אתה יכול לבטל אותה?"
  },
  {
   "start": 556.61,
   "end": 557.27,
   "text": "אמר לו כן."
  },
  {
   "start": 558.51,
   "end": 559.77,
   "text": "אמר לו בשם יתברך."
  },
  {
   "start": 562.45,
   "end": 569.91,
   "text": "מיד ענה גבריאל המלאך ואמר, אשריכם, בני אברהם,"
  },
  {
   "start": 570.55,
   "end": 571.75,
   "text": "בני יצחק,"
  },
  {
   "start": 572.37,
   "end": 573.53,
   "text": "בני יעקב,"
  },
  {
   "start": 573.93,
   "end": 578.51,
   "text": "שגילה הקדוש ברוך הוא לכם מה שלא גילה למלאכי השרת."
  },
  {
   "start": 587.78,
   "end": 589.22,
   "text": "אמר לו גבריאל המלאך,"
  },
  {
   "start": 590.0,
   "end": 591.72,
   "text": "ישמעאל בני,"
  },
  {
   "start": 592.74,
   "end": 594.48,
   "text": "ישמעאל בני,"
  },
  {
   "start": 595.36,
   "end": 596.48,
   "text": "חי נפשך,"
  },
  {
   "start": 597.18,
   "end": 599.62,
   "text": "שככה שמעתי מאחורי הפרגוד."
  },
  {
   "start": 600.44,
   "end": 606.78,
   "text": "עשרה חכמי ישראל נמסרו להריגה ביד מלכות הרשעה."
  },
  {
   "start": 608.46,
   "end": 610.02,
   "text": "עשרה חכמי ישראל"
  },
  {
   "start": 610.78,
   "end": 613.32,
   "text": "נמסרו להריגה ביד מלכות הרשעה."
  },
  {
   "start": 615.34,
   "end": 617.04,
   "text": "אמר רבי ישמעאל, למה?"
  },
  {
   "start": 617.98,
   "end": 619.36,
   "text": "אני רוצה לדעת למה."
  },
  {
   "start": 620.62,
   "end": 622.28,
   "text": "אמר לו, אתה יודע למה?"
  },
  {
   "start": 623.02,
   "end": 624.6,
   "text": "על מכירת יוסף,"
  },
  {
   "start": 625.28,
   "end": 627.06,
   "text": "שמכרו אותו האחים שלו."
  },
  {
   "start": 627.92,
   "end": 631.54,
   "text": "אתה יודע, מידת הדין מקטרגת כל יום,"
  },
  {
   "start": 631.88,
   "end": 635.08,
   "text": "כל יום לפני הכיסא הכבוד, ואומרת,"
  },
  {
   "start": 635.88,
   "end": 637.88,
   "text": "בורא עולם, ריבונו של עולם,"
  },
  {
   "start": 638.54,
   "end": 641.88,
   "text": "וכי כתבת בתורתך אות אחת לבטלה?"
  },
  {
   "start": 643.44,
   "end": 645.98,
   "text": "כתבת בתורה שלך אות אחת לבטלה?"
  },
  {
   "start": 646.96,
   "end": 647.78,
   "text": "הרי השבטים,"
  },
  {
   "start": 648.62,
   "end": 650.74,
   "text": "אותם שבטים שמכרו את יוסף,"
  },
  {
   "start": 655.88,
   "end": 658.32,
   "text": "ולא פרעת מהם עדיין,"
  },
  {
   "start": 659.98,
   "end": 661.18,
   "text": "לא מהם"
  },
  {
   "start": 662.66,
   "end": 664.16,
   "text": "ולא מזרעם,"
  },
  {
   "start": 666.48,
   "end": 671.54,
   "text": "לכן עתה נגזרה הגזרה על עשרה גדולי ישראל,"
  },
  {
   "start": 671.54,
   "end": 675.02,
   "text": "שייהרגו בידי מלכות הרשעה."
  },
  {
   "start": 676.86,
   "end": 678.24,
   "text": "אמר לו רבי ישמעאל,"
  },
  {
   "start": 680.22,
   "end": 683.26,
   "text": "גבריאל המלאך, גבריאל המלאך,"
  },
  {
   "start": 684.16,
   "end": 686.36,
   "text": "עד עתה לא מצא הקדוש ברוך הוא"
  },
  {
   "start": 687.48,
   "end": 690.08,
   "text": "איך לפרוע את עוון השבטים הקדושים,"
  },
  {
   "start": 691.1,
   "end": 692.02,
   "text": "אלא רק בנו."
  },
  {
   "start": 694.34,
   "end": 695.88,
   "text": "ענה לו המלאך גבריאל,"
  },
  {
   "start": 697.2,
   "end": 697.98,
   "text": "חיי נפשך,"
  },
  {
   "start": 699.04,
   "end": 702.66,
   "text": "חיי נפשך, ישמעאל בני, ישמעאל בני,"
  },
  {
   "start": 703.38,
   "end": 706.66,
   "text": "שמיום שמכרו השבטים את יוסף,"
  },
  {
   "start": 707.58,
   "end": 710.34,
   "text": "לא מצא הקדוש ברוך הוא בדור אחד"
  },
  {
   "start": 711.1,
   "end": 715.36,
   "text": "עשרה צדיקים וחסידים כמו השבטים."
  },
  {
   "start": 716.54,
   "end": 718.6,
   "text": "לכן הקדוש ברוך הוא פורע מכם."
  },
  {
   "start": 724.08,
   "end": 730.04,
   "text": "אבל אני אגיד לך, כיוון שראה אותו מלאך רשע שמסתין על עם ישראל,"
  },
  {
   "start": 730.84,
   "end": 733.42,
   "text": "שביקש הקדוש ברוך הוא לחתום,"
  },
  {
   "start": 734.4,
   "end": 738.1,
   "text": "למסור עשרה צדיקים ביד מלכות הרשעה,"
  },
  {
   "start": 738.7,
   "end": 740.56,
   "text": "הוא שמח שמחה כל כך גדולה,"
  },
  {
   "start": 742.04,
   "end": 743.84,
   "text": "והיה מתפאר לומר, ניצחתי,"
  },
  {
   "start": 744.5,
   "end": 747.22,
   "text": "ניצחתי את מיכאל, שרו של ישראל."
  },
  {
   "start": 749.3,
   "end": 749.62,
   "text": "מיד"
  },
  {
   "start": 750.58,
   "end": 753.16,
   "text": "חרא אפו של הקדוש ברוך הוא על אותו מלאך,"
  },
  {
   "start": 754.18,
   "end": 754.98,
   "text": "ואמר לו, תדע לך,"
  },
  {
   "start": 756.1,
   "end": 757.14,
   "text": "אתה תצטרך להחליט"
  },
  {
   "start": 758.42,
   "end": 759.22,
   "text": "אחת משתיים,"
  },
  {
   "start": 764.45,
   "end": 768.81,
   "text": "או שאתה תקבל עונש לעתיד לבוא כשיבוא המשיח,"
  },
  {
   "start": 769.47,
   "end": 770.39,
   "text": "או שתוותר,"
  },
  {
   "start": 772.19,
   "end": 778.37,
   "text": "או שאתה עצמך תפטור את עשרה חכמי ישראל,"
  },
  {
   "start": 779.69,
   "end": 782.33,
   "text": "או שתקבל עליך הצהרת לעולם הבא,"
  },
  {
   "start": 782.91,
   "end": 785.53,
   "text": "תהיה מנודה בעולם הבא, תסבול בעולם הבא."
  },
  {
   "start": 787.55,
   "end": 789.45,
   "text": "אמר לו אותו מלאך,"
  },
  {
   "start": 790.23,
   "end": 792.55,
   "text": "לא אפטור עשרה צדיקים מההריגה,"
  },
  {
   "start": 792.89,
   "end": 796.11,
   "text": "ואני מקבל עלי את הגזירה כאשר דיברת, כך הוא אמר."
  },
  {
   "start": 797.51,
   "end": 801.31,
   "text": "הוא הסכים לקבל עליו גזירה כזאת נוראה לעולם הבא,"
  },
  {
   "start": 801.65,
   "end": 804.65,
   "text": "ובלבד לא לוותר לאותם עשרה צדיקים."
  },
  {
   "start": 808.15,
   "end": 809.93,
   "text": "חרע אפו של הקדוש ברוך הוא"
  },
  {
   "start": 810.87,
   "end": 811.57,
   "text": "על אותו מלאך."
  },
  {
   "start": 813.03,
   "end": 818.39,
   "text": "ולא הספיק את דבריו עד שקרע הקדוש ברוך הוא אל השר הגדול הסופר, ואמר לו, תכתוב את החתום."
  },
  {
   "start": 819.45,
   "end": 823.51,
   "text": "נגע, צרע, צאי עץ, ספחת, בהרת, ירקון, שכין רע על עדו מרשעה."
  },
  {
   "start": 823.51,
   "end": 831.99,
   "text": "וגופרית ואש על האדם ועל הבהמה ועל הכסף ועל הזהב ועל כל אשר להם עד שכל אחד יגיד לכם"
  },
  {
   "start": 832.61,
   "end": 835.93,
   "text": "בוא בוא נקנה את כולם בשקל ואף אחד לא ירצה."
  },
  {
   "start": 840.5,
   "end": 841.56,
   "text": "שמע את זה רבי ישמעאל"
  },
  {
   "start": 842.4,
   "end": 843.3,
   "text": "שמע את הגזרה"
  },
  {
   "start": 844.4,
   "end": 845.4,
   "text": "שמע את החתימה"
  },
  {
   "start": 846.34,
   "end": 847.56,
   "text": "נתקררה דעתו"
  },
  {
   "start": 849.0,
   "end": 850.58,
   "text": "והיה הולך ברקיעה"
  },
  {
   "start": 851.1,
   "end": 851.94,
   "text": "ענה וענה"
  },
  {
   "start": 853.72,
   "end": 854.2,
   "text": "לפתע"
  },
  {
   "start": 854.9,
   "end": 855.78,
   "text": "שם ברקיעה"
  },
  {
   "start": 857.66,
   "end": 861.16,
   "text": "הוא ראה מזבח סמוך לכיסא הכבוד,"
  },
  {
   "start": 862.38,
   "end": 865.14,
   "text": "סמוך לרקיע ערבות לכיסא הכבוד."
  },
  {
   "start": 865.72,
   "end": 866.52,
   "text": "היה שם מזבח."
  },
  {
   "start": 869.19,
   "end": 870.27,
   "text": "פנה רבי ישמעאל,"
  },
  {
   "start": 870.87,
   "end": 873.41,
   "text": "כהן גדול ואמר לגבריאל המלאך, מה זה?"
  },
  {
   "start": 874.21,
   "end": 875.17,
   "text": "אמר לו, זה מזבח."
  },
  {
   "start": 876.49,
   "end": 878.59,
   "text": "ומה אתם מקריבים עליו בכל יום?"
  },
  {
   "start": 879.27,
   "end": 880.13,
   "text": "מה, יש פה פרים?"
  },
  {
   "start": 880.87,
   "end": 881.45,
   "text": "יש פה כבשים?"
  },
  {
   "start": 882.19,
   "end": 882.83,
   "text": "מה זה מזבח?"
  },
  {
   "start": 883.69,
   "end": 885.07,
   "text": "אני כהן בבית המקדש,"
  },
  {
   "start": 885.63,
   "end": 886.99,
   "text": "אז יש מזבח, מקריבים עליו קורבנות."
  },
  {
   "start": 887.21,
   "end": 889.65,
   "text": "אבל פה בשמיים למעלה,"
  },
  {
   "start": 890.35,
   "end": 893.79,
   "text": "מה מקריבים במזבח הזה שליד כיסא הכבוד?"
  },
  {
   "start": 895.67,
   "end": 897.95,
   "text": "ענה לו המלאך גבריאל,"
  },
  {
   "start": 898.83,
   "end": 899.65,
   "text": "פה על המזבח"
  },
  {
   "start": 900.59,
   "end": 903.83,
   "text": "מוקרבים נפשות של צדיקים,"
  },
  {
   "start": 904.53,
   "end": 909.03,
   "text": "שאנו מקריבים עליו בכל יום את כל המסירות נפש,"
  },
  {
   "start": 909.51,
   "end": 914.05,
   "text": "את כל המסירות נפש יהודי מוסר נפש לכבוד השם יתברך,"
  },
  {
   "start": 914.75,
   "end": 920.69,
   "text": "את אותה מסירות נפש עולה אל אותו מזבח כריח ניחוח לפני כיסא הכבוד,"
  },
  {
   "start": 921.23,
   "end": 922.73,
   "text": "לפני השם יתברך."
  },
  {
   "start": 929.12,
   "end": 932.68,
   "text": "מיד ירד רבי ישמעאל והגיע לארץ,"
  },
  {
   "start": 933.48,
   "end": 940.8,
   "text": "והיא אמר לחברים שלו שכבר נגזרה גזירה ונכתב ונחתם ואין מה לעשות."
  },
  {
   "start": 944.04,
   "end": 944.46,
   "text": "והיו,"
  },
  {
   "start": 945.54,
   "end": 946.68,
   "text": "היו מתאוננים קצת"
  },
  {
   "start": 947.22,
   "end": 949.7,
   "text": "בימין על שנגזרה עליהם גזירה קשה כזאת,"
  },
  {
   "start": 950.42,
   "end": 951.52,
   "text": "ושמחים בשמאל,"
  },
  {
   "start": 952.24,
   "end": 956.04,
   "text": "על שכלן הקדוש ברוך הוא בצדקות ובחסידות נגד השבטים."
  },
  {
   "start": 957.18,
   "end": 961.18,
   "text": "ויושבים עשרה חכמי ישראל, עשרה גדולי הדור,"
  },
  {
   "start": 961.94,
   "end": 962.64,
   "text": "זוגות-זוגות,"
  },
  {
   "start": 963.18,
   "end": 966.14,
   "text": "רבי ישמעאל כהן גדול ורבן שמעון בן גמליאל,"
  },
  {
   "start": 966.94,
   "end": 967.54,
   "text": "רבי עקיבא"
  },
  {
   "start": 968.32,
   "end": 969.48,
   "text": "ורבי חנניה בן תרדיון,"
  },
  {
   "start": 970.04,
   "end": 972.84,
   "text": "רבי אלעזר בן שמוע ורבי אשבב הסופר,"
  },
  {
   "start": 973.26,
   "end": 976.0,
   "text": "רבי חנניה בן חכינאי ורבי יהודה בן בבא,"
  },
  {
   "start": 976.52,
   "end": 980.16,
   "text": "רבי חוצפית המתורגמן ורבי יהודה בן דמה."
  },
  {
   "start": 1014.62,
   "end": 1015.38,
   "text": "קנס הקיסר"
  },
  {
   "start": 1016.78,
   "end": 1018.26,
   "text": "וכל גדולי רומי אחריו."
  },
  {
   "start": 1020.22,
   "end": 1022.22,
   "text": "אמר להם הקיסר, מי יהרג תחילה?"
  },
  {
   "start": 1023.7,
   "end": 1025.98,
   "text": "אנא רבי שענא רבי אנשי בון מגמליאל,"
  },
  {
   "start": 1027.3,
   "end": 1027.6,
   "text": "אני אני,"
  },
  {
   "start": 1028.2,
   "end": 1028.86,
   "text": "אני אהרג תחילה."
  },
  {
   "start": 1029.78,
   "end": 1030.28,
   "text": "אני נשיא,"
  },
  {
   "start": 1031.1,
   "end": 1031.8,
   "text": "בן נשיא,"
  },
  {
   "start": 1032.38,
   "end": 1034.58,
   "text": "מזרעו של דוד מלך ישראל עליו השלום,"
  },
  {
   "start": 1035.3,
   "end": 1036.32,
   "text": "אני אהרג תחילה."
  },
  {
   "start": 1037.96,
   "end": 1039.78,
   "text": "אנא רבי ישמעאל כהן גדול ואמר,"
  },
  {
   "start": 1040.52,
   "end": 1041.4,
   "text": "אני כהן גדול,"
  },
  {
   "start": 1042.3,
   "end": 1045.24,
   "text": "בן כהן גדול, מזרעו של אהרן הכהן,"
  },
  {
   "start": 1045.94,
   "end": 1047.04,
   "text": "אני איהרג תחילה."
  },
  {
   "start": 1048.56,
   "end": 1050.14,
   "text": "אמר הקיסר המום כולו,"
  },
  {
   "start": 1051.22,
   "end": 1052.54,
   "text": "זה אמר אני איהרג תחילה,"
  },
  {
   "start": 1053.34,
   "end": 1054.94,
   "text": "וזה אמר אני איהרג תחילה."
  },
  {
   "start": 1056.08,
   "end": 1057.9,
   "text": "אם כן, תפילו גורלות ביניכם."
  },
  {
   "start": 1059.48,
   "end": 1060.22,
   "text": "הם הפילו גורל,"
  },
  {
   "start": 1061.92,
   "end": 1062.98,
   "text": "ונפל הגורל"
  },
  {
   "start": 1063.78,
   "end": 1065.26,
   "text": "על רבן שמעון בן גמליאל."
  },
  {
   "start": 1091.26,
   "end": 1092.14,
   "text": "ציווה הקיסר"
  },
  {
   "start": 1092.9,
   "end": 1094.86,
   "text": "לקחת את רבן שמעון בן גמליאל"
  },
  {
   "start": 1095.56,
   "end": 1096.62,
   "text": "ולחתוך את ראשו,"
  },
  {
   "start": 1099.48,
   "end": 1105.74,
   "text": "ואותם רומאים אכזרים תפסו את גדול הדור נשיא ישראל וחתכו את ראשו."
  },
  {
   "start": 1107.24,
   "end": 1109.12,
   "text": "ראה את זה רבי ישמעאל כהן גדול,"
  },
  {
   "start": 1109.76,
   "end": 1115.06,
   "text": "נטל את ראשו בין ירחיו וצבח עליו במר נפש,"
  },
  {
   "start": 1115.86,
   "end": 1117.78,
   "text": "ואמר אה תורה ואה שכרה,"
  },
  {
   "start": 1118.34,
   "end": 1122.92,
   "text": "הלשון הזו שהייתה מבארת את התורה בשבעים לשונות,"
  },
  {
   "start": 1123.66,
   "end": 1125.72,
   "text": "איך עתה לוחכת את העפר,"
  },
  {
   "start": 1128.46,
   "end": 1130.52,
   "text": "והיה בוכה על רבן שמעון מגמליאל."
  },
  {
   "start": 1131.9,
   "end": 1135.54,
   "text": "ראה את זה הקיסר, אמר לו, תגיד לי, על מה אתה בוכה? אתה בוכה על החברים שלך?"
  },
  {
   "start": 1136.14,
   "end": 1139.84,
   "text": "אתה בוכה על החבר שלך? תבכה על עצמך, אתה הבא בתור!"
  },
  {
   "start": 1141.2,
   "end": 1146.74,
   "text": "אמר לו רבי ישמעאל לאותו קיסר, אני לא בוכה על עצמי,"
  },
  {
   "start": 1148.26,
   "end": 1149.24,
   "text": "אלא אני בוכה שהוא"
  },
  {
   "start": 1149.86,
   "end": 1152.56,
   "text": "קדים אותי, אותו חבר, בישיבה של מעלה."
  },
  {
   "start": 1153.44,
   "end": 1155.82,
   "text": "על זה אני בוכה שהוא זכה למות לפניי."
  },
  {
   "start": 1159.0,
   "end": 1159.62,
   "text": "עוד הוא מדבר."
  },
  {
   "start": 1159.72,
   "end": 1163.82,
   "text": "ובוכה על רבן שמעון בן גמליאל."
  },
  {
   "start": 1165.48,
   "end": 1167.64,
   "text": "הביטה מבעד לחלון,"
  },
  {
   "start": 1168.3,
   "end": 1169.1,
   "text": "הבת של הקיסר,"
  },
  {
   "start": 1170.34,
   "end": 1173.32,
   "text": "והיא רואה את רבי ישמעאל כהן גדול."
  },
  {
   "start": 1174.24,
   "end": 1176.34,
   "text": "אמרו עליו על רבי ישמעאל כהן גדול,"
  },
  {
   "start": 1177.0,
   "end": 1179.62,
   "text": "שהיה משבעה יפים שהיו בעולם,"
  },
  {
   "start": 1180.68,
   "end": 1182.96,
   "text": "שהיה משבעה יפים שהיו בעולם,"
  },
  {
   "start": 1183.6,
   "end": 1186.46,
   "text": "והיו פניו דומות למלאך השם צבחות."
  },
  {
   "start": 1188.06,
   "end": 1188.7,
   "text": "והיא ראתה אותו,"
  },
  {
   "start": 1189.38,
   "end": 1190.08,
   "text": "את היופי שלו."
  },
  {
   "start": 1191.8,
   "end": 1195.0,
   "text": "ונכמרו רחמיה ושלחה לאבא שלה,"
  },
  {
   "start": 1195.64,
   "end": 1196.62,
   "text": "יש לי בקשה אחת,"
  },
  {
   "start": 1197.3,
   "end": 1198.82,
   "text": "יש לי שאלה אחת ממך, אבא."
  },
  {
   "start": 1200.04,
   "end": 1201.66,
   "text": "שלח לה הקיסר, בתי,"
  },
  {
   "start": 1202.08,
   "end": 1204.3,
   "text": "כל מה שתאמרי אני אעשה,"
  },
  {
   "start": 1204.96,
   "end": 1205.86,
   "text": "חוץ מדבר אחד,"
  },
  {
   "start": 1206.88,
   "end": 1207.86,
   "text": "רבי ישמעאל"
  },
  {
   "start": 1208.76,
   "end": 1209.7,
   "text": "והחברים שלו,"
  },
  {
   "start": 1210.42,
   "end": 1210.76,
   "text": "זה לא."
  },
  {
   "start": 1212.16,
   "end": 1212.92,
   "text": "אני מבקשת,"
  },
  {
   "start": 1213.86,
   "end": 1215.4,
   "text": "תחיה אותו, אני רוצה אותו."
  },
  {
   "start": 1216.86,
   "end": 1218.18,
   "text": "התחננה בתו של הקיסר,"
  },
  {
   "start": 1218.94,
   "end": 1219.82,
   "text": "אמר לה, לא,"
  },
  {
   "start": 1220.46,
   "end": 1221.14,
   "text": "אני כבר נשבעתי."
  },
  {
   "start": 1224.31,
   "end": 1225.53,
   "text": "אמרה לו, טוב, אם ככה,"
  },
  {
   "start": 1226.25,
   "end": 1227.03,
   "text": "אני מבקשת ממך."
  },
  {
   "start": 1228.63,
   "end": 1229.53,
   "text": "תראו איזה אכזריות."
  },
  {
   "start": 1231.89,
   "end": 1232.37,
   "text": "אם כן,"
  },
  {
   "start": 1233.07,
   "end": 1236.67,
   "text": "לפחות תצווה להפשיט את עור הפנים שלו,"
  },
  {
   "start": 1237.31,
   "end": 1238.33,
   "text": "הכל-כך יפות,"
  },
  {
   "start": 1238.87,
   "end": 1241.19,
   "text": "שאני אוכל לעשות כמו פוחלץ,"
  },
  {
   "start": 1241.57,
   "end": 1244.21,
   "text": "שאני אוכל להסתכל בו במקום מראה."
  },
  {
   "start": 1244.83,
   "end": 1247.11,
   "text": "אני אוכל להסתכל בעור הפנים שלו, בפנים שלו."
  },
  {
   "start": 1248.05,
   "end": 1250.65,
   "text": "תפשיט בבקשה את עור פניו כשאתה הורג אותו."
  },
  {
   "start": 1262.64,
   "end": 1263.78,
   "text": "מיד ציווה הקיסר"
  },
  {
   "start": 1264.52,
   "end": 1265.68,
   "text": "להפשיט את עור פניו."
  },
  {
   "start": 1266.84,
   "end": 1267.42,
   "text": "וכיוון"
  },
  {
   "start": 1268.36,
   "end": 1270.34,
   "text": "שהגיעו למקום תפילין,"
  },
  {
   "start": 1272.98,
   "end": 1275.88,
   "text": "צעק רבי ישמעאל כהן גדול,"
  },
  {
   "start": 1276.96,
   "end": 1279.3,
   "text": "צעקה גדולה ומרה,"
  },
  {
   "start": 1290.07,
   "end": 1299.65,
   "text": "ונזדעזעה שמיים וארץ, צעק פעם שנייה,"
  },
  {
   "start": 1300.75,
   "end": 1305.79,
   "text": "ונזדעזעה כיסא הכבוד."
  },
  {
   "start": 1319.58,
   "end": 1322.76,
   "text": "אמרו מלאכי השרת לפני הקדוש ברוך הוא,"
  },
  {
   "start": 1325.4,
   "end": 1326.68,
   "text": "איזו זעקה."
  },
  {
   "start": 1334.47,
   "end": 1335.43,
   "text": "צדיק כזה,"
  },
  {
   "start": 1336.01,
   "end": 1344.63,
   "text": "אמרו כמלאכי השרת לפני הקדוש ברוך הוא, צדיק כזה, שהראת לו את כל גנזי העולם, עליונים ורזי תחתונים, יהרג במיתה משונה מזה הרשע,"
  },
  {
   "start": 1345.21,
   "end": 1346.65,
   "text": "זו תורה וזו זכרה."
  },
  {
   "start": 1347.29,
   "end": 1350.79,
   "text": "אמר להם, תניחו לו שתעמוד זכותו לדורות אחריו."
  },
  {
   "start": 1354.04,
   "end": 1356.7,
   "text": "אמר הקדוש ברוך הוא, מעשה לבניי גזירה היא,"
  },
  {
   "start": 1357.26,
   "end": 1358.38,
   "text": "ואין מי שיפר אותה."
  },
  {
   "start": 1359.38,
   "end": 1361.54,
   "text": "ורבי ישמעאל זועק,"
  },
  {
   "start": 1362.14,
   "end": 1365.26,
   "text": "יצתה בת קול ואמרה, אם אשמע קול אחר,"
  },
  {
   "start": 1365.9,
   "end": 1369.24,
   "text": "אהפוך את כל העולם לתוהו ובוהו."
  },
  {
   "start": 1370.18,
   "end": 1374.72,
   "text": "רבי ישמעאל, אם תמשיך לבכות, אני הופך את כל העולם לתוהו ובוהו."
  },
  {
   "start": 1375.24,
   "end": 1376.0,
   "text": "רק אל תזעק!"
  },
  {
   "start": 1390.4,
   "end": 1391.06,
   "text": "בת קול ואמרה,"
  },
  {
   "start": 1392.12,
   "end": 1393.08,
   "text": "אם אשמע קול אחר,"
  },
  {
   "start": 1398.82,
   "end": 1400.94,
   "text": "אהפוך את כל העולם לתוהו ובוהו."
  },
  {
   "start": 1401.76,
   "end": 1404.42,
   "text": "כששמע כך רבי ישמעאל, כהן גדול,"
  },
  {
   "start": 1405.26,
   "end": 1407.56,
   "text": "חרק שיניים ושתק."
  },
  {
   "start": 1413.2,
   "end": 1414.16,
   "text": "אמר לו הקיסר,"
  },
  {
   "start": 1415.06,
   "end": 1420.84,
   "text": "עד עכשיו לא בכית ולא צעקת, עכשיו אתה צועק."
  },
  {
   "start": 1425.19,
   "end": 1427.61,
   "text": "אמר לו, לא על נשמתי אני צועק,"
  },
  {
   "start": 1432.96,
   "end": 1437.6,
   "text": "אלא על מצוות תפילין, על המצוות שלוקחים ממני."
  },
  {
   "start": 1439.91,
   "end": 1443.73,
   "text": "אמר לו הקיסר, גם ברגעים כאלה אתה מחובר אל השם יתברך."
  },
  {
   "start": 1444.69,
   "end": 1449.49,
   "text": "אמר לו, הוא יקטלנו, הוא יהרוג אותי, לא אתה, הוא הורג אותי, ולא, אני מייחל אותו, אני אוהב."
  },
  {
   "start": 1451.69,
   "end": 1455.47,
   "text": "מיד יצאה נשמתו של רבי ישמעאל,"
  },
  {
   "start": 1458.56,
   "end": 1459.44,
   "text": "אותו רבי ישמעאל,"
  },
  {
   "start": 1460.32,
   "end": 1464.26,
   "text": "שזכותו עומדת לדורות שאחריו, לדורות שלנו."
  }
 ]
}