{
 "disc": "28צ- הרוגי מלכות",
 "track": "Track03",
 "duration": 777.168,
 "segments": [
  {
   "start": 3.22,
   "end": 3.8,
   "text": "הגיע תורו"
  },
  {
   "start": 4.7,
   "end": 6.32,
   "text": "של רבי חנניה בן תירדיון."
  },
  {
   "start": 8.2,
   "end": 8.82,
   "text": "אמרו עליו,"
  },
  {
   "start": 9.64,
   "end": 11.22,
   "text": "על רבי חנניה בן תירדיון,"
  },
  {
   "start": 12.1,
   "end": 14.6,
   "text": "שהיה נעים בפני הקדוש ברוך הוא, בפני האדם."
  },
  {
   "start": 15.9,
   "end": 16.66,
   "text": "ומעולם,"
  },
  {
   "start": 17.44,
   "end": 19.82,
   "text": "אבל מעולם לא עלתה קללת חברו על שפתו,"
  },
  {
   "start": 22.27,
   "end": 26.53,
   "text": "כשציווה הקיסר ברומי שאף אחד לא ילמד תורה."
  },
  {
   "start": 26.99,
   "end": 28.99,
   "text": "אתם יודעים מה עשה רבי חנניה בן תירדיון?"
  },
  {
   "start": 30.53,
   "end": 33.07,
   "text": "הוא עמד והקהיל קהילות ברבים."
  },
  {
   "start": 34.97,
   "end": 35.97,
   "text": "למרות הגזירה,"
  },
  {
   "start": 36.83,
   "end": 39.47,
   "text": "הוא ישב לו שמה בשווקים של רומי"
  },
  {
   "start": 40.17,
   "end": 43.27,
   "text": "והיה לומד ועוסק ודורש בתורה לפני כולם."
  },
  {
   "start": 46.28,
   "end": 47.16,
   "text": "ציווה הקיסר"
  },
  {
   "start": 47.98,
   "end": 49.82,
   "text": "לקחת את רבי חנניה בן תירדיון,"
  },
  {
   "start": 50.5,
   "end": 55.1,
   "text": "לכרוך אותו בספר תורה ולשרוף אותו בצורה הזאת,"
  },
  {
   "start": 55.92,
   "end": 59.26,
   "text": "את ספר התורה ואת רבי חנניה בן תירדיון."
  },
  {
   "start": 61.3,
   "end": 65.14,
   "text": "התליין קוסטינור לקח אותו,"
  },
  {
   "start": 65.9,
   "end": 67.7,
   "text": "כרך אותו בספר התורה."
  },
  {
   "start": 71.59,
   "end": 73.07,
   "text": "הוא שם ספוג של צמר,"
  },
  {
   "start": 73.99,
   "end": 75.09,
   "text": "השרה את זה במים,"
  },
  {
   "start": 76.03,
   "end": 77.53,
   "text": "ושם את זה על הלב שלו,"
  },
  {
   "start": 78.53,
   "end": 80.63,
   "text": "כדי שלא תצא נשמתו בטהרה,"
  },
  {
   "start": 81.59,
   "end": 83.97,
   "text": "לא תצא נשמתו במהרה,"
  },
  {
   "start": 84.59,
   "end": 85.93,
   "text": "יסבול בייסורים,"
  },
  {
   "start": 87.51,
   "end": 88.77,
   "text": "ימות מייסורים."
  },
  {
   "start": 92.74,
   "end": 94.12,
   "text": "ואז הוא הדליק את האש,"
  },
  {
   "start": 95.24,
   "end": 97.82,
   "text": "ובתו של רבי חננה בן תרדיון עומדת,"
  },
  {
   "start": 98.76,
   "end": 99.98,
   "text": "רואה את אבא שלה,"
  },
  {
   "start": 101.58,
   "end": 102.66,
   "text": "מתייסר."
  },
  {
   "start": 105.41,
   "end": 106.23,
   "text": "אמרה אבא,"
  },
  {
   "start": 106.89,
   "end": 109.27,
   "text": "אוי לי אבא שראיתי אותך ככה."
  },
  {
   "start": 110.79,
   "end": 112.67,
   "text": "אמר לה רבי חננה בן תרדיון,"
  },
  {
   "start": 113.41,
   "end": 116.29,
   "text": "טוב לי בתי שראית אותי בכך."
  },
  {
   "start": 119.84,
   "end": 124.66,
   "text": "ותלמידיו היו עומדים עליו ואומרים רבנו, מה אתה רואה?"
  },
  {
   "start": 125.34,
   "end": 126.34,
   "text": "אמר להם,"
  },
  {
   "start": 127.5,
   "end": 128.72,
   "text": "אמר להם,"
  },
  {
   "start": 129.66,
   "end": 131.94,
   "text": "אני רואה גבילים נשרפים,"
  },
  {
   "start": 132.42,
   "end": 134.44,
   "text": "אותיות פורחים באוויר,"
  },
  {
   "start": 134.98,
   "end": 136.5,
   "text": "ואז הוא התחיל לבכות."
  },
  {
   "start": 137.04,
   "end": 139.66,
   "text": "אמרו לו, תלמידיו, רבי, בבנימה אתה בוכה?"
  },
  {
   "start": 140.22,
   "end": 144.04,
   "text": "אמר להם, אם אני לבדי נשרף, לא היה קשה לי,"
  },
  {
   "start": 144.6,
   "end": 145.76,
   "text": "אבל עכשיו אני נשרף."
  },
  {
   "start": 146.64,
   "end": 148.7,
   "text": "וספר תורה עימי..."
  },
  {
   "start": 149.12,
   "end": 149.9,
   "text": "ראה את זה הקוסטינור,"
  },
  {
   "start": 151.0,
   "end": 152.2,
   "text": "ראה את זה התליין הרומאי,"
  },
  {
   "start": 154.91,
   "end": 157.09,
   "text": "ורצה להתקרב אל אותו עם מופלא,"
  },
  {
   "start": 158.07,
   "end": 159.89,
   "text": "אל אותה גדלות נפש עצומה."
  },
  {
   "start": 160.67,
   "end": 164.07,
   "text": "אמר הקוסטינור הרומאי, אמר רבי,"
  },
  {
   "start": 164.61,
   "end": 168.47,
   "text": "אם אני מסלק את אותם ספוגים של צמר רטובים על הלב שלך,"
  },
  {
   "start": 169.01,
   "end": 170.81,
   "text": "כדי שנשמתך תצא במהרה,"
  },
  {
   "start": 171.53,
   "end": 173.53,
   "text": "אתה מביא אותי לחיי העולם הבא."
  },
  {
   "start": 175.03,
   "end": 176.59,
   "text": "ראה רבי חנא בן תירדיון"
  },
  {
   "start": 177.29,
   "end": 179.09,
   "text": "שהרומאי מוכן להסתכן,"
  },
  {
   "start": 179.51,
   "end": 181.73,
   "text": "מוכן למות, הרי יתפסו אותו על זה ויהרגו אותו."
  },
  {
   "start": 182.79,
   "end": 184.45,
   "text": "כדי להצטרף לעם ישראל,"
  },
  {
   "start": 184.97,
   "end": 185.87,
   "text": "אמר לו כן,"
  },
  {
   "start": 188.68,
   "end": 190.06,
   "text": "אמר לו רבי תישבע לי."
  },
  {
   "start": 191.02,
   "end": 191.64,
   "text": "נשבע לו,"
  },
  {
   "start": 192.78,
   "end": 193.82,
   "text": "מיד שנשבע לו,"
  },
  {
   "start": 193.82,
   "end": 196.7,
   "text": "הרבה אותו קוסטינור את האש,"
  },
  {
   "start": 197.3,
   "end": 198.3,
   "text": "הוציא את הספוגים,"
  },
  {
   "start": 199.48,
   "end": 200.64,
   "text": "ויצתה נשמתו"
  },
  {
   "start": 202.16,
   "end": 204.18,
   "text": "של רבי חנניה בן תירדיון."
  },
  {
   "start": 208.24,
   "end": 208.5,
   "text": "ואז"
  },
  {
   "start": 209.06,
   "end": 210.02,
   "text": "אותו קוסטינור"
  },
  {
   "start": 210.66,
   "end": 212.4,
   "text": "השליך את עצמו עפו באש,"
  },
  {
   "start": 213.08,
   "end": 216.2,
   "text": "ונשרף יחד עם רבי חנניה בן תירדיון."
  },
  {
   "start": 216.94,
   "end": 218.4,
   "text": "היא יצתה בת קול ואמרה,"
  },
  {
   "start": 219.04,
   "end": 221.24,
   "text": "רבי חנניה בן תירדיון"
  },
  {
   "start": 222.18,
   "end": 226.16,
   "text": "וקוסטינור מזומנים לחיי העולם הבא."
  },
  {
   "start": 227.56,
   "end": 228.78,
   "text": "בכה רבי ואמר,"
  },
  {
   "start": 229.46,
   "end": 231.56,
   "text": "יש קונה עולמו בשעה אחת."
  },
  {
   "start": 232.9,
   "end": 233.82,
   "text": "כמו זה הקוסטינור,"
  },
  {
   "start": 234.72,
   "end": 237.24,
   "text": "ויש אדם שעובד את השם כל ימי חייו,"
  },
  {
   "start": 237.82,
   "end": 239.88,
   "text": "ומפסיד את כל השכר בשעה אחת."
  },
  {
   "start": 240.48,
   "end": 242.02,
   "text": "זה אותו יוחנן כהן גדול,"
  },
  {
   "start": 242.48,
   "end": 245.0,
   "text": "ששימש 80 שנה בכהונה גדולה,"
  },
  {
   "start": 245.48,
   "end": 247.36,
   "text": "ולבסוף נעשה צדוקי."
  },
  {
   "start": 257.45,
   "end": 259.49,
   "text": "ואחריו הוציאו את רבי יהודה בן בבא,"
  },
  {
   "start": 260.17,
   "end": 262.65,
   "text": "שלא טעם טעם שינה אלא כשנת הסוס."
  },
  {
   "start": 263.17,
   "end": 267.45,
   "text": "מגיל שמונה עשרה שנה ועד שמונים שנה הוא לא ישן יותר מחצי שעה."
  },
  {
   "start": 269.47,
   "end": 272.91,
   "text": "כשיצתה נשמתו יצתה בת קול ואמרה,"
  },
  {
   "start": 273.87,
   "end": 280.53,
   "text": "אשריך רבי יהודה בן בבא שהיית דומה למלאך ויצתה נשמתך באלוקים."
  },
  {
   "start": 290.41,
   "end": 292.03,
   "text": "אמרו עליו, על רבי יהודה בן בבא,"
  },
  {
   "start": 293.69,
   "end": 295.53,
   "text": "שהוא לא טעמתם חטא מימיו"
  },
  {
   "start": 296.37,
   "end": 299.65,
   "text": "והוא לא אמר על טמא טהור ועל טהור טמא, מעולם לא טעה"
  },
  {
   "start": 301.76,
   "end": 303.54,
   "text": "ולא היה איש בבית המדרש, הוא לא חידש,"
  },
  {
   "start": 304.0,
   "end": 305.54,
   "text": "לא העיר לו משהו בדברי תורה."
  },
  {
   "start": 306.52,
   "end": 307.74,
   "text": "נתן לו אור בנשמה שלו."
  },
  {
   "start": 309.16,
   "end": 311.06,
   "text": "והוא ישב בתענית 26 שנה."
  },
  {
   "start": 312.7,
   "end": 314.5,
   "text": "והיה בניקיון כל ימי חייו."
  },
  {
   "start": 315.44,
   "end": 318.72,
   "text": "ולא נכשלו חבריו בדבר הלכה עמו ושמח בהם."
  },
  {
   "start": 320.74,
   "end": 322.54,
   "text": "והיה קורא לתלמידים שלו רבי."
  },
  {
   "start": 323.7,
   "end": 326.12,
   "text": "והיה מלמד את התלמידים שלו יומם ולילה."
  },
  {
   "start": 327.88,
   "end": 330.7,
   "text": "ואותו היום שנהרג היה בן 70 שנה."
  },
  {
   "start": 333.85,
   "end": 335.01,
   "text": "והיה שם זקן אחד,"
  },
  {
   "start": 335.79,
   "end": 337.61,
   "text": "רבי ראובן בן איסטרובול שמו."
  },
  {
   "start": 339.57,
   "end": 340.09,
   "text": "אמר לו,"
  },
  {
   "start": 344.74,
   "end": 345.94,
   "text": "רבי יהודה בן בבא,"
  },
  {
   "start": 347.14,
   "end": 348.78,
   "text": "יודע אני שצדיק גמור אתה,"
  },
  {
   "start": 349.9,
   "end": 353.26,
   "text": "אבל מלכות הרשעה העיזה פניה לאבד את כל היהלומים שלנו."
  },
  {
   "start": 354.14,
   "end": 357.7,
   "text": "אולי עם רצונך אמות אני תחתיך ואתה תנצל?"
  },
  {
   "start": 359.02,
   "end": 361.18,
   "text": "חייך רבי יהודה ואמר לו, ראובן אחי,"
  },
  {
   "start": 362.1,
   "end": 365.14,
   "text": "עם גזירת בשר ודם אנחנו לא יכולים לבטל,"
  },
  {
   "start": 365.76,
   "end": 368.36,
   "text": "גזירת מלך מלכי המלכים הקדוש ברוך הוא,"
  },
  {
   "start": 368.98,
   "end": 370.36,
   "text": "מי יכול לבטל אותה?"
  },
  {
   "start": 371.36,
   "end": 376.5,
   "text": "אלא תעזוב, הנח דבריך וברך עלי, ברוך דיין האמת."
  },
  {
   "start": 378.68,
   "end": 384.6,
   "text": "אמרו לו תלמידיו, כבוד הרב, אולי רצונך ככה סעודה אחרונה לטעם משהו לפני שאתה נהרג?"
  },
  {
   "start": 385.38,
   "end": 386.22,
   "text": "אמר להם, תגידו,"
  },
  {
   "start": 386.84,
   "end": 390.74,
   "text": "עד עכשיו לא הייתי יודע עדיין באיזה דרך אני הולך, לא טעמתי כלום."
  },
  {
   "start": 391.34,
   "end": 394.16,
   "text": "עכשיו שאני יודע באיזה דרך אני הולך, אני טעם משהו?"
  },
  {
   "start": 398.18,
   "end": 399.12,
   "text": "ולא טעם כלום,"
  },
  {
   "start": 399.7,
   "end": 402.3,
   "text": "וכך נהרג, ויצתה נשמתו,"
  },
  {
   "start": 402.86,
   "end": 404.18,
   "text": "יצתה בת קול ואמרה,"
  },
  {
   "start": 404.68,
   "end": 407.66,
   "text": "אשריך רבי יהודה בן בבא שגופך נקי,"
  },
  {
   "start": 408.58,
   "end": 411.26,
   "text": "ויצתה נשמתך בנקיות."
  },
  {
   "start": 419.27,
   "end": 424.24,
   "text": "אחריו הוציאו את רבי יהודה בן דמה והרגו אותו,"
  },
  {
   "start": 425.02,
   "end": 430.56,
   "text": "ובא אליהו ולקח את האיברים וקבר אותם במערה אחת הסמוכה לנהר היורד לפני רומי,"
  },
  {
   "start": 431.26,
   "end": 436.18,
   "text": "וכל הרומאים שומעים קול נהי ובכי קול שלושים יום מהמערה."
  },
  {
   "start": 437.1,
   "end": 438.78,
   "text": "באו ואמרו לקיסר, תראה מה זה,"
  },
  {
   "start": 439.28,
   "end": 443.5,
   "text": "מה מה רע שמה של רבי יהודה בן דמה נשמע כל הזמן בכי."
  },
  {
   "start": 453.06,
   "end": 453.62,
   "text": "ואחריו,"
  },
  {
   "start": 454.52,
   "end": 456.62,
   "text": "אחריו הוציאו את רבי חוצפיתא מתורגמן,"
  },
  {
   "start": 462.32,
   "end": 463.98,
   "text": "שהיה שקול כיהונתן בן עוזיאל,"
  },
  {
   "start": 464.8,
   "end": 467.1,
   "text": "שהיה פה שונה 180 פנים בתורת כהנים,"
  },
  {
   "start": 468.92,
   "end": 470.7,
   "text": "ויודע בשבעים לשון ובקי בהם."
  },
  {
   "start": 479.99,
   "end": 482.37,
   "text": "ואחריו הוציאו את רבי חנינא בן חכינאי."
  },
  {
   "start": 485.62,
   "end": 487.48,
   "text": "רבי חנינא בן חכינאי התחיל בקידוש היום,"
  },
  {
   "start": 488.56,
   "end": 489.5,
   "text": "כי היה זה ערב שבת,"
  },
  {
   "start": 490.2,
   "end": 495.74,
   "text": "ויחולו השמיים עד ויקדש ולא הניחו לו לגמור עד שהרגו אותו."
  },
  {
   "start": 496.5,
   "end": 503.86,
   "text": "יצתה בת קול ואמרה אשריך רבי חנינא בן חכיני שהיית קדוש ויצתה נשמתך בקדושה"
  },
  {
   "start": 504.52,
   "end": 506.06,
   "text": "בתיבת ויקדש."
  },
  {
   "start": 513.7,
   "end": 515.42,
   "text": "אחריו הוציאו את רבי אשבבה סופר."
  },
  {
   "start": 522.51,
   "end": 532.06,
   "text": "כשיצתה נשמתו יצתה בת קול ואמרה אשריך רבי אשבבה סופר שלא הנחת מתורת משה כלום ואחריו"
  },
  {
   "start": 534.18,
   "end": 536.38,
   "text": "האחרון הוציאו את רבי אלעזר בן שמוע."
  },
  {
   "start": 537.12,
   "end": 538.98,
   "text": "אמרו עליו רבי אלעזר בן שמוע,"
  },
  {
   "start": 539.5,
   "end": 541.94,
   "text": "שאותו יום שהוציאו אותו להורג היה בן מאה וחמש שנים,"
  },
  {
   "start": 542.78,
   "end": 545.96,
   "text": "ומילדותו ועד סוף ימיו לא שמע אדם שהוציא דבר"
  },
  {
   "start": 547.88,
   "end": 548.72,
   "text": "הבל מפיו,"
  },
  {
   "start": 549.5,
   "end": 552.58,
   "text": "ולא רב עם חבריו, לא בדיבור ולא במעשה,"
  },
  {
   "start": 553.32,
   "end": 556.6,
   "text": "והיה עניו בשפל רוח, וישב בתענית שמונים שנה,"
  },
  {
   "start": 557.34,
   "end": 559.22,
   "text": "ואותו היום שהוציאו אותו להורג,"
  },
  {
   "start": 559.94,
   "end": 560.76,
   "text": "יום כיפורים היה."
  },
  {
   "start": 561.76,
   "end": 564.66,
   "text": "באו התלמידים לפני רבי אלעזר בן שמוע ואמרו לו,"
  },
  {
   "start": 565.0,
   "end": 566.84,
   "text": "רבנו, מה אתה רואה?"
  },
  {
   "start": 567.54,
   "end": 572.26,
   "text": "אמר להם, אני רואה את רבי יהודה בן בבא שמסיעים את מיתתו,"
  },
  {
   "start": 572.86,
   "end": 577.06,
   "text": "ומיתת רבי עקיבא, רבי עקיבא בן יוסף סמוכה אצלו,"
  },
  {
   "start": 577.74,
   "end": 579.2,
   "text": "והם מתווכחים בדבר הלכה."
  },
  {
   "start": 583.89,
   "end": 585.21,
   "text": "אמרו לו תלמידיו,"
  },
  {
   "start": 585.81,
   "end": 587.39,
   "text": "רבנו, מי הכריע ביניהם?"
  },
  {
   "start": 588.07,
   "end": 590.11,
   "text": "אמר להם רבי אלעזר בן שמוע,"
  },
  {
   "start": 590.73,
   "end": 594.59,
   "text": "רבי ישמעאל, כהן גדול, הכריע ביניהם."
  },
  {
   "start": 595.43,
   "end": 596.39,
   "text": "אמרו לו, מי מנצח?"
  },
  {
   "start": 597.59,
   "end": 598.83,
   "text": "אמר להם רבי עקיבא"
  },
  {
   "start": 599.35,
   "end": 601.19,
   "text": "על שטרח בכל כוחו בתורה."
  },
  {
   "start": 602.53,
   "end": 606.81,
   "text": "אמר להם, בניי, אתם יודעים מה אני רואה עוד? אני רואה שנשמט קול צדיק וצדיק"
  },
  {
   "start": 607.23,
   "end": 613.81,
   "text": "מטהרת את עצמה במי השילוח כדי להיכנס היום בטהרה לישיבה של מעלה,"
  },
  {
   "start": 614.53,
   "end": 619.29,
   "text": "לשמוע את דרשותיו של רבי עקיבא בן יוסף שידרוש להם מעניינו של יום,"
  },
  {
   "start": 619.85,
   "end": 626.97,
   "text": "וכל מלאך ומלאך מביא קתדראות של זהב לכל צדיק וצדיק לשבת עליהם בטהרה."
  },
  {
   "start": 628.97,
   "end": 632.33,
   "text": "ואז ציווה הקיסר להרוג את רבי אלעזר בן שמוע."
  },
  {
   "start": 633.37,
   "end": 634.79,
   "text": "יצתה בת קול ואמרה,"
  },
  {
   "start": 635.41,
   "end": 639.11,
   "text": "אשריך רבי אלעזר בן שמוע שהיית טהור,"
  },
  {
   "start": 640.05,
   "end": 643.21,
   "text": "ויצדה נשמתך בטהרה."
  },
  {
   "start": 647.1,
   "end": 647.96,
   "text": "ברגע המוות"
  },
  {
   "start": 648.94,
   "end": 650.58,
   "text": "הוא הספיק להתחיל את קידוש היום,"
  },
  {
   "start": 650.58,
   "end": 654.26,
   "text": "וכשהוא הגיע לאשר ברא אלוהים לעשות,"
  },
  {
   "start": 657.24,
   "end": 660.62,
   "text": "היכו אותו ויצתה נשמתו בתיבת אלוקים."
  },
  {
   "start": 661.28,
   "end": 663.94,
   "text": "יצתה בת קול ואמרה, אשריך, אלעזר,"
  },
  {
   "start": 664.52,
   "end": 666.68,
   "text": "בעולם הזה היית דומה לאלוקים."
  },
  {
   "start": 667.16,
   "end": 671.64,
   "text": "ויצתה נשמתך באלוקים, התברך והתנשא,"
  },
  {
   "start": 672.4,
   "end": 673.26,
   "text": "עילת העילות,"
  },
  {
   "start": 673.88,
   "end": 675.74,
   "text": "שלא נתקנו עלילות,"
  },
  {
   "start": 676.42,
   "end": 677.54,
   "text": "כי עליך הורגנו"
  },
  {
   "start": 678.26,
   "end": 678.8,
   "text": "כל היום."
  },
  {
   "start": 679.56,
   "end": 682.54,
   "text": "כי עליך הורגנו כל היום."
  },
  {
   "start": 695.88,
   "end": 696.82,
   "text": "דהיה בקצרה,"
  },
  {
   "start": 697.7,
   "end": 698.32,
   "text": "מדרש,"
  },
  {
   "start": 699.34,
   "end": 700.08,
   "text": "אלי אזכרה,"
  },
  {
   "start": 703.51,
   "end": 704.65,
   "text": "מסירות נפש"
  },
  {
   "start": 706.31,
   "end": 707.53,
   "text": "של עשרת הרוגי מלכות,"
  },
  {
   "start": 709.61,
   "end": 714.99,
   "text": "שבעולם הבא הם נמצאים בהיכל מיוחד,"
  },
  {
   "start": 718.11,
   "end": 719.61,
   "text": "שם למעלה בגן עדן,"
  },
  {
   "start": 719.99,
   "end": 724.91,
   "text": "היכל מיוחד של עשרת הרוגי מלכות. אין לא ראתה, אלוקים זולתך."
  },
  {
   "start": 731.6,
   "end": 732.26,
   "text": "ובמותם"
  },
  {
   "start": 733.4,
   "end": 734.44,
   "text": "הראינו את הדרך,"
  },
  {
   "start": 735.34,
   "end": 736.96,
   "text": "הייתה דרך אל הידבקות בשם יתברך."
  },
  {
   "start": 737.74,
   "end": 738.34,
   "text": "בדור שלנו"
  },
  {
   "start": 739.16,
   "end": 739.84,
   "text": "הפתרון הוא אחד,"
  },
  {
   "start": 740.48,
   "end": 744.59,
   "text": "לנסור נפש לכבוד השם יתברך."
  },
  {
   "start": 745.03,
   "end": 748.15,
   "text": "לא למות על קידוש השם, לחיות על קידוש השם."
  }
 ]
}