{
 "disc": "28צ- הרוגי מלכות",
 "track": "Track04",
 "duration": 1677.168,
 "segments": [
  {
   "start": 6.11,
   "end": 13.47,
   "text": "לפני רבות בשנים הייתה אימפריה שהשתלטה על רוב העולם,"
  },
  {
   "start": 15.03,
   "end": 15.81,
   "text": "האימפריה היוונית."
  },
  {
   "start": 17.19,
   "end": 18.87,
   "text": "יוון רצתה לשנות את פני העולם."
  },
  {
   "start": 21.36,
   "end": 23.86,
   "text": "יוון נלחמה מלחמה, לא רק מלחמה פיזית בשטח,"
  },
  {
   "start": 25.34,
   "end": 26.12,
   "text": "בשדה הקרב,"
  },
  {
   "start": 27.26,
   "end": 30.66,
   "text": "היא נלחמה מלחמה גם על התרבות של האדם,"
  },
  {
   "start": 31.22,
   "end": 32.7,
   "text": "על האדם לשנות האנשים,"
  },
  {
   "start": 33.58,
   "end": 35.02,
   "text": "שכל העולם יהיה כמוה."
  },
  {
   "start": 37.49,
   "end": 41.19,
   "text": "והיה מקום אחד בעולם שהיא לא הצליחה"
  },
  {
   "start": 42.83,
   "end": 44.55,
   "text": "לנצח אותו מבחינה רוחנית."
  },
  {
   "start": 47.22,
   "end": 50.04,
   "text": "לארץ קרוי ארץ ישראל, לעם קרו עם ישראל."
  },
  {
   "start": 52.08,
   "end": 53.54,
   "text": "פיזית היה אפשר לנצח אותו,"
  },
  {
   "start": 54.14,
   "end": 55.02,
   "text": "אבל בתחום הרוחני"
  },
  {
   "start": 56.88,
   "end": 57.9,
   "text": "הם לא מצליחים לנצח,"
  },
  {
   "start": 58.26,
   "end": 60.82,
   "text": "וזה הפריע להם מאוד. למה? כי הם יודעים שברוחניות,"
  },
  {
   "start": 61.96,
   "end": 64.1,
   "text": "בקדושה, היהודים הם אימפריה."
  },
  {
   "start": 64.84,
   "end": 67.56,
   "text": "זה עם קטן, אבל במבחינה רוחנית, אימפריה."
  },
  {
   "start": 71.13,
   "end": 71.91,
   "text": "אותו עם נפלא,"
  },
  {
   "start": 72.35,
   "end": 77.95,
   "text": "אותו עם נצחי וקדוש שכל אומות העולם שמו להם למטרה בזמן זה או אחר להשמיד אותו,"
  },
  {
   "start": 78.53,
   "end": 79.11,
   "text": "להכריע אותו."
  },
  {
   "start": 79.91,
   "end": 80.35,
   "text": "אבל תמיד,"
  },
  {
   "start": 81.05,
   "end": 82.13,
   "text": "בורא העולם עמד לצידו,"
  },
  {
   "start": 82.83,
   "end": 85.31,
   "text": "עמים קמו ונפלו, מנהיגים עלו וירדו,"
  },
  {
   "start": 85.75,
   "end": 88.29,
   "text": "אימפריות המריאו ושקעו."
  },
  {
   "start": 89.63,
   "end": 90.13,
   "text": "והיהודי,"
  },
  {
   "start": 90.79,
   "end": 91.45,
   "text": "והיהודייה,"
  },
  {
   "start": 92.03,
   "end": 92.87,
   "text": "ואתה, ואת,"
  },
  {
   "start": 93.45,
   "end": 95.35,
   "text": "ואנחנו כולנו, עברנו את כולם,"
  },
  {
   "start": 96.17,
   "end": 99.41,
   "text": "ניצחנו את כולם, כי אחרי הכל נשארנו."
  },
  {
   "start": 99.69,
   "end": 101.99,
   "text": "עם הנשמה הנפלאה שלנו."
  },
  {
   "start": 103.05,
   "end": 104.57,
   "text": "יכלו אולי לפגוע בנו בגוף,"
  },
  {
   "start": 105.21,
   "end": 105.91,
   "text": "אבל בנשמה,"
  },
  {
   "start": 106.43,
   "end": 107.95,
   "text": "מבחינה רוחנית, לא ולא."
  },
  {
   "start": 113.04,
   "end": 113.82,
   "text": "באותה תקופה,"
  },
  {
   "start": 115.48,
   "end": 121.16,
   "text": "המלך היווני אנטיוכוס אפיפאנס חיפש בין השבויים היהודים"
  },
  {
   "start": 121.16,
   "end": 125.5,
   "text": "איזה סמל שאיתו יכול לנצח, לשבור את הרוח של עם ישראל,"
  },
  {
   "start": 128.07,
   "end": 129.73,
   "text": "והוא היה בטוח, הנה אני מצאתי את מה שחיפשתי."
  },
  {
   "start": 131.11,
   "end": 131.73,
   "text": "בין השבויים,"
  },
  {
   "start": 132.83,
   "end": 133.29,
   "text": "שם היא עמדה,"
  },
  {
   "start": 134.29,
   "end": 137.33,
   "text": "אישה יהודייה מוקפת בילדים שלה,"
  },
  {
   "start": 138.13,
   "end": 139.87,
   "text": "מחבקת אותם בחיבוק אמיץ."
  },
  {
   "start": 140.81,
   "end": 141.11,
   "text": "אמא,"
  },
  {
   "start": 141.83,
   "end": 143.35,
   "text": "אמא עם שבעת ילדיה,"
  },
  {
   "start": 144.45,
   "end": 146.29,
   "text": "וזה בדיוק מה שהם היו צריכים."
  },
  {
   "start": 148.11,
   "end": 148.97,
   "text": "מצד אחד ילדים,"
  },
  {
   "start": 149.81,
   "end": 151.97,
   "text": "סמל העתיד, סמל הפריחה."
  },
  {
   "start": 152.35,
   "end": 155.31,
   "text": "ניצחת את הילדים, ניצחת את עתיד היהודים."
  },
  {
   "start": 156.33,
   "end": 156.95,
   "text": "מצד שני,"
  },
  {
   "start": 157.59,
   "end": 158.69,
   "text": "אמא יהודייה,"
  },
  {
   "start": 161.28,
   "end": 163.04,
   "text": "האישה היהודייה, האמא,"
  },
  {
   "start": 163.82,
   "end": 166.36,
   "text": "הייתה שונה מכל הנשים שהם הכירו."
  },
  {
   "start": 168.16,
   "end": 169.66,
   "text": "היהודייה תמיד הייתה צנועה,"
  },
  {
   "start": 170.54,
   "end": 171.14,
   "text": "שקטה,"
  },
  {
   "start": 171.88,
   "end": 175.5,
   "text": "ובצניעות שלה הייתה כל כך הרבה עוצמה,"
  },
  {
   "start": 176.42,
   "end": 177.4,
   "text": "כל כך הרבה כוח,"
  },
  {
   "start": 178.22,
   "end": 179.04,
   "text": "והיא הייתה סמל,"
  },
  {
   "start": 180.14,
   "end": 183.96,
   "text": "סמל לעיצוב, סמל לאישה שמעצבת, שבונה,"
  },
  {
   "start": 184.54,
   "end": 186.82,
   "text": "בונה דורות של נשמות"
  },
  {
   "start": 187.44,
   "end": 188.36,
   "text": "של יהודים."
  },
  {
   "start": 190.61,
   "end": 193.25,
   "text": "האם היהודייה לא הייתה כמו הנשים היווניות,"
  },
  {
   "start": 193.77,
   "end": 195.53,
   "text": "שכל חייהם היו מיועדות ליופי,"
  },
  {
   "start": 196.61,
   "end": 197.47,
   "text": "חיצוניות."
  },
  {
   "start": 198.01,
   "end": 202.07,
   "text": "היו מחנכים אותה מגיל קטן שהכי חשוב בעולם זה להיות יפה."
  },
  {
   "start": 205.08,
   "end": 206.0,
   "text": "וכל יווניה,"
  },
  {
   "start": 206.58,
   "end": 207.18,
   "text": "החיים שלה"
  },
  {
   "start": 207.88,
   "end": 209.92,
   "text": "היו נגמרים בסביבות גיל 20-30."
  },
  {
   "start": 213.54,
   "end": 216.8,
   "text": "היוונים גם ראו את יחס הגברים היהודים לנשים שלהם."
  },
  {
   "start": 217.66,
   "end": 218.88,
   "text": "איזה כבוד, איזה ערכה."
  },
  {
   "start": 219.34,
   "end": 220.6,
   "text": "איך היו מתייעצים עם הנשים,"
  },
  {
   "start": 221.06,
   "end": 225.54,
   "text": "איך הייתה חלוקת תפקידים בצורה כל כך נפלאה, באחדות כל כך מהנה."
  },
  {
   "start": 225.78,
   "end": 226.3,
   "text": "מהנה,"
  },
  {
   "start": 227.62,
   "end": 229.5,
   "text": "כל אחד ניהל את התחום שלו."
  },
  {
   "start": 231.4,
   "end": 234.56,
   "text": "אז הם ידעו שאם אנחנו נפגע בבית היהודי,"
  },
  {
   "start": 236.46,
   "end": 237.52,
   "text": "באישה היהודייה,"
  },
  {
   "start": 238.22,
   "end": 239.8,
   "text": "באימא היהודייה, בילדים,"
  },
  {
   "start": 240.4,
   "end": 242.36,
   "text": "זו תהיה פגיעה מוחצת ביהדות."
  },
  {
   "start": 252.41,
   "end": 257.15,
   "text": "זו הייתה מטרתם, לשבור את הבית היהודי ואת הילדים הקטנים, את הנשמה שלהם, את האמונה שלהם,"
  },
  {
   "start": 257.75,
   "end": 258.43,
   "text": "לעיני כולם."
  },
  {
   "start": 261.36,
   "end": 264.7,
   "text": "הם היו בטוחים שהאישה הזאת והילדים שלה יהפכו לסמל."
  },
  {
   "start": 265.64,
   "end": 270.94,
   "text": "הם ייתנו את האות להפיכת העם היהודי לחלק מהתרבות ההלניסטית היוונית."
  },
  {
   "start": 276.2,
   "end": 279.82,
   "text": "והם לקחו את האישה, את האימא עם שבעת ילדיה."
  },
  {
   "start": 282.3,
   "end": 282.96,
   "text": "קראו לאימא,"
  },
  {
   "start": 283.54,
   "end": 284.6,
   "text": "לאישה הזאת חנה."
  },
  {
   "start": 286.24,
   "end": 294.8,
   "text": "הם אמרו לה, תדעי לך, אנחנו נפגע לך ביקר מכל בילדים אם לא תתני לנו את האפשרות להעביר אותם על דתם."
  },
  {
   "start": 295.42,
   "end": 296.14,
   "text": "או יותר נכון,"
  },
  {
   "start": 296.84,
   "end": 299.62,
   "text": "לעשות סמל בזה שהם השתחוו"
  },
  {
   "start": 300.38,
   "end": 302.36,
   "text": "לאלילות שלנו, לעולם שלנו."
  },
  {
   "start": 303.64,
   "end": 305.48,
   "text": "אנחנו נכיר להם את העבודה זרה שלנו,"
  },
  {
   "start": 307.18,
   "end": 308.42,
   "text": "והם יהיו חלק מאיתנו."
  },
  {
   "start": 309.12,
   "end": 311.98,
   "text": "ואם לא תסכימי, תאבדי אותם לנצח."
  },
  {
   "start": 313.68,
   "end": 315.36,
   "text": "סיננה יועץ היווני בזעם."
  },
  {
   "start": 318.98,
   "end": 319.74,
   "text": "והאימא יהודייה"
  },
  {
   "start": 321.32,
   "end": 324.5,
   "text": "הושלכה עם מלעדיה אל תא הכלא."
  },
  {
   "start": 326.76,
   "end": 327.24,
   "text": "בתא הכלא"
  },
  {
   "start": 328.46,
   "end": 329.7,
   "text": "השתרדה דממת מוות."
  },
  {
   "start": 330.78,
   "end": 332.74,
   "text": "הילדים הסתכלו על אימא,"
  },
  {
   "start": 333.66,
   "end": 334.94,
   "text": "על האימא הנפלאה שלהם."
  },
  {
   "start": 337.12,
   "end": 338.3,
   "text": "היא הייתה חיוורת כמו סיד,"
  },
  {
   "start": 341.23,
   "end": 342.31,
   "text": "אבל אחרי דקה ארוכה"
  },
  {
   "start": 347.81,
   "end": 350.17,
   "text": "היא התחילה לשיר בקול שקט, כמו בבית,"
  },
  {
   "start": 350.99,
   "end": 352.25,
   "text": "כמו בערב שבת בבית."
  },
  {
   "start": 355.46,
   "end": 356.02,
   "text": "וגם הם,"
  },
  {
   "start": 357.42,
   "end": 363.32,
   "text": "כמו בבית, עצמו העיניים,"
  },
  {
   "start": 364.02,
   "end": 365.12,
   "text": "ולפתע הם כבר לא בתא."
  },
  {
   "start": 371.64,
   "end": 372.04,
   "text": "הם בבית."
  },
  {
   "start": 373.44,
   "end": 374.6,
   "text": "לפתע הם מתעלמים מהכל."
  },
  {
   "start": 381.67,
   "end": 382.71,
   "text": "אני לא יודע מה הם דיברו שם."
  },
  {
   "start": 384.31,
   "end": 385.83,
   "text": "אני לא יודע, אף אחד לא יודע."
  },
  {
   "start": 386.59,
   "end": 392.09,
   "text": "רק בורא העולם יודע איזה שיחות נפש ניהלה האימא המופלאה הזאת עם הילדים שלה,"
  },
  {
   "start": 392.75,
   "end": 394.61,
   "text": "עם שבעת הגיבורים הקטנים שלה,"
  },
  {
   "start": 395.69,
   "end": 396.93,
   "text": "חנה ושבעת בניה."
  },
  {
   "start": 401.63,
   "end": 407.44,
   "text": "בינתיים בארמון מתחילים,"
  },
  {
   "start": 407.86,
   "end": 410.32,
   "text": "בארמון, בארמונו של אנטיוכוס אפיפאנס,"
  },
  {
   "start": 411.04,
   "end": 415.28,
   "text": "מכינים את המסיבה הגדולה, את האירוע הגדול של השנה."
  },
  {
   "start": 416.5,
   "end": 424.14,
   "text": "משפחה שלמה תיהפך לחלק מהתרבות היוונית."
  },
  {
   "start": 424.64,
   "end": 425.36,
   "text": "משפחה שלמה יהודית,"
  },
  {
   "start": 426.84,
   "end": 428.86,
   "text": "משפחה שלמה של העם היהודי."
  },
  {
   "start": 429.9,
   "end": 430.42,
   "text": "איזה הישג."
  },
  {
   "start": 435.61,
   "end": 439.23,
   "text": "וארמונו של אנטיוכוס אפיפנס היה הומה מהאנשים, כל נכבדי אבן הגיעו."
  },
  {
   "start": 439.97,
   "end": 441.85,
   "text": "הרחובות מסביב היו מלאים באדם,"
  },
  {
   "start": 442.23,
   "end": 444.13,
   "text": "כולם מתוחים, כולם ממתינים לבאות"
  },
  {
   "start": 449.29,
   "end": 453.13,
   "text": "באולם הגדול והמרווח שבמשכן המלך"
  },
  {
   "start": 453.83,
   "end": 455.07,
   "text": "התרכזו כולם מסביב."
  },
  {
   "start": 456.75,
   "end": 457.07,
   "text": "המוני,"
  },
  {
   "start": 457.67,
   "end": 458.43,
   "text": "המוני יוונים,"
  },
  {
   "start": 459.37,
   "end": 460.33,
   "text": "המוני יהודים,"
  },
  {
   "start": 460.83,
   "end": 468.29,
   "text": "מביטים בחרדה מה יהיה ועוד נציגים מכל אומות העולם."
  },
  {
   "start": 469.29,
   "end": 470.67,
   "text": "כולם ממתינים למוצא פיו"
  },
  {
   "start": 471.51,
   "end": 476.99,
   "text": "של המלך והאות ניתן."
  },
  {
   "start": 478.63,
   "end": 481.79,
   "text": "אל האולם הובלה משפחה אומללה,"
  },
  {
   "start": 483.61,
   "end": 484.97,
   "text": "אמא ושבעת ילדיה."
  },
  {
   "start": 486.77,
   "end": 487.61,
   "text": "הם נראו כל כך,"
  },
  {
   "start": 488.37,
   "end": 491.41,
   "text": "כל כך חסרי אונים מול החיילים שהקיפו אותם."
  },
  {
   "start": 493.93,
   "end": 494.47,
   "text": "רק העיניים,"
  },
  {
   "start": 494.97,
   "end": 500.17,
   "text": "העיניים הבוערות סיפרו על עוצמות הנפש,"
  },
  {
   "start": 500.81,
   "end": 501.39,
   "text": "על תעוזת הרוח."
  },
  {
   "start": 504.44,
   "end": 507.24,
   "text": "אני לא יודע, לא יכול להעביר, לא יכול לתאר"
  },
  {
   "start": 507.98,
   "end": 511.44,
   "text": "כמה האימא הגדולה הזאת חנה אהבת הילדים שלה."
  },
  {
   "start": 512.46,
   "end": 517.54,
   "text": "איזה אימא היא הייתה מסורה, כל החיים שלה היא הקדישה בשביל הילדים שלה."
  },
  {
   "start": 520.57,
   "end": 524.45,
   "text": "בתקופות הקשות היא הייתה מחזירה אוכל מהפה שלה,"
  },
  {
   "start": 525.47,
   "end": 527.97,
   "text": "ונותנת לילדים שיאכלו, שיתחזקו,"
  },
  {
   "start": 528.09,
   "end": 529.21,
   "text": "שיעבדו את השם."
  },
  {
   "start": 535.27,
   "end": 536.17,
   "text": "וכל הזמן,"
  },
  {
   "start": 536.95,
   "end": 540.57,
   "text": "וכל הזמן היא הייתה מחייכת, הייתה שומרת"
  },
  {
   "start": 541.09,
   "end": 541.83,
   "text": "על אמונה,"
  },
  {
   "start": 542.43,
   "end": 543.11,
   "text": "על רוח,"
  },
  {
   "start": 544.93,
   "end": 548.55,
   "text": "רוח של שמחה בבית, שאף אחד לא ידע שאולי חסר לנו אוכל."
  },
  {
   "start": 553.23,
   "end": 553.69,
   "text": "ועכשיו"
  },
  {
   "start": 554.63,
   "end": 556.07,
   "text": "כל הילדים עומדים סביבה,"
  },
  {
   "start": 557.25,
   "end": 557.51,
   "text": "והיא,"
  },
  {
   "start": 558.23,
   "end": 559.27,
   "text": "עם כתפיים דקות,"
  },
  {
   "start": 559.95,
   "end": 561.17,
   "text": "חזות כל כך עדינה,"
  },
  {
   "start": 561.83,
   "end": 564.69,
   "text": "משמשת מקלט ומגן עבורם."
  },
  {
   "start": 572.48,
   "end": 573.42,
   "text": "ולפני שהיא הספיקה,"
  },
  {
   "start": 573.74,
   "end": 576.38,
   "text": "הספיקה להגיד מילים, מילים שלא נגמרות."
  },
  {
   "start": 577.64,
   "end": 583.8,
   "text": "משפטים אחרונים של אמא שרוצה למסור מסר של נצח לילד שלה."
  },
  {
   "start": 584.6,
   "end": 586.82,
   "text": "לפתע הוא נלקח בכוח הזרוע, הבן הבכור."
  },
  {
   "start": 587.8,
   "end": 589.12,
   "text": "הבן הבכור, הם לקחו אותו"
  },
  {
   "start": 590.54,
   "end": 592.1,
   "text": "והעמידו אותו מול אנטיוכוס."
  },
  {
   "start": 593.1,
   "end": 595.02,
   "text": "הוא נעמד מולו ילד יהודי קטן,"
  },
  {
   "start": 596.6,
   "end": 598.38,
   "text": "מול מנהיג האימפריה העולמית."
  },
  {
   "start": 603.74,
   "end": 604.06,
   "text": "קדימה,"
  },
  {
   "start": 604.96,
   "end": 605.58,
   "text": "תשתחווה,"
  },
  {
   "start": 606.64,
   "end": 608.02,
   "text": "קרוי יועצי אנטיוכוס."
  },
  {
   "start": 609.16,
   "end": 610.72,
   "text": "אבל הבן, הבן הבכור,"
  },
  {
   "start": 613.59,
   "end": 614.63,
   "text": "מזווית עיניו הוא ראה,"
  },
  {
   "start": 615.31,
   "end": 617.09,
   "text": "הוא ראה את אמא מתבוננת בו,"
  },
  {
   "start": 617.71,
   "end": 618.41,
   "text": "בהערצה."
  },
  {
   "start": 619.45,
   "end": 621.45,
   "text": "ואז הוא אמר, בתורה שלמדתי בבית ספר,"
  },
  {
   "start": 622.09,
   "end": 625.69,
   "text": "בתורה שלמדתי בתלמוד התורה, בתורה שלמדתי בחיידר,"
  },
  {
   "start": 626.15,
   "end": 628.83,
   "text": "בתורה שבורא עולם הביא לעולם,"
  },
  {
   "start": 629.45,
   "end": 632.01,
   "text": "כתוב אנוכי השם אלוקיך."
  },
  {
   "start": 634.43,
   "end": 636.29,
   "text": "רק בורא עולם הוא האלוקים,"
  },
  {
   "start": 637.23,
   "end": 638.29,
   "text": "רק אליו אני אשתחווה."
  },
  {
   "start": 638.29,
   "end": 638.73,
   "text": "אתה חווה"
  },
  {
   "start": 642.71,
   "end": 644.31,
   "text": "פניו של אנטיוכוס איודימו."
  },
  {
   "start": 646.88,
   "end": 647.6,
   "text": "הוא נתן הוראה,"
  },
  {
   "start": 649.1,
   "end": 649.84,
   "text": "והם הוציאו אותו,"
  },
  {
   "start": 650.96,
   "end": 652.06,
   "text": "את הילד אל התליין,"
  },
  {
   "start": 652.84,
   "end": 654.5,
   "text": "לתליין שעמד לו בחוץ,"
  },
  {
   "start": 655.06,
   "end": 656.76,
   "text": "עם מבט מזרעמים בעיניים,"
  },
  {
   "start": 660.94,
   "end": 661.62,
   "text": "והוא החל להוביל אותו."
  },
  {
   "start": 662.8,
   "end": 665.54,
   "text": "הוא החליט להוביל אותו בדרך, בדרך הארוכה אל המוות,"
  },
  {
   "start": 666.48,
   "end": 667.48,
   "text": "וכולם ממתינים, נו."
  },
  {
   "start": 669.1,
   "end": 669.32,
   "text": "ילד,"
  },
  {
   "start": 669.96,
   "end": 673.16,
   "text": "די, אתה מבין שאתה הולך למות? די, תתייאש, תעצור, תתחרט."
  },
  {
   "start": 675.36,
   "end": 676.18,
   "text": "אבל הילד פסע,"
  },
  {
   "start": 676.94,
   "end": 678.8,
   "text": "בראש מורם,"
  },
  {
   "start": 681.14,
   "end": 683.42,
   "text": "וחנה עומדת לה עם ששת בניה,"
  },
  {
   "start": 684.58,
   "end": 687.26,
   "text": "כאב חד לופת את ליבה."
  },
  {
   "start": 688.66,
   "end": 689.82,
   "text": "בן שלה הבכור,"
  },
  {
   "start": 690.72,
   "end": 692.06,
   "text": "שנשאה בבטנה,"
  },
  {
   "start": 693.22,
   "end": 694.72,
   "text": "שהשקיעה בלילות"
  },
  {
   "start": 695.56,
   "end": 696.64,
   "text": "לגדל אותו,"
  },
  {
   "start": 700.64,
   "end": 701.28,
   "text": "כאב חד,"
  },
  {
   "start": 702.02,
   "end": 703.5,
   "text": "ומצד שני שמחה,"
  },
  {
   "start": 704.24,
   "end": 705.82,
   "text": "שמחה על הילד שלא יכזב,"
  },
  {
   "start": 706.48,
   "end": 707.06,
   "text": "שלא יכזב,"
  },
  {
   "start": 707.58,
   "end": 710.4,
   "text": "הילד שהלך בדרכי אבותיו, הילד שמוסר,"
  },
  {
   "start": 711.3,
   "end": 714.74,
   "text": "מוסר את נפשו לקדש שם שמיים."
  },
  {
   "start": 719.19,
   "end": 719.89,
   "text": "הנר הראשון"
  },
  {
   "start": 721.35,
   "end": 721.97,
   "text": "במנורת"
  },
  {
   "start": 722.73,
   "end": 723.71,
   "text": "הלב היהודי הודלק."
  },
  {
   "start": 736.82,
   "end": 738.46,
   "text": "הם העמידו את הבן השני,"
  },
  {
   "start": 741.01,
   "end": 742.09,
   "text": "והבן השני קרא,"
  },
  {
   "start": 743.67,
   "end": 748.03,
   "text": "אדוני המלך, לא יהיה לך אלוקים אחרים על פניי, רשום אצלנו בתורה."
  },
  {
   "start": 749.41,
   "end": 754.25,
   "text": "קיבלנו תורה מסיני, לא יהיה לך אלוקים אחרים על פניי, לקדוש ברוך הוא אין סגנים."
  },
  {
   "start": 755.25,
   "end": 758.81,
   "text": "והוא ציווה עליי רק לעבוד אותו,"
  },
  {
   "start": 759.87,
   "end": 760.99,
   "text": "רק להיות מחובר אליו."
  },
  {
   "start": 762.47,
   "end": 765.11,
   "text": "וזה מה שאני אעשה גם אם תהרוג אותי,"
  },
  {
   "start": 769.85,
   "end": 772.63,
   "text": "ופסע אף הוא בעקבות אחיו הבכור."
  },
  {
   "start": 774.65,
   "end": 775.45,
   "text": "ונר שני,"
  },
  {
   "start": 776.23,
   "end": 778.59,
   "text": "נר שני הודלק במנורת"
  },
  {
   "start": 779.61,
   "end": 781.31,
   "text": "הזהב של הלב היהודי."
  },
  {
   "start": 792.98,
   "end": 795.7,
   "text": "הבן השלישי עמד אף הוא במבחן."
  },
  {
   "start": 796.7,
   "end": 800.42,
   "text": "גם הוא עמד במבחן כשהוא משתדל להסתיר את המתח בפנים שלו,"
  },
  {
   "start": 801.24,
   "end": 802.08,
   "text": "לא להראות את הפחד,"
  },
  {
   "start": 805.9,
   "end": 807.38,
   "text": "וגם הוא מובל בעקבות אחיו."
  },
  {
   "start": 811.18,
   "end": 812.82,
   "text": "רחש נער נשמע בקהל."
  },
  {
   "start": 814.18,
   "end": 815.58,
   "text": "זה לא כל כך קל כמו שהם חשבו."
  },
  {
   "start": 816.66,
   "end": 818.76,
   "text": "ילדים מול מנהיג אימפריה."
  },
  {
   "start": 822.92,
   "end": 825.0,
   "text": "והיוונים ידעו, כל מי שהיה שם, לא רק היוונים,"
  },
  {
   "start": 825.32,
   "end": 826.52,
   "text": "כל האנשים שנאספו שם,"
  },
  {
   "start": 827.12,
   "end": 827.7,
   "text": "ידעו את האמת,"
  },
  {
   "start": 828.22,
   "end": 833.38,
   "text": "ידעו שעבור האמונה שלהם הם לא היו מוכנים לוותר על משהו מהנאות החיים."
  },
  {
   "start": 835.14,
   "end": 837.76,
   "text": "ובאה המציאות וטופחת על פניהם."
  },
  {
   "start": 838.44,
   "end": 839.0,
   "text": "ילדים,"
  },
  {
   "start": 839.74,
   "end": 840.68,
   "text": "סמל החיים,"
  },
  {
   "start": 841.32,
   "end": 848.44,
   "text": "ילדים, סמל החיים, מוכנים לוותר על היקר מכל, על החיים למען אמונתם."
  },
  {
   "start": 853.32,
   "end": 855.0,
   "text": "ובכל הארמון, בכל העולם,"
  },
  {
   "start": 855.62,
   "end": 856.48,
   "text": "גם מבחוץ,"
  },
  {
   "start": 857.18,
   "end": 857.92,
   "text": "ברחובות,"
  },
  {
   "start": 858.6,
   "end": 860.12,
   "text": "שיווי המשקל התערער."
  },
  {
   "start": 860.7,
   "end": 861.48,
   "text": "כולם הבינו,"
  },
  {
   "start": 862.4,
   "end": 863.98,
   "text": "כולם ידעו אצל מי האמת."
  },
  {
   "start": 869.72,
   "end": 871.04,
   "text": "תור הבן הרביעי הגיע."
  },
  {
   "start": 876.82,
   "end": 878.08,
   "text": "הוא סובב את ראשו לאימא,"
  },
  {
   "start": 879.44,
   "end": 881.72,
   "text": "וחנה בעיניים,"
  },
  {
   "start": 883.1,
   "end": 884.28,
   "text": "בעיניים אדומות מדמע,"
  },
  {
   "start": 888.47,
   "end": 889.71,
   "text": "חייכה חיוך קלוש"
  },
  {
   "start": 891.53,
   "end": 892.41,
   "text": "אל הבן שלה."
  },
  {
   "start": 893.79,
   "end": 896.19,
   "text": "הילד עצם את העיניים ואמר בנחישות,"
  },
  {
   "start": 897.29,
   "end": 899.15,
   "text": "לא תשתחווה לאל נכר,"
  },
  {
   "start": 900.19,
   "end": 901.99,
   "text": "לא תשתחווה לאל אחר."
  },
  {
   "start": 903.25,
   "end": 904.29,
   "text": "ככה אני למדתי,"
  },
  {
   "start": 905.41,
   "end": 907.33,
   "text": "ואני נשאר עם הקדוש ברוך הוא,"
  },
  {
   "start": 912.57,
   "end": 914.73,
   "text": "ונר רביעי יצטרף לאחיו הבוערים,"
  },
  {
   "start": 915.61,
   "end": 916.01,
   "text": "וכך"
  },
  {
   "start": 917.97,
   "end": 920.53,
   "text": "גם הנר החמישי והנר השישי,"
  },
  {
   "start": 921.85,
   "end": 924.75,
   "text": "וחנה מאבדת את הילדים שלה"
  },
  {
   "start": 926.77,
   "end": 927.97,
   "text": "אחד אחר השני,"
  },
  {
   "start": 929.33,
   "end": 932.45,
   "text": "ונשארת לבסוף עם הילד הקטן."
  },
  {
   "start": 933.69,
   "end": 937.09,
   "text": "עם הילד הקטן, עם התקווה האחרונה של אמא,"
  },
  {
   "start": 937.51,
   "end": 939.77,
   "text": "עם הנאור האחרון בחייה."
  },
  {
   "start": 943.49,
   "end": 944.29,
   "text": "ואנטיוכוס,"
  },
  {
   "start": 944.73,
   "end": 949.63,
   "text": "יודע שזה הסיכוי האחרון שלו לצאת מנצח מהמלחמה האיומה הזאת."
  },
  {
   "start": 951.51,
   "end": 952.87,
   "text": "הוא הרחל מדבר אל ליבו של הילד."
  },
  {
   "start": 958.01,
   "end": 958.87,
   "text": "והילד הקטן,"
  },
  {
   "start": 960.23,
   "end": 960.97,
   "text": "הילד הקטן,"
  },
  {
   "start": 962.19,
   "end": 965.21,
   "text": "רק לא מזמן עבר מלהיות תינוק"
  },
  {
   "start": 966.53,
   "end": 967.45,
   "text": "לילד קטן,"
  },
  {
   "start": 968.17,
   "end": 969.07,
   "text": "הוא אומר לו בלשון,"
  },
  {
   "start": 970.49,
   "end": 971.61,
   "text": "בלשון של ילדים,"
  },
  {
   "start": 973.93,
   "end": 977.79,
   "text": "המלך, אנחנו כבר נשבענו לקדוש ברוך הוא שלא נעזוב אותו."
  },
  {
   "start": 978.35,
   "end": 979.41,
   "text": "אז אנחנו לא נעזוב אותו."
  },
  {
   "start": 980.73,
   "end": 983.31,
   "text": "והוא נשבע שהוא לא יחליף אותנו בשום עם."
  },
  {
   "start": 984.77,
   "end": 986.31,
   "text": "בשום עם, גם בכם."
  },
  {
   "start": 987.39,
   "end": 988.43,
   "text": "הוא תמיד יהיה איתנו."
  },
  {
   "start": 990.7,
   "end": 991.78,
   "text": "אז תגיד לי, אדוני המלך,"
  },
  {
   "start": 992.58,
   "end": 995.4,
   "text": "למה אתה מתאמץ כל כך? הרי אתה לא תצליח."
  },
  {
   "start": 997.52,
   "end": 998.64,
   "text": "הבורא עולם איתנו."
  },
  {
   "start": 999.32,
   "end": 1000.08,
   "text": "השם איתנו."
  },
  {
   "start": 1005.18,
   "end": 1005.88,
   "text": "ארתיוכוס,"
  },
  {
   "start": 1006.92,
   "end": 1009.54,
   "text": "נהיה אדום כולו, אמר למה ילד? תקשיב, תקשיב ילד."
  },
  {
   "start": 1010.78,
   "end": 1011.64,
   "text": "אני אעשה איתך עסק."
  },
  {
   "start": 1012.58,
   "end": 1014.9,
   "text": "אני אפיל את הטבעת שלי, את החותמת שלי,"
  },
  {
   "start": 1015.88,
   "end": 1016.62,
   "text": "לרצפה,"
  },
  {
   "start": 1017.56,
   "end": 1018.32,
   "text": "ואתה תרים אותה,"
  },
  {
   "start": 1019.14,
   "end": 1020.62,
   "text": "ותביא אותה אליי,"
  },
  {
   "start": 1021.48,
   "end": 1023.44,
   "text": "ואז למעשה כאילו השתחווית."
  },
  {
   "start": 1024.92,
   "end": 1028.74,
   "text": "וניתן לך את החיים שלך ושל אמא שלך במתנה."
  },
  {
   "start": 1033.76,
   "end": 1034.86,
   "text": "בוא אני אפיל את הטבעת,"
  },
  {
   "start": 1035.94,
   "end": 1039.52,
   "text": "רק שכולם יאמרו שהנה השתחווית."
  },
  {
   "start": 1043.08,
   "end": 1043.7,
   "text": "ענה הילד,"
  },
  {
   "start": 1044.6,
   "end": 1046.76,
   "text": "תראה כמה אתה חושב על הכבוד שלך."
  },
  {
   "start": 1047.4,
   "end": 1049.12,
   "text": "אם אתה חושב כך על הכבוד שלך,"
  },
  {
   "start": 1049.56,
   "end": 1052.34,
   "text": "כמה אני צריך לחשוב על הכבוד של השם יתברך,"
  },
  {
   "start": 1052.8,
   "end": 1055.12,
   "text": "כמה אני צריך לחשוב על הכבוד של השם יתברך."
  },
  {
   "start": 1056.72,
   "end": 1060.96,
   "text": "וזה קרע את אנטיוכוס, הוא ידע שהם הפסידו."
  },
  {
   "start": 1062.36,
   "end": 1096.09,
   "text": "בגדול, במקום, במקום להאביס את האור היהודי,"
  },
  {
   "start": 1098.39,
   "end": 1101.47,
   "text": "הובער אור אחר, אור מאש של מסירות נפש,"
  },
  {
   "start": 1102.57,
   "end": 1103.23,
   "text": "של התמדה."
  },
  {
   "start": 1111.18,
   "end": 1112.76,
   "text": "אנטיוכוס איבד את עשתונותיו וצרח."
  },
  {
   "start": 1113.88,
   "end": 1114.8,
   "text": "בפראות הוציא אותו,"
  },
  {
   "start": 1115.54,
   "end": 1116.46,
   "text": "תוציא אותו למוות."
  },
  {
   "start": 1121.08,
   "end": 1121.98,
   "text": "והם לקחו אותו להריגה,"
  },
  {
   "start": 1123.3,
   "end": 1125.24,
   "text": "והוא הולך צעד אחרי צעד."
  },
  {
   "start": 1130.84,
   "end": 1130.98,
   "text": "לפתע,"
  },
  {
   "start": 1131.8,
   "end": 1132.88,
   "text": "לפתע התפרצה חנה,"
  },
  {
   "start": 1133.42,
   "end": 1134.24,
   "text": "התפרצה האמא,"
  },
  {
   "start": 1134.82,
   "end": 1136.12,
   "text": "הרגש האמהי שלה,"
  },
  {
   "start": 1136.78,
   "end": 1138.64,
   "text": "הרגש האמהי שלה פרץ קדימה."
  },
  {
   "start": 1139.16,
   "end": 1139.5,
   "text": "רגע,"
  },
  {
   "start": 1140.14,
   "end": 1140.52,
   "text": "רגע,"
  },
  {
   "start": 1141.36,
   "end": 1142.42,
   "text": "עצרו."
  },
  {
   "start": 1143.72,
   "end": 1144.38,
   "text": "וכולם,"
  },
  {
   "start": 1145.16,
   "end": 1146.86,
   "text": "כולם עצרו את נשימתם."
  },
  {
   "start": 1147.7,
   "end": 1149.6,
   "text": "אנטיוכוס הורה להם לעצור."
  },
  {
   "start": 1150.42,
   "end": 1151.52,
   "text": "לרגע הזה הוא חיכה."
  },
  {
   "start": 1152.76,
   "end": 1154.44,
   "text": "לרגע השבירה הוא חיכה."
  },
  {
   "start": 1158.28,
   "end": 1160.82,
   "text": "הוא ראה את הכאב, את הכאב של חנה,"
  },
  {
   "start": 1161.48,
   "end": 1165.46,
   "text": "את הכאב של אמא שרצחו את הילדים שלה מול העיניים שלה."
  },
  {
   "start": 1166.74,
   "end": 1174.63,
   "text": "עכשיו היא תשכנע לפחות הבן שלה הקטן להתייוון."
  },
  {
   "start": 1177.37,
   "end": 1178.43,
   "text": "וכולם נעצרים,"
  },
  {
   "start": 1179.03,
   "end": 1183.81,
   "text": "וחנה מתקרבת צעד ועוד צעד אל הבן שלה,"
  },
  {
   "start": 1184.29,
   "end": 1185.39,
   "text": "אל הילד הקטן שלה,"
  },
  {
   "start": 1185.87,
   "end": 1187.05,
   "text": "האחרון שנשאר,"
  },
  {
   "start": 1202.01,
   "end": 1202.31,
   "text": "חנה."
  },
  {
   "start": 1203.11,
   "end": 1205.37,
   "text": "חנה באה לחיבקת הבן שלה,"
  },
  {
   "start": 1205.93,
   "end": 1206.89,
   "text": "התחילה מנשקת אותו,"
  },
  {
   "start": 1208.75,
   "end": 1213.17,
   "text": "ומנשקת אותו, וככה הם היו חבוקים יחד בכוח,"
  },
  {
   "start": 1215.65,
   "end": 1218.49,
   "text": "מזרימים כוחות ואנרגיה אחד לשני,"
  },
  {
   "start": 1219.51,
   "end": 1222.05,
   "text": "והבן בוכה על כתפי אמו,"
  },
  {
   "start": 1222.75,
   "end": 1225.21,
   "text": "ואימא יושבת ובוכה בכי של אימא שמסרה,"
  },
  {
   "start": 1228.23,
   "end": 1229.69,
   "text": "מסרה את יותר מנפשה,"
  },
  {
   "start": 1230.81,
   "end": 1231.87,
   "text": "ואז היא הדהימה את כולם."
  },
  {
   "start": 1233.15,
   "end": 1234.29,
   "text": "היא עזבה את הבן שלה"
  },
  {
   "start": 1235.09,
   "end": 1236.17,
   "text": "ואמרה לו,"
  },
  {
   "start": 1237.11,
   "end": 1238.09,
   "text": "לך, בני היקר,"
  },
  {
   "start": 1238.97,
   "end": 1239.99,
   "text": "לך עם האחים שלך,"
  },
  {
   "start": 1241.05,
   "end": 1242.77,
   "text": "לך עם האחים שחלכו כל הבנים,"
  },
  {
   "start": 1243.31,
   "end": 1245.67,
   "text": "ושם בעולם הבא תבקשו"
  },
  {
   "start": 1246.47,
   "end": 1247.59,
   "text": "את אברהם אבינו,"
  },
  {
   "start": 1248.07,
   "end": 1250.77,
   "text": "ותלכו לאברהם ותגידו לו, אברהם, אברהם,"
  },
  {
   "start": 1251.43,
   "end": 1253.97,
   "text": "אתה אקדת מזבח אחד,"
  },
  {
   "start": 1254.85,
   "end": 1257.17,
   "text": "אני אקדתי שבעה מזבחות,"
  },
  {
   "start": 1258.29,
   "end": 1260.43,
   "text": "אתה אקדת מזבח אחד,"
  },
  {
   "start": 1261.13,
   "end": 1264.09,
   "text": "אני אקדתי שבעה מזבחות,"
  },
  {
   "start": 1265.15,
   "end": 1270.37,
   "text": "שבעה ילדים מסרתי לכבוד השם"
  },
  {
   "start": 1271.21,
   "end": 1274.73,
   "text": "אתה רק ניסיון, אני באסוף מעשה."
  },
  {
   "start": 1276.39,
   "end": 1276.67,
   "text": "לך בני,"
  },
  {
   "start": 1277.51,
   "end": 1296.24,
   "text": "לך אהובי, לך בדרך של העם ישראל והבן הקטן התחיל ללכת כשכתפיו רועדות מבכי."
  },
  {
   "start": 1326.56,
   "end": 1326.98,
   "text": "וחנה"
  },
  {
   "start": 1327.9,
   "end": 1329.62,
   "text": "חנה, האמא הגדולה,"
  },
  {
   "start": 1331.54,
   "end": 1334.7,
   "text": "הסתובבה ופרצה לה החוצה."
  },
  {
   "start": 1336.14,
   "end": 1338.14,
   "text": "פרצה לה החוצה, מבין כולם."
  },
  {
   "start": 1339.56,
   "end": 1340.2,
   "text": "היא יוצאת,"
  },
  {
   "start": 1341.68,
   "end": 1343.24,
   "text": "נשארה לבד בעולם."
  },
  {
   "start": 1344.66,
   "end": 1346.48,
   "text": "כולה דבקות בשם מתברך,"
  },
  {
   "start": 1346.82,
   "end": 1348.7,
   "text": "היא יודעת שהיא הבאה בתור,"
  },
  {
   "start": 1349.16,
   "end": 1353.48,
   "text": "ולא מוכנה לתת להם את הסיכוי הזה לשבור אותה."
  },
  {
   "start": 1354.18,
   "end": 1354.7,
   "text": "היא עלתה,"
  },
  {
   "start": 1355.5,
   "end": 1356.64,
   "text": "עלתה על גג גבוה,"
  },
  {
   "start": 1357.96,
   "end": 1358.62,
   "text": "ומהגג"
  },
  {
   "start": 1362.09,
   "end": 1364.45,
   "text": "נשאה את העיניים לאבא שבשמיים,"
  },
  {
   "start": 1365.41,
   "end": 1367.67,
   "text": "הרימה את הידיים לאבא שבשמיים,"
  },
  {
   "start": 1368.41,
   "end": 1370.09,
   "text": "ובשם כל הקדושים,"
  },
  {
   "start": 1371.05,
   "end": 1373.21,
   "text": "בשם כל הילדים,"
  },
  {
   "start": 1374.15,
   "end": 1382.44,
   "text": "בשם כל הנשמות, נפלה מהגג,"
  },
  {
   "start": 1384.1,
   "end": 1384.94,
   "text": "ומתה."
  },
  {
   "start": 1400.62,
   "end": 1401.76,
   "text": "יצאתה בת קול,"
  },
  {
   "start": 1403.06,
   "end": 1405.54,
   "text": "ואמרה, אם הבנים שמחה הללויה,"
  },
  {
   "start": 1406.32,
   "end": 1408.28,
   "text": "אם הבנים שמחה הללויה,"
  },
  {
   "start": 1415.55,
   "end": 1416.39,
   "text": "אימא יהודייה."
  },
  {
   "start": 1417.55,
   "end": 1418.89,
   "text": "איזו עוצמה רוחנית"
  },
  {
   "start": 1419.73,
   "end": 1423.45,
   "text": "מול אימפריה שלמה, אם רק נדמיין את זה, אם רק נבין."
  },
  {
   "start": 1424.93,
   "end": 1426.19,
   "text": "אי אפשר להבין,"
  },
  {
   "start": 1426.55,
   "end": 1431.49,
   "text": "אי אפשר, אנחנו שומעים את זה ואי אפשר להבין. נדמיין עצמנו את עומדים במקום אותה אימא,"
  },
  {
   "start": 1432.11,
   "end": 1433.69,
   "text": "איך היינו מגיבים,"
  },
  {
   "start": 1434.55,
   "end": 1435.83,
   "text": "איך היינו מגיבים."
  },
  {
   "start": 1436.93,
   "end": 1441.91,
   "text": "אבל עם המסירות נפש, הם הדליקו את מנורת הזהב"
  },
  {
   "start": 1442.45,
   "end": 1445.73,
   "text": "של עם ישראל, מנורת הזהב של מסירות נפש,"
  },
  {
   "start": 1446.87,
   "end": 1448.39,
   "text": "מנורת הזהב של אמונה,"
  },
  {
   "start": 1448.75,
   "end": 1451.61,
   "text": "מנורת הזהב של דבקות בשם יתברך."
  },
  {
   "start": 1452.15,
   "end": 1452.89,
   "text": "והמנורה הזאת,"
  },
  {
   "start": 1454.03,
   "end": 1454.85,
   "text": "עד היום,"
  },
  {
   "start": 1455.51,
   "end": 1456.69,
   "text": "עד היום היא בוערת."
  },
  {
   "start": 1457.15,
   "end": 1458.27,
   "text": "אתם יודעים איפה היא בוערת?"
  },
  {
   "start": 1458.79,
   "end": 1461.93,
   "text": "אצלנו, בלב שלך, בלב שלך."
  },
  {
   "start": 1462.49,
   "end": 1464.11,
   "text": "המנורה הזאת דולקת,"
  },
  {
   "start": 1464.71,
   "end": 1465.97,
   "text": "המנורה הזאת דולקת."
  },
  {
   "start": 1466.53,
   "end": 1469.95,
   "text": "אם היא לא הייתה דולקת, אז איך בדור כזה חשוך"
  },
  {
   "start": 1470.57,
   "end": 1473.55,
   "text": "היית עובדת את השם, היית עובדת את השם."
  },
  {
   "start": 1473.95,
   "end": 1478.17,
   "text": "איך בדור כזה מתקשרות אמהות ובוכות על הילדים שלהם?"
  },
  {
   "start": 1478.51,
   "end": 1482.03,
   "text": "למה הילדים שלהם מתרחקים מה' יתברך?"
  },
  {
   "start": 1483.53,
   "end": 1485.65,
   "text": "האור של המסירות נפש הוא גם היום,"
  },
  {
   "start": 1486.23,
   "end": 1489.35,
   "text": "ואנחנו ננצח, וננחיל אותו הלאה לדור הבא."
  },
  {
   "start": 1489.87,
   "end": 1490.07,
   "text": "אתם,"
  },
  {
   "start": 1490.53,
   "end": 1493.03,
   "text": "אתם צעירים וצעירות, מבוגרים ומבוגרות,"
  },
  {
   "start": 1493.43,
   "end": 1495.63,
   "text": "בואו נעביר לכולנו את הלב הנפלא שלנו."
  },
  {
   "start": 1496.19,
   "end": 1498.85,
   "text": "בואו נמשיך את מה שהנחיל עלינו חנה."
  },
  {
   "start": 1499.21,
   "end": 1500.79,
   "text": "חנה מתה על קידוש השם."
  },
  {
   "start": 1501.35,
   "end": 1503.77,
   "text": "חנה והילדים של הקטנים מתו על קידוש השם."
  },
  {
   "start": 1504.29,
   "end": 1508.21,
   "text": "בואו אנחנו, בואו אנחנו כאן, נחיה על קידוש השם."
  },
  {
   "start": 1508.55,
   "end": 1510.17,
   "text": "בואו נחיה על קידוש השם."
  },
  {
   "start": 1510.77,
   "end": 1512.17,
   "text": "לחיות על קידוש השם."
  },
  {
   "start": 1512.73,
   "end": 1514.13,
   "text": "לחיות על קידוש השם."
  },
  {
   "start": 1514.73,
   "end": 1515.77,
   "text": "זה רצון השם."
  },
  {
   "start": 1516.49,
   "end": 1518.03,
   "text": "זה המסירות נפש."
  },
  {
   "start": 1518.43,
   "end": 1521.55,
   "text": "ככה ננצח את כל האנטיוכוסים בעולם."
  },
  {
   "start": 1523.13,
   "end": 1524.33,
   "text": "ככה ננצח את כל,"
  },
  {
   "start": 1525.59,
   "end": 1526.19,
   "text": "את כל הפיגועים,"
  },
  {
   "start": 1526.59,
   "end": 1526.97,
   "text": "את כל הטרור,"
  },
  {
   "start": 1527.25,
   "end": 1527.89,
   "text": "את כל המצב הכלכלי."
  },
  {
   "start": 1528.89,
   "end": 1529.29,
   "text": "לחיות,"
  },
  {
   "start": 1529.83,
   "end": 1530.83,
   "text": "לחיות על קידוש השם."
  },
  {
   "start": 1551.92,
   "end": 1552.6,
   "text": "אתם יודעים,"
  },
  {
   "start": 1556.04,
   "end": 1557.94,
   "text": "אומרים חז״ל הקדושי,"
  },
  {
   "start": 1559.16,
   "end": 1562.46,
   "text": "מי זאת הייתה אותה חנה, אותה אימא גדולה?"
  },
  {
   "start": 1563.54,
   "end": 1565.16,
   "text": "אומר ספר הדורות,"
  },
  {
   "start": 1567.83,
   "end": 1569.23,
   "text": "היא הייתה תיקון,"
  },
  {
   "start": 1569.77,
   "end": 1574.35,
   "text": "היא הייתה ניצוץ נשמתה של אמתלאי בת קרנבו."
  },
  {
   "start": 1574.99,
   "end": 1578.83,
   "text": "אמתלאי בת קרנבו הייתה אימא של אברהם אבינו."
  },
  {
   "start": 1580.49,
   "end": 1581.81,
   "text": "האימא של אברהם אבינו,"
  },
  {
   "start": 1581.81,
   "end": 1585.95,
   "text": "כשאברהם אבינו הולך לנסור את עצמו על קידוש השם לפני נמרוד,"
  },
  {
   "start": 1586.39,
   "end": 1589.35,
   "text": "היא ניסתה למנוע ממנו לא אל תלך,"
  },
  {
   "start": 1589.81,
   "end": 1591.23,
   "text": "אל תקדש שם שמיים,"
  },
  {
   "start": 1591.77,
   "end": 1592.39,
   "text": "אל תלך."
  },
  {
   "start": 1594.84,
   "end": 1598.1,
   "text": "באה הכנה תיקון של אמתלייק בת קרנבו,"
  },
  {
   "start": 1598.64,
   "end": 1601.1,
   "text": "מסרה את כל הילדים שלה על קידוש השם."
  },
  {
   "start": 1602.16,
   "end": 1604.04,
   "text": "לכן היא אמרה להם, בניי,"
  },
  {
   "start": 1604.7,
   "end": 1607.72,
   "text": "לכו ואמרו דווקא לאברהם,"
  },
  {
   "start": 1608.36,
   "end": 1609.84,
   "text": "תיקנתי,"
  },
  {
   "start": 1610.42,
   "end": 1613.1,
   "text": "אתה עקת מזבח אחד,"
  },
  {
   "start": 1613.94,
   "end": 1616.74,
   "text": "אני עקנתי שבעה מזבחות,"
  },
  {
   "start": 1617.38,
   "end": 1620.36,
   "text": "אני תיקנתי, הגעתי לשלמות."
  },
  {
   "start": 1620.92,
   "end": 1622.62,
   "text": "יצאתה בת קול ואמרה,"
  },
  {
   "start": 1623.18,
   "end": 1625.08,
   "text": "אם הבנים שמחה,"
  },
  {
   "start": 1625.44,
   "end": 1628.1,
   "text": "אף היא עלתה לגג ונפלה ומתה."
  },
  {
   "start": 1628.48,
   "end": 1630.22,
   "text": "יצאתה בת קול ואמרה,"
  },
  {
   "start": 1630.88,
   "end": 1633.9,
   "text": "אם הבנים שמחה."
  },
  {
   "start": 1638.23,
   "end": 1641.37,
   "text": "שמחה בכל מקום הפירוש שלה, שלמות."
  },
  {
   "start": 1642.05,
   "end": 1644.67,
   "text": "שמחה בכל מקום, הפירוש שלה, אחדות."
  },
  {
   "start": 1645.67,
   "end": 1652.87,
   "text": "הזכר של חנה ושבעת בניה נשאר חקוק בליבו של העם היהודי לדורי דורות."
  },
  {
   "start": 1654.47,
   "end": 1655.89,
   "text": "מי זוכר את אותו קיסר?"
  },
  {
   "start": 1656.91,
   "end": 1660.13,
   "text": "אבל כולנו זוכרים את חנה ושבעת בניה."
  },
  {
   "start": 1660.81,
   "end": 1662.63,
   "text": "אם הבנים שמחה."
  },
  {
   "start": 1663.55,
   "end": 1664.19,
   "text": "הללויה."
  }
 ]
}