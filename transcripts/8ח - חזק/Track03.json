{
 "disc": "8ח - חזק",
 "track": "Track03",
 "duration": 1108.176,
 "segments": [
  {
   "start": 9.69,
   "end": 11.11,
   "text": "מאז המקרה בו נפגע,"
  },
  {
   "start": 12.05,
   "end": 13.81,
   "text": "בו איבד את מאור עיניו רבי אברהם נחמני,"
  },
  {
   "start": 14.51,
   "end": 15.41,
   "text": "עברו שלושה חודשים."
  },
  {
   "start": 17.15,
   "end": 17.45,
   "text": "יום אחד,"
  },
  {
   "start": 18.51,
   "end": 20.45,
   "text": "ברחוב הקבצנים, שם בגטו היהודים,"
  },
  {
   "start": 21.19,
   "end": 22.79,
   "text": "נעצרת לה מרכבה הדורה."
  },
  {
   "start": 24.83,
   "end": 27.85,
   "text": "יד יוצאת מהמרכבה, ומטבע הזהב"
  },
  {
   "start": 28.51,
   "end": 29.93,
   "text": "נזרקת לקבצן העיוור,"
  },
  {
   "start": 31.69,
   "end": 33.35,
   "text": "שהקרין סביבו אור מיוחד."
  },
  {
   "start": 38.14,
   "end": 39.18,
   "text": "אני לא יכול לראות אותך,"
  },
  {
   "start": 40.04,
   "end": 41.82,
   "text": "אבל נשמתך זוהרת אליי,"
  },
  {
   "start": 42.8,
   "end": 43.42,
   "text": "אמר הרב,"
  },
  {
   "start": 44.96,
   "end": 49.42,
   "text": "והאיש מהמרכבה ירד."
  },
  {
   "start": 50.8,
   "end": 53.38,
   "text": "התקרב אל רבי אברהם נחמני ואמר לו,"
  },
  {
   "start": 54.22,
   "end": 56.9,
   "text": "חוט של חסד אלוקים משוך על פניך."
  },
  {
   "start": 61.29,
   "end": 64.61,
   "text": "למה אתה מדבר עם יהודי עלוב שכמוני? זה יכול לסכן אותך. לך מפה."
  },
  {
   "start": 67.48,
   "end": 69.24,
   "text": "אני אזרח צרפתי חופשי,"
  },
  {
   "start": 69.76,
   "end": 73.46,
   "text": "ואף אחד פה בספרד לא יגיד לי מה לעשות,"
  },
  {
   "start": 75.86,
   "end": 76.42,
   "text": "אדוני הרב."
  },
  {
   "start": 77.58,
   "end": 78.98,
   "text": "ואם תרשה לי לקחת אותך,"
  },
  {
   "start": 79.6,
   "end": 97.61,
   "text": "יחדתי לטייל קצת במרכבה והאציל הצרפתי שהתברר אחרי זה ששמו היה המרכיז דובל"
  },
  {
   "start": 101.86,
   "end": 105.2,
   "text": "עזר לרבי אברהם נחמני לעלות איתו למרכבה"
  },
  {
   "start": 106.7,
   "end": 111.2,
   "text": "והם יצאו לטיול, אולי טיול מוזר, לא מובן"
  },
  {
   "start": 112.96,
   "end": 114.04,
   "text": "ברחבי ולנסיה."
  },
  {
   "start": 119.18,
   "end": 123.37,
   "text": "המרכיז דובל סיפר"
  },
  {
   "start": 124.29,
   "end": 126.27,
   "text": "לרבי אברהם נחמני במהלך הטיול"
  },
  {
   "start": 126.93,
   "end": 128.49,
   "text": "שהוא חייב תודה מיוחדת ליהודים."
  },
  {
   "start": 129.49,
   "end": 130.07,
   "text": "ולא רק זה,"
  },
  {
   "start": 130.59,
   "end": 134.07,
   "text": "אלא יש לו חשבון פתוח עם בישוף שקוראים לו גספרי."
  },
  {
   "start": 135.95,
   "end": 136.99,
   "text": "ולכן הוא מעוניין"
  },
  {
   "start": 138.01,
   "end": 139.79,
   "text": "לעזור לקהילה היהודית."
  },
  {
   "start": 143.46,
   "end": 143.8,
   "text": "הרב,"
  },
  {
   "start": 144.76,
   "end": 147.8,
   "text": "שלא ידע אם זה עוד סוכן של גספרי,"
  },
  {
   "start": 148.98,
   "end": 149.56,
   "text": "או באמת"
  },
  {
   "start": 151.06,
   "end": 153.2,
   "text": "גוי מחסידי אומות העולם,"
  },
  {
   "start": 155.22,
   "end": 155.54,
   "text": "שתק."
  },
  {
   "start": 157.28,
   "end": 159.74,
   "text": "אבל המרכיז דובל נהג"
  },
  {
   "start": 160.08,
   "end": 160.78,
   "text": "מאז אותו יום,"
  },
  {
   "start": 161.74,
   "end": 162.62,
   "text": "פעם בשבוע לבוא"
  },
  {
   "start": 164.16,
   "end": 165.18,
   "text": "ולשוחח עם הרב."
  },
  {
   "start": 165.9,
   "end": 167.02,
   "text": "ככה נוצרה מערכת"
  },
  {
   "start": 168.02,
   "end": 178.7,
   "text": "כמעט בלתי אפשרית של יחסי אמון בין הצרפתי מחסידי אומות העולם לבין הרב היהודי."
  },
  {
   "start": 183.36,
   "end": 184.32,
   "text": "לאט לאט הם יושבים,"
  },
  {
   "start": 185.56,
   "end": 187.58,
   "text": "וככל שהיחסים,"
  },
  {
   "start": 188.78,
   "end": 191.36,
   "text": "יחסי האמון נרקמים ביניהם, הם החלו לתכנן תוכנית"
  },
  {
   "start": 192.24,
   "end": 194.8,
   "text": "להברחת בני הקהילה היהודית לצרפת."
  },
  {
   "start": 195.78,
   "end": 197.82,
   "text": "המרכיז דובל, משהו הניע אותו."
  },
  {
   "start": 201.03,
   "end": 201.89,
   "text": "הוא גייס כסף"
  },
  {
   "start": 205.57,
   "end": 206.39,
   "text": "ואפילו שיחד"
  },
  {
   "start": 207.05,
   "end": 208.99,
   "text": "כמה מהאנשים של גספרי לעבוד איתו."
  },
  {
   "start": 210.87,
   "end": 211.55,
   "text": "והתוכנית,"
  },
  {
   "start": 212.01,
   "end": 214.37,
   "text": "תוכנית הבריחה לצרפת, החל לקורמת עור וגידים."
  },
  {
   "start": 216.03,
   "end": 216.53,
   "text": "לא להאמין,"
  },
  {
   "start": 217.05,
   "end": 220.57,
   "text": "לפעמים אתה לא מבין מאיפה הקדוש ברוך הוא שולח את הישועה."
  },
  {
   "start": 225.68,
   "end": 226.18,
   "text": "בינתיים,"
  },
  {
   "start": 227.56,
   "end": 228.98,
   "text": "הבישוף גספרי לחוץ."
  },
  {
   "start": 228.98,
   "end": 230.98,
   "text": "היהודים,"
  },
  {
   "start": 231.86,
   "end": 234.06,
   "text": "היהודים לא רק שלא נשברים,"
  },
  {
   "start": 235.8,
   "end": 237.42,
   "text": "הם אפילו לא חושבים על המרת הדת,"
  },
  {
   "start": 245.81,
   "end": 246.31,
   "text": "והוא מחליט,"
  },
  {
   "start": 247.87,
   "end": 250.23,
   "text": "הוא מחליט לגייס את שלמה נחמני,"
  },
  {
   "start": 250.97,
   "end": 251.97,
   "text": "את סברוס שלו,"
  },
  {
   "start": 252.71,
   "end": 254.49,
   "text": "לרגל אחרי היהודים."
  },
  {
   "start": 255.57,
   "end": 256.59,
   "text": "הוא קורא אותו אליו,"
  },
  {
   "start": 260.5,
   "end": 262.94,
   "text": "ואז מסביר לו בצורה שאינה משתמעת לשני פנים,"
  },
  {
   "start": 265.0,
   "end": 266.46,
   "text": "שהוא יהרוס לו את כל המשפחה,"
  },
  {
   "start": 267.1,
   "end": 267.64,
   "text": "את כל העסקים,"
  },
  {
   "start": 268.38,
   "end": 269.0,
   "text": "את הכל,"
  },
  {
   "start": 269.46,
   "end": 274.74,
   "text": "אם הוא לא עכשיו יצטרף, יהיה מרגל לטובתו בתוך אחיו היהודים."
  },
  {
   "start": 277.68,
   "end": 280.7,
   "text": "ושלמה לא יודע איך לצאת, איך לצאת מהסבך הזה."
  },
  {
   "start": 281.9,
   "end": 283.34,
   "text": "הוא לא האמין שהוא יגיע לכך הוא חשב."
  },
  {
   "start": 285.83,
   "end": 287.27,
   "text": "חשב אולי מחשבות בהתחלה,"
  },
  {
   "start": 287.85,
   "end": 289.03,
   "text": "שהוא יתנצר מחשבות טובות,"
  },
  {
   "start": 290.15,
   "end": 298.95,
   "text": "אבל היום הוא מבין כבר שהוא נכנס אל בן קורי העכביש שלחד אותו לאט-לאט."
  },
  {
   "start": 303.3,
   "end": 304.0,
   "text": "למחרת היום,"
  },
  {
   "start": 309.1,
   "end": 309.8,
   "text": "חומק שלמה."
  },
  {
   "start": 310.96,
   "end": 311.76,
   "text": "לבוש בפשטות,"
  },
  {
   "start": 313.32,
   "end": 313.8,
   "text": "מוסווה"
  },
  {
   "start": 314.88,
   "end": 316.18,
   "text": "אל תוך הגטו היהודי,"
  },
  {
   "start": 321.35,
   "end": 323.49,
   "text": "אל עבר ביתו של רבי אברהם אחיו."
  },
  {
   "start": 340.12,
   "end": 340.86,
   "text": "שעת ערב,"
  },
  {
   "start": 343.38,
   "end": 345.64,
   "text": "משהו אמר לשלומו לא להיכנס מיד"
  },
  {
   "start": 346.34,
   "end": 348.08,
   "text": "אל אחיו שגם ככה לא רוצה לקבל אותו."
  },
  {
   "start": 351.28,
   "end": 352.5,
   "text": "הוא התחבא לו מאחורי החלום"
  },
  {
   "start": 353.66,
   "end": 354.64,
   "text": "ושמע קולות,"
  },
  {
   "start": 356.28,
   "end": 357.02,
   "text": "קולות מוכרים."
  },
  {
   "start": 358.1,
   "end": 361.02,
   "text": "ופתאום הוא מזהה את קולו של המרקיז דובל,"
  },
  {
   "start": 361.82,
   "end": 363.0,
   "text": "הצרפתי המפורסם."
  },
  {
   "start": 363.76,
   "end": 364.8,
   "text": "מה הוא עושה פה אצל אחי?"
  },
  {
   "start": 365.92,
   "end": 366.32,
   "text": "מה הוא עושה?"
  },
  {
   "start": 367.86,
   "end": 369.32,
   "text": "האציל הצרפתי אצל אחי."
  },
  {
   "start": 370.52,
   "end": 375.3,
   "text": "ושלמה מאזין ושומע על תוכנית הבריחה."
  },
  {
   "start": 379.68,
   "end": 380.84,
   "text": "שלמה החל מדמיין"
  },
  {
   "start": 381.54,
   "end": 383.18,
   "text": "מה הוא יזכה מגספרי"
  },
  {
   "start": 384.0,
   "end": 385.06,
   "text": "עבור המידע הזה."
  },
  {
   "start": 390.64,
   "end": 392.96,
   "text": "יותר מאוחר, כשהמרכיז דובל יצא,"
  },
  {
   "start": 394.12,
   "end": 395.22,
   "text": "שלמה המתין כמה דקות,"
  },
  {
   "start": 396.16,
   "end": 398.6,
   "text": "ואז החל לנקוש על הדלת."
  },
  {
   "start": 407.12,
   "end": 409.52,
   "text": "העתיד של אחיו, רבי אברהם, תלוי בו."
  },
  {
   "start": 410.52,
   "end": 411.52,
   "text": "הוא נקש בדלת."
  },
  {
   "start": 413.38,
   "end": 413.92,
   "text": "כן,"
  },
  {
   "start": 415.08,
   "end": 418.22,
   "text": "נשמע קולו של רבי אברהם, ושלמה נכנס."
  },
  {
   "start": 419.46,
   "end": 419.94,
   "text": "מי זה שם?"
  },
  {
   "start": 421.44,
   "end": 422.48,
   "text": "קרא רבי אברהם, מי זה?"
  },
  {
   "start": 426.47,
   "end": 428.35,
   "text": "ושלמה ראה את אחיו,"
  },
  {
   "start": 429.03,
   "end": 430.37,
   "text": "יותר נכון את גבו של אחיו."
  },
  {
   "start": 431.75,
   "end": 432.37,
   "text": "ואז,"
  },
  {
   "start": 433.67,
   "end": 434.77,
   "text": "אז רבי אברהם,"
  },
  {
   "start": 435.99,
   "end": 439.72,
   "text": "אחיו הבכור של שלמה,"
  },
  {
   "start": 440.6,
   "end": 442.28,
   "text": "הסתובב לאומתו,"
  },
  {
   "start": 443.7,
   "end": 444.24,
   "text": "ושלמה"
  },
  {
   "start": 445.46,
   "end": 448.81,
   "text": "ראה את מראה פני אחיו,"
  },
  {
   "start": 456.79,
   "end": 458.11,
   "text": "והכל קרס למולו."
  },
  {
   "start": 460.46,
   "end": 461.24,
   "text": "הוא היה מזורזר."
  },
  {
   "start": 464.39,
   "end": 464.77,
   "text": "מי זה?"
  },
  {
   "start": 467.06,
   "end": 468.64,
   "text": "זה אני, שלמה."
  },
  {
   "start": 469.86,
   "end": 470.66,
   "text": "לך מכאן."
  },
  {
   "start": 471.38,
   "end": 472.08,
   "text": "לך מכאן."
  },
  {
   "start": 473.72,
   "end": 475.0,
   "text": "קרר בי אברהם,"
  },
  {
   "start": 477.54,
   "end": 481.5,
   "text": "ושלמה מסתכל, רואה את אחיו מגשש באפלה,"
  },
  {
   "start": 484.95,
   "end": 486.45,
   "text": "והאמת פילחה את מוחו."
  },
  {
   "start": 487.65,
   "end": 488.05,
   "text": "אחיו."
  },
  {
   "start": 489.85,
   "end": 491.75,
   "text": "הם עיוותו את הפנים של אחיו."
  },
  {
   "start": 492.59,
   "end": 493.65,
   "text": "הם עיוורו את אחיו."
  },
  {
   "start": 497.95,
   "end": 498.71,
   "text": "לך מכאן."
  },
  {
   "start": 502.93,
   "end": 504.93,
   "text": "מכרת את הנשמה שלך. לך מכאן."
  },
  {
   "start": 506.95,
   "end": 513.65,
   "text": "ושלמה הסתובב ורץ ורץ ורץ כל הדרך כשהמראה של אחיו רודף אחריו."
  },
  {
   "start": 514.39,
   "end": 516.07,
   "text": "המראה של אחיו רודף אחריו."
  },
  {
   "start": 516.75,
   "end": 517.27,
   "text": "הוא רץ."
  },
  {
   "start": 518.63,
   "end": 519.73,
   "text": "כל עוד נפשו בו."
  },
  {
   "start": 522.53,
   "end": 524.45,
   "text": "רק הרוח הקרירה היא בשת הדמעות."
  },
  {
   "start": 525.27,
   "end": 527.21,
   "text": "שירדו ללא הפוגה."
  },
  {
   "start": 528.13,
   "end": 528.81,
   "text": "שלמה בכה."
  },
  {
   "start": 530.75,
   "end": 531.39,
   "text": "בכה על אחיו."
  },
  {
   "start": 532.39,
   "end": 533.05,
   "text": "בכה על אבא."
  },
  {
   "start": 533.47,
   "end": 534.01,
   "text": "על אמא."
  },
  {
   "start": 534.79,
   "end": 535.89,
   "text": "על היהדות שלו."
  },
  {
   "start": 536.49,
   "end": 537.33,
   "text": "על עצמו."
  },
  {
   "start": 551.69,
   "end": 552.79,
   "text": "משהו השתנה אצל שלמה."
  },
  {
   "start": 553.95,
   "end": 555.43,
   "text": "שלמה החל מארגן את המשפחה שלו"
  },
  {
   "start": 556.01,
   "end": 557.17,
   "text": "לנסיעה לצרפת."
  },
  {
   "start": 558.33,
   "end": 558.83,
   "text": "בחשאי,"
  },
  {
   "start": 559.45,
   "end": 560.47,
   "text": "בלי שאף אחד יודע."
  },
  {
   "start": 561.65,
   "end": 562.39,
   "text": "אני חייב לצאת."
  },
  {
   "start": 563.99,
   "end": 564.87,
   "text": "אני חייב לברוח."
  },
  {
   "start": 583.86,
   "end": 586.86,
   "text": "באותו יום שהוא ארגן את המשפחה שלו והתחיל להבריח אותה כבר בכלל"
  },
  {
   "start": 588.56,
   "end": 589.54,
   "text": "לכיוון צרפת."
  },
  {
   "start": 591.24,
   "end": 593.62,
   "text": "כדי להסיר חשד ממנו הוא פנה לגספרי."
  },
  {
   "start": 597.01,
   "end": 600.49,
   "text": "וגספרי הזמין אותו למשחק שחמט, הם נהגו מדי פעם לשחק ביניהם שחמט."
  },
  {
   "start": 603.44,
   "end": 604.04,
   "text": "שנים הם משחקים,"
  },
  {
   "start": 605.18,
   "end": 606.7,
   "text": "שנים שלמה מנצח."
  },
  {
   "start": 607.66,
   "end": 608.56,
   "text": "ולפתע הפעם"
  },
  {
   "start": 610.28,
   "end": 611.04,
   "text": "שלמה הפסיד."
  },
  {
   "start": 612.16,
   "end": 614.1,
   "text": "גספרי החל חושד בו משהו לא בסדר."
  },
  {
   "start": 614.26,
   "end": 618.86,
   "text": "גספרי היה ערמומי וחשדן, אי אפשר היה"
  },
  {
   "start": 620.56,
   "end": 624.06,
   "text": "אי אפשר היה לעבור אותו."
  },
  {
   "start": 628.43,
   "end": 630.15,
   "text": "וגספרי אומר, שלמה, אתה נשאר כאן."
  },
  {
   "start": 631.33,
   "end": 634.57,
   "text": "אני רוצה לשלוח כמה מהסוכנים שלי לבדוק מה קורה."
  },
  {
   "start": 636.19,
   "end": 640.79,
   "text": "והוא שולח סוכנים אליו הביתה."
  },
  {
   "start": 646.91,
   "end": 647.87,
   "text": "לא עובר זמן,"
  },
  {
   "start": 648.67,
   "end": 651.43,
   "text": "והסוכנים חוזרים ומדווחים"
  },
  {
   "start": 651.43,
   "end": 654.65,
   "text": "שהבית ששלמה ריק,"
  },
  {
   "start": 657.76,
   "end": 658.32,
   "text": "גספרי,"
  },
  {
   "start": 660.79,
   "end": 661.53,
   "text": "נותן הוראה,"
  },
  {
   "start": 662.15,
   "end": 662.89,
   "text": "מילה קצרה,"
  },
  {
   "start": 663.49,
   "end": 665.59,
   "text": "ושלמה נלקח למרתף האינקוויזיציה."
  },
  {
   "start": 669.2,
   "end": 670.52,
   "text": "הוא עובר סדרת עינויים"
  },
  {
   "start": 676.64,
   "end": 678.5,
   "text": "במטרה לגלות,"
  },
  {
   "start": 679.5,
   "end": 680.38,
   "text": "לגלות את הסודות"
  },
  {
   "start": 682.49,
   "end": 685.03,
   "text": "שהוא צופן בליבו."
  },
  {
   "start": 701.41,
   "end": 701.87,
   "text": "ושלמה,"
  },
  {
   "start": 702.77,
   "end": 705.05,
   "text": "שלמה אותו יהודי שוויתר,"
  },
  {
   "start": 705.95,
   "end": 707.21,
   "text": "ויתר על היהדות שלו,"
  },
  {
   "start": 707.69,
   "end": 709.25,
   "text": "ויתר על הכל למען הכסף,"
  },
  {
   "start": 710.33,
   "end": 712.13,
   "text": "עושה תפנית של 180 מעלות."
  },
  {
   "start": 712.65,
   "end": 714.87,
   "text": "הנשמה היהודית מתחילה להתנוצץ."
  },
  {
   "start": 715.47,
   "end": 717.47,
   "text": "הם מענים אותו, הם שוברים אותו,"
  },
  {
   "start": 717.99,
   "end": 718.95,
   "text": "אבל זרק את הגוף."
  },
  {
   "start": 719.49,
   "end": 721.49,
   "text": "הוא החליט, הוא חוזר הביתה."
  },
  {
   "start": 722.67,
   "end": 724.87,
   "text": "יהודי נשאר יהודי, לא יעזור כלום."
  },
  {
   "start": 725.63,
   "end": 726.79,
   "text": "שלמה לא מוכן לוותר."
  },
  {
   "start": 727.21,
   "end": 728.37,
   "text": "שלמה חורק שיניים."
  },
  {
   "start": 729.41,
   "end": 733.51,
   "text": "בזמן שמלתעות האינקוויזיציה מתהדקות סביבו."
  },
  {
   "start": 735.67,
   "end": 737.75,
   "text": "הוא יודע את האמת, הוא יודע שהיום בלילה,"
  },
  {
   "start": 738.79,
   "end": 739.93,
   "text": "בזמן שמענים אותו,"
  },
  {
   "start": 740.57,
   "end": 745.01,
   "text": "בינתיים, אי שם בוואלנסיה, הקהילה היהודית מוברחת."
  },
  {
   "start": 751.09,
   "end": 754.11,
   "text": "אהלך הבריחה מלווה בלחץ גדול,"
  },
  {
   "start": 754.67,
   "end": 756.47,
   "text": "כי בינתיים התפרסמה הידיעה ששלמה,"
  },
  {
   "start": 757.15,
   "end": 757.79,
   "text": "סוורוס,"
  },
  {
   "start": 758.65,
   "end": 759.87,
   "text": "בעינויים נתפס,"
  },
  {
   "start": 761.13,
   "end": 764.49,
   "text": "והמרכיז דובל חושש שמא יש לו מידע שיכול להסגיר אותם."
  },
  {
   "start": 766.09,
   "end": 771.11,
   "text": "וככה ספינה ועוד ספינה מפליגה לה נושאת מיהודי וואלנסיה,"
  },
  {
   "start": 773.83,
   "end": 775.75,
   "text": "והמרכיז דובל נותן הוראות קצרות."
  },
  {
   "start": 778.58,
   "end": 781.22,
   "text": "כל הספינות נעו, למעט ספינה אחת."
  },
  {
   "start": 781.76,
   "end": 782.98,
   "text": "ספינה אחרונה ממתינה."
  },
  {
   "start": 783.56,
   "end": 784.2,
   "text": "למי היא ממתינה?"
  },
  {
   "start": 785.5,
   "end": 787.38,
   "text": "היא ממתינה על פי אורת המרקיז דובל,"
  },
  {
   "start": 799.91,
   "end": 801.23,
   "text": "ואז בחסות החשיכה."
  },
  {
   "start": 802.67,
   "end": 804.25,
   "text": "לפתע נראים ארבע דמויות,"
  },
  {
   "start": 805.23,
   "end": 805.63,
   "text": "סוחבות,"
  },
  {
   "start": 807.03,
   "end": 807.75,
   "text": "סוחבות משהו,"
  },
  {
   "start": 808.75,
   "end": 809.67,
   "text": "סוחבות אלונקה,"
  },
  {
   "start": 812.94,
   "end": 813.6,
   "text": "ובאלונקה"
  },
  {
   "start": 815.12,
   "end": 815.56,
   "text": "שלמה"
  },
  {
   "start": 816.44,
   "end": 817.36,
   "text": "שלמה נחמני,"
  },
  {
   "start": 818.24,
   "end": 818.6,
   "text": "נכה,"
  },
  {
   "start": 819.58,
   "end": 820.2,
   "text": "מיוסר,"
  },
  {
   "start": 821.1,
   "end": 824.48,
   "text": "מוברח על ידי אנשי המרכיז שהוא השתלו באינקיוויזיציה."
  },
  {
   "start": 828.88,
   "end": 829.76,
   "text": "המרכיז דובל,"
  },
  {
   "start": 831.04,
   "end": 833.36,
   "text": "שכששמע על מסירות הנפש"
  },
  {
   "start": 834.48,
   "end": 835.12,
   "text": "של היהודי"
  },
  {
   "start": 836.16,
   "end": 842.2,
   "text": "שהמיר את דתו וחזר בתשובה שלמה ועומד בגבורה ולא מגלה שום סוד לאינקיוויזיציה,"
  },
  {
   "start": 842.54,
   "end": 843.78,
   "text": "עומד בעינויים בל יתוארו,"
  },
  {
   "start": 844.44,
   "end": 846.3,
   "text": "דאג לשחד מספר שומרים,"
  },
  {
   "start": 846.7,
   "end": 852.1,
   "text": "להפעיל את האנשים שלו באינקיוויזיציה על מנת להבריח את גופו השבור"
  },
  {
   "start": 852.84,
   "end": 853.34,
   "text": "של שלמה"
  },
  {
   "start": 868.62,
   "end": 874.52,
   "text": "שלמה מועלה על הספינה האחרונה שמתחילה להפליג לה"
  },
  {
   "start": 875.24,
   "end": 875.6,
   "text": "אל הים."
  },
  {
   "start": 876.58,
   "end": 880.54,
   "text": "ובספינה לא רק שלמה,"
  },
  {
   "start": 881.32,
   "end": 881.74,
   "text": "הוא נכה."
  },
  {
   "start": 882.72,
   "end": 883.9,
   "text": "יש שם עוד מישהו נכה."
  },
  {
   "start": 885.58,
   "end": 885.84,
   "text": "אחיו,"
  },
  {
   "start": 887.18,
   "end": 887.9,
   "text": "רבי אברהם,"
  },
  {
   "start": 890.52,
   "end": 891.46,
   "text": "המרכיז דובל,"
  },
  {
   "start": 892.94,
   "end": 894.08,
   "text": "מבשר לרבי אברהם"
  },
  {
   "start": 895.7,
   "end": 897.4,
   "text": "על עמידתו המופלאה של שלמה,"
  },
  {
   "start": 898.02,
   "end": 902.8,
   "text": "שעונה ומסר את נפשו כדי לא לגלות את הברחת יהודי ולנסיה."
  },
  {
   "start": 904.54,
   "end": 908.84,
   "text": "ורבי אברהם מבקש שיוליך אותו אל אחיו,"
  },
  {
   "start": 912.24,
   "end": 916.8,
   "text": "ושני האחים נכים בגופם,"
  },
  {
   "start": 917.7,
   "end": 919.18,
   "text": "כואבים בעצמותיהם,"
  },
  {
   "start": 921.06,
   "end": 921.88,
   "text": "אבל הרוח,"
  },
  {
   "start": 922.28,
   "end": 924.1,
   "text": "הנשמה שלהם חופשייה,"
  },
  {
   "start": 924.44,
   "end": 926.76,
   "text": "משוחררת חזקה יותר מאי פעם."
  },
  {
   "start": 928.28,
   "end": 928.94,
   "text": "הם נפגשים"
  },
  {
   "start": 929.9,
   "end": 936.26,
   "text": "מתחבקים ובוכים כמו צמד ילדים קטנים,"
  },
  {
   "start": 936.96,
   "end": 938.8,
   "text": "כמו שהם בכו כשהיו ילדים קטנים,"
  },
  {
   "start": 941.29,
   "end": 944.75,
   "text": "שני יהודים שמסרו נפש לכבוד השם יתברך,"
  },
  {
   "start": 945.53,
   "end": 946.83,
   "text": "כל אחד בדרכו הוא."
  },
  {
   "start": 949.22,
   "end": 949.94,
   "text": "הם התאחדו,"
  },
  {
   "start": 952.45,
   "end": 954.03,
   "text": "רבי אברהם ומשפחתו,"
  },
  {
   "start": 955.89,
   "end": 960.57,
   "text": "ושלמה נחמני, או רבי שלמה נחמני, מקדש שם שמיים,"
  },
  {
   "start": 962.03,
   "end": 964.23,
   "text": "התאחדו, ושני המשפחות"
  },
  {
   "start": 966.46,
   "end": 969.54,
   "text": "עם האונייה, עם הספינה,"
  },
  {
   "start": 971.52,
   "end": 973.48,
   "text": "הצליחו להגיע לצרפת."
  },
  {
   "start": 975.56,
   "end": 977.16,
   "text": "ומצרפת המשיכו להולנד,"
  },
  {
   "start": 977.94,
   "end": 979.9,
   "text": "שם הם מצאו בהולנד חוף מבטחים."
  },
  {
   "start": 980.74,
   "end": 982.64,
   "text": "שם המשיכו את מסורת אבותם."
  },
  {
   "start": 983.1,
   "end": 986.34,
   "text": "שם הם החלו לילדים שלהם, לנכדים שלהם, לנינים שלהם"
  },
  {
   "start": 987.54,
   "end": 988.62,
   "text": "את התורה הקדושה."
  },
  {
   "start": 996.24,
   "end": 998.04,
   "text": "וזה לא רק הם, לא רק האחים נחמני."
  },
  {
   "start": 998.66,
   "end": 1000.12,
   "text": "ככה עם ישראל תמיד היה."
  },
  {
   "start": 1001.16,
   "end": 1001.6,
   "text": "שבור,"
  },
  {
   "start": 1002.22,
   "end": 1009.56,
   "text": "מעונה אבל ממשיך לא נשבר לא נשבר יש קשיים יש ניסיונות מכל הסוגים"
  },
  {
   "start": 1011.68,
   "end": 1030.3,
   "text": "יש שמחזקים כל הזמן כמו רבי אברהם יש כאלה שנופלים כמו שלמה אבל גם היהודים שנופלים בסוף הם קמים הם קמים כי יש להם נשמה אלוקית כי הם חלק אלוקם ממעל כי עם ישראל זה עם אחר זה עם שונה זה עם חזק יותר"
  },
  {
   "start": 1031.06,
   "end": 1035.66,
   "text": "ועם ישראל מאוחד, פצוע, כואב,"
  },
  {
   "start": 1036.0,
   "end": 1039.68,
   "text": "אבל אנחנו נלחמים על האמונה שלנו, על החיים שלנו,"
  },
  {
   "start": 1040.12,
   "end": 1041.4,
   "text": "ואנחנו ננצח,"
  },
  {
   "start": 1041.86,
   "end": 1042.8,
   "text": "ואנחנו ננצח,"
  },
  {
   "start": 1043.4,
   "end": 1045.02,
   "text": "ואנחנו בחסדי השם יתברך,"
  },
  {
   "start": 1054.24,
   "end": 1054.94,
   "text": "אנחנו כולנו,"
  },
  {
   "start": 1058.0,
   "end": 1058.28,
   "text": "כולנו,"
  },
  {
   "start": 1061.22,
   "end": 1061.86,
   "text": "כולנו ביחד,"
  },
  {
   "start": 1062.38,
   "end": 1064.12,
   "text": "כן, בתקופה הזאת, תקופה שהיא חשוכה,"
  },
  {
   "start": 1064.96,
   "end": 1068.56,
   "text": "שהיא קשה, שהיא מלאה בערפל, כולנו נתעורר,"
  },
  {
   "start": 1069.2,
   "end": 1071.5,
   "text": "נשתחרר מהכבלים האלה של ההרגל,"
  },
  {
   "start": 1071.5,
   "end": 1085.46,
   "text": "מהכבלים של הקשיים ונצעק לאבא שבשמיים בורא עולם בורא עולם לא עזבת אותנו מעולם ואנחנו יודעים שאתה איתנו יודעים שאתה איתנו יודעים שאתה איתנו בורא עולם אנא ממך בורא עולם"
  },
  {
   "start": 1086.12,
   "end": 1101.28,
   "text": "בורא עולם תן לנו את הזכות הזאת להיות דבוקים אליך לבוא ולהגיד לך תודה כי כשיבוא המשיח כולם כולם יודו לך נודה לך על כל מה שעשית איתנו כי מה שאפילו קשה לנו זה חסד ממך יתברך"
  },
  {
   "start": 1101.5,
   "end": 1104.8,
   "text": "אוהבים אותך אבא שבשמיים, בוא ניתן תודה לשם יתברך."
  }
 ]
}