{
 "disc": "8ח - חזק",
 "track": "Track01",
 "duration": 564.168,
 "segments": [
  {
   "start": 0.66,
   "end": 1.6,
   "text": "פקודת מעצר הוצאה,"
  },
  {
   "start": 2.86,
   "end": 3.92,
   "text": "והם חיפשו אותו בכל מקום."
  },
  {
   "start": 6.1,
   "end": 6.76,
   "text": "מכריו וידידיו"
  },
  {
   "start": 7.62,
   "end": 8.32,
   "text": "השתדלו להחביא אותו"
  },
  {
   "start": 9.4,
   "end": 10.16,
   "text": "ככה שלא ימצאו אותו."
  },
  {
   "start": 13.25,
   "end": 15.29,
   "text": "הרב יחזקאל אברהמסקי, זכר צדיק לברכה."
  },
  {
   "start": 18.41,
   "end": 19.47,
   "text": "הרב יחזקאל אברהמסקי"
  },
  {
   "start": 20.61,
   "end": 22.07,
   "text": "הפך למבוקש מספר אחד"
  },
  {
   "start": 22.75,
   "end": 24.89,
   "text": "של המשטרה החשאית של רוסיה, הקגב."
  },
  {
   "start": 28.24,
   "end": 28.7,
   "text": "הקגב,"
  },
  {
   "start": 33.66,
   "end": 35.18,
   "text": "שהיו נוהגים לפשוט"
  },
  {
   "start": 36.4,
   "end": 38.74,
   "text": "ולתפוס להם מתנגדי שלטון כדבריהם,"
  },
  {
   "start": 39.56,
   "end": 42.06,
   "text": "והיו מעבירים אותם לזמן בלתי מוגבל."
  },
  {
   "start": 44.2,
   "end": 44.72,
   "text": "לסיביר,"
  },
  {
   "start": 45.58,
   "end": 47.1,
   "text": "לערבות סיביר הקפואות,"
  },
  {
   "start": 47.86,
   "end": 48.44,
   "text": "משם כבר"
  },
  {
   "start": 49.42,
   "end": 50.4,
   "text": "הדם לא היה חוזר."
  },
  {
   "start": 52.5,
   "end": 53.54,
   "text": "והחיפושים גברו"
  },
  {
   "start": 54.54,
   "end": 55.44,
   "text": "ממקום למקום."
  },
  {
   "start": 56.38,
   "end": 58.92,
   "text": "בנתן הרב אברמסקי הסתתר לו במרתף"
  },
  {
   "start": 59.54,
   "end": 60.92,
   "text": "ביתה של אלמנה ישישה."
  },
  {
   "start": 62.12,
   "end": 65.72,
   "text": "אף אחד לא יחשוב לחפש במרתף הזה שהיה מוסתר מן העין."
  },
  {
   "start": 73.1,
   "end": 74.82,
   "text": "הרב חיפש לו איזה ספר לקרוא."
  },
  {
   "start": 75.6,
   "end": 77.68,
   "text": "מה כבר אתה יכול לעשות כשאתה כלוא במרתף?"
  },
  {
   "start": 78.76,
   "end": 79.98,
   "text": "ולפתע הוא מצא ספר אחד."
  },
  {
   "start": 80.92,
   "end": 81.42,
   "text": "הוא פתח."
  },
  {
   "start": 83.36,
   "end": 86.52,
   "text": "מחבר הספר, רבי אלחנן ספקטור, אף בדין דה קובנה."
  },
  {
   "start": 88.42,
   "end": 93.78,
   "text": "סיפר הרבי יחזקאל אברהמסקי שאני פתחתי את הספר וראיתי שזה של רבי אלחנן ספקטור מקובנה."
  },
  {
   "start": 94.46,
   "end": 95.92,
   "text": "הבנתי למה אני מבוקש."
  },
  {
   "start": 98.35,
   "end": 99.59,
   "text": "כי אני פעם חלקתי עליו."
  },
  {
   "start": 101.09,
   "end": 102.09,
   "text": "באיזה נקודה מסוימת."
  },
  {
   "start": 103.61,
   "end": 104.53,
   "text": "אולי היה מותר לי לחלוק,"
  },
  {
   "start": 105.23,
   "end": 107.83,
   "text": "אבל בכל אופן כנראה יכול להיות זה פגע קצת בכבודו,"
  },
  {
   "start": 108.87,
   "end": 109.67,
   "text": "עכשיו אני מבין."
  },
  {
   "start": 111.59,
   "end": 112.49,
   "text": "ואברהם רמסקי"
  },
  {
   "start": 113.57,
   "end": 114.51,
   "text": "פתח את הספר,"
  },
  {
   "start": 115.63,
   "end": 119.43,
   "text": "וכשהוא פותח בדיוק בנקודת המחלוקת, בנקודה בה הם חלקו,"
  },
  {
   "start": 122.38,
   "end": 123.42,
   "text": "לימים סיפר הרב"
  },
  {
   "start": 124.22,
   "end": 125.58,
   "text": "כשאני ראיתי שפתחתי"
  },
  {
   "start": 126.46,
   "end": 128.62,
   "text": "באותה נקודה ידעתי שאני נתפס היום."
  },
  {
   "start": 129.66,
   "end": 131.04,
   "text": "ידעתי שמפה אני לא יוצא."
  },
  {
   "start": 132.24,
   "end": 132.94,
   "text": "אני נתפס."
  },
  {
   "start": 136.11,
   "end": 136.65,
   "text": "בצהריים"
  },
  {
   "start": 137.49,
   "end": 138.53,
   "text": "נתפס הרב במרתף."
  },
  {
   "start": 140.17,
   "end": 141.65,
   "text": "ביתה של האלמנה הקשישה"
  },
  {
   "start": 142.77,
   "end": 145.49,
   "text": "על ידי המשטרה החשאית הסובייטית."
  },
  {
   "start": 157.85,
   "end": 158.33,
   "text": "סיביר,"
  },
  {
   "start": 159.19,
   "end": 160.87,
   "text": "ערבות השלג הבלתי נגמרות,"
  },
  {
   "start": 162.51,
   "end": 163.49,
   "text": "עבודת פרך,"
  },
  {
   "start": 164.25,
   "end": 164.87,
   "text": "מכות,"
  },
  {
   "start": 165.39,
   "end": 166.53,
   "text": "ביזיונות,"
  },
  {
   "start": 167.35,
   "end": 170.59,
   "text": "זו מנת חלקו של האסיר בסיביר."
  },
  {
   "start": 171.75,
   "end": 173.41,
   "text": "אסירים נרקבים שם שנים,"
  },
  {
   "start": 174.69,
   "end": 176.79,
   "text": "איש לא יודע אם הוא ישתחרר,"
  },
  {
   "start": 177.69,
   "end": 178.89,
   "text": "איש לא יודע מה יהיה מחר."
  },
  {
   "start": 181.15,
   "end": 183.97,
   "text": "ולרב אברמסקי לא היה קל."
  },
  {
   "start": 185.13,
   "end": 187.39,
   "text": "כל חייו היו בעולם התורה,"
  },
  {
   "start": 188.13,
   "end": 189.19,
   "text": "ולפתע הוא נזרק"
  },
  {
   "start": 190.07,
   "end": 193.53,
   "text": "לא פחות ולא יותר אל הכלא הגרוע ביותר בעולם."
  },
  {
   "start": 195.47,
   "end": 196.67,
   "text": "מה יחזיק אותו?"
  },
  {
   "start": 197.87,
   "end": 199.21,
   "text": "איך הם לא הצליחו לשבור אותו?"
  },
  {
   "start": 204.22,
   "end": 206.7,
   "text": "היו שם אנשים בריאים יותר ממנו."
  },
  {
   "start": 207.24,
   "end": 210.68,
   "text": "היו שם אנשים חזקים יותר ממנו. היו שם קשוחים יותר ממנו."
  },
  {
   "start": 211.24,
   "end": 212.68,
   "text": "ונשברו אחד-אחד,"
  },
  {
   "start": 213.48,
   "end": 213.82,
   "text": "והוא"
  },
  {
   "start": 215.32,
   "end": 216.08,
   "text": "נשאר איתן."
  },
  {
   "start": 218.5,
   "end": 219.26,
   "text": "סיפר הרב"
  },
  {
   "start": 219.86,
   "end": 220.7,
   "text": "כל בוקר,"
  },
  {
   "start": 221.4,
   "end": 222.82,
   "text": "כשקמתי בבוקר,"
  },
  {
   "start": 223.88,
   "end": 225.54,
   "text": "אמרתי מודה אני לפניך,"
  },
  {
   "start": 226.1,
   "end": 227.3,
   "text": "מלך חי וקיים,"
  },
  {
   "start": 227.9,
   "end": 232.22,
   "text": "שהחזרת בי נשמתי בחמלה רבה אמונתך."
  },
  {
   "start": 233.06,
   "end": 234.72,
   "text": "כשאני הייתי אומר מודה אני,"
  },
  {
   "start": 235.94,
   "end": 238.48,
   "text": "אומר הרב, הייתי אומר מודה אני,"
  },
  {
   "start": 239.22,
   "end": 240.62,
   "text": "מה מחכה לי היום, מה?"
  },
  {
   "start": 242.06,
   "end": 242.94,
   "text": "יום של מכות,"
  },
  {
   "start": 243.62,
   "end": 244.5,
   "text": "יום של ביזיונות,"
  },
  {
   "start": 245.94,
   "end": 247.06,
   "text": "אז על מה אני מודה?"
  },
  {
   "start": 247.84,
   "end": 249.38,
   "text": "על מה אני אומר מודה אני?"
  },
  {
   "start": 250.74,
   "end": 259.22,
   "text": "אבל אמרתי מודה אני לפניך מלך חי וקיים שהחזרת בי נשמתי בחמלה וכשהגעתי לרבה אמונתך"
  },
  {
   "start": 260.12,
   "end": 265.0,
   "text": "הייתי מחזק ומקבל כוח נפלא רבה אמונתך"
  },
  {
   "start": 265.86,
   "end": 274.46,
   "text": "את האמונה בשם יתברך הם לא יכולים לקחת לי הם יכולים לעשות לי הכל אבל את האמונה בשם יתברך"
  },
  {
   "start": 275.0,
   "end": 278.76,
   "text": "את זה הם לא יכולים לקחת לי. את זה אף אחד לא יכול לקחת לי."
  },
  {
   "start": 279.5,
   "end": 281.9,
   "text": "שווה לי לחיות בשביל האמונה הזאת."
  },
  {
   "start": 283.12,
   "end": 284.9,
   "text": "בשביל האמונה הזאת שווה לי לחיות."
  },
  {
   "start": 285.38,
   "end": 287.3,
   "text": "את האמונה הם לא יכולים לקחת לי."
  },
  {
   "start": 287.7,
   "end": 289.5,
   "text": "מה שהם לא יעשו לא יעזור כלום."
  },
  {
   "start": 289.92,
   "end": 291.66,
   "text": "את האמונה אתם לא תיקחו ממני."
  },
  {
   "start": 292.2,
   "end": 297.76,
   "text": "את החיות שלי אתם לא תיקחו את החיות האלוקית. הדבקות בה' מתברחת אתם לא תיגעו בה."
  },
  {
   "start": 298.78,
   "end": 299.68,
   "text": "וככה המשיך הרב."
  },
  {
   "start": 300.4,
   "end": 301.42,
   "text": "יום אחרי יום."
  },
  {
   "start": 302.6,
   "end": 304.24,
   "text": "חודש אחרי חודש."
  },
  {
   "start": 304.8,
   "end": 308.68,
   "text": "שנה אחר שנה זה מה שמחזיק אותו."
  },
  {
   "start": 309.6,
   "end": 310.98,
   "text": "את האמונה הם לא ייקחו ממנו."
  },
  {
   "start": 313.7,
   "end": 315.12,
   "text": "את האמונה שהכל לטובה."
  },
  {
   "start": 315.56,
   "end": 318.34,
   "text": "את האמונה שהשם יתברך משגיח ולא עוזב אותו לרגע."
  },
  {
   "start": 320.08,
   "end": 320.46,
   "text": "וככה,"
  },
  {
   "start": 321.14,
   "end": 321.9,
   "text": "בין כל החושך,"
  },
  {
   "start": 322.82,
   "end": 323.98,
   "text": "לילה אחד הוא חולם חלום,"
  },
  {
   "start": 325.2,
   "end": 326.04,
   "text": "והנה בחלום"
  },
  {
   "start": 327.06,
   "end": 328.92,
   "text": "רבי אלחנן הספקטור מקובנה,"
  },
  {
   "start": 329.66,
   "end": 330.26,
   "text": "זה שאז"
  },
  {
   "start": 331.14,
   "end": 332.52,
   "text": "הוא פתח את הספר שלו."
  },
  {
   "start": 333.56,
   "end": 335.42,
   "text": "מופיע לו בחלום, מחייך."
  },
  {
   "start": 337.16,
   "end": 340.36,
   "text": "הוא מתעורר בבוקר למחרת ומודיע לכולם, היום אני משתחרר."
  },
  {
   "start": 341.6,
   "end": 345.32,
   "text": "אומרים לו תגלי, אתה נורמלי, מישהו השתחרר, כבוד הרב, כנראה דעתך נטרפה עליך."
  },
  {
   "start": 346.78,
   "end": 348.9,
   "text": "בצהריים הגיעה פקודת שחרור."
  },
  {
   "start": 357.24,
   "end": 358.84,
   "text": "רציף הרכבת היה ריק מאדם."
  },
  {
   "start": 360.26,
   "end": 360.56,
   "text": "לבד"
  },
  {
   "start": 361.34,
   "end": 362.12,
   "text": "מדמות אחת"
  },
  {
   "start": 363.0,
   "end": 366.14,
   "text": "של אדם בעל חזות יהודית."
  },
  {
   "start": 367.48,
   "end": 369.9,
   "text": "הדמות עמדה לה בשקט ברציף והמתינה."
  },
  {
   "start": 371.92,
   "end": 372.2,
   "text": "לפתע"
  },
  {
   "start": 372.78,
   "end": 374.2,
   "text": "נשמעו פסיעות ברציף."
  },
  {
   "start": 375.48,
   "end": 376.42,
   "text": "הרב הפנה את הראש שלו."
  },
  {
   "start": 377.12,
   "end": 378.56,
   "text": "רבי יחזקאל אברמסקי ראה"
  },
  {
   "start": 379.4,
   "end": 380.8,
   "text": "למולו את מנהל הכלא."
  },
  {
   "start": 384.93,
   "end": 385.61,
   "text": "מה הוא רוצה ממני?"
  },
  {
   "start": 386.19,
   "end": 387.39,
   "text": "חלפה מחשבה בראשו."
  },
  {
   "start": 391.2,
   "end": 391.68,
   "text": "רבי יהודי,"
  },
  {
   "start": 392.74,
   "end": 395.68,
   "text": "עקבתי אחריך במשך כל השנים שהיית פה."
  },
  {
   "start": 396.8,
   "end": 397.94,
   "text": "הרבה יהודים נשברים."
  },
  {
   "start": 399.1,
   "end": 401.44,
   "text": "הרבה יהודים התרחקו מהזהות שלהם,"
  },
  {
   "start": 401.76,
   "end": 403.84,
   "text": "מהזהות היהודית, מהאמונה."
  },
  {
   "start": 404.36,
   "end": 405.26,
   "text": "נעלמו להם."
  },
  {
   "start": 405.8,
   "end": 406.46,
   "text": "ואינם."
  },
  {
   "start": 407.24,
   "end": 407.96,
   "text": "אבל אתה החזקת."
  },
  {
   "start": 408.94,
   "end": 412.54,
   "text": "אתה התנהגת כל הזמן כמו שיהודי צריך להתנהג."
  },
  {
   "start": 413.98,
   "end": 415.72,
   "text": "ואני באתי לכאן להגיד לך משהו."
  },
  {
   "start": 416.96,
   "end": 418.06,
   "text": "אמא שלי יהודייה."
  },
  {
   "start": 419.02,
   "end": 422.6,
   "text": "כשראיתי איך אתה מתאמץ, איך אתה מנצח,"
  },
  {
   "start": 423.44,
   "end": 427.76,
   "text": "איך אתה מאמין, הרגשתי גאה שאימא שלי יהודייה."
  },
  {
   "start": 429.72,
   "end": 435.86,
   "text": "הרגשתי בפעם הראשונה בחיי שאני גאה שאני יהודי."
  },
  {
   "start": 439.13,
   "end": 440.05,
   "text": "אז באתי לכאן."
  },
  {
   "start": 440.65,
   "end": 442.17,
   "text": "תראה לי את הכרטיס שקיבלת."
  },
  {
   "start": 443.93,
   "end": 445.97,
   "text": "והרב אברמסקי הוציא לו כרטיס אדום."
  },
  {
   "start": 447.35,
   "end": 448.01,
   "text": "אמר לו, תקשיב."
  },
  {
   "start": 448.99,
   "end": 450.15,
   "text": "מנהל הכלא אמר הרב,"
  },
  {
   "start": 451.33,
   "end": 452.37,
   "text": "כרטיס אדום,"
  },
  {
   "start": 453.17,
   "end": 454.47,
   "text": "השלטונות נתנו לך."
  },
  {
   "start": 454.99,
   "end": 457.07,
   "text": "יש כרטיס אדום ויש כרטיס ירוק."
  },
  {
   "start": 457.39,
   "end": 459.21,
   "text": "כרטיס אדום מעלים אותך אל קרון,"
  },
  {
   "start": 459.95,
   "end": 462.31,
   "text": "שבאמצע הדרך נפתחים החלונות,"
  },
  {
   "start": 462.69,
   "end": 464.97,
   "text": "והאוויר קר וקפוא נכנס,"
  },
  {
   "start": 465.63,
   "end": 467.41,
   "text": "ואין לך שום הגנה משום מקום,"
  },
  {
   "start": 467.75,
   "end": 470.85,
   "text": "ופשוט זה הופך אותך כעבור כמה זמן לגוש קרח."
  },
  {
   "start": 472.31,
   "end": 474.51,
   "text": "זה דרך השלטונות להיפטר מאנשים."
  },
  {
   "start": 476.65,
   "end": 478.25,
   "text": "גזר דין מוות בטוח."
  },
  {
   "start": 479.35,
   "end": 484.07,
   "text": "ויש כרטיס ירוק שבו אתה עולה על קרון שאתה נשאר בחיים, קרון סגור."
  },
  {
   "start": 484.83,
   "end": 487.21,
   "text": "יש לי פה איתי כרטיס ירוק בו אני אחליף לך."
  },
  {
   "start": 487.75,
   "end": 489.59,
   "text": "והוא אחליף לו לכרטיס ירוק."
  },
  {
   "start": 491.23,
   "end": 492.79,
   "text": "הרב אברמסקי עלה על הרכבת."
  },
  {
   "start": 494.13,
   "end": 496.07,
   "text": "עלה על הרכבת עם הכרטיס הירוק."
  },
  {
   "start": 496.97,
   "end": 499.91,
   "text": "הופנה בקרון של כרטיסים ירוקים וניצל."
  },
  {
   "start": 500.47,
   "end": 504.09,
   "text": "כל הדרך הוא ראה איך מוציאים גופות מהקרונות האדומים."
  },
  {
   "start": 505.17,
   "end": 507.01,
   "text": "והוא בקרון הירוק ניצל."
  },
  {
   "start": 509.78,
   "end": 512.7,
   "text": "עמידה בקשיים, העמידה בקשיים הצילה אותו ממוות."
  },
  {
   "start": 516.21,
   "end": 517.05,
   "text": "והוא זכה."
  },
  {
   "start": 517.85,
   "end": 521.01,
   "text": "איך הוא התעודד והתגבר בשעות הקשות? רבה אמונתך."
  },
  {
   "start": 521.59,
   "end": 524.31,
   "text": "את האמונה, הדבקות בה' יתברך, לא לקחת."
  },
  {
   "start": 524.83,
   "end": 526.07,
   "text": "וגם אנחנו צריכים לדעת היום."
  },
  {
   "start": 526.77,
   "end": 527.69,
   "text": "צריכים לדעת היום גם."
  },
  {
   "start": 528.43,
   "end": 529.17,
   "text": "גם כשקשה."
  },
  {
   "start": 529.75,
   "end": 530.65,
   "text": "גם שקשה,"
  },
  {
   "start": 531.61,
   "end": 531.95,
   "text": "תמיד,"
  },
  {
   "start": 532.67,
   "end": 533.07,
   "text": "תמיד,"
  },
  {
   "start": 534.45,
   "end": 535.21,
   "text": "תמיד נאמר"
  },
  {
   "start": 537.23,
   "end": 541.25,
   "text": "לקדוש ברוך הוא ברוך העולם, כמה שקשה אנחנו הבנים שלך ולא נעזוב אותך."
  },
  {
   "start": 542.05,
   "end": 542.55,
   "text": "לא ייקחו"
  },
  {
   "start": 543.23,
   "end": 546.03,
   "text": "את האמונה מאיתנו, את הדבקות בשם יתברך,"
  },
  {
   "start": 546.57,
   "end": 548.75,
   "text": "את אהבת השם יתברך, את זה אי אפשר לקחת מאיתנו."
  },
  {
   "start": 549.57,
   "end": 550.27,
   "text": "על זה לא נוותר."
  },
  {
   "start": 550.87,
   "end": 551.63,
   "text": "לא נוותר."
  },
  {
   "start": 551.95,
   "end": 552.97,
   "text": "זה יהיה תמיד איתנו."
  },
  {
   "start": 553.29,
   "end": 554.01,
   "text": "זה ילך איתנו."
  },
  {
   "start": 554.33,
   "end": 555.21,
   "text": "זה ילווה אותנו."
  },
  {
   "start": 555.53,
   "end": 558.69,
   "text": "אם נחשוב ככה, נקבל כוח, נקבל רוחניות,"
  },
  {
   "start": 558.69,
   "end": 561.47,
   "text": "נצליח, נצליח לעבור את כל הקשיים."
  }
 ]
}