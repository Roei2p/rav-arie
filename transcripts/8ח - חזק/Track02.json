{
 "disc": "8ח - חזק",
 "track": "Track02",
 "duration": 1648.176,
 "segments": [
  {
   "start": 7.37,
   "end": 7.89,
   "text": "משה נחמני."
  },
  {
   "start": 9.77,
   "end": 11.85,
   "text": "תלמיד חכם וצדיק."
  },
  {
   "start": 13.61,
   "end": 13.91,
   "text": "גר לו"
  },
  {
   "start": 14.97,
   "end": 17.23,
   "text": "בעיר ולנסיה שבספרד."
  },
  {
   "start": 18.21,
   "end": 18.93,
   "text": "היו לו שני בנים,"
  },
  {
   "start": 23.12,
   "end": 25.02,
   "text": "אברהם ושלמה."
  },
  {
   "start": 26.44,
   "end": 29.58,
   "text": "לאברהם מגיל קטן יש לו נטייה לתורה."
  },
  {
   "start": 30.66,
   "end": 31.88,
   "text": "לשלמה מגיל קטן"
  },
  {
   "start": 32.44,
   "end": 33.52,
   "text": "יש לו נטייה לעסקנות."
  },
  {
   "start": 38.92,
   "end": 39.36,
   "text": "הגיע יום"
  },
  {
   "start": 40.32,
   "end": 41.8,
   "text": "בו רבי משה נחמני"
  },
  {
   "start": 45.28,
   "end": 46.62,
   "text": "צריך ללכת לבית עולמו."
  },
  {
   "start": 47.02,
   "end": 48.12,
   "text": "הוא מכנס את הילדים ואומר,"
  },
  {
   "start": 50.38,
   "end": 52.48,
   "text": "אברהם, אתה תמיד היה לך נטייה לתורה,"
  },
  {
   "start": 53.02,
   "end": 54.04,
   "text": "אתה צריך לשבת וללמוד."
  },
  {
   "start": 54.74,
   "end": 55.04,
   "text": "שלמה,"
  },
  {
   "start": 55.96,
   "end": 57.14,
   "text": "תמיד היה לך נטייה לעסקים."
  },
  {
   "start": 58.7,
   "end": 61.9,
   "text": "אני רוצה שתעשו הסכם, הסכם יששכר וזבלון ביניכם."
  },
  {
   "start": 62.7,
   "end": 64.12,
   "text": "אברהם יישב וילמד תורה,"
  },
  {
   "start": 64.96,
   "end": 69.7,
   "text": "ושלמה, אתה תנהל את כל העסקים המסועפים שלי."
  },
  {
   "start": 70.8,
   "end": 73.3,
   "text": "רבי משה נחמני היה אחד מעשירי ספרד,"
  },
  {
   "start": 76.65,
   "end": 77.31,
   "text": "ובכסף"
  },
  {
   "start": 78.15,
   "end": 81.83,
   "text": "אתה, שלמה, תפרנס את אברהם, תאפשר לו ללמוד על מי מנוחות,"
  },
  {
   "start": 82.29,
   "end": 88.37,
   "text": "וככה תתחלק איתו גם בלימוד. יהיה לך גם תורה וגם כסף, וגם לך, אברהם, יהיה גם תורה וגם כסף."
  },
  {
   "start": 89.59,
   "end": 90.27,
   "text": "זה ההסכם,"
  },
  {
   "start": 91.65,
   "end": 93.55,
   "text": "ובמילים אלו, האב נפטר."
  },
  {
   "start": 95.91,
   "end": 96.49,
   "text": "והאחים,"
  },
  {
   "start": 97.07,
   "end": 98.47,
   "text": "צמד האחים הנפלאים האלה,"
  },
  {
   "start": 99.47,
   "end": 100.97,
   "text": "שומרים על ההסכם. שלמה,"
  },
  {
   "start": 102.03,
   "end": 102.83,
   "text": "בעסקים,"
  },
  {
   "start": 103.65,
   "end": 104.35,
   "text": "מצליח,"
  },
  {
   "start": 107.12,
   "end": 108.96,
   "text": "קשרים מסועפים בכל ספרד,"
  },
  {
   "start": 109.68,
   "end": 110.6,
   "text": "ורבי אברהם,"
  },
  {
   "start": 111.58,
   "end": 112.9,
   "text": "אט אט"
  },
  {
   "start": 113.92,
   "end": 115.98,
   "text": "נהפך לרב קהילת ולנסיה,"
  },
  {
   "start": 117.06,
   "end": 118.68,
   "text": "נושא הערצה לכל היהודים,"
  },
  {
   "start": 119.28,
   "end": 121.36,
   "text": "מסירות נפש בלתי ללאית לקהילה,"
  },
  {
   "start": 121.98,
   "end": 127.59,
   "text": "התמדה ולימוד כל מה"
  },
  {
   "start": 129.07,
   "end": 129.97,
   "text": "שבן תורה צריך."
  },
  {
   "start": 133.34,
   "end": 134.38,
   "text": "בינתיים בספרד,"
  },
  {
   "start": 135.12,
   "end": 137.28,
   "text": "בינתיים בספרד מתפשטת לה."
  },
  {
   "start": 139.16,
   "end": 140.0,
   "text": "האינקוויזיציה,"
  },
  {
   "start": 140.62,
   "end": 142.38,
   "text": "אותו שלטון אימים של הכנסייה"
  },
  {
   "start": 142.38,
   "end": 146.9,
   "text": "שעשה כל מה שבידו כדי לפגוע ביהודים,"
  },
  {
   "start": 147.3,
   "end": 149.82,
   "text": "כדי להרוג, להשמיד יהודים."
  },
  {
   "start": 152.34,
   "end": 155.32,
   "text": "זרועותיה השטניות של אינקוויזיציה מגיעות אף לוולנסיה."
  },
  {
   "start": 157.08,
   "end": 159.52,
   "text": "שנבין, אז האינקוויזיציה זה השלטון של הכנסייה"
  },
  {
   "start": 161.26,
   "end": 163.74,
   "text": "שהחליט שהוא צריך לנצר את כל היהודים."
  },
  {
   "start": 164.5,
   "end": 176.47,
   "text": "יהודי שלא רצה היה סופג עינויים כל כך קשים עד שהוא היה או מת"
  },
  {
   "start": 178.21,
   "end": 186.93,
   "text": "או נכנע ומתנצר, מה שכן יהודים רבים עשו את עצמם מתנצרים כלפי חוץ,"
  },
  {
   "start": 188.43,
   "end": 189.05,
   "text": "אבל בסתר"
  },
  {
   "start": 190.19,
   "end": 191.39,
   "text": "היו מנהלים אורח יהודי תקין,"
  },
  {
   "start": 193.61,
   "end": 195.11,
   "text": "וכשהאינקוויזיציה הייתה תופסת כאלה,"
  },
  {
   "start": 196.33,
   "end": 199.11,
   "text": "היו הורגים אותם בעינויים איומים, היו מעלים אותם על המוקד,"
  },
  {
   "start": 199.93,
   "end": 200.77,
   "text": "שורפים אותם חיים."
  },
  {
   "start": 203.48,
   "end": 206.94,
   "text": "אז האינקוויזיציה מתפשטת לה בספרד ומגיעה אף לוואלנסיה,"
  },
  {
   "start": 207.44,
   "end": 208.48,
   "text": "הבישוף של וואלנסיה,"
  },
  {
   "start": 209.0,
   "end": 209.46,
   "text": "גספרי."
  },
  {
   "start": 210.34,
   "end": 210.9,
   "text": "גספרי,"
  },
  {
   "start": 211.68,
   "end": 216.3,
   "text": "שהתפרסם יותר מאוחר כאחד מהבישופים האכזריים ביותר,"
  },
  {
   "start": 216.9,
   "end": 217.46,
   "text": "אנטישמי,"
  },
  {
   "start": 218.12,
   "end": 219.52,
   "text": "שואף לקידום וכוח,"
  },
  {
   "start": 220.14,
   "end": 221.34,
   "text": "נאמן לאינקוויזיציה."
  },
  {
   "start": 222.1,
   "end": 223.06,
   "text": "הוא פותח במסע,"
  },
  {
   "start": 224.2,
   "end": 226.16,
   "text": "בראש של מסע התנכלות ליהודים."
  },
  {
   "start": 227.94,
   "end": 228.94,
   "text": "או המרת דת,"
  },
  {
   "start": 229.54,
   "end": 232.3,
   "text": "או טיפול מיוחד, זה מה שעומד בפניכם."
  },
  {
   "start": 233.94,
   "end": 235.46,
   "text": "גספרי שם לעצמו מטרה,"
  },
  {
   "start": 235.98,
   "end": 239.06,
   "text": "לגרום לכל קהילת ולנסיה להמיר את דתם,"
  },
  {
   "start": 239.68,
   "end": 243.0,
   "text": "ולהחליף את אמונתם,"
  },
  {
   "start": 243.42,
   "end": 246.26,
   "text": "ולסלול ככה את הדרך של גספרי לוותיקן."
  },
  {
   "start": 247.28,
   "end": 249.1,
   "text": "ולשם כך הוא לא בחל בשום אמצעי."
  },
  {
   "start": 249.76,
   "end": 250.9,
   "text": "הכל היה כשר בשבילו."
  },
  {
   "start": 251.82,
   "end": 254.96,
   "text": "והיהודים האומללים נאלצו לעזוב את הבתים שלהם,"
  },
  {
   "start": 255.8,
   "end": 256.98,
   "text": "ולעבור לאיזה גטו"
  },
  {
   "start": 257.8,
   "end": 263.06,
   "text": "קטן וצר שבנו עבורם."
  },
  {
   "start": 263.72,
   "end": 265.22,
   "text": "הם ישבו שם בתת-תנאים,"
  },
  {
   "start": 267.45,
   "end": 269.53,
   "text": "בציפות נוראה, בעוני מחריד."
  },
  {
   "start": 270.75,
   "end": 271.39,
   "text": "אבל היהודים,"
  },
  {
   "start": 272.17,
   "end": 273.27,
   "text": "היהודים לא נשברים."
  },
  {
   "start": 277.52,
   "end": 278.86,
   "text": "גם רבי אברהם נחמני,"
  },
  {
   "start": 279.54,
   "end": 281.06,
   "text": "הרב של קהילת ולנסיה,"
  },
  {
   "start": 281.9,
   "end": 283.02,
   "text": "אף הוא הועבר לגטו."
  },
  {
   "start": 283.78,
   "end": 287.04,
   "text": "שם הוא נהפך למוקד הכוח הרוחני של היהודים."
  },
  {
   "start": 287.52,
   "end": 290.92,
   "text": "מעודד, תומך, כאילו, כאילו לא קרה כלום."
  },
  {
   "start": 293.12,
   "end": 295.72,
   "text": "כולם היו שואבים ממנו כוח, מרבי אברהם נחמני."
  },
  {
   "start": 297.46,
   "end": 298.44,
   "text": "ובינתיים אחיו,"
  },
  {
   "start": 299.14,
   "end": 300.12,
   "text": "שלמה נחמני,"
  },
  {
   "start": 300.9,
   "end": 301.98,
   "text": "העשיר הגדול,"
  },
  {
   "start": 303.14,
   "end": 306.64,
   "text": "שלמה נחמני היה מאז ומתמיד בין ידידיו"
  },
  {
   "start": 306.64,
   "end": 309.52,
   "text": "הקרובים של אבישוף גספרי."
  },
  {
   "start": 311.36,
   "end": 314.0,
   "text": "תוך חידוש הוא מנצל את קרבתו"
  },
  {
   "start": 315.72,
   "end": 317.5,
   "text": "של שלמה נחמני אליו,"
  },
  {
   "start": 318.38,
   "end": 323.66,
   "text": "פנה אבישוף גספרי והתחיל לשכנע ברכות את שלמה שימיר את דתו."
  },
  {
   "start": 325.93,
   "end": 330.95,
   "text": "גספרי ידע שאם הוא יצליח לשכנע את שלמה המפורסם, העשיר המפורסם, להמיר את דתו,"
  },
  {
   "start": 331.35,
   "end": 333.93,
   "text": "הרבה עשירים, הרבה יהודים, הלכו בעקבותיו."
  },
  {
   "start": 336.05,
   "end": 337.57,
   "text": "אז בתחילה הוא מנסה לדבר איתו בברכות,"
  },
  {
   "start": 338.55,
   "end": 339.45,
   "text": "אבל החבר שלו,"
  },
  {
   "start": 340.17,
   "end": 341.01,
   "text": "שלמה, לא כל כך"
  },
  {
   "start": 342.37,
   "end": 343.85,
   "text": "שש ונלהב לזה."
  },
  {
   "start": 344.81,
   "end": 345.85,
   "text": "אז הבישוף גספרי"
  },
  {
   "start": 346.93,
   "end": 348.63,
   "text": "שוכח לפתע את כל החברות,"
  },
  {
   "start": 349.49,
   "end": 350.73,
   "text": "ומתחיל בתקיפות."
  },
  {
   "start": 351.51,
   "end": 353.73,
   "text": "מתחיל להסביר לו, שלמה, תדע לך,"
  },
  {
   "start": 354.71,
   "end": 355.67,
   "text": "אם אתה לא תמיר את דתך,"
  },
  {
   "start": 357.07,
   "end": 357.73,
   "text": "אתה תאבד."
  },
  {
   "start": 358.49,
   "end": 359.63,
   "text": "תאבד את כל רכושך."
  },
  {
   "start": 373.74,
   "end": 374.08,
   "text": "שלמה,"
  },
  {
   "start": 374.92,
   "end": 376.56,
   "text": "אני אהרוס אותך, לא יהיה לי ברירה."
  },
  {
   "start": 377.54,
   "end": 378.62,
   "text": "חברים, חברים,"
  },
  {
   "start": 379.2,
   "end": 380.8,
   "text": "אבל אתה הולך לאבד את כל מה שבנית."
  },
  {
   "start": 383.04,
   "end": 383.48,
   "text": "אם לא תתנצר."
  },
  {
   "start": 384.68,
   "end": 385.18,
   "text": "ושלמה,"
  },
  {
   "start": 385.92,
   "end": 387.76,
   "text": "שלמה מבקש ארכה למחשבה."
  },
  {
   "start": 397.69,
   "end": 398.43,
   "text": "הגטו היהודי."
  },
  {
   "start": 400.41,
   "end": 400.73,
   "text": "שלמה,"
  },
  {
   "start": 401.59,
   "end": 403.63,
   "text": "שלמה נחמני פסע המום,"
  },
  {
   "start": 404.59,
   "end": 405.41,
   "text": "המום בגטו."
  },
  {
   "start": 406.65,
   "end": 407.09,
   "text": "הוא הלך"
  },
  {
   "start": 409.17,
   "end": 411.01,
   "text": "אל אחיו הגדול רבי אברהם נחמני"
  },
  {
   "start": 411.89,
   "end": 412.73,
   "text": "להתייעץ איתו."
  },
  {
   "start": 413.41,
   "end": 413.93,
   "text": "מה לעשות?"
  },
  {
   "start": 414.99,
   "end": 416.37,
   "text": "מה לעשות עם אבישוף גספרי?"
  },
  {
   "start": 418.68,
   "end": 420.4,
   "text": "ואז הוא ראה את העוני,"
  },
  {
   "start": 421.18,
   "end": 426.98,
   "text": "את הדלות, את הצפיפות שזעקו מכל פינה בגטו היהודי."
  },
  {
   "start": 427.88,
   "end": 430.36,
   "text": "ושלמה, שהתרגל כל כך לאושר,"
  },
  {
   "start": 431.08,
   "end": 432.26,
   "text": "לנוחות, לרווחה,"
  },
  {
   "start": 433.48,
   "end": 435.66,
   "text": "היה קשה לו לדמיין את עצמו במצב הזה."
  },
  {
   "start": 437.02,
   "end": 437.58,
   "text": "אני אהיה פה,"
  },
  {
   "start": 438.22,
   "end": 438.74,
   "text": "אני לא יכול."
  },
  {
   "start": 440.26,
   "end": 440.84,
   "text": "זה יהרוס אותי."
  },
  {
   "start": 443.15,
   "end": 443.93,
   "text": "מוטב לי למות"
  },
  {
   "start": 444.65,
   "end": 445.93,
   "text": "ולא לאבד את מה שהשגתי."
  },
  {
   "start": 449.41,
   "end": 450.51,
   "text": "והוא מגיע לאחיו,"
  },
  {
   "start": 453.91,
   "end": 455.25,
   "text": "אל רבי אברהם הגדול,"
  },
  {
   "start": 458.14,
   "end": 458.84,
   "text": "מספר לו,"
  },
  {
   "start": 460.16,
   "end": 465.16,
   "text": "מספר לו מה גספרי הבישוף הרצחני רוצה ממנו."
  },
  {
   "start": 465.66,
   "end": 467.08,
   "text": "הוא שכח בכלל שאנחנו חברים,"
  },
  {
   "start": 467.8,
   "end": 468.6,
   "text": "לא אכפת לו כלום."
  },
  {
   "start": 470.44,
   "end": 471.18,
   "text": "הוא יפגע בי."
  },
  {
   "start": 471.76,
   "end": 474.34,
   "text": "מה אני עושה, אחי הגדול? מה אני עושה, רבי אברהם?"
  },
  {
   "start": 475.9,
   "end": 477.48,
   "text": "שלמה, זה ניסיון גדול,"
  },
  {
   "start": 478.06,
   "end": 483.42,
   "text": "ואתה חייב לעמוד בו. תדע לך, בורא עולם לא נותן לאדם ניסיונות שהוא לא יכול לעמוד בהם."
  },
  {
   "start": 484.12,
   "end": 485.46,
   "text": "אתה יכול לקדש שם שמיים."
  },
  {
   "start": 490.29,
   "end": 492.49,
   "text": "יש לך נשמה אלוקית, שלמה."
  },
  {
   "start": 493.15,
   "end": 493.75,
   "text": "אל תטמא אותה."
  },
  {
   "start": 494.69,
   "end": 495.37,
   "text": "לכבוד השם."
  },
  {
   "start": 495.97,
   "end": 497.01,
   "text": "לכבוד השם."
  },
  {
   "start": 497.65,
   "end": 499.59,
   "text": "אבא ואמא בשמיים מסתכלים עליך."
  },
  {
   "start": 501.8,
   "end": 502.44,
   "text": "אל תזוז."
  },
  {
   "start": 503.2,
   "end": 504.56,
   "text": "אפילו תאבד את כל רכושך."
  },
  {
   "start": 505.52,
   "end": 507.62,
   "text": "שלמה, אל תוותר, שלמה."
  },
  {
   "start": 510.53,
   "end": 511.13,
   "text": "אל תוותר."
  },
  {
   "start": 513.78,
   "end": 514.28,
   "text": "ושלמה,"
  },
  {
   "start": 516.23,
   "end": 517.11,
   "text": "שואב כוחות,"
  },
  {
   "start": 517.95,
   "end": 519.59,
   "text": "מתחזק מאחיו,"
  },
  {
   "start": 523.18,
   "end": 526.02,
   "text": "ויצא מהגטו היהודי נחוש בהחלטתו."
  },
  {
   "start": 526.62,
   "end": 527.08,
   "text": "אני לא מוותר."
  },
  {
   "start": 527.98,
   "end": 532.74,
   "text": "אני אשאר יהודי על אפו ועל חמתו של גספרי ועוד אלף כמותו."
  },
  {
   "start": 541.97,
   "end": 542.47,
   "text": "למחרת,"
  },
  {
   "start": 543.61,
   "end": 546.41,
   "text": "שלמה פוגש את הילדים שלו בבוקר."
  },
  {
   "start": 547.63,
   "end": 547.89,
   "text": "אבא,"
  },
  {
   "start": 548.61,
   "end": 549.57,
   "text": "אבא תביא לנו כסף."
  },
  {
   "start": 550.31,
   "end": 551.59,
   "text": "אבא, אני רוצה דמי כיס."
  },
  {
   "start": 552.49,
   "end": 554.15,
   "text": "אבא, תראה, אני צריך להחליף כמה בגדים."
  },
  {
   "start": 556.13,
   "end": 557.71,
   "text": "ושלמה מסתכל בילדים שלו."
  },
  {
   "start": 559.41,
   "end": 560.45,
   "text": "איך אני ארגיל אותם"
  },
  {
   "start": 562.25,
   "end": 563.37,
   "text": "למה שאני הולך לעשות?"
  },
  {
   "start": 564.37,
   "end": 566.39,
   "text": "מסתכל על רעייתו שהתרגלה לחיי מותרות."
  },
  {
   "start": 569.15,
   "end": 570.29,
   "text": "איך אני אאבד את כל זה?"
  },
  {
   "start": 570.87,
   "end": 574.43,
   "text": "לפתע הספק חזר לנקר במוחו."
  },
  {
   "start": 575.29,
   "end": 577.73,
   "text": "לפתע הפחד לפת את ליבו."
  },
  {
   "start": 579.31,
   "end": 579.83,
   "text": "ואז הוא החליט."
  },
  {
   "start": 581.91,
   "end": 584.29,
   "text": "אני אתנצל אבל רק למראית עין."
  },
  {
   "start": 586.13,
   "end": 587.51,
   "text": "כך אני ארוויח משני העולמות."
  },
  {
   "start": 588.13,
   "end": 589.87,
   "text": "מצד אחד הרכוש לי ישמר."
  },
  {
   "start": 590.53,
   "end": 594.75,
   "text": "מצד שני אני אשאר נאמן לעם ישראל ולבורא עולם."
  },
  {
   "start": 598.54,
   "end": 599.68,
   "text": "והבישוף גספרי,"
  },
  {
   "start": 600.3,
   "end": 604.36,
   "text": "ששלח לו ללא הרף הודעות על הודעות, נו מה קורה?"
  },
  {
   "start": 605.5,
   "end": 607.36,
   "text": "שמח לשמוע את החלטת"
  },
  {
   "start": 607.98,
   "end": 610.56,
   "text": "ידידו משכבר הימים, שלמה נחמני."
  },
  {
   "start": 614.27,
   "end": 617.29,
   "text": "הבישוף גספרי ארגן טקס פומבי ברוב עם והדר."
  },
  {
   "start": 618.65,
   "end": 623.95,
   "text": "הוא רצה לעשות הכל כדי שיהודים נוספים יראו ויומרצו גם הם להצטרף"
  },
  {
   "start": 625.27,
   "end": 625.81,
   "text": "אל שלמה"
  },
  {
   "start": 627.23,
   "end": 628.55,
   "text": "בעזיבת הדת היהודית."
  },
  {
   "start": 630.85,
   "end": 631.49,
   "text": "שלמה הרגיש"
  },
  {
   "start": 634.05,
   "end": 638.35,
   "text": "בכל, כל הזמן של אותו טקס משפיל שהוא עבר,"
  },
  {
   "start": 638.87,
   "end": 639.69,
   "text": "ירגיש שהבישוף,"
  },
  {
   "start": 640.39,
   "end": 641.19,
   "text": "החבר שלו,"
  },
  {
   "start": 642.27,
   "end": 644.01,
   "text": "למעשה לועג לו,"
  },
  {
   "start": 644.57,
   "end": 645.19,
   "text": "מזלזל בו."
  },
  {
   "start": 646.15,
   "end": 646.83,
   "text": "אבל הוא ידחיק את זה."
  },
  {
   "start": 647.27,
   "end": 647.75,
   "text": "אין ברירה."
  },
  {
   "start": 648.25,
   "end": 649.07,
   "text": "למען הילדים שלי."
  },
  {
   "start": 649.47,
   "end": 650.27,
   "text": "למען המשפחה שלי."
  },
  {
   "start": 650.69,
   "end": 651.69,
   "text": "למען העתיד שלי."
  },
  {
   "start": 652.03,
   "end": 652.93,
   "text": "צריך לעשות השתדלות."
  },
  {
   "start": 653.31,
   "end": 653.75,
   "text": "מה עם הפרנסה?"
  },
  {
   "start": 655.03,
   "end": 655.51,
   "text": "מה עם העבודה?"
  },
  {
   "start": 658.81,
   "end": 659.99,
   "text": "אני חייב ללכת על זה."
  },
  {
   "start": 661.73,
   "end": 662.89,
   "text": "אני לימד תורה בערב."
  },
  {
   "start": 663.97,
   "end": 665.53,
   "text": "אני אשמור מצוות בלי שאף אחד ידע."
  },
  {
   "start": 665.95,
   "end": 669.09,
   "text": "כלפי חוץ, כלפי חוץ, הנראה היא אחרת."
  },
  {
   "start": 670.03,
   "end": 670.49,
   "text": "אין לי ברירה."
  },
  {
   "start": 671.89,
   "end": 672.83,
   "text": "צריך להתפרנס."
  },
  {
   "start": 688.02,
   "end": 689.0,
   "text": "שלמה חוזר הביתה."
  },
  {
   "start": 691.68,
   "end": 693.32,
   "text": "בדרך הביתה הוא שומע על פרעות ביהודים."
  },
  {
   "start": 695.22,
   "end": 697.0,
   "text": "חנויות בתי מלאכה נשדדו."
  },
  {
   "start": 697.84,
   "end": 698.86,
   "text": "נהרסו עד היסוד."
  },
  {
   "start": 699.84,
   "end": 700.74,
   "text": "יהודים נפגעים."
  },
  {
   "start": 701.46,
   "end": 702.54,
   "text": "המון זועם מתפרע."
  },
  {
   "start": 703.48,
   "end": 704.46,
   "text": "לפתע אין משטרה?"
  },
  {
   "start": 704.96,
   "end": 705.56,
   "text": "אין כלום."
  },
  {
   "start": 706.2,
   "end": 707.7,
   "text": "היהודים לבד חשופים."
  },
  {
   "start": 709.58,
   "end": 710.7,
   "text": "שלמה חש כאב."
  },
  {
   "start": 711.54,
   "end": 715.68,
   "text": "אמר אולי אני אצליח לשכנע את גספרי להפסיק לפגוע ביהודים."
  },
  {
   "start": 717.22,
   "end": 718.58,
   "text": "אני בטח אלך כבר, אני אדבר איתו."
  },
  {
   "start": 719.22,
   "end": 720.78,
   "text": "הוא רק כל כך מרוצה מהצעד שלי."
  },
  {
   "start": 722.46,
   "end": 723.24,
   "text": "אני אלך לדבר איתו."
  },
  {
   "start": 729.14,
   "end": 730.2,
   "text": "כך חשב לו שלמה,"
  },
  {
   "start": 734.84,
   "end": 743.58,
   "text": "עד שההאשליה הזאת נופצה מול... כשגספרי הוא לא היה מוכן בכלל לקבל אותו אליו."
  },
  {
   "start": 745.48,
   "end": 746.0,
   "text": "ושלמה,"
  },
  {
   "start": 746.6,
   "end": 748.08,
   "text": "או יותר נכון סוורוס,"
  },
  {
   "start": 748.64,
   "end": 750.06,
   "text": "כך הוא כונה בשמו הנוצרי,"
  },
  {
   "start": 751.44,
   "end": 753.36,
   "text": "חזר הביתה אבל וחפוי ראש."
  },
  {
   "start": 764.26,
   "end": 764.5,
   "text": "בגטו."
  },
  {
   "start": 765.74,
   "end": 766.76,
   "text": "בגטו היהודי היהודים."
  },
  {
   "start": 767.68,
   "end": 767.96,
   "text": "היהודים"
  },
  {
   "start": 770.38,
   "end": 772.22,
   "text": "נהיו פיגועים הרוסים."
  },
  {
   "start": 773.44,
   "end": 774.12,
   "text": "שבורים."
  },
  {
   "start": 774.94,
   "end": 775.6,
   "text": "אבל כל זה חיצונית."
  },
  {
   "start": 776.78,
   "end": 779.08,
   "text": "כי הרוח שלהם, הרוח היהודי תטנה."
  },
  {
   "start": 779.54,
   "end": 786.08,
   "text": "הנשמה שלהם זועקת, קשורה עדיין לאבא שבשמיים. וכשהנשמה של היהודי קשורה לאבא שבשמיים,"
  },
  {
   "start": 787.68,
   "end": 789.62,
   "text": "אי אפשר לנצח אותו."
  },
  {
   "start": 790.48,
   "end": 793.86,
   "text": "ורבי אברהם נחמני עובר מבית לבית,"
  },
  {
   "start": 794.22,
   "end": 799.34,
   "text": "ממשפחה למשפחה ומחזק ומעודד את רוחם הנכהה."
  },
  {
   "start": 803.04,
   "end": 806.8,
   "text": "אפילו מהכסף, מאותו כסף שהוא מקבל מאח שלו שלמה,"
  },
  {
   "start": 807.84,
   "end": 808.98,
   "text": "במקום לקח את זה לעצמו,"
  },
  {
   "start": 809.54,
   "end": 811.22,
   "text": "הוא מרעיף את זה על עניי הקהילה."
  },
  {
   "start": 814.19,
   "end": 816.97,
   "text": "כל הקהילה למעשה נהפכו לעניים מקבצי נדבות,"
  },
  {
   "start": 818.51,
   "end": 820.25,
   "text": "במיוחד אחרי הפרעות האחרונות."
  },
  {
   "start": 821.49,
   "end": 824.29,
   "text": "ורבי אברהם נחמני לוקח את הכסף ומחלק אותו בין כולם."
  },
  {
   "start": 827.16,
   "end": 827.72,
   "text": "בינתיים,"
  },
  {
   "start": 828.56,
   "end": 830.74,
   "text": "בינתיים אי שם במרתפי האינקוויזיציה."
  },
  {
   "start": 831.84,
   "end": 832.32,
   "text": "גספרי."
  },
  {
   "start": 833.28,
   "end": 836.06,
   "text": "גספרי שולח סוכני חרש לבדוק למה."
  },
  {
   "start": 836.96,
   "end": 838.26,
   "text": "למה היהודים לא נכנעים?"
  },
  {
   "start": 839.38,
   "end": 845.04,
   "text": "מה גורם להם להישאר איתנים בדעתם, לא להישבר?"
  },
  {
   "start": 851.36,
   "end": 853.4,
   "text": "ימים מספר אחר כך חוזרים,"
  },
  {
   "start": 853.96,
   "end": 855.92,
   "text": "חוזרים, חוזרים המרגלים של גספרי."
  },
  {
   "start": 857.16,
   "end": 858.32,
   "text": "ליהודים יש מנהיג."
  },
  {
   "start": 859.56,
   "end": 861.26,
   "text": "קוראים לו רבי אברהם נחמני."
  },
  {
   "start": 862.7,
   "end": 865.38,
   "text": "כל עוד שהוא קיים, הוא מחזק את כל היהודים."
  },
  {
   "start": 869.29,
   "end": 869.83,
   "text": "גספרי"
  },
  {
   "start": 870.97,
   "end": 873.77,
   "text": "קורא לשלמה נחמני, לסוורוס."
  },
  {
   "start": 875.09,
   "end": 875.73,
   "text": "סוורוס,"
  },
  {
   "start": 876.61,
   "end": 877.01,
   "text": "תגיד לי,"
  },
  {
   "start": 877.83,
   "end": 879.27,
   "text": "למה אח שלך לא מקבץ נדבות?"
  },
  {
   "start": 880.57,
   "end": 881.73,
   "text": "מאיפה יש לו כסף"
  },
  {
   "start": 882.27,
   "end": 884.37,
   "text": "להחלק לקהילה היהודית?"
  },
  {
   "start": 885.95,
   "end": 890.44,
   "text": "אז שלמה מסביר לו,"
  },
  {
   "start": 891.04,
   "end": 892.86,
   "text": "מספר לו על ההסכם ביניהם,"
  },
  {
   "start": 894.28,
   "end": 895.46,
   "text": "על הצוואה של אבא."
  },
  {
   "start": 897.58,
   "end": 899.56,
   "text": "גספרי זועם ורועד מזעם."
  },
  {
   "start": 900.54,
   "end": 900.92,
   "text": "אתה לא מתבייש?"
  },
  {
   "start": 901.2,
   "end": 904.92,
   "text": "אני אוסר עליך לתת לו אפילו פרוטה אחת."
  },
  {
   "start": 906.46,
   "end": 906.84,
   "text": "שמעת?"
  },
  {
   "start": 908.66,
   "end": 912.48,
   "text": "דמך בראש חיים אני אדע שאתה נותן פרוטה אחת לגטו היהודי."
  },
  {
   "start": 916.08,
   "end": 916.36,
   "text": "שלמה,"
  },
  {
   "start": 916.88,
   "end": 919.56,
   "text": "שחושש שגספרי ילך ויפגע גם באחיו,"
  },
  {
   "start": 924.89,
   "end": 926.07,
   "text": "אומר לגספרי, תגיד לי,"
  },
  {
   "start": 926.67,
   "end": 928.03,
   "text": "מותר לי לדבר עם אחי על זה?"
  },
  {
   "start": 929.61,
   "end": 931.15,
   "text": "מותר לך לדבר עם אחיך על זה?"
  },
  {
   "start": 932.27,
   "end": 932.65,
   "text": "מותר."
  },
  {
   "start": 933.67,
   "end": 936.45,
   "text": "תשכנע אותו גם שיאמיר את דתו ואנחנו נדאג לו"
  },
  {
   "start": 937.15,
   "end": 939.29,
   "text": "למעמד טוב ולכסף, להפסיק להיות עני."
  },
  {
   "start": 940.65,
   "end": 941.59,
   "text": "יוכל לחיות כמוך."
  },
  {
   "start": 943.55,
   "end": 944.23,
   "text": "כמו שאתה,"
  },
  {
   "start": 945.19,
   "end": 946.39,
   "text": "חייך גספרי בלעג,"
  },
  {
   "start": 947.23,
   "end": 947.73,
   "text": "לא מוסתר."
  },
  {
   "start": 966.5,
   "end": 967.16,
   "text": "הגטו היהודי,"
  },
  {
   "start": 968.24,
   "end": 969.16,
   "text": "שלמה פוסע בגטו."
  },
  {
   "start": 973.03,
   "end": 976.03,
   "text": "הוא פוסע וכולם, כל היהודים, מתרחקים ממנו בית ייעוב."
  },
  {
   "start": 977.05,
   "end": 978.55,
   "text": "הילדים מצביעים עליו מרחוק."
  },
  {
   "start": 982.14,
   "end": 985.4,
   "text": "כל הרחובות מתרוקנים כשהוא מגיע. כל מקום כשהוא מגיע מתרוקן."
  },
  {
   "start": 987.14,
   "end": 987.5,
   "text": "שלמה,"
  },
  {
   "start": 988.42,
   "end": 990.66,
   "text": "כמעט לא שם לב לזה, הוא מזועזע"
  },
  {
   "start": 991.68,
   "end": 992.44,
   "text": "ממראה עיניו,"
  },
  {
   "start": 993.2,
   "end": 993.92,
   "text": "מהסבל,"
  },
  {
   "start": 994.46,
   "end": 997.86,
   "text": "מהעוני, מהצער של אחיו היהודים, כמה הם סובלים."
  },
  {
   "start": 998.58,
   "end": 999.12,
   "text": "כואב הלב."
  },
  {
   "start": 1033.54,
   "end": 1034.38,
   "text": "שלמה מגיע לבית,"
  },
  {
   "start": 1035.4,
   "end": 1036.04,
   "text": "הבית הדל"
  },
  {
   "start": 1036.98,
   "end": 1038.14,
   "text": "של רבי אברהם, אחיו."
  },
  {
   "start": 1040.06,
   "end": 1041.54,
   "text": "רבי אברהם מקבל אותו בשמחה."
  },
  {
   "start": 1042.08,
   "end": 1044.78,
   "text": "שלמה, אחי, מה שלומך? הם מתחבקים."
  },
  {
   "start": 1045.98,
   "end": 1046.56,
   "text": "איך אתה מרגיש?"
  },
  {
   "start": 1047.8,
   "end": 1049.7,
   "text": "עיניו של רבי אברהם מאירות."
  },
  {
   "start": 1051.46,
   "end": 1051.82,
   "text": "לפתע,"
  },
  {
   "start": 1052.46,
   "end": 1054.28,
   "text": "בנו הקטן של רבי אברהם נכנס,"
  },
  {
   "start": 1055.54,
   "end": 1057.7,
   "text": "עומד ובתמימות שואל,"
  },
  {
   "start": 1058.32,
   "end": 1058.64,
   "text": "אבא,"
  },
  {
   "start": 1059.52,
   "end": 1062.08,
   "text": "אבא, למה כולם קוראים לדוד שלמה בוגד?"
  },
  {
   "start": 1063.2,
   "end": 1063.5,
   "text": "אבא,"
  },
  {
   "start": 1064.24,
   "end": 1066.32,
   "text": "מדוע כולם מתרחקים מדוד שלמה?"
  },
  {
   "start": 1072.48,
   "end": 1074.44,
   "text": "שני האחים החברו כמו סיד."
  },
  {
   "start": 1075.96,
   "end": 1076.9,
   "text": "לא יכול להיות,"
  },
  {
   "start": 1077.76,
   "end": 1078.88,
   "text": "לחש אברהם."
  },
  {
   "start": 1079.32,
   "end": 1080.76,
   "text": "לא יכול להיות."
  },
  {
   "start": 1082.48,
   "end": 1085.5,
   "text": "כשהוא מחכה ששלמה יכחיש."
  },
  {
   "start": 1087.1,
   "end": 1088.0,
   "text": "שלמה תגיד משהו."
  },
  {
   "start": 1089.66,
   "end": 1090.82,
   "text": "אבל שלמה שותק."
  },
  {
   "start": 1093.29,
   "end": 1094.01,
   "text": "שלמה שותק,"
  },
  {
   "start": 1095.19,
   "end": 1097.29,
   "text": "ורבי אברהם הבין."
  },
  {
   "start": 1099.5,
   "end": 1101.58,
   "text": "העיניים שלו מתכסות דמעות."
  },
  {
   "start": 1105.86,
   "end": 1107.1,
   "text": "הוא ניגש אל השולחן"
  },
  {
   "start": 1108.1,
   "end": 1110.46,
   "text": "ומרין סכין חדה כתער."
  },
  {
   "start": 1111.9,
   "end": 1113.06,
   "text": "שלמה כפה על מקומו."
  },
  {
   "start": 1113.86,
   "end": 1116.16,
   "text": "הוא ידע מה רבי אברהם מתכונן לעשות."
  },
  {
   "start": 1116.86,
   "end": 1119.58,
   "text": "הוא ידע מה אחיו הגדול והאהוב הולך לעשות."
  },
  {
   "start": 1120.78,
   "end": 1121.32,
   "text": "שלמה עמד קפוא."
  },
  {
   "start": 1122.22,
   "end": 1123.3,
   "text": "שלמה עמד מיוסר."
  },
  {
   "start": 1123.76,
   "end": 1124.0,
   "text": "אחי,"
  },
  {
   "start": 1124.98,
   "end": 1125.26,
   "text": "אחי,"
  },
  {
   "start": 1126.3,
   "end": 1127.14,
   "text": "זה רק למראית עין."
  },
  {
   "start": 1128.24,
   "end": 1130.1,
   "text": "ככה אני אוכל לעזור לכם מבפנים."
  },
  {
   "start": 1131.32,
   "end": 1133.64,
   "text": "ככה אני אוכל להיות המלאך ששומר עליכם."
  },
  {
   "start": 1136.21,
   "end": 1139.87,
   "text": "רבי אברהם מסתכל על אחיו שלמה בעיניים דומעות"
  },
  {
   "start": 1141.63,
   "end": 1142.41,
   "text": "ואומר לו,"
  },
  {
   "start": 1144.01,
   "end": 1144.37,
   "text": "שלמה,"
  },
  {
   "start": 1145.19,
   "end": 1147.17,
   "text": "קל למצוא תירוצים."
  },
  {
   "start": 1148.55,
   "end": 1149.67,
   "text": "קל למצוא תירוצים."
  },
  {
   "start": 1150.73,
   "end": 1152.07,
   "text": "אנחנו לא רוצים את הכסף שלך."
  },
  {
   "start": 1153.37,
   "end": 1154.49,
   "text": "הכסף שלך נקנה,"
  },
  {
   "start": 1155.87,
   "end": 1157.57,
   "text": "במחיר של הנשמה שלך."
  },
  {
   "start": 1158.47,
   "end": 1160.69,
   "text": "כסף כזה אנחנו לא רוצים."
  },
  {
   "start": 1162.21,
   "end": 1163.75,
   "text": "שלמה, אל תבוא לכאן יותר,"
  },
  {
   "start": 1164.59,
   "end": 1165.67,
   "text": "ואל תביא לי כסף."
  },
  {
   "start": 1168.64,
   "end": 1168.92,
   "text": "אחי,"
  },
  {
   "start": 1169.54,
   "end": 1172.32,
   "text": "רבי אברהם תיזהר מגספרי, הוא יילחם בך,"
  },
  {
   "start": 1172.84,
   "end": 1173.72,
   "text": "תיזהר ממנו."
  },
  {
   "start": 1175.28,
   "end": 1176.8,
   "text": "השם יתברך ישמור עלינו,"
  },
  {
   "start": 1177.64,
   "end": 1178.86,
   "text": "אני לא מפחד מגספרי,"
  },
  {
   "start": 1181.98,
   "end": 1183.46,
   "text": "והשיחה כאילו הסתיימה."
  },
  {
   "start": 1185.0,
   "end": 1188.68,
   "text": "רבי אברהם בתנועות איטיות הרים את הסכין החדה,"
  },
  {
   "start": 1189.46,
   "end": 1191.64,
   "text": "והוריד אותה בתנועה מהירה,"
  },
  {
   "start": 1192.3,
   "end": 1193.04,
   "text": "בתנועה חדה,"
  },
  {
   "start": 1193.86,
   "end": 1195.16,
   "text": "כשהוא עושה חתך בבגדו."
  },
  {
   "start": 1197.76,
   "end": 1198.62,
   "text": "רבי אברהם"
  },
  {
   "start": 1199.32,
   "end": 1201.58,
   "text": "קרע קריעה על אחיו."
  },
  {
   "start": 1203.56,
   "end": 1205.76,
   "text": "אחר כך ישב על הקרקע"
  },
  {
   "start": 1206.44,
   "end": 1207.64,
   "text": "כדרך האבלים,"
  },
  {
   "start": 1208.32,
   "end": 1210.08,
   "text": "וכיסה את פניו בידיו,"
  },
  {
   "start": 1210.68,
   "end": 1211.18,
   "text": "ובכה,"
  },
  {
   "start": 1211.96,
   "end": 1212.44,
   "text": "ובכה."
  },
  {
   "start": 1214.36,
   "end": 1215.0,
   "text": "ושלמה,"
  },
  {
   "start": 1216.72,
   "end": 1218.98,
   "text": "שלמה עזב את הבית בכתפיים שמוטות."
  },
  {
   "start": 1233.3,
   "end": 1241.2,
   "text": "אל רחובות הגטו היהודי הצטרף ומקבץ נדבות חדש הרב אברהם נחמני"
  },
  {
   "start": 1244.49,
   "end": 1247.21,
   "text": "ועד מהרה גם רחוב הקבצנים"
  },
  {
   "start": 1247.85,
   "end": 1248.53,
   "text": "התמלא באנרגיה,"
  },
  {
   "start": 1249.31,
   "end": 1250.07,
   "text": "התמלא בחיות,"
  },
  {
   "start": 1250.71,
   "end": 1252.47,
   "text": "התמלא באמונה,"
  },
  {
   "start": 1253.29,
   "end": 1253.79,
   "text": "באמונה,"
  },
  {
   "start": 1262.78,
   "end": 1270.38,
   "text": "רבי אברהם נחמני בחר לא להיכנע, להיות עם השם יתברך עד הסוף בכל מחיר,"
  },
  {
   "start": 1271.2,
   "end": 1272.52,
   "text": "בכל מחיר שלא יהיה"
  },
  {
   "start": 1273.14,
   "end": 1339.57,
   "text": "ועם השם יתברך, רחוב הקבצנים היהודי."
  },
  {
   "start": 1340.91,
   "end": 1341.67,
   "text": "שקט, שלו,"
  },
  {
   "start": 1344.85,
   "end": 1347.65,
   "text": "העיניים נשואות למעלה אל אבא שבשמיים."
  },
  {
   "start": 1349.65,
   "end": 1355.99,
   "text": "הפרש שהופיע לפתע ברחוב הקבצנים היהודי"
  },
  {
   "start": 1356.65,
   "end": 1357.53,
   "text": "לא היה נראה חשוד."
  },
  {
   "start": 1358.35,
   "end": 1359.63,
   "text": "מדי פעם היו נכנסים פרשים"
  },
  {
   "start": 1361.35,
   "end": 1361.95,
   "text": "אל הרחוב,"
  },
  {
   "start": 1367.82,
   "end": 1369.28,
   "text": "והוא דוהר לו בשלווה"
  },
  {
   "start": 1372.14,
   "end": 1372.7,
   "text": "ברחוב."
  },
  {
   "start": 1375.11,
   "end": 1381.03,
   "text": "אף אחד לא חשד בפרש שהיה מכוסה למעשה"
  },
  {
   "start": 1382.69,
   "end": 1384.59,
   "text": "במעין סודר שכיסה את פניו."
  },
  {
   "start": 1386.67,
   "end": 1388.05,
   "text": "יש פרשים שהיו נוהגים ככה,"
  },
  {
   "start": 1388.91,
   "end": 1389.83,
   "text": "יש לו להיכנס להם אבק,"
  },
  {
   "start": 1392.44,
   "end": 1400.64,
   "text": "והפרש התחיל להתקרב עם הסוס אל הקבצנים שישבו להם בפינה."
  },
  {
   "start": 1403.68,
   "end": 1406.54,
   "text": "בין הקבצנים ישב לו רבי אברהם נחמני."
  },
  {
   "start": 1410.35,
   "end": 1414.07,
   "text": "הפרש התקדם עוד מטר ועוד מטר."
  },
  {
   "start": 1417.15,
   "end": 1418.31,
   "text": "לפתע הוא סביב את הסוס,"
  },
  {
   "start": 1418.97,
   "end": 1419.33,
   "text": "כאילו,"
  },
  {
   "start": 1420.57,
   "end": 1421.95,
   "text": "כאילו רוצה לדהור,"
  },
  {
   "start": 1424.45,
   "end": 1426.11,
   "text": "אבל אז הוא נעץ תעקביו בסוס,"
  },
  {
   "start": 1430.57,
   "end": 1432.19,
   "text": "והסוס החל להשתולל,"
  },
  {
   "start": 1433.27,
   "end": 1433.67,
   "text": "ובועט,"
  },
  {
   "start": 1434.21,
   "end": 1434.59,
   "text": "ובועט,"
  },
  {
   "start": 1435.95,
   "end": 1438.91,
   "text": "ובועט ברבי אברהם נחמני."
  },
  {
   "start": 1442.18,
   "end": 1442.8,
   "text": "תוך שניות"
  },
  {
   "start": 1444.04,
   "end": 1445.26,
   "text": "דהר הפרש עלה."
  },
  {
   "start": 1447.78,
   "end": 1448.56,
   "text": "ומה שנראה,"
  },
  {
   "start": 1449.72,
   "end": 1450.62,
   "text": "כאילו כתאונה."
  },
  {
   "start": 1453.48,
   "end": 1454.16,
   "text": "הרב נחמני,"
  },
  {
   "start": 1455.18,
   "end": 1456.26,
   "text": "רבי אברהם נחמני,"
  },
  {
   "start": 1458.98,
   "end": 1460.38,
   "text": "ממנהיגי הגטו היהודי,"
  },
  {
   "start": 1461.18,
   "end": 1462.08,
   "text": "נותר שרוע,"
  },
  {
   "start": 1462.9,
   "end": 1463.34,
   "text": "זב דם,"
  },
  {
   "start": 1467.72,
   "end": 1469.24,
   "text": "פגיעה שנראית כאנושה בפניו."
  },
  {
   "start": 1477.05,
   "end": 1477.97,
   "text": "שבועות רבים,"
  },
  {
   "start": 1478.89,
   "end": 1479.89,
   "text": "רבי אברהם נחמני,"
  },
  {
   "start": 1480.57,
   "end": 1482.97,
   "text": "אחרי אותו מקרה היה מרחף בין חיים למוות."
  },
  {
   "start": 1484.03,
   "end": 1484.67,
   "text": "כל היהודים,"
  },
  {
   "start": 1486.35,
   "end": 1488.77,
   "text": "כל היהודים המתינו בחרדה."
  },
  {
   "start": 1490.35,
   "end": 1490.79,
   "text": "מה יהיה?"
  },
  {
   "start": 1491.85,
   "end": 1494.53,
   "text": "נשים צדקניות ישבו, קראו תהילים."
  },
  {
   "start": 1496.63,
   "end": 1497.29,
   "text": "לרפואתו,"
  },
  {
   "start": 1498.49,
   "end": 1499.21,
   "text": "לבסוף,"
  },
  {
   "start": 1500.65,
   "end": 1501.55,
   "text": "הוא נותר בחיים."
  },
  {
   "start": 1503.09,
   "end": 1503.63,
   "text": "אבל הנזק,"
  },
  {
   "start": 1505.03,
   "end": 1506.03,
   "text": "הנזק היה בלתי הפיך."
  },
  {
   "start": 1507.59,
   "end": 1509.95,
   "text": "פניו נמחצו בצורה חמורה."
  },
  {
   "start": 1513.5,
   "end": 1516.44,
   "text": "הוא איבד את רוב שיניו, השם ירחם,"
  },
  {
   "start": 1519.0,
   "end": 1520.2,
   "text": "וחמור מכל,"
  },
  {
   "start": 1521.28,
   "end": 1522.64,
   "text": "רבי אברהם נחמני איבד,"
  },
  {
   "start": 1526.08,
   "end": 1527.24,
   "text": "את מאור עיניו."
  },
  {
   "start": 1529.24,
   "end": 1530.92,
   "text": "הרב נחמני נותר עיוור."
  },
  {
   "start": 1532.84,
   "end": 1534.76,
   "text": "הוא יותר לא יוכל לראות את אור השמש,"
  },
  {
   "start": 1539.26,
   "end": 1543.33,
   "text": "ודמעות מילאו כל עין"
  },
  {
   "start": 1544.31,
   "end": 1545.35,
   "text": "יהודית בגטו."
  },
  {
   "start": 1547.89,
   "end": 1549.63,
   "text": "רבנו מורנו נותר עיוור."
  },
  {
   "start": 1552.08,
   "end": 1557.19,
   "text": "העיניים שכל כך הפליאו ללמוד,"
  },
  {
   "start": 1557.75,
   "end": 1560.11,
   "text": "שהפליאו לנסוך חום וביטחון באנשים,"
  },
  {
   "start": 1561.01,
   "end": 1564.63,
   "text": "כבר לא יראו יותר את אור השמש."
  },
  {
   "start": 1574.83,
   "end": 1575.75,
   "text": "הרב נחמני,"
  },
  {
   "start": 1577.07,
   "end": 1578.25,
   "text": "כשהוא התאושש לגמרי."
  },
  {
   "start": 1579.69,
   "end": 1581.87,
   "text": "אז הוא גילה את הביטחון המופלא שלו בשם."
  },
  {
   "start": 1582.69,
   "end": 1586.37,
   "text": "הוא חזר לרחוב לקבץ נדבות"
  },
  {
   "start": 1586.97,
   "end": 1588.83,
   "text": "כשהוא יושב ולומד בעל פה."
  },
  {
   "start": 1591.57,
   "end": 1593.57,
   "text": "בקהילה היו דואגים למלא את הקופה שלו."
  },
  {
   "start": 1594.73,
   "end": 1595.63,
   "text": "אבל הוא היה הבין את זה,"
  },
  {
   "start": 1596.05,
   "end": 1599.63,
   "text": "אז הוא לקח מעט לצורכו ומחלק את השאר לקהילה,"
  },
  {
   "start": 1600.17,
   "end": 1601.01,
   "text": "לקהילה הרעבה."
  },
  {
   "start": 1601.73,
   "end": 1602.63,
   "text": "הם פגעו בגופו,"
  },
  {
   "start": 1603.35,
   "end": 1604.75,
   "text": "אבל נשמתו טהורה."
  },
  {
   "start": 1605.07,
   "end": 1607.97,
   "text": "כולו כיסופים לשם יתברך ודאגה לאחיו."
  },
  {
   "start": 1608.65,
   "end": 1612.85,
   "text": "הוא הוכיח לכולם, הרב נחמני לא ראה דרך העיניים,"
  },
  {
   "start": 1613.33,
   "end": 1614.65,
   "text": "הוא ראה דרך הלב,"
  },
  {
   "start": 1615.09,
   "end": 1618.03,
   "text": "הוא ראה דרך הלב את מצוקת אחאב,"
  },
  {
   "start": 1618.81,
   "end": 1620.53,
   "text": "והיה משמש כמתווך,"
  },
  {
   "start": 1621.61,
   "end": 1622.91,
   "text": "מתווך חסר עיניים,"
  },
  {
   "start": 1623.41,
   "end": 1627.71,
   "text": "אבל מתווך בין הילדים לאבא שבשמיים."
  },
  {
   "start": 1637.06,
   "end": 1639.5,
   "text": "הוא ידע שלרגע הוא לא יעצור,"
  },
  {
   "start": 1640.24,
   "end": 1642.08,
   "text": "הוא לא יעצור והוא ינצח."
  }
 ]
