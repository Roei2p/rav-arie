{
 "disc": "8ח - חזק",
 "track": "Track05",
 "duration": 457.176,
 "segments": [
  {
   "start": 0.68,
   "end": 1.28,
   "text": "נער אחד"
  },
  {
   "start": 3.08,
   "end": 5.38,
   "text": "נסע לבקר בכפר,"
  },
  {
   "start": 6.72,
   "end": 8.16,
   "text": "נוסע וחושב לו,"
  },
  {
   "start": 9.14,
   "end": 10.04,
   "text": "עד שהוא מגיע לכפר."
  },
  {
   "start": 10.98,
   "end": 11.18,
   "text": "בכפר"
  },
  {
   "start": 12.62,
   "end": 13.6,
   "text": "הוא גר באיזה בית,"
  },
  {
   "start": 18.45,
   "end": 19.01,
   "text": "מסביב"
  },
  {
   "start": 20.77,
   "end": 23.33,
   "text": "הרבה חלונות, הוא עומד ומביט דרך החלון,"
  },
  {
   "start": 24.21,
   "end": 25.81,
   "text": "והנה הוא רואה אדם"
  },
  {
   "start": 28.19,
   "end": 30.97,
   "text": "הולך לו לכיוון חלקת"
  },
  {
   "start": 32.37,
   "end": 39.16,
   "text": "אדמה נאה ופשוט"
  },
  {
   "start": 40.46,
   "end": 40.96,
   "text": "הוא לוקח"
  },
  {
   "start": 42.38,
   "end": 44.88,
   "text": "איזה כלי והופך את כל האדמה."
  },
  {
   "start": 45.5,
   "end": 46.54,
   "text": "פשוט מקלקל אותה."
  },
  {
   "start": 47.42,
   "end": 48.0,
   "text": "סתם, ככה."
  },
  {
   "start": 50.51,
   "end": 52.95,
   "text": "הנער הזה מעולם לא ראה, לא חרישה,"
  },
  {
   "start": 53.59,
   "end": 56.87,
   "text": "לא עבודה חקלאית, לא עידור, כלום."
  },
  {
   "start": 58.23,
   "end": 59.01,
   "text": "אז מבחינתו,"
  },
  {
   "start": 59.97,
   "end": 61.53,
   "text": "האדם הזה מקלקל את האדמה."
  },
  {
   "start": 63.09,
   "end": 65.17,
   "text": "הוא רוצה לצאת, הוא רוצה לעצור אותו,"
  },
  {
   "start": 65.99,
   "end": 67.09,
   "text": "אבל הדלתות סגורות."
  },
  {
   "start": 67.61,
   "end": 69.09,
   "text": "הוא התחיל לצרוק, למה?"
  },
  {
   "start": 69.41,
   "end": 72.61,
   "text": "למה אתה משחית סתם חלקה כל כך יפה? למה?"
  },
  {
   "start": 73.61,
   "end": 75.37,
   "text": "אבל החלונות הסגורים בלעו,"
  },
  {
   "start": 77.01,
   "end": 79.43,
   "text": "בלעו את הצעקה שלו."
  },
  {
   "start": 89.66,
   "end": 90.14,
   "text": "למחרת,"
  },
  {
   "start": 90.92,
   "end": 91.68,
   "text": "למחרת שוב,"
  },
  {
   "start": 93.26,
   "end": 94.48,
   "text": "שוב הוא מביט בחלון,"
  },
  {
   "start": 95.22,
   "end": 95.62,
   "text": "והנה,"
  },
  {
   "start": 96.64,
   "end": 97.36,
   "text": "הנה האיש ההוא,"
  },
  {
   "start": 98.22,
   "end": 98.78,
   "text": "שוב הגיע."
  },
  {
   "start": 100.26,
   "end": 101.24,
   "text": "והנער מתבונן,"
  },
  {
   "start": 102.38,
   "end": 107.22,
   "text": "והפעם הוא רואה אותו מתוך איזה מיכל סגור ומוציא חופן של גרגירים,"
  },
  {
   "start": 107.66,
   "end": 108.96,
   "text": "וזורק אותם על האדמה."
  },
  {
   "start": 109.9,
   "end": 111.34,
   "text": "כאילו עשתה לו משהו, למה?"
  },
  {
   "start": 112.24,
   "end": 114.64,
   "text": "מה אתה רוצה מהאדמה הזאת? היא הייתה כל כך יפה."
  },
  {
   "start": 115.12,
   "end": 115.92,
   "text": "אתמול הפכת אותה,"
  },
  {
   "start": 116.4,
   "end": 118.64,
   "text": "עכשיו אתה זורק עליה כל מיני גרעינים, מה קורה פה?"
  },
  {
   "start": 119.16,
   "end": 122.34,
   "text": "הוא רוצה להצאת, הוא רוצה למחות, הוא רוצה להפגין."
  },
  {
   "start": 123.02,
   "end": 125.06,
   "text": "אבל הוא לא יכול, הוא נעול בחדר."
  },
  {
   "start": 126.74,
   "end": 128.04,
   "text": "וככה עוברת לה תקופה,"
  },
  {
   "start": 128.94,
   "end": 130.44,
   "text": "חלקת האדמה כוסתה"
  },
  {
   "start": 131.12,
   "end": 133.7,
   "text": "במרבד של ירק נפלא."
  },
  {
   "start": 135.44,
   "end": 136.6,
   "text": "עכשיו הנער"
  },
  {
   "start": 137.5,
   "end": 144.14,
   "text": "מביט דרך החלון ומשבח את בורא העולם שמנע ממנו לצאת ולהפריע לגנן הנפלא הזה,"
  },
  {
   "start": 144.7,
   "end": 149.6,
   "text": "להפוך חלקת אדמה חלקה לגן ירק נפלא."
  },
  {
   "start": 151.48,
   "end": 153.6,
   "text": "אבל זה עוד לא נגמר, עוברת לה עוד תקופה."
  },
  {
   "start": 154.06,
   "end": 157.6,
   "text": "בוקר אחד הנער שלנו מתעורר לשם הרעשים מוזרים."
  },
  {
   "start": 158.0,
   "end": 161.34,
   "text": "הוא רץ אל החלון ומבעד לחלון הוא רואה את הגנן"
  },
  {
   "start": 164.62,
   "end": 165.46,
   "text": "ללא חמלה,"
  },
  {
   "start": 166.06,
   "end": 166.84,
   "text": "באכזריות,"
  },
  {
   "start": 167.5,
   "end": 169.2,
   "text": "חותך את כל הצמחייה."
  },
  {
   "start": 169.76,
   "end": 170.52,
   "text": "הוא מנסה לצאת,"
  },
  {
   "start": 171.06,
   "end": 172.68,
   "text": "והכול סגור. הוא צועק,"
  },
  {
   "start": 173.1,
   "end": 174.1,
   "text": "ואף אחד לא שומע."
  },
  {
   "start": 174.46,
   "end": 179.36,
   "text": "הוא מנסה באיתותי מורס, לא מבינים, מירס, טירס,"
  },
  {
   "start": 179.8,
   "end": 180.36,
   "text": "כלום!"
  },
  {
   "start": 182.02,
   "end": 182.46,
   "text": "בסוף,"
  },
  {
   "start": 183.64,
   "end": 185.32,
   "text": "איכשהו הוא מצליח לפתוח את אחד הדלתות,"
  },
  {
   "start": 185.76,
   "end": 186.5,
   "text": "והוא רץ החוצה,"
  },
  {
   "start": 186.94,
   "end": 187.52,
   "text": "רץ, רץ,"
  },
  {
   "start": 188.36,
   "end": 190.36,
   "text": "ונעמד, נעמד מול הגנן,"
  },
  {
   "start": 190.74,
   "end": 194.24,
   "text": "והתחיל צועק עליו, תגיד לי מה אתה עושה? תגיד לי מה אתה מעולל? אתה לא מתבייש?"
  },
  {
   "start": 195.16,
   "end": 198.68,
   "text": "עד שסוף סוף גדל פה קצת, קצת ירק, קצת צבע,"
  },
  {
   "start": 198.76,
   "end": 201.14,
   "text": "אתה ככה באכזריות הולך וחותך את הכול."
  },
  {
   "start": 203.12,
   "end": 204.8,
   "text": "והגנן בנחת"
  },
  {
   "start": 205.42,
   "end": 212.52,
   "text": "יושב ובסבלנות מראה לנער התמים את כל התהליך של זריעת החיטה,"
  },
  {
   "start": 213.3,
   "end": 220.14,
   "text": "מהפיכת האדמה ועד יצירת הלחם."
  },
  {
   "start": 222.72,
   "end": 224.34,
   "text": "ואז הנער סוף-סוף הבין"
  },
  {
   "start": 225.82,
   "end": 229.68,
   "text": "שלא היה מקום לצעוק, לא היה מקום לשאול, לא היה מקום לכאוב."
  },
  {
   "start": 230.48,
   "end": 232.44,
   "text": "ככה זה בעולם שלנו."
  },
  {
   "start": 233.22,
   "end": 259.66,
   "text": "זה המשל שמביא הכף רננים זה המשל והנמשל הוא בעולם שלנו עלינו החיים שלנו אנחנו רואים בחיים שלנו תהליכים כל יהודי כל יהודי מקרים כואבים משברים שהם עוברים שאנחנו כולנו עוברים אם זה בזוגיות אם זה בלימודים פרנסה בריאות מה לא ונראה לנו שזה הרס נראה לנו שזה חורבן למה זה קורה לי"
  },
  {
   "start": 260.12,
   "end": 262.06,
   "text": "לא מבינים למה, למה זה ככה?"
  },
  {
   "start": 262.7,
   "end": 265.08,
   "text": "למה הקדוש ברוך הוא מקשה עלינו את החיים?"
  },
  {
   "start": 265.44,
   "end": 270.66,
   "text": "למה מקשה עלינו את התשובה? למה, למה שהתחלתי לחזור בתשובה להתקרב לשם כל הניסיונות?"
  },
  {
   "start": 271.14,
   "end": 272.52,
   "text": "למה כל כך קשה ללמוד?"
  },
  {
   "start": 273.12,
   "end": 274.5,
   "text": "למה כל כך קשה להתקדם?"
  },
  {
   "start": 277.34,
   "end": 278.18,
   "text": "זועקים"
  },
  {
   "start": 279.56,
   "end": 280.42,
   "text": "ללא קול."
  },
  {
   "start": 281.04,
   "end": 282.88,
   "text": "זועקים ללא מענה."
  },
  {
   "start": 283.52,
   "end": 286.94,
   "text": "אבל צריך לדעת שאנחנו כמו הנער הזה שלא רואה,"
  },
  {
   "start": 287.54,
   "end": 288.44,
   "text": "לא מבין,"
  },
  {
   "start": 288.86,
   "end": 290.82,
   "text": "שמה שנראה כאילו זה הרס,"
  },
  {
   "start": 291.14,
   "end": 295.08,
   "text": "כאילו זה קלקול, זה בנייה, זה תהליך של יצירה,"
  },
  {
   "start": 295.4,
   "end": 298.78,
   "text": "תהליך של עולם שלם שנבנה לטובתנו."
  },
  {
   "start": 299.14,
   "end": 303.08,
   "text": "ככה גם תהליך יצירת האדם השלם, האישה השלמה."
  },
  {
   "start": 303.44,
   "end": 309.6,
   "text": "לעיתים יש תהליכים שנראים אולי כואבים, נראים לא טובים, אבל לא, זה לא הרס, זה בנייה."
  },
  {
   "start": 310.32,
   "end": 311.22,
   "text": "זה בנייה."
  },
  {
   "start": 317.62,
   "end": 324.18,
   "text": "כשאתה רואה מקום שהולכים והורסים אותו עם טרקטור, תדע לך, מצד אחד נראה לך שאתה צריך להיות עצוב כי הורסים פה,"
  },
  {
   "start": 324.68,
   "end": 327.12,
   "text": "אבל מצד שני אתה צריך לחייך. למה?"
  },
  {
   "start": 327.8,
   "end": 331.28,
   "text": "כי במקום שמתחילים להרוס, סימן שרוצים לבנות,"
  },
  {
   "start": 331.94,
   "end": 333.98,
   "text": "לבנות משהו חדש יותר טוב."
  },
  {
   "start": 334.76,
   "end": 338.56,
   "text": "בנייה שלך, בנייה שלך, בנייה של כולנו."
  },
  {
   "start": 339.48,
   "end": 340.88,
   "text": "זה רק רק לטובתנו."
  },
  {
   "start": 343.9,
   "end": 345.22,
   "text": "כמו שצריך חרישה,"
  },
  {
   "start": 346.24,
   "end": 347.08,
   "text": "וזריעה,"
  },
  {
   "start": 347.98,
   "end": 350.46,
   "text": "וקצירה, ובסוף יוצאת החיטה,"
  },
  {
   "start": 350.84,
   "end": 352.32,
   "text": "ומהחיטה קמח,"
  },
  {
   "start": 352.8,
   "end": 354.76,
   "text": "ומהקמח לחם,"
  },
  {
   "start": 354.88,
   "end": 359.66,
   "text": "ואז אנחנו יכולים לאכול וחיים ובריאים ונושמים."
  },
  {
   "start": 360.32,
   "end": 364.92,
   "text": "ככה גם לנו ברוחניות יש ניסיונות ויש קשיים."
  },
  {
   "start": 365.86,
   "end": 366.4,
   "text": "אם זה בפרנסה,"
  },
  {
   "start": 366.9,
   "end": 367.52,
   "text": "אם זה בזוגיות,"
  },
  {
   "start": 368.04,
   "end": 368.7,
   "text": "אם זה בילדים,"
  },
  {
   "start": 369.16,
   "end": 369.88,
   "text": "אם זה בזיווג,"
  },
  {
   "start": 370.3,
   "end": 371.92,
   "text": "כל אחד והבעיות שלו."
  },
  {
   "start": 372.74,
   "end": 376.82,
   "text": "אבל כל זה זה בנייה כדי שאנחנו נצא בסוף שלמים,"
  },
  {
   "start": 377.24,
   "end": 382.88,
   "text": "מתוקנים, שנתקן את הכול, את כל הקומה השלמה שלנו."
  },
  {
   "start": 383.34,
   "end": 387.42,
   "text": "שנהיה מוכנים לקראת המשיח,"
  },
  {
   "start": 388.16,
   "end": 389.26,
   "text": "לקראת הגאולה,"
  },
  {
   "start": 393.47,
   "end": 395.43,
   "text": "לקראת עולם של ימות משיח,"
  },
  {
   "start": 395.75,
   "end": 400.75,
   "text": "לקראת עולם של תחיית המתים, עולם הבא, גן עדן, עולם הנשמות."
  },
  {
   "start": 401.41,
   "end": 402.99,
   "text": "ומה שאנחנו צריכים עכשיו זה להתחזק,"
  },
  {
   "start": 403.77,
   "end": 406.69,
   "text": "לקחת לעצמנו לשאוב כוחות."
  },
  {
   "start": 407.27,
   "end": 407.99,
   "text": "זה קשה,"
  },
  {
   "start": 408.59,
   "end": 411.01,
   "text": "אבל אנחנו חייבים לשאוב כוחות, להחזיק מעמד,"
  },
  {
   "start": 411.41,
   "end": 414.69,
   "text": "לשמוח, להכניס לעצמנו שמחה למרות הקשיים,"
  },
  {
   "start": 415.09,
   "end": 419.99,
   "text": "לעשות חיל, להתקרב לשם יתברך לו, לעזוב לרגע את השם יתברך,"
  },
  {
   "start": 420.53,
   "end": 421.99,
   "text": "את התורה הקדושה."
  },
  {
   "start": 422.35,
   "end": 424.71,
   "text": "צריך לדעת את זה. וגם כשקשה לנו,"
  },
  {
   "start": 425.11,
   "end": 432.83,
   "text": "גם כשלא הולך לנו, גם כשנראה הכל הכל הכל קשה, בין אם אתה שומר תורה ומצוות, בין אם לא, בין אם את שומר תורה ומצוות, בין אם לא."
  },
  {
   "start": 433.15,
   "end": 436.87,
   "text": "צריך לדעת להתפלל השם בורא עולם, בורא עולם, גל עיניי."
  },
  {
   "start": 437.29,
   "end": 440.55,
   "text": "תזיז לי את השחור שבעין, שאני אתחיל לראות,"
  },
  {
   "start": 440.95,
   "end": 443.79,
   "text": "לראות איך העולם הזה כולו כולו נוצר בשבילי."
  },
  {
   "start": 444.11,
   "end": 448.73,
   "text": "כי האמת, כל העולם, בורא עולם, יצר בשבילנו למען הבנייה שלנו,"
  },
  {
   "start": 449.13,
   "end": 449.99,
   "text": "לטובתנו."
  },
  {
   "start": 450.37,
   "end": 452.33,
   "text": "ואנחנו רק נשאר לנו להגיד, בורא עולם,"
  },
  {
   "start": 452.67,
   "end": 455.83,
   "text": "גל עיניי ואביט הנפלאות מתורתך."
  }
 ]
}