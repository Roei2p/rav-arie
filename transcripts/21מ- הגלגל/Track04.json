{
 "disc": "21מ- הגלגל",
 "track": "Track04",
 "duration": 809.184,
 "segments": [
  {
   "start": 7.63,
   "end": 11.39,
   "text": "היה הרי איר את פניו ליהודי, לאברך הצעיר,"
  },
  {
   "start": 12.83,
   "end": 15.45,
   "text": "שפסלו במשעול."
  },
  {
   "start": 16.31,
   "end": 17.05,
   "text": "אברך צעיר"
  },
  {
   "start": 18.55,
   "end": 19.81,
   "text": "שעושה את הדרך שלו"
  },
  {
   "start": 24.42,
   "end": 25.5,
   "text": "אל התורה הקדושה."
  },
  {
   "start": 27.5,
   "end": 28.88,
   "text": "אבל אז כדי להגיע מהבית"
  },
  {
   "start": 29.66,
   "end": 32.2,
   "text": "אל לימוד התורה הקדושה, אז צריך לעבור דרך"
  },
  {
   "start": 33.28,
   "end": 35.76,
   "text": "דרך חתחתים. ואם אתה עני ואין לך כסף,"
  },
  {
   "start": 36.54,
   "end": 39.92,
   "text": "אתה צריך להתחיל ללכת ברגל ולסמוך מדי פעם על הגלה פה, הגלה שם שתעצור,"
  },
  {
   "start": 40.58,
   "end": 42.74,
   "text": "שכמה יהודים טובים יעשו לך טובה ויעבירו אותך."
  },
  {
   "start": 43.26,
   "end": 46.04,
   "text": "אם שפר עליך מזלחה איזה ייקח שבוע, אם לא עשית יותר."
  },
  {
   "start": 47.14,
   "end": 48.24,
   "text": "ומה תאכל בדרך?"
  },
  {
   "start": 49.08,
   "end": 49.98,
   "text": "לחם יבש."
  },
  {
   "start": 51.36,
   "end": 51.88,
   "text": "אותו אברך,"
  },
  {
   "start": 52.32,
   "end": 54.98,
   "text": "אותו אברך עני, באמת היה לו באמתחתו כמה פירורי לחם."
  },
  {
   "start": 56.38,
   "end": 58.48,
   "text": "וכך הוא היה מסתובב לו בדרכים."
  },
  {
   "start": 59.98,
   "end": 61.46,
   "text": "והנה, בזמן שהוא פוסע ביער,"
  },
  {
   "start": 63.02,
   "end": 63.86,
   "text": "לפתע הוא ראה מולו"
  },
  {
   "start": 64.9,
   "end": 65.8,
   "text": "בטח שניא."
  },
  {
   "start": 68.81,
   "end": 70.03,
   "text": "בטח שניא מט ליפול."
  },
  {
   "start": 71.01,
   "end": 74.49,
   "text": "אבל המזוזה בלטה לה על משקוף הדלת,"
  },
  {
   "start": 75.17,
   "end": 75.91,
   "text": "והוא כל כך שמח."
  },
  {
   "start": 76.89,
   "end": 78.05,
   "text": "זה בטח שניא יהודי."
  },
  {
   "start": 78.69,
   "end": 80.25,
   "text": "אולי אפשר להיות שם בינתיים."
  },
  {
   "start": 80.77,
   "end": 81.83,
   "text": "אולי אפשר להתארח."
  },
  {
   "start": 82.47,
   "end": 83.37,
   "text": "הוא דפק בדלת,"
  },
  {
   "start": 84.79,
   "end": 85.57,
   "text": "נשמע קול."
  },
  {
   "start": 87.01,
   "end": 87.65,
   "text": "תיכנס."
  },
  {
   "start": 88.71,
   "end": 93.6,
   "text": "הוא לחץ על הידית ונכנס."
  },
  {
   "start": 96.85,
   "end": 99.25,
   "text": "אבל שנייה אחר כך"
  },
  {
   "start": 100.51,
   "end": 102.59,
   "text": "הוא כל כך הצטער שהוא נכנס."
  },
  {
   "start": 108.64,
   "end": 108.96,
   "text": "העוני"
  },
  {
   "start": 110.48,
   "end": 115.74,
   "text": "העוני זעק מכל קירות האכסניה."
  },
  {
   "start": 118.8,
   "end": 121.76,
   "text": "הוא רצה לסגת אחורה, אבל כבר לא היה ברירה, בעל הבית הגיע."
  },
  {
   "start": 122.72,
   "end": 123.16,
   "text": "יהודי,"
  },
  {
   "start": 124.02,
   "end": 124.62,
   "text": "חיוור,"
  },
  {
   "start": 125.44,
   "end": 127.3,
   "text": "אבל לא מבושה, חיוור מרעב."
  },
  {
   "start": 128.74,
   "end": 129.74,
   "text": "הוא אומר לו, בוא, בוא, כנס."
  },
  {
   "start": 130.64,
   "end": 131.9,
   "text": "בוא, אברך יקר, בוא, כנס."
  },
  {
   "start": 133.02,
   "end": 134.36,
   "text": "יש לך מה לאכול איתך?"
  },
  {
   "start": 135.04,
   "end": 137.02,
   "text": "והאברך אומר לו, כן, יש לי קצת לחם יבש."
  },
  {
   "start": 137.76,
   "end": 141.1,
   "text": "אוי, יופי, אז תוכל לדאוג לעצמך לאוכל ובינתיים להתארח אצלנו."
  },
  {
   "start": 141.66,
   "end": 143.98,
   "text": "אל תדאג, האחסניה כבר הרבה זמן לא פעילה."
  },
  {
   "start": 146.34,
   "end": 148.14,
   "text": "והאברך מצטנף לו בפינה,"
  },
  {
   "start": 150.96,
   "end": 153.28,
   "text": "קיבל חדר קטן ורעוע,"
  },
  {
   "start": 154.06,
   "end": 154.9,
   "text": "ויושב שמה,"
  },
  {
   "start": 156.18,
   "end": 157.9,
   "text": "כשהעוני זועק מכל הקירות,"
  },
  {
   "start": 158.52,
   "end": 161.6,
   "text": "והאחסנאי ובני משפחתו יושבים בצד השני."
  },
  {
   "start": 164.16,
   "end": 167.38,
   "text": "כך הוא למד קצת, ולפנות ערב הוא רצה לאכול, האברך."
  },
  {
   "start": 169.0,
   "end": 170.28,
   "text": "אבל אז שהוא בא להוציא את האוכל,"
  },
  {
   "start": 171.32,
   "end": 171.6,
   "text": "לפתע"
  },
  {
   "start": 172.42,
   "end": 173.26,
   "text": "הוא שמע בכי."
  },
  {
   "start": 174.7,
   "end": 176.06,
   "text": "הוא שמע בכי קורע הלב."
  },
  {
   "start": 178.4,
   "end": 178.84,
   "text": "הוא קם,"
  },
  {
   "start": 179.94,
   "end": 180.72,
   "text": "פתח את הדלת"
  },
  {
   "start": 181.7,
   "end": 183.12,
   "text": "ויצא לכיוון מקור הבכי,"
  },
  {
   "start": 186.23,
   "end": 187.85,
   "text": "והמראה שהוא ראהיה מזעזע."
  },
  {
   "start": 188.73,
   "end": 192.53,
   "text": "הוא ראה את בעל האכסניה עומד וסביבו עומדים הילדים שלו,"
  },
  {
   "start": 193.61,
   "end": 196.43,
   "text": "ובוכים ואומרים, אבא, כואב לי הבטן, אבא, אני רעב."
  },
  {
   "start": 197.15,
   "end": 200.41,
   "text": "אבא, תלענו, מה לאכול אין לנו, קשה לנו, אבא."
  },
  {
   "start": 202.09,
   "end": 204.41,
   "text": "אבא, כמה נחקה, אבא, אמרת לנו גם אתמול"
  },
  {
   "start": 206.19,
   "end": 209.51,
   "text": "שנמתין בסבלנות, אבא, אנחנו רעבים והילדים בוכים."
  },
  {
   "start": 209.65,
   "end": 214.29,
   "text": "והאברך בלי משים התחיל לבכות איתם."
  },
  {
   "start": 216.47,
   "end": 217.27,
   "text": "אבל מה הוא יכול לעשות?"
  },
  {
   "start": 218.57,
   "end": 219.19,
   "text": "הוא הסתובב,"
  },
  {
   "start": 219.97,
   "end": 220.49,
   "text": "לקח את"
  },
  {
   "start": 221.03,
   "end": 222.45,
   "text": "פירוי הלחם שהיו איתו,"
  },
  {
   "start": 223.15,
   "end": 225.07,
   "text": "בא לבעל האכסניה ונתן לו אותם."
  },
  {
   "start": 226.05,
   "end": 227.23,
   "text": "יותר מזה הוא לא יכול לתת,"
  },
  {
   "start": 229.79,
   "end": 230.71,
   "text": "זה קרע לו את הלב."
  },
  {
   "start": 232.03,
   "end": 232.83,
   "text": "הוא נשאר שם,"
  },
  {
   "start": 234.03,
   "end": 235.01,
   "text": "לפנות בוקר הוא קם,"
  },
  {
   "start": 236.13,
   "end": 237.47,
   "text": "התפלל ותיקין הנץ,"
  },
  {
   "start": 238.73,
   "end": 239.57,
   "text": "ויצא לדרך."
  },
  {
   "start": 240.49,
   "end": 241.09,
   "text": "לא היה לו מה להישאר."
  },
  {
   "start": 242.93,
   "end": 243.91,
   "text": "וכך הוא חזר אל היער,"
  },
  {
   "start": 244.89,
   "end": 246.03,
   "text": "וכך הוא הסתובב ביער,"
  },
  {
   "start": 246.71,
   "end": 248.05,
   "text": "ממשיך בדרכו אותו אברך,"
  },
  {
   "start": 258.58,
   "end": 259.28,
   "text": "התקרב לעברו."
  },
  {
   "start": 261.14,
   "end": 261.8,
   "text": "הוא הסתובב,"
  },
  {
   "start": 262.68,
   "end": 264.86,
   "text": "הספיק לראות מרכבה אדורה חולפת על פניו,"
  },
  {
   "start": 266.52,
   "end": 268.38,
   "text": "אבל אז המרכבה לפתע נעצרה."
  },
  {
   "start": 269.78,
   "end": 270.62,
   "text": "הדלת נפתחה,"
  },
  {
   "start": 271.66,
   "end": 273.66,
   "text": "והאברך הספיק לראות יהודי עשיר"
  },
  {
   "start": 274.38,
   "end": 275.9,
   "text": "יושב לו ואומר לו, בוא אברך, בוא,"
  },
  {
   "start": 276.5,
   "end": 277.04,
   "text": "בוא, כנס."
  },
  {
   "start": 278.14,
   "end": 279.1,
   "text": "בוא, אני אקח אותך הלאה."
  },
  {
   "start": 279.98,
   "end": 280.98,
   "text": "קצת חסד לא יזיק לי."
  },
  {
   "start": 282.94,
   "end": 285.78,
   "text": "האברך העיף מבט על העשיר היהודי ואמר לו"
  },
  {
   "start": 286.56,
   "end": 287.38,
   "text": "אני לא בא איתך."
  },
  {
   "start": 289.46,
   "end": 290.72,
   "text": "אני לא מוכן לנסוע איתך."
  },
  {
   "start": 292.16,
   "end": 293.28,
   "text": "והיהודי היה בהלם."
  },
  {
   "start": 294.38,
   "end": 296.94,
   "text": "מה אתה לא מוכן לנסוע איתי? למה יש לך הרבה ברירות?"
  },
  {
   "start": 297.38,
   "end": 298.76,
   "text": "אני עושה לך טובה, על מה אתה מדבר?"
  },
  {
   "start": 299.74,
   "end": 300.44,
   "text": "בוא תעלה."
  },
  {
   "start": 301.72,
   "end": 304.78,
   "text": "והאברך הצעיר מסתכל עליו ואומר לו תראה,"
  },
  {
   "start": 305.64,
   "end": 306.26,
   "text": "תראה יהודי."
  },
  {
   "start": 307.08,
   "end": 310.16,
   "text": "אם אתה רוצה שאני אעלה למרכבה שלך יש לי תנאי בשבילך."
  },
  {
   "start": 311.02,
   "end": 313.04,
   "text": "אם תקיים את התנאי, אני אעלה."
  },
  {
   "start": 314.24,
   "end": 315.22,
   "text": "מאיפה החוצפה הזאת?"
  },
  {
   "start": 315.84,
   "end": 316.78,
   "text": "אני עושה לך טובה."
  },
  {
   "start": 317.32,
   "end": 319.3,
   "text": "עוצר לך טרמפ ואתה עושה לי תנאים."
  },
  {
   "start": 320.66,
   "end": 321.36,
   "text": "אבל היה משהו"
  },
  {
   "start": 322.1,
   "end": 326.3,
   "text": "באבת הפנים, בדימה של הדברים של אותו אברך שגרם לעשיר,"
  },
  {
   "start": 326.94,
   "end": 328.54,
   "text": "להגיד לו, כן, מה, מה התנאי?"
  },
  {
   "start": 329.92,
   "end": 331.2,
   "text": "אמר לו האברך העני, תראה,"
  },
  {
   "start": 332.22,
   "end": 333.06,
   "text": "אני עזבתי עכשיו."
  },
  {
   "start": 334.0,
   "end": 335.24,
   "text": "בית אכסניה פה יהודי."
  },
  {
   "start": 336.3,
   "end": 337.46,
   "text": "יש שם משפחה יהודייה,"
  },
  {
   "start": 338.18,
   "end": 339.28,
   "text": "אין להם מה לאכול."
  },
  {
   "start": 340.08,
   "end": 342.2,
   "text": "הילדים רעבים ללחם."
  },
  {
   "start": 343.06,
   "end": 346.26,
   "text": "אני בטוח שיש לך איזה קצת אוכל מזונות לפחות"
  },
  {
   "start": 347.1,
   "end": 347.68,
   "text": "במרכבה איתך."
  },
  {
   "start": 349.0,
   "end": 351.92,
   "text": "אם אתה מוכן להסתובב איתי ולחזור חזרה לשם,"
  },
  {
   "start": 352.38,
   "end": 354.26,
   "text": "ולתת להם את מה שיש לך במרכבה,"
  },
  {
   "start": 355.26,
   "end": 358.18,
   "text": "ואולי לתת להם קצת צדקה שיהיה לו אפשרות לסדר את עצמו,"
  },
  {
   "start": 358.5,
   "end": 360.12,
   "text": "לספק אוכל לילדים שלו,"
  },
  {
   "start": 360.76,
   "end": 362.48,
   "text": "אני עולה על המרכבה."
  },
  {
   "start": 363.32,
   "end": 365.0,
   "text": "אבל אם לא, אני לא מוכן לנסוע איתך."
  },
  {
   "start": 367.69,
   "end": 368.39,
   "text": "היהודי מסתכל עליו,"
  },
  {
   "start": 368.55,
   "end": 371.39,
   "text": "חושב מה לעשות."
  },
  {
   "start": 372.37,
   "end": 375.53,
   "text": "ואז אותו אברך המשיך ואמר לו, תדע לך, יהודי,"
  },
  {
   "start": 377.13,
   "end": 380.05,
   "text": "אומר הפסוק בתורה ספר דברים, פרק ט״ו,"
  },
  {
   "start": 380.77,
   "end": 384.77,
   "text": "נתון תיתן לו ולא ירה לבבך בתיתך לו,"
  },
  {
   "start": 385.35,
   "end": 388.71,
   "text": "כי בגלל הדבר הזה יברך השם אלוקיך."
  },
  {
   "start": 389.49,
   "end": 390.71,
   "text": "יהודי, אל תהסס."
  },
  {
   "start": 391.41,
   "end": 395.63,
   "text": "נתון תיתן ועל ירה לבבך בתיתך לו,"
  },
  {
   "start": 396.13,
   "end": 400.61,
   "text": "כי בגלל הדבר הזה יבחיך השם אלוקיך."
  },
  {
   "start": 401.23,
   "end": 402.39,
   "text": "ואומרת הגמרא,"
  },
  {
   "start": 403.13,
   "end": 403.87,
   "text": "מסכת שבת,"
  },
  {
   "start": 404.43,
   "end": 405.39,
   "text": "דף קנא,"
  },
  {
   "start": 406.13,
   "end": 408.05,
   "text": "כי בגלל הדבר הזה,"
  },
  {
   "start": 408.77,
   "end": 410.57,
   "text": "תנא דבר רבי ישמעאל,"
  },
  {
   "start": 411.21,
   "end": 413.57,
   "text": "גלגל הוא שחוזר בעולם."
  },
  {
   "start": 416.08,
   "end": 418.1,
   "text": "גלגל הוא שחוזר בעולם,"
  },
  {
   "start": 418.46,
   "end": 422.02,
   "text": "כי בגלל הדבר הזה יבחיך השם אלוקיך."
  },
  {
   "start": 422.6,
   "end": 423.44,
   "text": "אל תהסס יהודי."
  },
  {
   "start": 426.1,
   "end": 427.18,
   "text": "אשר יהודי סימן,"
  },
  {
   "start": 429.25,
   "end": 431.25,
   "text": "ועד מרה הם עשו את דרכם אל האכסניה,"
  },
  {
   "start": 432.07,
   "end": 433.31,
   "text": "מגיעים לבית האכסניה."
  },
  {
   "start": 442.55,
   "end": 445.87,
   "text": "לא יכול לתאר לכם במילים את השמחה של בעל האכסניה,"
  },
  {
   "start": 446.67,
   "end": 448.67,
   "text": "את האושר שנשקף מהילדים."
  },
  {
   "start": 450.8,
   "end": 451.76,
   "text": "כשאותו עשיר"
  },
  {
   "start": 452.48,
   "end": 453.22,
   "text": "הוציא מזונות,"
  },
  {
   "start": 453.76,
   "end": 454.48,
   "text": "הוציאו גיוצת,"
  },
  {
   "start": 456.0,
   "end": 456.46,
   "text": "הוציאו להם דובשניות."
  },
  {
   "start": 459.34,
   "end": 461.06,
   "text": "אותם ילדים כל כך שמחו."
  },
  {
   "start": 462.24,
   "end": 464.64,
   "text": "פשוט התחילו לבכות עברה מאושר,"
  },
  {
   "start": 467.2,
   "end": 468.2,
   "text": "ובעל האכסניה"
  },
  {
   "start": 470.28,
   "end": 471.54,
   "text": "היה נרגש הדמעות."
  },
  {
   "start": 472.74,
   "end": 479.1,
   "text": "אחרי זה העשיר הוציא סכום הגון של צדקה ואמר לו כך תתחיל לסדר את עצמך."
  },
  {
   "start": 479.58,
   "end": 482.84,
   "text": "כך שיהיה לך התחלה חדשה, תצא מפה, תעבור למקום אחר."
  },
  {
   "start": 488.19,
   "end": 489.37,
   "text": "שנים רבות אחר כך"
  },
  {
   "start": 490.63,
   "end": 491.45,
   "text": "בעיר קוסוב"
  },
  {
   "start": 492.31,
   "end": 495.45,
   "text": "יושב הצדיק הקדוש,"
  },
  {
   "start": 496.57,
   "end": 498.79,
   "text": "איש אלוקים קדוש מורם מעם,"
  },
  {
   "start": 499.19,
   "end": 501.51,
   "text": "רבי מנחם מנדל מקוסוב,"
  },
  {
   "start": 502.05,
   "end": 504.11,
   "text": "זכר צדיק וקדוש לברכה."
  },
  {
   "start": 504.77,
   "end": 507.51,
   "text": "יושב על כיסא האדמעות בקוסוב,"
  },
  {
   "start": 509.95,
   "end": 511.47,
   "text": "ומולו יש תור שלה."
  },
  {
   "start": 512.49,
   "end": 514.79,
   "text": "אנשים שמחכים לישועה, לברכה."
  },
  {
   "start": 519.36,
   "end": 521.8,
   "text": "הרב הקדוש רבי מנחם מנדל מקוסוב,"
  },
  {
   "start": 522.26,
   "end": 525.26,
   "text": "מאחווה בידו הטהורה אל הראשון בתור,"
  },
  {
   "start": 526.16,
   "end": 526.82,
   "text": "יהודי עני,"
  },
  {
   "start": 527.7,
   "end": 529.72,
   "text": "שאיכשהו מגיע אלי רבי, הרבי הקדוש,"
  },
  {
   "start": 530.3,
   "end": 531.54,
   "text": "מתחיל לבכות, אומר לו רבה,"
  },
  {
   "start": 532.38,
   "end": 534.18,
   "text": "רבה, המצב שלי כל כך קשה,"
  },
  {
   "start": 534.8,
   "end": 536.74,
   "text": "רבה, אין לי כסף לחתן את הילדות שלי,"
  },
  {
   "start": 537.5,
   "end": 541.24,
   "text": "תרבה, אני לא יודע מה לעשות, אני, כי לאחר ייאוש אשתי כבר הייתה."
  },
  {
   "start": 543.1,
   "end": 546.7,
   "text": "כבר אין לי אישה כמעט בבית. איזה עצבות, איזה חושך, איזה קשיים."
  },
  {
   "start": 547.94,
   "end": 549.98,
   "text": "כמה עוני בן אדם יכול לסבול."
  },
  {
   "start": 550.62,
   "end": 552.14,
   "text": "הוא מתפורץ בבכי מר."
  },
  {
   "start": 554.67,
   "end": 558.43,
   "text": "ורבי מנחם מדל מיקוסר, מיקוסוב, אוהב ישראל,"
  },
  {
   "start": 559.45,
   "end": 561.39,
   "text": "מביט ברחמים בעני,"
  },
  {
   "start": 562.05,
   "end": 563.21,
   "text": "ואומר לו תמתין כאן."
  },
  {
   "start": 564.19,
   "end": 566.83,
   "text": "ואז הוא מסמן באצבעו הקדושה."
  },
  {
   "start": 566.83,
   "end": 570.37,
   "text": "אל זה שעמד אחריה, אני אומר לו, בוא אתה, אתה בוא."
  },
  {
   "start": 571.21,
   "end": 574.67,
   "text": "ואותו יהודי שנראה עשיר מאוד מתקרב, אומר לו, בוא,"
  },
  {
   "start": 575.77,
   "end": 576.79,
   "text": "אתה רואה את העני הזה?"
  },
  {
   "start": 578.05,
   "end": 578.55,
   "text": "תן לו צדקה."
  },
  {
   "start": 583.13,
   "end": 584.21,
   "text": "הוא בא לתת לו צדקה,"
  },
  {
   "start": 584.93,
   "end": 587.83,
   "text": "ורבי מנחם מנדל מקוסו והוא אמר לו, תשאל אותו איך קוראים לו."
  },
  {
   "start": 588.89,
   "end": 589.75,
   "text": "ואז העני אומר,"
  },
  {
   "start": 590.37,
   "end": 592.25,
   "text": "קוראים לי כך וכך, אומר את השם."
  },
  {
   "start": 593.67,
   "end": 595.39,
   "text": "והעיניים של העשיר נפתחות."
  },
  {
   "start": 597.09,
   "end": 597.65,
   "text": "חכה רגע,"
  },
  {
   "start": 598.45,
   "end": 599.65,
   "text": "בוא אני ארשום לך כאן."
  },
  {
   "start": 600.35,
   "end": 601.45,
   "text": "מאתיים אלף רובל,"
  },
  {
   "start": 602.35,
   "end": 602.67,
   "text": "סכום עתק."
  },
  {
   "start": 603.99,
   "end": 610.35,
   "text": "קח את זה ואני לא מבין כל כך הרבה כסף,"
  },
  {
   "start": 611.17,
   "end": 612.65,
   "text": "איך אתה הופך אותי לעשיר?"
  },
  {
   "start": 613.51,
   "end": 618.15,
   "text": "מאתיים אלף רובל מי שמע על סכום כל כך אדיר?"
  },
  {
   "start": 620.63,
   "end": 622.87,
   "text": "והעשיר מסתכל על העני ואומר לו, קח,"
  },
  {
   "start": 623.65,
   "end": 628.85,
   "text": "כי משלך אתה נוטה לי."
  },
  {
   "start": 629.23,
   "end": 630.85,
   "text": "תראה, אתה אולי לא זוכר אותי,"
  },
  {
   "start": 631.67,
   "end": 633.73,
   "text": "אבל נכון שפעם היית עשיר,"
  },
  {
   "start": 634.37,
   "end": 655.05,
   "text": "נכון שפעם באת עם איזה אברך לפני שנים שם ביער אל בית אכסניה וראית שם משפחה של בעל האכסניה ענייה ונתת להם מזונות ונתת לילדים דובשניות ונתת לבעל האכסניה עני כסף"
  },
  {
   "start": 656.23,
   "end": 657.79,
   "text": "והוא רשם את השם שלך"
  },
  {
   "start": 658.95,
   "end": 660.81,
   "text": "אני זה בעל האכסניה"
  },
  {
   "start": 661.71,
   "end": 663.13,
   "text": "אני נהייתי עשיר"
  },
  {
   "start": 664.01,
   "end": 666.45,
   "text": "שפר עליי מזלי,"
  },
  {
   "start": 667.23,
   "end": 668.75,
   "text": "התהפך עליי הגורל,"
  },
  {
   "start": 670.13,
   "end": 671.49,
   "text": "ואני נהייתי עשיר."
  },
  {
   "start": 672.97,
   "end": 676.11,
   "text": "אתה הוא זה שעזרת לי, יש לך חלק בעשירות שלי,"
  },
  {
   "start": 676.77,
   "end": 678.41,
   "text": "קח כי משלך אתה נוטל."
  },
  {
   "start": 680.67,
   "end": 682.37,
   "text": "והעני לקח בדמעות ואמר תודה."
  },
  {
   "start": 684.35,
   "end": 684.95,
   "text": "אבל אז,"
  },
  {
   "start": 685.93,
   "end": 687.67,
   "text": "אבל אז פנה העשיר,"
  },
  {
   "start": 688.53,
   "end": 689.47,
   "text": "לפני כל הנוכחים,"
  },
  {
   "start": 690.17,
   "end": 692.47,
   "text": "אל הרב הקדוש רבי מנחם מנדל מיקוסוף,"
  },
  {
   "start": 693.29,
   "end": 694.75,
   "text": "ואמר לו כבוד הרב"
  },
  {
   "start": 705.76,
   "end": 707.38,
   "text": "אמר העשיר כבוד הרב"
  },
  {
   "start": 708.9,
   "end": 712.76,
   "text": "ואני זוכר גם מי זה היה האברך"
  },
  {
   "start": 713.98,
   "end": 715.8,
   "text": "מי היה אותו אברך צעיר"
  },
  {
   "start": 716.52,
   "end": 719.58,
   "text": "כבוד הרב היה אותו אברך צעיר"
  },
  {
   "start": 721.0,
   "end": 721.86,
   "text": "כבוד הרב"
  },
  {
   "start": 722.5,
   "end": 727.6,
   "text": "הרב הקדוש רבי מנחם מנדל מיקוסוב כבודו היה אותו צעיר"
  },
  {
   "start": 730.58,
   "end": 735.14,
   "text": "חייך רבי מנחם מנדל מיקוסוב אמר רבי מנחם מנדל מיקוסוב לעני"
  },
  {
   "start": 735.74,
   "end": 737.96,
   "text": "אתה זוכר שהיית עשיר? מה אני אמרתי לך?"
  },
  {
   "start": 738.58,
   "end": 746.82,
   "text": "נתון תיתן לו ולא ירע לבבך בתיתך לו, כי בגלל הדבר הזה יברך השם אלוקיך."
  },
  {
   "start": 748.04,
   "end": 752.64,
   "text": "אומרת הגמרא מסכת שבת תקנא כי בגלל הדבר הזה,"
  },
  {
   "start": 753.1,
   "end": 755.08,
   "text": "תנא דבר רבי ישמעאל,"
  },
  {
   "start": 756.22,
   "end": 758.56,
   "text": "אל תקרה כי בגלל הדבר הזה,"
  },
  {
   "start": 759.38,
   "end": 762.92,
   "text": "אלא בגלגל גלגל הוא שחוזר בעולם."
  },
  {
   "start": 762.92,
   "end": 765.82,
   "text": "פעם אתה למטה,"
  },
  {
   "start": 766.5,
   "end": 767.82,
   "text": "אחרי זה אתה עולה למעלה."
  },
  {
   "start": 769.74,
   "end": 772.8,
   "text": "כי בגלל הדבר הזה יברך השם אלוקיך."
  },
  {
   "start": 773.74,
   "end": 775.94,
   "text": "גלגל הוא שחוזר בעולם,"
  },
  {
   "start": 776.62,
   "end": 778.68,
   "text": "כאשר אדם למטה נמצא."
  },
  {
   "start": 779.18,
   "end": 783.92,
   "text": "צריך לדעת גלגל הוא שחוזר בעולם, עוד יגיע הזמן שהוא יעלה למעלה למעלה."
  },
  {
   "start": 785.02,
   "end": 785.86,
   "text": "רק סבלנות."
  },
  {
   "start": 786.66,
   "end": 788.68,
   "text": "ככה כל עם ישראל צריכים לדעת."
  },
  {
   "start": 789.86,
   "end": 792.66,
   "text": "כמה שקשה לנו ואנחנו מרגישים למטה בתחתית,"
  },
  {
   "start": 792.8,
   "end": 794.46,
   "text": "כי אנחנו רוצים את השם."
  },
  {
   "start": 795.04,
   "end": 796.98,
   "text": "גלגל הוא שחוזר בעולם,"
  },
  {
   "start": 797.36,
   "end": 800.68,
   "text": "ועוד מעט עומד לעלות קרננו, רק סבלנות."
  },
  {
   "start": 801.6,
   "end": 803.44,
   "text": "ואנחנו כאן צריכים עכשיו להתחזק."
  },
  {
   "start": 804.02,
   "end": 807.1,
   "text": "כאן עכשיו בחושך הזה צריך להתעורר, צריך להאיר."
  }
 ]
}