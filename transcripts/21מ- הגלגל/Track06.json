{
 "disc": "21מ- הגלגל",
 "track": "Track06",
 "duration": 1157.184,
 "segments": [
  {
   "start": 2.05,
   "end": 2.69,
   "text": "הגאון מווילנה."
  },
  {
   "start": 4.09,
   "end": 4.71,
   "text": "הגאון מווילנה"
  },
  {
   "start": 7.87,
   "end": 11.87,
   "text": "היה במסע של נדודים ברחבי אירופה והוא הגיע לאמסטרדם."
  },
  {
   "start": 12.41,
   "end": 14.87,
   "text": "הוא נתקל שם, התארח באיזה בית של יהודי,"
  },
  {
   "start": 16.13,
   "end": 22.55,
   "text": "והוא ראה שם איך היהודי הזה מכבד ומוקיר את רעייתו."
  },
  {
   "start": 23.11,
   "end": 29.69,
   "text": "הוא לא ראה מעולם התנהגות כזו. זה היה מעל ומעבר למה שאפשר לדמיין."
  },
  {
   "start": 30.89,
   "end": 31.63,
   "text": "אז הוא לא יכל להתאפק."
  },
  {
   "start": 31.75,
   "end": 33.93,
   "text": "הגאון מבינה פנה אל אותו אדם ואמר לו, תגיד לי,"
  },
  {
   "start": 34.95,
   "end": 41.33,
   "text": "מאיפה הכוחות, איך רכשת את היכולת המופלאה הזאת להעניק ולהעניק ולהעניק לאשתך?"
  },
  {
   "start": 45.9,
   "end": 47.1,
   "text": "ואז אותו אדם"
  },
  {
   "start": 47.82,
   "end": 48.4,
   "text": "החל לספר."
  },
  {
   "start": 50.2,
   "end": 51.38,
   "text": "אמר לו, אתה יודע, כבוד הרב,"
  },
  {
   "start": 52.98,
   "end": 55.14,
   "text": "כשאני הייתי צעיר, צעיר לימים עדיין,"
  },
  {
   "start": 56.54,
   "end": 57.36,
   "text": "הייתי עילוי."
  },
  {
   "start": 58.58,
   "end": 60.26,
   "text": "בישיבה הייתי מספר אחד."
  },
  {
   "start": 61.96,
   "end": 63.94,
   "text": "הייתי בחור מאוד מאוד נאה,"
  },
  {
   "start": 64.62,
   "end": 65.98,
   "text": "וגם מאוד מאוד מוכשר."
  },
  {
   "start": 68.9,
   "end": 71.94,
   "text": "והיה ברור שאני אשתדח עם אישה שהיא עשירה,"
  },
  {
   "start": 72.6,
   "end": 73.7,
   "text": "נאה ומצליחה."
  },
  {
   "start": 77.15,
   "end": 79.69,
   "text": "וזה לא היה רחוק מהמציאות,"
  },
  {
   "start": 82.98,
   "end": 84.32,
   "text": "אלא באמת זה היה כך."
  },
  {
   "start": 85.68,
   "end": 86.4,
   "text": "השתדחתי"
  },
  {
   "start": 87.32,
   "end": 89.92,
   "text": "עם נערה עשירה,"
  },
  {
   "start": 91.32,
   "end": 93.3,
   "text": "נאה ומצליחה."
  },
  {
   "start": 94.8,
   "end": 95.26,
   "text": "אידיליה."
  },
  {
   "start": 96.14,
   "end": 100.08,
   "text": "החותן שלי אמר, אל תדאג, אני אממן אותך, אתה תלמד אצלי, אל תדאג."
  },
  {
   "start": 100.7,
   "end": 103.74,
   "text": "אוכל לא יאסר, שום דבר לא יאסר בבית, אני אדאג לכל."
  },
  {
   "start": 104.68,
   "end": 105.44,
   "text": "ואני הייתי רגוע."
  },
  {
   "start": 113.14,
   "end": 114.06,
   "text": "חצי שנה אחר כך,"
  },
  {
   "start": 114.86,
   "end": 115.64,
   "text": "חצי שנה אחר כך,"
  },
  {
   "start": 116.16,
   "end": 117.0,
   "text": "נסעתי עם אבא"
  },
  {
   "start": 118.4,
   "end": 123.46,
   "text": "לסדר את הפרטים האחרונים, לסגור את הפרטים האחרונים לקראת המועד חתונה שכבר התחיל להתקרב ממש."
  },
  {
   "start": 126.72,
   "end": 129.96,
   "text": "ואני מגיע לעיר של הכלה,"
  },
  {
   "start": 131.56,
   "end": 133.24,
   "text": "שואל על הכתובת שהם גרים,"
  },
  {
   "start": 134.32,
   "end": 135.02,
   "text": "מסמנים לי,"
  },
  {
   "start": 135.64,
   "end": 137.14,
   "text": "ואז אני רואה, מגיע לאיזה"
  },
  {
   "start": 137.9,
   "end": 140.18,
   "text": "פינת העיר, בית גדול, אדיר."
  },
  {
   "start": 141.12,
   "end": 143.46,
   "text": "איזה עושר נוצץ מכל פינה, דופק בדלת."
  },
  {
   "start": 145.18,
   "end": 149.4,
   "text": "ואני שואל, אני משלום הגעתי ל... אומרים לי, כן, אבל זה היה הבית שלהם."
  },
  {
   "start": 150.6,
   "end": 152.08,
   "text": "היום זה כבר לא הבית שלהם."
  },
  {
   "start": 152.74,
   "end": 153.54,
   "text": "הם גרים שם."
  },
  {
   "start": 155.76,
   "end": 159.32,
   "text": "והעיניים שלי מלוות את האצבע המורה לי את כיוון מגוריהם."
  },
  {
   "start": 162.74,
   "end": 164.38,
   "text": "ואני רואה צריף דל"
  },
  {
   "start": 166.68,
   "end": 167.66,
   "text": "נוטה ליפול."
  },
  {
   "start": 170.09,
   "end": 172.59,
   "text": "התחלתי להתקרב, אני ואבא שלי, בצדדים מהוססים"
  },
  {
   "start": 173.23,
   "end": 174.05,
   "text": "אל עבר הצריף,"
  },
  {
   "start": 176.96,
   "end": 177.66,
   "text": "שם בצריף."
  },
  {
   "start": 179.16,
   "end": 179.88,
   "text": "שם בצריף,"
  },
  {
   "start": 180.48,
   "end": 181.08,
   "text": "בחצר"
  },
  {
   "start": 182.1,
   "end": 182.82,
   "text": "עלובה"
  },
  {
   "start": 184.14,
   "end": 184.6,
   "text": "ראיתי אותם."
  },
  {
   "start": 186.58,
   "end": 189.14,
   "text": "את הכלה שלי לעתיד ואת אבא שלה."
  },
  {
   "start": 192.59,
   "end": 196.77,
   "text": "מה שהתברר זה שהוא התרושש, האבא, מכל הכספים שלו."
  },
  {
   "start": 198.03,
   "end": 199.27,
   "text": "איבד את כל הרכוש שלו."
  },
  {
   "start": 202.92,
   "end": 205.82,
   "text": "ואותה כלה שהייתה צריכה להיות עשירה,"
  },
  {
   "start": 206.4,
   "end": 210.1,
   "text": "הפכה לענייה עם גדים בלויים."
  },
  {
   "start": 211.8,
   "end": 214.78,
   "text": "הם פשוט התביישו, התביישו לפנות אלינו."
  },
  {
   "start": 215.54,
   "end": 216.8,
   "text": "התביישו לספר לנו"
  },
  {
   "start": 218.06,
   "end": 219.84,
   "text": "על גודל האסון שפקד אותם."
  },
  {
   "start": 221.0,
   "end": 222.88,
   "text": "אבא שלי הסתכל, אמר לי, מה אתה אומר, בני?"
  },
  {
   "start": 223.88,
   "end": 224.76,
   "text": "אני אמרתי, אין ברירה,"
  },
  {
   "start": 225.34,
   "end": 229.63,
   "text": "אני חייב ללמוד ואני רוצה להצליח."
  },
  {
   "start": 230.77,
   "end": 234.27,
   "text": "אני מצטער, אני צריכה להודיע על ביטול השידוך."
  },
  {
   "start": 237.06,
   "end": 239.64,
   "text": "היא שמעה את זה, היה לה קשה לספוג את זה."
  },
  {
   "start": 240.06,
   "end": 240.28,
   "text": "פשוט"
  },
  {
   "start": 241.0,
   "end": 242.54,
   "text": "ברחה פנימה, נכנסה הביתה,"
  },
  {
   "start": 243.54,
   "end": 244.8,
   "text": "ורק מרחוק שמעתי"
  },
  {
   "start": 245.7,
   "end": 246.84,
   "text": "יבבות קטועות"
  },
  {
   "start": 248.66,
   "end": 252.84,
   "text": "שכנראה פרצו מליבה השבור."
  },
  {
   "start": 256.54,
   "end": 257.94,
   "text": "חזרנו הביתה, אני ואבא שלי."
  },
  {
   "start": 275.72,
   "end": 276.8,
   "text": "כבוד הרב, אתה יודע,"
  },
  {
   "start": 277.56,
   "end": 278.06,
   "text": "הזמן,"
  },
  {
   "start": 278.86,
   "end": 280.16,
   "text": "הזמן מרפא כל פצע."
  },
  {
   "start": 282.22,
   "end": 282.24,
   "text": "אז"
  },
  {
   "start": 282.24,
   "end": 288.64,
   "text": "אז עברו כמה חודשים עד שהספקתי לשכוח ממנה"
  },
  {
   "start": 291.22,
   "end": 292.86,
   "text": "וכבר הייתי בדרך לשידוכים חדשים."
  },
  {
   "start": 295.17,
   "end": 297.11,
   "text": "והשתדכתי עם השירה,"
  },
  {
   "start": 297.99,
   "end": 300.09,
   "text": "והפעם הדרך הייתה סלולה ללא תקלות."
  },
  {
   "start": 301.87,
   "end": 306.77,
   "text": "עד ליום החתונה התחתנו והרגשתי שהנה החיים מחייכים אליי"
  },
  {
   "start": 307.37,
   "end": 308.37,
   "text": "כמו שצריך להיות."
  },
  {
   "start": 317.43,
   "end": 318.59,
   "text": "שנה אחרי החתונה זה קרה."
  },
  {
   "start": 319.51,
   "end": 324.25,
   "text": "שנה אחרי חתונה התעוררתי בוקר אחד וכל הגוף שלי מגרד."
  },
  {
   "start": 326.92,
   "end": 329.7,
   "text": "זה נראה אולי גירוד שעובר,"
  },
  {
   "start": 330.8,
   "end": 331.72,
   "text": "אבל זה לא עבר."
  },
  {
   "start": 333.52,
   "end": 337.9,
   "text": "ככל שהזמן עבר לא יתברר שזו מחלת עור,"
  },
  {
   "start": 338.76,
   "end": 339.4,
   "text": "מחלת עור קשה."
  },
  {
   "start": 341.7,
   "end": 343.86,
   "text": "מחלת עור שאין לה מרפא,"
  },
  {
   "start": 346.28,
   "end": 347.62,
   "text": "והמצב החל מחמיר."
  },
  {
   "start": 348.16,
   "end": 349.42,
   "text": "הגוף שלי התמלא פצעים,"
  },
  {
   "start": 351.88,
   "end": 353.02,
   "text": "והפצעים האלה העדיפו"
  },
  {
   "start": 354.42,
   "end": 355.64,
   "text": "ריח לא נעים."
  },
  {
   "start": 358.2,
   "end": 358.64,
   "text": "הייתי צריך"
  },
  {
   "start": 359.34,
   "end": 362.58,
   "text": "להיות בטיפול יומיומי, כל יום להחליף לי את התחבושות,"
  },
  {
   "start": 363.54,
   "end": 365.0,
   "text": "ואותה כלה צעירה,"
  },
  {
   "start": 365.68,
   "end": 366.68,
   "text": "נאה ועשירה,"
  },
  {
   "start": 367.26,
   "end": 369.32,
   "text": "זה היה מעבר לכוחות שלה."
  },
  {
   "start": 370.3,
   "end": 371.56,
   "text": "היא לא יכלה לשאת את זה."
  },
  {
   "start": 376.33,
   "end": 379.69,
   "text": "אז היא החליפה והחליפה, אבל היא כבר לא יכלה לסבול את זה."
  },
  {
   "start": 383.72,
   "end": 385.76,
   "text": "ויום אחד היא באה עם ההורים שלה,"
  },
  {
   "start": 386.94,
   "end": 388.28,
   "text": "והבהירו לי חד משמעית,"
  },
  {
   "start": 388.92,
   "end": 390.14,
   "text": "אין ברירה, אי אפשר יותר."
  },
  {
   "start": 392.6,
   "end": 393.84,
   "text": "ואני הייתי חסר ישע."
  },
  {
   "start": 394.42,
   "end": 396.26,
   "text": "שוכב במיטה נתון לחסדיהם."
  },
  {
   "start": 400.58,
   "end": 402.82,
   "text": "הם אילצו אותי לתת גט"
  },
  {
   "start": 404.14,
   "end": 404.68,
   "text": "לאשתי."
  },
  {
   "start": 406.78,
   "end": 410.38,
   "text": "יומיים אחר כך הועברתי לבית התמחוי של העיר."
  },
  {
   "start": 412.36,
   "end": 412.96,
   "text": "מוזנח,"
  },
  {
   "start": 413.84,
   "end": 415.9,
   "text": "שבור ובודד."
  },
  {
   "start": 416.86,
   "end": 418.16,
   "text": "כולם מתרחקים ממני."
  },
  {
   "start": 421.66,
   "end": 422.18,
   "text": "בלילה,"
  },
  {
   "start": 423.78,
   "end": 424.44,
   "text": "בלילה ב..."
  },
  {
   "start": 425.94,
   "end": 427.16,
   "text": "הייתי שוכב לי במיטה."
  },
  {
   "start": 428.0,
   "end": 430.78,
   "text": "נאנח מהכאבים, מהפצעים."
  },
  {
   "start": 431.88,
   "end": 432.44,
   "text": "הייתי קצת"
  },
  {
   "start": 433.1,
   "end": 435.74,
   "text": "מוצא לי מרגו על הנשמה, הייתי מנגן,"
  },
  {
   "start": 436.3,
   "end": 437.12,
   "text": "שר לי שירים."
  },
  {
   "start": 440.93,
   "end": 443.09,
   "text": "אתה יודע, כבוד הרב, בלילה שם שאתה שוכב,"
  },
  {
   "start": 445.3,
   "end": 446.38,
   "text": "יש לך זמן לחשוב,"
  },
  {
   "start": 449.36,
   "end": 450.02,
   "text": "להיזכר"
  },
  {
   "start": 451.42,
   "end": 452.12,
   "text": "בכל מיני דברים."
  },
  {
   "start": 456.1,
   "end": 457.1,
   "text": "ואז יום אחד נזכרתי,"
  },
  {
   "start": 459.18,
   "end": 459.8,
   "text": "באותה,"
  },
  {
   "start": 460.8,
   "end": 462.08,
   "text": "באותה כלה אז,"
  },
  {
   "start": 462.48,
   "end": 469.5,
   "text": "שלא רציתי להינשא לה בגלל שהיא נהייתה ענייה."
  },
  {
   "start": 471.76,
   "end": 472.16,
   "text": "ואני,"
  },
  {
   "start": 472.8,
   "end": 473.72,
   "text": "אני למדתי יהדות."
  },
  {
   "start": 474.78,
   "end": 475.74,
   "text": "אז תהיתי לעצמי,"
  },
  {
   "start": 476.48,
   "end": 477.72,
   "text": "האם זה מקאם,"
  },
  {
   "start": 478.9,
   "end": 481.36,
   "text": "מידה כנגד מידה של השם יתברך כנגדי?"
  },
  {
   "start": 484.48,
   "end": 485.18,
   "text": "אם כן,"
  },
  {
   "start": 486.26,
   "end": 488.58,
   "text": "אז אני עושה תשובה, מלמלתי בבכי."
  },
  {
   "start": 490.36,
   "end": 491.48,
   "text": "וככה לילה-לילה."
  },
  {
   "start": 492.38,
   "end": 495.24,
   "text": "היה לי זמן לעשות חשבון נפש על כל הדברים שעשיתי."
  },
  {
   "start": 506.56,
   "end": 507.64,
   "text": "כמה חודשים אחר כך,"
  },
  {
   "start": 508.92,
   "end": 510.02,
   "text": "השכן העני שלי,"
  },
  {
   "start": 511.24,
   "end": 511.9,
   "text": "שגם הוא היה במצב"
  },
  {
   "start": 514.2,
   "end": 515.18,
   "text": "לא רחוק ממני,"
  },
  {
   "start": 516.32,
   "end": 517.16,
   "text": "אני קבצן,"
  },
  {
   "start": 519.75,
   "end": 521.13,
   "text": "שהיה חי לו בבית התמחוי,"
  },
  {
   "start": 521.59,
   "end": 523.93,
   "text": "אמר לי, בוא נעשה עסק משותף, תראה,"
  },
  {
   "start": 524.59,
   "end": 527.19,
   "text": "אני מתפרנס מצדקה."
  },
  {
   "start": 528.69,
   "end": 530.81,
   "text": "אתה, אנשים ידברו איתך בתורה, אתה יודע לענות."
  },
  {
   "start": 533.2,
   "end": 534.22,
   "text": "אז פה אתה תהיה איתי,"
  },
  {
   "start": 535.86,
   "end": 538.5,
   "text": "יראו אותך סובל כל כך, יראו את המצב שלך,"
  },
  {
   "start": 539.4,
   "end": 540.44,
   "text": "וכולם ירצו לתרום."
  },
  {
   "start": 540.52,
   "end": 542.32,
   "text": "יודעים שאתה יודע תורה, יתרמו יותר,"
  },
  {
   "start": 542.84,
   "end": 543.98,
   "text": "ונתחלק חצי-חצי."
  },
  {
   "start": 545.02,
   "end": 546.0,
   "text": "והתחלתי להסתובב."
  },
  {
   "start": 547.26,
   "end": 551.42,
   "text": "כי רציתי קצת עצמאות, רציתי קצת שיהיה לי כסף משלי, כמה אני יכול לחיות בבית המחוי."
  },
  {
   "start": 552.06,
   "end": 553.9,
   "text": "גם הם, כבר היה קשה להם איתי."
  },
  {
   "start": 554.26,
   "end": 557.8,
   "text": "אמרתי, אולי אני אשיג פעם כסף שאני אוכל להחזיק איזה מישהו שיעזור לי בתשלום."
  },
  {
   "start": 559.72,
   "end": 561.66,
   "text": "וככה היינו מסתובבים ממקום למקום."
  },
  {
   "start": 562.9,
   "end": 564.88,
   "text": "הוא היה מספר לאנשים על רוע המזלי."
  },
  {
   "start": 566.8,
   "end": 568.16,
   "text": "ואנשים היו מרחמים באים."
  },
  {
   "start": 568.92,
   "end": 572.78,
   "text": "היו קודם כל בוחנים אותי, שואלים אותי שאלות, דלדעת באמת זה אחד שפעם למד תורה?"
  },
  {
   "start": 574.48,
   "end": 577.02,
   "text": "בתחושת הבושה כל פעם מחדש, כבוד הרב,"
  },
  {
   "start": 577.92,
   "end": 581.54,
   "text": "עד היום אני רועד שאני נזכר בה, לא אשכח אותה."
  },
  {
   "start": 582.4,
   "end": 583.88,
   "text": "ככה הסתובבנו חודשים."
  },
  {
   "start": 586.8,
   "end": 587.26,
   "text": "יום אחד,"
  },
  {
   "start": 591.48,
   "end": 593.32,
   "text": "בא אליי השותף שלי ואמר לי, תראה די,"
  },
  {
   "start": 594.0,
   "end": 595.48,
   "text": "אני לא יכול כבר להסתובב עוד איתך."
  },
  {
   "start": 596.82,
   "end": 597.98,
   "text": "קשה לי, אני רוצה לפרוש."
  },
  {
   "start": 599.04,
   "end": 600.66,
   "text": "אני רוצה ללכת, חסכתי קצת כסף,"
  },
  {
   "start": 600.82,
   "end": 606.32,
   "text": "אולי לפתוח לי איזה עסק קטן, משהו שאני אתחיל קצת להתפרנס בכוחות עצמי ולא מן הצדקה."
  },
  {
   "start": 607.58,
   "end": 608.78,
   "text": "ואתה תצטרך להסתדר."
  },
  {
   "start": 612.42,
   "end": 613.26,
   "text": "לא ידעתי מה לעשות."
  },
  {
   "start": 614.18,
   "end": 616.02,
   "text": "מי יעזור לי? מי יבוא איתי לקבץ נדבות?"
  },
  {
   "start": 618.18,
   "end": 619.02,
   "text": "מה אני עושה?"
  },
  {
   "start": 620.04,
   "end": 621.62,
   "text": "לאן אני הולך? לאן אני בא?"
  },
  {
   "start": 623.2,
   "end": 624.8,
   "text": "אבל הקדוש ברוך הוא לא עזב אותי."
  },
  {
   "start": 626.18,
   "end": 628.84,
   "text": "באותו זמן שאותו השותף שלי עזב,"
  },
  {
   "start": 629.82,
   "end": 631.4,
   "text": "מצאתי לי אדם מבוגר,"
  },
  {
   "start": 635.38,
   "end": 639.4,
   "text": "שגם הוא חיפש מישהו שאיתו ביחד יחד הולך לקבץ נדבות."
  },
  {
   "start": 640.1,
   "end": 642.02,
   "text": "והסיפור שלי מצא חן בעיניו."
  },
  {
   "start": 644.26,
   "end": 648.06,
   "text": "יהודי בן תורה שעקב מחלה כל כך איומה"
  },
  {
   "start": 649.78,
   "end": 651.92,
   "text": "נזרק מהבית שלו אל הרחוב,"
  },
  {
   "start": 655.87,
   "end": 658.27,
   "text": "אז הקמתי שותפות עם אותו איש מבוגר."
  },
  {
   "start": 660.7,
   "end": 663.28,
   "text": "אותו איש מבוגר הזדהה עם הבעיה שלי,"
  },
  {
   "start": 664.02,
   "end": 665.3,
   "text": "כי לאותו איש מבוגר,"
  },
  {
   "start": 667.84,
   "end": 670.14,
   "text": "שהחיים כנראה לא היטיבו עמו,"
  },
  {
   "start": 670.82,
   "end": 671.52,
   "text": "הייתה לא בת,"
  },
  {
   "start": 672.76,
   "end": 673.38,
   "text": "בת חולנית."
  },
  {
   "start": 676.03,
   "end": 676.37,
   "text": "וכך"
  },
  {
   "start": 677.51,
   "end": 678.73,
   "text": "הסתובבנו כולנו."
  },
  {
   "start": 680.77,
   "end": 682.35,
   "text": "היהודי המבוגר, הבת שלו החולנית,"
  },
  {
   "start": 684.75,
   "end": 687.91,
   "text": "ואני מסתובבים ממקום למקום,"
  },
  {
   "start": 691.16,
   "end": 691.98,
   "text": "מקבצים נדבות."
  },
  {
   "start": 704.93,
   "end": 708.99,
   "text": "יום אחד פנה אליי היהודי המבוגר ואמר לי,"
  },
  {
   "start": 709.89,
   "end": 712.19,
   "text": "תראה, אנחנו מסתובבים כל כך הרבה זמן כבר ביחד."
  },
  {
   "start": 714.17,
   "end": 714.39,
   "text": "אתה חולה."
  },
  {
   "start": 718.68,
   "end": 719.96,
   "text": "במחלה כל כך איומה,"
  },
  {
   "start": 723.58,
   "end": 724.74,
   "text": "לא תרצה להינשא לך."
  },
  {
   "start": 726.98,
   "end": 728.56,
   "text": "הבת שלי חולנית שנים כבר."
  },
  {
   "start": 729.74,
   "end": 731.52,
   "text": "אף אחד לא ירצה להינשא לה."
  },
  {
   "start": 732.66,
   "end": 733.28,
   "text": "בואו אולי."
  },
  {
   "start": 734.26,
   "end": 735.28,
   "text": "תנסו אחת אל השנייה."
  },
  {
   "start": 739.37,
   "end": 742.15,
   "text": "הצדק היה איתו, אף אחת לא תרצה להתחתן איתי. מי תרצה להתחתן?"
  },
  {
   "start": 742.81,
   "end": 743.69,
   "text": "אין לי שום סיכוי."
  },
  {
   "start": 744.39,
   "end": 747.49,
   "text": "זה עוד חסד גמור שאותה אחת עושה איתי שהיא מוכנה להתחתן."
  },
  {
   "start": 750.12,
   "end": 751.58,
   "text": "וככה כנראה גם השנייה חשבה."
  },
  {
   "start": 752.6,
   "end": 753.02,
   "text": "הקלה חשבה."
  },
  {
   "start": 754.44,
   "end": 754.9,
   "text": "אז הסכמתי."
  },
  {
   "start": 756.18,
   "end": 756.82,
   "text": "והיא הסכימה."
  },
  {
   "start": 761.97,
   "end": 772.61,
   "text": "מצאנו איזה עיר שבה יכלנו לארגן מניין אנשים שיוכלו לבוא ונוכל לערוך את החופה עם קצת עזרה מבית התמחוי שיהיה קצת אוכל."
  },
  {
   "start": 774.23,
   "end": 775.67,
   "text": "כסף לסעודה לא היה לנו,"
  },
  {
   "start": 777.25,
   "end": 778.65,
   "text": "היכן לגור לא היה לנו,"
  },
  {
   "start": 780.69,
   "end": 781.29,
   "text": "כלום לא היה לנו."
  },
  {
   "start": 783.31,
   "end": 784.29,
   "text": "וכך עשינו חופה."
  },
  {
   "start": 785.13,
   "end": 788.23,
   "text": "אני חושב שזו הייתה החופה העלובה ביותר שהייתה בשנים האחרונות באירופה."
  },
  {
   "start": 788.23,
   "end": 788.59,
   "text": "באירופה."
  },
  {
   "start": 790.45,
   "end": 791.61,
   "text": "בקושי מניין אנשים,"
  },
  {
   "start": 794.48,
   "end": 796.44,
   "text": "הכלה באותם בגדים, אני באותם בגדים."
  },
  {
   "start": 803.4,
   "end": 804.04,
   "text": "בתום החופה"
  },
  {
   "start": 805.28,
   "end": 806.16,
   "text": "נשארנו לבד,"
  },
  {
   "start": 809.2,
   "end": 809.82,
   "text": "רק אני ואי."
  },
  {
   "start": 811.8,
   "end": 813.26,
   "text": "ואז הכלה מבקשת ממני,"
  },
  {
   "start": 815.51,
   "end": 816.55,
   "text": "אני רוצה לטייל."
  },
  {
   "start": 818.31,
   "end": 819.21,
   "text": "אני רוצה לטייל."
  },
  {
   "start": 820.41,
   "end": 822.11,
   "text": "אני שומע אותה מדברת בקול חנוק."
  },
  {
   "start": 823.87,
   "end": 824.65,
   "text": "אז הלכנו,"
  },
  {
   "start": 825.21,
   "end": 827.09,
   "text": "לפחות את זה אני יכול לתת לה."
  },
  {
   "start": 827.45,
   "end": 831.53,
   "text": "את האפשרות לטייל אני יכול לתת לה, חוץ מזה אין לי מה לתת לה כלום."
  },
  {
   "start": 835.3,
   "end": 836.54,
   "text": "וככה אנחנו מטיינים בשקט."
  },
  {
   "start": 838.06,
   "end": 839.0,
   "text": "אין לנו מה להגיד."
  },
  {
   "start": 842.2,
   "end": 842.76,
   "text": "ולפתע,"
  },
  {
   "start": 844.3,
   "end": 847.92,
   "text": "פרץ של בכי חנוק מציף את גרונה,"
  },
  {
   "start": 848.32,
   "end": 850.04,
   "text": "וכל גופה החל להיטלטל מבכי."
  },
  {
   "start": 851.52,
   "end": 852.34,
   "text": "ואני בא אליה ואומר לה,"
  },
  {
   "start": 853.6,
   "end": 854.16,
   "text": "מה קרה?"
  },
  {
   "start": 855.12,
   "end": 856.08,
   "text": "מה קרה? תסבירי לי."
  },
  {
   "start": 857.14,
   "end": 859.14,
   "text": "והיא ממשיכה לבכות ולבכות."
  },
  {
   "start": 859.56,
   "end": 860.44,
   "text": "אבל תגידי לי,"
  },
  {
   "start": 860.82,
   "end": 862.6,
   "text": "ככה אני מדובב אותה שעה ארוכה."
  },
  {
   "start": 865.01,
   "end": 865.57,
   "text": "ולבסוף,"
  },
  {
   "start": 866.57,
   "end": 870.71,
   "text": "לבסוף היא פרצה בשטף של דברים."
  },
  {
   "start": 872.53,
   "end": 883.49,
   "text": "והתברר שהיא בוכה וכואבת על החלומות שהיא רקמה על חופה נפלאה וקדושה שגם הם נגוזו."
  },
  {
   "start": 884.89,
   "end": 887.19,
   "text": "על הקמת בית יהודי עם תלמיד חכם,"
  },
  {
   "start": 888.45,
   "end": 889.33,
   "text": "עם בן תורה."
  },
  {
   "start": 890.27,
   "end": 892.57,
   "text": "בית יהודי קבוע, בית יהודי חם."
  },
  {
   "start": 894.19,
   "end": 895.19,
   "text": "וגם את זה אי אפשר."
  },
  {
   "start": 897.66,
   "end": 898.86,
   "text": "והיא החלה מספרת לי"
  },
  {
   "start": 899.6,
   "end": 900.34,
   "text": "על חתן."
  },
  {
   "start": 901.52,
   "end": 904.12,
   "text": "על החתן הראשון המיועד שלה,"
  },
  {
   "start": 905.28,
   "end": 905.98,
   "text": "שנטש אותה."
  },
  {
   "start": 907.28,
   "end": 910.52,
   "text": "שכשהתברר שאבא שלה, שהיה עשיר גדול,"
  },
  {
   "start": 911.62,
   "end": 913.18,
   "text": "התרושש מכל נכסיו,"
  },
  {
   "start": 915.97,
   "end": 918.21,
   "text": "הוא לא היה מוכן לשמוע כלום ועזב אותה."
  },
  {
   "start": 921.9,
   "end": 924.28,
   "text": "והיא שנים בייסורים ובכאבים,"
  },
  {
   "start": 925.08,
   "end": 926.32,
   "text": "ונהייתה חולה מאז."
  },
  {
   "start": 927.62,
   "end": 928.16,
   "text": "ועכשיו,"
  },
  {
   "start": 929.38,
   "end": 930.84,
   "text": "חופה כל כך עלובה"
  },
  {
   "start": 931.5,
   "end": 932.28,
   "text": "וללא בית."
  },
  {
   "start": 933.82,
   "end": 937.08,
   "text": "וסך הכל שני מוכי גורל שנודדים ממקום למקום."
  },
  {
   "start": 941.86,
   "end": 942.54,
   "text": "וכך היא בוכה."
  },
  {
   "start": 943.58,
   "end": 944.48,
   "text": "בוכה על עצמה."
  },
  {
   "start": 946.2,
   "end": 947.3,
   "text": "בוכה על החיים שלה."
  },
  {
   "start": 948.12,
   "end": 948.94,
   "text": "ואז אני נעמדתי."
  },
  {
   "start": 950.66,
   "end": 951.02,
   "text": "מביט,"
  },
  {
   "start": 951.68,
   "end": 953.56,
   "text": "מביט בקלה ומביט טוב."
  },
  {
   "start": 954.42,
   "end": 955.86,
   "text": "ואז מעבר לחולי,"
  },
  {
   "start": 956.7,
   "end": 957.84,
   "text": "מעבר לרזון."
  },
  {
   "start": 958.9,
   "end": 960.28,
   "text": "מעבר לאותות הצער."
  },
  {
   "start": 962.12,
   "end": 963.02,
   "text": "זו הייתה היא."
  },
  {
   "start": 964.22,
   "end": 965.28,
   "text": "זו הייתה היא."
  },
  {
   "start": 966.16,
   "end": 967.46,
   "text": "הכלה שאני נטשתי."
  },
  {
   "start": 969.72,
   "end": 970.9,
   "text": "לא יכלתי להתאפק."
  },
  {
   "start": 972.24,
   "end": 972.94,
   "text": "נפלתי"
  },
  {
   "start": 976.54,
   "end": 978.5,
   "text": "והתחלתי לגעוד בבכי."
  },
  {
   "start": 979.36,
   "end": 982.08,
   "text": "תוך שאני מספר לה, אני זה החתן שנטשתי."
  },
  {
   "start": 983.44,
   "end": 984.1,
   "text": "אני זה שעזבתי."
  },
  {
   "start": 985.24,
   "end": 988.64,
   "text": "אני זה שחשבתי שאני אסדר אני יודע בדיוק."
  },
  {
   "start": 989.48,
   "end": 990.82,
   "text": "אני אחיה חיים טובים."
  },
  {
   "start": 993.13,
   "end": 994.69,
   "text": "והמעגל נסגר."
  },
  {
   "start": 997.02,
   "end": 998.18,
   "text": "המעגל נסגר."
  },
  {
   "start": 998.92,
   "end": 1000.0,
   "text": "בו העולם חינך אותי."
  },
  {
   "start": 1001.5,
   "end": 1002.16,
   "text": "חינך אותי"
  },
  {
   "start": 1002.72,
   "end": 1004.3,
   "text": "בצורה שלעולם לא אשכח."
  },
  {
   "start": 1010.92,
   "end": 1011.62,
   "text": "כבוד הרב,"
  },
  {
   "start": 1015.72,
   "end": 1016.88,
   "text": "הקדוש ברוך הוא סייע לנו."
  },
  {
   "start": 1017.66,
   "end": 1019.94,
   "text": "מישהו תרם לנו לפחות"
  },
  {
   "start": 1021.06,
   "end": 1023.28,
   "text": "לחודש ימים בקתה קטנה."
  },
  {
   "start": 1024.56,
   "end": 1025.16,
   "text": "שם היינו."
  },
  {
   "start": 1026.08,
   "end": 1028.16,
   "text": "שם היינו בת שבע הברכות גם."
  },
  {
   "start": 1028.7,
   "end": 1030.54,
   "text": "כבוד הרב, בתום שבע הברכות"
  },
  {
   "start": 1031.38,
   "end": 1032.34,
   "text": "התרחש נס נוסף."
  },
  {
   "start": 1035.71,
   "end": 1036.03,
   "text": "לפתע"
  },
  {
   "start": 1037.91,
   "end": 1039.55,
   "text": "רעייתי החלה להבריא,"
  },
  {
   "start": 1042.38,
   "end": 1045.38,
   "text": "והתרחש עוד נס, אולי גדול מהראשון."
  },
  {
   "start": 1046.24,
   "end": 1048.42,
   "text": "לפתע פצעים, פצע אחרי פצע."
  },
  {
   "start": 1049.26,
   "end": 1049.98,
   "text": "החלו להיעלם,"
  },
  {
   "start": 1050.66,
   "end": 1051.5,
   "text": "החלו להתרפא,"
  },
  {
   "start": 1052.12,
   "end": 1053.22,
   "text": "החלו להגליד,"
  },
  {
   "start": 1053.66,
   "end": 1055.82,
   "text": "ואני מתחיל לחזור לקדמותי,"
  },
  {
   "start": 1057.56,
   "end": 1059.74,
   "text": "כאילו בורא עולם אומר נגמר."
  },
  {
   "start": 1061.5,
   "end": 1062.12,
   "text": "ולפתע"
  },
  {
   "start": 1062.12,
   "end": 1064.56,
   "text": "יום אחרי יום"
  },
  {
   "start": 1065.5,
   "end": 1067.52,
   "text": "החלנו במסע של הבראה,"
  },
  {
   "start": 1068.8,
   "end": 1069.86,
   "text": "החלמנו כליל"
  },
  {
   "start": 1073.52,
   "end": 1077.24,
   "text": "והחלנו בחיי נישואים מאושרים ובריאים."
  },
  {
   "start": 1077.98,
   "end": 1080.58,
   "text": "ולא רק זה, אלא הקדוש ברוך הוא העיר לנו"
  },
  {
   "start": 1081.3,
   "end": 1083.66,
   "text": "והחלנו להצליח בכל מעשי ידינו."
  },
  {
   "start": 1084.18,
   "end": 1085.86,
   "text": "ואני יודע שאם אני הייתי"
  },
  {
   "start": 1086.9,
   "end": 1090.34,
   "text": "נאמן למה שהשם רוצה, לא למה שאני רוצה,"
  },
  {
   "start": 1090.74,
   "end": 1092.46,
   "text": "לא הייתי עושה את כל הסיבוב הזה."
  },
  {
   "start": 1092.8,
   "end": 1095.02,
   "text": "היא לא הייתה סובלת שנים בשבילי."
  },
  {
   "start": 1098.86,
   "end": 1101.58,
   "text": "פשוט ניסיתי, אני יודע מה אני צריך."
  },
  {
   "start": 1102.44,
   "end": 1104.66,
   "text": "ולא נתתי לה שם יתברך לנהל את החיים."
  },
  {
   "start": 1105.28,
   "end": 1108.12,
   "text": "אז היום אני מפצה כבוד הרב על כל השנים מפצה אותה."
  },
  {
   "start": 1108.84,
   "end": 1112.2,
   "text": "על כל הצער שגרמתי לה, על כל הצער שגרמתי לשנינו."
  },
  {
   "start": 1114.72,
   "end": 1115.52,
   "text": "הגאון מווילנה"
  },
  {
   "start": 1116.08,
   "end": 1118.84,
   "text": "שמע את הסיפור הזה של אותו יהודי מאמסטרדם."
  },
  {
   "start": 1120.96,
   "end": 1122.92,
   "text": "לימים הוא סיפר אותו בהתפעלות"
  },
  {
   "start": 1123.78,
   "end": 1126.32,
   "text": "לתלמידו המובהק הגאון רבי חיים מבולוז'ין,"
  },
  {
   "start": 1126.32,
   "end": 1127.42,
   "text": "בעל נפש החיים."
  },
  {
   "start": 1130.38,
   "end": 1134.66,
   "text": "צריך לדעת שהמקרה הזה זה יסוד בסיס להשגחה,"
  },
  {
   "start": 1135.26,
   "end": 1138.74,
   "text": "לדעת שהכל הכל מנוהל מהשם יתברך."
  },
  {
   "start": 1139.06,
   "end": 1143.08,
   "text": "הכל הכל מנוהל מהשם יתברך."
  }
 ]
}