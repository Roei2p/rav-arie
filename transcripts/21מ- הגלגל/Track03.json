{
 "disc": "21מ- הגלגל",
 "track": "Track03",
 "duration": 463.152,
 "segments": [
  {
   "start": 2.92,
   "end": 5.94,
   "text": "אומרים חז״ל הקדושים שכאשר הייתה יציאת מצרים,"
  },
  {
   "start": 6.68,
   "end": 10.56,
   "text": "ביציאת מצרים עם ישראל היה בעבדות, היה בקשיים."
  },
  {
   "start": 11.86,
   "end": 15.98,
   "text": "אז כשמשה רבנו בא ועשר מכות הוא נותן,"
  },
  {
   "start": 16.74,
   "end": 21.26,
   "text": "אז בעשר מכות כל מצרים וכל ישראל רואים יש בורא עולם."
  },
  {
   "start": 21.92,
   "end": 23.58,
   "text": "אז רשום ויאמן העם."
  },
  {
   "start": 24.32,
   "end": 25.1,
   "text": "אז האמינו."
  },
  {
   "start": 25.8,
   "end": 27.88,
   "text": "כי הקל להאמין האפשרות להאמין."
  },
  {
   "start": 28.38,
   "end": 32.38,
   "text": "כי כשאני עבד, כשלי קשה ובא מישהו ומראה לי אותות ומופתים,"
  },
  {
   "start": 32.92,
   "end": 35.6,
   "text": "מראה לי שיש אפשרות להשתחרר, בוודאי שאני אאמין לו."
  },
  {
   "start": 37.08,
   "end": 39.36,
   "text": "זה סוג אחד של אמונה, זה לא קל גם אל זה להגיע."
  },
  {
   "start": 39.96,
   "end": 41.28,
   "text": "אבל זה סוג נפלא של אמונה."
  },
  {
   "start": 42.54,
   "end": 44.8,
   "text": "אבל יש סוג יותר גדול מזה של אמונה."
  },
  {
   "start": 47.11,
   "end": 49.19,
   "text": "כאשר עם ישראל בגלות,"
  },
  {
   "start": 49.87,
   "end": 52.01,
   "text": "כאשר האדם, האישה בגלות,"
  },
  {
   "start": 52.57,
   "end": 53.37,
   "text": "בחושך,"
  },
  {
   "start": 54.07,
   "end": 57.03,
   "text": "ולבוא להאמין שבתוך החושך שאנחנו נמצאים בו,"
  },
  {
   "start": 57.53,
   "end": 59.37,
   "text": "גם החושך הזה זה רצון השם,"
  },
  {
   "start": 59.81,
   "end": 60.93,
   "text": "וזה טוב בעיני השם,"
  },
  {
   "start": 61.27,
   "end": 62.21,
   "text": "וזה טוב לנו,"
  },
  {
   "start": 62.29,
   "end": 68.17,
   "text": "והכל יהיה בסדר, למרות החושך שאתם רואים, למרות האין סיכוי שאתם רואים, למרות הייאוש שיש לכם,"
  },
  {
   "start": 68.71,
   "end": 69.89,
   "text": "זה אמונה שהשם רוצה."
  },
  {
   "start": 70.29,
   "end": 72.99,
   "text": "עם זה נכנסים לארץ ישראל, עם זה יוצאים מהגלות."
  },
  {
   "start": 73.41,
   "end": 74.69,
   "text": "ואם לא מאמינים בזה,"
  },
  {
   "start": 75.05,
   "end": 78.43,
   "text": "לא עוברים את השלבים האלה של אמונה, אי אפשר להשיג גאולה."
  },
  {
   "start": 79.09,
   "end": 81.55,
   "text": "ובדור שלנו, דור של כל כך הרבה קשיים,"
  },
  {
   "start": 82.13,
   "end": 83.57,
   "text": "זו האמונה שהשם רוצה."
  },
  {
   "start": 83.91,
   "end": 85.45,
   "text": "שנדע שהקשיים שלנו,"
  },
  {
   "start": 85.83,
   "end": 87.63,
   "text": "שהקשיים שלנו זה רצון השם,"
  },
  {
   "start": 88.07,
   "end": 89.01,
   "text": "זה הטוב עבורנו."
  },
  {
   "start": 89.01,
   "end": 92.87,
   "text": "וזה מה שבעולם רוצה מאיתנו."
  },
  {
   "start": 94.13,
   "end": 96.39,
   "text": "בעולם רוצה מאיתנו שבקשיים של היום,"
  },
  {
   "start": 97.05,
   "end": 99.85,
   "text": "בחיים של היום, בטוב של היום, ולא משנה מה,"
  },
  {
   "start": 100.17,
   "end": 101.77,
   "text": "יש אחד טוב לו, יש אחד פחות טוב לו,"
  },
  {
   "start": 102.31,
   "end": 104.41,
   "text": "במה שאנחנו עוברים, מה שיעבור עלינו."
  },
  {
   "start": 105.65,
   "end": 108.83,
   "text": "צריך לדעת ולהאמין שזה הדבר הכי טוב עבורנו."
  },
  {
   "start": 112.27,
   "end": 113.17,
   "text": "בואו ניקח לדוגמה,"
  },
  {
   "start": 113.99,
   "end": 114.43,
   "text": "בשואה,"
  },
  {
   "start": 115.11,
   "end": 116.43,
   "text": "57 שנה אחרונה,"
  },
  {
   "start": 120.14,
   "end": 121.48,
   "text": "סיפר הרב יזיאל טאובר"
  },
  {
   "start": 125.52,
   "end": 126.36,
   "text": "באחד המחנות."
  },
  {
   "start": 127.28,
   "end": 128.16,
   "text": "היה שם רבי מאוז'ארוב,"
  },
  {
   "start": 129.98,
   "end": 130.6,
   "text": "עובד עבודות כפייה."
  },
  {
   "start": 132.8,
   "end": 134.06,
   "text": "בינתיים מגיעים שיירות"
  },
  {
   "start": 134.72,
   "end": 135.82,
   "text": "של מועמדים למוות,"
  },
  {
   "start": 138.41,
   "end": 141.19,
   "text": "של יהודים שהנאצים, יימח שמם וזכרם,"
  },
  {
   "start": 141.55,
   "end": 143.95,
   "text": "מייעדים להם גורל מר ונמהר."
  },
  {
   "start": 145.15,
   "end": 145.25,
   "text": "לפתע,"
  },
  {
   "start": 146.17,
   "end": 147.55,
   "text": "מבין שיירת הממתינים"
  },
  {
   "start": 148.13,
   "end": 149.63,
   "text": "ניתקת לה דמות,"
  },
  {
   "start": 150.23,
   "end": 151.01,
   "text": "דמותה של אישה."
  },
  {
   "start": 152.67,
   "end": 153.39,
   "text": "עיניה צדו."
  },
  {
   "start": 155.27,
   "end": 155.69,
   "text": "את הרבי,"
  },
  {
   "start": 156.23,
   "end": 157.57,
   "text": "את הרבי מאוז'ארוב, היא רצה אליו."
  },
  {
   "start": 158.29,
   "end": 160.55,
   "text": "עוזבת את הכל, מסכנת את החיים שלה."
  },
  {
   "start": 162.19,
   "end": 164.45,
   "text": "ורצה, רצה על הרבי שהיה צמוד לגדר."
  },
  {
   "start": 165.15,
   "end": 166.13,
   "text": "היא באה אליו ואמרת, כבוד הרב,"
  },
  {
   "start": 166.69,
   "end": 167.55,
   "text": "אני רוצה סכין!"
  },
  {
   "start": 168.39,
   "end": 169.17,
   "text": "והרב מסתכל עליה,"
  },
  {
   "start": 169.99,
   "end": 173.03,
   "text": "רואה את העיניים שלה, את ההחלטיות בעיניים,"
  },
  {
   "start": 173.67,
   "end": 174.13,
   "text": "את המבט,"
  },
  {
   "start": 175.61,
   "end": 176.47,
   "text": "המבט הנחוש."
  },
  {
   "start": 177.57,
   "end": 178.51,
   "text": "סכין היא ממלמלת."
  },
  {
   "start": 179.91,
   "end": 181.77,
   "text": "והרבי מתחיל לדבר, מסביר לה, תראי גברת,"
  },
  {
   "start": 182.51,
   "end": 183.27,
   "text": "אפילו שזה קשה,"
  },
  {
   "start": 183.83,
   "end": 185.63,
   "text": "צריכים לקבל את גזרות השם יתברך."
  },
  {
   "start": 186.61,
   "end": 189.23,
   "text": "זה עונש מהשם יתברך בשבילנו, צריכים לקבל אותו באהבה,"
  },
  {
   "start": 189.69,
   "end": 190.21,
   "text": "לא להתאבד."
  },
  {
   "start": 191.35,
   "end": 193.27,
   "text": "והאישה כאילו לא שומעת מה שהוא אומר."
  },
  {
   "start": 193.85,
   "end": 194.27,
   "text": "סכין,"
  },
  {
   "start": 194.83,
   "end": 195.13,
   "text": "סכין."
  },
  {
   "start": 195.55,
   "end": 197.25,
   "text": "והרבי מוז'ר מסתכל על הצדדים, הוא יודע,"
  },
  {
   "start": 197.79,
   "end": 198.19,
   "text": "הוא יודע,"
  },
  {
   "start": 199.81,
   "end": 201.03,
   "text": "שדיבורים מיותרים"
  },
  {
   "start": 202.31,
   "end": 203.21,
   "text": "שנואים בעיני הנאצים."
  },
  {
   "start": 204.95,
   "end": 205.85,
   "text": "ולצערו הרב,"
  },
  {
   "start": 206.67,
   "end": 211.46,
   "text": "מצד שמאל מתקרב לו שוטר של הגסטאפו."
  },
  {
   "start": 213.6,
   "end": 214.18,
   "text": "הוא נעצר,"
  },
  {
   "start": 216.35,
   "end": 218.79,
   "text": "מביט במבט שטני ברבי,"
  },
  {
   "start": 218.83,
   "end": 219.69,
   "text": "ואומר, מה היא רוצה?"
  },
  {
   "start": 221.05,
   "end": 222.11,
   "text": "מה האישה רוצה ממך?"
  },
  {
   "start": 225.86,
   "end": 227.78,
   "text": "ואז האישה פולטת סכין,"
  },
  {
   "start": 228.8,
   "end": 229.24,
   "text": "סכין."
  },
  {
   "start": 232.28,
   "end": 233.84,
   "text": "השוטר הגרמני חייך."
  },
  {
   "start": 236.2,
   "end": 236.98,
   "text": "סכין את רוצה?"
  },
  {
   "start": 239.0,
   "end": 240.34,
   "text": "את רוצה להרוג את עצמך?"
  },
  {
   "start": 241.32,
   "end": 242.94,
   "text": "הוא שלף סכין חדה קטער"
  },
  {
   "start": 243.7,
   "end": 244.38,
   "text": "מהחגורה שלו,"
  },
  {
   "start": 245.46,
   "end": 246.62,
   "text": "ואמר, קחי לך סכין,"
  },
  {
   "start": 247.76,
   "end": 248.64,
   "text": "וחייך אל הרב."
  },
  {
   "start": 253.9,
   "end": 256.86,
   "text": "והאישה חטפה את הסכין כמוצאת שלל רב."
  },
  {
   "start": 258.24,
   "end": 259.18,
   "text": "לפתע היא רכנה,"
  },
  {
   "start": 262.87,
   "end": 267.87,
   "text": "ישבה לה על הברכיים והוציאה מתוך המעיל שעטף אותה"
  },
  {
   "start": 269.31,
   "end": 269.95,
   "text": "ערימת בד."
  },
  {
   "start": 270.47,
   "end": 271.67,
   "text": "היא פתחה את ערימת הדעבד"
  },
  {
   "start": 273.27,
   "end": 277.27,
   "text": "ולנגד עיניהם הנדהמות של הנוכחים נתגלה."
  },
  {
   "start": 278.69,
   "end": 278.95,
   "text": "תינוק,"
  },
  {
   "start": 280.29,
   "end": 281.71,
   "text": "תינוק בן שמונה ימים."
  },
  {
   "start": 283.59,
   "end": 284.61,
   "text": "היא לקחה את הסכין,"
  },
  {
   "start": 285.73,
   "end": 289.57,
   "text": "ברחה אשר קידשנו במצוותיו וציוונו על המילה."
  },
  {
   "start": 290.57,
   "end": 292.21,
   "text": "ומלה את הבן שלה,"
  },
  {
   "start": 293.19,
   "end": 293.99,
   "text": "אותה אישה,"
  },
  {
   "start": 295.25,
   "end": 296.49,
   "text": "אותה אישה יהודייה,"
  },
  {
   "start": 297.47,
   "end": 298.93,
   "text": "מלה את הבן שלה."
  },
  {
   "start": 302.38,
   "end": 303.66,
   "text": "ואז היא השליכה את הסכין,"
  },
  {
   "start": 304.64,
   "end": 305.76,
   "text": "לקחה את הילד,"
  },
  {
   "start": 306.54,
   "end": 307.5,
   "text": "לקחה את התינוק,"
  },
  {
   "start": 308.16,
   "end": 310.8,
   "text": "הרימה אותו כלפי מעלה וזעקה,"
  },
  {
   "start": 314.12,
   "end": 315.56,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 317.14,
   "end": 319.14,
   "text": "אתה הבאת לי ילד בריא,"
  },
  {
   "start": 320.26,
   "end": 323.56,
   "text": "אני מחזירה לך יהודי כשר."
  },
  {
   "start": 324.76,
   "end": 325.66,
   "text": "בורא עולם,"
  },
  {
   "start": 326.42,
   "end": 328.42,
   "text": "הבאת לי ילד בריא."
  },
  {
   "start": 333.22,
   "end": 334.26,
   "text": "חזירה לך"
  },
  {
   "start": 336.2,
   "end": 337.82,
   "text": "יהודי כשר."
  },
  {
   "start": 345.24,
   "end": 347.16,
   "text": "הגרמני השפיל את העיניים,"
  },
  {
   "start": 351.09,
   "end": 351.67,
   "text": "והיהודייה"
  },
  {
   "start": 352.39,
   "end": 353.41,
   "text": "לקחה את התינוק"
  },
  {
   "start": 354.23,
   "end": 356.23,
   "text": "והצטרפה אל שיירת הממתינים."
  },
  {
   "start": 357.71,
   "end": 359.37,
   "text": "ממתינים לחיי העולם הבא."
  },
  {
   "start": 366.85,
   "end": 367.69,
   "text": "בתוך החושך"
  },
  {
   "start": 368.61,
   "end": 370.41,
   "text": "לראות את הקדוש ברוך הוא."
  },
  {
   "start": 371.23,
   "end": 372.33,
   "text": "בתוך הקשיים"
  },
  {
   "start": 373.29,
   "end": 375.83,
   "text": "לראות את הקדוש ברוך הוא."
  },
  {
   "start": 377.29,
   "end": 378.69,
   "text": "אני יכולה להתייאש,"
  },
  {
   "start": 379.33,
   "end": 381.01,
   "text": "אני יכולה אולי להרוג את עצמי,"
  },
  {
   "start": 381.61,
   "end": 382.93,
   "text": "אבל אני לא אעשה את זה."
  },
  {
   "start": 383.47,
   "end": 384.85,
   "text": "אני חושבת על רצון השני."
  },
  {
   "start": 385.67,
   "end": 387.31,
   "text": "בורא עולם אתה הבאת לי ילד."
  },
  {
   "start": 388.29,
   "end": 389.63,
   "text": "הילד בן שמונה ימים,"
  },
  {
   "start": 390.19,
   "end": 393.77,
   "text": "ואתה ציווית בתורה הקדושה שלך למול אותו."
  },
  {
   "start": 395.03,
   "end": 399.17,
   "text": "אז אפילו שיש קשיים, אני יודעת שהקשיים זה ממך והשואה זה ממך."
  },
  {
   "start": 400.07,
   "end": 400.69,
   "text": "ואני אמול אותו,"
  },
  {
   "start": 401.45,
   "end": 404.65,
   "text": "ואני אבוא אליך, בורא עולם, ויגיד לך, ריבונו של עולם,"
  },
  {
   "start": 405.83,
   "end": 408.21,
   "text": "זיכית אותי בילד בריא!"
  },
  {
   "start": 410.19,
   "end": 411.71,
   "text": "אני עושה את התפקיד שלי"
  },
  {
   "start": 412.31,
   "end": 414.53,
   "text": "ומחזירה לך יהודי כשר."
  },
  {
   "start": 418.67,
   "end": 423.95,
   "text": "לאיזה היכל אותה נשמה של אמא יהודייה טיפסה,"
  },
  {
   "start": 424.59,
   "end": 427.99,
   "text": "לא יודע אם תהיה לנו אפשרות להתקרב להיכל הזה,"
  },
  {
   "start": 428.61,
   "end": 429.99,
   "text": "להציץ לתוכו."
  },
  {
   "start": 434.22,
   "end": 435.66,
   "text": "ואנחנו היום,"
  },
  {
   "start": 436.5,
   "end": 440.82,
   "text": "לא אחרי שמונה ימים, אחרי עשרים שנה, שלושים שנה, ארבעים, שישים."
  },
  {
   "start": 441.74,
   "end": 443.88,
   "text": "זה המבחן שלנו בתוך החושך,"
  },
  {
   "start": 444.52,
   "end": 445.48,
   "text": "לראות את האור."
  }
 ]
}