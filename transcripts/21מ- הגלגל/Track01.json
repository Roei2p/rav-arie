{
 "disc": "21מ- הגלגל",
 "track": "Track01",
 "duration": 307.152,
 "segments": [
  {
   "start": 14.4,
   "end": 17.48,
   "text": "הצדיק הקדוש רבי אלימלך מליז'נסק,"
  },
  {
   "start": 18.92,
   "end": 19.84,
   "text": "בעל הנועם מלימלך."
  },
  {
   "start": 21.18,
   "end": 23.36,
   "text": "בתקופה שלו היה הרבי של כל הרבים."
  },
  {
   "start": 26.42,
   "end": 27.86,
   "text": "היה הבעל שם טוב הקדוש,"
  },
  {
   "start": 28.7,
   "end": 30.3,
   "text": "אחריו בא המגיד ממזריץ',"
  },
  {
   "start": 31.14,
   "end": 33.6,
   "text": "ואחריו הרבי של כל הרבים,"
  },
  {
   "start": 34.16,
   "end": 34.98,
   "text": "הנועם אלימלך,"
  },
  {
   "start": 35.8,
   "end": 36.96,
   "text": "רבי אלימלך מליז'נסק."
  },
  {
   "start": 38.16,
   "end": 42.9,
   "text": "רבי אלימלך מליז'נסק היה נוהג כל סעודה שלישית של שבת לומר,"
  },
  {
   "start": 46.18,
   "end": 52.2,
   "text": "איזה דיבור, איזה דבר תורה שמדבר על התקופה שלנו כאן,"
  },
  {
   "start": 52.56,
   "end": 54.62,
   "text": "עלינו, על העתיד,"
  },
  {
   "start": 55.5,
   "end": 56.46,
   "text": "על דורו של משיח."
  },
  {
   "start": 61.18,
   "end": 62.08,
   "text": "וכך הוא אמר,"
  },
  {
   "start": 63.48,
   "end": 69.28,
   "text": "בדור שלפני בואו של המשיח אומר הנועם אלימלך, מה יהיה אז?"
  },
  {
   "start": 69.84,
   "end": 70.6,
   "text": "יהיה ברור."
  },
  {
   "start": 71.24,
   "end": 72.74,
   "text": "ברור זה מלשון ברור."
  },
  {
   "start": 73.66,
   "end": 75.82,
   "text": "כלומר, כשהמשיח יבוא,"
  },
  {
   "start": 76.32,
   "end": 83.76,
   "text": "יהיה ברור לכולם מי עם השם ומי לא עם השם, מי זכאי ומי חייב."
  },
  {
   "start": 86.24,
   "end": 87.36,
   "text": "ואיך יהיה הבירור,"
  },
  {
   "start": 87.8,
   "end": 89.0,
   "text": "אומר הנועם מלימלך,"
  },
  {
   "start": 89.38,
   "end": 91.34,
   "text": "כמו שלוקחים מסננת"
  },
  {
   "start": 92.28,
   "end": 93.78,
   "text": "ובאים לסנן קמח"
  },
  {
   "start": 94.32,
   "end": 96.38,
   "text": "לפני שאופים בקמח הזה,"
  },
  {
   "start": 97.3,
   "end": 103.12,
   "text": "אז הקמח מעורב בו גם קמח טהור, נקי, לבן וגם פסולת."
  },
  {
   "start": 104.02,
   "end": 106.3,
   "text": "ולוקחים את הקמח עם הפסולת למסננת,"
  },
  {
   "start": 107.06,
   "end": 110.88,
   "text": "שמים למטה קערה ומתחילים להקפיץ את המסננת,"
  },
  {
   "start": 111.92,
   "end": 113.5,
   "text": "לטלטל את המסננת."
  },
  {
   "start": 114.18,
   "end": 116.62,
   "text": "וכאשר המסננת סופגת טלטלות,"
  },
  {
   "start": 118.12,
   "end": 123.66,
   "text": "מה שקורה זה גם הפסולת וגם הקמח חוטפים חבטות."
  },
  {
   "start": 125.58,
   "end": 126.8,
   "text": "והקמח שנוחת"
  },
  {
   "start": 127.66,
   "end": 131.7,
   "text": "הוא נופל בין סדקי המסננת למטה על הקערה,"
  },
  {
   "start": 132.52,
   "end": 133.92,
   "text": "והפסולת נשארת למעלה,"
  },
  {
   "start": 134.9,
   "end": 135.3,
   "text": "על הגובה."
  },
  {
   "start": 136.3,
   "end": 137.66,
   "text": "והיא מסתכלת למטה"
  },
  {
   "start": 138.62,
   "end": 141.92,
   "text": "על הקמח שבקערה וצוחקת ולועגת."
  },
  {
   "start": 142.48,
   "end": 143.56,
   "text": "ואומרת, תראה קמח,"
  },
  {
   "start": 143.98,
   "end": 144.84,
   "text": "תראה איך אתה למטה,"
  },
  {
   "start": 145.26,
   "end": 149.54,
   "text": "איך הטפת חבטות על זה שאתה נקי ולבן ואני למעלה,"
  },
  {
   "start": 149.96,
   "end": 150.5,
   "text": "אני על הגובה."
  },
  {
   "start": 153.73,
   "end": 154.87,
   "text": "המסננת ממשיכה"
  },
  {
   "start": 156.21,
   "end": 159.59,
   "text": "לקבל טלטלה ועוד טלטלה, למה?"
  },
  {
   "start": 159.97,
   "end": 162.97,
   "text": "חבל לבעל המסננת על כל טיפת קמח,"
  },
  {
   "start": 163.39,
   "end": 165.43,
   "text": "על כל פירור קמח שנשאר,"
  },
  {
   "start": 165.87,
   "end": 167.79,
   "text": "על כל נשמה להציל אותה."
  },
  {
   "start": 168.45,
   "end": 169.39,
   "text": "עד שמגיע הרגע"
  },
  {
   "start": 170.63,
   "end": 173.31,
   "text": "שבו לוקח בעל המסננת את המסננת עם הפסולת,"
  },
  {
   "start": 174.43,
   "end": 176.71,
   "text": "והפסולת לסל וחסל."
  },
  {
   "start": 179.46,
   "end": 182.04,
   "text": "אומר הנועם אלימלך, ככה יהיה הבירור"
  },
  {
   "start": 183.4,
   "end": 184.58,
   "text": "בדורו של משיח."
  },
  {
   "start": 185.76,
   "end": 186.72,
   "text": "יבוא בעל הבית,"
  },
  {
   "start": 187.38,
   "end": 187.98,
   "text": "בורא עולם,"
  },
  {
   "start": 188.8,
   "end": 189.66,
   "text": "ויטלטל את כולם,"
  },
  {
   "start": 195.14,
   "end": 201.14,
   "text": "ואלו שחפצים את השם יחטפו חבטות ויראו כאילו הם נופלים למטה."
  },
  {
   "start": 201.92,
   "end": 202.88,
   "text": "הם יהיו בתחתית,"
  },
  {
   "start": 204.34,
   "end": 207.06,
   "text": "ואלה שלמעלה יצחקו על אלו שלמטה."
  },
  {
   "start": 208.76,
   "end": 213.98,
   "text": "אבל בורא העולם ימשיך לטלטל את המסננת, ימשיך לעשות בירור בשביל עוד נשמה."
  },
  {
   "start": 214.84,
   "end": 216.0,
   "text": "להציל עוד נשמה."
  },
  {
   "start": 216.58,
   "end": 219.88,
   "text": "יש באיזה פינה שם נידחת עוד נשמה שצריך להציל אותה."
  },
  {
   "start": 220.34,
   "end": 222.62,
   "text": "בניי אהובים עוד מעט, אני יודע שקשה."
  },
  {
   "start": 223.08,
   "end": 224.32,
   "text": "אני יודע שלועגים לכם."
  },
  {
   "start": 224.64,
   "end": 226.94,
   "text": "אני יודע שאתם נמצאים בקשיים ובניסיונות קשים."
  },
  {
   "start": 227.98,
   "end": 231.2,
   "text": "אבל תמתינו בסבלנטים בשביל עוד נשמה, עוד נשמה."
  },
  {
   "start": 231.62,
   "end": 233.28,
   "text": "אבל הנה כבר עוד מעט הכל נגמר."
  },
  {
   "start": 234.04,
   "end": 237.58,
   "text": "ואתם נשארים נקיים, לבני וטהורים"
  },
  {
   "start": 238.4,
   "end": 239.66,
   "text": "לעולם שכולו טוב,"
  },
  {
   "start": 240.54,
   "end": 242.84,
   "text": "לעולם נפלא, עולם ימות משיח."
  },
  {
   "start": 243.6,
   "end": 245.04,
   "text": "חבל לאבד את זה."
  },
  {
   "start": 245.54,
   "end": 247.04,
   "text": "פה העולם אומר, אני יודע שקשה."
  },
  {
   "start": 247.76,
   "end": 250.42,
   "text": "אני יודע שלפעמים לא הולך כמו שרוצים."
  },
  {
   "start": 251.06,
   "end": 251.92,
   "text": "בכל דבר."
  },
  {
   "start": 252.3,
   "end": 253.88,
   "text": "אם זה בשלום בית, אם זה בזיווגים,"
  },
  {
   "start": 254.28,
   "end": 259.72,
   "text": "אם זה בחינוך הילדים, אם זה בפרנסה, במה לא, במה לא."
  },
  {
   "start": 260.04,
   "end": 262.1,
   "text": "אבל בניי היקרים, תמתינו בניי."
  },
  {
   "start": 263.26,
   "end": 264.72,
   "text": "בניי זה רק נראה שאתם למטה."
  },
  {
   "start": 265.96,
   "end": 266.66,
   "text": "אתם איתי,"
  },
  {
   "start": 267.32,
   "end": 268.44,
   "text": "אתם מהשם יתברך."
  },
  {
   "start": 271.72,
   "end": 273.74,
   "text": "יש גלגל מסתובב בעולם."
  },
  {
   "start": 275.28,
   "end": 277.24,
   "text": "פעם אתה למעלה, פעם אתה למטה."
  },
  {
   "start": 278.54,
   "end": 280.84,
   "text": "כאשר רואים שכל מי שחפץ את השם,"
  },
  {
   "start": 281.42,
   "end": 284.58,
   "text": "כרגע הוא למטה, צריך להבין, הנה, כבר עוד מעטה הגלגל הולך להסתובב."
  },
  {
   "start": 286.12,
   "end": 287.54,
   "text": "ומגיע זמן העלייה."
  },
  {
   "start": 289.2,
   "end": 292.52,
   "text": "עלייתו של הגלגל, גלגל האור הגדול."
  },
  {
   "start": 294.75,
   "end": 296.05,
   "text": "אורו של משיח."
  },
  {
   "start": 296.89,
   "end": 298.23,
   "text": "אורו של הקדוש ברוך הוא."
  }
 ]
}