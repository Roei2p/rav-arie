{
 "disc": "21מ- הגלגל",
 "track": "Track02",
 "duration": 910.2,
 "segments": [
  {
   "start": 1.9,
   "end": 4.78,
   "text": "אומרים חז״ל הקדושים,"
  },
  {
   "start": 7.4,
   "end": 9.56,
   "text": "כל השירים קודש."
  },
  {
   "start": 12.48,
   "end": 13.66,
   "text": "יש שירת דוד,"
  },
  {
   "start": 14.76,
   "end": 15.68,
   "text": "שירת דבורה,"
  },
  {
   "start": 19.0,
   "end": 20.24,
   "text": "כל השירים קודש."
  },
  {
   "start": 22.9,
   "end": 25.44,
   "text": "שיר השירים קודש קודשים."
  },
  {
   "start": 26.7,
   "end": 26.9,
   "text": "למה?"
  },
  {
   "start": 30.76,
   "end": 31.96,
   "text": "אומרים חז״ל הקדושים,"
  },
  {
   "start": 33.9,
   "end": 36.14,
   "text": "כל השירים קודש, שירת הים לדוגמה."
  },
  {
   "start": 36.58,
   "end": 39.08,
   "text": "שירת הים זה היה אחרי שים סוף נבקע לו."
  },
  {
   "start": 39.84,
   "end": 42.74,
   "text": "אז עם ישראל אחרי נס כל כך גדול,"
  },
  {
   "start": 43.2,
   "end": 45.54,
   "text": "משה רבנו אחרי שרואה נס כזה נפלא,"
  },
  {
   "start": 46.16,
   "end": 48.68,
   "text": "שים שלם נבקע בפני עם ישראל,"
  },
  {
   "start": 49.16,
   "end": 54.68,
   "text": "ועם ישראל עובר את הים הנפלא הזה."
  },
  {
   "start": 55.8,
   "end": 57.36,
   "text": "והמצרים אחרי זה טובעים,"
  },
  {
   "start": 57.94,
   "end": 59.36,
   "text": "אז בטח שהוא יגיד שירה"
  },
  {
   "start": 60.5,
   "end": 61.74,
   "text": "אחרי נס כזה מדהים."
  },
  {
   "start": 65.38,
   "end": 66.28,
   "text": "אז ישיר משה,"
  },
  {
   "start": 67.22,
   "end": 70.08,
   "text": "אשיר על השם כי גאו גאה, גאה בליבו,"
  },
  {
   "start": 70.68,
   "end": 73.44,
   "text": "השירה התפרצה מתוכו אחרי נס כזה."
  },
  {
   "start": 74.44,
   "end": 78.54,
   "text": "כשדבורה שרה אחרי שהם ניצחו צבא ישראל, ניצח את צבא סיסרא."
  },
  {
   "start": 79.76,
   "end": 80.86,
   "text": "אפשר להבין את שירת דבורה."
  },
  {
   "start": 82.6,
   "end": 83.78,
   "text": "אבל שיר השירים,"
  },
  {
   "start": 84.7,
   "end": 89.34,
   "text": "שיר השירים שבו רשום מצאוני השומרים, אומר שיר השירים,"
  },
  {
   "start": 89.92,
   "end": 91.44,
   "text": "היכוני, פצעוני."
  },
  {
   "start": 92.86,
   "end": 95.0,
   "text": "קשיים של כנסת ישראל, של הגלות,"
  },
  {
   "start": 96.76,
   "end": 101.56,
   "text": "לשיר בתוך הגלות, בתוך הקשיים, עם הירידות,"
  },
  {
   "start": 101.9,
   "end": 103.36,
   "text": "עם הפצעים, עם הפגעים,"
  },
  {
   "start": 103.36,
   "end": 106.72,
   "text": "עם הלעג והעלבונות שאנחנו סופגים, ואנחנו מהמבית ומבחוץ,"
  },
  {
   "start": 107.84,
   "end": 111.54,
   "text": "שכנסת ישראל ספגה ככה שנים, בכל הגלויות, בכל הזמנים,"
  },
  {
   "start": 114.36,
   "end": 116.26,
   "text": "זה קודש קודשים בעיני השם."
  },
  {
   "start": 116.92,
   "end": 118.18,
   "text": "זה דרגה אחרת לגמרי."
  },
  {
   "start": 119.88,
   "end": 120.44,
   "text": "צריך לדעת,"
  },
  {
   "start": 121.2,
   "end": 124.88,
   "text": "זה הנחת לשם, זה הקורבן הגדול ביותר לכבוד השם יתברך."
  },
  {
   "start": 125.68,
   "end": 127.76,
   "text": "שדווקא בקשיים אתה מתחזק, את מתחזקת,"
  },
  {
   "start": 129.48,
   "end": 130.7,
   "text": "ומהללת את השם יתברך."
  },
  {
   "start": 131.42,
   "end": 132.78,
   "text": "ומה שצריך לתת לנו הרבה כוח,"
  },
  {
   "start": 133.46,
   "end": 134.76,
   "text": "שהעולם הוא כמו גלגל,"
  },
  {
   "start": 134.76,
   "end": 135.76,
   "text": "גלגל הוא לא סתם כדורי,"
  },
  {
   "start": 136.42,
   "end": 138.76,
   "text": "גלגל הוא בעולם, העולם מסתובב."
  },
  {
   "start": 140.0,
   "end": 141.76,
   "text": "אנחנו למטה למחרת, אנחנו למעלה."
  },
  {
   "start": 143.16,
   "end": 144.02,
   "text": "אתם יודעים, יש איזה סיפור,"
  },
  {
   "start": 149.56,
   "end": 151.5,
   "text": "איזה עשיר אחד, עשיר גדול."
  },
  {
   "start": 152.2,
   "end": 155.74,
   "text": "היה לו משרת שגם היה מנהל החשבונות שלו, משרת נאמן."
  },
  {
   "start": 158.76,
   "end": 160.32,
   "text": "ויום אחד הוא יצא למסע עסקים"
  },
  {
   "start": 161.88,
   "end": 167.36,
   "text": "לעיר הסמוכה, לקח סכום של כסף רציני, שם אותו בקופת הברזל, קופה שהיה מאחסן שם את הכסף."
  },
  {
   "start": 168.5,
   "end": 170.94,
   "text": "עלה למרכבה שלו, ויחד עם העוזר שלו, מנהל החשבונות,"
  },
  {
   "start": 171.62,
   "end": 172.32,
   "text": "הם יוצאים לדרך."
  },
  {
   "start": 173.02,
   "end": 175.06,
   "text": "שם היה צריך לעשות כמה עסקאות לקנות סחורה."
  },
  {
   "start": 176.36,
   "end": 178.34,
   "text": "בדרך אומרים יער נפלא, מראות נפלאים,"
  },
  {
   "start": 179.0,
   "end": 180.3,
   "text": "ריח של פריחה באוויר."
  },
  {
   "start": 181.28,
   "end": 183.24,
   "text": "הם הגיעו למקום די מרכזי, כמו אחו,"
  },
  {
   "start": 183.8,
   "end": 185.18,
   "text": "מעין מרוות דשא טבעי,"
  },
  {
   "start": 185.74,
   "end": 187.32,
   "text": "שבקצה הוא היה מעיין נובע."
  },
  {
   "start": 188.48,
   "end": 192.04,
   "text": "והם היו עייפים מהדרך, אז העשיר אמר למנהל החשבונות שלו, בוא נעצור פה קצת, ננוח."
  },
  {
   "start": 193.56,
   "end": 194.7,
   "text": "הם עצרו את המרכבה,"
  },
  {
   "start": 195.5,
   "end": 195.96,
   "text": "ירדו,"
  },
  {
   "start": 197.4,
   "end": 199.02,
   "text": "והעשיר לקח את אותה קובת ברזל,"
  },
  {
   "start": 199.68,
   "end": 200.18,
   "text": "שם אותה,"
  },
  {
   "start": 201.34,
   "end": 202.48,
   "text": "שם במבד הדשא,"
  },
  {
   "start": 202.9,
   "end": 206.7,
   "text": "קיפל שמיכה עליה, וככה נוצר המעין כרית, והוא ככה יושן על זה."
  },
  {
   "start": 207.54,
   "end": 208.84,
   "text": "גם שומר על זה וגם יושן על זה."
  },
  {
   "start": 209.68,
   "end": 211.82,
   "text": "וככה הם נרדמו קצת, נחו להם."
  },
  {
   "start": 212.84,
   "end": 214.24,
   "text": "מקץ שעה קלה הם מתעוררים,"
  },
  {
   "start": 215.46,
   "end": 217.3,
   "text": "אוספים את הבגדים שלהם, את השמיכות,"
  },
  {
   "start": 217.98,
   "end": 219.2,
   "text": "וממשיכים בדרכם"
  },
  {
   "start": 219.86,
   "end": 221.48,
   "text": "אל העיר הסמוכה, אל היריד הגדול."
  },
  {
   "start": 222.5,
   "end": 224.6,
   "text": "הם מגיעים ליריד ומתחילים לעשות סחורה, לקנות,"
  },
  {
   "start": 225.68,
   "end": 227.84,
   "text": "מסכמים, מנסים להוריד מחירים כמה שאפשר,"
  },
  {
   "start": 228.34,
   "end": 229.62,
   "text": "עד ליום האחרון בו הם ישלמו."
  },
  {
   "start": 231.0,
   "end": 233.6,
   "text": "סוגרים עסקאות, היום האחרון מגיע, הם באים"
  },
  {
   "start": 234.74,
   "end": 236.36,
   "text": "אל קופת הברזל, להוציא את הכסף,"
  },
  {
   "start": 237.14,
   "end": 237.82,
   "text": "ושוד ושבר."
  },
  {
   "start": 239.0,
   "end": 239.6,
   "text": "הקופה נעלמה."
  },
  {
   "start": 241.88,
   "end": 242.26,
   "text": "הם לא מבינים,"
  },
  {
   "start": 243.26,
   "end": 245.64,
   "text": "אבל מקץ דקות מספר הם נזכרים."
  },
  {
   "start": 246.76,
   "end": 247.96,
   "text": "העשיר אומר, אוי ואבוי,"
  },
  {
   "start": 248.54,
   "end": 249.02,
   "text": "הקופה,"
  },
  {
   "start": 249.92,
   "end": 250.98,
   "text": "השארנו אותה שמה,"
  },
  {
   "start": 251.62,
   "end": 252.84,
   "text": "אני לא לקחתי איתי את הקופה."
  },
  {
   "start": 253.48,
   "end": 255.34,
   "text": "היא נשארה שמה במרבד דשא הזה,"
  },
  {
   "start": 255.86,
   "end": 257.94,
   "text": "במקום שכולם עוצרים וחונים."
  },
  {
   "start": 258.92,
   "end": 260.16,
   "text": "מקום כל כך מרכזי, מי?"
  },
  {
   "start": 260.96,
   "end": 261.46,
   "text": "מי לא יראה אותה."
  },
  {
   "start": 262.74,
   "end": 262.92,
   "text": "זהו,"
  },
  {
   "start": 263.96,
   "end": 264.84,
   "text": "איבדתי את הכסף."
  },
  {
   "start": 266.06,
   "end": 268.92,
   "text": "אבל לא נורא, אני יכול להמשיך להסתדר, זה לא קריטי לגביי."
  },
  {
   "start": 269.56,
   "end": 271.7,
   "text": "הוא ביטל את כל העסקאות שלו וחזר הביתה."
  },
  {
   "start": 272.56,
   "end": 274.16,
   "text": "מאוכזב, כאילו חזר כאילו מעט שבא."
  },
  {
   "start": 275.08,
   "end": 277.64,
   "text": "בדרך אומר לו המנהל חשבונות, בוא נעצור שם על יד מרבד הדשא."
  },
  {
   "start": 278.7,
   "end": 279.12,
   "text": "אולי,"
  },
  {
   "start": 279.74,
   "end": 281.06,
   "text": "אולי הקופה נמצאת שם."
  },
  {
   "start": 281.68,
   "end": 282.7,
   "text": "אומר לו, אין סיכוי."
  },
  {
   "start": 284.44,
   "end": 285.34,
   "text": "לך תדע, אולי."
  },
  {
   "start": 287.0,
   "end": 289.02,
   "text": "בסוף הם החליטו טוב, לעבור דרך."
  },
  {
   "start": 290.0,
   "end": 292.52,
   "text": "עברו דרך, איך שמגיעים למרבד התשא."
  },
  {
   "start": 293.54,
   "end": 296.76,
   "text": "לפתע העיניים של העשיר קולטות את הקופה."
  },
  {
   "start": 297.7,
   "end": 300.24,
   "text": "ניצבת לה שמה כמו שהיא הייתה."
  },
  {
   "start": 301.2,
   "end": 303.9,
   "text": "הם יורדים, והעשיר ככה הולך לאט."
  },
  {
   "start": 305.06,
   "end": 308.46,
   "text": "אומר לה מנהל חשבונות, תראה, הקופה אולי נמצאת, אבל כסף בטוח שאין בה."
  },
  {
   "start": 310.02,
   "end": 311.86,
   "text": "הם מגיעים לשמה, פותחים את הקופה,"
  },
  {
   "start": 312.66,
   "end": 314.9,
   "text": "הכסף מסודר שם כמו שהיה."
  },
  {
   "start": 316.18,
   "end": 317.96,
   "text": "מנהל חשבונות מרים שמח כולו,"
  },
  {
   "start": 318.54,
   "end": 320.78,
   "text": "מביט בעשיר, רואה את העשיר כולו אדום,"
  },
  {
   "start": 321.64,
   "end": 322.94,
   "text": "אחרי זה חיוור כמו סיד."
  },
  {
   "start": 324.4,
   "end": 325.74,
   "text": "מביט פה במבט רציני."
  },
  {
   "start": 326.92,
   "end": 327.74,
   "text": "טוב, הם עולים לעגלה"
  },
  {
   "start": 328.6,
   "end": 329.82,
   "text": "על המרכבה ונוסעים הביתה."
  },
  {
   "start": 331.4,
   "end": 331.74,
   "text": "בערב"
  },
  {
   "start": 332.46,
   "end": 334.32,
   "text": "קורא העשיר למנהל החשבונות,"
  },
  {
   "start": 334.94,
   "end": 335.52,
   "text": "אמר לו, תקשיב,"
  },
  {
   "start": 336.06,
   "end": 337.68,
   "text": "אתה הבארת אותי שנים בנאמנות."
  },
  {
   "start": 339.32,
   "end": 342.06,
   "text": "כך, הנה יש לך פה מכתב פיטורים, אני מפטר אותך."
  },
  {
   "start": 344.02,
   "end": 346.42,
   "text": "אל תשאל שאלות, אני פשוט מפטר אותך."
  },
  {
   "start": 346.82,
   "end": 347.42,
   "text": "יש לך פה צ'ק,"
  },
  {
   "start": 348.3,
   "end": 350.28,
   "text": "פיצויים על כל השנים שעבדת אותי?"
  },
  {
   "start": 351.1,
   "end": 352.18,
   "text": "קח את זה בבקשה להתראות."
  },
  {
   "start": 353.62,
   "end": 354.72,
   "text": "אל תתווכח איתי ולא כלום."
  },
  {
   "start": 355.64,
   "end": 356.3,
   "text": "אתה מפוטר."
  },
  {
   "start": 357.68,
   "end": 359.04,
   "text": "ומנהל חשבונות לא מבין למה."
  },
  {
   "start": 359.8,
   "end": 360.3,
   "text": "מה אני עשיתי?"
  },
  {
   "start": 361.56,
   "end": 362.42,
   "text": "למה אתה מפטר אותי?"
  },
  {
   "start": 363.74,
   "end": 364.22,
   "text": "והוא הולך,"
  },
  {
   "start": 364.84,
   "end": 366.0,
   "text": "יוצא עם הצ'ק,"
  },
  {
   "start": 366.78,
   "end": 368.58,
   "text": "צ'ק על סכום נכבד, יוצא, אני לא מבין."
  },
  {
   "start": 372.01,
   "end": 372.71,
   "text": "עברה לה תקופה."
  },
  {
   "start": 374.23,
   "end": 374.85,
   "text": "מאז"
  },
  {
   "start": 376.13,
   "end": 378.97,
   "text": "שאותו מנהל חשבונות עזב את העשיר,"
  },
  {
   "start": 379.81,
   "end": 382.77,
   "text": "מאז שהעשיר פיטר את העוזר שלו הנאמן שלו,"
  },
  {
   "start": 384.41,
   "end": 387.11,
   "text": "הוא התחיל להפסיד את הכסף שלו."
  },
  {
   "start": 387.97,
   "end": 390.41,
   "text": "מצבו הכלכלי מתחיל להידרדר."
  },
  {
   "start": 390.79,
   "end": 392.65,
   "text": "עסקה אחר עסקה נכשלת."
  },
  {
   "start": 393.25,
   "end": 394.29,
   "text": "הוא נכנס לחובות."
  },
  {
   "start": 395.35,
   "end": 398.87,
   "text": "עד מהרק, עבור מספר חודשים, הוא מוצא את עצמו על סף פשיטת רגל."
  },
  {
   "start": 399.71,
   "end": 401.23,
   "text": "מאבד את כל מה שהיה לו."
  },
  {
   "start": 401.83,
   "end": 402.93,
   "text": "שנתיים אחרי זה,"
  },
  {
   "start": 403.57,
   "end": 404.97,
   "text": "הוא איבד את הכל הכל."
  },
  {
   "start": 405.51,
   "end": 407.59,
   "text": "יוצא לשוטט בדרכים, מקבץ נדבות."
  },
  {
   "start": 421.84,
   "end": 428.56,
   "text": "קבוצת הקבצנים שהתקרבה לעיר וילנה הייתה אומללה,"
  },
  {
   "start": 429.24,
   "end": 430.7,
   "text": "ביניהם בעלת קבצן אחד,"
  },
  {
   "start": 431.4,
   "end": 434.7,
   "text": "אותו עשיר שכבר היה מכוסה כולו בכדים,"
  },
  {
   "start": 435.28,
   "end": 436.98,
   "text": "בגדים קרועים ובלים,"
  },
  {
   "start": 438.1,
   "end": 439.8,
   "text": "ממש מראה איום ונורא."
  },
  {
   "start": 440.88,
   "end": 443.64,
   "text": "כבר שנים מזה שנים הוא מקבץ נדבות,"
  },
  {
   "start": 444.3,
   "end": 445.24,
   "text": "חי מהיד לפה,"
  },
  {
   "start": 445.94,
   "end": 446.92,
   "text": "והוא מגיע לעיר וילנה."
  },
  {
   "start": 447.9,
   "end": 449.94,
   "text": "בעיר וילנה מתקבצים להם הקבצנים,"
  },
  {
   "start": 450.7,
   "end": 453.46,
   "text": "ומחליפים ביניהם את הדבר החשוב ביותר,"
  },
  {
   "start": 454.08,
   "end": 454.46,
   "text": "מידע."
  },
  {
   "start": 455.52,
   "end": 456.66,
   "text": "מי זה העשיר שתורם?"
  },
  {
   "start": 458.52,
   "end": 462.98,
   "text": "מי זה היהודי שאם נבוא אליו ונבקש צדקה ייתן לכם?"
  },
  {
   "start": 463.66,
   "end": 464.94,
   "text": "ככה מעבירים מידע ביניהם."
  },
  {
   "start": 467.54,
   "end": 471.36,
   "text": "והעשיר לשעבר שלנו שומע על איזה עשיר שיש בווילנה,"
  },
  {
   "start": 471.98,
   "end": 473.14,
   "text": "שהוא ברוך השם נדיב לב."
  },
  {
   "start": 474.32,
   "end": 476.3,
   "text": "והוא כמו כל הקבצנים עושה את דרכו גם אליו,"
  },
  {
   "start": 477.16,
   "end": 477.74,
   "text": "דופק בדלת."
  },
  {
   "start": 478.64,
   "end": 480.66,
   "text": "העשיר מווילנה פותח את הדלת,"
  },
  {
   "start": 481.96,
   "end": 488.74,
   "text": "מביט בקבצן שמולו שמבקש בתחינה תעשה לי טובה, תן לי צדקה"
  },
  {
   "start": 489.96,
   "end": 495.32,
   "text": "ואותו עשיר מסתכל ואומר לו תגיד לי אתה לא מזהה אותי?"
  },
  {
   "start": 496.58,
   "end": 497.4,
   "text": "אתה לא זוכר אותי?"
  },
  {
   "start": 499.24,
   "end": 502.62,
   "text": "הקבצן מסתכל ואומר לו לא מי אתה?"
  },
  {
   "start": 503.64,
   "end": 505.88,
   "text": "אתה לא זוכר אותי, אני המנהל חשבונות שלך."
  },
  {
   "start": 506.04,
   "end": 508.84,
   "text": "אתה היית אז עשיר גדול,"
  },
  {
   "start": 509.56,
   "end": 510.62,
   "text": "אני הייתי העוזר שלך,"
  },
  {
   "start": 511.28,
   "end": 517.32,
   "text": "המשרת שלך, מנהל חשבונות שלך. אתה לא זוכר שפעם אחת באת ובאופן פתאומי פיטרת אותי?"
  },
  {
   "start": 518.8,
   "end": 526.22,
   "text": "תדע לך, מאז שפיטרת אותי לקחתי את הכסף של הפיצויים והשקעתי ושגשגתי ונהייתי העשיר של וילנה,"
  },
  {
   "start": 526.92,
   "end": 527.96,
   "text": "ותראה מה קרה לך."
  },
  {
   "start": 528.94,
   "end": 531.92,
   "text": "אבל תדע לך שאני לא שומר לך טינה על זה שפיטרת אותי."
  },
  {
   "start": 532.56,
   "end": 534.12,
   "text": "אני זוכר את השנים שהיינו ביחד,"
  },
  {
   "start": 535.12,
   "end": 535.92,
   "text": "ואני מבקש ממך,"
  },
  {
   "start": 537.04,
   "end": 537.92,
   "text": "אני רוצה לעזור לך."
  },
  {
   "start": 539.06,
   "end": 541.26,
   "text": "רק לך, אני אתן לך עכשיו חמש רובל."
  },
  {
   "start": 541.94,
   "end": 544.28,
   "text": "לך למקווה, לך לבית המרחץ."
  },
  {
   "start": 544.82,
   "end": 546.94,
   "text": "אז זה היה לא מקלחות בבתים, היה מרחץ מרכזי."
  },
  {
   "start": 547.66,
   "end": 551.14,
   "text": "תרחוץ עצמך, תסתפר, תראה, אתה נראה נורא ואיום."
  },
  {
   "start": 552.66,
   "end": 553.34,
   "text": "תבוא אליי,"
  },
  {
   "start": 553.84,
   "end": 557.94,
   "text": "מקולח עם קצת מקלחת אחרי כלא דקה, מהזמן שמים לא באו לגוף שלך."
  },
  {
   "start": 559.18,
   "end": 560.36,
   "text": "תבוא אליי ואני אעזור לך,"
  },
  {
   "start": 561.22,
   "end": 562.28,
   "text": "שלא תהיה במצב הזה."
  },
  {
   "start": 563.04,
   "end": 567.28,
   "text": "אותו עשיר לשעבר, אותו עני, לקח את החמש רובל בעיניים דומעות"
  },
  {
   "start": 568.2,
   "end": 571.56,
   "text": "והולך פוסע לו לעבר בית המרחץ המרכזי של וילנה."
  },
  {
   "start": 573.24,
   "end": 576.6,
   "text": "השומר לא נתן לו להיכנס, מי ייתן לאחד כזה? מן הסתם אין לו כסף."
  },
  {
   "start": 577.62,
   "end": 580.08,
   "text": "כשהוא נתן לו מטבע של חמש רובל הוא כל כך הופתע, השומר"
  },
  {
   "start": 581.08,
   "end": 582.24,
   "text": "נתן לקבצן להיכנס."
  },
  {
   "start": 583.12,
   "end": 584.48,
   "text": "הוא נכנס פושט הבגדים,"
  },
  {
   "start": 585.78,
   "end": 587.16,
   "text": "מתקלח שמה,"
  },
  {
   "start": 590.03,
   "end": 593.81,
   "text": "גרמים של לכלוך יורדים לו מהגוף."
  },
  {
   "start": 595.09,
   "end": 599.79,
   "text": "ובתום כמה שעות של טיפול הוא מתחיל להתלבש, לובש את המכנסיים,"
  },
  {
   "start": 600.57,
   "end": 601.39,
   "text": "לובש את החולצה,"
  },
  {
   "start": 602.23,
   "end": 603.25,
   "text": "ואז שם את הציצית."
  },
  {
   "start": 604.29,
   "end": 605.67,
   "text": "ואז הוא בא לקחת את המעיל שלו."
  },
  {
   "start": 606.59,
   "end": 609.87,
   "text": "זה המעיל הקרוע הבלוי שלו, המרופץ שלו, שמלווה אותו שנים,"
  },
  {
   "start": 612.58,
   "end": 613.62,
   "text": "ולפתע הוא לא רואה אותו."
  },
  {
   "start": 615.04,
   "end": 616.7,
   "text": "הוא מחפש אותו פה ושם לא מוצא אותו."
  },
  {
   "start": 619.08,
   "end": 620.96,
   "text": "הוא בא לשומר, אומר, תגיד, ראית את המעיל שלי?"
  },
  {
   "start": 622.38,
   "end": 626.36,
   "text": "מעיל כזה קרוע. אומר לו, רגע, יצא פה מישהו עם מעיל, כנראה גנבו לך את המעיל."
  },
  {
   "start": 628.44,
   "end": 630.18,
   "text": "גנבו לך כנראה את המעיל, לא שמתי לב."
  },
  {
   "start": 632.68,
   "end": 635.12,
   "text": "והקבצן העשיר לשעבר מסתכל"
  },
  {
   "start": 635.74,
   "end": 636.36,
   "text": "על השומר,"
  },
  {
   "start": 637.64,
   "end": 638.92,
   "text": "מחייך כולו,"
  },
  {
   "start": 639.94,
   "end": 640.22,
   "text": "פניו"
  },
  {
   "start": 640.74,
   "end": 642.2,
   "text": "יוצאים סמוקות מאושר,"
  },
  {
   "start": 643.04,
   "end": 643.56,
   "text": "והוא יוצא,"
  },
  {
   "start": 644.24,
   "end": 644.74,
   "text": "יחף,"
  },
  {
   "start": 645.82,
   "end": 646.5,
   "text": "עם רק חולצה,"
  },
  {
   "start": 648.54,
   "end": 650.94,
   "text": "מכנסיים וציצית לאורו,"
  },
  {
   "start": 651.66,
   "end": 653.34,
   "text": "יוצא לשלג אל הקור"
  },
  {
   "start": 653.98,
   "end": 654.7,
   "text": "של וילנה,"
  },
  {
   "start": 655.34,
   "end": 657.62,
   "text": "ומתחיל לרקוד ולקפץ ברחובות."
  },
  {
   "start": 658.38,
   "end": 660.4,
   "text": "וכולו שמחה, כולו אושר."
  },
  {
   "start": 661.22,
   "end": 663.16,
   "text": "ובאים ילדים מסתכלים, לא מבינים מה קורה."
  },
  {
   "start": 663.86,
   "end": 667.68,
   "text": "ובאים מבוגרים מסתכלים, אף אחד לא מבין מה קורה. על מה אתה שמח? מה קרה?"
  },
  {
   "start": 668.68,
   "end": 670.16,
   "text": "הבן אדם כנראה יצא מדעתו."
  },
  {
   "start": 671.32,
   "end": 673.66,
   "text": "וככה כולם באים לראות במחזה אדם מטורף."
  },
  {
   "start": 675.9,
   "end": 678.1,
   "text": "השמועה הגיעה גם לעשיר של וילנה."
  },
  {
   "start": 679.0,
   "end": 679.7,
   "text": "והוא גם הגיע למקום."
  },
  {
   "start": 680.8,
   "end": 682.76,
   "text": "והנה הוא רואה את הידיד שלו."
  },
  {
   "start": 684.06,
   "end": 686.0,
   "text": "את העשיר לשעבר שהוא עבד אצלו."
  },
  {
   "start": 686.98,
   "end": 688.14,
   "text": "מתנהג כמו מטורף."
  },
  {
   "start": 689.1,
   "end": 690.06,
   "text": "הוא בא אליו ואומר לו, בוא,"
  },
  {
   "start": 690.8,
   "end": 695.1,
   "text": "כנראה כל הזמן שהיית קבצן השפיע עליך, פגע בך, בוא, בוא."
  },
  {
   "start": 696.06,
   "end": 698.82,
   "text": "מה אתה עושה? למה אתה מתנהג בצורה כל כך מוזרה?"
  },
  {
   "start": 700.18,
   "end": 700.74,
   "text": "אבל אז,"
  },
  {
   "start": 701.4,
   "end": 704.7,
   "text": "לעיני כולם, עצר לפתע אותו קבצן עשיר,"
  },
  {
   "start": 705.54,
   "end": 708.74,
   "text": "הביט במנהל החשבונות לשעבר שלו ואמר לו, תקשיב,"
  },
  {
   "start": 709.56,
   "end": 710.2,
   "text": "אני לא מטורף."
  },
  {
   "start": 711.18,
   "end": 712.86,
   "text": "אתה יודע למה אני מתנהג ככה?"
  },
  {
   "start": 714.52,
   "end": 715.64,
   "text": "אתה זוכר אז"
  },
  {
   "start": 716.24,
   "end": 727.61,
   "text": "אותו יום שיצאנו ליריד ואיבדתי את קופת הברזל שלי ואחרי זה מצאנו אותה עם הכסף."
  },
  {
   "start": 729.19,
   "end": 731.91,
   "text": "אתה ראית איך התנהגתי, איך הייתי עצוב, אתה יודע למה?"
  },
  {
   "start": 732.99,
   "end": 733.63,
   "text": "תדע לך,"
  },
  {
   "start": 734.23,
   "end": 735.23,
   "text": "גלגל הוא בעולם."
  },
  {
   "start": 736.03,
   "end": 738.03,
   "text": "אדם יכול לעלות למעלה למעלה,"
  },
  {
   "start": 739.17,
   "end": 741.77,
   "text": "אבל בסוף מגיע לנקודה שהוא רק יורד."
  },
  {
   "start": 745.03,
   "end": 749.81,
   "text": "כאשר אני ראיתי שאני מגיע למצב כזה כל כך טוב,"
  },
  {
   "start": 750.25,
   "end": 754.19,
   "text": "שאפילו כסף שהלך לי לאיבוד, בורא עולם מחזיר לי"
  },
  {
   "start": 755.67,
   "end": 759.09,
   "text": "אפילו כסף שהלך לאיבוד, בורא עולם מחזיר לי, לא לוקח לי"
  },
  {
   "start": 759.85,
   "end": 764.27,
   "text": "לא נאבד לי, הכסף חוזר, כסף שבדרך הטבע היה צריך כבר להיעבד"
  },
  {
   "start": 764.71,
   "end": 768.53,
   "text": "הבנתי שהגיעתי לשיא שלי, שמכאן נותר רק לרדת"
  },
  {
   "start": 768.97,
   "end": 775.99,
   "text": "ואני כל כך אהבתי אותך, וכל כך היה אכפת לי לך, שעוד באותו יום ידעתי אם אני אסביר לך אתה תתווכח איתי"
  },
  {
   "start": 776.55,
   "end": 784.09,
   "text": "פיטרתי אותך בלי הסברים ונתתי לך סכום כסף פיצוי כל עוד שיש לי כסף כי ידעתי שאני הולך לאבד את הכל"
  },
  {
   "start": 785.03,
   "end": 785.49,
   "text": "ובאמת"
  },
  {
   "start": 787.69,
   "end": 793.05,
   "text": "אחרי כמה זמן התחלתי להידרדר ולאבד את הכל גלגלו בעולם"
  },
  {
   "start": 796.83,
   "end": 799.71,
   "text": "וכאשר הגעתי למצב שהייתי קבצן"
  },
  {
   "start": 800.57,
   "end": 805.89,
   "text": "ואני מקבץ וסוף סוף אני הולך לבית המרחץ אחרי שנים של קיבוץ נדבות"
  },
  {
   "start": 806.83,
   "end": 811.67,
   "text": "ובבית המרחץ גונבים לי את המעיל הקרוע שלי,"
  },
  {
   "start": 812.03,
   "end": 813.97,
   "text": "מעיל שמי היה רוצה דבר כזה."
  },
  {
   "start": 814.47,
   "end": 819.59,
   "text": "אפילו את המעיל שלי גנבו עם הכינים, עם הקרעים, אותו גנבו,"
  },
  {
   "start": 820.01,
   "end": 821.99,
   "text": "יותר מזה כבר אי אפשר לרדת."
  },
  {
   "start": 823.25,
   "end": 828.15,
   "text": "אז עכשיו אני שמח ורוקד כי אני יודע שהעזרה שאתה תושיט לי תעלה אותי מעלה-מעלה,"
  },
  {
   "start": 828.51,
   "end": 829.69,
   "text": "שנגמרה הגלות שלי,"
  },
  {
   "start": 830.01,
   "end": 831.19,
   "text": "שנגמר החושך שלי,"
  },
  {
   "start": 831.49,
   "end": 833.51,
   "text": "כי מכאן אי אפשר כבר לרדת."
  },
  {
   "start": 834.51,
   "end": 840.43,
   "text": "אותו מנהל חשבונות נתן סיוע לאותו העשיר, קבצן."
  },
  {
   "start": 841.11,
   "end": 843.19,
   "text": "ואכן, כמו שהוא אמר, הגלגל הוא בעולם."
  },
  {
   "start": 844.05,
   "end": 846.99,
   "text": "והקבצן הזה עלה חזרה להיות עשיר כמו קודם."
  },
  {
   "start": 849.56,
   "end": 853.0,
   "text": "גם כשקשה צריך לדעת אם אנחנו רואים שעם ישראל,"
  },
  {
   "start": 853.46,
   "end": 855.76,
   "text": "אלה שעובדים את השם, אלה שרוצים את השם,"
  },
  {
   "start": 856.14,
   "end": 857.04,
   "text": "נרמסים,"
  },
  {
   "start": 857.36,
   "end": 858.16,
   "text": "וקשה דווקא,"
  },
  {
   "start": 858.48,
   "end": 863.78,
   "text": "וקשיים, ואורה למטה למטה, גלגל הוא בעולם. עוד מעט הולך להתחלף הכול."
  },
  {
   "start": 864.16,
   "end": 868.32,
   "text": "עוד מעט הולך להעיר אורו של השם יתברך בעולם."
  },
  {
   "start": 868.98,
   "end": 870.0,
   "text": "לכן צריכים להתחזק,"
  },
  {
   "start": 870.48,
   "end": 873.02,
   "text": "לכן דווקא בתוך החושך צריך לראות את האור."
  },
  {
   "start": 873.9,
   "end": 877.38,
   "text": "דווקא בחודש החושך צריך להבין, הנה הולך להגיע הסיום."
  },
  {
   "start": 878.04,
   "end": 880.78,
   "text": "ועכשיו זה כבר סיום של כל העולם הנוכחי שלנו."
  },
  {
   "start": 881.34,
   "end": 883.42,
   "text": "ששת אלפים השנה מתקרבות לסיומם,"
  },
  {
   "start": 883.78,
   "end": 885.32,
   "text": "התכלית מתקרבת לסיומה,"
  },
  {
   "start": 885.76,
   "end": 886.74,
   "text": "רק להחזיק מעמד,"
  },
  {
   "start": 887.16,
   "end": 890.14,
   "text": "רק להבין שהנה עוד מעט הולך להסתובב הכל,"
  },
  {
   "start": 890.62,
   "end": 893.46,
   "text": "והגלגל יעלה אותנו מעלה-מעלה."
  },
  {
   "start": 896.02,
   "end": 900.2,
   "text": "אם נתגבר על כל גל של ניסיונות ועוד גל של ניסיונות,"
  },
  {
   "start": 900.7,
   "end": 905.44,
   "text": "נהיה בעזרת השם על הגלגל שיעלה אותנו באזור השם מעלה-מעלה."
  }
 ]
}