{
 "disc": "21מ- הגלגל",
 "track": "Track07",
 "duration": 158.184,
 "segments": [
  {
   "start": 3.63,
   "end": 5.29,
   "text": "אמר רבי אלימלך מיליז'נסק,"
  },
  {
   "start": 6.45,
   "end": 7.43,
   "text": "הרבי של כל הרבי."
  },
  {
   "start": 8.53,
   "end": 13.05,
   "text": "לעתיד לבוא מותח הקדוש ברוך הוא חבל מקצה העולם ועד קצהו,"
  },
  {
   "start": 14.35,
   "end": 18.53,
   "text": "וכל העולם נאחזים בחבל של הקדוש ברוך הוא."
  },
  {
   "start": 19.47,
   "end": 21.65,
   "text": "ואז הקדוש ברוך הוא עושה טלטלה."
  },
  {
   "start": 22.47,
   "end": 26.93,
   "text": "טלטלה של הקדוש ברוך הוא זה כמו שהייתה השואה לדוגמה, זאת טלטלה."
  },
  {
   "start": 27.73,
   "end": 28.93,
   "text": "והחלשים עוזבים."
  },
  {
   "start": 29.59,
   "end": 32.59,
   "text": "ככה קרה לי, אין זה, אחרי השואה, אני לא מאמין,"
  },
  {
   "start": 32.81,
   "end": 37.39,
   "text": "אחרי אז זה החלשים עוזבים ונופלים לתהום."
  },
  {
   "start": 40.56,
   "end": 43.5,
   "text": "ואז נשארים עדיין יהודים על החבל."
  },
  {
   "start": 44.54,
   "end": 47.22,
   "text": "והקדוש ברוך הוא מטלטל שוב את החבל,"
  },
  {
   "start": 48.3,
   "end": 49.56,
   "text": "טלטלה שנייה."
  },
  {
   "start": 50.54,
   "end": 52.26,
   "text": "ומבין אלו שנשארו,"
  },
  {
   "start": 53.02,
   "end": 55.58,
   "text": "מבין אלו שהאמינו גם אחרי השואה,"
  },
  {
   "start": 56.18,
   "end": 58.92,
   "text": "מבין אלה שהאמינו ומאמינים בתוכנו,"
  },
  {
   "start": 59.76,
   "end": 63.0,
   "text": "יש שיאמרו, כנראה הקדוש ברוך הוא לא רוצה אותנו."
  },
  {
   "start": 63.58,
   "end": 64.44,
   "text": "או כל מיני תירוצים,"
  },
  {
   "start": 65.82,
   "end": 66.6,
   "text": "כל מיני תירוצים."
  },
  {
   "start": 67.38,
   "end": 69.08,
   "text": "אני לא שווה כלום, אין לי כוח,"
  },
  {
   "start": 70.06,
   "end": 70.56,
   "text": "אני לא מסוגל,"
  },
  {
   "start": 72.02,
   "end": 74.98,
   "text": "אני כולי תיקון, קליפה, לא יעזור כלום."
  },
  {
   "start": 75.6,
   "end": 79.9,
   "text": "ואותם אלה עוזבים את החבל מרצונם, רחמנא ליצלן."
  },
  {
   "start": 80.94,
   "end": 82.6,
   "text": "עוזבים את החבל מרצונם."
  },
  {
   "start": 83.96,
   "end": 85.28,
   "text": "ובחבל יישארו"
  },
  {
   "start": 86.12,
   "end": 87.06,
   "text": "אותם אלו"
  },
  {
   "start": 87.78,
   "end": 89.7,
   "text": "שהחזיקו בכל כוחם"
  },
  {
   "start": 90.4,
   "end": 95.64,
   "text": "ולא עזבו את החבל המחבר אל השם יתברך, יהיה מה שיהיה לא עוזבים."
  },
  {
   "start": 100.37,
   "end": 101.81,
   "text": "וזה מה שנאמר,"
  },
  {
   "start": 102.63,
   "end": 104.27,
   "text": "חבלו של משיח."
  },
  {
   "start": 105.29,
   "end": 107.01,
   "text": "וזהו חבלו של משיח."
  },
  {
   "start": 107.99,
   "end": 109.81,
   "text": "סיים רבי אלימלך מליז'נסק"
  },
  {
   "start": 120.3,
   "end": 122.18,
   "text": "והשאיר לנו במוטו צוואה,"
  },
  {
   "start": 123.02,
   "end": 125.94,
   "text": "לא לעזוב את הקדוש ברוך הוא, יהיה"
  },
  {
   "start": 126.56,
   "end": 127.52,
   "text": "מה שיהיה."
  },
  {
   "start": 128.26,
   "end": 128.82,
   "text": "לא משנה."
  },
  {
   "start": 129.5,
   "end": 130.24,
   "text": "אני עם הקדוש ברוך הוא."
  },
  {
   "start": 131.56,
   "end": 132.94,
   "text": "אני עם מלך."
  },
  {
   "start": 133.48,
   "end": 139.28,
   "text": "מלכי, המלכים, הקדוש ברוך הוא לא יעזור כלום עם התורה שלו,"
  },
  {
   "start": 139.88,
   "end": 143.34,
   "text": "עם המצוות שלו, עם השבת, עם הכל,"
  },
  {
   "start": 143.98,
   "end": 146.3,
   "text": "אני עם הקדוש ברוך הוא."
  },
  {
   "start": 152.99,
   "end": 155.07,
   "text": "הכל, הכל למען השם יברח."
  }
 ]
}