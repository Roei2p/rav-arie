{
 "disc": "39תת- שאיפות קטלניות",
 "track": "Track03",
 "duration": 1564.176,
 "segments": [
  {
   "start": 3.91,
   "end": 5.23,
   "text": "אבימלך בן עיר ובעל,"
  },
  {
   "start": 5.87,
   "end": 7.29,
   "text": "אדם עם שאיפות מסוכנות,"
  },
  {
   "start": 8.61,
   "end": 10.61,
   "text": "אדם ללא יראת שמיים."
  },
  {
   "start": 11.99,
   "end": 13.25,
   "text": "וכשאין יראת שמיים,"
  },
  {
   "start": 15.53,
   "end": 16.63,
   "text": "זו בעיה גדולה מאוד."
  },
  {
   "start": 17.31,
   "end": 18.55,
   "text": "עוד בספר בראשית,"
  },
  {
   "start": 18.97,
   "end": 21.29,
   "text": "אבי האומה העברית אברהם אבינו אומר,"
  },
  {
   "start": 22.83,
   "end": 25.61,
   "text": "רק אין יראת אלוקים במקום הזה והרגוני."
  },
  {
   "start": 27.59,
   "end": 31.95,
   "text": "כשיש עיר ללא יראת שמיים, כשיש אדם ללא יראת שמיים, התוצאות הן נוראות."
  },
  {
   "start": 32.79,
   "end": 39.17,
   "text": "ואבימלך משתרר לו על ישראל במשך שלוש שנים,"
  },
  {
   "start": 40.33,
   "end": 42.93,
   "text": "כשמרכז הכובד שלו, מרכז השלטון שלו,"
  },
  {
   "start": 43.55,
   "end": 44.21,
   "text": "זה בשכם."
  },
  {
   "start": 45.45,
   "end": 48.91,
   "text": "הוא שולט על כל ישראל בעל כורחם ומתוך גאווה."
  },
  {
   "start": 49.89,
   "end": 52.33,
   "text": "הסמל של אבימלך הוא כוכיב עוצם ידי,"
  },
  {
   "start": 54.69,
   "end": 56.13,
   "text": "הוא חוסר ביראת שמיים."
  },
  {
   "start": 59.65,
   "end": 60.65,
   "text": "אבל אבימלך,"
  },
  {
   "start": 61.95,
   "end": 66.23,
   "text": "זה שלמעשה בנה את השקפת העולם שלו, את החיים שלו,"
  },
  {
   "start": 66.55,
   "end": 70.55,
   "text": "את ההצלחות שלו על הכוח שלו, על התכנון שלו,"
  },
  {
   "start": 71.39,
   "end": 74.97,
   "text": "על העוצמה שלו, על השאיפות המסוכנות שלו,"
  },
  {
   "start": 75.95,
   "end": 82.37,
   "text": "שכח או לא לקח בחשבון את מי שאמר והיה עולם."
  },
  {
   "start": 83.49,
   "end": 86.49,
   "text": "ואז מה שקורה, שהקדוש ברוך הוא,"
  },
  {
   "start": 87.27,
   "end": 88.71,
   "text": "זה שמנהל את העניינים,"
  },
  {
   "start": 89.45,
   "end": 92.37,
   "text": "שהכל מאיתו התברך בהשגחה מופלאה,"
  },
  {
   "start": 92.91,
   "end": 95.23,
   "text": "יוצר לכאורה לפתע,"
  },
  {
   "start": 95.39,
   "end": 96.89,
   "text": "לכאורה ללא סיבה מובנת,"
  },
  {
   "start": 97.79,
   "end": 99.99,
   "text": "שינוי, שינוי בדעת הקהל"
  },
  {
   "start": 101.45,
   "end": 105.49,
   "text": "של הבוחרים של אבימלך, של אוהבי אבימלך,"
  },
  {
   "start": 106.07,
   "end": 107.17,
   "text": "של בני העיר שכם."
  },
  {
   "start": 107.97,
   "end": 109.61,
   "text": "הקדוש ברוך הוא שולח רוח רעה,"
  },
  {
   "start": 109.95,
   "end": 110.89,
   "text": "רוח של שנאה,"
  },
  {
   "start": 111.27,
   "end": 112.13,
   "text": "רוח של מריבה,"
  },
  {
   "start": 112.55,
   "end": 113.61,
   "text": "רוח של מחלוקת."
  },
  {
   "start": 114.97,
   "end": 116.13,
   "text": "ובעלי שכם,"
  },
  {
   "start": 116.51,
   "end": 122.59,
   "text": "בעלי שכם הכוונה החשובים שבעיר שכם פשוט בוגדים באבימלך,"
  },
  {
   "start": 123.21,
   "end": 125.77,
   "text": "ומרימים ראש כנגד מנהיגותו."
  },
  {
   "start": 126.91,
   "end": 128.85,
   "text": "אבימלך שיצא מהעיר שכם למסע,"
  },
  {
   "start": 129.33,
   "end": 131.01,
   "text": "מסע של שליחויות ממקום למקום,"
  },
  {
   "start": 131.67,
   "end": 136.31,
   "text": "הם שמים ערבים בראשי ההרים על מנת להתנקש בחייו."
  },
  {
   "start": 137.05,
   "end": 138.35,
   "text": "הם מחכים מתי הוא יגיע,"
  },
  {
   "start": 138.87,
   "end": 140.59,
   "text": "מתי הם יוכלו סוף סוף להרוג אותו."
  },
  {
   "start": 141.47,
   "end": 143.81,
   "text": "איש לא מבין מאין זה התחיל, למה?"
  },
  {
   "start": 144.93,
   "end": 146.35,
   "text": "רק יושב במרום עם משחק,"
  },
  {
   "start": 147.07,
   "end": 148.57,
   "text": "אתה אבימלך מתכנן?"
  },
  {
   "start": 149.11,
   "end": 151.11,
   "text": "אתה חושב שהכל בתכנון שלך?"
  },
  {
   "start": 152.03,
   "end": 155.45,
   "text": "ומעתה הכל יתנהל בהשגחה מופלאה מאת השם יתברך."
  },
  {
   "start": 157.09,
   "end": 160.79,
   "text": "ואבימלך אולי יזכה להיות שליח של השם יתברך."
  },
  {
   "start": 161.33,
   "end": 161.85,
   "text": "בינתיים,"
  },
  {
   "start": 162.33,
   "end": 163.65,
   "text": "בינתיים באזור שכם,"
  },
  {
   "start": 164.67,
   "end": 168.57,
   "text": "המערבים ששמים אנשי שכם בראשי הערים ממתינים לאבימלך,"
  },
  {
   "start": 168.89,
   "end": 169.73,
   "text": "שאולי ישוב,"
  },
  {
   "start": 171.03,
   "end": 172.07,
   "text": "ואז יוכלו לפגוע בו."
  },
  {
   "start": 172.49,
   "end": 173.65,
   "text": "בינתיים הם לא יכולים להתאפק."
  },
  {
   "start": 174.29,
   "end": 178.39,
   "text": "שכם, עיר ללא יראת שמיים, עיר מועדת לפורענות."
  },
  {
   "start": 179.27,
   "end": 181.09,
   "text": "הם מתחילים לגזול את העוברים ושבים."
  },
  {
   "start": 181.79,
   "end": 184.85,
   "text": "אומר הפסוק, ויגזלו את כל אשר יעבור עליהם בדרך."
  },
  {
   "start": 185.65,
   "end": 186.95,
   "text": "כל מי שעובר עליהם בדרך,"
  },
  {
   "start": 187.53,
   "end": 188.87,
   "text": "כל מי שנמצא באזור,"
  },
  {
   "start": 189.77,
   "end": 190.67,
   "text": "הם גוזלים אותו."
  },
  {
   "start": 195.45,
   "end": 195.91,
   "text": "שכם,"
  },
  {
   "start": 196.57,
   "end": 197.73,
   "text": "עיר של דמים,"
  },
  {
   "start": 198.27,
   "end": 200.77,
   "text": "גובה מחיר כבד מכל מי שמתקרד אליהם."
  },
  {
   "start": 201.71,
   "end": 205.71,
   "text": "חזל הקדושים למדו מהפסוק, ויגזלו את כל אשר יעבור עליהם בדרך,"
  },
  {
   "start": 206.39,
   "end": 210.11,
   "text": "מכאן שגזלן זה אדם שגוזל בגלוי,"
  },
  {
   "start": 210.63,
   "end": 211.49,
   "text": "לפני כולם,"
  },
  {
   "start": 211.89,
   "end": 216.37,
   "text": "וגנב זה שגונב בצנעה בסתם."
  },
  {
   "start": 220.83,
   "end": 226.17,
   "text": "המקאם, עמידה כנגד מיניה של ריבונו של עולם, המקאם האלוקי מתחיל לעבוד."
  },
  {
   "start": 226.61,
   "end": 229.27,
   "text": "אבימלך כל אותו זמן לא נמצא בכלל באזור."
  },
  {
   "start": 229.75,
   "end": 233.45,
   "text": "את ניהול העיר הוא השאיר בידי הפקיד הנאמן שלו,"
  },
  {
   "start": 233.79,
   "end": 236.27,
   "text": "העוזר הפרלמנטרי שלו, זבול."
  },
  {
   "start": 237.45,
   "end": 238.45,
   "text": "כך קוראים לו זבול."
  },
  {
   "start": 239.39,
   "end": 239.83,
   "text": "והנה,"
  },
  {
   "start": 240.47,
   "end": 241.51,
   "text": "אל שכם מגיע,"
  },
  {
   "start": 242.31,
   "end": 246.63,
   "text": "לכאורה במקרה אבל הקול מאיתו התברך אדם גוי,"
  },
  {
   "start": 247.19,
   "end": 249.21,
   "text": "געל בן עבד והאחים שלו."
  },
  {
   "start": 251.94,
   "end": 263.84,
   "text": "ואותו געל בן עבד רוצה לדבר, רוצה לנאום בפני אנשי העיר שכם ובנאום פוליטי מזהיר הוא משכנע את אנשי שכם שיבטחו בו."
  },
  {
   "start": 264.9,
   "end": 266.44,
   "text": "והוא דווקא נראה להם די מתאים."
  },
  {
   "start": 267.72,
   "end": 270.72,
   "text": "הוא נראה להם מתאים להנהיג אותם במקום אבימלך."
  },
  {
   "start": 271.62,
   "end": 272.9,
   "text": "נראה מוזר, לא הגיוני,"
  },
  {
   "start": 273.4,
   "end": 274.64,
   "text": "אדם שהם לא מכירים בכלל."
  },
  {
   "start": 275.3,
   "end": 279.52,
   "text": "איך הגיע וכבר הם רוחניים שהם חושבים שהוא זה שמתאים להנהיג אותם?"
  },
  {
   "start": 279.9,
   "end": 283.32,
   "text": "נראה מוזר, לא הגיוני, אולי לא יכול להתרחש בימינו."
  },
  {
   "start": 286.37,
   "end": 287.03,
   "text": "מי מכיר?"
  },
  {
   "start": 287.61,
   "end": 289.79,
   "text": "כשיש בתקופה שלנו בחירות,"
  },
  {
   "start": 290.25,
   "end": 294.71,
   "text": "מי באמת מכיר את המועמדים באמת? מי בחן את הכישורים שלהם?"
  },
  {
   "start": 295.77,
   "end": 298.65,
   "text": "כאשר לדוגמה שר הבריאות נבחר,"
  },
  {
   "start": 299.01,
   "end": 301.63,
   "text": "האם מישהו בדק את כישוריו בתחום הרפואה?"
  },
  {
   "start": 302.53,
   "end": 303.41,
   "text": "אף אחד לא יודע,"
  },
  {
   "start": 304.11,
   "end": 305.35,
   "text": "ואף אחד אולי לא מתעניין."
  },
  {
   "start": 306.57,
   "end": 308.51,
   "text": "כך היום וכך גם אז."
  },
  {
   "start": 309.79,
   "end": 314.21,
   "text": "וגעל, געל פונה אל האינטרסים,"
  },
  {
   "start": 314.73,
   "end": 319.14,
   "text": "אל הרגשות של אנשי שכם, ואומר להם, תגידו לי,"
  },
  {
   "start": 319.98,
   "end": 324.4,
   "text": "אם, אם אבימלך וזבול הפקיד שלו באו לשכם, אז"
  },
  {
   "start": 325.24,
   "end": 327.74,
   "text": "מן ההיגיון שהם יהיו תחת אנשי שכם,"
  },
  {
   "start": 328.64,
   "end": 331.28,
   "text": "למה אתם, אנשי שכם החשובים, כל כך נהיים תחתם?"
  },
  {
   "start": 333.24,
   "end": 334.4,
   "text": "וגעל בן עבד אומר,"
  },
  {
   "start": 334.88,
   "end": 336.9,
   "text": "אומר לאנשי שכם, עיר כל כך חשובה,"
  },
  {
   "start": 337.34,
   "end": 339.38,
   "text": "עיר כל כך יוקרתית כשכם,"
  },
  {
   "start": 339.88,
   "end": 343.0,
   "text": "לא ראוי שאדם שפל ימשול בה. זה לא מתאים,"
  },
  {
   "start": 344.1,
   "end": 344.6,
   "text": "זה לא מתאים."
  },
  {
   "start": 347.37,
   "end": 349.07,
   "text": "ובאבימלך מתקיימת המשנה,"
  },
  {
   "start": 349.73,
   "end": 351.67,
   "text": "כל הרודף אחר הכבוד,"
  },
  {
   "start": 352.37,
   "end": 353.55,
   "text": "הכבוד בורח ממנו."
  },
  {
   "start": 354.71,
   "end": 356.57,
   "text": "כל אחד שרודף אחרי הכבוד כמו אבימלך,"
  },
  {
   "start": 357.21,
   "end": 359.07,
   "text": "למעשה הכבוד בורח."
  },
  {
   "start": 361.09,
   "end": 362.07,
   "text": "במהירות הבזק,"
  },
  {
   "start": 362.69,
   "end": 364.67,
   "text": "אנשי שכם מבזים אותו,"
  },
  {
   "start": 365.41,
   "end": 366.29,
   "text": "לא רוצים אותו."
  },
  {
   "start": 368.56,
   "end": 370.72,
   "text": "בינתיים געל ממשיך בנאום הפוליטי המזהיר,"
  },
  {
   "start": 371.22,
   "end": 373.48,
   "text": "והוא אומר, אם הייתה לי אפשרות, אני הייתי מסלק אותו."
  },
  {
   "start": 374.54,
   "end": 374.92,
   "text": "ואז,"
  },
  {
   "start": 375.44,
   "end": 377.54,
   "text": "ואז כמו כל פוליטיקאי מזהיר,"
  },
  {
   "start": 377.86,
   "end": 378.82,
   "text": "הוא קורא לאבימלך,"
  },
  {
   "start": 379.08,
   "end": 380.28,
   "text": "מעל במת הנואמים,"
  },
  {
   "start": 380.62,
   "end": 382.56,
   "text": "לגייס חיילים רבים לצבאו,"
  },
  {
   "start": 382.98,
   "end": 385.28,
   "text": "ולצאת מול געל בן עבד."
  },
  {
   "start": 387.25,
   "end": 389.31,
   "text": "ועיר שכם צהלה ושמחה."
  },
  {
   "start": 389.69,
   "end": 390.37,
   "text": "סוף סוף,"
  },
  {
   "start": 391.49,
   "end": 393.27,
   "text": "סוף סוף הם יכולים להישען על מישהו,"
  },
  {
   "start": 393.71,
   "end": 395.07,
   "text": "על פוליטיקאי חדש,"
  },
  {
   "start": 395.45,
   "end": 399.17,
   "text": "על מלך חדש, אותה עיר דמים, אותה עיר מועדת לפורענות,"
  },
  {
   "start": 399.69,
   "end": 404.53,
   "text": "היא יכולה להחליף בן רגע מלך כל יום והכוכב שלו,"
  },
  {
   "start": 405.55,
   "end": 407.21,
   "text": "כל יום כוכב חדש נולד."
  },
  {
   "start": 410.82,
   "end": 416.46,
   "text": "העיר שכם יוצאת לחגוג סוף סוף את פציר הענבים. עד עכשיו הם חששו, חששו מאבי מלך,"
  },
  {
   "start": 416.98,
   "end": 419.48,
   "text": "אבל עכשיו, עכשיו שהמרד בפרהסיה,"
  },
  {
   "start": 420.5,
   "end": 424.8,
   "text": "הם יכולים ללכת ולחגוג את פציר הענבים במשתה,"
  },
  {
   "start": 425.24,
   "end": 427.6,
   "text": "ושם אפילו העזו לקלל אותו."
  },
  {
   "start": 427.6,
   "end": 433.8,
   "text": "בשכם כמעט כולם חוברים יחדיו כנגד אבימלך,"
  },
  {
   "start": 434.38,
   "end": 435.96,
   "text": "למעט זבול,"
  },
  {
   "start": 436.42,
   "end": 437.86,
   "text": "זבול עוזו הפרלמנטרי,"
  },
  {
   "start": 438.58,
   "end": 440.92,
   "text": "זבול הפקיד של אבימלך,"
  },
  {
   "start": 441.44,
   "end": 443.48,
   "text": "שגם הוא מאוים על ידי געל."
  },
  {
   "start": 445.14,
   "end": 450.98,
   "text": "כלפי חוץ מראה שהוא תומך במשאל עם שנעשה בשכם, בדעת קהל,"
  },
  {
   "start": 451.7,
   "end": 457.42,
   "text": "אבל בפנים זבול זועם על המהפך ושולח לאבימלך,"
  },
  {
   "start": 457.96,
   "end": 461.52,
   "text": "דרך סוכני המודיעין שלו, מידע על המתרחש."
  },
  {
   "start": 463.78,
   "end": 465.06,
   "text": "ולא רק זה, הוא גם מציע לו,"
  },
  {
   "start": 465.58,
   "end": 467.98,
   "text": "תבוא בלילה, תארוב בשדה,"
  },
  {
   "start": 468.58,
   "end": 469.64,
   "text": "רחוק מן העיר,"
  },
  {
   "start": 470.82,
   "end": 472.96,
   "text": "ואז השכם בבוקר,"
  },
  {
   "start": 473.84,
   "end": 479.55,
   "text": "אחרי שארבת בלילה בשדה, השכם בבוקר,"
  },
  {
   "start": 480.03,
   "end": 482.61,
   "text": "תוכל לפשוט על העיר מהמערב,"
  },
  {
   "start": 482.99,
   "end": 489.46,
   "text": "תוכל לנצל את גורם ההפתעה ולגרוף לך ניצחון מהיר,"
  },
  {
   "start": 489.78,
   "end": 492.12,
   "text": "כך השדר שמעביר זבול."
  },
  {
   "start": 492.48,
   "end": 499.22,
   "text": "אבימלך, אבימלך שסומך על עצמו בלבד,"
  },
  {
   "start": 500.44,
   "end": 501.86,
   "text": "אכן מקבל את ההצעה."
  },
  {
   "start": 503.08,
   "end": 512.2,
   "text": "הוא לוקח את הצבא שלו ומחלק את הצבא לארבעה ראשים שיערבו מארבע רוחות השמיים לאנשי שכם."
  },
  {
   "start": 514.53,
   "end": 519.73,
   "text": "אבל גם בשכם יש שם איש שגם הוא לא סומך על אף אחד,"
  },
  {
   "start": 520.59,
   "end": 521.63,
   "text": "געל בן עבד."
  },
  {
   "start": 523.96,
   "end": 525.22,
   "text": "הוא חש את המתח באוויר,"
  },
  {
   "start": 525.92,
   "end": 529.5,
   "text": "הוא יוצא אל פתח העיר שכם ומביט סביבות העיר."
  },
  {
   "start": 530.24,
   "end": 533.04,
   "text": "יש לו חשש גדול ממערב, משהו,"
  },
  {
   "start": 533.62,
   "end": 535.98,
   "text": "משהו בלב מנבל הוראות."
  },
  {
   "start": 537.38,
   "end": 539.9,
   "text": "והמתיחות באזור הולכת וגדלה,"
  },
  {
   "start": 540.42,
   "end": 542.62,
   "text": "כי כולם מצפים לעימות,"
  },
  {
   "start": 543.12,
   "end": 547.08,
   "text": "העימות הצפוי כל כך בין אבימלך לגעל בן עבד."
  },
  {
   "start": 550.12,
   "end": 554.02,
   "text": "שם בפתח העיר שכם, יחד עם געל, נמצא גם זבול."
  },
  {
   "start": 555.14,
   "end": 557.14,
   "text": "געל בן עבד מתבונן אל ההרים שממול,"
  },
  {
   "start": 557.98,
   "end": 558.3,
   "text": "לפתע,"
  },
  {
   "start": 559.2,
   "end": 560.98,
   "text": "לפתע הוא רואה שם דמויות,"
  },
  {
   "start": 562.4,
   "end": 566.5,
   "text": "דמויות יורדות מראשי הערים, צללים, צללים של אנשים."
  },
  {
   "start": 567.7,
   "end": 570.0,
   "text": "אבל הראות כל כך קשה, האם אני טועה?"
  },
  {
   "start": 570.84,
   "end": 571.56,
   "text": "האם זה דמיון"
  },
  {
   "start": 572.74,
   "end": 573.56,
   "text": "או מציאות?"
  },
  {
   "start": 574.9,
   "end": 577.28,
   "text": "וגעל פונה אל זבול, תגיד לי, אתה רואה משהו?"
  },
  {
   "start": 578.68,
   "end": 581.82,
   "text": "זבול, אתה שם לב, אתה רואה שם את הדמויות, את הצללים?"
  },
  {
   "start": 582.62,
   "end": 583.6,
   "text": "וזבול אומר לו,"
  },
  {
   "start": 584.4,
   "end": 587.14,
   "text": "געל בן עבד, כנראה אתה כל כך מפחד,"
  },
  {
   "start": 587.8,
   "end": 590.06,
   "text": "שאתה רואה את צל ההרים כאנשים."
  },
  {
   "start": 591.36,
   "end": 592.86,
   "text": "אתה רואה את צל ההרים כאנשים."
  },
  {
   "start": 593.56,
   "end": 594.84,
   "text": "עד כך אתה מפחד?"
  },
  {
   "start": 596.66,
   "end": 598.92,
   "text": "התחלת לראות את צל ההרים כאנשים,"
  },
  {
   "start": 599.68,
   "end": 602.44,
   "text": "אבל געל עדיין לא נרגע."
  },
  {
   "start": 607.54,
   "end": 608.64,
   "text": "הנה הם, תסתכל טוב,"
  },
  {
   "start": 608.98,
   "end": 610.7,
   "text": "הם יורדים מהר הגבוה שממול,"
  },
  {
   "start": 611.04,
   "end": 614.7,
   "text": "וגם חלק באים מדרך העמק, דרך אלון מעוננים. תסתכל טוב."
  },
  {
   "start": 616.26,
   "end": 617.28,
   "text": "הם ממש קרובים."
  },
  {
   "start": 618.52,
   "end": 619.1,
   "text": "ואז זבול"
  },
  {
   "start": 620.8,
   "end": 622.0,
   "text": "מגחך ואומר לו,"
  },
  {
   "start": 622.46,
   "end": 623.54,
   "text": "כנראה שאתה צודק,"
  },
  {
   "start": 624.64,
   "end": 625.32,
   "text": "אבל בעצם,"
  },
  {
   "start": 626.2,
   "end": 630.44,
   "text": "הרי דיברת והצהרת כל כך הרבה הצהרות מי אבימלך כנעבדנו."
  },
  {
   "start": 632.69,
   "end": 634.37,
   "text": "הלא זה העם אשר מאסת בו."
  },
  {
   "start": 635.53,
   "end": 638.27,
   "text": "צאנה אתה ויילחם בו."
  },
  {
   "start": 644.6,
   "end": 645.38,
   "text": "אבימלך,"
  },
  {
   "start": 646.64,
   "end": 648.44,
   "text": "אדם של כוכי ועוצם ידי,"
  },
  {
   "start": 649.16,
   "end": 649.92,
   "text": "של פוליטיקה,"
  },
  {
   "start": 650.38,
   "end": 651.4,
   "text": "של הכל תלוי בי,"
  },
  {
   "start": 651.74,
   "end": 652.94,
   "text": "של הכל תחת שליטה,"
  },
  {
   "start": 653.52,
   "end": 656.44,
   "text": "של רק אין יראת אלוקים."
  },
  {
   "start": 657.1,
   "end": 657.98,
   "text": "גל בן עבד,"
  },
  {
   "start": 658.9,
   "end": 659.26,
   "text": "גוי,"
  },
  {
   "start": 660.38,
   "end": 671.0,
   "text": "פוליטיקאי מזהיר, רק אין יראת אלוקים זבול עוזר"
  },
  {
   "start": 672.2,
   "end": 675.6,
   "text": "הכל תלוי בי, הכל תחת שליטה, כוכי ועוצם ידי,"
  },
  {
   "start": 676.34,
   "end": 678.44,
   "text": "רק אין יראת אלוקים"
  },
  {
   "start": 679.96,
   "end": 682.56,
   "text": "הכל תלוי בי, הכל תחת שליטה."
  },
  {
   "start": 683.3,
   "end": 687.28,
   "text": "נדמה עכשיו שאולי לאף אחד אין לי שליטה"
  },
  {
   "start": 688.04,
   "end": 690.1,
   "text": "וכבר שום דבר לא תלוי בהם."
  },
  {
   "start": 690.88,
   "end": 694.34,
   "text": "געל בן עבד יוצא להילחם באבימלך."
  },
  {
   "start": 695.38,
   "end": 697.92,
   "text": "הם נפגשים בקרב קשה,"
  },
  {
   "start": 698.3,
   "end": 699.38,
   "text": "קרב אכזרי,"
  },
  {
   "start": 699.8,
   "end": 700.6,
   "text": "בו רבים,"
  },
  {
   "start": 701.04,
   "end": 702.96,
   "text": "רבים נהרגים משני המחנות,"
  },
  {
   "start": 703.28,
   "end": 707.04,
   "text": "רבים מבחורי ישראל נהרגים מקפחים את חייהם,"
  },
  {
   "start": 709.17,
   "end": 713.91,
   "text": "וגעל בן עבד ואנשיו ניגפים לפני אבימלך."
  },
  {
   "start": 718.53,
   "end": 719.05,
   "text": "אבימלך"
  },
  {
   "start": 719.67,
   "end": 720.47,
   "text": "יושב ברומא."
  },
  {
   "start": 721.43,
   "end": 723.09,
   "text": "לעת עתה הוא נח מן הקרב,"
  },
  {
   "start": 725.47,
   "end": 727.75,
   "text": "ובזמן הזה גל בן עבד מנסה בכל אופן."
  },
  {
   "start": 728.23,
   "end": 730.33,
   "text": "עדיין הוא לא מתייאש, עדיין יש לו שאיפות."
  },
  {
   "start": 731.59,
   "end": 733.53,
   "text": "מנסה לחזור לשכם עם האחים שלו,"
  },
  {
   "start": 734.13,
   "end": 736.79,
   "text": "אבל אז הוא מגורש משם על ידי זבול."
  },
  {
   "start": 738.85,
   "end": 742.35,
   "text": "אחרי הכישלון בקרב לא מעוניינים בו אנשי שכם."
  },
  {
   "start": 743.19,
   "end": 746.27,
   "text": "אנחנו רוצים רק אנשים שיש לנו אינטרס,"
  },
  {
   "start": 749.66,
   "end": 751.54,
   "text": "רק אין יראת אלוקים במקום הזה."
  },
  {
   "start": 752.3,
   "end": 756.1,
   "text": "עיר שכם, עיר של דמים, עיר של פורענות,"
  },
  {
   "start": 757.38,
   "end": 759.22,
   "text": "והפוליטיקאי המזהיר, הלוחם,"
  },
  {
   "start": 759.54,
   "end": 760.42,
   "text": "כוכי ראש צמדי,"
  },
  {
   "start": 760.56,
   "end": 761.42,
   "text": "גאל בן עבד,"
  },
  {
   "start": 761.76,
   "end": 766.66,
   "text": "נעלם לעד מעל במת ההיסטוריה."
  },
  {
   "start": 767.9,
   "end": 768.58,
   "text": "למחרת,"
  },
  {
   "start": 769.48,
   "end": 771.38,
   "text": "למחרת יוצאים מהעיר שכם אנשים,"
  },
  {
   "start": 772.4,
   "end": 775.76,
   "text": "אחרי ששמעו שנפלו גם רבים מחיילי אבימלך,"
  },
  {
   "start": 776.32,
   "end": 779.04,
   "text": "הם אמרו אולי סוף סוף אנחנו נוכל להכות אותו,"
  },
  {
   "start": 779.58,
   "end": 781.64,
   "text": "לנצח אותו בכוחותינו אנו."
  },
  {
   "start": 783.3,
   "end": 785.14,
   "text": "אנשי המודיעין מדווחים לאבימלך."
  },
  {
   "start": 786.2,
   "end": 788.54,
   "text": "אבימלך מזדרז, מקים מערבים,"
  },
  {
   "start": 789.58,
   "end": 791.94,
   "text": "מכל הכיוונים, מארבע רוחות השמיים."
  },
  {
   "start": 792.76,
   "end": 796.82,
   "text": "ואנשי שכם שפוסעים ישירות אל המלכודות של אבימלך,"
  },
  {
   "start": 797.16,
   "end": 798.0,
   "text": "בלי נסיעים,"
  },
  {
   "start": 798.92,
   "end": 799.58,
   "text": "לפתע קמים,"
  },
  {
   "start": 800.66,
   "end": 801.76,
   "text": "קמים חיילים ממערב,"
  },
  {
   "start": 802.1,
   "end": 804.22,
   "text": "חיילי אבימלך, ותוקפים אותם מכל הכיוונים,"
  },
  {
   "start": 804.58,
   "end": 805.44,
   "text": "בכל החזיתות."
  },
  {
   "start": 806.04,
   "end": 808.3,
   "text": "אנשי שכם משיבים מלחמה שערה,"
  },
  {
   "start": 808.94,
   "end": 811.38,
   "text": "ואבימלך נלחם עימהם כל היום,"
  },
  {
   "start": 811.82,
   "end": 812.74,
   "text": "כל היום מלחמה,"
  },
  {
   "start": 813.1,
   "end": 814.5,
   "text": "כל היום שפיכות דמים,"
  },
  {
   "start": 814.84,
   "end": 821.12,
   "text": "ממחלוקות כולם סובלים, כשאין יראת אלוקים כולם סובלים, זה עניין של זמן."
  },
  {
   "start": 821.5,
   "end": 824.18,
   "text": "והזמן הגיע, זמן התשלום הגיע."
  },
  {
   "start": 825.8,
   "end": 833.32,
   "text": "וכך אבימלך והאנשי שלכם נלחמים זה בזה עד שאחר קרב מתיש, קרב בעל קורבנות כל כך רבים,"
  },
  {
   "start": 833.76,
   "end": 834.84,
   "text": "אבימלך סוף-סוף"
  },
  {
   "start": 835.92,
   "end": 836.92,
   "text": "לוכד את העיר."
  },
  {
   "start": 836.92,
   "end": 844.54,
   "text": "הוא אבי מלך, אבי מלך שפתאום שום דבר לא עובד לפי התכנון שלו."
  },
  {
   "start": 845.82,
   "end": 850.08,
   "text": "לפתע בעצם יש איזו יד עליונה שמשחקת איתו."
  },
  {
   "start": 850.74,
   "end": 853.2,
   "text": "הוא זועם כל כך, הוא מרגיש שהוא מאבד שליטה."
  },
  {
   "start": 853.66,
   "end": 858.08,
   "text": "אדם שכל החיים שלו היו פרי התכנון שלו,"
  },
  {
   "start": 858.42,
   "end": 860.78,
   "text": "כוכי ועוצם ידי, אני יכול לעשות הכל."
  },
  {
   "start": 862.22,
   "end": 866.0,
   "text": "כאשר הוא מאבד שליטה, הוא מתחיל לזעום."
  },
  {
   "start": 866.76,
   "end": 867.3,
   "text": "הוא זועם,"
  },
  {
   "start": 867.68,
   "end": 868.6,
   "text": "ומרוב זעם,"
  },
  {
   "start": 868.9,
   "end": 869.92,
   "text": "מרוב תסכול,"
  },
  {
   "start": 870.24,
   "end": 874.14,
   "text": "הוא הורג את כל אנשי שכם באכזריות,"
  },
  {
   "start": 874.68,
   "end": 876.0,
   "text": "ללא החמים."
  },
  {
   "start": 876.58,
   "end": 877.22,
   "text": "ולא רק זה,"
  },
  {
   "start": 877.68,
   "end": 878.38,
   "text": "הוא ממשיך,"
  },
  {
   "start": 878.8,
   "end": 884.18,
   "text": "שובר ומנתץ את כל בתיה של העיר שהמליכה אותו."
  },
  {
   "start": 885.16,
   "end": 886.08,
   "text": "ולא רק זה,"
  },
  {
   "start": 887.54,
   "end": 891.4,
   "text": "אלא הוא גם זורע מלח באדמה שלה,"
  },
  {
   "start": 892.08,
   "end": 893.46,
   "text": "שלא תעלה יבול."
  },
  {
   "start": 896.48,
   "end": 897.26,
   "text": "בורא עולם,"
  },
  {
   "start": 898.26,
   "end": 906.46,
   "text": "למעשה שולח את אבימלך לנקום בעיר שכם על כל מה שהם עשו,"
  },
  {
   "start": 906.94,
   "end": 907.84,
   "text": "על כך שהיא עיר,"
  },
  {
   "start": 908.16,
   "end": 910.3,
   "text": "עיר מועדת לפורענות, עיר של דמים,"
  },
  {
   "start": 910.7,
   "end": 912.6,
   "text": "רק אין עירת אלוקים במקום הזה."
  },
  {
   "start": 913.7,
   "end": 915.38,
   "text": "נידה כנגד נידה לשכם."
  },
  {
   "start": 915.84,
   "end": 921.02,
   "text": "אתם שמחתם כשאבימלך רצח שבעים מהבנים שלי."
  },
  {
   "start": 922.18,
   "end": 923.28,
   "text": "אתם המלכתם אותו."
  },
  {
   "start": 925.38,
   "end": 928.78,
   "text": "אתם זוכרים את משל האתד של יותם?"
  },
  {
   "start": 932.13,
   "end": 935.95,
   "text": "הנה קם האתד והורג את מי שהמליך אותו."
  },
  {
   "start": 938.04,
   "end": 939.14,
   "text": "אבל זה עדיין לא נגמר."
  },
  {
   "start": 939.76,
   "end": 944.14,
   "text": "נכבדי שכם, אלו שבפועל הם שהמליכו את אבימלך."
  },
  {
   "start": 944.82,
   "end": 947.18,
   "text": "הם הנקראים בעלי מגדל שכם,"
  },
  {
   "start": 947.64,
   "end": 949.28,
   "text": "הם לא היו בעיר באותו זמן."
  },
  {
   "start": 950.24,
   "end": 951.3,
   "text": "וכשהם שמעו,"
  },
  {
   "start": 951.82,
   "end": 954.94,
   "text": "כשנודע להם על הזוועה, נודע להם מה קרה,"
  },
  {
   "start": 955.56,
   "end": 957.22,
   "text": "הם באו לצריח בית אל."
  },
  {
   "start": 957.88,
   "end": 959.56,
   "text": "זה היה בית העבודה הזרה שלהם,"
  },
  {
   "start": 960.0,
   "end": 962.66,
   "text": "שהיה נמצא בלב יער מוקף עצים,"
  },
  {
   "start": 963.08,
   "end": 965.4,
   "text": "שכמעט אי אפשר היה לגשת לשם."
  },
  {
   "start": 966.26,
   "end": 968.54,
   "text": "זה היה סבך עצים כמעט בלתי עביר,"
  },
  {
   "start": 969.04,
   "end": 970.34,
   "text": "ושם הם מתקבצים."
  },
  {
   "start": 971.84,
   "end": 974.68,
   "text": "אבל סוכני המודיעין של אבימלך"
  },
  {
   "start": 975.6,
   "end": 977.2,
   "text": "עושים את עבודתם נאמנה,"
  },
  {
   "start": 977.7,
   "end": 978.1,
   "text": "הם לא מאכזבים,"
  },
  {
   "start": 979.02,
   "end": 979.84,
   "text": "ומודיעים לו,"
  },
  {
   "start": 980.22,
   "end": 983.9,
   "text": "מודיעים לו בדיוק היכן נמצאים בעלי מגדל שכם."
  },
  {
   "start": 984.84,
   "end": 988.84,
   "text": "אבימלך מארגן את הצבא שלו ללא היסוס."
  },
  {
   "start": 989.84,
   "end": 991.86,
   "text": "ולפני שהם יוצאים לדרך הוא מצייד אותם"
  },
  {
   "start": 992.4,
   "end": 994.34,
   "text": "בכלי נשק אולי קצת חריגים שונים."
  },
  {
   "start": 994.8,
   "end": 996.02,
   "text": "הוא מצייד אותם בגרזינים."
  },
  {
   "start": 997.62,
   "end": 1001.78,
   "text": "ואחרי זה הוא לוקח וכורת לו ענפים ולוקח איתו,"
  },
  {
   "start": 1002.42,
   "end": 1006.24,
   "text": "והוא מורה לכולם, כל חייל יעשה בדיוק כמוני."
  },
  {
   "start": 1006.78,
   "end": 1010.2,
   "text": "וכך הם מגיעים לאותו צריח בית אל,"
  },
  {
   "start": 1010.56,
   "end": 1011.66,
   "text": "אותו בית עבודה זרה."
  },
  {
   "start": 1012.28,
   "end": 1015.48,
   "text": "שם את כל הענפים הם שמים על הצריח."
  },
  {
   "start": 1016.5,
   "end": 1019.64,
   "text": "ואבימלך, בטקס מחריד,"
  },
  {
   "start": 1020.34,
   "end": 1021.24,
   "text": "מדליק לפיד,"
  },
  {
   "start": 1021.68,
   "end": 1024.04,
   "text": "ובאמצעות הלפיד הוא שורף,"
  },
  {
   "start": 1024.64,
   "end": 1026.1,
   "text": "שורף את כל הענפים באש,"
  },
  {
   "start": 1026.7,
   "end": 1027.9,
   "text": "שורף את כל הצריח,"
  },
  {
   "start": 1029.6,
   "end": 1033.68,
   "text": "שבפנים מתחבאים להם אלף איש ואישה,"
  },
  {
   "start": 1034.44,
   "end": 1037.2,
   "text": "שנשרפים כולם למוות."
  },
  {
   "start": 1038.78,
   "end": 1039.72,
   "text": "בעלי שכם,"
  },
  {
   "start": 1040.3,
   "end": 1043.62,
   "text": "אתם בעלי שכם שבאתם לחסות בצלע עתד,"
  },
  {
   "start": 1044.44,
   "end": 1046.18,
   "text": "התקיימה קללת יותם."
  },
  {
   "start": 1047.0,
   "end": 1047.74,
   "text": "אומר יותם,"
  },
  {
   "start": 1048.54,
   "end": 1049.6,
   "text": "במשל יותם,"
  },
  {
   "start": 1050.36,
   "end": 1051.1,
   "text": "ואם אין,"
  },
  {
   "start": 1051.62,
   "end": 1053.26,
   "text": "תצא אש מאבי מלך,"
  },
  {
   "start": 1053.7,
   "end": 1056.68,
   "text": "ותאכל את בעלי שכם ואת בית מילו."
  },
  {
   "start": 1057.34,
   "end": 1058.06,
   "text": "אומר יותם,"
  },
  {
   "start": 1058.68,
   "end": 1061.1,
   "text": "אומר יותם, במשל יותם, לאנשי שכם,"
  },
  {
   "start": 1061.58,
   "end": 1063.14,
   "text": "אם באמת ובתמים עשיתם,"
  },
  {
   "start": 1063.78,
   "end": 1065.9,
   "text": "התכוונתם לטובה באמת עם גדעון,"
  },
  {
   "start": 1066.52,
   "end": 1067.06,
   "text": "אז אולי,"
  },
  {
   "start": 1067.58,
   "end": 1069.16,
   "text": "אולי אתם יכולים לשמוח."
  },
  {
   "start": 1070.06,
   "end": 1075.82,
   "text": "אבל מאחר שהרגתם את הבנים של גדעון זה לא נראה כל כך הטבה,"
  },
  {
   "start": 1076.16,
   "end": 1077.56,
   "text": "הכרת הטוב לגדעון."
  },
  {
   "start": 1078.16,
   "end": 1079.6,
   "text": "לכן הוא אומר, ואם אין,"
  },
  {
   "start": 1080.12,
   "end": 1080.98,
   "text": "ואם זה לא ככה,"
  },
  {
   "start": 1081.48,
   "end": 1085.22,
   "text": "תצא אש מאבימלך ותאכל את בעלי שכם."
  },
  {
   "start": 1087.2,
   "end": 1087.44,
   "text": "אבל,"
  },
  {
   "start": 1087.88,
   "end": 1088.78,
   "text": "אבל זה עדיין לא נגמר,"
  },
  {
   "start": 1089.4,
   "end": 1091.48,
   "text": "כי יותם ממשיך ואומר,"
  },
  {
   "start": 1091.86,
   "end": 1097.76,
   "text": "ותצא אש מבעלי שכם ותאכל את אבימלך."
  },
  {
   "start": 1101.12,
   "end": 1105.62,
   "text": "משל יותם תצא אשמה אבימלך ותאכל בעלי שכם מתקיימת לה."
  },
  {
   "start": 1106.36,
   "end": 1108.98,
   "text": "סופה של העיר שכם נהרגו כולם,"
  },
  {
   "start": 1109.5,
   "end": 1110.54,
   "text": "העיר נחרבה,"
  },
  {
   "start": 1110.92,
   "end": 1115.34,
   "text": "האדמה נהפכה עקרה ונכבדיהם נשרפו באש."
  },
  {
   "start": 1116.08,
   "end": 1118.42,
   "text": "זהו מחיר צילו של האתד."
  },
  {
   "start": 1120.3,
   "end": 1131.87,
   "text": "החלק השני עדיין עדיין לא התקיים אבל בואו ונמשיך ואבימלך,"
  },
  {
   "start": 1132.71,
   "end": 1134.23,
   "text": "אבימלך הוא לא חש עדיין."
  },
  {
   "start": 1135.45,
   "end": 1139.91,
   "text": "או אולי הוא חש אבל עדיין לא מבין ממש שהוא בובה של השם נדבריו,"
  },
  {
   "start": 1140.77,
   "end": 1143.13,
   "text": "שהוא בסך הכל מונהג בידי ההשגחה האלוקית,"
  },
  {
   "start": 1143.75,
   "end": 1145.95,
   "text": "עדיין הוא חי בדמיון של כוכי ועוצם ידי."
  },
  {
   "start": 1147.37,
   "end": 1148.57,
   "text": "אז הוא פונה אל העיר טבץ,"
  },
  {
   "start": 1149.59,
   "end": 1151.95,
   "text": "עיר סמוכה שגם תושביה מרדו בו,"
  },
  {
   "start": 1153.87,
   "end": 1156.49,
   "text": "ושם הוא פושט על העיר ולוכד אותה."
  },
  {
   "start": 1157.71,
   "end": 1161.07,
   "text": "בעיר טבץ היה מגדל חזק מאוד, מגדל"
  },
  {
   "start": 1162.15,
   "end": 1163.05,
   "text": "לעבודה זרה."
  },
  {
   "start": 1164.03,
   "end": 1169.43,
   "text": "אם נשים לב, הגויים כל הזמן עושים מגדל, דברים בולטים, לכאורה לכרות תגר כלפי מלכות שמיים,"
  },
  {
   "start": 1169.83,
   "end": 1171.53,
   "text": "וזה המשמש אותם לעבודה זרה."
  },
  {
   "start": 1171.87,
   "end": 1174.55,
   "text": "גם לעיר טווץ יש מגדל, מגדל עוז,"
  },
  {
   "start": 1174.95,
   "end": 1176.21,
   "text": "ככה קוראים למגדל."
  },
  {
   "start": 1177.59,
   "end": 1177.91,
   "text": "לשם,"
  },
  {
   "start": 1178.33,
   "end": 1183.35,
   "text": "לשם בורחים תושבי טווץ מאימת אבינלך, הם מפחדים מאבינלך, הם יודעים כמו אכזרי,"
  },
  {
   "start": 1183.67,
   "end": 1186.31,
   "text": "הם שמעו את הזוועות שהוא חולל בשכם."
  },
  {
   "start": 1187.25,
   "end": 1192.09,
   "text": "וכשהם נכנסו למגדל עוז, הם סוגרים את השערים כך שאי אפשר להיכנס."
  },
  {
   "start": 1193.67,
   "end": 1196.79,
   "text": "ואבימלך, אבימלך, הוא פונה אל המגדל."
  },
  {
   "start": 1200.32,
   "end": 1202.7,
   "text": "שום דבר לא יכול לעמוד בפניו, כך הוא חושב."
  },
  {
   "start": 1203.14,
   "end": 1207.42,
   "text": "הוא לא שם לב שהוא למעשה שליח של השם לביאור עבודה זרה מהארץ."
  },
  {
   "start": 1208.02,
   "end": 1209.38,
   "text": "כמו המן בשעתו,"
  },
  {
   "start": 1209.8,
   "end": 1212.28,
   "text": "שכשהוא נתלה הוא קידש שם שמיים,"
  },
  {
   "start": 1212.66,
   "end": 1215.54,
   "text": "הוא קירב את הלבבות של כל עם ישראל אחד לשני."
  },
  {
   "start": 1215.94,
   "end": 1217.96,
   "text": "ככה אבימלך, בלי לשים לב,"
  },
  {
   "start": 1218.28,
   "end": 1224.34,
   "text": "משמש כשוט של השם יתברך לבער את העבודה הזרה מארץ הקודש."
  },
  {
   "start": 1224.34,
   "end": 1229.3,
   "text": "ונשל יותם, הקללה של יותם עדיין תלויה"
  },
  {
   "start": 1229.3,
   "end": 1235.16,
   "text": "ותצא אש מבעלי שכם ומבית מילו ותאכל את אבימלך."
  },
  {
   "start": 1236.3,
   "end": 1237.94,
   "text": "אבימלך פונה אל המגדל,"
  },
  {
   "start": 1238.52,
   "end": 1246.28,
   "text": "אבימלך והצבא שלו מנסים להילחם, מנסים לנתץ, לשבור את המגדל,"
  },
  {
   "start": 1246.62,
   "end": 1247.72,
   "text": "אבל המגדל חזק,"
  },
  {
   "start": 1248.66,
   "end": 1251.18,
   "text": "אבל אבימלך גם הוא לא מוותר,"
  },
  {
   "start": 1251.5,
   "end": 1252.96,
   "text": "איזה כוח מושך אותו,"
  },
  {
   "start": 1253.24,
   "end": 1256.06,
   "text": "כוח פנימי מושך אותו, לנסות,"
  },
  {
   "start": 1256.66,
   "end": 1258.7,
   "text": "לנסות גם את המגדל הזה לשרוף באש."
  },
  {
   "start": 1259.08,
   "end": 1264.62,
   "text": "ואז הוא פונה בראש לוחמיו אל פתח המגדל על מנת לשרוף אותו באש."
  },
  {
   "start": 1266.54,
   "end": 1267.22,
   "text": "ושם,"
  },
  {
   "start": 1267.9,
   "end": 1268.76,
   "text": "שם למעלה,"
  },
  {
   "start": 1270.0,
   "end": 1273.18,
   "text": "בגג המגדל עמדה לה אישה,"
  },
  {
   "start": 1276.2,
   "end": 1276.88,
   "text": "ואם היא בתה,"
  },
  {
   "start": 1277.66,
   "end": 1283.4,
   "text": "היא רואה את אבימלך בראש אנשיו מתקרבים אל המגדל שם למטה."
  },
  {
   "start": 1284.32,
   "end": 1290.9,
   "text": "אותה אישה התכופפה והרימה אבן רחיים."
  },
  {
   "start": 1291.42,
   "end": 1292.66,
   "text": "פלח רכב."
  },
  {
   "start": 1292.98,
   "end": 1295.26,
   "text": "פלח רכב זה אבן הרחיים העליונה."
  },
  {
   "start": 1295.78,
   "end": 1298.92,
   "text": "יש אבן רחיים תחתונה ואבן רחיים עליונה."
  },
  {
   "start": 1300.16,
   "end": 1302.94,
   "text": "היא לקחה את האבן רחיים והשליכה מטה,"
  },
  {
   "start": 1306.4,
   "end": 1309.9,
   "text": "והאבן עושה את כל הדרך הישר אל ראש אבי מלך."
  },
  {
   "start": 1310.58,
   "end": 1314.47,
   "text": "מרוצצת את ראשו, הוא נופל,"
  },
  {
   "start": 1315.23,
   "end": 1319.91,
   "text": "שותת דם, אבל עדיין לא מת."
  },
  {
   "start": 1322.16,
   "end": 1325.86,
   "text": "אבימלך, כוכי ועוצם ידי, אבן אחת."
  },
  {
   "start": 1327.38,
   "end": 1334.98,
   "text": "והוא כבר שוכב על הרצפה כשנותרו לו מספר דקות של חיים."
  },
  {
   "start": 1335.96,
   "end": 1340.42,
   "text": "אבימלך, אבימלך שהרג את האחים שלו על אבן אחת."
  },
  {
   "start": 1341.1,
   "end": 1343.92,
   "text": "אמר לו הקדוש ברוך הוא ריבונו של עולם."
  },
  {
   "start": 1344.42,
   "end": 1346.08,
   "text": "אמר לו השם רשע,"
  },
  {
   "start": 1346.96,
   "end": 1350.7,
   "text": "רשע אתה הרגת שבעים איש על אבן אחת,"
  },
  {
   "start": 1351.42,
   "end": 1354.62,
   "text": "תבוא אבן אחת ותהרוג אותך."
  },
  {
   "start": 1358.9,
   "end": 1360.78,
   "text": "ואבימלך שוכב שם,"
  },
  {
   "start": 1361.48,
   "end": 1362.22,
   "text": "שותה דם,"
  },
  {
   "start": 1363.9,
   "end": 1364.72,
   "text": "אבל עדיין חי,"
  },
  {
   "start": 1365.28,
   "end": 1366.4,
   "text": "ועדיין עם מוח צלול."
  },
  {
   "start": 1367.18,
   "end": 1368.96,
   "text": "הוא יודע שהזמן שלו קצוב,"
  },
  {
   "start": 1369.94,
   "end": 1372.98,
   "text": "ובעוד מספר דקות הוא כבר לא יהיה כאן."
  },
  {
   "start": 1374.12,
   "end": 1376.54,
   "text": "אבל במקום לנצל את הרגע לתשובה,"
  },
  {
   "start": 1376.54,
   "end": 1377.08,
   "text": "בתשובה,"
  },
  {
   "start": 1378.22,
   "end": 1381.16,
   "text": "אבימלך עדיין שקוע בדמיון הגדולה שלו,"
  },
  {
   "start": 1381.84,
   "end": 1383.2,
   "text": "ומה שמעניין אותו,"
  },
  {
   "start": 1384.08,
   "end": 1386.8,
   "text": "גם עכשיו, גם ברגעים אחרונים,"
  },
  {
   "start": 1388.84,
   "end": 1391.46,
   "text": "מעניין אותו זה הכבוד, מה יגידו עליי,"
  },
  {
   "start": 1392.14,
   "end": 1393.7,
   "text": "מה יתפרסם אחרי מותי."
  },
  {
   "start": 1394.8,
   "end": 1395.96,
   "text": "אז הוא קורא לנער שלו,"
  },
  {
   "start": 1396.68,
   "end": 1400.34,
   "text": "קורא לעוזר שלו ומבקש, תעשה לי טובה, תהרוג אותי."
  },
  {
   "start": 1400.98,
   "end": 1404.52,
   "text": "תהרוג אותי, שלא יאמרו כולם, אישה הרגה אותו."
  },
  {
   "start": 1405.52,
   "end": 1409.7,
   "text": "תהרוג אותי שלא יגידו, שלא יתפרסם שאישה הרגה אותי."
  },
  {
   "start": 1410.04,
   "end": 1411.0,
   "text": "תהרוג אותי אתה."
  },
  {
   "start": 1412.66,
   "end": 1413.84,
   "text": "מהר, מהר."
  },
  {
   "start": 1414.66,
   "end": 1418.04,
   "text": "והנער דוקר אותו למוות."
  },
  {
   "start": 1419.62,
   "end": 1425.62,
   "text": "תצא אש מבעלי שכם ומבית מילו ותאכל את אבימלך."
  },
  {
   "start": 1426.22,
   "end": 1428.7,
   "text": "קללת יותם מתקיימת."
  },
  {
   "start": 1429.92,
   "end": 1431.76,
   "text": "אבימלך, אבימלך מת."
  },
  {
   "start": 1432.56,
   "end": 1433.88,
   "text": "האיש שחיפש תהילה,"
  },
  {
   "start": 1434.5,
   "end": 1436.4,
   "text": "האיש שחיפש כבוד, שררה,"
  },
  {
   "start": 1437.18,
   "end": 1438.98,
   "text": "מת בלי כבוד,"
  },
  {
   "start": 1440.06,
   "end": 1440.96,
   "text": "בלי גם תהילה,"
  },
  {
   "start": 1441.64,
   "end": 1443.12,
   "text": "מת בחוסר כול."
  },
  {
   "start": 1443.96,
   "end": 1444.96,
   "text": "כל מעשיו,"
  },
  {
   "start": 1445.56,
   "end": 1447.48,
   "text": "כל פועלו לריק,"
  },
  {
   "start": 1448.06,
   "end": 1449.48,
   "text": "לא נשאר זכר."
  },
  {
   "start": 1450.22,
   "end": 1452.84,
   "text": "איך אומר הפסוק, וילכו איש למקומו,"
  },
  {
   "start": 1453.38,
   "end": 1458.28,
   "text": "כל אחד חזר לאותה נקודת התחלה שם התחיל."
  },
  {
   "start": 1459.24,
   "end": 1464.56,
   "text": "אפילו לא היו לו יורשים ולא נתקיימה מלכותו לזרעו."
  },
  {
   "start": 1465.9,
   "end": 1466.48,
   "text": "ולא רק זה,"
  },
  {
   "start": 1467.32,
   "end": 1471.06,
   "text": "אלא הוא שכל כך רצה להתפרסם גם אחרי מותו,"
  },
  {
   "start": 1471.54,
   "end": 1477.72,
   "text": "מותו התפרסם לעולמי עד שהוא מת ונהרג על ידי אישה,"
  },
  {
   "start": 1478.46,
   "end": 1480.0,
   "text": "מה שהוא כל כך רצה להסתיר."
  },
  {
   "start": 1481.08,
   "end": 1482.32,
   "text": "העולם הזה לא היה לו,"
  },
  {
   "start": 1483.18,
   "end": 1484.02,
   "text": "והעולם הבא,"
  },
  {
   "start": 1485.32,
   "end": 1487.1,
   "text": "מי יודע."
  },
  {
   "start": 1488.1,
   "end": 1494.6,
   "text": "באבימלך התקיים הפסוק וישב אלוקים את רעת אבימלך."
  },
  {
   "start": 1495.96,
   "end": 1503.06,
   "text": "בשכם התקיים הפסוק ואת כל רעת אנשי שכם השיב אלוקים על ראשם."
  },
  {
   "start": 1516.29,
   "end": 1518.57,
   "text": "לבסוף מתברר לכולם"
  },
  {
   "start": 1520.19,
   "end": 1522.85,
   "text": "שבורא עולם הוא מנהיג את הכל,"
  },
  {
   "start": 1523.53,
   "end": 1529.15,
   "text": "וכל דבר בעולם הזה יש לו חשבון מדויק,"
  },
  {
   "start": 1530.65,
   "end": 1535.21,
   "text": "אתה, אבימלך, חשבת שתצליח ללא יראת שמיים."
  },
  {
   "start": 1536.63,
   "end": 1537.63,
   "text": "לא השגת כלום."
  },
  {
   "start": 1538.21,
   "end": 1539.27,
   "text": "אתם אנשי שכם."
  },
  {
   "start": 1540.27,
   "end": 1542.23,
   "text": "חשבתם שתוכלו להקים עיר,"
  },
  {
   "start": 1542.89,
   "end": 1545.39,
   "text": "עיר של דמים, עיר ללא יראת שמיים."
  },
  {
   "start": 1545.97,
   "end": 1548.57,
   "text": "לא נשאר לא עיר ולא שריד."
  }
 ]
}