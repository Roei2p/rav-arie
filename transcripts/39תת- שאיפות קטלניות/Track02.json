{
 "disc": "39תת- שאיפות קטלניות",
 "track": "Track02",
 "duration": 790.2,
 "segments": [
  {
   "start": 2.88,
   "end": 8.02,
   "text": "העיר שכם ממליכה את אבימלך בן גדעון."
  },
  {
   "start": 9.72,
   "end": 13.7,
   "text": "והדברים מגיעים עד הניצול היחידי"
  },
  {
   "start": 14.6,
   "end": 15.8,
   "text": "מהאחים של אבימלך."
  },
  {
   "start": 16.14,
   "end": 20.68,
   "text": "מפניו של גדעון שנרצחו, הוא היה ניצול יחידי, יותם."
  },
  {
   "start": 21.88,
   "end": 25.34,
   "text": "יותם שומע על המלכת אבימלך בשכם."
  },
  {
   "start": 27.08,
   "end": 28.94,
   "text": "ואז יותם הולך,"
  },
  {
   "start": 28.94,
   "end": 34.4,
   "text": "הולך אל המקום בו עמדו השבטים בתקופת משה רבנו, עליו השלום,"
  },
  {
   "start": 35.52,
   "end": 38.46,
   "text": "ואמרו ארור משיג גבול רעהו."
  },
  {
   "start": 41.34,
   "end": 42.7,
   "text": "אבימלך אתה הלכת,"
  },
  {
   "start": 43.5,
   "end": 46.76,
   "text": "הלכת למעשה ופגעת באחים שלך."
  },
  {
   "start": 47.82,
   "end": 50.16,
   "text": "עליך נאמר ארור משיג גבול רעהו,"
  },
  {
   "start": 50.86,
   "end": 53.2,
   "text": "והיוטם הולך שם אל המקום שם,"
  },
  {
   "start": 53.58,
   "end": 60.58,
   "text": "שם עמדו השבטים הקדושים ואמרו זעקו ואמרו לכל עם ישראל,"
  },
  {
   "start": 61.96,
   "end": 67.92,
   "text": "ארור מסי גבול רעהו אל המקום ההוא היה זה הר הר גריזים."
  },
  {
   "start": 68.86,
   "end": 75.32,
   "text": "הולך יותם אל ההר, אל הר גריזים ההר, בו נאמר ארור מקלה אבי ואימו."
  },
  {
   "start": 77.34,
   "end": 81.5,
   "text": "ואבימלך בייש את אביו ואת אימו."
  },
  {
   "start": 82.6,
   "end": 84.66,
   "text": "אבימלך, בהתנהגותו הרצחנית,"
  },
  {
   "start": 85.36,
   "end": 86.26,
   "text": "האכזרית,"
  },
  {
   "start": 87.48,
   "end": 88.8,
   "text": "חסרת המעצורים,"
  },
  {
   "start": 89.74,
   "end": 93.6,
   "text": "ללא האמונה בייש את אביו ואת אמו,"
  },
  {
   "start": 94.3,
   "end": 96.6,
   "text": "עליו נאמר ארור מקלה אביו ואמו."
  },
  {
   "start": 98.46,
   "end": 100.06,
   "text": "שם יותם עולה,"
  },
  {
   "start": 102.16,
   "end": 103.32,
   "text": "שם יותם עולה,"
  },
  {
   "start": 104.18,
   "end": 108.16,
   "text": "ויעמוד בראש הגריזים, ויישא קולו ויקרא."
  },
  {
   "start": 109.3,
   "end": 112.36,
   "text": "ואז הוא פותח במשל אל אנשי שכם."
  },
  {
   "start": 113.32,
   "end": 115.44,
   "text": "הוא אומר להם, שמעו אלי בעלי שכם,"
  },
  {
   "start": 116.24,
   "end": 118.42,
   "text": "וישמע עליכם אלוקים."
  },
  {
   "start": 119.32,
   "end": 120.5,
   "text": "והוא ממשיל להם משל."
  },
  {
   "start": 121.38,
   "end": 124.2,
   "text": "אומר יותם לאנשי שכם יום אחד,"
  },
  {
   "start": 124.78,
   "end": 125.8,
   "text": "עצי היער,"
  },
  {
   "start": 126.6,
   "end": 129.46,
   "text": "שם ביער, העצים של היער, עצי היער,"
  },
  {
   "start": 129.94,
   "end": 131.96,
   "text": "רצו למשוך להם מלך."
  },
  {
   "start": 133.16,
   "end": 134.72,
   "text": "רצו שיהיה להם מלך משלהם."
  },
  {
   "start": 135.54,
   "end": 136.48,
   "text": "אז הם פנו אל הזית,"
  },
  {
   "start": 137.04,
   "end": 138.14,
   "text": "אל עץ הזית, ואמרו לו,"
  },
  {
   "start": 138.44,
   "end": 140.54,
   "text": "בבקשה, בוא תמלוך עלינו."
  },
  {
   "start": 141.52,
   "end": 143.26,
   "text": "ועץ הזית סירב."
  },
  {
   "start": 143.84,
   "end": 146.74,
   "text": "עץ הזית לא הסכים, אמר להם, אם אני אמלוך עליכם,"
  },
  {
   "start": 147.58,
   "end": 152.9,
   "text": "אני לא אוכל להעניק מהפירות שלי שבהן מתכבד הקדוש ברוך הוא."
  },
  {
   "start": 154.02,
   "end": 155.8,
   "text": "בזית עושים שמן,"
  },
  {
   "start": 156.26,
   "end": 159.86,
   "text": "והשמן משמש למנורה בבית המקדש,"
  },
  {
   "start": 160.52,
   "end": 161.92,
   "text": "לכבוד השם יתברך."
  },
  {
   "start": 162.46,
   "end": 164.9,
   "text": "ולא רק זה, גם הפירות שלי מהנים אדם."
  },
  {
   "start": 165.2,
   "end": 169.7,
   "text": "הרי עושים את שמן המשחה, הרי יש שמן מאכל לאדם."
  },
  {
   "start": 170.96,
   "end": 173.72,
   "text": "אני כל הזמן אהיה טרוד בצורכי הציבור."
  },
  {
   "start": 174.2,
   "end": 176.98,
   "text": "איך אני אוכל לשמח אלוקים ואדם?"
  },
  {
   "start": 177.38,
   "end": 180.32,
   "text": "איך אני אוכל לשמח אלוקים ואדם?"
  },
  {
   "start": 181.66,
   "end": 183.74,
   "text": "הנמשל של הזית,"
  },
  {
   "start": 184.5,
   "end": 187.0,
   "text": "זה היה למעשה עתניאל בן קנז."
  },
  {
   "start": 187.38,
   "end": 192.08,
   "text": "השופט היה שופט בעם ישראל, קראו לו עתניאל בן קנז עמוד של תורה."
  },
  {
   "start": 192.38,
   "end": 194.06,
   "text": "איש אלוקים קדוש,"
  },
  {
   "start": 194.38,
   "end": 195.26,
   "text": "עמוד של תורה,"
  },
  {
   "start": 195.56,
   "end": 197.96,
   "text": "שהיה לומד ומלמד כל הזמן תורה."
  },
  {
   "start": 198.34,
   "end": 199.94,
   "text": "והוא לא רצה שררה."
  },
  {
   "start": 200.72,
   "end": 201.96,
   "text": "למה? כי הוא רצה תורה,"
  },
  {
   "start": 202.04,
   "end": 204.34,
   "text": "הוא רצה תורה, הוא פחד שהתורה תיפגע."
  },
  {
   "start": 206.04,
   "end": 209.72,
   "text": "ולמרות שהוא לא רצה שררה, בסוף הוא נהיה מנהיג עם ישראל שופט."
  },
  {
   "start": 210.18,
   "end": 212.56,
   "text": "אבל בהתחלה הוא לא רצה שררה."
  },
  {
   "start": 213.86,
   "end": 218.34,
   "text": "הוא נמנע, הוא לא רצה מנהיגות, הוא לא רץ לשום דבר."
  },
  {
   "start": 218.76,
   "end": 224.22,
   "text": "הוא רוצה לשמח אלוקים ואדם. אדם כזה נהיה מנהיג בעם ישראל."
  },
  {
   "start": 226.73,
   "end": 228.67,
   "text": "ממשיך יותם במשל ואומר,"
  },
  {
   "start": 229.57,
   "end": 233.09,
   "text": "אז עצי היער שחיפשו להם מלך שינלוך עליהם,"
  },
  {
   "start": 233.45,
   "end": 235.27,
   "text": "הלכו אל התאנה, אל עץ התאנה."
  },
  {
   "start": 235.83,
   "end": 238.33,
   "text": "אמרו לתאנה, אולי תמלכי את עלינו,"
  },
  {
   "start": 238.65,
   "end": 241.35,
   "text": "הרי הפירות שלך זה לא עבור המקדש,"
  },
  {
   "start": 241.83,
   "end": 242.85,
   "text": "זה לא עבור המזבח."
  },
  {
   "start": 244.27,
   "end": 245.95,
   "text": "אבל גם עץ התאנה סירבה,"
  },
  {
   "start": 246.47,
   "end": 248.63,
   "text": "היא אמרה, איך אני אפסיק את הפירות שלי?"
  },
  {
   "start": 249.09,
   "end": 252.29,
   "text": "אתם יודעים, בפירות שלי יש אפילו רפואה לאדם."
  },
  {
   "start": 252.95,
   "end": 255.91,
   "text": "אומרים חזל הקדושים, מי שאחזו בולמוס,"
  },
  {
   "start": 257.23,
   "end": 261.41,
   "text": "מאכילים אותו דבר מתוק עד שיאורו עיניו."
  },
  {
   "start": 262.29,
   "end": 267.15,
   "text": "תאנה הפרי המתוק שבה יכול להבריא את האדם."
  },
  {
   "start": 267.83,
   "end": 271.77,
   "text": "הנמשל דבורה הנביאה, אמא של עם ישראל,"
  },
  {
   "start": 272.19,
   "end": 274.13,
   "text": "ששיקמה את עם ישראל,"
  },
  {
   "start": 274.47,
   "end": 277.27,
   "text": "שנתנה פירות לעם ישראל, את השירה שלה,"
  },
  {
   "start": 277.59,
   "end": 282.29,
   "text": "שירת האמונה, שירת הניסים הגדולים שהיו בזמן דבורה."
  },
  {
   "start": 284.63,
   "end": 287.29,
   "text": "גם דבורה לא חיפשה להנהגה."
  },
  {
   "start": 291.14,
   "end": 294.86,
   "text": "ממשיך היותם במשל ואומר, אז עצי היער,"
  },
  {
   "start": 295.92,
   "end": 298.96,
   "text": "ראו שהזית לא רוצה למלוך."
  },
  {
   "start": 300.2,
   "end": 301.82,
   "text": "התאנה לא רוצה למלוך."
  },
  {
   "start": 302.32,
   "end": 303.42,
   "text": "הלכו אל הגפן."
  },
  {
   "start": 303.98,
   "end": 305.28,
   "text": "ניגשו לגפן ואמרו לה,"
  },
  {
   "start": 305.9,
   "end": 306.6,
   "text": "תראי, גפן,"
  },
  {
   "start": 307.3,
   "end": 310.78,
   "text": "האילנות הגבוהים בעלי הקומה לא נתרצו."
  },
  {
   "start": 311.36,
   "end": 313.04,
   "text": "למה? כי בעלי קומה הם,"
  },
  {
   "start": 313.52,
   "end": 314.48,
   "text": "ואם הם יותר יגוויעו,"
  },
  {
   "start": 314.96,
   "end": 317.8,
   "text": "נרים אותם עוד יותר, הפירות שלהם ייפגעו."
  },
  {
   "start": 318.48,
   "end": 319.02,
   "text": "אבל את,"
  },
  {
   "start": 319.8,
   "end": 321.6,
   "text": "את העץ הכי נמוך."
  },
  {
   "start": 322.66,
   "end": 325.32,
   "text": "כמעט נראה כמו שיח, שיח מטפס."
  },
  {
   "start": 325.94,
   "end": 327.26,
   "text": "את תמלכי עלינו אולי?"
  },
  {
   "start": 328.68,
   "end": 330.1,
   "text": "את תסכים למלוך עלינו?"
  },
  {
   "start": 330.8,
   "end": 332.06,
   "text": "וגם הגפן סירבה."
  },
  {
   "start": 332.72,
   "end": 333.22,
   "text": "היא אמרה,"
  },
  {
   "start": 333.64,
   "end": 334.14,
   "text": "אם אני אמלוך,"
  },
  {
   "start": 334.82,
   "end": 337.84,
   "text": "הרי אני אצטרך להפסיק להביא את היין שלי,"
  },
  {
   "start": 338.3,
   "end": 341.22,
   "text": "שממנו מביאים יין לנסכים בבית המקדש."
  },
  {
   "start": 341.64,
   "end": 348.3,
   "text": "הרי אין אומרים שירה בבית המקדש, אלא בעת ניסוך המים. אני לא רוצה להפסיק את השירה של בית המקדש."
  },
  {
   "start": 349.8,
   "end": 351.2,
   "text": "ואם אני אצליח להתרומם,"
  },
  {
   "start": 351.88,
   "end": 355.3,
   "text": "אם אני אצליח להיות קצת עם גאווה בשביל למלוך עליכם,"
  },
  {
   "start": 355.76,
   "end": 362.16,
   "text": "אני לא יוכל להיות בבית המקדש כי בשביל להיות בקודש להיות בקודש קודשים צריך להיות עם ענווה."
  },
  {
   "start": 363.7,
   "end": 382.9,
   "text": "אומרת הגמרא מסכת מנחות אין מביאים נסכים לא מן הדליות אלא מן הרגליות ומן הקרמים. מעצים שפלים לכאורה מצמחים שנראים צמחים מטפסים זה המשל והנמשל של עץ הגפן"
  },
  {
   "start": 383.52,
   "end": 386.98,
   "text": "זה גדעון, גדעון שהיה עניו ושפל,"
  },
  {
   "start": 387.6,
   "end": 389.58,
   "text": "גדעון שברח מהכבוד,"
  },
  {
   "start": 390.0,
   "end": 393.16,
   "text": "גדעון שלא חיפש להיות מנהיג של עם ישראל,"
  },
  {
   "start": 396.2,
   "end": 402.68,
   "text": "שלמעשה שורר שיר נפלא אל השם יתברך גם שאין בית מקדש,"
  },
  {
   "start": 403.12,
   "end": 404.34,
   "text": "שיר של אמונה,"
  },
  {
   "start": 404.72,
   "end": 406.52,
   "text": "שירת החיים של יהודי,"
  },
  {
   "start": 406.92,
   "end": 409.82,
   "text": "שיר של אמונה, צליל של אמונה, צליל העומר."
  },
  {
   "start": 410.2,
   "end": 411.86,
   "text": "זה מה שגדעון הביא לעם ישראל."
  },
  {
   "start": 412.86,
   "end": 413.76,
   "text": "זה המשל,"
  },
  {
   "start": 414.1,
   "end": 420.84,
   "text": "המשל של יותם, שהוא פתח ולמעשה תיאר את מנהיגי ישראל, איך כולם ברחו מן הכבוד."
  },
  {
   "start": 421.3,
   "end": 424.92,
   "text": "אלו מנהיגי ישראל, בורחים מהכבוד, לא רוצים שררה,"
  },
  {
   "start": 425.24,
   "end": 427.26,
   "text": "ויש להם הרבה הרבה פירות,"
  },
  {
   "start": 427.58,
   "end": 429.04,
   "text": "יש להם הרבה הרבה מה לתת,"
  },
  {
   "start": 429.42,
   "end": 430.86,
   "text": "יש להם הרבה הרבה מה להשפיע,"
  },
  {
   "start": 431.34,
   "end": 433.3,
   "text": "הרבה טוב להעניק לעם ישראל."
  },
  {
   "start": 434.6,
   "end": 437.42,
   "text": "ואז יותם ממשיך במשל ואומר,"
  },
  {
   "start": 438.08,
   "end": 438.76,
   "text": "ואז,"
  },
  {
   "start": 439.64,
   "end": 442.38,
   "text": "אז פנו עצי היער לאתד,"
  },
  {
   "start": 444.96,
   "end": 446.9,
   "text": "אז פנו עצי היער לאטד."
  },
  {
   "start": 447.56,
   "end": 451.6,
   "text": "האטד עושה מעט-מעט פרי כשהוא רך."
  },
  {
   "start": 454.7,
   "end": 457.54,
   "text": "כמו אבימלך, כשהיה קטן, אולי היה קצת פרי בו."
  },
  {
   "start": 458.3,
   "end": 459.14,
   "text": "אבל אחר כך,"
  },
  {
   "start": 459.68,
   "end": 461.44,
   "text": "ברבות השנים,"
  },
  {
   "start": 461.84,
   "end": 463.82,
   "text": "הוא מתקשה כמו עץ יבש,"
  },
  {
   "start": 464.26,
   "end": 466.48,
   "text": "אין לו טעם ואין לו ריח,"
  },
  {
   "start": 467.12,
   "end": 470.32,
   "text": "וכל מי שנפגש עמו נהיה עצוב,"
  },
  {
   "start": 470.72,
   "end": 471.62,
   "text": "נהיה כואב,"
  },
  {
   "start": 472.04,
   "end": 472.94,
   "text": "נהיה סובל."
  },
  {
   "start": 477.14,
   "end": 481.44,
   "text": "אמרו לו עצי היער, אתה בטח תשמח להיות בגדולה,"
  },
  {
   "start": 481.8,
   "end": 484.78,
   "text": "בשררה, תשמח להיות מלך עלינו."
  },
  {
   "start": 486.3,
   "end": 487.46,
   "text": "ענה להם האטד,"
  },
  {
   "start": 488.04,
   "end": 491.14,
   "text": "אם באמת אתם רוצים אותי למלך עליכם,"
  },
  {
   "start": 491.78,
   "end": 492.92,
   "text": "אז בואו בבקשה,"
  },
  {
   "start": 493.36,
   "end": 497.92,
   "text": "בואו תחסו בצלי ותוכיחו שאתם שפלים לאומתי."
  },
  {
   "start": 499.18,
   "end": 503.06,
   "text": "אבל אם את זה לא תסכימו ורק צחקתם לי,"
  },
  {
   "start": 503.44,
   "end": 506.14,
   "text": "לא התכוונתם ברצינות שאהיה מלך שלכם,"
  },
  {
   "start": 506.94,
   "end": 510.88,
   "text": "אז כמו שאני עץ קשה, אני ראוי הרי לשרפה מיידית."
  },
  {
   "start": 512.0,
   "end": 513.22,
   "text": "קל מאוד לשרפה,"
  },
  {
   "start": 513.84,
   "end": 516.72,
   "text": "ונוח לי לשרוף אתכם,"
  },
  {
   "start": 518.04,
   "end": 520.06,
   "text": "אפילו שגם אני אשרף עמכם."
  },
  {
   "start": 522.81,
   "end": 527.87,
   "text": "הנמשל אומר יותם לאנשי שכם, אתם עצי היער."
  },
  {
   "start": 528.31,
   "end": 529.75,
   "text": "אבימלך זה האטד."
  },
  {
   "start": 530.13,
   "end": 532.99,
   "text": "היו מנהיגים בעם ישראל, כולם היו עם מצוות,"
  },
  {
   "start": 533.47,
   "end": 537.77,
   "text": "עם מעשים טובים, עם שפע של טוב להנחיל לכל עם ישראל,"
  },
  {
   "start": 538.17,
   "end": 540.33,
   "text": "והם ברחו מהשררה, לא רצו הנהגה."
  },
  {
   "start": 540.97,
   "end": 546.09,
   "text": "ואתם רצתם והמלכתם אחד שכל כך רוצה הנהגה,"
  },
  {
   "start": 546.57,
   "end": 548.15,
   "text": "אחד שאין בו תורה ומצוות,"
  },
  {
   "start": 548.63,
   "end": 550.69,
   "text": "אחד שאין בו מעשים טובים."
  },
  {
   "start": 551.35,
   "end": 552.21,
   "text": "אמר יותם,"
  },
  {
   "start": 552.73,
   "end": 555.43,
   "text": "אם אתם המלכתם את אבימלך בתום לב,"
  },
  {
   "start": 556.21,
   "end": 558.41,
   "text": "לגמול טוב לגדעון,"
  },
  {
   "start": 558.79,
   "end": 559.31,
   "text": "אבא שלו,"
  },
  {
   "start": 559.63,
   "end": 560.93,
   "text": "שהיה מנהיג כל כך טוב,"
  },
  {
   "start": 561.23,
   "end": 563.23,
   "text": "שהשפיע כל כך טוב על עם ישראל,"
  },
  {
   "start": 563.69,
   "end": 565.83,
   "text": "אז רציתם כל כך להכיר לו טובה,"
  },
  {
   "start": 566.63,
   "end": 571.15,
   "text": "הרי גרמתם להרוג את כל הבנים של גדעון, ואחרי זה,"
  },
  {
   "start": 571.53,
   "end": 573.73,
   "text": "אחרי שרצחו את כל הבנים של גדעון,"
  },
  {
   "start": 574.07,
   "end": 575.45,
   "text": "אך אחרי זה המלאכתם"
  },
  {
   "start": 576.17,
   "end": 577.21,
   "text": "את אבימלך."
  },
  {
   "start": 578.11,
   "end": 578.65,
   "text": "אם כך,"
  },
  {
   "start": 579.41,
   "end": 583.63,
   "text": "העדפתם את אבימלך לא בגלל שהוא בן של גדעון,"
  },
  {
   "start": 584.11,
   "end": 586.27,
   "text": "בגלל שהוא אח שלכם."
  },
  {
   "start": 589.32,
   "end": 592.98,
   "text": "אומר הפסוק, וכל עוף למינו ישכון."
  },
  {
   "start": 594.24,
   "end": 597.68,
   "text": "כל עוף חיים עם הבן מין שלו."
  },
  {
   "start": 598.34,
   "end": 600.1,
   "text": "היה לכם, או אינטרס היה לכם."
  },
  {
   "start": 600.56,
   "end": 603.02,
   "text": "רציתם, כי הוא משכם, כי הוא האח שלכם."
  },
  {
   "start": 603.72,
   "end": 604.96,
   "text": "בגלל זה עשיתם את זה."
  },
  {
   "start": 605.44,
   "end": 608.96,
   "text": "אם ככה, אז תשמחו כולכם ביום הזה, תשמחו."
  },
  {
   "start": 609.4,
   "end": 610.88,
   "text": "גם אתם וגם הוא."
  },
  {
   "start": 611.88,
   "end": 614.18,
   "text": "אבל תדעו לכם, זה רק היום הזה."
  },
  {
   "start": 615.12,
   "end": 616.16,
   "text": "זה רק היום הזה."
  },
  {
   "start": 617.12,
   "end": 618.26,
   "text": "לשקר אין רגליים."
  },
  {
   "start": 618.92,
   "end": 620.78,
   "text": "אתם עוד תצטערו על כך."
  },
  {
   "start": 621.24,
   "end": 624.52,
   "text": "עוד יבוא יום ואתם תצטערו על כך."
  },
  {
   "start": 624.92,
   "end": 626.22,
   "text": "כי האדם יכול לתכנן,"
  },
  {
   "start": 626.72,
   "end": 628.44,
   "text": "יכול לומר כוכי ועוצם ידי,"
  },
  {
   "start": 628.82,
   "end": 630.7,
   "text": "יכול להיות פתוח שהכל תלוי בו,"
  },
  {
   "start": 631.0,
   "end": 631.8,
   "text": "בכישורים שלו,"
  },
  {
   "start": 632.1,
   "end": 633.14,
   "text": "בעוצמה שלו."
  },
  {
   "start": 633.9,
   "end": 634.46,
   "text": "אבל האמת,"
  },
  {
   "start": 635.1,
   "end": 637.16,
   "text": "עצת השם היא תקום."
  },
  {
   "start": 638.12,
   "end": 642.14,
   "text": "אתם חשבתם על מהלך מדיני כי הוא אח שלכם?"
  },
  {
   "start": 643.14,
   "end": 649.12,
   "text": "עוד תצא אש מאבימלך עצמו ותאכל ותשרוף את הכל."
  },
  {
   "start": 650.78,
   "end": 651.46,
   "text": "אחיכנו,"
  },
  {
   "start": 652.18,
   "end": 653.06,
   "text": "אתם דומים לו."
  },
  {
   "start": 653.98,
   "end": 656.6,
   "text": "אבא שלי, גדעון, סייע לישראל,"
  },
  {
   "start": 657.06,
   "end": 662.86,
   "text": "ואתם קמתם וגרמתם להרג של בניו."
  },
  {
   "start": 664.04,
   "end": 665.52,
   "text": "רבים מול מעטים,"
  },
  {
   "start": 666.08,
   "end": 668.08,
   "text": "צבא שלם מתנפל עליהם,"
  },
  {
   "start": 668.58,
   "end": 670.58,
   "text": "לא נותן להם סיכוי להתנגד."
  },
  {
   "start": 671.12,
   "end": 671.94,
   "text": "בלי משפט,"
  },
  {
   "start": 672.84,
   "end": 675.32,
   "text": "ככה רצח על אבן אחת?"
  },
  {
   "start": 676.7,
   "end": 682.74,
   "text": "עוד תצא אש מאבימלך עצמו ותפגע בכם."
  },
  {
   "start": 683.22,
   "end": 687.74,
   "text": "ואותה אש תצא גם מכם ותפגע בו."
  },
  {
   "start": 688.58,
   "end": 692.78,
   "text": "איזה אש, איזו אש, זו אש המחלוקת שהבערתם."
  },
  {
   "start": 693.16,
   "end": 695.12,
   "text": "היא תשרוף אתכם, את כולכם."
  },
  {
   "start": 703.08,
   "end": 705.2,
   "text": "יותם מסיים את המשל שלו,"
  },
  {
   "start": 705.64,
   "end": 708.48,
   "text": "פונה אל מקום שנקרא בעירה ויושב שם,"
  },
  {
   "start": 710.1,
   "end": 713.16,
   "text": "מוגן שם, נזהר מאבימלך."
  },
  {
   "start": 715.74,
   "end": 719.72,
   "text": "עיקר התפקיד של המנהיג בעם ישראל זה להורות דרך"
  },
  {
   "start": 720.54,
   "end": 723.82,
   "text": "לעם ישראל להגיע לדבקות בריבונו של עולם."
  },
  {
   "start": 725.18,
   "end": 732.26,
   "text": "אין צורך, כמו באומות העולם, שהמנהיג של עם ישראל יהיה מצביא מזהיר או פוליטיקאי שנון."
  },
  {
   "start": 733.62,
   "end": 734.68,
   "text": "לא צריך את זה."
  },
  {
   "start": 735.16,
   "end": 735.78,
   "text": "לא צריך."
  },
  {
   "start": 736.16,
   "end": 738.02,
   "text": "צריך מישהו שיהיה דבק בשם יתברך,"
  },
  {
   "start": 738.62,
   "end": 740.48,
   "text": "שיחדיר אמונה בעם ישראל,"
  },
  {
   "start": 741.62,
   "end": 742.86,
   "text": "כמו גדעון בשעתו."
  },
  {
   "start": 744.4,
   "end": 745.2,
   "text": "אומר הרמב״ם,"
  },
  {
   "start": 745.7,
   "end": 749.06,
   "text": "מי שיש לו שררה או אף קרוב אליה,"
  },
  {
   "start": 750.16,
   "end": 753.04,
   "text": "לא יכול לעבוד את הקדוש ברוך הוא כראוי."
  },
  {
   "start": 754.54,
   "end": 756.24,
   "text": "אמר רבי יצחק אברבנאל,"
  },
  {
   "start": 756.94,
   "end": 763.92,
   "text": "מיום שהתקבלתי להיות בן המלכים לא יכולתי לעבוד את הקדוש ברוך הוא כראוי."
  },
  {
   "start": 764.84,
   "end": 768.78,
   "text": "אם ככה אומר, אם ככה מעיד על עצמו רבי יצחק אברבנאל,"
  },
  {
   "start": 769.12,
   "end": 771.82,
   "text": "ירא שמיים, תלמיד חכם גדול,"
  },
  {
   "start": 772.54,
   "end": 775.38,
   "text": "קל וחומר לעם הארץ,"
  },
  {
   "start": 775.94,
   "end": 777.82,
   "text": "קל וחומר לאחד"
  },
  {
   "start": 778.46,
   "end": 779.3,
   "text": "כמו אבי מלך."
  },
  {
   "start": 780.48,
   "end": 781.68,
   "text": "אבל,"
  },
  {
   "start": 782.28,
   "end": 783.36,
   "text": "אבל עוד ימים יגידו."
  }
 ]
}