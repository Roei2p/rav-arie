{
 "disc": "39תת- שאיפות קטלניות",
 "track": "Track01",
 "duration": 1385.184,
 "segments": [
  {
   "start": 2.53,
   "end": 3.33,
   "text": "קהל קדוש."
  },
  {
   "start": 4.83,
   "end": 5.93,
   "text": "בדורות האחרונים,"
  },
  {
   "start": 7.07,
   "end": 15.75,
   "text": "כשהאדם גדל עם חינוך, עם מטרה הרבה פעמים לשאיפה, שאיפה קדימה."
  },
  {
   "start": 18.34,
   "end": 22.8,
   "text": "בדורות שאולי החינוך הבולט ביותר,"
  },
  {
   "start": 23.32,
   "end": 28.17,
   "text": "ההשפעה הבולטת ביותר על האדם,"
  },
  {
   "start": 28.65,
   "end": 30.03,
   "text": "היא ההשפעה החיצונית."
  },
  {
   "start": 32.5,
   "end": 35.44,
   "text": "כל הכותרות בחוץ זועקות, תהיה משהו, תהיה מישהו."
  },
  {
   "start": 35.44,
   "end": 37.56,
   "text": "בדורות שכאלה,"
  },
  {
   "start": 38.46,
   "end": 41.52,
   "text": "במחשבה שכזאת,"
  },
  {
   "start": 42.6,
   "end": 45.16,
   "text": "כדאי אולי לחזור אחורה,"
  },
  {
   "start": 46.18,
   "end": 51.66,
   "text": "אל פרק מיוחד בתולדות עם ישראל,"
  },
  {
   "start": 52.84,
   "end": 53.32,
   "text": "אל התנ״ך,"
  },
  {
   "start": 59.1,
   "end": 60.12,
   "text": "אל ספר שופטים,"
  },
  {
   "start": 61.4,
   "end": 63.86,
   "text": "אל תקופה שאחרי גדעון,"
  },
  {
   "start": 64.76,
   "end": 68.26,
   "text": "גדעון השופט הנפלא ששפט את עם ישראל במשך ארבעים שנה,"
  },
  {
   "start": 69.1,
   "end": 70.38,
   "text": "ארבעים שנה של שקט,"
  },
  {
   "start": 71.16,
   "end": 76.0,
   "text": "ארבעים שנה של שלום, ארבעים שנה של שפע רוחני וכלכלי."
  },
  {
   "start": 76.92,
   "end": 79.28,
   "text": "ואותו גדעון משאיר אחריו שבעים בנים."
  },
  {
   "start": 81.74,
   "end": 85.0,
   "text": "בואו נראה איך אדם אחד, אדם אחד עם שאיפות."
  },
  {
   "start": 86.94,
   "end": 90.14,
   "text": "שלכאורה שאיפה זה דבר טוב,"
  },
  {
   "start": 90.98,
   "end": 94.16,
   "text": "אבל כאשר הכיוון הוא לא כל כך טוב,"
  },
  {
   "start": 95.52,
   "end": 98.08,
   "text": "שאיפות יכולות להיות דבר מאוד מאוד מסוכן."
  },
  {
   "start": 98.84,
   "end": 100.8,
   "text": "וכשהן חוברות השאיפות,"
  },
  {
   "start": 100.8,
   "end": 104.12,
   "text": "עם מקום מיוחד,"
  },
  {
   "start": 105.4,
   "end": 109.24,
   "text": "אז הדבר עלול לעלות במחיר של דם."
  },
  {
   "start": 112.98,
   "end": 122.14,
   "text": "צריך לדעת שמה שמשפיע על האדם זה מה שהוא רואה ומה שהוא שומע וגם מה שהוא חושב,"
  },
  {
   "start": 123.38,
   "end": 126.46,
   "text": "אבל לפעמים גם המקום,"
  },
  {
   "start": 126.88,
   "end": 127.94,
   "text": "המקום בו הוא נמצא,"
  },
  {
   "start": 128.32,
   "end": 129.54,
   "text": "המקום בו הוא גדל,"
  },
  {
   "start": 130.1,
   "end": 130.98,
   "text": "גם לו יש חלק."
  },
  {
   "start": 131.96,
   "end": 133.04,
   "text": "אומר השיח יצחק,"
  },
  {
   "start": 135.0,
   "end": 135.72,
   "text": "ואני מצטט,"
  },
  {
   "start": 136.32,
   "end": 157.82,
   "text": "ואמרו חז״ל הקדושים כי במקום שיעשה האדם איזה חטא ממשיך טומאה על אותו מקום וגורם שאם עבר אדם באותו מקום מתלבשות בו הקליפות ומכניסות בליבו מחשבות זרות מעין אותו עוון ומחטיאות אותו."
  },
  {
   "start": 158.42,
   "end": 162.0,
   "text": "ולכן תראה שלפעמים אדם נכנס לאיזה מקום"
  },
  {
   "start": 162.78,
   "end": 164.7,
   "text": "ותוקף את אותו פתאום מחשבה רעה,"
  },
  {
   "start": 165.32,
   "end": 166.6,
   "text": "שמעולם לא עלתה על ליבו."
  },
  {
   "start": 168.34,
   "end": 171.94,
   "text": "והוא מחמת שבאותו מקום עשו איזה עוון מעין אותה מחשבה,"
  },
  {
   "start": 172.52,
   "end": 174.44,
   "text": "והטומאה שבאותו מקום התלבשה בו,"
  },
  {
   "start": 174.84,
   "end": 177.02,
   "text": "והכניסה אותה מחשבה בליבו."
  },
  {
   "start": 180.18,
   "end": 183.86,
   "text": "וממשיך השיח יצחק ואומר, והוא משל לאדם מלא כינים,"
  },
  {
   "start": 184.58,
   "end": 186.18,
   "text": "שבכל מקום שישב,"
  },
  {
   "start": 187.24,
   "end": 188.62,
   "text": "כל מקום שהוא יישב,"
  },
  {
   "start": 189.2,
   "end": 191.08,
   "text": "הוא יותיר אחריו מהכינים שלו,"
  },
  {
   "start": 191.8,
   "end": 193.0,
   "text": "וכל היושב שם"
  },
  {
   "start": 193.6,
   "end": 194.5,
   "text": "יעלו עליו."
  },
  {
   "start": 197.42,
   "end": 203.08,
   "text": "כלומר, אומר השיח יצחק, אדם שעובר באיזה מקום שבמקום הזה נעשתה עבירה,"
  },
  {
   "start": 203.54,
   "end": 207.06,
   "text": "התלבשה באותו מקום גם טומאה מאותו סוג העבירה,"
  },
  {
   "start": 207.42,
   "end": 209.12,
   "text": "וזה יכול להשפיע על אותו אדם."
  },
  {
   "start": 209.46,
   "end": 214.04,
   "text": "וכן להפך, אדם שעשה מצווה, אדם שעשה דבר של קדושה,"
  },
  {
   "start": 214.64,
   "end": 219.8,
   "text": "מתלבשת באותו מקום ארשת של קדושה, השפעה טובה של קדושה."
  },
  {
   "start": 220.56,
   "end": 221.86,
   "text": "עד לכך ניתן דוגמה,"
  },
  {
   "start": 222.76,
   "end": 226.22,
   "text": "הגאון הגדול רבי חיים קנייבסקי סיפר שהוא"
  },
  {
   "start": 226.22,
   "end": 227.7,
   "text": "הוא פעם ליווה את הדוד שלו."
  },
  {
   "start": 228.26,
   "end": 229.96,
   "text": "הדוד שלו זה החזון איש."
  },
  {
   "start": 230.58,
   "end": 237.5,
   "text": "ליווה את החזון איש עד בין הארבעים ברחוב שלימים להיקרא רחוב חזון איש."
  },
  {
   "start": 238.52,
   "end": 241.68,
   "text": "הרופאים ציוו על החזון איש לעשות טיול רגלי,"
  },
  {
   "start": 242.28,
   "end": 244.66,
   "text": "וכך הוא ליווה אותו קצת בבין הארבעים."
  },
  {
   "start": 246.1,
   "end": 253.42,
   "text": "מספר הגאון הגדול רבי חיים קניאבסקי, כשהגענו בצוותיים החזון איש, סמוך לבית הקברות שומרי שבת,"
  },
  {
   "start": 254.4,
   "end": 256.4,
   "text": "היה שם מקום שהיה מוקף פרדסים."
  },
  {
   "start": 257.14,
   "end": 258.26,
   "text": "אמר החזון איש,"
  },
  {
   "start": 258.84,
   "end": 263.26,
   "text": "תדע לך, במקום הזה עברו בני ישיבה ודיברו דברי תורה."
  },
  {
   "start": 264.84,
   "end": 266.94,
   "text": "אני מרגיש כאן קדושה יתרה."
  },
  {
   "start": 268.52,
   "end": 270.38,
   "text": "אני מרגיש כאן קדושה יתרה."
  },
  {
   "start": 272.77,
   "end": 281.93,
   "text": "אומר הגאון רבי חיים קניבסקי, יש תוספתא על התרגום שמספרת שכשבא מלאך אל יהושע בן נון ואמר לו, עתה באתי,"
  },
  {
   "start": 282.77,
   "end": 289.63,
   "text": "זה ספר יהושע, פרק ה', פסוק י״ד אז למעשה הוא ציווה עליו לקום על רגליו."
  },
  {
   "start": 290.53,
   "end": 292.91,
   "text": "אתם יודעים למה הוא ציווה עליו לקום על רגליו?"
  },
  {
   "start": 293.95,
   "end": 306.93,
   "text": "כי במקום הזה עתיד אלישע יותר מאוחר. אלישע הנביא לעמוד ולהרביץ תורה לכלל ישראל ולכן כבר עתה שורה קדושה נוראה על המקום הזה."
  },
  {
   "start": 307.57,
   "end": 312.69,
   "text": "תראו כמה כוח השפעה שיש לאדם על המקום בו הוא נמצא."
  },
  {
   "start": 315.84,
   "end": 318.18,
   "text": "מספר הרב זילברשטיין בספר טובחה יביעו,"
  },
  {
   "start": 319.82,
   "end": 323.2,
   "text": "הוא מביא שם שתפסו גויים, תפסו יהודי,"
  },
  {
   "start": 324.54,
   "end": 325.74,
   "text": "ורצו להרוג אותו."
  },
  {
   "start": 327.0,
   "end": 329.24,
   "text": "והוא ביקש משאלה אחרונה, תעשו לי טובה,"
  },
  {
   "start": 329.7,
   "end": 333.18,
   "text": "אם אתם יכולים להעביר אותי דרך הרחוב הסמוך שם."
  },
  {
   "start": 334.52,
   "end": 337.72,
   "text": "אז הם העבירו אותו, משאלה אחרונה, כבר הולכים להרוג אותו."
  },
  {
   "start": 338.5,
   "end": 341.46,
   "text": "העבירו אותו דרך הרחוב הסמוך כמו שהוא ביקש,"
  },
  {
   "start": 342.3,
   "end": 345.04,
   "text": "ואז לפתע באמצע הרחוב לא להאמין,"
  },
  {
   "start": 345.66,
   "end": 346.56,
   "text": "לפתע הם התחרטו,"
  },
  {
   "start": 347.32,
   "end": 348.12,
   "text": "שחררו אותו."
  },
  {
   "start": 349.68,
   "end": 350.1,
   "text": "מה קרה?"
  },
  {
   "start": 350.62,
   "end": 351.36,
   "text": "מה קרה להם?"
  },
  {
   "start": 352.78,
   "end": 356.22,
   "text": "פשוט ברחוב הקודם שרתה שם טומאה,"
  },
  {
   "start": 356.98,
   "end": 360.7,
   "text": "וכשעברו מקום פגה לה השפעת הטומאה."
  },
  {
   "start": 361.84,
   "end": 365.82,
   "text": "מכאן נראה כמה יש השפעה לאזור בו גדל האדם."
  },
  {
   "start": 368.48,
   "end": 369.22,
   "text": "אז בואו נחזור."
  },
  {
   "start": 369.86,
   "end": 372.42,
   "text": "לתקופה מיד אחרי מותו של גדעון."
  },
  {
   "start": 374.44,
   "end": 376.24,
   "text": "לגדעון היו 70 בנים."
  },
  {
   "start": 377.26,
   "end": 380.74,
   "text": "70 בנים, וכולם הולכים בדרך של אבא שלהם,"
  },
  {
   "start": 381.84,
   "end": 382.88,
   "text": "בענווה,"
  },
  {
   "start": 383.4,
   "end": 388.04,
   "text": "בצניעות, בירת שמיים ועם הרבה הרבה הרבה אמונה."
  },
  {
   "start": 389.3,
   "end": 393.58,
   "text": "וכל אותם 70 בנים, כולם עם פוטנציאל להנהיג את עם ישראל."
  },
  {
   "start": 393.98,
   "end": 394.22,
   "text": "כלומר,"
  },
  {
   "start": 394.3,
   "end": 401.34,
   "text": "לעם ישראל יש תקופה כל כך נפלאה שיש שם 70 מועמדים נפלאים להנהיג את עם ישראל,"
  },
  {
   "start": 402.72,
   "end": 405.22,
   "text": "לקחת את עם ישראל ולהצעיד אותם קדימה."
  },
  {
   "start": 409.77,
   "end": 415.39,
   "text": "אבל היה לגדעון גם בן של פילגש אחת מעיר ושמה שכם."
  },
  {
   "start": 417.13,
   "end": 419.91,
   "text": "קראו לבן הפילגש שהיה לו השם שלו אבימלך."
  },
  {
   "start": 421.41,
   "end": 425.47,
   "text": "השם של בן הפילגש היה אבימלך מהעיר שכם."
  },
  {
   "start": 425.47,
   "end": 428.91,
   "text": "ואבימלך גודל בעיר שכם,"
  },
  {
   "start": 432.04,
   "end": 434.58,
   "text": "והוא סופג את האווירה של שכם."
  },
  {
   "start": 436.24,
   "end": 437.8,
   "text": "והוא גודל עם שאיפות,"
  },
  {
   "start": 439.22,
   "end": 443.58,
   "text": "אבל השאיפות שלו הן שאיפות קדימה,"
  },
  {
   "start": 444.42,
   "end": 446.38,
   "text": "קדימה לעצמו."
  },
  {
   "start": 447.28,
   "end": 448.32,
   "text": "הוא רוצה לשאוף קדימה,"
  },
  {
   "start": 449.4,
   "end": 450.6,
   "text": "הוא מחפש הנהגה,"
  },
  {
   "start": 451.26,
   "end": 452.54,
   "text": "הוא מחפש שלטון,"
  },
  {
   "start": 453.06,
   "end": 456.78,
   "text": "בכל מצב וגם בכל מחיר."
  },
  {
   "start": 457.5,
   "end": 458.22,
   "text": "וזה מסוכן."
  },
  {
   "start": 463.66,
   "end": 465.88,
   "text": "אומר הפסוק וילך אבימלך בן ירובעל,"
  },
  {
   "start": 466.78,
   "end": 471.1,
   "text": "לא נכתב אבימלך בן גדעון, נכתב אבימלך בן ירובעל."
  },
  {
   "start": 471.72,
   "end": 472.02,
   "text": "למה?"
  },
  {
   "start": 472.76,
   "end": 476.4,
   "text": "כי חזל הקדושים תבעו לנו ואמרו לנו אמרה חשובה,"
  },
  {
   "start": 476.92,
   "end": 480.66,
   "text": "כל המשנה מדרך אבותיו משנים את שמו."
  },
  {
   "start": 481.74,
   "end": 486.08,
   "text": "אבא של אבימלך, גדעון, כל החיים הוא ברח מכבוד,"
  },
  {
   "start": 486.76,
   "end": 487.76,
   "text": "ברח משררה,"
  },
  {
   "start": 488.6,
   "end": 490.12,
   "text": "וכל כולו היה אמונה."
  },
  {
   "start": 490.6,
   "end": 492.36,
   "text": "אבימלך בדיוק ההפך."
  },
  {
   "start": 493.02,
   "end": 495.58,
   "text": "כל-כולו, כל חייו, רודף אחרי כבוד,"
  },
  {
   "start": 495.94,
   "end": 497.24,
   "text": "רודף אחרי שררה,"
  },
  {
   "start": 497.54,
   "end": 501.22,
   "text": "מחפש פוליטיקה, חי פוליטיקה, נושם פוליטיקה."
  },
  {
   "start": 501.74,
   "end": 504.98,
   "text": "וכל-כולו כוכי ועוצם ידי."
  },
  {
   "start": 506.58,
   "end": 509.38,
   "text": "כוכי ועוצם ידי. אני אעשה, אני אשתדל,"
  },
  {
   "start": 509.7,
   "end": 512.32,
   "text": "אני אצליח, אני אנווט, אני אנהיג."
  },
  {
   "start": 512.7,
   "end": 513.36,
   "text": "זה היה אבימלך."
  },
  {
   "start": 514.5,
   "end": 518.24,
   "text": "ואבימלך נאמן לדרכו כשהאדם קובע את דרכו,"
  },
  {
   "start": 518.7,
   "end": 519.82,
   "text": "קובע את הישגיו,"
  },
  {
   "start": 520.28,
   "end": 523.42,
   "text": "פונה אל אחי אמו בשכם ומשכנע אותם,"
  },
  {
   "start": 523.84,
   "end": 524.54,
   "text": "תראו כדאי,"
  },
  {
   "start": 524.92,
   "end": 528.12,
   "text": "כדאי מאוד שאני אהיה המנהיג של שכם."
  },
  {
   "start": 528.96,
   "end": 533.28,
   "text": "אני המנהיג של שכם וסביבותיה וגם לעתיד של כל ישראל."
  },
  {
   "start": 535.0,
   "end": 537.26,
   "text": "הוא מסביר להם, הוא פונה אליהם בחישובים פוליטיים."
  },
  {
   "start": 537.9,
   "end": 544.2,
   "text": "הוא אומר להם, הרי תראו, אם לא תבחרו בי וייבחר אחד מהבנים של גדעון האחרים,"
  },
  {
   "start": 545.28,
   "end": 548.18,
   "text": "הרי הם שבעים, שבעים איש."
  },
  {
   "start": 548.88,
   "end": 553.12,
   "text": "זה בטח לתוהו ובוהו, שבעים איש, עדיף מנהיג אחד."
  },
  {
   "start": 553.78,
   "end": 556.22,
   "text": "ולא רק זה, כולם הם אחים."
  },
  {
   "start": 557.52,
   "end": 560.52,
   "text": "אז אם הם אחים, גם אם תרצו להיפטר מהם,"
  },
  {
   "start": 561.28,
   "end": 563.08,
   "text": "הם יתאחדו כולם למלוך עליכם."
  },
  {
   "start": 563.72,
   "end": 566.38,
   "text": "זה יהיה שם ממש, כל אחד ידאג לשני."
  },
  {
   "start": 566.88,
   "end": 569.36,
   "text": "הם ידאגו רק לעצמם, למשפחתיות שלהם."
  },
  {
   "start": 569.7,
   "end": 571.44,
   "text": "הם אחים, כל אחד דואג אחד לשני."
  },
  {
   "start": 571.84,
   "end": 575.64,
   "text": "אסור שזה יקרה. אם אתם רוצים שלטון אמיתי, אתם צריכים שאני."
  },
  {
   "start": 575.92,
   "end": 578.5,
   "text": "אם אתם רוצים לדאוג לאינטרסים שלכם,"
  },
  {
   "start": 578.96,
   "end": 585.12,
   "text": "צריך שאחד כמוני הוא זה שישלוט. גם אני בן של גדעון, אבל אני יחיד, ואני משכם."
  },
  {
   "start": 585.62,
   "end": 586.62,
   "text": "אני מאצליו מפה."
  },
  {
   "start": 586.98,
   "end": 588.52,
   "text": "אני אדאג לאינטרסים של שכם."
  },
  {
   "start": 588.96,
   "end": 590.12,
   "text": "אני זה שידאג לכם."
  },
  {
   "start": 592.22,
   "end": 593.08,
   "text": "ואבימלך,"
  },
  {
   "start": 594.2,
   "end": 600.32,
   "text": "אבימלך שפנה ככה אל אחי אימו בשכם רוצה את העזרה של האחים של אימא שלו."
  },
  {
   "start": 602.77,
   "end": 607.53,
   "text": "ואותם אחים של אימא שלו עושים שם, אחי אימו עושים שם חישוב פוליטי."
  },
  {
   "start": 608.01,
   "end": 611.01,
   "text": "והבינו כמה הם ירוויחו על כך."
  },
  {
   "start": 611.57,
   "end": 614.99,
   "text": "אז הם פונים לאנשי שכם ומשכנעים אותם. תראו, טובת שכם,"
  },
  {
   "start": 615.43,
   "end": 617.97,
   "text": "טובת שכם מצריכה קידום אבימלך."
  },
  {
   "start": 618.35,
   "end": 619.51,
   "text": "לטובת שכם."
  },
  {
   "start": 620.19,
   "end": 624.55,
   "text": "טובת שכם מצריכה קידום אבימלך."
  },
  {
   "start": 625.75,
   "end": 630.39,
   "text": "היה פעם בעבר מישהו שגם זעק טובת שכם, טובת שכם."
  },
  {
   "start": 630.97,
   "end": 635.53,
   "text": "טובת שכם מצריכה את זה שכולנו מתחתן עם הבנות של יעקב."
  },
  {
   "start": 636.23,
   "end": 637.51,
   "text": "היה זה שכם בן חמור,"
  },
  {
   "start": 638.09,
   "end": 639.21,
   "text": "שהוא רצה את בינה,"
  },
  {
   "start": 639.71,
   "end": 642.99,
   "text": "שכנע את כל אנשי שכם ללכת איתו,"
  },
  {
   "start": 643.79,
   "end": 644.91,
   "text": "ומלכו אחריו,"
  },
  {
   "start": 645.65,
   "end": 646.89,
   "text": "ומלו את עצמם,"
  },
  {
   "start": 647.31,
   "end": 649.85,
   "text": "ושילמו ביוקר, שילמו בחייהם כולם."
  },
  {
   "start": 650.43,
   "end": 653.39,
   "text": "הוא טען שהוא צריך רוצה טובת שכם, אבל האמת,"
  },
  {
   "start": 653.87,
   "end": 655.23,
   "text": "הוא רצה רק את טובת עצמו."
  },
  {
   "start": 655.79,
   "end": 656.59,
   "text": "גם עכשיו באים,"
  },
  {
   "start": 657.07,
   "end": 658.17,
   "text": "שנים אחר כך,"
  },
  {
   "start": 658.77,
   "end": 661.15,
   "text": "אחרי אימו של אבימלך,"
  },
  {
   "start": 662.03,
   "end": 664.91,
   "text": "ומשכנעים את אנשי שכם בשם טובת שכם."
  },
  {
   "start": 665.53,
   "end": 668.03,
   "text": "היא לתמוך באבימלך."
  },
  {
   "start": 668.55,
   "end": 671.15,
   "text": "אבימלך מקבל את תמיכת אנשי שכם."
  },
  {
   "start": 672.93,
   "end": 674.21,
   "text": "הוא נהיה המנהיג של שכם,"
  },
  {
   "start": 676.07,
   "end": 679.13,
   "text": "והוא עושה צעדים בדרך להשתלט על כל עם ישראל."
  },
  {
   "start": 679.77,
   "end": 681.61,
   "text": "שום דבר לא יעמוד בדרכו."
  },
  {
   "start": 682.29,
   "end": 685.75,
   "text": "כל אמצעי יקדש את המטרה."
  },
  {
   "start": 690.55,
   "end": 693.89,
   "text": "אני לא בוחל בשום אמצעי, לא אכפת לי איך אני עושה את זה."
  },
  {
   "start": 694.21,
   "end": 695.57,
   "text": "כך הוא אמר, כך הוא חשב."
  },
  {
   "start": 696.33,
   "end": 698.51,
   "text": "ולא רק זה, הוא מקבל גם 70 כסף."
  },
  {
   "start": 700.76,
   "end": 704.72,
   "text": "מימון כלכלי אדיר על מנת לחזק את עצמו."
  },
  {
   "start": 705.16,
   "end": 706.24,
   "text": "ומה הוא עושה בכסף?"
  },
  {
   "start": 706.72,
   "end": 709.14,
   "text": "בכסף הוא הולך, ולא פחות ולא יותר."
  },
  {
   "start": 710.16,
   "end": 712.12,
   "text": "הוא בונה לו צבא. איזה צבא?"
  },
  {
   "start": 712.44,
   "end": 714.98,
   "text": "הוא זוכר בכסף פושעים."
  },
  {
   "start": 715.48,
   "end": 721.03,
   "text": "הוא זוכר בכסף רוצחים, שודדים,"
  },
  {
   "start": 721.51,
   "end": 724.27,
   "text": "כדי שישמשו בתור הצבא שלו."
  },
  {
   "start": 727.64,
   "end": 728.66,
   "text": "ואז אבימלך הולך"
  },
  {
   "start": 729.4,
   "end": 733.26,
   "text": "ומגיע לביקור משפחתי שם בעופרה,"
  },
  {
   "start": 734.0,
   "end": 736.64,
   "text": "בבית אביו גדעון שנפטר."
  },
  {
   "start": 737.52,
   "end": 738.8,
   "text": "הוא בא לבקר את האחים שלו."
  },
  {
   "start": 739.84,
   "end": 742.34,
   "text": "איש מהאחים של אבימלך לא מעלה בדעתו."
  },
  {
   "start": 743.26,
   "end": 746.56,
   "text": "הרי אנחנו הבנים של גדעון, אנחנו הבני אבא אחד."
  },
  {
   "start": 747.46,
   "end": 750.68,
   "text": "הם מארחים אותו, מארחים אותו בשמחה, באהבה."
  },
  {
   "start": 751.04,
   "end": 754.8,
   "text": "הוא אוכל מהאוכל שלהם, מהלחם שלהם."
  },
  {
   "start": 756.51,
   "end": 760.51,
   "text": "ואף אחד לא שם לב שבכל זמן פנוי שיש לו, בלי שאף אחד שם לב,"
  },
  {
   "start": 760.87,
   "end": 764.17,
   "text": "הוא יוצא מהבית ונפגש במקום סתרים,"
  },
  {
   "start": 764.57,
   "end": 767.05,
   "text": "עם כל מיני אנשים מפוקפקים."
  },
  {
   "start": 767.93,
   "end": 768.75,
   "text": "זה הצבא שלו,"
  },
  {
   "start": 769.59,
   "end": 771.59,
   "text": "וכך הוא מארגן את הצבא שלו,"
  },
  {
   "start": 775.12,
   "end": 775.22,
   "text": "בעת,"
  },
  {
   "start": 776.48,
   "end": 780.22,
   "text": "בעת שאף אחד, איש לא מעלה על דעתו, לפתע."
  },
  {
   "start": 782.14,
   "end": 784.86,
   "text": "אבימלך מבפנים פותח את הדלתות,"
  },
  {
   "start": 786.34,
   "end": 787.08,
   "text": "ולבית,"
  },
  {
   "start": 787.54,
   "end": 790.26,
   "text": "לבית שקשירים הבנים הנפלאים של גדעון,"
  },
  {
   "start": 791.3,
   "end": 792.22,
   "text": "הוא מתנפל,"
  },
  {
   "start": 793.66,
   "end": 797.12,
   "text": "הוא חובר עם הצבא שלו, עם הצבא האכזרי שלו,"
  },
  {
   "start": 797.48,
   "end": 801.0,
   "text": "ויחד הם מתנחלים על שבעים האחים שלא מוכנים,"
  },
  {
   "start": 801.32,
   "end": 803.14,
   "text": "שלא מעלים על דעתם בכלל,"
  },
  {
   "start": 804.04,
   "end": 805.26,
   "text": "שחייהם בסכנה."
  },
  {
   "start": 805.96,
   "end": 807.9,
   "text": "ואבימלך, אלה לא רחמים,"
  },
  {
   "start": 808.84,
   "end": 811.18,
   "text": "פשוט רוצח אותם באכזריות,"
  },
  {
   "start": 812.08,
   "end": 813.52,
   "text": "ללא הנד עפעף."
  },
  {
   "start": 815.52,
   "end": 818.12,
   "text": "כל דבר שיעצור אותו בדרך לשלטון,"
  },
  {
   "start": 819.08,
   "end": 821.4,
   "text": "אבימלך מוכן לעשות הכל על מנת לסלק אותו."
  },
  {
   "start": 821.9,
   "end": 827.14,
   "text": "ואבימלך פשוט רוצח אותם שעם האחים שלו על אבן אחת הוא שופך את הדם שלהם."
  },
  {
   "start": 827.86,
   "end": 832.54,
   "text": "כמה שאיפות, כמה האדם שמוכן לעשות הכל כדי להשיג את המטרות שלו,"
  },
  {
   "start": 833.0,
   "end": 834.1,
   "text": "זה כל כך מסוכן,"
  },
  {
   "start": 834.86,
   "end": 836.08,
   "text": "זה כל כך מסוכן."
  },
  {
   "start": 837.32,
   "end": 840.84,
   "text": "איש לא יעצור אותו, כך הוא חושב בדרכו לבנות את עתידו המזהיר."
  },
  {
   "start": 841.76,
   "end": 845.2,
   "text": "וגם רצח ושפיכות דמים למען האינטרס,"
  },
  {
   "start": 845.76,
   "end": 846.32,
   "text": "מותר."
  },
  {
   "start": 847.52,
   "end": 850.34,
   "text": "גם כשזה אחיך, מהבשר שלך, בני העם שלך,"
  },
  {
   "start": 850.76,
   "end": 852.82,
   "text": "למעשה הדם שלהם זורק מן האדמה,"
  },
  {
   "start": 853.14,
   "end": 856.16,
   "text": "אבל אבי מלך אוטם את אוזניו משמוע."
  },
  {
   "start": 856.62,
   "end": 858.46,
   "text": "הוא לא מוכן לשמוע שום דבר."
  },
  {
   "start": 859.32,
   "end": 861.88,
   "text": "כשאין אמונה, כשאין יראת שמיים,"
  },
  {
   "start": 862.44,
   "end": 863.64,
   "text": "אז אין גם אדם."
  },
  {
   "start": 865.26,
   "end": 869.88,
   "text": "אז אהדב נהיה חיה מסוכנת יותר גם מהחיות הטורפות שביער."
  },
  {
   "start": 875.62,
   "end": 877.84,
   "text": "אבימלך יוצא מבית הדמים בעופרה,"
  },
  {
   "start": 878.76,
   "end": 881.28,
   "text": "בטוח שהרג את כולם."
  },
  {
   "start": 883.61,
   "end": 887.93,
   "text": "כך, בלהט השפיכות דמים, הוא לא שם לב לדמות,"
  },
  {
   "start": 888.63,
   "end": 890.47,
   "text": "דמות שחומקת לה מן הבית,"
  },
  {
   "start": 891.19,
   "end": 892.35,
   "text": "בחסות החשיכה."
  },
  {
   "start": 892.97,
   "end": 897.43,
   "text": "היה זה יותם, יותם בן גדעון הצליח לברוח,"
  },
  {
   "start": 897.75,
   "end": 900.13,
   "text": "יותם בן גדעון הוא הניצול,"
  },
  {
   "start": 900.57,
   "end": 901.75,
   "text": "הוא הניצול היחידי."
  },
  {
   "start": 906.64,
   "end": 910.1,
   "text": "אבימלך חוזר אחרי סילוק המועמדים מדרכו,"
  },
  {
   "start": 911.54,
   "end": 912.46,
   "text": "ואנשי שכם,"
  },
  {
   "start": 913.22,
   "end": 914.38,
   "text": "במקום להתרחק ממנו,"
  },
  {
   "start": 914.8,
   "end": 919.24,
   "text": "במקום להבין לאיפה הגיע אותו מנהיג שלהם,"
  },
  {
   "start": 919.9,
   "end": 921.26,
   "text": "עד כמה הוא הרחיק לכת,"
  },
  {
   "start": 922.04,
   "end": 923.7,
   "text": "עד כמה זה מצער את השן,"
  },
  {
   "start": 924.32,
   "end": 926.28,
   "text": "עד כמה צריך להתרחק מאדם כמוהו,"
  },
  {
   "start": 927.74,
   "end": 930.54,
   "text": "הם לוקחים אותו, לוקחים אותו אל עץ אלון,"
  },
  {
   "start": 931.24,
   "end": 932.24,
   "text": "עץ אלון מיוחד."
  },
  {
   "start": 933.24,
   "end": 933.62,
   "text": "שם,"
  },
  {
   "start": 934.26,
   "end": 935.88,
   "text": "שם מתחת לעץ האלון,"
  },
  {
   "start": 936.86,
   "end": 942.4,
   "text": "לפני שנים קבר יעקב אבינו עליו השלום עבודה זרה,"
  },
  {
   "start": 943.0,
   "end": 944.9,
   "text": "את העבודה הזרה של העיר שכם,"
  },
  {
   "start": 945.34,
   "end": 948.02,
   "text": "אחרי שהיא הוכתה על ידי שמעון ולוי,"
  },
  {
   "start": 948.7,
   "end": 954.08,
   "text": "יעקב אסף את כל העבודה הזרה של אותה עיר וקבר אותה שמה תחת האלון,"
  },
  {
   "start": 954.64,
   "end": 955.14,
   "text": "ושם,"
  },
  {
   "start": 955.92,
   "end": 958.04,
   "text": "בחסות אותו עץ אלון,"
  },
  {
   "start": 958.78,
   "end": 961.86,
   "text": "שם באדמה שרוויה בעבודה זרה,"
  },
  {
   "start": 962.5,
   "end": 966.28,
   "text": "ממליכים, ממליכים את אבימלך עליהם."
  },
  {
   "start": 967.02,
   "end": 967.36,
   "text": "למה?"
  },
  {
   "start": 967.7,
   "end": 968.3,
   "text": "למה שם?"
  },
  {
   "start": 968.8,
   "end": 970.26,
   "text": "למה תחת העבודה זרה?"
  },
  {
   "start": 970.88,
   "end": 973.34,
   "text": "כדי להגביר את הכוח של עשית רעך,"
  },
  {
   "start": 973.68,
   "end": 975.76,
   "text": "כדי להגביר את הכוח של העבודה זרה,"
  },
  {
   "start": 976.14,
   "end": 977.6,
   "text": "להכניס בו יותר טומאה,"
  },
  {
   "start": 977.94,
   "end": 978.62,
   "text": "להעצים את כוחו."
  },
  {
   "start": 983.99,
   "end": 986.91,
   "text": "פעם בא תלמיד חכם לגאון רבי חיים קניבסקי,"
  },
  {
   "start": 987.43,
   "end": 988.25,
   "text": "אמר לו, תראה הרב,"
  },
  {
   "start": 988.25,
   "end": 997.81,
   "text": "עכשיו אני מנסה להקים ישיבה בעיר אחת בחוץ לארץ ואני לא מצליח. מה שאני עושה, כמה שאני משתדל, אני לא מצליח."
  },
  {
   "start": 1001.15,
   "end": 1010.23,
   "text": "הגאון רבי חיים קנייבסקי פתח ספר חסידים והראה לו שרשום שם בספר חסידים שבעיר הזאתי,"
  },
  {
   "start": 1011.17,
   "end": 1013.97,
   "text": "בדיוק זאת שהוא ניסה שם להקים ישיבה,"
  },
  {
   "start": 1014.65,
   "end": 1018.31,
   "text": "לא תהיה תורה כי יש בה כוח טומאה גדול מאוד."
  },
  {
   "start": 1019.19,
   "end": 1021.41,
   "text": "כמה האדם משפיע על הבריאה,"
  },
  {
   "start": 1022.37,
   "end": 1024.43,
   "text": "כמה האדם משפיע על הבריאה."
  },
  {
   "start": 1024.93,
   "end": 1026.21,
   "text": "אומר הזוהר הקדוש,"
  },
  {
   "start": 1026.79,
   "end": 1031.55,
   "text": "מסופר בזוהר הקדוש על רבי חייא ורבי יוסי שהיו מהלכים בדרך."
  },
  {
   "start": 1032.41,
   "end": 1033.51,
   "text": "אז הם פגשו איזה אדם,"
  },
  {
   "start": 1034.09,
   "end": 1034.47,
   "text": "והאדם"
  },
  {
   "start": 1035.89,
   "end": 1037.13,
   "text": "אמר להם, תעצרו כאן."
  },
  {
   "start": 1039.66,
   "end": 1041.3,
   "text": "הם אמרו לו, למה? למה לעצור?"
  },
  {
   "start": 1041.72,
   "end": 1045.6,
   "text": "אמר להם, תראו, אני מציע לכם לעקוף את הדרך,"
  },
  {
   "start": 1045.94,
   "end": 1049.6,
   "text": "לעקוף את המקום עכשיו שאתם רוצים ללכת, המקום שתכננתם לעבור דרכו."
  },
  {
   "start": 1049.9,
   "end": 1050.42,
   "text": "תעקפו."
  },
  {
   "start": 1051.08,
   "end": 1052.08,
   "text": "אמרו לו, למה שנעקוף?"
  },
  {
   "start": 1052.74,
   "end": 1054.04,
   "text": "זה הרי מאריך לנו את הדרך."
  },
  {
   "start": 1054.66,
   "end": 1056.6,
   "text": "מאריך לנו את הדרך לפחות באיזה שעה וחצי."
  },
  {
   "start": 1057.06,
   "end": 1058.0,
   "text": "מה פתאום שנאריך?"
  },
  {
   "start": 1059.34,
   "end": 1061.06,
   "text": "אמר להם אותו אדם, שם."
  },
  {
   "start": 1062.32,
   "end": 1064.16,
   "text": "בדיוק בדרך הרי אתם עוברים דרך היער."
  },
  {
   "start": 1064.62,
   "end": 1067.46,
   "text": "עבר תלמיד חכם, ולפתע התנפל עליו."
  },
  {
   "start": 1068.16,
   "end": 1068.78,
   "text": "שודד."
  },
  {
   "start": 1069.82,
   "end": 1071.6,
   "text": "ורצח אותו באכזריות."
  },
  {
   "start": 1072.56,
   "end": 1073.68,
   "text": "מאז המקום הזה,"
  },
  {
   "start": 1074.24,
   "end": 1075.6,
   "text": "זה מקום של סכנה."
  },
  {
   "start": 1076.28,
   "end": 1079.18,
   "text": "הדם שנשפך שם, העבירה שנעשתה שם,"
  },
  {
   "start": 1079.52,
   "end": 1083.44,
   "text": "משפיעה על המקום, אז אני מבקש מכם, אל תעבוד עכשיו."
  },
  {
   "start": 1093.56,
   "end": 1094.24,
   "text": "האמרי חיים"
  },
  {
   "start": 1096.86,
   "end": 1097.72,
   "text": "מווישניץ,"
  },
  {
   "start": 1098.18,
   "end": 1100.7,
   "text": "זצה לאדמוו מווישניץ, הגיע לארצות הברית."
  },
  {
   "start": 1101.92,
   "end": 1104.5,
   "text": "הוא ניסה שם להקים קריה לפליטי שואה."
  },
  {
   "start": 1105.48,
   "end": 1106.32,
   "text": "זה היה אחרי השואה."
  },
  {
   "start": 1107.96,
   "end": 1109.8,
   "text": "עכשיו, הוא קצת לא הרגיש כל כך טוב,"
  },
  {
   "start": 1110.36,
   "end": 1111.16,
   "text": "אז על פי הרופאים,"
  },
  {
   "start": 1111.86,
   "end": 1115.9,
   "text": "הרופאים דרשו ממנו כדי להבריא את גופו שיצא לטיול."
  },
  {
   "start": 1116.5,
   "end": 1118.62,
   "text": "כל יום, שעה של טיול רגלי."
  },
  {
   "start": 1119.68,
   "end": 1123.88,
   "text": "אז הוא ביקש לקחת איתו לטיול רגלי כיסא מתקפל."
  },
  {
   "start": 1125.68,
   "end": 1130.46,
   "text": "השמש של הרב לקח את הכיסא מתקפל והלך עם הרב ביחד,"
  },
  {
   "start": 1131.18,
   "end": 1132.08,
   "text": "ביחד לטיול."
  },
  {
   "start": 1133.14,
   "end": 1135.68,
   "text": "ככה הם הולכים כל יום, שעה הליכה."
  },
  {
   "start": 1136.22,
   "end": 1139.16,
   "text": "כל פעם שהרב היה עייף, נעמד,"
  },
  {
   "start": 1139.52,
   "end": 1141.42,
   "text": "השמש פותח את הכיסא,"
  },
  {
   "start": 1141.78,
   "end": 1143.08,
   "text": "הוא יושב על הכיסא נח,"
  },
  {
   "start": 1143.56,
   "end": 1146.38,
   "text": "עשר דקות, קם אחרי זה, ממשיך בטיול."
  },
  {
   "start": 1147.1,
   "end": 1150.26,
   "text": "יום אחד פנה אליו הגבאי ואמר לו, כבוד הרב, אני רוצה להבין."
  },
  {
   "start": 1151.04,
   "end": 1151.54,
   "text": "כבוד הרב,"
  },
  {
   "start": 1152.2,
   "end": 1153.74,
   "text": "אני לא אכפת לי לסחוב את הכיסא,"
  },
  {
   "start": 1154.36,
   "end": 1155.7,
   "text": "אבל הרב, אני רוצה להבין,"
  },
  {
   "start": 1156.12,
   "end": 1161.06,
   "text": "הרי יש הרבה ספסלים פזורים לאורך כל הטיילת, אנחנו מטיילים בטיילת,"
  },
  {
   "start": 1161.48,
   "end": 1164.72,
   "text": "יש שם ספסלים מצד ימין ומצד שמאל,"
  },
  {
   "start": 1165.26,
   "end": 1168.26,
   "text": "משני הצדדים יש ספסלים, למה הרב לא יושב על הספסלים?"
  },
  {
   "start": 1168.68,
   "end": 1170.04,
   "text": "למה צריך לסחוב את הכיסא?"
  },
  {
   "start": 1171.54,
   "end": 1173.48,
   "text": "אמר לו הרב, אם קשה לך,"
  },
  {
   "start": 1174.06,
   "end": 1175.52,
   "text": "אני אסחוב את הכיסא בעצמי."
  },
  {
   "start": 1175.94,
   "end": 1176.6,
   "text": "אמר לו הגבאי,"
  },
  {
   "start": 1177.06,
   "end": 1180.28,
   "text": "הרב לא, אני רק רוצה לדעת, רק רוצה להבין."
  },
  {
   "start": 1182.44,
   "end": 1183.08,
   "text": "ענה לו הרב,"
  },
  {
   "start": 1184.62,
   "end": 1185.92,
   "text": "אתה רוצה לדעת למה?"
  },
  {
   "start": 1187.14,
   "end": 1187.9,
   "text": "תדע לך,"
  },
  {
   "start": 1188.4,
   "end": 1191.12,
   "text": "כאן בארצות הברית, כאן בין הגויים,"
  },
  {
   "start": 1191.78,
   "end": 1194.16,
   "text": "מי יודע מי ישב על הספסלים?"
  },
  {
   "start": 1195.22,
   "end": 1198.48,
   "text": "מי יודע וכי אני יודע מי ישב על הספסלים?"
  },
  {
   "start": 1198.94,
   "end": 1199.46,
   "text": "מה הוא חשב?"
  },
  {
   "start": 1200.38,
   "end": 1200.94,
   "text": "מה הוא עשה?"
  },
  {
   "start": 1202.28,
   "end": 1203.38,
   "text": "מי הבן אדם הזה?"
  },
  {
   "start": 1204.48,
   "end": 1205.64,
   "text": "איזה מחשבות היו לו?"
  },
  {
   "start": 1206.58,
   "end": 1208.0,
   "text": "איזה עבירות הוא עבר."
  },
  {
   "start": 1209.78,
   "end": 1210.7,
   "text": "אני פשוט"
  },
  {
   "start": 1211.82,
   "end": 1212.96,
   "text": "לא רוצה להידבק,"
  },
  {
   "start": 1214.08,
   "end": 1215.78,
   "text": "לכן אני לא יושב על הספסלים האלה."
  },
  {
   "start": 1217.22,
   "end": 1220.2,
   "text": "עד כדי כך, כוח השפעה של מקום."
  },
  {
   "start": 1221.78,
   "end": 1223.44,
   "text": "כוח השפעה של מקום."
  },
  {
   "start": 1224.38,
   "end": 1225.1,
   "text": "ולכן,"
  },
  {
   "start": 1226.2,
   "end": 1227.56,
   "text": "בואו נחזור לעיר שכם."
  },
  {
   "start": 1228.4,
   "end": 1233.96,
   "text": "העיר שכם בוחרת באבימלך שרצח את אחיו, שבעים אחים."
  },
  {
   "start": 1237.02,
   "end": 1238.8,
   "text": "הוא נבחר למנהיג של שכם,"
  },
  {
   "start": 1239.46,
   "end": 1240.18,
   "text": "ולא רק זה,"
  },
  {
   "start": 1240.76,
   "end": 1243.64,
   "text": "אלא העיר שכם מעצימה את כוחו על ידי טומאה,"
  },
  {
   "start": 1244.0,
   "end": 1245.08,
   "text": "על ידי עבודה זרה,"
  },
  {
   "start": 1245.98,
   "end": 1249.44,
   "text": "וכוחות רשע קדמוניים מתעוררים מהם."
  },
  {
   "start": 1251.95,
   "end": 1253.15,
   "text": "בואו נחזור שנים אחורה,"
  },
  {
   "start": 1253.81,
   "end": 1255.79,
   "text": "אומר הרמק, רבי משה קורדוברו,"
  },
  {
   "start": 1258.21,
   "end": 1258.79,
   "text": "רבקה,"
  },
  {
   "start": 1260.61,
   "end": 1263.97,
   "text": "רבקה אמנו לוקחת את שתי הבנים שלה,"
  },
  {
   "start": 1264.33,
   "end": 1266.51,
   "text": "את יעקב ואת עשיו,"
  },
  {
   "start": 1266.97,
   "end": 1268.03,
   "text": "לטיול בשדה."
  },
  {
   "start": 1269.01,
   "end": 1269.65,
   "text": "היא מתפללת,"
  },
  {
   "start": 1270.43,
   "end": 1271.51,
   "text": "והם מטיילים הילדים."
  },
  {
   "start": 1272.31,
   "end": 1273.71,
   "text": "ושם היא מוצאת מערה,"
  },
  {
   "start": 1274.59,
   "end": 1278.97,
   "text": "והם נכנסים למערה ומוצאים במערה גופה,"
  },
  {
   "start": 1279.55,
   "end": 1280.73,
   "text": "גופה של אדם,"
  },
  {
   "start": 1281.37,
   "end": 1282.51,
   "text": "אדם עם הרבה שאיפות,"
  },
  {
   "start": 1283.13,
   "end": 1286.15,
   "text": "אדם עם הרבה עבירות, את גופתו של נמרוד."
  },
  {
   "start": 1287.05,
   "end": 1287.89,
   "text": "כתר בראשו,"
  },
  {
   "start": 1288.69,
   "end": 1291.85,
   "text": "ובידו חרב, ובא השם המפורש,"
  },
  {
   "start": 1294.56,
   "end": 1295.44,
   "text": "את הכתר,"
  },
  {
   "start": 1296.36,
   "end": 1297.18,
   "text": "את החרב,"
  },
  {
   "start": 1297.78,
   "end": 1299.38,
   "text": "היא נתנה ביד יעקב."
  },
  {
   "start": 1300.48,
   "end": 1302.92,
   "text": "ואת הלבוש של נמרוד לעשו."
  },
  {
   "start": 1304.14,
   "end": 1306.56,
   "text": "למעשה כל אלו היו של אדם הראשון."
  },
  {
   "start": 1307.08,
   "end": 1310.94,
   "text": "נמרוד לקח אותם למעשה מהאדם הראשון,"
  },
  {
   "start": 1311.48,
   "end": 1314.28,
   "text": "וכך הוא שלט בכל העולם האלה מכוחות עצומים."
  },
  {
   "start": 1317.52,
   "end": 1318.32,
   "text": "יותר מאוחר,"
  },
  {
   "start": 1319.08,
   "end": 1319.94,
   "text": "כשבא יעקב"
  },
  {
   "start": 1321.52,
   "end": 1323.52,
   "text": "ורוצה מעשו את הבכורה,"
  },
  {
   "start": 1327.54,
   "end": 1330.66,
   "text": "עשו התנה תנאי עם יעקב."
  },
  {
   "start": 1331.06,
   "end": 1333.08,
   "text": "הוא אמר לו, תראה, תמורת הבכורה,"
  },
  {
   "start": 1335.17,
   "end": 1336.27,
   "text": "תמורת הבכורה,"
  },
  {
   "start": 1337.21,
   "end": 1339.33,
   "text": "תיתן לי את אותה חרב,"
  },
  {
   "start": 1339.89,
   "end": 1342.77,
   "text": "חרב דמים, שקיבל מאימא רבקה."
  },
  {
   "start": 1343.91,
   "end": 1344.39,
   "text": "וכן,"
  },
  {
   "start": 1344.97,
   "end": 1349.39,
   "text": "אני רוצה גם לקבל חלק קטן בארץ ישראל, שיהיה שלי."
  },
  {
   "start": 1349.83,
   "end": 1352.95,
   "text": "עשיו איש הדמים מבקש חלק קטן בארץ ישראל,"
  },
  {
   "start": 1353.33,
   "end": 1354.11,
   "text": "שיהיה שלו."
  },
  {
   "start": 1354.69,
   "end": 1355.95,
   "text": "ויעקב נותן לו,"
  },
  {
   "start": 1356.69,
   "end": 1357.45,
   "text": "נותן לו חלק,"
  },
  {
   "start": 1357.89,
   "end": 1360.29,
   "text": "נותן לו עיר אחת מארץ ישראל,"
  },
  {
   "start": 1361.23,
   "end": 1363.15,
   "text": "עיר שקוראים לה שכן."
  },
  {
   "start": 1364.01,
   "end": 1366.61,
   "text": "עיר של דמים, עיר של פורענות."
  },
  {
   "start": 1366.67,
   "end": 1370.77,
   "text": "שכם היא מחלקו של עשיו,"
  },
  {
   "start": 1371.31,
   "end": 1375.69,
   "text": "לכן שכם היא עיר שמועדת לפורענות,"
  },
  {
   "start": 1375.99,
   "end": 1380.67,
   "text": "עיר של דמים שעכשיו מתעוררת לה שוב לחיים."
  }
 ]
}