{
 "disc": "11יא- לתת",
 "track": "Track06",
 "duration": 169.176,
 "segments": [
  {
   "start": 1.44,
   "end": 2.32,
   "text": "רבי יעקב נאמן,"
  },
  {
   "start": 3.76,
   "end": 4.94,
   "text": "ראש ישיבה בארצות הברית,"
  },
  {
   "start": 6.14,
   "end": 7.04,
   "text": "כשהלך לבית עולמו,"
  },
  {
   "start": 8.7,
   "end": 9.0,
   "text": "באו"
  },
  {
   "start": 9.84,
   "end": 11.14,
   "text": "תלמידיו בהמוניהם"
  },
  {
   "start": 13.26,
   "end": 14.26,
   "text": "לנחם את רעייתו."
  },
  {
   "start": 15.0,
   "end": 16.0,
   "text": "לא היו להם ילדים,"
  },
  {
   "start": 17.1,
   "end": 17.96,
   "text": "התלמידים באו"
  },
  {
   "start": 18.82,
   "end": 20.3,
   "text": "לשמש כמעין ילדים."
  },
  {
   "start": 21.98,
   "end": 25.24,
   "text": "תלמידיו של האדם הם מעין ילדיו הרוחניים,"
  },
  {
   "start": 29.2,
   "end": 33.14,
   "text": "וכל אחד אומר דבר תורה כמה שניתן."
  },
  {
   "start": 34.28,
   "end": 34.68,
   "text": "ואז,"
  },
  {
   "start": 35.48,
   "end": 44.53,
   "text": "ביום האחרון לפתע באה אלמנה וביקשה לדבר,"
  },
  {
   "start": 47.24,
   "end": 47.88,
   "text": "והיא פנתה,"
  },
  {
   "start": 50.64,
   "end": 52.82,
   "text": "פנתה לתלמידים ואמרה להם, תדעו לכם."
  },
  {
   "start": 54.86,
   "end": 56.82,
   "text": "אתם בטח הכרתם את בעלי,"
  },
  {
   "start": 57.44,
   "end": 58.92,
   "text": "הכרתם את ראש הישיבה בלימוד,"
  },
  {
   "start": 61.68,
   "end": 64.02,
   "text": "בהנהגה עם התלמידים, בתפילה,"
  },
  {
   "start": 66.74,
   "end": 69.06,
   "text": "אבל מבחינה אישית לא הכרתם אותו."
  },
  {
   "start": 69.72,
   "end": 71.4,
   "text": "אני יכולה להגיד דבר אחד,"
  },
  {
   "start": 71.94,
   "end": 73.06,
   "text": "ממנו תבינו את הכול."
  },
  {
   "start": 78.27,
   "end": 81.55,
   "text": "אנחנו נשואים היינו יותר מ-25 שנה הרבה יותר."
  },
  {
   "start": 86.64,
   "end": 88.08,
   "text": "ולא היה לנו ילדים."
  },
  {
   "start": 89.88,
   "end": 90.68,
   "text": "כמה זה קשה."
  },
  {
   "start": 97.87,
   "end": 98.97,
   "text": "ולמרות שהיה קשה,"
  },
  {
   "start": 101.79,
   "end": 104.87,
   "text": "אני הייתי עושה את הפעילות חסד, הייתי עושה פעילות חסד מפעלי חסד."
  },
  {
   "start": 105.99,
   "end": 106.65,
   "text": "והוא היה בישיבה."
  },
  {
   "start": 107.83,
   "end": 109.05,
   "text": "וכשהוא היה חוזר הביתה,"
  },
  {
   "start": 111.63,
   "end": 113.55,
   "text": "כל לילה כשהייתי חוזרת הביתה,"
  },
  {
   "start": 114.59,
   "end": 115.53,
   "text": "הוא היה מחכה לי"
  },
  {
   "start": 116.47,
   "end": 117.67,
   "text": "עם שני כוסות קפה"
  },
  {
   "start": 118.87,
   "end": 119.37,
   "text": "ועוגה"
  },
  {
   "start": 121.69,
   "end": 122.85,
   "text": "מקבל את פניי"
  },
  {
   "start": 123.45,
   "end": 124.15,
   "text": "ללא מילה,"
  },
  {
   "start": 130.56,
   "end": 131.94,
   "text": "עם אותו לב, אותו חיוך,"
  },
  {
   "start": 133.22,
   "end": 136.06,
   "text": "מקבל את פניי כל לילה."
  },
  {
   "start": 137.72,
   "end": 141.3,
   "text": "26 שנה ללא שום מילה,"
  },
  {
   "start": 142.2,
   "end": 142.98,
   "text": "ללא שום הארה."
  },
  {
   "start": 144.46,
   "end": 145.8,
   "text": "מעולם הוא לא אמר משהו,"
  },
  {
   "start": 146.34,
   "end": 150.34,
   "text": "מעולם לא הייתה לו מורת רוח על זה שאין לנו ילדים,"
  },
  {
   "start": 153.58,
   "end": 154.48,
   "text": "ללא שום מילה."
  },
  {
   "start": 157.78,
   "end": 159.74,
   "text": "את כל הלב שלו הוא נתן"
  },
  {
   "start": 160.84,
   "end": 161.44,
   "text": "מתן עבורי."
  }
 ]
}