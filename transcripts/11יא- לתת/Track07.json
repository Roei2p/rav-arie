{
 "disc": "11יא- לתת",
 "track": "Track07",
 "duration": 704.16,
 "segments": [
  {
   "start": 24.63,
   "end": 25.41,
   "text": "שלמה ורבקה"
  },
  {
   "start": 26.33,
   "end": 27.23,
   "text": "היו זוג נפלא."
  },
  {
   "start": 28.65,
   "end": 36.39,
   "text": "נירת שמיים וצדקה חברו להם יחדיו ומילאו את ביתם הגדול באור יקרות."
  },
  {
   "start": 37.97,
   "end": 39.61,
   "text": "אבל האור הזה היה קצת עמום."
  },
  {
   "start": 40.51,
   "end": 40.93,
   "text": "למה?"
  },
  {
   "start": 41.53,
   "end": 42.57,
   "text": "כי לא היו להם ילדים."
  },
  {
   "start": 44.53,
   "end": 48.49,
   "text": "שלמה ורבקה היו מבאי ביתו של אור שבעת הימים."
  },
  {
   "start": 49.79,
   "end": 51.05,
   "text": "רבי ישראל הבעל שם טוב,"
  },
  {
   "start": 51.05,
   "end": 60.31,
   "text": "מזה עשרים שנה אין להם ילדים והבעל שם טוב מעולם לא בירך אותם בפרי בטן."
  },
  {
   "start": 61.47,
   "end": 65.95,
   "text": "כאילו הוא חתום בשמיים גזר דין שלשלמה ורבקה לא יהיה פרי בטן, לא יהיה ילדים."
  },
  {
   "start": 69.21,
   "end": 70.93,
   "text": "הם באו אליו כאובים ועצובים."
  },
  {
   "start": 72.69,
   "end": 72.89,
   "text": "הרב,"
  },
  {
   "start": 73.61,
   "end": 74.95,
   "text": "מה שווה לנו כל הכסף,"
  },
  {
   "start": 75.65,
   "end": 76.33,
   "text": "כל העושר,"
  },
  {
   "start": 76.85,
   "end": 80.71,
   "text": "כשאחרי מותנו לא יישאר מאיתנו זכר כי אין לנו בנים,"
  },
  {
   "start": 81.15,
   "end": 82.01,
   "text": "כי אין לנו בנות."
  },
  {
   "start": 89.22,
   "end": 90.2,
   "text": "הבעל שם טוב קם,"
  },
  {
   "start": 91.54,
   "end": 93.12,
   "text": "ניגש אל החלון שממול,"
  },
  {
   "start": 94.1,
   "end": 96.7,
   "text": "הביט מהורהר מבעד לחלון,"
  },
  {
   "start": 99.16,
   "end": 104.18,
   "text": "ואז הוא פנה לשלמה ורבקה, בני הזוג היקרים, ואמר להם, תדעו לכם, מחר"
  },
  {
   "start": 104.96,
   "end": 109.22,
   "text": "תצאו למקום מסוים על פי המפה שנכין עבורכם."
  },
  {
   "start": 110.1,
   "end": 112.84,
   "text": "אתם תיסעו ותגיעו לאותו מקום,"
  },
  {
   "start": 113.84,
   "end": 114.24,
   "text": "ושם,"
  },
  {
   "start": 114.92,
   "end": 118.1,
   "text": "שם הקדוש ברוך הוא ינחה אתכם בדרך הנכונה."
  },
  {
   "start": 118.94,
   "end": 121.48,
   "text": "והם נסעו, הם יצאו לדרך."
  },
  {
   "start": 124.65,
   "end": 125.81,
   "text": "למחרת בבוקר,"
  },
  {
   "start": 126.59,
   "end": 127.39,
   "text": "שלמה ורבקה"
  },
  {
   "start": 128.37,
   "end": 131.63,
   "text": "עשו את דרכם על פי המפה שהם קיבלו."
  },
  {
   "start": 134.04,
   "end": 135.02,
   "text": "ניקץ מספר ימים."
  },
  {
   "start": 136.44,
   "end": 138.72,
   "text": "הם עמדו בפאתי העיר"
  },
  {
   "start": 140.12,
   "end": 141.1,
   "text": "ולא ידעו מה לעשות."
  },
  {
   "start": 142.36,
   "end": 145.92,
   "text": "מה יש להם כאן לראות שינחה אותם בדרך הנכונה?"
  },
  {
   "start": 150.62,
   "end": 155.04,
   "text": "והנה בפתח העיר הייתה לה קבוצת ילדים ששיחקה לה בחול,"
  },
  {
   "start": 158.0,
   "end": 160.24,
   "text": "ברוך משה! צעק ילד אחד, תמסור גם לי!"
  },
  {
   "start": 161.22,
   "end": 162.82,
   "text": "טוב ברוך משה! פנה השני."
  },
  {
   "start": 165.01,
   "end": 166.25,
   "text": "משה ברוך, תביא לי!"
  },
  {
   "start": 167.53,
   "end": 169.19,
   "text": "שלמה התקרב אל הקבוצה."
  },
  {
   "start": 170.37,
   "end": 171.57,
   "text": "היה קצת משהו מוזר שם."
  },
  {
   "start": 172.77,
   "end": 174.39,
   "text": "הוא שאל, סלח לי ילד, מה השם שלך?"
  },
  {
   "start": 175.33,
   "end": 175.81,
   "text": "משה ברוך."
  },
  {
   "start": 177.51,
   "end": 179.55,
   "text": "ועתה ילד פנה לילד אחר, מה השם שלך?"
  },
  {
   "start": 180.65,
   "end": 181.33,
   "text": "ברוך משה."
  },
  {
   "start": 183.09,
   "end": 185.73,
   "text": "שלמה נדהם לגלות שכולם קרויים באותו שם."
  },
  {
   "start": 188.38,
   "end": 189.28,
   "text": "ובצד השני,"
  },
  {
   "start": 190.88,
   "end": 195.04,
   "text": "גילתה רבקה רעייתו שכל הבנות"
  },
  {
   "start": 195.78,
   "end": 197.94,
   "text": "נקראות באותו שם, ברכה לאה,"
  },
  {
   "start": 200.32,
   "end": 202.78,
   "text": "ושלמה ורבקה הביטו זה בזה בתימהון."
  },
  {
   "start": 211.13,
   "end": 218.91,
   "text": "יומיים לקח להם להבין שלא רק קבוצת הילדים שהם פגשו שמה בהתחלת העיר נשאו את אותו שם."
  },
  {
   "start": 220.41,
   "end": 223.63,
   "text": "גם בתלמודי התורה כל הילדים והילדות"
  },
  {
   "start": 224.43,
   "end": 225.27,
   "text": "בני אותו שם."
  },
  {
   "start": 226.15,
   "end": 227.05,
   "text": "גם בישיבות"
  },
  {
   "start": 227.63,
   "end": 230.35,
   "text": "כל הנערים בני אותו שם."
  },
  {
   "start": 231.59,
   "end": 232.01,
   "text": "הם לא הבינו,"
  },
  {
   "start": 232.87,
   "end": 233.51,
   "text": "הם היו מבולבלים."
  },
  {
   "start": 235.31,
   "end": 235.87,
   "text": "מה הם עשו?"
  },
  {
   "start": 236.65,
   "end": 238.31,
   "text": "הם פנו אל ביתו של זקן העיר,"
  },
  {
   "start": 238.89,
   "end": 241.49,
   "text": "מבקשים לדעת את פשר התעלומה."
  },
  {
   "start": 245.49,
   "end": 246.63,
   "text": "זקן העיר התיישב,"
  },
  {
   "start": 248.78,
   "end": 249.62,
   "text": "וכך הוא סיפר."
  },
  {
   "start": 255.1,
   "end": 255.98,
   "text": "לפני כמאה שנה"
  },
  {
   "start": 256.86,
   "end": 257.72,
   "text": "נולד יהודי"
  },
  {
   "start": 259.02,
   "end": 260.46,
   "text": "בעיר ושמו ברוך משה."
  },
  {
   "start": 261.78,
   "end": 263.14,
   "text": "כשהוא התחיל ללמוד בתלמוד תורה,"
  },
  {
   "start": 263.9,
   "end": 264.96,
   "text": "התברר שברוך משה"
  },
  {
   "start": 265.96,
   "end": 267.14,
   "text": "יש לו לב זהב,"
  },
  {
   "start": 268.18,
   "end": 269.06,
   "text": "נשמה טהורה,"
  },
  {
   "start": 270.06,
   "end": 270.84,
   "text": "אבל ללמוד,"
  },
  {
   "start": 271.62,
   "end": 272.96,
   "text": "ללמוד הוא לא היה מסוגל."
  },
  {
   "start": 274.06,
   "end": 275.84,
   "text": "הוא התאמץ, השתדל, אבל לא היה מסוגל."
  },
  {
   "start": 277.0,
   "end": 278.52,
   "text": "לא היה את היכולת, לא היה לו את היכולת."
  },
  {
   "start": 281.13,
   "end": 285.31,
   "text": "אחרי שנים של מאמצים הוא הופנה על ידי אבא שלו להיות קצב,"
  },
  {
   "start": 286.71,
   "end": 288.51,
   "text": "וכך הוא גדל לו בחנות של אבא,"
  },
  {
   "start": 290.8,
   "end": 291.5,
   "text": "ואחר כך,"
  },
  {
   "start": 292.68,
   "end": 298.06,
   "text": "כשהתבגר החליף את אבא שלו ועשה חי,"
  },
  {
   "start": 298.14,
   "end": 299.66,
   "text": "להצליח בעסקי הבשר."
  },
  {
   "start": 301.54,
   "end": 304.9,
   "text": "נהיה קצב מספר אחד, אטליז גדול ומפואר."
  },
  {
   "start": 306.74,
   "end": 308.52,
   "text": "לימים הוא נשא אישה,"
  },
  {
   "start": 309.44,
   "end": 310.0,
   "text": "ברך עליה,"
  },
  {
   "start": 310.68,
   "end": 313.18,
   "text": "יהודייה כשרה ונפלאה, פשוטה,"
  },
  {
   "start": 314.32,
   "end": 316.98,
   "text": "אבל עם טוב לב מיוחד במינו."
  },
  {
   "start": 317.96,
   "end": 319.84,
   "text": "וככה הם חיו להם בשמחה ורוגע."
  },
  {
   "start": 322.52,
   "end": 324.08,
   "text": "וכשנפטרו ההורים שלו,"
  },
  {
   "start": 326.26,
   "end": 327.32,
   "text": "הלך ברוך משה,"
  },
  {
   "start": 327.54,
   "end": 330.18,
   "text": "שכר לו מלמד מיוחד שילמדו קצת תורה,"
  },
  {
   "start": 330.84,
   "end": 332.9,
   "text": "הוא רצה ללמוד לעילוי נשמתם של ההורים,"
  },
  {
   "start": 334.08,
   "end": 334.94,
   "text": "אבל זה לא עזר לו."
  },
  {
   "start": 335.84,
   "end": 336.24,
   "text": "הוא לא מצליח,"
  },
  {
   "start": 336.66,
   "end": 337.98,
   "text": "הוא לא מסתדר עם הלימוד,"
  },
  {
   "start": 338.24,
   "end": 339.62,
   "text": "כמו שהיה קטן גם עכשיו."
  },
  {
   "start": 345.91,
   "end": 346.45,
   "text": "בני הזוג,"
  },
  {
   "start": 347.47,
   "end": 349.95,
   "text": "בני הזוג הנפלאים האלה שירבו בצדקה וחסד,"
  },
  {
   "start": 350.97,
   "end": 352.61,
   "text": "שקעו להם בצער גדול."
  },
  {
   "start": 354.03,
   "end": 355.43,
   "text": "ברוך משה לא יודע ללמוד,"
  },
  {
   "start": 357.73,
   "end": 359.29,
   "text": "ואפילו ילדים אין להם."
  },
  {
   "start": 360.71,
   "end": 361.45,
   "text": "אז מה יהיה גורלם?"
  },
  {
   "start": 364.65,
   "end": 367.29,
   "text": "וכך יושב לו ברוך משה הקצב בבית הכנסת בשבת,"
  },
  {
   "start": 368.21,
   "end": 374.17,
   "text": "ושומע את הרב אומר כל המלמד את בנו של חברו תורה כאילו ילד אותו."
  },
  {
   "start": 376.66,
   "end": 378.44,
   "text": "והמילים הדהדו לו לברוך משה."
  },
  {
   "start": 379.16,
   "end": 379.4,
   "text": "בסוף התפילה,"
  },
  {
   "start": 380.64,
   "end": 382.0,
   "text": "כשכולם הלכו לבתיהם,"
  },
  {
   "start": 382.98,
   "end": 385.72,
   "text": "נותר לו ברוך משה נטוע על מקומו בבית הכנסת,"
  },
  {
   "start": 386.54,
   "end": 389.44,
   "text": "כשדמעות חמות זולגות על פניו."
  },
  {
   "start": 391.93,
   "end": 392.55,
   "text": "ברוך משה,"
  },
  {
   "start": 393.31,
   "end": 396.19,
   "text": "ברוך משה, למה אתה כל כך בצער? שאל אותו הרב,"
  },
  {
   "start": 396.63,
   "end": 397.67,
   "text": "כשראה את הכאב שלו."
  },
  {
   "start": 398.63,
   "end": 401.47,
   "text": "הרב, אני כואב, הרב, קשה לי."
  },
  {
   "start": 402.05,
   "end": 403.05,
   "text": "לא רק שאין לי בנים,"
  },
  {
   "start": 403.59,
   "end": 405.17,
   "text": "לא רק שאין לי בנות משלי,"
  },
  {
   "start": 405.63,
   "end": 408.27,
   "text": "אפילו ללמד ילדים של אחרים אני לא יכול."
  },
  {
   "start": 409.49,
   "end": 410.41,
   "text": "אני לא יודע גם ללמוד."
  },
  {
   "start": 414.17,
   "end": 414.65,
   "text": "הלו, הרב,"
  },
  {
   "start": 416.05,
   "end": 418.81,
   "text": "אם אתה לא יכול ללמד בעצמך ילדים של אחרים,"
  },
  {
   "start": 419.45,
   "end": 421.93,
   "text": "תוכל לזכור מלמד עבור ילד של אדם אחר,"
  },
  {
   "start": 422.69,
   "end": 423.61,
   "text": "מאחינו היהודים."
  },
  {
   "start": 424.99,
   "end": 426.21,
   "text": "וכל ישראל הערבים,"
  },
  {
   "start": 426.87,
   "end": 428.25,
   "text": "תחשב לך הזכות הזו,"
  },
  {
   "start": 428.93,
   "end": 429.89,
   "text": "כאילו היית אבא שלו,"
  },
  {
   "start": 430.45,
   "end": 434.99,
   "text": "כאילו אתה, אתה לימדת אותו, אתה גידלת אותו, אתה ילדת אותו."
  },
  {
   "start": 437.79,
   "end": 438.63,
   "text": "אמר הרב והלך."
  },
  {
   "start": 440.71,
   "end": 443.29,
   "text": "איש לא האמין עד כמה דבריו של הרב"
  },
  {
   "start": 443.95,
   "end": 449.69,
   "text": "נפעלו בקרב הלב החם הפשוט והאוהב של ברוך משה וברכה עליה."
  },
  {
   "start": 453.49,
   "end": 460.99,
   "text": "תוך חודש הם שכרו שלושים מלמדים עבור כל הילדים של הסביבה."
  },
  {
   "start": 462.47,
   "end": 462.99,
   "text": "ומאז"
  },
  {
   "start": 462.99,
   "end": 468.25,
   "text": "כל הכסף שלהם היה מוקדש לחינוך ילדי העיר."
  },
  {
   "start": 472.52,
   "end": 473.64,
   "text": "נבנו תלמודי תורה,"
  },
  {
   "start": 474.5,
   "end": 475.5,
   "text": "נבנו מדרשיות,"
  },
  {
   "start": 476.14,
   "end": 476.54,
   "text": "ישיבות,"
  },
  {
   "start": 477.72,
   "end": 478.52,
   "text": "בזכותם."
  },
  {
   "start": 480.2,
   "end": 481.1,
   "text": "עברו שנים,"
  },
  {
   "start": 481.82,
   "end": 484.16,
   "text": "כל ילד וילדה בעיר זכו לחינוך נפלא."
  },
  {
   "start": 485.92,
   "end": 486.5,
   "text": "ערב אחד,"
  },
  {
   "start": 488.72,
   "end": 489.76,
   "text": "בתום מסיבת סידור,"
  },
  {
   "start": 490.58,
   "end": 492.38,
   "text": "באחד מתלמודי התורה שהם פתחו."
  },
  {
   "start": 501.65,
   "end": 505.11,
   "text": "היתה שמחה כל כך גדולה, כולם שמחים, מסיבת סידור,"
  },
  {
   "start": 505.63,
   "end": 510.35,
   "text": "והיו שם גם ברכה לאה וברוך משה."
  },
  {
   "start": 513.01,
   "end": 516.25,
   "text": "בסוף המסיבה התקרבה ברכה לאה לבעלה ואמרה לו,"
  },
  {
   "start": 517.03,
   "end": 518.33,
   "text": "אמרה לו בבכי,"
  },
  {
   "start": 521.11,
   "end": 521.83,
   "text": "אישי היקר,"
  },
  {
   "start": 522.55,
   "end": 526.81,
   "text": "מי מהילדים האלו יזכור אותנו כשנהיה שם למעלה?"
  },
  {
   "start": 529.15,
   "end": 530.33,
   "text": "אל תבכי ברכה לאה,"
  },
  {
   "start": 530.87,
   "end": 533.05,
   "text": "תראי סביב את כל הילדים שלך,"
  },
  {
   "start": 533.35,
   "end": 534.69,
   "text": "את כל הילדות שלך."
  },
  {
   "start": 535.07,
   "end": 537.05,
   "text": "אנא לה ברוך משה בעלה ברכות."
  },
  {
   "start": 537.97,
   "end": 541.57,
   "text": "הם היו בטוחים שאף אחד לא שמע את דבריהם,"
  },
  {
   "start": 542.79,
   "end": 544.35,
   "text": "אבל שמעו את דבריהם."
  },
  {
   "start": 545.07,
   "end": 550.21,
   "text": "ילדים מקרב התלמוד תורה שמעו ושמרו את הדברים בליבם."
  },
  {
   "start": 555.87,
   "end": 557.17,
   "text": "לפני כעשרים שנה,"
  },
  {
   "start": 559.29,
   "end": 560.41,
   "text": "סיפר זקן העיר,"
  },
  {
   "start": 562.79,
   "end": 564.63,
   "text": "נפטרו בני הזוג הנאצלים האלו."
  },
  {
   "start": 566.17,
   "end": 570.19,
   "text": "ואנו בני העיר, שזכינו לחינוך כל כך טוב בזכותם,"
  },
  {
   "start": 571.25,
   "end": 572.97,
   "text": "החלטנו לקרוא לבנים שלנו,"
  },
  {
   "start": 573.41,
   "end": 574.99,
   "text": "לבנות שלנו על שמם."
  },
  {
   "start": 576.67,
   "end": 580.77,
   "text": "ולכן כל ילד וילדה שאתם פוגשים פה נקרא על שמם."
  },
  {
   "start": 581.61,
   "end": 583.33,
   "text": "ולא רק זה, בכל שנה,"
  },
  {
   "start": 584.01,
   "end": 584.93,
   "text": "ביום הפטירה,"
  },
  {
   "start": 585.45,
   "end": 591.31,
   "text": "כולנו עולים יחד אל הקבר שלהם ולומדים לעילוי נשמתם ממש,"
  },
  {
   "start": 591.89,
   "end": 595.37,
   "text": "כמו בנים כלפי האבות שלהם, כלפי האמהות שלהם."
  },
  {
   "start": 596.73,
   "end": 600.61,
   "text": "הם הקדישו את זמנם, מרצם וכספם עבורנו,"
  },
  {
   "start": 601.13,
   "end": 602.47,
   "text": "עבור ילדי ישראל,"
  },
  {
   "start": 602.97,
   "end": 606.17,
   "text": "כולנו נחשבים כילדיהם,"
  },
  {
   "start": 606.89,
   "end": 612.49,
   "text": "סיפר זקן העיר את סיפורם המיוחד והמרגש של ילדי העיר."
  },
  {
   "start": 620.22,
   "end": 622.38,
   "text": "שלמה ורבקה חזרו לביתם נרגשים."
  },
  {
   "start": 623.58,
   "end": 627.04,
   "text": "עכשיו הם הבינו מדוע נשלחו על ידי הבעל שם טוב לעיר הזו."
  },
  {
   "start": 628.12,
   "end": 636.3,
   "text": "שלמה ורבקה יזמו מסגרות לימוד ושכרו מלמדים עבור הילדים העניים שהיו להם בעיר שלהם."
  },
  {
   "start": 637.08,
   "end": 638.96,
   "text": "היו ילדים שאין להם מי שיתמוך בהם,"
  },
  {
   "start": 640.62,
   "end": 641.6,
   "text": "הם דאגו לטפל בהם."
  },
  {
   "start": 642.7,
   "end": 644.1,
   "text": "אף הם זכו לבנים,"
  },
  {
   "start": 644.72,
   "end": 646.48,
   "text": "בנים רוחניים, בנים נצחיים,"
  },
  {
   "start": 647.82,
   "end": 648.14,
   "text": "בנות"
  },
  {
   "start": 649.0,
   "end": 650.16,
   "text": "רוחניות נצחיות."
  },
  {
   "start": 651.94,
   "end": 653.42,
   "text": "כי עם ישראל עם אחד,"
  },
  {
   "start": 654.5,
   "end": 656.26,
   "text": "בנים כולם לה' יתברך."
  },
  {
   "start": 657.46,
   "end": 659.5,
   "text": "כל ישראל ערבים לזה לזה,"
  },
  {
   "start": 660.38,
   "end": 662.84,
   "text": "וכולם אהובים אצל ה' יתברך."
  },
  {
   "start": 664.38,
   "end": 668.0,
   "text": "אמר הבעל שם טוב בליקוטי שיחות קרח ג', עמוד 982,"
  },
  {
   "start": 668.7,
   "end": 671.18,
   "text": "כל יהודי יקר ואהוב אצל הקדוש ברוך הוא,"
  },
  {
   "start": 671.8,
   "end": 676.94,
   "text": "כמו בן יחיד שנולד להורים שלו לעת זקנותם,"
  },
  {
   "start": 681.74,
   "end": 682.5,
   "text": "אבא שלנו."
  },
  {
   "start": 684.08,
   "end": 687.26,
   "text": "כולנו ערבים אחד לשני."
  },
  {
   "start": 687.78,
   "end": 689.86,
   "text": "כל הנשמות שלנו זה נשמה אחת,"
  },
  {
   "start": 690.48,
   "end": 691.54,
   "text": "וכולנו ביחד."
  },
  {
   "start": 692.2,
   "end": 694.44,
   "text": "בואו, בואו נשמח את אבא שלנו בשמיים."
  },
  {
   "start": 695.34,
   "end": 696.24,
   "text": "אוהבים אותך."
  }
 ]
}