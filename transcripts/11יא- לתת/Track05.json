{
 "disc": "11יא- לתת",
 "track": "Track05",
 "duration": 439.152,
 "segments": [
  {
   "start": 2.8,
   "end": 17.45,
   "text": "הגאון רבי חיים עוזר גרוז'ינסקי, זכר צדיק לברכה,"
  },
  {
   "start": 17.97,
   "end": 21.07,
   "text": "שעליו אמר החפץ חיים הוא כלל ישראל."
  },
  {
   "start": 22.39,
   "end": 23.43,
   "text": "קרא לו כלל ישראל."
  },
  {
   "start": 24.27,
   "end": 27.27,
   "text": "יום אחד שאל אותו יהודי, תגיד לי, איפה רחוב זה וזה?"
  },
  {
   "start": 28.15,
   "end": 28.89,
   "text": "זה רחוב מסוים."
  },
  {
   "start": 29.71,
   "end": 31.65,
   "text": "הוא הלך איתו עד לאותו רחוב."
  },
  {
   "start": 32.67,
   "end": 35.53,
   "text": "אמרו לו התלמידים, הרב, בשמאן ללכת איתו? אנחנו בואו נסביר לו מכאן."
  },
  {
   "start": 36.51,
   "end": 39.71,
   "text": "לא, לא, הוא התעקש, לקח אותו יד ביד עד לאותו רחוב."
  },
  {
   "start": 41.43,
   "end": 42.31,
   "text": "והתלמידים אחריו,"
  },
  {
   "start": 42.85,
   "end": 49.31,
   "text": "כשחזרו התלמידים שואלים את הרב אמרו לו כבוד הרב הרי אתה עסוק כבוד הרב לקח אותו יד ביד עד לאותו רחוב"
  },
  {
   "start": 49.83,
   "end": 50.73,
   "text": "יכל להראות לו"
  },
  {
   "start": 52.29,
   "end": 52.91,
   "text": "להסביר לו"
  },
  {
   "start": 53.69,
   "end": 56.37,
   "text": "זה היה שואל מספר שאלות והוא מקבל כמה תשובות נגמר עניין"
  },
  {
   "start": 57.95,
   "end": 58.85,
   "text": "אמר להם הגאון"
  },
  {
   "start": 59.63,
   "end": 63.01,
   "text": "אתם לא שמתם לב שהיהודי הזה הוא דיבר אתם שמתם לב הוא מגמגם"
  },
  {
   "start": 64.55,
   "end": 66.03,
   "text": "אז ללכת עוד לצער אותו?"
  },
  {
   "start": 67.83,
   "end": 69.61,
   "text": "שעוד ירגיש שלא נעים לפני כולם?"
  },
  {
   "start": 70.41,
   "end": 71.73,
   "text": "בעוד שאלות ועוד תשובות?"
  },
  {
   "start": 72.39,
   "end": 74.55,
   "text": "כדי לחסור לו את האי-נעימות לקחתי אותו עד לשם."
  },
  {
   "start": 76.23,
   "end": 76.99,
   "text": "זה אי-אכפתיות."
  },
  {
   "start": 77.57,
   "end": 79.95,
   "text": "זה לרצות הטובה של החבר. מנהל הג'וינט."
  },
  {
   "start": 80.95,
   "end": 86.89,
   "text": "פעם באה גם לרב גרוז'ינסקי, זכר צעיד לברכה, ואמר לו, אחרי איזו התרמה למשפחות נזקקות ולכל מיני אנשים שנצרכים,"
  },
  {
   "start": 88.09,
   "end": 90.47,
   "text": "בא לרב ואמר לו, תראה, עד עכשיו עשינו למען הכלל."
  },
  {
   "start": 90.97,
   "end": 93.31,
   "text": "עכשיו אני רוצה לעשות משהו למען כבוד הרב."
  },
  {
   "start": 94.07,
   "end": 94.97,
   "text": "מה הרב רוצה?"
  },
  {
   "start": 98.34,
   "end": 102.94,
   "text": "אחריך רבי חיים עוזר גרוז'ינסקי אמר לו, כן, אני צריך משהו."
  },
  {
   "start": 103.78,
   "end": 104.24,
   "text": "אומר לו, מה?"
  },
  {
   "start": 104.8,
   "end": 107.16,
   "text": "זאת אומרת, תראה, יש איזה, עם אשתי,"
  },
  {
   "start": 107.66,
   "end": 110.3,
   "text": "יש אישה מבוגרת, מבשלת, מבוגרת, שעוזרת לה."
  },
  {
   "start": 112.92,
   "end": 115.64,
   "text": "ולמבשלת המבוגרת, אין לה נעליים לחורף."
  },
  {
   "start": 117.64,
   "end": 119.12,
   "text": "הייתי רוצה שאתה חוזר לפריז,"
  },
  {
   "start": 119.9,
   "end": 122.82,
   "text": "תקנה לה נעליים חמות לחורף ותשלח לה בדואר."
  },
  {
   "start": 123.88,
   "end": 125.02,
   "text": "כדי שיהיה לה חם בחורף,"
  },
  {
   "start": 125.7,
   "end": 126.76,
   "text": "כדי שלא תסבול מקור."
  },
  {
   "start": 128.7,
   "end": 129.54,
   "text": "זו אכפתיות"
  },
  {
   "start": 131.42,
   "end": 132.06,
   "text": "לזולת."
  },
  {
   "start": 134.49,
   "end": 136.07,
   "text": "זה מה שכל העולם רוצה מאיתנו."
  },
  {
   "start": 141.67,
   "end": 142.67,
   "text": "כשזוג נישאים,"
  },
  {
   "start": 143.63,
   "end": 147.87,
   "text": "מה אומרים? הרי את מקודשת לי כדת משה וישראל."
  },
  {
   "start": 148.87,
   "end": 149.43,
   "text": "מה הקשר?"
  },
  {
   "start": 150.39,
   "end": 155.93,
   "text": "מה הקשר בין קידושין לכדת משה וישראל? מה הקשר משה וישראל?"
  },
  {
   "start": 156.61,
   "end": 161.33,
   "text": "אצלך הרי את מקודשת לי כדת היהודים, או כדת."
  },
  {
   "start": 163.57,
   "end": 164.77,
   "text": "הרי את מקודשת לי כדת."
  },
  {
   "start": 165.81,
   "end": 167.21,
   "text": "מה זה כדת משה וישראל?"
  },
  {
   "start": 168.33,
   "end": 170.23,
   "text": "אתם יודעים מה זה כדת משה וישראל?"
  },
  {
   "start": 171.23,
   "end": 174.09,
   "text": "כמו משה וישראל."
  },
  {
   "start": 174.91,
   "end": 178.19,
   "text": "כמו שמשה וישראל הלכו ארבעים שנה במדבר."
  },
  {
   "start": 179.73,
   "end": 181.57,
   "text": "משה סבל את עם ישראל."
  },
  {
   "start": 182.05,
   "end": 183.39,
   "text": "למות שלו הם הרבה טענות,"
  },
  {
   "start": 184.29,
   "end": 185.09,
   "text": "הרבה מריבות,"
  },
  {
   "start": 185.77,
   "end": 186.37,
   "text": "קשיים."
  },
  {
   "start": 186.89,
   "end": 190.21,
   "text": "הם לא נמצאו באיזה בית מלון חמישה כוכבים במדבר."
  },
  {
   "start": 192.25,
   "end": 193.01,
   "text": "בקשיים."
  },
  {
   "start": 193.43,
   "end": 194.65,
   "text": "הם עברו מלחמות."
  },
  {
   "start": 197.6,
   "end": 198.84,
   "text": "הם עברו סבל."
  },
  {
   "start": 201.77,
   "end": 206.49,
   "text": "ככה בני זוג צריכים להיות, כדת משה וישראל."
  },
  {
   "start": 207.23,
   "end": 210.33,
   "text": "כמו שמשה וישראל עברו את כל הקשיים,"
  },
  {
   "start": 210.87,
   "end": 213.57,
   "text": "ככה בני הזוג צריכים לעבור את כל הקשיים."
  },
  {
   "start": 214.19,
   "end": 215.99,
   "text": "זה לא חוכמה להיות עם שלום בית"
  },
  {
   "start": 216.63,
   "end": 219.95,
   "text": "כששני בני הזוג הם רגועים והכול על מי מנוחות והכול בסדר."
  },
  {
   "start": 220.65,
   "end": 224.13,
   "text": "החוכמה היא להיות, לחיות עם שלום בית כשיש קשיים,"
  },
  {
   "start": 224.51,
   "end": 228.29,
   "text": "כשאחד מוותר לשני, כדת משה וישראל גם כשקשה."
  },
  {
   "start": 231.52,
   "end": 233.06,
   "text": "ככה בני הזוג צריכים להיות,"
  },
  {
   "start": 233.3,
   "end": 235.24,
   "text": "ככה עם ישראל כולו צריך להיות."
  },
  {
   "start": 236.82,
   "end": 240.02,
   "text": "אתם יודעים, היה איזה מקרה לפני 57 שנה"
  },
  {
   "start": 242.58,
   "end": 243.78,
   "text": "בעיירה סאנוק."
  },
  {
   "start": 248.32,
   "end": 251.26,
   "text": "הגרמנים הנאצים פשטו והגיעו לעיירה סאנוק."
  },
  {
   "start": 252.16,
   "end": 253.72,
   "text": "הם לכדו את כל יהודי העיירה,"
  },
  {
   "start": 254.4,
   "end": 257.1,
   "text": "ובכללם את רבי טוביה הורוביץ' מסאנק"
  },
  {
   "start": 259.12,
   "end": 259.62,
   "text": "ואשתו."
  },
  {
   "start": 260.54,
   "end": 262.32,
   "text": "והם העבירו אותם למחנה הריכוז זסלב."
  },
  {
   "start": 269.23,
   "end": 270.17,
   "text": "באחד מהלילות"
  },
  {
   "start": 271.11,
   "end": 273.07,
   "text": "הרב ורעייתו,"
  },
  {
   "start": 275.66,
   "end": 277.46,
   "text": "שהיו זוג, זוג למופת,"
  },
  {
   "start": 278.36,
   "end": 280.76,
   "text": "מצאו פרצה בגדר,"
  },
  {
   "start": 281.72,
   "end": 283.12,
   "text": "והם החלו להימלט מן המחנה,"
  },
  {
   "start": 283.88,
   "end": 285.06,
   "text": "כשכולם תקווה,"
  },
  {
   "start": 285.4,
   "end": 288.16,
   "text": "כשהלב פועם בתקווה לעבור את הגבול,"
  },
  {
   "start": 288.48,
   "end": 289.56,
   "text": "להגיע אל החופש,"
  },
  {
   "start": 290.64,
   "end": 291.98,
   "text": "להתרחק מהמוות"
  },
  {
   "start": 295.06,
   "end": 296.84,
   "text": "אחרי מספר קילומטרים."
  },
  {
   "start": 298.1,
   "end": 298.4,
   "text": "לפתע"
  },
  {
   "start": 299.62,
   "end": 300.42,
   "text": "היא לא שמה לב,"
  },
  {
   "start": 301.56,
   "end": 302.44,
   "text": "היה שם איזה אבן,"
  },
  {
   "start": 302.44,
   "end": 307.46,
   "text": "והרבנית החליקה ונקעה את הרגל."
  },
  {
   "start": 309.98,
   "end": 311.0,
   "text": "נקעה את הרגל"
  },
  {
   "start": 311.76,
   "end": 313.08,
   "text": "והיא לא יכולה להמשיך."
  },
  {
   "start": 319.7,
   "end": 320.24,
   "text": "היה ברור לה"
  },
  {
   "start": 321.76,
   "end": 322.74,
   "text": "שהיא נשארת"
  },
  {
   "start": 324.02,
   "end": 333.81,
   "text": "והרב ממשיך הלאה כדי להציל ולהמשיך את השושלת המשפחתית."
  },
  {
   "start": 336.23,
   "end": 336.85,
   "text": "אבל הרב,"
  },
  {
   "start": 337.77,
   "end": 339.97,
   "text": "רבי טוביה הורוביץ' מסנוק,"
  },
  {
   "start": 339.97,
   "end": 343.41,
   "text": "קם ואמר, אני חוזר."
  },
  {
   "start": 345.64,
   "end": 347.36,
   "text": "כלומר, אנחנו חוזרים חזרה."
  },
  {
   "start": 348.6,
   "end": 349.32,
   "text": "חזרה אל המחנה."
  },
  {
   "start": 350.76,
   "end": 351.56,
   "text": "חזרה אל המוות."
  },
  {
   "start": 352.66,
   "end": 353.44,
   "text": "התחננה."
  },
  {
   "start": 355.44,
   "end": 356.42,
   "text": "אישי תמשיך."
  },
  {
   "start": 357.02,
   "end": 358.34,
   "text": "אישי תברח על נפשך."
  },
  {
   "start": 358.8,
   "end": 360.26,
   "text": "לפחות אתה תנצל."
  },
  {
   "start": 361.0,
   "end": 363.12,
   "text": "אני מרשה לך. אני מתחננת בפניך."
  },
  {
   "start": 364.82,
   "end": 366.26,
   "text": "לא הועילו לה כל התחנונים."
  },
  {
   "start": 367.24,
   "end": 368.6,
   "text": "הרב אמר, אני לא עוזב אותך."
  },
  {
   "start": 369.7,
   "end": 371.12,
   "text": "אני לא משאיר אותך לבד."
  },
  {
   "start": 372.08,
   "end": 372.62,
   "text": "אנחנו ביחד,"
  },
  {
   "start": 374.0,
   "end": 377.62,
   "text": "והרב הרים אותה ונשא אותה בזרועותיו"
  },
  {
   "start": 378.34,
   "end": 383.78,
   "text": "וחזר יחד עימה את כל הדרך אל המחנה."
  },
  {
   "start": 385.26,
   "end": 387.1,
   "text": "מאבד את הסיכוי לחופש,"
  },
  {
   "start": 387.72,
   "end": 389.2,
   "text": "מאבד את הסיכוי לחיים,"
  },
  {
   "start": 389.94,
   "end": 393.0,
   "text": "אבל את רעייתו הוא לא ינטוש לבדה."
  },
  {
   "start": 410.94,
   "end": 415.8,
   "text": "מאוחר יותר הוא עבר הרב למחנה ההשמדה בלז'ץ,"
  },
  {
   "start": 415.8,
   "end": 434.62,
   "text": "ובי' בשבט תש״ג עלתה נשמתו הקדושה בסערה השמיימה ובלבד שלא ייטוש את אשתו את רעייתו."
  }
 ]
}