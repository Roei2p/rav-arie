{
 "disc": "11יא- לתת",
 "track": "Track01",
 "duration": 987.216,
 "segments": [
  {
   "start": 8.94,
   "end": 10.22,
   "text": "רבי צבי הורוביץ'"
  },
  {
   "start": 11.22,
   "end": 11.98,
   "text": "מצ'ורטקוב"
  },
  {
   "start": 13.98,
   "end": 15.98,
   "text": "אימץ לו יום אחד יתום,"
  },
  {
   "start": 19.92,
   "end": 20.98,
   "text": "ילד יתום לבית שלו."
  },
  {
   "start": 22.42,
   "end": 23.16,
   "text": "קראו לילד משה."
  },
  {
   "start": 29.16,
   "end": 33.52,
   "text": "משה היתום גדל ונהפך לעוזרו,"
  },
  {
   "start": 36.12,
   "end": 37.18,
   "text": "עוזרו הראשי של הרב."
  },
  {
   "start": 42.0,
   "end": 42.68,
   "text": "לרב היו בנות,"
  },
  {
   "start": 44.16,
   "end": 45.08,
   "text": "הבנות גם הן גדלות."
  },
  {
   "start": 46.18,
   "end": 47.06,
   "text": "והרב רגוע,"
  },
  {
   "start": 48.04,
   "end": 51.54,
   "text": "הייתה לו תוכנית חיסכון לבנות שלו."
  },
  {
   "start": 53.14,
   "end": 55.12,
   "text": "לתוכנית קראו תוכנית מגירה."
  },
  {
   "start": 56.34,
   "end": 59.24,
   "text": "כלומר, הייתה לו מגירה קטנה שם הוא שם כסף"
  },
  {
   "start": 59.8,
   "end": 62.76,
   "text": "פרוטה לפרוטה, כדי שיום אחד יגיע הזמן"
  },
  {
   "start": 63.3,
   "end": 66.16,
   "text": "והבנות שלו יצטרכו להינשא כדת משה וישראל,"
  },
  {
   "start": 67.02,
   "end": 68.7,
   "text": "יהיה לו לתת להם לנדוניה."
  },
  {
   "start": 69.96,
   "end": 73.42,
   "text": "הם יוכלו לנשא לתלמידי חכמים ולהקים בית כרצון השם יתברך."
  },
  {
   "start": 76.77,
   "end": 78.35,
   "text": "בינתיים הנער משה"
  },
  {
   "start": 80.13,
   "end": 80.65,
   "text": "מתבגר,"
  },
  {
   "start": 81.47,
   "end": 84.61,
   "text": "מכיר את כלתו לעתיד,"
  },
  {
   "start": 85.09,
   "end": 87.87,
   "text": "מתחתן ועוקר לו מצ'ורוטקוב,"
  },
  {
   "start": 88.91,
   "end": 91.43,
   "text": "תוך שהוא נפרד בדמעות"
  },
  {
   "start": 92.71,
   "end": 94.13,
   "text": "מהרב שגידל אותו,"
  },
  {
   "start": 94.93,
   "end": 96.99,
   "text": "שאסף אותו מהרחוב,"
  },
  {
   "start": 97.93,
   "end": 98.59,
   "text": "וגידל אותו"
  },
  {
   "start": 99.71,
   "end": 100.47,
   "text": "עד הזמן הזה."
  },
  {
   "start": 105.3,
   "end": 106.3,
   "text": "עברה כמעט שנה,"
  },
  {
   "start": 108.32,
   "end": 108.78,
   "text": "והנה,"
  },
  {
   "start": 108.78,
   "end": 113.84,
   "text": "הנה הגיע זמן נישואי ביתו הבכירה של הרב"
  },
  {
   "start": 116.55,
   "end": 120.77,
   "text": "והכל מתארגנים לקראת החתונה ממשמשת ובאה"
  },
  {
   "start": 124.23,
   "end": 126.97,
   "text": "והרב הולך כדור ביטחון,"
  },
  {
   "start": 127.81,
   "end": 131.91,
   "text": "הולך אל תוכנית המגירה שלו, אל אותה מגירה שם,"
  },
  {
   "start": 133.47,
   "end": 134.65,
   "text": "שם הוא הטמין במשך"
  },
  {
   "start": 135.79,
   "end": 138.77,
   "text": "זמן קורב את כל,"
  },
  {
   "start": 139.51,
   "end": 140.79,
   "text": "את כל המעות שהוא אסף."
  },
  {
   "start": 143.79,
   "end": 144.63,
   "text": "הוא לא יכול להבין"
  },
  {
   "start": 146.01,
   "end": 148.27,
   "text": "מאיפה צץ לו אותו רגש מבשר האות"
  },
  {
   "start": 150.7,
   "end": 152.58,
   "text": "שנייה לפני שהוא פתח את המגירה."
  },
  {
   "start": 155.1,
   "end": 164.78,
   "text": "אבל הוא פתח, מגלה לתדהמתו את מה שעיניו ראו ומוחו סירב להאמין."
  },
  {
   "start": 166.36,
   "end": 167.26,
   "text": "כל החסכונות,"
  },
  {
   "start": 168.22,
   "end": 171.5,
   "text": "כל הכספים שהוא אסף במשך שנים נעלמו."
  },
  {
   "start": 172.46,
   "end": 173.66,
   "text": "המגירה הייתה ריקה."
  },
  {
   "start": 177.04,
   "end": 181.58,
   "text": "המחשבה היחידה שעלמה במוחו היחיד שיודע זה משה."
  },
  {
   "start": 182.52,
   "end": 183.18,
   "text": "משה היתום"
  },
  {
   "start": 183.18,
   "end": 185.06,
   "text": "שגידלתי,"
  },
  {
   "start": 188.03,
   "end": 188.77,
   "text": "אבל לא יכול להיות."
  },
  {
   "start": 190.82,
   "end": 191.3,
   "text": "ודאי,"
  },
  {
   "start": 191.96,
   "end": 192.78,
   "text": "ודאי שהוא לא לקח."
  },
  {
   "start": 193.88,
   "end": 194.76,
   "text": "כמו הבן שלי."
  },
  {
   "start": 200.09,
   "end": 201.05,
   "text": "אבל הוא היחיד שיודע."
  },
  {
   "start": 204.84,
   "end": 206.28,
   "text": "אז הרב הצדיק מצ'ורטקוב"
  },
  {
   "start": 207.02,
   "end": 208.82,
   "text": "הרגיע את עצמו ואמר, אני בטוח."
  },
  {
   "start": 209.62,
   "end": 213.0,
   "text": "אני בטוח שאולי הוא ילווה את הכסף על מנת להתחתן, לא היה נעים לו ממני."
  },
  {
   "start": 214.9,
   "end": 216.88,
   "text": "אבל הוא יחזיר, הוא יחזיר לי."
  },
  {
   "start": 218.22,
   "end": 222.52,
   "text": "אני אמתין, אני אשלח לו מכתב, בואו נספר שהבת שלי עומדת להתחתן."
  },
  {
   "start": 224.4,
   "end": 225.5,
   "text": "ואז ודאי שהוא יחזיר."
  },
  {
   "start": 228.35,
   "end": 229.01,
   "text": "המרכתב נשלח"
  },
  {
   "start": 231.29,
   "end": 238.51,
   "text": "ומועד החתונה קרב והלחץ בבית של הרב מידשו-אודקוב גדל."
  },
  {
   "start": 239.97,
   "end": 240.71,
   "text": "אשת הרב,"
  },
  {
   "start": 241.47,
   "end": 243.99,
   "text": "הרבנית ביקשה ממנו, תיסע לפריז."
  },
  {
   "start": 245.83,
   "end": 247.91,
   "text": "תיסע אליו, אל משה, הוא נמצא שם."
  },
  {
   "start": 248.63,
   "end": 255.74,
   "text": "אולי הוא עוד יכול להחזיר לנו חלק מהסכום, איש מהם."
  },
  {
   "start": 255.74,
   "end": 262.14,
   "text": "מותה המשפחה יראת שמיים לא העלה על הדעת להאשים אותו בגניבה"
  },
  {
   "start": 271.98,
   "end": 273.34,
   "text": "שבוע אחר כך."
  },
  {
   "start": 274.1,
   "end": 274.56,
   "text": "פריז,"
  },
  {
   "start": 278.12,
   "end": 278.92,
   "text": "דפיקות בדלת,"
  },
  {
   "start": 279.86,
   "end": 284.42,
   "text": "ומשה קם ממקום מושבו וניגש אל הדלת ופתח אותה."
  },
  {
   "start": 289.13,
   "end": 290.11,
   "text": "הוא עמד בפתח נדהם."
  },
  {
   "start": 296.6,
   "end": 298.44,
   "text": "עונג גדול הוא לארח את כבוד הרב,"
  },
  {
   "start": 299.62,
   "end": 302.34,
   "text": "והוא נחפז לארח את הרב שהיה לו כמו אבא."
  },
  {
   "start": 303.74,
   "end": 307.14,
   "text": "הרב שכל כך היטיב לו במשך שנות ילדותו."
  },
  {
   "start": 308.22,
   "end": 309.38,
   "text": "והרב,"
  },
  {
   "start": 309.94,
   "end": 313.46,
   "text": "בקול שקט ומתנצל, מסביר את המצב,"
  },
  {
   "start": 314.36,
   "end": 314.96,
   "text": "מבקש,"
  },
  {
   "start": 315.98,
   "end": 316.28,
   "text": "אולי,"
  },
  {
   "start": 316.64,
   "end": 318.56,
   "text": "אולי משה אתה יכול לעזור לי בינתיים?"
  },
  {
   "start": 319.46,
   "end": 321.3,
   "text": "אולי יש לך בינתיים חלק מהכסף?"
  },
  {
   "start": 323.94,
   "end": 326.66,
   "text": "ומשה מניד את ראשו,"
  },
  {
   "start": 330.43,
   "end": 331.15,
   "text": "כבוד הרב,"
  },
  {
   "start": 332.77,
   "end": 334.17,
   "text": "אתה כל כך טוב לב,"
  },
  {
   "start": 336.05,
   "end": 337.15,
   "text": "הוא פורץ מפחי."
  },
  {
   "start": 338.33,
   "end": 338.81,
   "text": "אחר כך"
  },
  {
   "start": 338.81,
   "end": 343.17,
   "text": "ניגש משה ומוציא סכום כסף נכבד"
  },
  {
   "start": 345.19,
   "end": 345.79,
   "text": "מארונו"
  },
  {
   "start": 346.67,
   "end": 347.67,
   "text": "נותן על החשבון"
  },
  {
   "start": 348.97,
   "end": 351.45,
   "text": "אני מבטיח לך, כבוד הרב, כל חודש"
  },
  {
   "start": 352.23,
   "end": 355.15,
   "text": "כבוד הרב, אני מבטיח, כל חודש אני אשלח"
  },
  {
   "start": 355.97,
   "end": 364.15,
   "text": "סכום לא מבוטל עד שאני אכסה את כל החודש כבוד הרב, אני מבקש מחילה, אני תכננתי להחזיר"
  },
  {
   "start": 365.53,
   "end": 367.11,
   "text": "אני צריך להחזיר לכבוד הרב"
  },
  {
   "start": 369.23,
   "end": 370.13,
   "text": "אני אעשה תשובה"
  },
  {
   "start": 372.74,
   "end": 373.6,
   "text": "והרב מרגיע"
  },
  {
   "start": 375.06,
   "end": 380.84,
   "text": "מרגיע את היתום שגדל אצלו כמו בן,"
  },
  {
   "start": 381.38,
   "end": 382.8,
   "text": "וטעה קצת ומעד קצת."
  },
  {
   "start": 385.56,
   "end": 387.06,
   "text": "הרב לא חשב אפילו להקפיד עליו."
  },
  {
   "start": 388.54,
   "end": 389.06,
   "text": "הוא חזר,"
  },
  {
   "start": 389.72,
   "end": 390.9,
   "text": "חזר לביתו לצ'ורטקוב,"
  },
  {
   "start": 391.72,
   "end": 392.54,
   "text": "שמח וטוב לב."
  },
  {
   "start": 393.74,
   "end": 394.2,
   "text": "ואכן,"
  },
  {
   "start": 394.82,
   "end": 397.8,
   "text": "כל חודש במדויק מחזיר משה את הכסף."
  },
  {
   "start": 399.58,
   "end": 400.54,
   "text": "והרב שמח,"
  },
  {
   "start": 401.34,
   "end": 401.98,
   "text": "שמח בלבו"
  },
  {
   "start": 403.72,
   "end": 406.16,
   "text": "על הילד בעל התשובה הנפלאה שגדל."
  },
  {
   "start": 409.32,
   "end": 410.24,
   "text": "מידותיו הנפלאות,"
  },
  {
   "start": 410.7,
   "end": 415.16,
   "text": "לא מרשות להיכל קיק של מחשבה איך הוא גמל הוראה,"
  },
  {
   "start": 415.56,
   "end": 417.12,
   "text": "איך הוא לקח ככה את הכסף"
  },
  {
   "start": 419.86,
   "end": 420.82,
   "text": "אחרי כל כך הרבה"
  },
  {
   "start": 421.78,
   "end": 425.16,
   "text": "שנים שגידלו אותו בבית."
  },
  {
   "start": 430.96,
   "end": 431.98,
   "text": "הרב שוקע בלימוד,"
  },
  {
   "start": 433.54,
   "end": 435.9,
   "text": "בלימוד נעים, שוכח מכל אבלי העולם הזה."
  },
  {
   "start": 462.17,
   "end": 466.01,
   "text": "זאת הלילה, דפיקות רמות"
  },
  {
   "start": 466.63,
   "end": 467.93,
   "text": "בדלת ביתו של הרב מצ'ורטקוב."
  },
  {
   "start": 470.11,
   "end": 471.01,
   "text": "הרב פתח את הדלת"
  },
  {
   "start": 471.85,
   "end": 475.19,
   "text": "ונרתע אחורה משטרה."
  },
  {
   "start": 475.19,
   "end": 475.45,
   "text": "המשטרה"
  },
  {
   "start": 476.73,
   "end": 477.79,
   "text": "משטרה בפתח של הדלת"
  },
  {
   "start": 479.49,
   "end": 480.21,
   "text": "של הרב מידשורטקוב."
  },
  {
   "start": 482.47,
   "end": 483.01,
   "text": "זה לא היה דבר"
  },
  {
   "start": 483.63,
   "end": 484.35,
   "text": "של יום-יום."
  },
  {
   "start": 485.65,
   "end": 487.43,
   "text": "הינך מתבקש להתלוות עמנו לתחנה,"
  },
  {
   "start": 493.01,
   "end": 494.79,
   "text": "והרב לא יודע על מה,"
  },
  {
   "start": 495.37,
   "end": 496.13,
   "text": "לא מבין למה,"
  },
  {
   "start": 496.81,
   "end": 498.01,
   "text": "אבל כולו אמונה."
  },
  {
   "start": 501.98,
   "end": 504.96,
   "text": "בתחנת המשטרה הרב מוכנס לחדר חקירות,"
  },
  {
   "start": 506.54,
   "end": 511.06,
   "text": "וממולו ניצב מפקח משטרה שמביט בו בפנים חמורי סבר."
  },
  {
   "start": 512.52,
   "end": 512.76,
   "text": "לפתע"
  },
  {
   "start": 514.02,
   "end": 517.22,
   "text": "הוא שלף משהו מאחוריו והשליך על השולחן."
  },
  {
   "start": 531.18,
   "end": 534.84,
   "text": "המפקח שלף משהו מאחוריו והשליך על השולחן."
  },
  {
   "start": 536.66,
   "end": 537.48,
   "text": "ועיני הרב"
  },
  {
   "start": 538.2,
   "end": 539.52,
   "text": "נפערו לרווחה"
  },
  {
   "start": 540.46,
   "end": 541.54,
   "text": "על השולחן."
  },
  {
   "start": 542.74,
   "end": 544.26,
   "text": "על השולחן היה מונח"
  },
  {
   "start": 545.84,
   "end": 547.36,
   "text": "ארנק החסכונות שלו."
  },
  {
   "start": 549.48,
   "end": 552.02,
   "text": "זה שהיה טמון במגירה עם כל הכסף,"
  },
  {
   "start": 553.44,
   "end": 555.32,
   "text": "כאילו לא נלקח מביתו מעולם."
  },
  {
   "start": 559.78,
   "end": 565.38,
   "text": "הרב שמע במעורפל את קולו של מפקח המשטרה שמספר לו"
  },
  {
   "start": 565.96,
   "end": 568.16,
   "text": "בבית שלך, כבוד הרב, הייתה מנקה גויה."
  },
  {
   "start": 569.84,
   "end": 570.34,
   "text": "אתה זוכר?"
  },
  {
   "start": 572.85,
   "end": 573.81,
   "text": "היא במקרה עלתה"
  },
  {
   "start": 574.73,
   "end": 579.61,
   "text": "על המקום בו הטמנת את הכסף."
  },
  {
   "start": 581.25,
   "end": 582.51,
   "text": "היא במקרה, תוך כדי ניקוי,"
  },
  {
   "start": 583.37,
   "end": 583.83,
   "text": "גילתה"
  },
  {
   "start": 585.01,
   "end": 585.77,
   "text": "את הכספת"
  },
  {
   "start": 588.64,
   "end": 592.66,
   "text": "הסודית שלך שם במגירה."
  },
  {
   "start": 593.86,
   "end": 595.86,
   "text": "היא גנבה את כל הכסף."
  },
  {
   "start": 596.4,
   "end": 597.4,
   "text": "ושמרה במקום סתר."
  },
  {
   "start": 598.56,
   "end": 600.24,
   "text": "היא לא לקחה בחשבון שבעלה,"
  },
  {
   "start": 601.82,
   "end": 603.08,
   "text": "השתיין של העיר,"
  },
  {
   "start": 603.88,
   "end": 606.14,
   "text": "ידבר, יספר לכולם, לכל החברים שלו."
  },
  {
   "start": 610.67,
   "end": 611.73,
   "text": "זה הגיע אלינו, היא נעצרה,"
  },
  {
   "start": 612.31,
   "end": 612.85,
   "text": "והודתה."
  },
  {
   "start": 613.87,
   "end": 614.81,
   "text": "הנה הארנק עם הכסף."
  },
  {
   "start": 615.81,
   "end": 616.81,
   "text": "תדע לך, רב יהודי,"
  },
  {
   "start": 618.03,
   "end": 618.55,
   "text": "כבוד הרב,"
  },
  {
   "start": 619.53,
   "end": 620.77,
   "text": "בורא העולם שומר עליך."
  },
  {
   "start": 622.81,
   "end": 625.67,
   "text": "נדיר מאוד שימצא כל הכסף בשלמותו."
  },
  {
   "start": 626.21,
   "end": 627.07,
   "text": "אצלך זה קרה."
  },
  {
   "start": 627.59,
   "end": 628.63,
   "text": "בורא העולם שומר עליך."
  },
  {
   "start": 632.21,
   "end": 632.49,
   "text": "והרב,"
  },
  {
   "start": 634.25,
   "end": 634.81,
   "text": "הרב קם,"
  },
  {
   "start": 635.65,
   "end": 636.53,
   "text": "חזר הביתה,"
  },
  {
   "start": 637.55,
   "end": 639.45,
   "text": "כשבראשו מנקרת המחשבה,"
  },
  {
   "start": 640.31,
   "end": 642.03,
   "text": "משה לא לקח מאומה."
  },
  {
   "start": 642.87,
   "end": 654.42,
   "text": "הוא לא לקח שבוע אחר כך,"
  },
  {
   "start": 657.85,
   "end": 658.89,
   "text": "דפיקות בדלת,"
  },
  {
   "start": 659.67,
   "end": 660.81,
   "text": "בביתו של משה."
  },
  {
   "start": 662.07,
   "end": 663.05,
   "text": "הוא פותח את הדלת,"
  },
  {
   "start": 665.26,
   "end": 666.22,
   "text": "הרב מצ'ורטקוב."
  },
  {
   "start": 666.9,
   "end": 672.93,
   "text": "כבוד הרב, הכיסא ששלחתי לו הגיע אליך, כבוד הרב."
  },
  {
   "start": 680.08,
   "end": 681.42,
   "text": "והוא רואה את הרב שגידל אותו,"
  },
  {
   "start": 682.54,
   "end": 683.56,
   "text": "עם דמעות בעיניים."
  },
  {
   "start": 686.74,
   "end": 700.46,
   "text": "משה, למה לא אמרת לי שזה לא אתה ומשה בוכה?"
  },
  {
   "start": 702.16,
   "end": 702.38,
   "text": "משה,"
  },
  {
   "start": 703.4,
   "end": 705.36,
   "text": "שכמעט לא ראו אותו בוכה,"
  },
  {
   "start": 706.9,
   "end": 709.02,
   "text": "מרשה לדמעות להתגלגל במורד לחיור."
  },
  {
   "start": 710.16,
   "end": 711.98,
   "text": "כבוד הרב, כאב לי כל כך הלב."
  },
  {
   "start": 713.24,
   "end": 714.32,
   "text": "כשבאת וסיפרת לי,"
  },
  {
   "start": 718.05,
   "end": 730.74,
   "text": "ידעתי שבזמן כזה אתה לא צריך לשמוע כלום חוץ מלקבל כסף כדי שיוכל לחתן את הבת שלך."
  },
  {
   "start": 730.98,
   "end": 734.96,
   "text": "אולי זה יהיה מעט על כל מה שהשקעת עבורי, כל מה שעשית עבורי."
  },
  {
   "start": 735.38,
   "end": 736.28,
   "text": "לא רציתי לאכזב אותך."
  },
  {
   "start": 736.88,
   "end": 738.66,
   "text": "לא רציתי לגרום לכם צער כל כך."
  },
  {
   "start": 739.92,
   "end": 743.7,
   "text": "אז ככה לקחתם את הכסף ולא חשתם שאתם נצרכים."
  },
  {
   "start": 745.46,
   "end": 747.74,
   "text": "כך יכולתי לגמול לכם על טוב לבכם."
  },
  {
   "start": 749.66,
   "end": 750.4,
   "text": "כבוד הרב,"
  },
  {
   "start": 751.86,
   "end": 753.74,
   "text": "בכה משה ואמר, כילד יתום,"
  },
  {
   "start": 754.22,
   "end": 759.5,
   "text": "עוד כילד יתום אני זכיתי להרגיש כל יום שהקדוש ברוך הוא איתי,"
  },
  {
   "start": 759.78,
   "end": 761.54,
   "text": "שהוא אבא שלי, אבא שאוהב."
  },
  {
   "start": 762.18,
   "end": 763.56,
   "text": "ככה החזקתי מעמד."
  },
  {
   "start": 767.58,
   "end": 768.76,
   "text": "שום דבר בעולם"
  },
  {
   "start": 769.58,
   "end": 771.6,
   "text": "ידעתי מגיל קטן אינו מקרי."
  },
  {
   "start": 772.32,
   "end": 773.88,
   "text": "הכל מנוהל על ידי אבא."
  },
  {
   "start": 774.64,
   "end": 776.36,
   "text": "אבא שלי, הקדוש ברוך הוא,"
  },
  {
   "start": 780.07,
   "end": 784.47,
   "text": "שדאג שכבוד הרב יאסוף אותי ברחובות, שיגדל אותי,"
  },
  {
   "start": 785.27,
   "end": 786.31,
   "text": "שייתן לי קורת גג."
  },
  {
   "start": 788.25,
   "end": 789.63,
   "text": "ולכן גם כשבאת,"
  },
  {
   "start": 790.07,
   "end": 793.87,
   "text": "גם כשכבוד הרב בא וחשד בי, ידעתי שזה מאבא."
  },
  {
   "start": 794.25,
   "end": 795.87,
   "text": "ידעתי שזה מהאבא שבשמיים,"
  },
  {
   "start": 796.63,
   "end": 798.97,
   "text": "שתמיד הוא איתי, והכל הכל לטובה."
  },
  {
   "start": 799.91,
   "end": 803.13,
   "text": "ואני פעלתי כמו שהוא היה רוצה שאפעל,"
  },
  {
   "start": 805.56,
   "end": 808.44,
   "text": "כמו שהוא היה רוצה שאני אעשה."
  },
  {
   "start": 808.88,
   "end": 809.64,
   "text": "נתתי כסף,"
  },
  {
   "start": 810.22,
   "end": 811.22,
   "text": "כדי שלא תצטער."
  },
  {
   "start": 813.1,
   "end": 813.92,
   "text": "תראה כבוד הרב,"
  },
  {
   "start": 815.08,
   "end": 816.76,
   "text": "כבוד הרב הנה בא ריבונו של עולם,"
  },
  {
   "start": 817.34,
   "end": 819.36,
   "text": "והראה לכולנו כמה הוא אוהב אותנו."
  },
  {
   "start": 819.94,
   "end": 822.32,
   "text": "ושהכל, אבל הכל בעולם הזה,"
  },
  {
   "start": 822.82,
   "end": 830.72,
   "text": "זה ניסיון כדי שנאיר את העולם באורו יתברך ונבנה לנו פיסת גן עדן בעולם הזה ובעולם הבא."
  },
  {
   "start": 832.46,
   "end": 835.0,
   "text": "והרב מצ'ורטקוב מביט במשה,"
  },
  {
   "start": 835.54,
   "end": 837.46,
   "text": "אותו משה שהוא גידל,"
  },
  {
   "start": 838.0,
   "end": 839.86,
   "text": "אותו משה שהוא הכתיר לו אמונה."
  },
  {
   "start": 841.38,
   "end": 841.82,
   "text": "ואז,"
  },
  {
   "start": 843.04,
   "end": 846.44,
   "text": "כשהוא לא יכול לעצור את הדמעות הזולגות מעיניו,"
  },
  {
   "start": 847.48,
   "end": 851.82,
   "text": "הוא בירך מכל הלב, מלב יהודי, מלב מאמין,"
  },
  {
   "start": 852.08,
   "end": 856.28,
   "text": "את משה, ואמר לו, תדע לך, אני מברך אותך על מה שעשית,"
  },
  {
   "start": 856.92,
   "end": 861.36,
   "text": "שאתה וכל המשפחה שלך וכל יוצאי חלציך"
  },
  {
   "start": 862.4,
   "end": 866.64,
   "text": "לא יראו עוד שער של חוסר פרנסה,"
  },
  {
   "start": 867.06,
   "end": 869.1,
   "text": "יזכו לאושר וברכה בכסף שלהם."
  },
  {
   "start": 872.71,
   "end": 874.79,
   "text": "כל ימי חייך, כמו שאתה דאגת,"
  },
  {
   "start": 875.09,
   "end": 878.25,
   "text": "כמו שאתה האמנת בלב שלם בריבונו של עולם,"
  },
  {
   "start": 878.65,
   "end": 879.63,
   "text": "שהכל לטובה,"
  },
  {
   "start": 879.95,
   "end": 882.93,
   "text": "פה העולם ישפיע עליך שפע של טובה לך,"
  },
  {
   "start": 883.33,
   "end": 883.89,
   "text": "לילדים שלך."
  },
  {
   "start": 884.59,
   "end": 885.75,
   "text": "לילדים של הילדים,"
  },
  {
   "start": 893.12,
   "end": 893.76,
   "text": "והברכה,"
  },
  {
   "start": 894.72,
   "end": 899.04,
   "text": "הברכה שטובלה לה בלב מאמין,"
  },
  {
   "start": 899.58,
   "end": 900.5,
   "text": "בהרבה אמונה,"
  },
  {
   "start": 902.06,
   "end": 903.36,
   "text": "בהרבה יראת שמיים,"
  },
  {
   "start": 903.74,
   "end": 908.36,
   "text": "בהרבה דבקות בשם יתברך, בידיעה שמי מנהל את העולם זה הקדוש ברוך הוא,"
  },
  {
   "start": 909.1,
   "end": 909.9,
   "text": "נשאה פרי,"
  },
  {
   "start": 912.42,
   "end": 913.24,
   "text": "ומשה,"
  },
  {
   "start": 917.7,
   "end": 924.6,
   "text": "משה הצליח לשאת ברכה בכספו."
  },
  {
   "start": 925.28,
   "end": 926.22,
   "text": "אתם יודעים מי זה משה?"
  },
  {
   "start": 927.8,
   "end": 928.12,
   "text": "משה,"
  },
  {
   "start": 929.1,
   "end": 932.24,
   "text": "נהיה משה הנשיל רוטשילד."
  },
  {
   "start": 933.52,
   "end": 935.54,
   "text": "הבן שלו היה מאיר הנשיל רוטשילד,"
  },
  {
   "start": 936.34,
   "end": 937.1,
   "text": "וכך ממנו"
  },
  {
   "start": 938.34,
   "end": 940.16,
   "text": "צמחה לה שושלת רוטשילד."
  },
  {
   "start": 942.1,
   "end": 944.34,
   "text": "שושלת עם סימן של ברכה ועושר,"
  },
  {
   "start": 945.24,
   "end": 950.52,
   "text": "מאותו משה שהאמין בקדוש ברוך הוא מאז שהילד יתום,"
  },
  {
   "start": 951.16,
   "end": 953.84,
   "text": "ועשה את מה שהקדוש ברוך הוא רוצה שהוא יעשה,"
  },
  {
   "start": 956.07,
   "end": 957.17,
   "text": "ומחל על כבודו."
  },
  {
   "start": 960.31,
   "end": 962.43,
   "text": "לכבוד השם יתברך כדי לא לצייר יהודי"
  },
  {
   "start": 963.09,
   "end": 967.07,
   "text": "אמונה בהשם יתברך מזכה אותו ואת הצאצאים שלו"
  },
  {
   "start": 968.71,
   "end": 975.57,
   "text": "לנחת ועושר בעולם הזה ולפיסת גן עדן בעולם."
  }
 ]
}