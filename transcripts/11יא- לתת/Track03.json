{
 "disc": "11יא- לתת",
 "track": "Track03",
 "duration": 1326.192,
 "segments": [
  {
   "start": 13.66,
   "end": 15.24,
   "text": "העיר אוסטרופול."
  },
  {
   "start": 16.3,
   "end": 17.94,
   "text": "העיר אוסטרופול הייתה שוממה."
  },
  {
   "start": 19.6,
   "end": 21.28,
   "text": "הגשמים שניתחו להם בעוז"
  },
  {
   "start": 22.14,
   "end": 23.7,
   "text": "הבריחו את התושבים אל תוך בתיהם."
  },
  {
   "start": 25.22,
   "end": 26.38,
   "text": "הייתה תחושה כאילו,"
  },
  {
   "start": 26.96,
   "end": 28.38,
   "text": "כאילו השמיים בוכים."
  },
  {
   "start": 30.0,
   "end": 31.5,
   "text": "ככה נראתה העיירה באותו יום."
  },
  {
   "start": 33.38,
   "end": 40.28,
   "text": "ענן קטן וסמיך נח לו מעל העיירה והוריד מטר עז של גשם שגרם לכל התושבים"
  },
  {
   "start": 41.02,
   "end": 42.98,
   "text": "לחוש מעין תחושה פנימית"
  },
  {
   "start": 43.78,
   "end": 44.24,
   "text": "כאילו,"
  },
  {
   "start": 45.08,
   "end": 46.38,
   "text": "כאילו השמיים בוכים,"
  },
  {
   "start": 48.0,
   "end": 49.28,
   "text": "כאילו השמיים בוכים."
  },
  {
   "start": 52.06,
   "end": 55.1,
   "text": "באותו יום נפטר באוסטרופול יהודי ישיש,"
  },
  {
   "start": 55.86,
   "end": 60.0,
   "text": "בן 106. יהודי לא כל כך מוכר,"
  },
  {
   "start": 60.96,
   "end": 63.02,
   "text": "הגיע לפני זמן קצר לאוסטרופול."
  },
  {
   "start": 64.5,
   "end": 65.2,
   "text": "כששאלו אותו"
  },
  {
   "start": 66.78,
   "end": 67.56,
   "text": "תושבי העיירה"
  },
  {
   "start": 68.92,
   "end": 70.94,
   "text": "מדוע הוא נע ונד בדרכים,"
  },
  {
   "start": 72.46,
   "end": 72.9,
   "text": "הוא לא ענה."
  },
  {
   "start": 72.9,
   "end": 77.8,
   "text": "כל מה שהוא השיב זה היה חיוך מסתורי."
  },
  {
   "start": 80.6,
   "end": 81.38,
   "text": "כשהוא נפטר,"
  },
  {
   "start": 82.3,
   "end": 86.72,
   "text": "החבר'ה קדישא דאגו לנפטר הישיש לכל צורכי הקבורה,"
  },
  {
   "start": 87.66,
   "end": 89.38,
   "text": "ומסע ההלוויה יצא לדרך."
  },
  {
   "start": 91.94,
   "end": 95.78,
   "text": "רק קומץ של אנשים מתושבי העיירה ליוו את הישיש בדרכו האחרונה,"
  },
  {
   "start": 98.1,
   "end": 98.7,
   "text": "ולפתע,"
  },
  {
   "start": 100.16,
   "end": 101.42,
   "text": "באמצע מסע ההלוויה,"
  },
  {
   "start": 102.2,
   "end": 103.42,
   "text": "מן היער הסמוך,"
  },
  {
   "start": 104.26,
   "end": 104.8,
   "text": "הגיחו"
  },
  {
   "start": 105.52,
   "end": 106.78,
   "text": "חבורת אנשים"
  },
  {
   "start": 107.82,
   "end": 108.66,
   "text": "בלתי מוכרים."
  },
  {
   "start": 112.67,
   "end": 114.45,
   "text": "אם היית מתקרב, אם היית מתקרבת,"
  },
  {
   "start": 116.89,
   "end": 117.93,
   "text": "אפשר היה לראות שהם"
  },
  {
   "start": 118.55,
   "end": 120.11,
   "text": "לא היו אנשים רגילים."
  },
  {
   "start": 121.53,
   "end": 122.69,
   "text": "הם היו אנשים מיוחדים,"
  },
  {
   "start": 123.45,
   "end": 124.45,
   "text": "הדורי פנים,"
  },
  {
   "start": 125.19,
   "end": 127.01,
   "text": "מראה אולי נדיר באוסטרופול."
  },
  {
   "start": 128.05,
   "end": 128.99,
   "text": "ואותה חבורה,"
  },
  {
   "start": 130.19,
   "end": 132.53,
   "text": "אותה חבורה מסתורית נעלה בשקט"
  },
  {
   "start": 133.31,
   "end": 134.67,
   "text": "אחר מיטת הנפטר."
  },
  {
   "start": 140.04,
   "end": 141.74,
   "text": "כשהיה צורך לומר קדיש,"
  },
  {
   "start": 142.68,
   "end": 145.9,
   "text": "אחד מן החבורה התנדב לומר קדיש."
  },
  {
   "start": 147.16,
   "end": 148.66,
   "text": "וכשהוא אמר קדיש,"
  },
  {
   "start": 149.72,
   "end": 156.35,
   "text": "זה היה קדיש מיוחד שהתנגן לו בניגוד מיוחד."
  },
  {
   "start": 157.31,
   "end": 159.11,
   "text": "קדיש מעולמות עליונים."
  },
  {
   "start": 162.3,
   "end": 164.74,
   "text": "אחר כך היה צריך לומר את שם הנפטר,"
  },
  {
   "start": 165.52,
   "end": 169.8,
   "text": "ולמעשה באוסטרופו לא ידעו בדיוק מהו שם הנפטר."
  },
  {
   "start": 170.76,
   "end": 171.98,
   "text": "אבל אותה חבורה ביסטורית,"
  },
  {
   "start": 173.4,
   "end": 175.74,
   "text": "הם ידעו צבי בן יחיאל,"
  },
  {
   "start": 178.6,
   "end": 179.96,
   "text": "כך נרשם על המצבה,"
  },
  {
   "start": 182.48,
   "end": 189.48,
   "text": "והלוויה הסתיימה דקות ספורות אחר כך,"
  },
  {
   "start": 189.98,
   "end": 193.02,
   "text": "נעלמה אותה חבורה מסתורית ומופלאה"
  },
  {
   "start": 194.52,
   "end": 196.9,
   "text": "באותה צורה שהופיעה"
  },
  {
   "start": 198.85,
   "end": 199.97,
   "text": "זמן רב אחר כך."
  },
  {
   "start": 200.51,
   "end": 203.95,
   "text": "עוד דיברו בו אוסטרופול על אותה חבורת מופלאים מסתורית."
  },
  {
   "start": 206.33,
   "end": 206.59,
   "text": "מי הם?"
  },
  {
   "start": 207.25,
   "end": 207.83,
   "text": "איש לא ידע."
  },
  {
   "start": 212.99,
   "end": 214.71,
   "text": "איש מתושבי אוסטרופול."
  },
  {
   "start": 216.31,
   "end": 219.49,
   "text": "איש מתושבי אוסטרופול לא יכל לשער,"
  },
  {
   "start": 220.03,
   "end": 224.55,
   "text": "לא יכל לדמיין שהייתה"
  },
  {
   "start": 225.33,
   "end": 226.31,
   "text": "הייתה להם הזכות,"
  },
  {
   "start": 227.75,
   "end": 233.21,
   "text": "זכות חד פעמית לארח חלק נכבד"
  },
  {
   "start": 233.89,
   "end": 237.83,
   "text": "מלמד וו הצדיקים הנסתרים שבאותו דור,"
  },
  {
   "start": 241.36,
   "end": 241.86,
   "text": "שבאו"
  },
  {
   "start": 243.18,
   "end": 247.58,
   "text": "ללוות את צבי בן יחיאל."
  },
  {
   "start": 250.09,
   "end": 251.69,
   "text": "מי היה אותו ישיש מסתורי?"
  },
  {
   "start": 253.25,
   "end": 256.73,
   "text": "לשם כך נחזור מספר רב של שנים אחורה"
  },
  {
   "start": 257.73,
   "end": 258.85,
   "text": "אל העיר ברודי,"
  },
  {
   "start": 270.68,
   "end": 271.72,
   "text": "היריד הגדול בברודי."
  },
  {
   "start": 273.4,
   "end": 274.66,
   "text": "מכל כפרי הסביבה"
  },
  {
   "start": 275.58,
   "end": 277.08,
   "text": "הגיעו תושבים יהודים"
  },
  {
   "start": 278.04,
   "end": 278.62,
   "text": "אל היריד,"
  },
  {
   "start": 279.32,
   "end": 281.84,
   "text": "מסתובבים מרחבי היריד, מנסים לאתר מבצעים,"
  },
  {
   "start": 282.98,
   "end": 283.76,
   "text": "מציאות."
  },
  {
   "start": 285.6,
   "end": 286.38,
   "text": "באחד הפינות"
  },
  {
   "start": 287.22,
   "end": 287.96,
   "text": "עמד לו אדם,"
  },
  {
   "start": 289.9,
   "end": 292.96,
   "text": "וסביבו התקבצו עשרות יהודים"
  },
  {
   "start": 294.08,
   "end": 296.56,
   "text": "מרותקים למוצא פיו הקדוש,"
  },
  {
   "start": 298.77,
   "end": 299.61,
   "text": "ואותו אדם"
  },
  {
   "start": 300.41,
   "end": 301.69,
   "text": "סיפר ללא הרף"
  },
  {
   "start": 304.06,
   "end": 305.58,
   "text": "על עולם של יהדות,"
  },
  {
   "start": 306.62,
   "end": 307.88,
   "text": "על תנאים קדושים,"
  },
  {
   "start": 308.76,
   "end": 310.12,
   "text": "על הבוראים מופלאים,"
  },
  {
   "start": 310.82,
   "end": 315.4,
   "text": "ועוד ועוד סיפורים מגדולי הצדיקים שהיו בעם ישראל."
  },
  {
   "start": 316.96,
   "end": 317.5,
   "text": "וכולם,"
  },
  {
   "start": 318.56,
   "end": 327.0,
   "text": "כולם בלעו בשקיקה את סיפוריו לפתע."
  },
  {
   "start": 328.06,
   "end": 329.56,
   "text": "לפתע פסק היהודי מלספר."
  },
  {
   "start": 331.2,
   "end": 331.96,
   "text": "מבטו הופנה"
  },
  {
   "start": 331.96,
   "end": 337.34,
   "text": "אל מעבר לחבורת הנאספים סביבו."
  },
  {
   "start": 338.44,
   "end": 338.82,
   "text": "שם,"
  },
  {
   "start": 339.8,
   "end": 341.1,
   "text": "שם במרכז היריד,"
  },
  {
   "start": 341.82,
   "end": 342.84,
   "text": "עבר לו יהודי,"
  },
  {
   "start": 344.0,
   "end": 345.0,
   "text": "סבל יהודי,"
  },
  {
   "start": 346.12,
   "end": 347.26,
   "text": "בעל מראה עלוב,"
  },
  {
   "start": 348.78,
   "end": 350.88,
   "text": "וכל כולו אומר עוני מחריד."
  },
  {
   "start": 353.24,
   "end": 358.26,
   "text": "מאחורי היהודי השתרך לו שובל של ילדים, ילדים שובבים,"
  },
  {
   "start": 358.88,
   "end": 360.36,
   "text": "שהחלו מקפצים אחריו"
  },
  {
   "start": 361.0,
   "end": 363.08,
   "text": "וקוראים אחריו קריאות של להג,"
  },
  {
   "start": 363.4,
   "end": 369.4,
   "text": "בוז וצחוק רודפים אחריו וקוראים לו מר עז, מר עז."
  },
  {
   "start": 380.3,
   "end": 380.6,
   "text": "מי זה?"
  },
  {
   "start": 381.58,
   "end": 384.8,
   "text": "מי זה היהודי הזה?"
  },
  {
   "start": 385.84,
   "end": 391.84,
   "text": "שאל אותו אדם הדור פנים שסביבו התקבצו יהודים לשמוע את מוצא פיו הקדוש והטהור."
  },
  {
   "start": 395.02,
   "end": 396.42,
   "text": "אחריכו האנשים ואמרו לו זה?"
  },
  {
   "start": 397.16,
   "end": 398.36,
   "text": "זה צבי הסבל."
  },
  {
   "start": 400.7,
   "end": 402.44,
   "text": "הוא יהודי אלמן, יש לו שני בנים,"
  },
  {
   "start": 403.22,
   "end": 404.18,
   "text": "הם נמצאים בישיבה."
  },
  {
   "start": 404.76,
   "end": 407.28,
   "text": "והוא בבית נשאר אלמן בודד,"
  },
  {
   "start": 407.82,
   "end": 409.8,
   "text": "עובד כסבל ומתפרנס למחייתו."
  },
  {
   "start": 411.36,
   "end": 413.6,
   "text": "אבל כל כך מוזר,"
  },
  {
   "start": 414.38,
   "end": 415.72,
   "text": "את מרבית הכסף שלו"
  },
  {
   "start": 418.19,
   "end": 420.91,
   "text": "הוא מקדיש ללא פחות ולא יותר"
  },
  {
   "start": 422.37,
   "end": 427.51,
   "text": "ארבע עיזים שמתגוררות אצלו בבית,"
  },
  {
   "start": 428.55,
   "end": 429.57,
   "text": "אצלו בצריף."
  },
  {
   "start": 431.03,
   "end": 431.73,
   "text": "ארבע עיזים,"
  },
  {
   "start": 434.68,
   "end": 439.28,
   "text": "ועליהם הוא מקדיש את רוב זמנו ואת מיטב כספו."
  },
  {
   "start": 439.86,
   "end": 442.16,
   "text": "לכן הילדים צוחקים, קוראים לו מר עז,"
  },
  {
   "start": 445.11,
   "end": 445.59,
   "text": "ועיניו"
  },
  {
   "start": 446.41,
   "end": 447.49,
   "text": "של אותו יהודי."
  },
  {
   "start": 449.31,
   "end": 451.03,
   "text": "הדורפנים עקבו כל הזמן"
  },
  {
   "start": 451.71,
   "end": 453.05,
   "text": "אחרי דמותו של צבי,"
  },
  {
   "start": 454.51,
   "end": 455.09,
   "text": "מר עז,"
  },
  {
   "start": 456.25,
   "end": 457.01,
   "text": "עד שנעלם."
  },
  {
   "start": 462.33,
   "end": 462.83,
   "text": "היהודי,"
  },
  {
   "start": 464.8,
   "end": 468.26,
   "text": "זה שפיו הקדוש לא הפסיק לספר לעם ישראל"
  },
  {
   "start": 469.42,
   "end": 471.04,
   "text": "על עולם היהדות המופלא,"
  },
  {
   "start": 471.56,
   "end": 474.42,
   "text": "לא היה יהודי רגיל ופשוט כלל ועיקר."
  },
  {
   "start": 475.36,
   "end": 482.08,
   "text": "היה זה לא פחות ולא יותר מאשר רבי ישראל הבעל שם טוב,"
  },
  {
   "start": 483.5,
   "end": 485.08,
   "text": "הבעל שם טוב הקדוש."
  },
  {
   "start": 485.86,
   "end": 486.88,
   "text": "והבעל שם טוב,"
  },
  {
   "start": 487.52,
   "end": 490.3,
   "text": "הוא ראה את מה שאיש לא יכול לראות."
  },
  {
   "start": 491.02,
   "end": 494.24,
   "text": "הוא ראה איך מעל ראשו של אותו צבי"
  },
  {
   "start": 495.0,
   "end": 497.22,
   "text": "העיר לו עמוד זך,"
  },
  {
   "start": 497.9,
   "end": 500.52,
   "text": "צלול ובהיר של אור,"
  },
  {
   "start": 501.24,
   "end": 502.18,
   "text": "אור יקרות,"
  },
  {
   "start": 503.02,
   "end": 504.36,
   "text": "לא מהעולם הזה."
  },
  {
   "start": 508.07,
   "end": 514.65,
   "text": "והבעל שם טוב נשאר בברודי והחל עוקב אחרי הסבל היהודי."
  },
  {
   "start": 516.21,
   "end": 516.91,
   "text": "מחפש,"
  },
  {
   "start": 518.05,
   "end": 520.03,
   "text": "מנסה לאתר, לגלות את הסוד שלו,"
  },
  {
   "start": 520.43,
   "end": 527.79,
   "text": "את סוד האור המקיף את כל סביבותיו של אותו סבל שכולם לועגים לו וקוראים לו מר עז."
  },
  {
   "start": 531.29,
   "end": 533.27,
   "text": "למרב הפתעתו הוא לא מגלה דבר."
  },
  {
   "start": 534.95,
   "end": 536.07,
   "text": "עמד הבעל שם טוב"
  },
  {
   "start": 536.73,
   "end": 539.85,
   "text": "וקיבל על עצמו תענית ותפילה לבורא עולם."
  },
  {
   "start": 540.49,
   "end": 548.27,
   "text": "בעולם תזכה אותי שאני ידע לעמוד על אותה עבודת קודש הנסתרת של אותו סבל מופלא."
  },
  {
   "start": 548.65,
   "end": 552.35,
   "text": "איך הוא זוכה לאור כל כך זך וצלול."
  },
  {
   "start": 553.23,
   "end": 556.61,
   "text": "איך הוא זוכה לעשות נחת למי שאמר והיה עולם."
  },
  {
   "start": 567.14,
   "end": 570.96,
   "text": "ניגש הבעל שם טוב אל צבי הסבל."
  },
  {
   "start": 573.26,
   "end": 573.9,
   "text": "שלום יהודי,"
  },
  {
   "start": 574.62,
   "end": 577.04,
   "text": "שמעתי שניתן לקנות אצלך חלב של עז."
  },
  {
   "start": 581.96,
   "end": 582.74,
   "text": "חייך צבי,"
  },
  {
   "start": 584.34,
   "end": 586.34,
   "text": "חיוך של פשטות, של תמימות,"
  },
  {
   "start": 587.06,
   "end": 587.76,
   "text": "ואמר לו,"
  },
  {
   "start": 590.82,
   "end": 591.02,
   "text": "בוא,"
  },
  {
   "start": 592.04,
   "end": 595.04,
   "text": "בוא עמי, אני אתן לך חלב עזים חינם."
  },
  {
   "start": 596.78,
   "end": 597.58,
   "text": "חינם אין כסף,"
  },
  {
   "start": 599.68,
   "end": 601.34,
   "text": "והבעל שם טוב התלווה אליו."
  },
  {
   "start": 602.48,
   "end": 604.08,
   "text": "הם עוברים את בתי העיר הססגוניים,"
  },
  {
   "start": 605.24,
   "end": 606.98,
   "text": "הם עוברים גם את פרברי העיר,"
  },
  {
   "start": 607.8,
   "end": 612.16,
   "text": "עד שמגיעים לשכונת פחונים ששכנה לה שם בפאתי העיר,"
  },
  {
   "start": 612.92,
   "end": 616.34,
   "text": "כשהדלות והעוני זועקים להם מכל פינה."
  },
  {
   "start": 619.63,
   "end": 621.23,
   "text": "הם הגיעו לחורבה אחת,"
  },
  {
   "start": 621.87,
   "end": 624.31,
   "text": "וצבי הזמין את הבעל שם טוב להיכנס."
  },
  {
   "start": 625.97,
   "end": 626.59,
   "text": "הם נכנסו,"
  },
  {
   "start": 627.83,
   "end": 631.5,
   "text": "ואת פניהם קידמו העיזים,"
  },
  {
   "start": 632.56,
   "end": 634.82,
   "text": "העיזים שהיו ממש בתוך החורבה."
  },
  {
   "start": 638.89,
   "end": 640.67,
   "text": "לצבי לא היה מקום אחר לגדל אותם,"
  },
  {
   "start": 642.37,
   "end": 644.39,
   "text": "ומשום מה הוא התעקש לגדל עיזים."
  },
  {
   "start": 645.27,
   "end": 646.21,
   "text": "אז בחדר אחד"
  },
  {
   "start": 647.29,
   "end": 648.17,
   "text": "הוא היה גר,"
  },
  {
   "start": 649.15,
   "end": 652.95,
   "text": "ובחדר השני של החורבה הקטנה הזו העזים היו גרים."
  },
  {
   "start": 665.23,
   "end": 672.75,
   "text": "הושיט כוס חלב לבעל שם טוב והביט בו."
  },
  {
   "start": 675.87,
   "end": 677.05,
   "text": "וצבי החל מדבר."
  },
  {
   "start": 677.99,
   "end": 683.19,
   "text": "הוא כאילו יודע שהבעל שם טוב מחכה לשמוע מהו סוד העזים,"
  },
  {
   "start": 686.09,
   "end": 687.01,
   "text": "מהו הסוד שלו."
  },
  {
   "start": 696.07,
   "end": 697.01,
   "text": "והוא החל מספר."
  },
  {
   "start": 698.87,
   "end": 699.65,
   "text": "כבוד הרב,"
  },
  {
   "start": 700.35,
   "end": 702.99,
   "text": "כמו שלעולם יש שמש שמאירה,"
  },
  {
   "start": 705.28,
   "end": 707.04,
   "text": "גם לי הייתה שמש שמאירה."
  },
  {
   "start": 707.04,
   "end": 709.22,
   "text": "קראו לה שרה,"
  },
  {
   "start": 710.26,
   "end": 710.7,
   "text": "אשתי,"
  },
  {
   "start": 711.46,
   "end": 713.92,
   "text": "אשתי היקרה והחסודה,"
  },
  {
   "start": 715.26,
   "end": 715.98,
   "text": "עליה השלום."
  },
  {
   "start": 717.64,
   "end": 719.14,
   "text": "החיים שלנו היו חיים בעוני,"
  },
  {
   "start": 720.1,
   "end": 723.28,
   "text": "אבל עם הרבה הרבה שלום, הרבה הרבה שלווה."
  },
  {
   "start": 724.0,
   "end": 724.44,
   "text": "בלילות"
  },
  {
   "start": 725.5,
   "end": 727.96,
   "text": "שרה הייתה יוצאת למעשה החסד שלה,"
  },
  {
   "start": 728.88,
   "end": 730.3,
   "text": "לסייע לזולת."
  },
  {
   "start": 732.08,
   "end": 735.0,
   "text": "היא הייתה מתכסה בצעיף שהיה מסתיר את פניה,"
  },
  {
   "start": 735.0,
   "end": 737.6,
   "text": "והייתה יוצאת."
  },
  {
   "start": 739.22,
   "end": 741.88,
   "text": "לא הייתה חולה שהיא לא ביקרה."
  },
  {
   "start": 742.76,
   "end": 757.56,
   "text": "לא הייתה יולדת ענייה שלא קיבלה סיוע ותמיכה. המלאך של ברודי כונתה אותה דמות של אישה שבאה וסייעה,"
  },
  {
   "start": 758.32,
   "end": 759.04,
   "text": "כשאיש"
  },
  {
   "start": 760.52,
   "end": 761.88,
   "text": "לא יודע על זהותה."
  },
  {
   "start": 763.36,
   "end": 763.82,
   "text": "ואני,"
  },
  {
   "start": 764.64,
   "end": 765.82,
   "text": "אני הייתי המלווה שלה."
  },
  {
   "start": 766.78,
   "end": 768.82,
   "text": "אני זכיתי להיות מלווה מלכה שלה."
  },
  {
   "start": 770.24,
   "end": 773.52,
   "text": "היא הייתה מלכת החסד ואני הייתי המלווה מלכה."
  },
  {
   "start": 774.9,
   "end": 778.34,
   "text": "הייתי ממתין לה בחוץ עד שסיים את פעילותה הקדושה"
  },
  {
   "start": 779.78,
   "end": 781.4,
   "text": "והפעילות המשותפת בלילות."
  },
  {
   "start": 782.58,
   "end": 784.76,
   "text": "אני לא מאמין שאפשר למצוא עוד דבר שכזה."
  },
  {
   "start": 786.64,
   "end": 787.48,
   "text": "ואז יום אחד."
  },
  {
   "start": 789.34,
   "end": 790.26,
   "text": "המלאך של ברודי"
  },
  {
   "start": 792.22,
   "end": 793.94,
   "text": "כנס את כנפיו, שרה שלי."
  },
  {
   "start": 794.92,
   "end": 796.12,
   "text": "שרה שלי נפטרה."
  },
  {
   "start": 796.78,
   "end": 798.6,
   "text": "היא שאירה אותי לבד בעולם."
  },
  {
   "start": 804.53,
   "end": 805.63,
   "text": "היה לי כל כך קשה."
  },
  {
   "start": 807.21,
   "end": 808.17,
   "text": "ובורא עולם,"
  },
  {
   "start": 808.73,
   "end": 810.01,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 810.65,
   "end": 812.11,
   "text": "ראה את המפעל שלנו,"
  },
  {
   "start": 812.75,
   "end": 814.49,
   "text": "ראה את האחדות שהייתה בינינו,"
  },
  {
   "start": 816.19,
   "end": 818.75,
   "text": "ומצאה דרך לאחד בינינו מחדש."
  },
  {
   "start": 829.65,
   "end": 831.19,
   "text": "שרה אשתי מופיעה אצלי,"
  },
  {
   "start": 831.71,
   "end": 832.83,
   "text": "ממש כמו במציאות."
  },
  {
   "start": 833.99,
   "end": 834.83,
   "text": "והיא מספרת לי"
  },
  {
   "start": 835.43,
   "end": 837.33,
   "text": "כמה טוב לה בעולם האמת."
  },
  {
   "start": 838.65,
   "end": 840.27,
   "text": "והיא נראתה כל כך זוהרת,"
  },
  {
   "start": 840.85,
   "end": 843.53,
   "text": "כל כך מאירה, כל כך קורנת."
  },
  {
   "start": 844.31,
   "end": 845.11,
   "text": "ושאלתי אותה,"
  },
  {
   "start": 846.55,
   "end": 848.49,
   "text": "רעייתי היקרה והחשובה,"
  },
  {
   "start": 849.15,
   "end": 850.35,
   "text": "איך זכית לכל זה?"
  },
  {
   "start": 851.61,
   "end": 852.63,
   "text": "היא אמרה לי, הכל,"
  },
  {
   "start": 853.15,
   "end": 855.01,
   "text": "הכל בזכות הסיוע לזולת,"
  },
  {
   "start": 855.53,
   "end": 858.01,
   "text": "הכל בגלל הלב הטוב, הלב היהודי,"
  },
  {
   "start": 858.81,
   "end": 860.11,
   "text": "שהיא נתנה לזולת,"
  },
  {
   "start": 860.83,
   "end": 863.47,
   "text": "לבנות של הקדוש ברוך הוא."
  },
  {
   "start": 865.47,
   "end": 866.59,
   "text": "על המאור פנים,"
  },
  {
   "start": 867.11,
   "end": 868.27,
   "text": "על שפת הלב,"
  },
  {
   "start": 869.09,
   "end": 873.43,
   "text": "על ניגון הלב שהייתה מנגנת ללבבות נשברים."
  },
  {
   "start": 879.8,
   "end": 886.0,
   "text": "בבית דין של מעלה הופיעו כל אותם אלו שהיא סעדה אותם כשהיו חולים,"
  },
  {
   "start": 887.06,
   "end": 889.08,
   "text": "ואותם נשמות העידו לטובתה,"
  },
  {
   "start": 889.5,
   "end": 893.64,
   "text": "ואותם מלאכים שנוצרו ממעשי החסד שלה, מהלב הטהור שלה,"
  },
  {
   "start": 894.22,
   "end": 895.1,
   "text": "באו להעיד עבורה."
  },
  {
   "start": 896.42,
   "end": 897.76,
   "text": "ואז היא פנתה אליי ואמרה לי,"
  },
  {
   "start": 899.12,
   "end": 900.56,
   "text": "צביעת היהודי פשוט,"
  },
  {
   "start": 901.08,
   "end": 902.8,
   "text": "תורה אתה לא יודע,"
  },
  {
   "start": 904.32,
   "end": 904.8,
   "text": "תפילה"
  },
  {
   "start": 906.22,
   "end": 907.26,
   "text": "אתה לא יודע להתפלל,"
  },
  {
   "start": 908.24,
   "end": 909.76,
   "text": "לפחות תשתדל."
  },
  {
   "start": 910.56,
   "end": 914.14,
   "text": "לפחות תשתדל לעשות חסד בצדקה עם יהודים."
  },
  {
   "start": 914.88,
   "end": 917.52,
   "text": "לפחות תאיר את הלב היהודי שלך."
  },
  {
   "start": 918.08,
   "end": 919.94,
   "text": "תן לב לעם ישראל."
  },
  {
   "start": 923.29,
   "end": 924.89,
   "text": "תגמול חסד."
  },
  {
   "start": 925.43,
   "end": 928.17,
   "text": "תפתח את הלב שלך לעם ישראל."
  },
  {
   "start": 928.95,
   "end": 930.51,
   "text": "אבל תזכור לעשות הכל בשקט."
  },
  {
   "start": 932.11,
   "end": 934.05,
   "text": "אתה לא צריך לגלות לאף אחד על המעשים שלך."
  },
  {
   "start": 941.52,
   "end": 942.22,
   "text": "התעוררתי בבוקר."
  },
  {
   "start": 943.8,
   "end": 946.58,
   "text": "לא ידעתי איך להתחיל, במה להתחיל."
  },
  {
   "start": 946.64,
   "end": 950.64,
   "text": "אבל אז נזכרתי שיש משהו שאני כן יודע לעשות,"
  },
  {
   "start": 951.16,
   "end": 953.36,
   "text": "להתפלל אולי לא, תורה אני לא יודע,"
  },
  {
   "start": 954.2,
   "end": 956.84,
   "text": "אבל לגדל עיזים אני כן יודע,"
  },
  {
   "start": 958.2,
   "end": 960.08,
   "text": "להיות סבל אני כן יודע."
  },
  {
   "start": 961.7,
   "end": 964.18,
   "text": "ועבדתי קשה, וחסכתי לי כסף,"
  },
  {
   "start": 964.8,
   "end": 966.76,
   "text": "ובכסף קניתי ארבע עיזים,"
  },
  {
   "start": 967.9,
   "end": 969.88,
   "text": "ואני מגדל אותם אצלי בבית,"
  },
  {
   "start": 970.94,
   "end": 972.7,
   "text": "ואת החלב שלהם"
  },
  {
   "start": 972.7,
   "end": 995.23,
   "text": "אני מספק בלילות ליולדות עניות וסובלות לילדים קשי יום לחולים לחזק את עם ישראל כל לילה אני מספק חלב"
  },
  {
   "start": 996.17,
   "end": 1000.77,
   "text": "חלב נזים חם טהור ומבריא לכל יהודי הסביבה"
  },
  {
   "start": 1001.43,
   "end": 1001.95,
   "text": "חינם"
  },
  {
   "start": 1002.73,
   "end": 1003.97,
   "text": "בלי שאף אחד ידע שזה אני"
  },
  {
   "start": 1003.97,
   "end": 1006.99,
   "text": "אז צוחקים עליי,"
  },
  {
   "start": 1007.81,
   "end": 1010.35,
   "text": "אז לועגים לי, קוראים לי מר עז,"
  },
  {
   "start": 1011.19,
   "end": 1012.33,
   "text": "אבל אני בשלי."
  },
  {
   "start": 1013.57,
   "end": 1015.49,
   "text": "מוטב שיקראו לי מר עז,"
  },
  {
   "start": 1016.13,
   "end": 1019.15,
   "text": "ושאיש לא יעלה על דעתו מי זה."
  },
  {
   "start": 1019.57,
   "end": 1023.07,
   "text": "מי זה שם חלב של עיזים בפתח של הבית"
  },
  {
   "start": 1024.01,
   "end": 1030.16,
   "text": "של ילדי העיירה, לילה-לילה."
  },
  {
   "start": 1031.58,
   "end": 1035.3,
   "text": "אתה יודע, כבוד הרב, חלק מהילדים שרודפים אחריי,"
  },
  {
   "start": 1036.0,
   "end": 1045.8,
   "text": "אני זוכר כשהם שכבו חולים וחלושים ומילאתי את הכוס של ידם בחלב חם ומזין שסייע להם לחזור לאיתנם."
  },
  {
   "start": 1050.0,
   "end": 1052.54,
   "text": "ואני כל כך שמח שהם בריאים."
  },
  {
   "start": 1053.08,
   "end": 1056.34,
   "text": "אני כל כך שמח שיש להם את הכוח לרדוף אחריי."
  },
  {
   "start": 1059.08,
   "end": 1059.8,
   "text": "והבעל שם טוב,"
  },
  {
   "start": 1060.84,
   "end": 1063.4,
   "text": "נפעם כולו, מביט במר העז."
  },
  {
   "start": 1063.82,
   "end": 1065.82,
   "text": "זה המבוזה, זה הנלעג,"
  },
  {
   "start": 1066.12,
   "end": 1070.12,
   "text": "זה שמחייב ומציל את הילדים שרודפים אחריו אחרי זה,"
  },
  {
   "start": 1070.12,
   "end": 1073.56,
   "text": "זה שהאזן את הילדות"
  },
  {
   "start": 1075.32,
   "end": 1077.36,
   "text": "שזה עתה טרקו בפניו את הדלת,"
  },
  {
   "start": 1082.82,
   "end": 1084.48,
   "text": "חיים בעוני ובמצוקה,"
  },
  {
   "start": 1086.0,
   "end": 1090.46,
   "text": "אבל מחלק ברוחב לב-לב יהודי."
  },
  {
   "start": 1095.77,
   "end": 1098.71,
   "text": "יש מלאך, יש מלאך לברודי."
  },
  {
   "start": 1099.37,
   "end": 1101.09,
   "text": "המלאך של ברודי חזר."
  },
  {
   "start": 1101.79,
   "end": 1102.83,
   "text": "זהו האיש הבזוי"
  },
  {
   "start": 1104.35,
   "end": 1105.11,
   "text": "של העיר"
  },
  {
   "start": 1105.97,
   "end": 1106.73,
   "text": "צבי הסבל."
  },
  {
   "start": 1108.07,
   "end": 1108.87,
   "text": "וצבי ממשיך"
  },
  {
   "start": 1109.11,
   "end": 1114.79,
   "text": "בקול מלא פשטות ותמינות, כבוד הרב, את כל הכסף שלי."
  },
  {
   "start": 1116.13,
   "end": 1117.93,
   "text": "את כל הכסף אני נותן לאוכל לעיזים,"
  },
  {
   "start": 1118.73,
   "end": 1124.73,
   "text": "שיאכלו טוב. אני עובד קשה כדי שיהיה אוכל טוב לעיזים, כדי שהם יניבו חלב נפלא ומבריא."
  },
  {
   "start": 1125.63,
   "end": 1127.31,
   "text": "ככה אני עושה במשך שנים,"
  },
  {
   "start": 1128.33,
   "end": 1129.01,
   "text": "ואף אחד לא יודע."
  },
  {
   "start": 1131.46,
   "end": 1133.04,
   "text": "לא יודע למה אני מספר לך, כבוד הרב."
  },
  {
   "start": 1134.2,
   "end": 1135.02,
   "text": "אתמול בלילה,"
  },
  {
   "start": 1136.66,
   "end": 1137.74,
   "text": "אחרי זמן רב,"
  },
  {
   "start": 1139.88,
   "end": 1143.82,
   "text": "שוב באה שרה שלי אליי בחלום."
  },
  {
   "start": 1145.26,
   "end": 1145.88,
   "text": "והיא אמרה לי,"
  },
  {
   "start": 1146.54,
   "end": 1146.9,
   "text": "צבי,"
  },
  {
   "start": 1148.04,
   "end": 1148.34,
   "text": "מחר,"
  },
  {
   "start": 1149.14,
   "end": 1152.1,
   "text": "מחר יפנה אליך יהודי ויבקש ממך חלב."
  },
  {
   "start": 1153.16,
   "end": 1154.04,
   "text": "תזמין אותו אליך"
  },
  {
   "start": 1154.98,
   "end": 1157.08,
   "text": "ותספר לו על הסוד שלנו."
  },
  {
   "start": 1157.64,
   "end": 1161.5,
   "text": "תספר לו ואחר כך תקשיב למה שיאמר לך."
  },
  {
   "start": 1162.46,
   "end": 1163.04,
   "text": "אל תחשוב הרבה,"
  },
  {
   "start": 1163.78,
   "end": 1164.58,
   "text": "אל תהסס."
  },
  {
   "start": 1165.5,
   "end": 1166.84,
   "text": "לך בעקבות היהודי הזה."
  },
  {
   "start": 1167.24,
   "end": 1169.88,
   "text": "לך בעקבות היהודי הזה."
  },
  {
   "start": 1175.77,
   "end": 1176.69,
   "text": "והבעל שם טוב,"
  },
  {
   "start": 1178.17,
   "end": 1184.33,
   "text": "שסוף סוף הבין מה מקור קרן האור מעולמות עליונים שהקיפה"
  },
  {
   "start": 1185.05,
   "end": 1188.83,
   "text": "את צבי הסבל, הוא לקח אותו איתו,"
  },
  {
   "start": 1189.51,
   "end": 1190.47,
   "text": "הוא קרב אותו אליו."
  },
  {
   "start": 1191.71,
   "end": 1193.09,
   "text": "הוא דאג לו לתלמידים,"
  },
  {
   "start": 1193.91,
   "end": 1196.27,
   "text": "תלמידי הבעל שם טוב הקדושים,"
  },
  {
   "start": 1196.97,
   "end": 1200.43,
   "text": "שילמדו את צבי הסבל תורה אות אחרי אות,"
  },
  {
   "start": 1201.73,
   "end": 1202.81,
   "text": "שלב אחרי שלב."
  },
  {
   "start": 1203.63,
   "end": 1206.93,
   "text": "וצבי מתקדם לו במעלות התורה הקדושה והיראה."
  },
  {
   "start": 1210.11,
   "end": 1212.31,
   "text": "מאוחר יותר צורף צבי,"
  },
  {
   "start": 1212.91,
   "end": 1218.01,
   "text": "שכבר נהפך לתלמיד חכם מן המניין אל חבורת הצדיקים הנסתרים,"
  },
  {
   "start": 1218.99,
   "end": 1224.21,
   "text": "והיה אחד מלמד וו צדיקים נסתרים שמחזיקים את העולם."
  },
  {
   "start": 1226.07,
   "end": 1228.11,
   "text": "צבי החל להסתובב בערים, מחזק את הרבים,"
  },
  {
   "start": 1229.13,
   "end": 1230.57,
   "text": "מחזק יהודים, מקרב אותם לתורה,"
  },
  {
   "start": 1231.27,
   "end": 1236.03,
   "text": "ועסק בעוד מספר משימות סודיות לטובת עם ישראל והעולם כולו."
  },
  {
   "start": 1237.91,
   "end": 1240.03,
   "text": "עד לאותו יום באוסטרפול,"
  },
  {
   "start": 1241.15,
   "end": 1241.37,
   "text": "שם"
  },
  {
   "start": 1242.19,
   "end": 1244.93,
   "text": "זקן ושבע הימים ב-106 שנים"
  },
  {
   "start": 1245.47,
   "end": 1249.91,
   "text": "נלקח לבית עולמו להיפגש בגן עדן עם שרה,"
  },
  {
   "start": 1250.55,
   "end": 1251.77,
   "text": "עם שרה לרעייתו,"
  },
  {
   "start": 1252.65,
   "end": 1254.41,
   "text": "והפעם לא כצבי הסבל,"
  },
  {
   "start": 1254.79,
   "end": 1256.87,
   "text": "אלא כרבי צבי בן יחיאל,"
  },
  {
   "start": 1257.27,
   "end": 1258.57,
   "text": "צדיק נסתר,"
  },
  {
   "start": 1266.21,
   "end": 1268.53,
   "text": "לימד אותנו, יהודי פשוט,"
  },
  {
   "start": 1269.23,
   "end": 1271.99,
   "text": "יהודי פשוט, איך הלב היהודי יכול להיות"
  },
  {
   "start": 1273.19,
   "end": 1274.87,
   "text": "להאיר עיירה שלמה."
  },
  {
   "start": 1275.93,
   "end": 1278.73,
   "text": "מלאך של ברודי, המלאך של ברודי."
  },
  {
   "start": 1279.87,
   "end": 1281.21,
   "text": "לב יהודי של אישה,"
  },
  {
   "start": 1281.79,
   "end": 1283.05,
   "text": "לב יהודי של איש,"
  },
  {
   "start": 1283.45,
   "end": 1285.07,
   "text": "מאירים להם עיר שלמה."
  },
  {
   "start": 1285.75,
   "end": 1292.88,
   "text": "ולנו לא נותר אלא להיות שמחים שזכינו ללב יהודי ולהאיר אותו."
  },
  {
   "start": 1293.8,
   "end": 1296.66,
   "text": "להפוך את דפיקות הלב האלה,"
  },
  {
   "start": 1296.94,
   "end": 1303.1,
   "text": "את הניצוץ שבלב שלנו ללהבה, להבה של קדושה, של טהרה, של חסד."
  },
  {
   "start": 1304.28,
   "end": 1307.48,
   "text": "לכבוד השם יתברך לטובת עם ישראל."
  }
 ]
}