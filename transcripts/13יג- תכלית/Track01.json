{
 "disc": "13יג- תכלית",
 "track": "Track01",
 "duration": 1084.08,
 "segments": [
  {
   "start": 5.66,
   "end": 5.94,
   "text": "הנרי."
  },
  {
   "start": 7.8,
   "end": 13.06,
   "text": "הנרי היה כל מה שהאמריקני ממוצע חולם להיות."
  },
  {
   "start": 16.14,
   "end": 19.3,
   "text": "איש עסקים מצליח שבנה את עצמו במו ידיו."
  },
  {
   "start": 22.01,
   "end": 22.81,
   "text": "תמיד הוא היה נוהג"
  },
  {
   "start": 24.03,
   "end": 25.71,
   "text": "להרים את הידיים שלו ולומר,"
  },
  {
   "start": 26.51,
   "end": 27.51,
   "text": "האצבעות האלו"
  },
  {
   "start": 29.03,
   "end": 30.65,
   "text": "כתבו סיפור הצלחה."
  },
  {
   "start": 31.97,
   "end": 35.05,
   "text": "באצבעות האלה כתבתי את סיפור ההצלחה שלי."
  },
  {
   "start": 37.01,
   "end": 38.71,
   "text": "בארץ האפשרויות הבלתי מוגבלות"
  },
  {
   "start": 39.25,
   "end": 41.51,
   "text": "ווינר או לוזר זו שאלה של חיים,"
  },
  {
   "start": 42.37,
   "end": 44.67,
   "text": "להצליח או להיכשל זוהי נקודה קריטית,"
  },
  {
   "start": 45.59,
   "end": 46.07,
   "text": "והנרי,"
  },
  {
   "start": 46.67,
   "end": 48.33,
   "text": "הנרי גילם את כל מה שההצלחה"
  },
  {
   "start": 49.19,
   "end": 49.65,
   "text": "טומנת בחובה."
  },
  {
   "start": 51.79,
   "end": 52.45,
   "text": "בחברה שלו,"
  },
  {
   "start": 53.15,
   "end": 54.19,
   "text": "בתור מנכ״ל דינמי,"
  },
  {
   "start": 54.77,
   "end": 57.15,
   "text": "הוא הטביע את הסיסמה"
  },
  {
   "start": 58.23,
   "end": 60.39,
   "text": "כדי לעבור את הנהר בשלום,"
  },
  {
   "start": 61.27,
   "end": 61.93,
   "text": "צריך לדעת"
  },
  {
   "start": 63.03,
   "end": 64.99,
   "text": "היכן נמצאים בדיוק המכשולים,"
  },
  {
   "start": 68.05,
   "end": 68.99,
   "text": "וכך כל עובד"
  },
  {
   "start": 68.99,
   "end": 76.41,
   "text": "או עובדת שהתקבלו לחברה שלו יצטרכו לקרוא את המשפט,"
  },
  {
   "start": 77.47,
   "end": 78.87,
   "text": "את המשפט הזה שהיה תלוי בחדרו,"
  },
  {
   "start": 79.61,
   "end": 83.35,
   "text": "ולהבין שהנרי מצפה מהם לשלמות."
  },
  {
   "start": 86.85,
   "end": 87.43,
   "text": "והעובדים,"
  },
  {
   "start": 88.15,
   "end": 92.87,
   "text": "העובדים שכל כך הרבה השקיעו על מנת לספק את רצון בעל החברה,"
  },
  {
   "start": 93.63,
   "end": 97.13,
   "text": "שדרש לא פחות ולא יותר מאשר את המקסימום מעובדיו,"
  },
  {
   "start": 99.74,
   "end": 101.94,
   "text": "כשהגיע אותו יום,"
  },
  {
   "start": 104.14,
   "end": 105.08,
   "text": "חששו לבשר לו."
  },
  {
   "start": 107.0,
   "end": 113.02,
   "text": "חששו לבשר לו על הירידה התלולה ברווחים שהחלה מתחילת השנה,"
  },
  {
   "start": 115.12,
   "end": 119.99,
   "text": "ולקראת סוף השנה החלה והתממשלה."
  },
  {
   "start": 122.58,
   "end": 124.46,
   "text": "גם כשהרווחים הפכו להפסדים,"
  },
  {
   "start": 125.98,
   "end": 130.76,
   "text": "איש לא עזר אומץ לגשת להנרי ולידע אותו."
  },
  {
   "start": 134.09,
   "end": 135.47,
   "text": "וכך מגיע לו סוף השנה,"
  },
  {
   "start": 136.35,
   "end": 137.47,
   "text": "מועד הסיכום השנתי,"
  },
  {
   "start": 139.76,
   "end": 142.64,
   "text": "ליבו של הנרי בישר לו רעות."
  },
  {
   "start": 144.06,
   "end": 148.5,
   "text": "כבר זמן מה הוא חש ירידה הולכת וגוברת ברווחיות החברה,"
  },
  {
   "start": 150.74,
   "end": 153.54,
   "text": "ושיחת טלפון לא כל כך שגרתית"
  },
  {
   "start": 154.32,
   "end": 155.82,
   "text": "מרואה החשבון של החברה,"
  },
  {
   "start": 156.58,
   "end": 158.26,
   "text": "שביקש פגישה בדחיפות,"
  },
  {
   "start": 160.66,
   "end": 161.52,
   "text": "לא בישרה טובות."
  },
  {
   "start": 169.68,
   "end": 170.16,
   "text": "החברה,"
  },
  {
   "start": 171.06,
   "end": 171.9,
   "text": "החברה שלך."
  },
  {
   "start": 173.26,
   "end": 174.04,
   "text": "מיסטר הנרי,"
  },
  {
   "start": 174.82,
   "end": 176.1,
   "text": "על סף פשיטת רגל."
  },
  {
   "start": 179.52,
   "end": 182.88,
   "text": "המילים חדרו למוחו של הנרי מבעד לערפל."
  },
  {
   "start": 185.18,
   "end": 187.04,
   "text": "עיניו נעצמו בעייפות הולכת וגוברת,"
  },
  {
   "start": 188.02,
   "end": 189.42,
   "text": "והוא פשוט צנח ארצה."
  },
  {
   "start": 198.52,
   "end": 201.6,
   "text": "הנרי חשש יותר מהכל, מהשכנים שלו,"
  },
  {
   "start": 202.18,
   "end": 203.16,
   "text": "מהמכרים שלו,"
  },
  {
   "start": 203.6,
   "end": 206.56,
   "text": "שיודעים כולם שהוא הנרי סמל ההצלחה."
  },
  {
   "start": 208.42,
   "end": 210.3,
   "text": "הוא הנרי זה שכולם קינאו בו."
  },
  {
   "start": 213.12,
   "end": 216.44,
   "text": "זה שכל אימא הייתה אומרת לבן שלה תלמד ותהיה כמו הנרי."
  },
  {
   "start": 217.42,
   "end": 220.92,
   "text": "אותו הנרי נהפך לפושט רגל עני,"
  },
  {
   "start": 221.9,
   "end": 225.78,
   "text": "סיפור של כישלון בחוץ."
  },
  {
   "start": 227.96,
   "end": 229.88,
   "text": "הוא עוד הצליח להסתיר את מצבו הנורא,"
  },
  {
   "start": 231.22,
   "end": 231.84,
   "text": "אבל בבית,"
  },
  {
   "start": 232.94,
   "end": 235.4,
   "text": "בבית החלו להתרגל לרמת חיים אחרת,"
  },
  {
   "start": 236.94,
   "end": 241.06,
   "text": "לעוני המבצבץ ובא לו בצעדי הענק."
  },
  {
   "start": 245.71,
   "end": 249.65,
   "text": "והנה הגיע אותו ערב שהנרי לא ישכח כל ימיו,"
  },
  {
   "start": 250.61,
   "end": 253.45,
   "text": "בבית נגמר האוכל."
  },
  {
   "start": 254.67,
   "end": 256.17,
   "text": "הילדים רוצים אוכל, אבא."
  },
  {
   "start": 256.77,
   "end": 257.83,
   "text": "אבא, אנחנו רעבים."
  },
  {
   "start": 259.25,
   "end": 260.33,
   "text": "ואין לו מה לתת להם."
  },
  {
   "start": 266.97,
   "end": 274.53,
   "text": "הילדים עלו למיטות. פעם הראשונה בחייהם עלו הילדים למיטות רעבים ללחם."
  },
  {
   "start": 280.64,
   "end": 281.84,
   "text": "שעת לילה מאוחרת,"
  },
  {
   "start": 282.92,
   "end": 286.44,
   "text": "הנרי נשכב בספה, דמעות בזוויות עיניו."
  },
  {
   "start": 287.82,
   "end": 288.94,
   "text": "חוסר אוני מוחלט."
  },
  {
   "start": 290.6,
   "end": 292.24,
   "text": "וסוף סוף הוא מאפשר לעיניים שלו"
  },
  {
   "start": 292.78,
   "end": 293.88,
   "text": "העייפות כל כך,"
  },
  {
   "start": 294.84,
   "end": 299.98,
   "text": "להיעצם וכל-כולו לברוח אט-אט"
  },
  {
   "start": 301.2,
   "end": 313.76,
   "text": "אל זרועות השינה באותו זמן בשמיים."
  },
  {
   "start": 315.44,
   "end": 318.82,
   "text": "באותו זמן בשמיים נפגשים להם שני מלאכים."
  },
  {
   "start": 320.08,
   "end": 322.28,
   "text": "מלאך אחד הוא המלאך הממונה על החלומות,"
  },
  {
   "start": 323.38,
   "end": 328.3,
   "text": "ומלאך שני מלאך הממונה על ההצלחות."
  },
  {
   "start": 330.0,
   "end": 332.08,
   "text": "והמלאך הממונה על ההצלחות מתפאר."
  },
  {
   "start": 332.88,
   "end": 334.66,
   "text": "אתה יודע כמה לבבות שימחתי?"
  },
  {
   "start": 335.6,
   "end": 338.38,
   "text": "אתה יודע כמה עניים האשרתי ביום אחד?"
  },
  {
   "start": 343.2,
   "end": 347.44,
   "text": "אתה יודע איזה חיים אנשים עושים בגלל ההצלחות שאני דואג להם?"
  },
  {
   "start": 350.23,
   "end": 351.87,
   "text": "ומלאך החלומות נשאר ככה,"
  },
  {
   "start": 354.17,
   "end": 354.75,
   "text": "אין לו מה לומר."
  },
  {
   "start": 355.77,
   "end": 358.77,
   "text": "לבסוף הם סיכמו שהם ייפגשו שוב מחר,"
  },
  {
   "start": 359.87,
   "end": 363.12,
   "text": "והם יספרו שוב,"
  },
  {
   "start": 365.18,
   "end": 365.88,
   "text": "שוב חוויות,"
  },
  {
   "start": 368.54,
   "end": 369.72,
   "text": "מה קורה שם למטה."
  },
  {
   "start": 392.65,
   "end": 393.43,
   "text": "מלאך החלומות"
  },
  {
   "start": 394.19,
   "end": 399.83,
   "text": "הביט אל כדור הארץ וחיפש, חיפש לבצע איזה חלום מיוחד,"
  },
  {
   "start": 400.59,
   "end": 402.01,
   "text": "שעוד לא היה כמותו."
  },
  {
   "start": 404.09,
   "end": 409.41,
   "text": "ואז מבטו נח על הנרי,"
  },
  {
   "start": 410.25,
   "end": 410.79,
   "text": "זהו,"
  },
  {
   "start": 411.71,
   "end": 413.01,
   "text": "זה כל מה שאני צריך,"
  },
  {
   "start": 414.77,
   "end": 416.13,
   "text": "זהו כל מה שאני צריך,"
  },
  {
   "start": 416.95,
   "end": 418.97,
   "text": "מלמל מלאך החלומות,"
  },
  {
   "start": 419.77,
   "end": 420.81,
   "text": "ויצא לדרך."
  },
  {
   "start": 431.41,
   "end": 432.13,
   "text": "הנרי חולם,"
  },
  {
   "start": 434.38,
   "end": 435.18,
   "text": "והנה הוא יוצא,"
  },
  {
   "start": 436.56,
   "end": 438.76,
   "text": "יוצא ליום חדש מלא אפשרויות של הצלחה."
  },
  {
   "start": 440.5,
   "end": 441.4,
   "text": "איזה חבר עשיר,"
  },
  {
   "start": 442.02,
   "end": 443.26,
   "text": "שהרבה זמן לא נפגשו,"
  },
  {
   "start": 446.89,
   "end": 447.59,
   "text": "הציע לו הנרי,"
  },
  {
   "start": 448.65,
   "end": 449.33,
   "text": "הנרי בוא איתי,"
  },
  {
   "start": 451.92,
   "end": 453.42,
   "text": "בוא נפתח שותפות עסקית ביחד."
  },
  {
   "start": 454.96,
   "end": 455.6,
   "text": "והם פותחים,"
  },
  {
   "start": 456.4,
   "end": 459.8,
   "text": "ואז גלגל ההצלחה מתחיל להסתובב."
  },
  {
   "start": 461.2,
   "end": 467.34,
   "text": "והנרי עושה קאמבק לעסקים ומצליח בצורה בלתי רגילה."
  },
  {
   "start": 467.74,
   "end": 469.68,
   "text": "הוא מתעשר, סוף סוף הוא חוזר"
  },
  {
   "start": 471.18,
   "end": 474.2,
   "text": "למה שהיה קודם, סוף סוף החיוך חוזר ללחיים."
  },
  {
   "start": 475.78,
   "end": 476.18,
   "text": "יום אחד,"
  },
  {
   "start": 477.08,
   "end": 479.7,
   "text": "מחליט הנרי לעשות סעודת הודיה"
  },
  {
   "start": 480.8,
   "end": 482.3,
   "text": "על שהצליח להעפיל שוב"
  },
  {
   "start": 482.96,
   "end": 484.54,
   "text": "אל פסגת ההצלחה."
  },
  {
   "start": 485.84,
   "end": 487.6,
   "text": "והוא מזמין את כל המכרים שלו."
  },
  {
   "start": 489.46,
   "end": 491.92,
   "text": "את כל המכרים שלו, וכולם שמחים."
  },
  {
   "start": 492.76,
   "end": 500.66,
   "text": "ולאט-לאט הוא מתחיל לשכוח מאותם זמנים רחוקים של עצבות,"
  },
  {
   "start": 501.36,
   "end": 502.04,
   "text": "של צער,"
  },
  {
   "start": 504.46,
   "end": 504.9,
   "text": "של עוני."
  },
  {
   "start": 516.65,
   "end": 517.85,
   "text": "המסיבה הייתה בעיצומה"
  },
  {
   "start": 519.13,
   "end": 519.71,
   "text": "כשהנרי"
  },
  {
   "start": 520.85,
   "end": 521.83,
   "text": "סימן לתזמורת"
  },
  {
   "start": 522.55,
   "end": 523.61,
   "text": "להפסיק לנגן."
  },
  {
   "start": 525.05,
   "end": 525.91,
   "text": "והוא עלה אל הבמה,"
  },
  {
   "start": 527.11,
   "end": 527.67,
   "text": "רוצה לשאת"
  },
  {
   "start": 528.83,
   "end": 530.19,
   "text": "נאום חוצב להבות"
  },
  {
   "start": 531.85,
   "end": 535.11,
   "text": "על דרכו של האדם וכוחו בעולם הזה."
  },
  {
   "start": 539.82,
   "end": 542.0,
   "text": "אש הוא גרם להנרי להביט אל החלון הגדול שממולו,"
  },
  {
   "start": 544.18,
   "end": 545.32,
   "text": "עוד לפני שהוא מתחיל לדבר,"
  },
  {
   "start": 546.44,
   "end": 547.36,
   "text": "ואז פניו החבירו."
  },
  {
   "start": 548.76,
   "end": 549.04,
   "text": "שם,"
  },
  {
   "start": 552.17,
   "end": 552.95,
   "text": "שם מבעד."
  },
  {
   "start": 554.27,
   "end": 554.83,
   "text": "שם מבעד,"
  },
  {
   "start": 555.69,
   "end": 556.59,
   "text": "מבעד לחלון."
  },
  {
   "start": 557.35,
   "end": 569.73,
   "text": "עמד לו הפושע הגדול והמפורסם ביותר בארצות הברית עם רובה צלפים"
  },
  {
   "start": 570.73,
   "end": 571.31,
   "text": "והרובה"
  },
  {
   "start": 572.53,
   "end": 573.53,
   "text": "מכוון להנרי."
  },
  {
   "start": 604.63,
   "end": 606.03,
   "text": "נשימתו של הנרי נעצרה."
  },
  {
   "start": 607.45,
   "end": 608.17,
   "text": "הוא רצה לומר,"
  },
  {
   "start": 609.23,
   "end": 610.55,
   "text": "לסמן,"
  },
  {
   "start": 611.37,
   "end": 617.27,
   "text": "אבל הוא לא יכל להוציא הגה וכך הוא עמד לו תקוע מספר שניות"
  },
  {
   "start": 619.7,
   "end": 623.86,
   "text": "ואז הוא הצליח לשחרר זעקה מגרונו והוא החל לצעוק הצילו,"
  },
  {
   "start": 624.32,
   "end": 626.38,
   "text": "הצילו, הצילו, ולצעוק,"
  },
  {
   "start": 626.98,
   "end": 627.78,
   "text": "ולצעוק,"
  },
  {
   "start": 629.46,
   "end": 630.12,
   "text": "ולצעוק."
  },
  {
   "start": 637.06,
   "end": 643.05,
   "text": "נשברה מעוצמת החבטה ושוברת להנרי את החלום."
  },
  {
   "start": 647.15,
   "end": 648.81,
   "text": "חלומו נופץ באחת."
  },
  {
   "start": 660.89,
   "end": 664.29,
   "text": "הנרי עמד המום בסלון ביתו,"
  },
  {
   "start": 665.21,
   "end": 667.85,
   "text": "מתעורר לאט-לאט מהשינה ומהחלום,"
  },
  {
   "start": 668.65,
   "end": 672.25,
   "text": "מתעורר אל מציאות עגומה של פושט רגל עני."
  },
  {
   "start": 673.63,
   "end": 673.91,
   "text": "מולו"
  },
  {
   "start": 674.59,
   "end": 675.41,
   "text": "עמדו שכנים"
  },
  {
   "start": 676.37,
   "end": 677.47,
   "text": "ומכרים המומים"
  },
  {
   "start": 678.79,
   "end": 682.41,
   "text": "שהגיעו ופרצו אל ביתו בעקבות הזעקות שלו."
  },
  {
   "start": 684.21,
   "end": 685.09,
   "text": "הן ראייה קפוא"
  },
  {
   "start": 686.93,
   "end": 687.63,
   "text": "על עומדו,"
  },
  {
   "start": 688.57,
   "end": 689.37,
   "text": "רק שילכו,"
  },
  {
   "start": 690.05,
   "end": 691.75,
   "text": "שלא יגלו את המצב שלי האמיתי."
  },
  {
   "start": 694.27,
   "end": 695.13,
   "text": "רגע של דממה,"
  },
  {
   "start": 696.31,
   "end": 697.07,
   "text": "רגע של מבוכה."
  },
  {
   "start": 700.46,
   "end": 700.82,
   "text": "ואז,"
  },
  {
   "start": 701.52,
   "end": 703.08,
   "text": "ואז מבעד לגרם המדרגות,"
  },
  {
   "start": 703.72,
   "end": 706.46,
   "text": "מבעד לגרם המדרגות הופיעו הילדים,"
  },
  {
   "start": 706.98,
   "end": 707.26,
   "text": "אבא,"
  },
  {
   "start": 707.86,
   "end": 709.0,
   "text": "אבא, אנחנו רעבים,"
  },
  {
   "start": 709.72,
   "end": 711.88,
   "text": "אבל למה אין לנו מה לאכול?"
  },
  {
   "start": 713.14,
   "end": 717.5,
   "text": "הילד הקטן ניגש אל המקרר בתקווה למצוא משהו, הוא פתח אותו."
  },
  {
   "start": 719.24,
   "end": 722.66,
   "text": "והמקרר הריק העיד על מה שקרה להנרי."
  },
  {
   "start": 724.9,
   "end": 727.8,
   "text": "השכנים והמכרים הביטו זה בזה,"
  },
  {
   "start": 728.58,
   "end": 729.9,
   "text": "הביטו בהנרי בחמלה,"
  },
  {
   "start": 730.68,
   "end": 733.24,
   "text": "ועזבו בשקט את הדירה."
  },
  {
   "start": 733.92,
   "end": 734.84,
   "text": "משאירים את הנרי,"
  },
  {
   "start": 735.7,
   "end": 738.88,
   "text": "משאירים את הנרי רועד בכל גופו ומתייפח."
  },
  {
   "start": 752.1,
   "end": 752.7,
   "text": "בבוקר,"
  },
  {
   "start": 753.52,
   "end": 759.78,
   "text": "בבוקר כבר כולם ידעו שהנרי איבד את כל הרכוש שלו,"
  },
  {
   "start": 761.1,
   "end": 761.9,
   "text": "וכפי הנראה,"
  },
  {
   "start": 762.92,
   "end": 765.48,
   "text": "מול כל הצער ועוגמת הנפש והבושה,"
  },
  {
   "start": 766.36,
   "end": 769.48,
   "text": "איבד גם את שפיות דעתו."
  },
  {
   "start": 790.21,
   "end": 792.35,
   "text": "בלילה למחרת, שם בשמיים,"
  },
  {
   "start": 793.09,
   "end": 795.53,
   "text": "נפגשים להם מלאך החלומות עם מלאך ההצלחות."
  },
  {
   "start": 796.35,
   "end": 797.75,
   "text": "מלאך החלומות צוחק,"
  },
  {
   "start": 798.09,
   "end": 800.95,
   "text": "מספר על הנרי ומתגלגל מצחוק."
  },
  {
   "start": 801.41,
   "end": 802.37,
   "text": "היית צריך לראות אותו,"
  },
  {
   "start": 802.71,
   "end": 803.45,
   "text": "איך הוא זועק."
  },
  {
   "start": 805.13,
   "end": 808.65,
   "text": "היית צריך לראות אותו עומד שמה וכולם נכנסים ומגלים אותו ככה,"
  },
  {
   "start": 809.45,
   "end": 810.41,
   "text": "בשיא הבושה."
  },
  {
   "start": 811.49,
   "end": 812.93,
   "text": "את כל מה שהוא רצה להסתיר"
  },
  {
   "start": 814.25,
   "end": 815.25,
   "text": "גילו אותו ככה,"
  },
  {
   "start": 817.07,
   "end": 818.17,
   "text": "בשיא עלבונו."
  },
  {
   "start": 819.95,
   "end": 821.33,
   "text": "מלאך ההצלחות שמע את זה,"
  },
  {
   "start": 822.83,
   "end": 823.69,
   "text": "כולו זעם."
  },
  {
   "start": 824.13,
   "end": 825.19,
   "text": "תגיד לי, אתה מלאך?"
  },
  {
   "start": 825.71,
   "end": 826.83,
   "text": "אמר למלאך החלומות."
  },
  {
   "start": 827.21,
   "end": 827.85,
   "text": "אתה לא מתבייש?"
  },
  {
   "start": 829.31,
   "end": 830.31,
   "text": "אין לך רגשות?"
  },
  {
   "start": 831.29,
   "end": 834.21,
   "text": "איך התעללת באדם כל כך מסכן?"
  },
  {
   "start": 834.79,
   "end": 836.01,
   "text": "איך השלית אותו?"
  },
  {
   "start": 836.69,
   "end": 840.81,
   "text": "ולבסוף העמדת אותו מול השכנים ומול המציאות העגומה."
  },
  {
   "start": 841.21,
   "end": 842.55,
   "text": "תגיד לי, אין לך לב?"
  },
  {
   "start": 843.21,
   "end": 844.27,
   "text": "תתבייש לך."
  },
  {
   "start": 844.81,
   "end": 845.91,
   "text": "תתבייש לך."
  },
  {
   "start": 848.5,
   "end": 851.16,
   "text": "אבל אז קם מלאך החלומות,"
  },
  {
   "start": 852.08,
   "end": 856.3,
   "text": "ובקול שקט וקר ענה,"
  },
  {
   "start": 857.08,
   "end": 858.14,
   "text": "תגיד לי מלאך ההצלחות,"
  },
  {
   "start": 859.12,
   "end": 860.1,
   "text": "שאני לא אתבייש?"
  },
  {
   "start": 860.94,
   "end": 861.48,
   "text": "מה אני עשיתי?"
  },
  {
   "start": 862.38,
   "end": 864.22,
   "text": "אני השליתי יהודי אחד,"
  },
  {
   "start": 865.2,
   "end": 867.1,
   "text": "לילה אחד, חלום אחד."
  },
  {
   "start": 868.2,
   "end": 868.76,
   "text": "ואתה?"
  },
  {
   "start": 869.44,
   "end": 873.9,
   "text": "70 שנה אתה משלה את כל האנשים שהם מצליחים."
  },
  {
   "start": 874.32,
   "end": 884.66,
   "text": "יש כאלה שאתה משלה אותם 30 שנה, 40 שנה, 60 שנה, 70 שנה. הם בטוחים שהם צודקים, הם בטוחים שהם מבינים, הם בטוחים שהם חיים נכון."
  },
  {
   "start": 885.88,
   "end": 887.52,
   "text": "ככה אתה משלה אותם כל החיים,"
  },
  {
   "start": 888.2,
   "end": 889.12,
   "text": "ואז אחר כך"
  },
  {
   "start": 890.42,
   "end": 891.86,
   "text": "לפתע נגמר הכל."
  },
  {
   "start": 892.44,
   "end": 894.0,
   "text": "וצריכים לעלות למעלה,"
  },
  {
   "start": 894.76,
   "end": 896.0,
   "text": "ללא חברים,"
  },
  {
   "start": 896.82,
   "end": 897.78,
   "text": "ללא כסף,"
  },
  {
   "start": 898.54,
   "end": 900.22,
   "text": "ללא משפחה, לבד."
  },
  {
   "start": 901.1,
   "end": 903.06,
   "text": "עולים לעולם נצחי,"
  },
  {
   "start": 903.92,
   "end": 906.02,
   "text": "ושם האמת מתבררת."
  },
  {
   "start": 906.92,
   "end": 909.44,
   "text": "האמת מתבררת שהכל זמני היה,"
  },
  {
   "start": 909.98,
   "end": 911.14,
   "text": "שהכל דמיון היה,"
  },
  {
   "start": 911.62,
   "end": 913.78,
   "text": "שהמציאות האמיתית היא הנצחית,"
  },
  {
   "start": 914.22,
   "end": 918.22,
   "text": "זה מי שיש בידו תורה ומצוות, יחיה טוב ולנצח,"
  },
  {
   "start": 918.8,
   "end": 921.58,
   "text": "ומי שלא ימצא את עצמו כמו הנרי,"
  },
  {
   "start": 922.04,
   "end": 922.8,
   "text": "ולנצח."
  },
  {
   "start": 923.88,
   "end": 925.0,
   "text": "אתה עושה את זה לכולם,"
  },
  {
   "start": 925.8,
   "end": 927.6,
   "text": "ואתה מוכיח אותי."
  },
  {
   "start": 928.22,
   "end": 930.74,
   "text": "אתה כל החיים מוליך שולל את כל האנושות."
  },
  {
   "start": 933.52,
   "end": 935.02,
   "text": "שנים הם חיים בחלומות."
  },
  {
   "start": 936.04,
   "end": 937.72,
   "text": "וכשמתנפץ החלום,"
  },
  {
   "start": 938.22,
   "end": 939.82,
   "text": "כשמתנפץ החלום,"
  },
  {
   "start": 940.26,
   "end": 941.94,
   "text": "נשאר להם רק לבכות."
  },
  {
   "start": 947.66,
   "end": 953.85,
   "text": "את המשל הזה סיפר הרב קובלסקי שליטה."
  },
  {
   "start": 957.44,
   "end": 958.32,
   "text": "כמה אנחנו,"
  },
  {
   "start": 959.24,
   "end": 962.94,
   "text": "כל יהודי ויהודייה, צריכים לקחת את הדברים אלינו."
  },
  {
   "start": 962.94,
   "end": 965.66,
   "text": "כמה פעמים בא,"
  },
  {
   "start": 968.52,
   "end": 969.72,
   "text": "באותה מחשבה,"
  },
  {
   "start": 971.04,
   "end": 972.82,
   "text": "באותו ג'וק של הצלחה,"
  },
  {
   "start": 973.4,
   "end": 974.32,
   "text": "ג'וק של דמיונות,"
  },
  {
   "start": 979.28,
   "end": 979.54,
   "text": "בא,"
  },
  {
   "start": 980.12,
   "end": 980.68,
   "text": "אותו,"
  },
  {
   "start": 981.48,
   "end": 983.0,
   "text": "אותה השקפת עולם מעוותת,"
  },
  {
   "start": 984.48,
   "end": 987.54,
   "text": "אותו יצר רבן דואג לנו שנחיה את העולם הזה,"
  },
  {
   "start": 988.0,
   "end": 991.04,
   "text": "שלא נרגיש שאנחנו מבזבזים וכולם בטוחים שהם צודקים,"
  },
  {
   "start": 991.96,
   "end": 993.6,
   "text": "שהם חיים נכון, שהם מבינים,"
  },
  {
   "start": 994.14,
   "end": 999.36,
   "text": "עד לרגע שכל יהודי ויהודייה ניצבים לפני מי שאמר והיה העולם."
  },
  {
   "start": 1000.14,
   "end": 1002.54,
   "text": "לפני מי שאמר והיה העולם."
  },
  {
   "start": 1004.52,
   "end": 1004.98,
   "text": "ואז,"
  },
  {
   "start": 1006.12,
   "end": 1011.4,
   "text": "ואז אתה עומד חשוף כולך ומגלה שכל החיים טעית,"
  },
  {
   "start": 1012.48,
   "end": 1015.0,
   "text": "שאת כל החיים שנתנו לך בזבזת,"
  },
  {
   "start": 1016.1,
   "end": 1016.9,
   "text": "כמה זה כואב."
  },
  {
   "start": 1019.26,
   "end": 1022.06,
   "text": "אז בואו בעזרת השם, בואו כל אחד יכניס את הדברים פנימה."
  },
  {
   "start": 1022.64,
   "end": 1025.94,
   "text": "בוא נדע שאנחנו חיים פה בעולם זמני, זו האמת."
  },
  {
   "start": 1026.76,
   "end": 1029.02,
   "text": "כל מה שמסביב עלול עוד מעט להיגמר."
  },
  {
   "start": 1029.54,
   "end": 1031.14,
   "text": "לאדם אחד זה נגמר תוך שנה,"
  },
  {
   "start": 1031.62,
   "end": 1033.58,
   "text": "לשני נגמר תוך שבעים שנה, אבל זה נגמר."
  },
  {
   "start": 1034.3,
   "end": 1036.28,
   "text": "ועולים אל אבא, אל אבא שאוהב."
  },
  {
   "start": 1037.12,
   "end": 1039.44,
   "text": "זו הנקודה הנפלאה שלנו, הזכות שלנו."
  },
  {
   "start": 1040.94,
   "end": 1041.9,
   "text": "והאבא הזה רוצה אותנו."
  },
  {
   "start": 1043.16,
   "end": 1045.18,
   "text": "רוצה לזכות אותנו בחיי העולם הבא."
  },
  {
   "start": 1046.5,
   "end": 1051.5,
   "text": "רוצה שנקנה טאבו חלקה בעולם הבא, בזכות ולא בחסד."
  },
  {
   "start": 1051.84,
   "end": 1053.42,
   "text": "נתנו אפשרות פה לעשות מצוות,"
  },
  {
   "start": 1054.0,
   "end": 1057.0,
   "text": "פה ללמוד תורה, פה לקנות, לבוא עם שטר."
  },
  {
   "start": 1057.44,
   "end": 1063.3,
   "text": "הנה אני קניתי פיסת גן עדן, את זה אי אפשר לקחת ממני. את זה אי אפשר, את זה אני קניתי במו ידיי."
  },
  {
   "start": 1065.4,
   "end": 1066.04,
   "text": "ולא לבוא עם"
  },
  {
   "start": 1067.28,
   "end": 1068.7,
   "text": "מטבע שכבר לא שכיר,"
  },
  {
   "start": 1070.12,
   "end": 1072.66,
   "text": "עם דולר שכבר לא שכיר עכשיו."
  },
  {
   "start": 1074.86,
   "end": 1075.48,
   "text": "לבוא עם תורה,"
  },
  {
   "start": 1076.1,
   "end": 1076.72,
   "text": "לבוא עם מצוות,"
  },
  {
   "start": 1077.48,
   "end": 1078.9,
   "text": "לבוא עם תכלית."
  }
 ]
}