{
 "disc": "13יג- תכלית",
 "track": "Track08",
 "duration": 519.216,
 "segments": [
  {
   "start": 5.06,
   "end": 6.42,
   "text": "חיל האוויר האמריקני,"
  },
  {
   "start": 9.78,
   "end": 11.78,
   "text": "בבסיס באחד נהי האוקיינוס השקט."
  },
  {
   "start": 15.42,
   "end": 20.46,
   "text": "לפתע פוקדות תאונות ניסטוריות את מטוסי חיל האוויר האמריקני."
  },
  {
   "start": 24.94,
   "end": 25.82,
   "text": "נעשתה חקירה,"
  },
  {
   "start": 26.88,
   "end": 32.22,
   "text": "והתברר שמנועי הסילון ששואבים אוויר,"
  },
  {
   "start": 33.04,
   "end": 35.66,
   "text": "אותם מנועי סילון של המטוסים ששואבים אוויר,"
  },
  {
   "start": 36.3,
   "end": 36.98,
   "text": "שואבים גם"
  },
  {
   "start": 37.62,
   "end": 38.58,
   "text": "אלבטרוסים."
  },
  {
   "start": 39.54,
   "end": 40.78,
   "text": "אלבטרוסים זה ציפורים."
  },
  {
   "start": 41.7,
   "end": 43.6,
   "text": "ציפורים די גדולות,"
  },
  {
   "start": 46.44,
   "end": 49.08,
   "text": "הם היו נשאבים לתוך המנועים ומקלקלים"
  },
  {
   "start": 50.02,
   "end": 52.68,
   "text": "גומל לתאונות למטוסי חלקל האוויר האמריקני."
  },
  {
   "start": 54.08,
   "end": 54.54,
   "text": "אז מה יעשו?"
  },
  {
   "start": 55.28,
   "end": 57.38,
   "text": "יעבירו את הבסיס כולו למקום אחר?"
  },
  {
   "start": 58.06,
   "end": 59.16,
   "text": "האמריקנים החליטו לא ולא."
  },
  {
   "start": 60.04,
   "end": 62.98,
   "text": "אנחנו נעביר את האלבטרוסים, את אותם ציפורים, נרחיק אותם."
  },
  {
   "start": 64.12,
   "end": 70.0,
   "text": "והם העלו אותם על מטוס, תפסו צדו את הציפורים האלה,"
  },
  {
   "start": 70.7,
   "end": 71.58,
   "text": "העלו אותם על מטוס,"
  },
  {
   "start": 72.54,
   "end": 77.24,
   "text": "וטסו איתם למרחק של 4,500 קילומטר."
  },
  {
   "start": 78.54,
   "end": 80.66,
   "text": "4,500 קילומטר."
  },
  {
   "start": 81.86,
   "end": 83.68,
   "text": "ושם הם שחררו אותם."
  },
  {
   "start": 88.5,
   "end": 90.02,
   "text": "שבועיים אחר כך"
  },
  {
   "start": 91.38,
   "end": 94.36,
   "text": "האלבטרוסים חזרו הביתה במדויק."
  },
  {
   "start": 96.02,
   "end": 96.98,
   "text": "ללא מצפן,"
  },
  {
   "start": 97.64,
   "end": 98.56,
   "text": "ללא ג'ירוסקופ,"
  },
  {
   "start": 101.99,
   "end": 103.17,
   "text": "ללא שום ניווט,"
  },
  {
   "start": 104.25,
   "end": 105.39,
   "text": "ללא שום מכם,"
  },
  {
   "start": 106.27,
   "end": 108.25,
   "text": "לא שוללו שום הוראות מגדל הפיקוח,"
  },
  {
   "start": 109.33,
   "end": 110.71,
   "text": "חזרו הביתה במדויק."
  },
  {
   "start": 113.92,
   "end": 114.46,
   "text": "תגידו לי,"
  },
  {
   "start": 115.36,
   "end": 120.14,
   "text": "עם אלבטרוסים, עם ציפורים, שאין להם סכל ואין להם נשמה,"
  },
  {
   "start": 121.34,
   "end": 124.36,
   "text": "חוזרים במדויק הביתה, אפילו שהרחיקו אותנו."
  },
  {
   "start": 125.94,
   "end": 126.94,
   "text": "אז יהודי יהודייה,"
  },
  {
   "start": 127.94,
   "end": 131.22,
   "text": "אפילו שהרחיקו אותנו שנים מאבא שבשמיים,"
  },
  {
   "start": 131.82,
   "end": 134.6,
   "text": "מהעם שלנו, משלשלת הזהב שלנו,"
  },
  {
   "start": 136.32,
   "end": 137.72,
   "text": "כמה מצפים מאיתנו"
  },
  {
   "start": 138.6,
   "end": 141.28,
   "text": "שנחזור הביתה, את כל הדרך הביתה,"
  },
  {
   "start": 142.32,
   "end": 143.84,
   "text": "אל אבא, אבא שבשמיים,"
  },
  {
   "start": 144.78,
   "end": 145.6,
   "text": "אל אבא שאוהב,"
  },
  {
   "start": 146.68,
   "end": 149.2,
   "text": "אל נשמות של קדושים וקדושות"
  },
  {
   "start": 150.36,
   "end": 151.54,
   "text": "שמתפללים עלינו,"
  },
  {
   "start": 153.26,
   "end": 153.96,
   "text": "שנמשיך,"
  },
  {
   "start": 154.66,
   "end": 155.92,
   "text": "נמשיך את מה שהם התחילו."
  },
  {
   "start": 158.96,
   "end": 161.92,
   "text": "אתם יודעים, בחופי ברזיל יש צו ים,"
  },
  {
   "start": 162.94,
   "end": 163.38,
   "text": "צווי ים."
  },
  {
   "start": 167.56,
   "end": 168.42,
   "text": "מדי שנתיים"
  },
  {
   "start": 170.12,
   "end": 172.1,
   "text": "צווי הים יוצאים למסע."
  },
  {
   "start": 173.54,
   "end": 179.12,
   "text": "מסע ארוך, מרחק של 2,250 קילומטר"
  },
  {
   "start": 180.52,
   "end": 181.72,
   "text": "לעיי הסינסנסיון,"
  },
  {
   "start": 182.84,
   "end": 185.74,
   "text": "זהים קטנים מאוד שבמפה אתה לא מצליח לראות אותם."
  },
  {
   "start": 187.44,
   "end": 189.36,
   "text": "והצווים מגיעים לשם במדויק,"
  },
  {
   "start": 190.06,
   "end": 191.06,
   "text": "מטילים שם ביצים,"
  },
  {
   "start": 192.68,
   "end": 199.28,
   "text": "מסתובבים וחוזרים את כל הדרך 2,250 קילומטר הביתה,"
  },
  {
   "start": 206.12,
   "end": 208.98,
   "text": "סולחים את הים בדרך הביתה."
  },
  {
   "start": 211.73,
   "end": 213.39,
   "text": "כמה זה מחייב אותנו,"
  },
  {
   "start": 214.23,
   "end": 214.91,
   "text": "בני אדם,"
  },
  {
   "start": 216.73,
   "end": 217.59,
   "text": "עם שכל,"
  },
  {
   "start": 219.09,
   "end": 219.85,
   "text": "עם רצון,"
  },
  {
   "start": 220.91,
   "end": 223.07,
   "text": "לחזור הביתה."
  },
  {
   "start": 224.43,
   "end": 230.84,
   "text": "לחזור הביתה אל השלשלת הנפלאה שלנו,"
  },
  {
   "start": 231.62,
   "end": 232.84,
   "text": "אל העם הנפלא שלנו."
  },
  {
   "start": 233.38,
   "end": 234.34,
   "text": "להרים את הראש,"
  },
  {
   "start": 236.87,
   "end": 239.29,
   "text": "להרים את הראש, להבין שאנחנו שייכים"
  },
  {
   "start": 241.27,
   "end": 242.13,
   "text": "לעם נפלא,"
  },
  {
   "start": 242.85,
   "end": 244.95,
   "text": "לאבא נפלא שמחכה לילדים שלו."
  },
  {
   "start": 246.93,
   "end": 250.81,
   "text": "בואו, בואו נראה בעזרת השם כמה דברים, לאן אנחנו חוזרים."
  },
  {
   "start": 251.75,
   "end": 256.29,
   "text": "לאן אנחנו חוזרים, לאיזה תפארת, לאיזה פאר, לאיזה עוצמה אנחנו חוזרים."
  },
  {
   "start": 256.83,
   "end": 257.39,
   "text": "אני אתן לכם רק,"
  },
  {
   "start": 257.91,
   "end": 258.39,
   "text": "אתם יודעים, פעם"
  },
  {
   "start": 259.51,
   "end": 261.57,
   "text": "מספרים ההיסטוריונים, פרידריך הגדול,"
  },
  {
   "start": 262.07,
   "end": 263.07,
   "text": "פרידריך ברברוסה,"
  },
  {
   "start": 263.73,
   "end": 265.09,
   "text": "נפגש עם הנסיך הצרפתי,"
  },
  {
   "start": 265.65,
   "end": 266.67,
   "text": "ג'ון בטיסט דה-בייה,"
  },
  {
   "start": 269.19,
   "end": 270.19,
   "text": "והתפתחה שיחה ביניהם."
  },
  {
   "start": 271.25,
   "end": 273.21,
   "text": "אמר פרידריך ברברוסה,"
  },
  {
   "start": 273.21,
   "end": 279.93,
   "text": "כבוד הנסיך, תביא לי הוכחה אחת ברורה לקיומו של האלוקים."
  },
  {
   "start": 281.79,
   "end": 284.87,
   "text": "חייך הנסיך הצרפתי ז'ון בטיס דה באייב אמר לו"
  },
  {
   "start": 285.73,
   "end": 286.23,
   "text": "אכן"
  },
  {
   "start": 287.89,
   "end": 290.93,
   "text": "יש לי להוד מלכותו הוכחה מדויקת"
  },
  {
   "start": 291.51,
   "end": 293.31,
   "text": "על מציאותו של האלוקים."
  },
  {
   "start": 294.25,
   "end": 297.49,
   "text": "יש לי הוכחה חסרת הפרחה, אתה לא יכול להפריך אותה."
  },
  {
   "start": 298.77,
   "end": 301.01,
   "text": "יש לי הוכחה בת מילה אחת,"
  },
  {
   "start": 303.77,
   "end": 304.65,
   "text": "היהודים."
  },
  {
   "start": 309.54,
   "end": 313.16,
   "text": "אנחנו ההוכחה לקיומו של השם יתברך."
  },
  {
   "start": 314.98,
   "end": 316.58,
   "text": "הייחודיות שלנו, תבינו,"
  },
  {
   "start": 317.56,
   "end": 319.7,
   "text": "העוצמה שלנו, אין את זה לאף אחד."
  },
  {
   "start": 320.1,
   "end": 320.76,
   "text": "אין, אין."
  },
  {
   "start": 321.32,
   "end": 323.56,
   "text": "לא היה, לא הווה ולא יהיה גם."
  },
  {
   "start": 327.16,
   "end": 328.98,
   "text": "החוקר הגרמני פרנץ דה ליטש"
  },
  {
   "start": 330.38,
   "end": 331.36,
   "text": "אמר ישראל"
  },
  {
   "start": 332.24,
   "end": 333.32,
   "text": "עם העמים."
  },
  {
   "start": 336.96,
   "end": 345.45,
   "text": "ראש ממשלת דרום אפריקה לשעבר צמץ אמר ישראל אומת האומות. זה גויים."
  },
  {
   "start": 346.43,
   "end": 349.47,
   "text": "גויים אומרים, ישראל אומת האומות, עם העמים."
  },
  {
   "start": 351.82,
   "end": 353.44,
   "text": "היהודים העניקו מתנות לאנושות כולה."
  },
  {
   "start": 356.64,
   "end": 358.02,
   "text": "המשורר הארדר,"
  },
  {
   "start": 359.04,
   "end": 360.18,
   "text": "יוהאן גודפריד הארדר,"
  },
  {
   "start": 361.34,
   "end": 362.96,
   "text": "בשנת 1780 אמר,"
  },
  {
   "start": 363.54,
   "end": 371.3,
   "text": "ישראל היה והווה העם המצוין ביותר עלי אדמות. שמעתם?"
  },
  {
   "start": 371.98,
   "end": 375.4,
   "text": "ישראל היה והווה העם"
  },
  {
   "start": 376.1,
   "end": 378.86,
   "text": "המצוין ביותר עלי אדמות"
  },
  {
   "start": 379.46,
   "end": 383.62,
   "text": "בראשיתו ובקיומו עד היום הזה."
  },
  {
   "start": 387.42,
   "end": 388.38,
   "text": "לב טולסטוי"
  },
  {
   "start": 389.88,
   "end": 392.0,
   "text": "כתב יהודי נושא מלנצח."
  },
  {
   "start": 392.82,
   "end": 394.18,
   "text": "הוא זה שלא יכלו להשמיד אותו."
  },
  {
   "start": 394.88,
   "end": 398.16,
   "text": "לא אש, לא חרב האינקוויזיציה, לא הצליחו להכחיד אותו."
  },
  {
   "start": 398.7,
   "end": 401.74,
   "text": "הוא אשר בישר ראשון את דבר השם."
  },
  {
   "start": 402.66,
   "end": 404.64,
   "text": "עם כזה לא יכול להיעלם."
  },
  {
   "start": 405.72,
   "end": 407.24,
   "text": "יהודי הוא התגשמות הנצח."
  },
  {
   "start": 409.0,
   "end": 410.5,
   "text": "שמענו, בי אנחנו."
  },
  {
   "start": 411.48,
   "end": 415.64,
   "text": "אנחנו לא יכולים לאלם, לא יעזור לאף אחד. ינסו להשמיד אותנו, יסכו לפגוע אותנו, לא יעזור כלום."
  },
  {
   "start": 416.22,
   "end": 417.24,
   "text": "לא, אנחנו ננצח."
  },
  {
   "start": 417.84,
   "end": 420.22,
   "text": "בואו נתחזק כולנו, אסור לנו לבייש את הפירמה."
  },
  {
   "start": 421.6,
   "end": 422.54,
   "text": "ז'אן פול סרטר,"
  },
  {
   "start": 423.48,
   "end": 425.44,
   "text": "הפילוסוף המשלווה, הסופר הצרפתי."
  },
  {
   "start": 426.54,
   "end": 429.78,
   "text": "העם היהודי הוא משהו מעבר לזמן."
  },
  {
   "start": 430.92,
   "end": 435.06,
   "text": "ההיסטוריון ארנולד טוינבי, תקשיבו טוב, סקר, כתב ספר."
  },
  {
   "start": 435.82,
   "end": 436.48,
   "text": "הוא עשה סקר."
  },
  {
   "start": 437.28,
   "end": 442.86,
   "text": "סקר 21 תרבויות שעלו לעולם,"
  },
  {
   "start": 444.08,
   "end": 447.26,
   "text": "שלטו בכל העולם ושקעו להם."
  },
  {
   "start": 448.52,
   "end": 450.24,
   "text": "וכשהוא מדבר על היהודים,"
  },
  {
   "start": 452.04,
   "end": 455.72,
   "text": "הוא אומר, זוהי תופעה כל כך לא רציונלית,"
  },
  {
   "start": 456.6,
   "end": 457.82,
   "text": "כל כך לא טבעית,"
  },
  {
   "start": 458.68,
   "end": 462.1,
   "text": "שלמולה ניצב כל היסטוריון פעור פה."
  },
  {
   "start": 463.0,
   "end": 464.56,
   "text": "נבין מי אנחנו."
  },
  {
   "start": 464.56,
   "end": 469.98,
   "text": "נבין מי אנחנו, זה אנחנו מדובר, עלינו!"
  },
  {
   "start": 470.5,
   "end": 475.04,
   "text": "אז איך אנחנו יכולים לפעמים להעיז בכלל להיות, רוצים להיות דומים שם לכוכב קולנוע הזה?"
  },
  {
   "start": 475.78,
   "end": 479.12,
   "text": "לשחקן כדורגל ההוא שם, אני יודע מה, לזמרת ההיא?"
  },
  {
   "start": 480.56,
   "end": 481.66,
   "text": "אנחנו עם נפלא."
  },
  {
   "start": 483.16,
   "end": 487.24,
   "text": "בוא נהיה אנחנו, נכיר את הערך שלנו, אין כמונו, אין כמוך,"
  },
  {
   "start": 487.66,
   "end": 489.88,
   "text": "אין כמוך, אין דבר כזה."
  },
  {
   "start": 490.3,
   "end": 491.8,
   "text": "אז בוא נהיה עצמנו באמת."
  },
  {
   "start": 497.62,
   "end": 502.76,
   "text": "אנחנו כולנו מאמינים בני מאמינים, כולנו, לא יעזור לאף"
  },
  {
   "start": 503.34,
   "end": 504.22,
   "text": "אף אחד בעולם."
  },
  {
   "start": 505.06,
   "end": 509.66,
   "text": "אנחנו מאמינים בני מאמינים, בני אברהם אבינו, בני יצחק, בני יעקב."
  }
 ]
}