{
 "disc": "13יג- תכלית",
 "track": "Track05",
 "duration": 398.184,
 "segments": [
  {
   "start": 8.0,
   "end": 9.3,
   "text": "ומה קורה אחר כך?"
  },
  {
   "start": 11.22,
   "end": 14.0,
   "text": "מה קורה אחר כך, אחרי שעולים למעלה"
  },
  {
   "start": 15.3,
   "end": 17.28,
   "text": "אל העולם הבא? עם מה באים למעלה?"
  },
  {
   "start": 18.54,
   "end": 23.96,
   "text": "את זה היטיב להמחיש לנו החפץ חיים במשל נפלא."
  },
  {
   "start": 24.48,
   "end": 25.6,
   "text": "אז בואו בעזרת השם,"
  },
  {
   "start": 25.94,
   "end": 30.08,
   "text": "בואו נתענג על פיו הקדוש של הכהן הגדול מאחיו,"
  },
  {
   "start": 31.6,
   "end": 33.6,
   "text": "רבי ישראל מאיר הכהן מראדין."
  },
  {
   "start": 36.88,
   "end": 37.64,
   "text": "היה איזה עשיר,"
  },
  {
   "start": 38.54,
   "end": 39.24,
   "text": "עשיר אחד,"
  },
  {
   "start": 41.92,
   "end": 43.52,
   "text": "יום אחד רואים אותו הבנים שלו,"
  },
  {
   "start": 44.76,
   "end": 46.22,
   "text": "קונה ארון מגירות גדול."
  },
  {
   "start": 48.38,
   "end": 49.76,
   "text": "מלא מגירות, המון מגירות."
  },
  {
   "start": 50.76,
   "end": 54.4,
   "text": "ארון מגירות, ובכל מגירה רואים אותו שם סוג של כסף."
  },
  {
   "start": 55.02,
   "end": 60.28,
   "text": "לירטות, דינאר מירדנים, דולרים, שקלים, יורו."
  },
  {
   "start": 62.38,
   "end": 68.79,
   "text": "ולמטה, בתוך כספת קטנה, הוא שם את יהלום הנסיכה."
  },
  {
   "start": 69.33,
   "end": 71.09,
   "text": "היהלום היקר ביותר בעולם."
  },
  {
   "start": 72.11,
   "end": 73.95,
   "text": "באים אליו הילדים ואומרים לו, אבא,"
  },
  {
   "start": 74.63,
   "end": 75.87,
   "text": "אבא למה? הרי יש בנק."
  },
  {
   "start": 76.55,
   "end": 80.73,
   "text": "הרי יש לך כל כך הרבה כסף, בשביל מה אתה שם כסף באמצע הסלון שם?"
  },
  {
   "start": 81.75,
   "end": 84.45,
   "text": "כסף מכל הסוגים, מה אתה צריך את זה?"
  },
  {
   "start": 86.61,
   "end": 88.17,
   "text": "אמר להם האבא, תקשיבו טוב,"
  },
  {
   "start": 89.19,
   "end": 91.13,
   "text": "אתם יודעים, אני רגיל בעולם הזה,"
  },
  {
   "start": 92.15,
   "end": 93.59,
   "text": "הכל אני משיג בכסף."
  },
  {
   "start": 95.13,
   "end": 98.67,
   "text": "אני משוכנע שגם בעולם הבא, הכל אני יכול לקנות בכסף."
  },
  {
   "start": 100.45,
   "end": 101.93,
   "text": "אבל אני לא יודע מה שכיר שם."
  },
  {
   "start": 103.87,
   "end": 106.15,
   "text": "עם מה אני יכול לקנות? עם איזה מטבע? דולרים?"
  },
  {
   "start": 106.77,
   "end": 108.79,
   "text": "יורו, שקלים, מה הולך שם?"
  },
  {
   "start": 110.17,
   "end": 111.17,
   "text": "אז אני אוסף מהכל,"
  },
  {
   "start": 113.56,
   "end": 116.1,
   "text": "ואפילו את היהלום, יהלום הנסיכה."
  },
  {
   "start": 117.3,
   "end": 119.22,
   "text": "אם לא בכסף, אז בטח יהלום,"
  },
  {
   "start": 119.66,
   "end": 122.16,
   "text": "שמה יהלום נחשב יקר ערך מאוד."
  },
  {
   "start": 123.06,
   "end": 124.74,
   "text": "ויש לי בקשה אחת, בניי היקרים,"
  },
  {
   "start": 125.32,
   "end": 128.4,
   "text": "כשאני אלך לעולמי, תקברו אותי עם הארון הזה."
  },
  {
   "start": 129.04,
   "end": 130.46,
   "text": "אני אבוא למעלה לשמיים,"
  },
  {
   "start": 130.8,
   "end": 133.18,
   "text": "ושם אני אנסה לקנות את חלקת גן עדן שלי."
  },
  {
   "start": 135.18,
   "end": 136.2,
   "text": "עברו להם הימים."
  },
  {
   "start": 147.03,
   "end": 147.89,
   "text": "האבא נפטר,"
  },
  {
   "start": 148.83,
   "end": 150.87,
   "text": "ונקבר עם הכסף"
  },
  {
   "start": 152.84,
   "end": 163.88,
   "text": "ועם היהלום, הוא מגיע אל העולם הבא."
  },
  {
   "start": 169.2,
   "end": 170.26,
   "text": "ואז הוא רואה את גן עדן,"
  },
  {
   "start": 171.36,
   "end": 174.24,
   "text": "והוא ראה מלאך גדול בשערי גן עדן."
  },
  {
   "start": 176.37,
   "end": 177.35,
   "text": "הוא ניגש אל המלאך,"
  },
  {
   "start": 178.53,
   "end": 180.35,
   "text": "אני יכול להיכנס פנימה לגן עדן?"
  },
  {
   "start": 181.97,
   "end": 184.55,
   "text": "והמלאך מביט מחייך, אומר לו, הבאת משהו איתך?"
  },
  {
   "start": 186.96,
   "end": 188.12,
   "text": "אז העשיר הוציא דולרים,"
  },
  {
   "start": 190.56,
   "end": 193.82,
   "text": "ושמח בלבו, הנה, באמת אפשר לקנות גן עדן,"
  },
  {
   "start": 194.46,
   "end": 196.1,
   "text": "הכל אפשר לקנות גם בעולם הבא."
  },
  {
   "start": 196.74,
   "end": 199.24,
   "text": "אבל המלאך מביט ואומר לו,"
  },
  {
   "start": 201.24,
   "end": 204.22,
   "text": "יהודי, עם זה לא נכנסים לגן עדן."
  },
  {
   "start": 206.33,
   "end": 211.17,
   "text": "הוא מוציא יורו, עם זה,"
  },
  {
   "start": 211.75,
   "end": 213.49,
   "text": "יהודי, לא נכנסים לגן עדן."
  },
  {
   "start": 214.51,
   "end": 215.33,
   "text": "שקלים,"
  },
  {
   "start": 216.27,
   "end": 218.03,
   "text": "עם זה לא נכנסים לגן עדן."
  },
  {
   "start": 218.65,
   "end": 219.95,
   "text": "דינארים ירדנים,"
  },
  {
   "start": 220.59,
   "end": 223.09,
   "text": "יהודי, עם זה לא נכנסים לגן עדן."
  },
  {
   "start": 223.41,
   "end": 226.99,
   "text": "וכך את כל סוגי המטבעות הוא מוציא ומוציא."
  },
  {
   "start": 228.01,
   "end": 228.51,
   "text": "לבסוף,"
  },
  {
   "start": 229.53,
   "end": 230.49,
   "text": "לבסוף הוא מוציא."
  },
  {
   "start": 233.04,
   "end": 238.94,
   "text": "את יהלום הנסיכה טוף בנייר."
  },
  {
   "start": 248.48,
   "end": 249.3,
   "text": "אז הוא רואה את המלאך,"
  },
  {
   "start": 250.34,
   "end": 252.94,
   "text": "איך עיני המלאך נפתחות"
  },
  {
   "start": 253.66,
   "end": 254.88,
   "text": "לנוכח היהלום,"
  },
  {
   "start": 257.34,
   "end": 258.94,
   "text": "וליבו נתמלא בשמחה."
  },
  {
   "start": 260.28,
   "end": 262.66,
   "text": "ואז המלאך ממלמל, עם זה,"
  },
  {
   "start": 263.5,
   "end": 264.16,
   "text": "עם זה יהודי,"
  },
  {
   "start": 264.86,
   "end": 266.26,
   "text": "עם זה קונים גן עדן,"
  },
  {
   "start": 266.62,
   "end": 268.32,
   "text": "עם זה נכנסים לגן עדן."
  },
  {
   "start": 269.3,
   "end": 270.58,
   "text": "והעשיר אוהד כולו,"
  },
  {
   "start": 271.28,
   "end": 278.7,
   "text": "והמלאך מושיט יד ותופס את הנייר שעוטף את היהלום,"
  },
  {
   "start": 280.14,
   "end": 283.04,
   "text": "ובתנועה מהירה מעיף את היהלום,"
  },
  {
   "start": 285.72,
   "end": 286.66,
   "text": "ומנפנף"
  },
  {
   "start": 287.52,
   "end": 289.66,
   "text": "עם הנייר שעטף את היהלום."
  },
  {
   "start": 290.5,
   "end": 291.02,
   "text": "יהודי,"
  },
  {
   "start": 291.86,
   "end": 292.72,
   "text": "יהודי יקר,"
  },
  {
   "start": 293.38,
   "end": 294.0,
   "text": "עם זה,"
  },
  {
   "start": 295.58,
   "end": 297.36,
   "text": "עם פיסת הנייר הזו,"
  },
  {
   "start": 298.08,
   "end": 299.18,
   "text": "קונים גן עדן,"
  },
  {
   "start": 300.18,
   "end": 304.52,
   "text": "והעשיר באה בתדהמה בפיסת הנייר."
  },
  {
   "start": 305.38,
   "end": 307.38,
   "text": "זו לא הייתה פיסת נייר רגילה,"
  },
  {
   "start": 308.0,
   "end": 313.58,
   "text": "זו הייתה קבלה על צדקה שהיהודי הזה פעם בחיים נתן."
  },
  {
   "start": 315.22,
   "end": 318.42,
   "text": "עם זה קונים גן עדן, עם תורה,"
  },
  {
   "start": 319.14,
   "end": 321.98,
   "text": "עם מצוות, עם צדקה,"
  },
  {
   "start": 322.6,
   "end": 325.82,
   "text": "עם תפילה, עם קיום רצון השם,"
  },
  {
   "start": 326.9,
   "end": 327.76,
   "text": "עם מצוות."
  },
  {
   "start": 329.18,
   "end": 331.26,
   "text": "עם מצוות באים לבורא עולם,"
  },
  {
   "start": 333.41,
   "end": 337.21,
   "text": "עם מצוות יהודים, עם מצוות באים לבורא עולם."
  },
  {
   "start": 338.73,
   "end": 342.87,
   "text": "למעלה בשמיים לא עוזר לו כסף ולא זהב,"
  },
  {
   "start": 343.59,
   "end": 345.05,
   "text": "לא שרירים ולא יופי,"
  },
  {
   "start": 345.97,
   "end": 348.09,
   "text": "עוזר דבר אחד,"
  },
  {
   "start": 348.99,
   "end": 349.73,
   "text": "יהדות,"
  },
  {
   "start": 350.87,
   "end": 353.59,
   "text": "עשיית רצון השם יתברך."
  },
  {
   "start": 355.57,
   "end": 358.59,
   "text": "ומי שחושב שפה בעולם הזה,"
  },
  {
   "start": 358.99,
   "end": 362.25,
   "text": "אם הוא יעשה את רצון השם יתברך, הוא יפסיד, הוא טועה."
  },
  {
   "start": 365.46,
   "end": 366.42,
   "text": "הכל אפשר לעשות,"
  },
  {
   "start": 367.72,
   "end": 369.56,
   "text": "רק בצורה קדושה וטהורה."
  },
  {
   "start": 371.46,
   "end": 372.3,
   "text": "ואז יהיה לנו"
  },
  {
   "start": 373.54,
   "end": 374.98,
   "text": "טוב בזה ובבא,"
  },
  {
   "start": 377.5,
   "end": 381.6,
   "text": "להיות את ואתה בעולם הזה ובעולם הבא."
  },
  {
   "start": 383.62,
   "end": 384.88,
   "text": "יש יותר טוב מזה?"
  },
  {
   "start": 387.24,
   "end": 389.54,
   "text": "זה לקנות גן עדן בעולם הזה."
  }
 ]
}