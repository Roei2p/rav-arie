{
 "disc": "13יג- תכלית",
 "track": "Track03",
 "duration": 253.176,
 "segments": [
  {
   "start": 2.15,
   "end": 2.69,
   "text": "אורם מאיר,"
  },
  {
   "start": 3.51,
   "end": 6.79,
   "text": "אחד מהאדמו״רים הקדושים מתלמידי החוזה מלובלין,"
  },
  {
   "start": 9.83,
   "end": 11.07,
   "text": "התארח באכסניה,"
  },
  {
   "start": 12.87,
   "end": 14.99,
   "text": "נתנו לו חדר, חדר פשוט, חדר נוח,"
  },
  {
   "start": 16.37,
   "end": 19.65,
   "text": "ובחדר היה שעון גדול, תלוי בקיר."
  },
  {
   "start": 22.12,
   "end": 23.1,
   "text": "יורד לו הלילה,"
  },
  {
   "start": 24.18,
   "end": 27.36,
   "text": "ובל אורם מאיר לא מצליח לישון."
  },
  {
   "start": 29.51,
   "end": 31.59,
   "text": "הוא מתחיל להסתובב הלוך ושוב בחדר,"
  },
  {
   "start": 34.4,
   "end": 36.48,
   "text": "כולו דבקות, כולו תפילה, כולו תורה."
  },
  {
   "start": 39.15,
   "end": 40.55,
   "text": "אבל אתם יודעים, אז היה החדרים,"
  },
  {
   "start": 41.37,
   "end": 42.53,
   "text": "הרצפה הייתה מעץ."
  },
  {
   "start": 43.19,
   "end": 46.31,
   "text": "וכשאתה נמצא בקומה שנייה, ואתה מסתובב כל הלילה,"
  },
  {
   "start": 47.01,
   "end": 48.73,
   "text": "אז זה שמתחתיך לא יכול לישון."
  },
  {
   "start": 51.16,
   "end": 51.62,
   "text": "בעל הבית"
  },
  {
   "start": 52.32,
   "end": 53.6,
   "text": "ישן בדיוק מתחת,"
  },
  {
   "start": 54.22,
   "end": 55.22,
   "text": "והוא לא מצליח לישון."
  },
  {
   "start": 57.72,
   "end": 59.0,
   "text": "אז הוא אומר, מה קורה לרב?"
  },
  {
   "start": 59.78,
   "end": 60.88,
   "text": "למה הרב לא יושן?"
  },
  {
   "start": 61.58,
   "end": 64.26,
   "text": "בסוף אמרת לו, ואני לא יושן, הוא לא יושן, לפחות אני אגיש לו כוס תה."
  },
  {
   "start": 65.52,
   "end": 66.7,
   "text": "הלך והכין לו כוס תה."
  },
  {
   "start": 67.52,
   "end": 69.42,
   "text": "בא דופק בדלת, הרב פותח לו את הדלת."
  },
  {
   "start": 70.1,
   "end": 71.32,
   "text": "קורא לו, בבקשה, קח כוס תה."
  },
  {
   "start": 72.5,
   "end": 75.66,
   "text": "ואז מעיז בעל הבית לשאול,"
  },
  {
   "start": 76.4,
   "end": 77.56,
   "text": "למה הרב לא ישן?"
  },
  {
   "start": 78.42,
   "end": 79.66,
   "text": "החדר לא כל כך נוח?"
  },
  {
   "start": 80.3,
   "end": 80.96,
   "text": "החדר לא מתאים?"
  },
  {
   "start": 82.9,
   "end": 84.72,
   "text": "אמר לו אור אמיר, הכל בסדר."
  },
  {
   "start": 85.58,
   "end": 86.9,
   "text": "רק תגיד לי, יש לי שאלה אחת."
  },
  {
   "start": 87.92,
   "end": 88.84,
   "text": "השעון הגדול הזה,"
  },
  {
   "start": 89.54,
   "end": 90.92,
   "text": "אז זה השעון שבקיר."
  },
  {
   "start": 92.16,
   "end": 95.9,
   "text": "האם הוא לא במקרה השעון של החוזה מלובלין?"
  },
  {
   "start": 98.28,
   "end": 98.9,
   "text": "אמר לו, כן."
  },
  {
   "start": 102.55,
   "end": 104.33,
   "text": "הבן שלו היה כאן לפני שבועיים."
  },
  {
   "start": 105.09,
   "end": 106.21,
   "text": "לא היה לו כסף לשלם,"
  },
  {
   "start": 106.77,
   "end": 108.65,
   "text": "אז הוא משכן את השעון עד שהוא יביא כסף,"
  },
  {
   "start": 109.21,
   "end": 110.21,
   "text": "ואז הוא ייקח את השעון."
  },
  {
   "start": 112.25,
   "end": 113.37,
   "text": "תגיד לי אבל, כבוד הרב,"
  },
  {
   "start": 114.13,
   "end": 117.93,
   "text": "מה הקשר בין השעון לזה שכבוד הרב לא מצליח לישון?"
  },
  {
   "start": 119.31,
   "end": 121.57,
   "text": "ואיך הרב בכלל ידע שזה השעון של החוזה?"
  },
  {
   "start": 123.21,
   "end": 124.97,
   "text": "למה הרב לא ישן בגלל השעון?"
  },
  {
   "start": 126.27,
   "end": 127.47,
   "text": "אמר לו אור המאיר,"
  },
  {
   "start": 128.75,
   "end": 130.31,
   "text": "תדע לך, יהודי יקר,"
  },
  {
   "start": 130.87,
   "end": 133.27,
   "text": "יש שני סוגים של שעונים בעולם."
  },
  {
   "start": 135.17,
   "end": 136.11,
   "text": "רוב השעונים,"
  },
  {
   "start": 137.43,
   "end": 138.73,
   "text": "כשאתה מביט בהם,"
  },
  {
   "start": 139.39,
   "end": 141.89,
   "text": "אתה רואה הם אומרים לך, עברה עוד שעה,"
  },
  {
   "start": 142.67,
   "end": 143.83,
   "text": "עברה לה עוד שעה."
  },
  {
   "start": 153.68,
   "end": 155.02,
   "text": "ואתה יודע שהחיים עוברים."
  },
  {
   "start": 156.44,
   "end": 157.48,
   "text": "אז אתה הולך לישון,"
  },
  {
   "start": 158.32,
   "end": 159.14,
   "text": "כבר מה זה משנה?"
  },
  {
   "start": 161.08,
   "end": 163.4,
   "text": "אבל השעון של החוזה מלובלין,"
  },
  {
   "start": 164.16,
   "end": 166.92,
   "text": "אבל השעון של החוזה מלובלין אומר אחרת."
  },
  {
   "start": 167.6,
   "end": 169.06,
   "text": "כשאתה מביט בו הוא אומר,"
  },
  {
   "start": 171.62,
   "end": 176.42,
   "text": "נפתעות שעה, התקרבת בעוד שעה."
  },
  {
   "start": 177.48,
   "end": 181.24,
   "text": "התקרבת בעוד שעה לחיי העולם הבא."
  },
  {
   "start": 181.94,
   "end": 185.22,
   "text": "תיק-תק, התקרבת בעוד שעה לתכלית שלך."
  },
  {
   "start": 186.6,
   "end": 190.48,
   "text": "תגיד לי, עם שעון כזה, איך אפשר להירדם?"
  },
  {
   "start": 191.88,
   "end": 193.68,
   "text": "עם שעון כזה שאומר לך,"
  },
  {
   "start": 194.5,
   "end": 195.28,
   "text": "תיק-תק,"
  },
  {
   "start": 195.94,
   "end": 197.34,
   "text": "התקרבת בעוד שעה."
  },
  {
   "start": 198.4,
   "end": 202.28,
   "text": "אתה יכול לנצל עוד שעה לזכות ולהתקרב אל השם יתברך,"
  },
  {
   "start": 202.78,
   "end": 204.04,
   "text": "להתקרב לעולם הבא,"
  },
  {
   "start": 204.56,
   "end": 206.2,
   "text": "להתקרב לתכלית שלך,"
  },
  {
   "start": 206.28,
   "end": 208.28,
   "text": "להתקרב לתיקון נשמה שלך."
  },
  {
   "start": 208.86,
   "end": 209.34,
   "text": "טק-טק,"
  },
  {
   "start": 210.0,
   "end": 211.04,
   "text": "התקרבת עוד שעה."
  },
  {
   "start": 211.68,
   "end": 213.32,
   "text": "עם שעון כזה אי אפשר לישון."
  },
  {
   "start": 213.82,
   "end": 216.66,
   "text": "חייבים ללכת ולנצל עוד דקה מהעולם הזה."
  },
  {
   "start": 217.04,
   "end": 218.08,
   "text": "עוד שעה מהעולם הזה."
  },
  {
   "start": 223.44,
   "end": 225.66,
   "text": "זה השעון של החוזה מלובלין."
  },
  {
   "start": 226.26,
   "end": 227.66,
   "text": "זה השעון שצריך להיות לנו."
  },
  {
   "start": 228.46,
   "end": 232.52,
   "text": "שעון זמן אמיתי שאומר יהודי יהודייה."
  },
  {
   "start": 233.42,
   "end": 234.28,
   "text": "עברה עוד שעה?"
  },
  {
   "start": 234.8,
   "end": 237.84,
   "text": "לא, התקרבת בעוד שעה אל הגאולה."
  },
  {
   "start": 238.52,
   "end": 240.36,
   "text": "התקרבת בעוד שעה אל התכלית."
  },
  {
   "start": 241.06,
   "end": 243.3,
   "text": "התקרבת בעוד שנה אל גן עדן,"
  },
  {
   "start": 243.78,
   "end": 244.66,
   "text": "אל עולם הבא."
  },
  {
   "start": 245.96,
   "end": 247.46,
   "text": "כדאי לנצל כל שעה,"
  },
  {
   "start": 248.1,
   "end": 249.44,
   "text": "כדאי לנצל כל דקה."
  },
  {
   "start": 251.0,
   "end": 252.38,
   "text": "כדאי לנצל כל דקה."
  }
 ]
}