{
 "disc": "13יג- תכלית",
 "track": "Track06",
 "duration": 202.2,
 "segments": [
  {
   "start": 1.92,
   "end": 6.4,
   "text": "ממש לפנות בוקר, עשה את דרכו אחד מגדולי ישראל המיוחדים,"
  },
  {
   "start": 7.5,
   "end": 8.7,
   "text": "הגאון רבי ישראל סלנטר,"
  },
  {
   "start": 9.82,
   "end": 11.3,
   "text": "עשה את דרכו אל בית הכנסת."
  },
  {
   "start": 12.14,
   "end": 13.22,
   "text": "זו הייתה תקופת סליחות."
  },
  {
   "start": 15.26,
   "end": 17.26,
   "text": "ולפתע הוא ראה אור דולק"
  },
  {
   "start": 18.16,
   "end": 20.62,
   "text": "בבית של אחד מהיהודים בעיירה סלנט."
  },
  {
   "start": 22.12,
   "end": 22.74,
   "text": "זה היה הסנדלר,"
  },
  {
   "start": 25.45,
   "end": 29.41,
   "text": "הזרב שכל כך דאג לכל עם ישראל, דופק בזהירות בדלת."
  },
  {
   "start": 30.79,
   "end": 32.13,
   "text": "והסנדלר פותח לו את הדלת."
  },
  {
   "start": 32.99,
   "end": 33.71,
   "text": "אמר לו, כן, הרב."
  },
  {
   "start": 34.75,
   "end": 35.21,
   "text": "והוא רואה,"
  },
  {
   "start": 36.31,
   "end": 37.91,
   "text": "הוא רואה בפינת החדר נר דולק"
  },
  {
   "start": 39.33,
   "end": 40.21,
   "text": "ואת הסנדלר"
  },
  {
   "start": 40.81,
   "end": 41.27,
   "text": "עובד"
  },
  {
   "start": 42.05,
   "end": 42.81,
   "text": "מתקן נעליים."
  },
  {
   "start": 44.69,
   "end": 45.97,
   "text": "הגאון רבי ישראל סלנטר"
  },
  {
   "start": 46.91,
   "end": 47.27,
   "text": "הביט"
  },
  {
   "start": 48.27,
   "end": 49.95,
   "text": "על הסנדלר ואמר לו, יהודי,"
  },
  {
   "start": 52.89,
   "end": 55.17,
   "text": "אתה לא הולך לסליחות, לפחות תלך לישון תנוח."
  },
  {
   "start": 56.25,
   "end": 58.55,
   "text": "למה אתה עובד עד שעות כאלה מאוחרות?"
  },
  {
   "start": 59.47,
   "end": 61.03,
   "text": "הביט בו הסנדלר ואמר,"
  },
  {
   "start": 65.46,
   "end": 67.8,
   "text": "הרב, כל זמן שהנר דולק"
  },
  {
   "start": 68.42,
   "end": 69.44,
   "text": "יש לתקן."
  },
  {
   "start": 69.9,
   "end": 70.82,
   "text": "הרב, אתה רואה את הנר?"
  },
  {
   "start": 71.82,
   "end": 73.08,
   "text": "כל זמן שהנר הזה דולק,"
  },
  {
   "start": 73.98,
   "end": 75.84,
   "text": "יש לתקן, אני אנצל את זה כדי לתקן."
  },
  {
   "start": 76.28,
   "end": 77.22,
   "text": "עוד נעל ועוד נעל."
  },
  {
   "start": 80.2,
   "end": 81.14,
   "text": "רבי ישראל סלנטר"
  },
  {
   "start": 81.98,
   "end": 83.08,
   "text": "עזב את הסנדלר נפעם."
  },
  {
   "start": 84.68,
   "end": 86.0,
   "text": "הוא עשה את דרכו אל בית הכנסת."
  },
  {
   "start": 87.56,
   "end": 88.82,
   "text": "נכנס אל בית הכנסת,"
  },
  {
   "start": 94.21,
   "end": 95.27,
   "text": "דפק על הבמה"
  },
  {
   "start": 96.53,
   "end": 98.09,
   "text": "ונשתררה לדממה."
  },
  {
   "start": 101.45,
   "end": 102.77,
   "text": "כולם התבוננו."
  },
  {
   "start": 103.59,
   "end": 105.23,
   "text": "והרב רבי ישראל סלנטר"
  },
  {
   "start": 106.07,
   "end": 108.39,
   "text": "הרים את עיניו לשמיים ואמר יהודים,"
  },
  {
   "start": 109.27,
   "end": 110.39,
   "text": "היום למדתי"
  },
  {
   "start": 111.27,
   "end": 113.81,
   "text": "דבר גדול מיהודי פשוט."
  },
  {
   "start": 115.83,
   "end": 117.51,
   "text": "היום למדתי דבר גדול,"
  },
  {
   "start": 118.17,
   "end": 120.41,
   "text": "כל זמן שהנר דולק"
  },
  {
   "start": 120.99,
   "end": 122.11,
   "text": "יש לתקן."
  },
  {
   "start": 123.17,
   "end": 126.01,
   "text": "כל זמן שהנר דולק יש לתקן."
  },
  {
   "start": 126.81,
   "end": 128.77,
   "text": "כל זמן שאתה עדיין חי,"
  },
  {
   "start": 129.47,
   "end": 131.05,
   "text": "שבעולם נותן לך עוד יום לחיות,"
  },
  {
   "start": 131.93,
   "end": 132.99,
   "text": "עוד שנה לחיות,"
  },
  {
   "start": 133.59,
   "end": 134.67,
   "text": "יש לתקן."
  },
  {
   "start": 135.31,
   "end": 136.11,
   "text": "תתקן,"
  },
  {
   "start": 137.23,
   "end": 138.31,
   "text": "תתקרב לשם,"
  },
  {
   "start": 139.17,
   "end": 140.63,
   "text": "קח איתך תורה ומצוות,"
  },
  {
   "start": 141.17,
   "end": 142.65,
   "text": "תבוא עם זה לעולם הבא,"
  },
  {
   "start": 143.55,
   "end": 146.89,
   "text": "תהנה פה בעולם הזה, תרכוש לך את העולם הזה."
  },
  {
   "start": 147.77,
   "end": 150.59,
   "text": "כל זמן שהנר דולק יש לתקן."
  },
  {
   "start": 151.63,
   "end": 156.57,
   "text": "נר השם נשמת אדם, כל זמן שהשמה בגוף של היהודי היא בוערת,"
  },
  {
   "start": 157.03,
   "end": 157.99,
   "text": "היא רוצה את השם."
  },
  {
   "start": 159.71,
   "end": 163.57,
   "text": "רק תיתן לה. אה, אין ייאוש בעולם, אין ייאוש לעולם למאוחר."
  },
  {
   "start": 164.11,
   "end": 168.87,
   "text": "לעולם לא מאוחר להתקרב לשם, לעולם לא מאוחר להתקרב אל השם."
  },
  {
   "start": 169.73,
   "end": 171.85,
   "text": "כל זמן שהנר דולק יש לתקן,"
  },
  {
   "start": 172.23,
   "end": 176.81,
   "text": "כל זמן שהנר, כל זמן שהנשמה בגוף של האדם, כל זמן שאתה חי, כל זמן שאת חיה,"
  },
  {
   "start": 177.29,
   "end": 177.93,
   "text": "תתקרבי לשם."
  },
  {
   "start": 178.27,
   "end": 180.49,
   "text": "תשובה, יראת שמיים, בשמחה."
  },
  {
   "start": 181.27,
   "end": 182.81,
   "text": "כי כל זמן שהנר דולק,"
  },
  {
   "start": 183.55,
   "end": 183.83,
   "text": "יש לתקן."
  },
  {
   "start": 185.77,
   "end": 186.49,
   "text": "יש לתקן."
  }
 ]
}