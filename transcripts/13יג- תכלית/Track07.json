{
 "disc": "13יג- תכלית",
 "track": "Track07",
 "duration": 388.176,
 "segments": [
  {
   "start": 0.0,
   "end": 6.77,
   "text": "הרמב״ם,"
  },
  {
   "start": 9.97,
   "end": 11.65,
   "text": "הרמב״ם בהלכות יסודי התורה,"
  },
  {
   "start": 12.73,
   "end": 13.17,
   "text": "קובע"
  },
  {
   "start": 13.85,
   "end": 19.23,
   "text": "בני ישראל לא הלכו אחרי משה בזכות האותות והמופתים אשר עשה,"
  },
  {
   "start": 20.23,
   "end": 20.93,
   "text": "כי המאמין"
  },
  {
   "start": 21.73,
   "end": 22.57,
   "text": "על פי אותות"
  },
  {
   "start": 23.29,
   "end": 23.99,
   "text": "ומופתים"
  },
  {
   "start": 24.97,
   "end": 25.85,
   "text": "יש בליבו דופי."
  },
  {
   "start": 29.96,
   "end": 31.68,
   "text": "כל הדתות מתבססות"
  },
  {
   "start": 32.56,
   "end": 34.26,
   "text": "ומתבססות על סיפורים"
  },
  {
   "start": 35.18,
   "end": 37.66,
   "text": "של אדם אחד שבא ומספר שקרה לו כך."
  },
  {
   "start": 38.56,
   "end": 41.84,
   "text": "אחד היה אומר שנגלה לא כך, ואחד היה אומר שנגלה לא כך."
  },
  {
   "start": 42.66,
   "end": 43.14,
   "text": "ואנחנו,"
  },
  {
   "start": 43.82,
   "end": 44.66,
   "text": "עם ישראל,"
  },
  {
   "start": 45.28,
   "end": 47.54,
   "text": "עם של קודש, לנו יש רצף,"
  },
  {
   "start": 48.56,
   "end": 51.26,
   "text": "לנו יש שרשרת, לנו יש סדר דורות,"
  },
  {
   "start": 54.29,
   "end": 58.71,
   "text": "לנו יש סדר דורות ממעמד הר סיני ועד היום."
  },
  {
   "start": 60.25,
   "end": 63.25,
   "text": "מהזמן שבו התגלה בורא עולם ונתן לנו את התורה הקדושה,"
  },
  {
   "start": 63.65,
   "end": 64.43,
   "text": "לא לפני אחד,"
  },
  {
   "start": 65.15,
   "end": 66.11,
   "text": "לפני מיליונים."
  },
  {
   "start": 66.65,
   "end": 67.47,
   "text": "והכל מתועד,"
  },
  {
   "start": 67.99,
   "end": 70.09,
   "text": "והכל כל כך אמיתי."
  },
  {
   "start": 71.31,
   "end": 73.01,
   "text": "והיום, בתקופה שלנו,"
  },
  {
   "start": 73.95,
   "end": 76.49,
   "text": "עם כל התפתחות המדע והטכנולוגיה,"
  },
  {
   "start": 77.21,
   "end": 79.43,
   "text": "כבר לא רק שאנחנו יודעים זאת,"
  },
  {
   "start": 80.49,
   "end": 83.19,
   "text": "גם הגויים, גם כל היקום יודע את זה."
  },
  {
   "start": 85.14,
   "end": 86.94,
   "text": "היום הארכיאולוגיה המודרנית."
  },
  {
   "start": 88.8,
   "end": 93.1,
   "text": "בואו נראה מה כותבת וילד אורנט, המסופר."
  },
  {
   "start": 93.84,
   "end": 98.14,
   "text": "המסופר בתנ״ך עמד במבחן הביקורת והארכיאולוגיה."
  },
  {
   "start": 99.14,
   "end": 100.5,
   "text": "כל שנה נוספות"
  },
  {
   "start": 101.48,
   "end": 102.48,
   "text": "עוד אמיתות."
  },
  {
   "start": 103.4,
   "end": 104.64,
   "text": "נוספת לה עוד אמינות."
  },
  {
   "start": 105.32,
   "end": 105.88,
   "text": "וילדורנט."
  },
  {
   "start": 107.62,
   "end": 108.42,
   "text": "ארכיאולוגיה"
  },
  {
   "start": 111.2,
   "end": 112.0,
   "text": "נלסון גליק,"
  },
  {
   "start": 113.02,
   "end": 115.04,
   "text": "בספר עבר הירדן המזרחי, עמוד 14,"
  },
  {
   "start": 118.16,
   "end": 123.2,
   "text": "אומר בצורה חד משמעית ימים רבים עסקתי בארכיאולוגיה מקראית"
  },
  {
   "start": 123.86,
   "end": 127.96,
   "text": "ועד היום לא הוצאתי ממעבי האדמה שום דבר"
  },
  {
   "start": 128.56,
   "end": 131.34,
   "text": "שיש בו איזו סתירה כביכול לדברי המקרא."
  },
  {
   "start": 132.34,
   "end": 135.44,
   "text": "נלסון גליק אומר, אני ארכיאולוג, חפרתי, בדקתי,"
  },
  {
   "start": 135.92,
   "end": 139.0,
   "text": "לא מצאתי משהו שיסתור את התורה הקדושה."
  },
  {
   "start": 140.52,
   "end": 141.32,
   "text": "ויליאם אולברייט,"
  },
  {
   "start": 142.1,
   "end": 146.48,
   "text": "מרובים הפרטים שנתעמתו על ידי דגליות בשנים האחרונות."
  },
  {
   "start": 150.7,
   "end": 152.06,
   "text": "פרופסור דיוויד רול,"
  },
  {
   "start": 156.22,
   "end": 157.62,
   "text": "נמצא פפירוס ברוקלין,"
  },
  {
   "start": 158.56,
   "end": 160.1,
   "text": "פפירוס ברוקלין נמצא במצרים,"
  },
  {
   "start": 160.68,
   "end": 161.38,
   "text": "שם המתואר,"
  },
  {
   "start": 162.08,
   "end": 167.18,
   "text": "איך מובא צהר מלכותי להעביר קבוצת עבדים מאזור לאזור במצרים."
  },
  {
   "start": 169.34,
   "end": 170.12,
   "text": "פלאי פלאות,"
  },
  {
   "start": 170.74,
   "end": 172.68,
   "text": "מה השמות של העבדים שרשומים שם?"
  },
  {
   "start": 173.72,
   "end": 174.48,
   "text": "שפרה,"
  },
  {
   "start": 175.24,
   "end": 176.58,
   "text": "מנחם, אשר,"
  },
  {
   "start": 179.34,
   "end": 184.1,
   "text": "מעידים כאלף עדים על יציאת מצרים, עבדות היהודים במצרים."
  },
  {
   "start": 185.28,
   "end": 186.42,
   "text": "פרופסור דיוויד רול,"
  },
  {
   "start": 187.68,
   "end": 188.86,
   "text": "בחפירות בגושן"
  },
  {
   "start": 193.9,
   "end": 199.87,
   "text": "נמצאו שלדים באותה שכבת קרקע,"
  },
  {
   "start": 200.47,
   "end": 205.41,
   "text": "שמה נמצאו השלדים נמצא אחוז גבוה מאוד של שלדי תינוקות."
  },
  {
   "start": 205.41,
   "end": 212.44,
   "text": "עד גיל שמונה עשרה חודש מעידים עדות אילמת"
  },
  {
   "start": 213.78,
   "end": 218.72,
   "text": "על גזירת כל הבנה ילודי אורה תשליכו וכל הבת תחיון."
  },
  {
   "start": 219.48,
   "end": 221.02,
   "text": "דווקא תינוקות זכרים."
  },
  {
   "start": 222.54,
   "end": 229.32,
   "text": "אחוז גבוה מאוד בארכיאולוגיה."
  },
  {
   "start": 230.46,
   "end": 232.86,
   "text": "ואין לה ברירה להודות, התורה אמת."
  },
  {
   "start": 233.6,
   "end": 235.06,
   "text": "התורה של היהודים אמת."
  },
  {
   "start": 237.08,
   "end": 238.72,
   "text": "וזו התורה שאנחנו נקשרים אליה."
  },
  {
   "start": 239.12,
   "end": 240.4,
   "text": "זו התורה שאנחנו מקיימים אותה."
  },
  {
   "start": 241.56,
   "end": 243.26,
   "text": "ההיסטוריון הפרסי ארודאס,"
  },
  {
   "start": 243.62,
   "end": 247.84,
   "text": "שנחשב למספר אחד בנאמנות הוא בר סמכה אצל החוקרים,"
  },
  {
   "start": 249.18,
   "end": 250.68,
   "text": "גילה מקום בשם און,"
  },
  {
   "start": 252.14,
   "end": 254.4,
   "text": "שמשמש כבית עבודה זרה לכהני מצרים,"
  },
  {
   "start": 254.82,
   "end": 256.84,
   "text": "ואחד מהם נקרא פוטיפרה,"
  },
  {
   "start": 258.12,
   "end": 260.94,
   "text": "בדיוק כמו בתורה שרשום פוטיפרה כהן און."
  },
  {
   "start": 261.78,
   "end": 266.4,
   "text": "אומר הרבה, בני ישראל לא הלכו אחרי משה בזכות האותות והמופתים אשר עשה."
  },
  {
   "start": 266.78,
   "end": 268.16,
   "text": "אנחנו לא הולכים אחרי אותות, לא אחרי מופתים,"
  },
  {
   "start": 269.14,
   "end": 270.16,
   "text": "לא שטיפת מוח."
  },
  {
   "start": 270.9,
   "end": 272.04,
   "text": "לא אופיום להמונים."
  },
  {
   "start": 273.18,
   "end": 274.36,
   "text": "אנחנו הולכים אחרי אמת."
  },
  {
   "start": 278.23,
   "end": 280.15,
   "text": "וצריך לדעת שאנחנו שייכים לעם נפלא,"
  },
  {
   "start": 280.57,
   "end": 284.63,
   "text": "עם שהביא לעולם מצפון, חסד, אמונה, חוכמה."
  },
  {
   "start": 286.59,
   "end": 287.67,
   "text": "אתם יודעים, יאן מסריק,"
  },
  {
   "start": 288.63,
   "end": 292.01,
   "text": "זה היה נשיא צ'כיה הראשון. הוא הגיע לדגניה, לקיבוץ דגניה בארץ."
  },
  {
   "start": 293.33,
   "end": 295.51,
   "text": "שאלה כמעט ראשונה שהוא שאל, איפה יש פה בית כנסת?"
  },
  {
   "start": 296.25,
   "end": 297.35,
   "text": "אמרו לו, אין לה, אין כאן."
  },
  {
   "start": 297.95,
   "end": 300.67,
   "text": "הוא הזדעזע, אמר, אתם יודעים, מקום,"
  },
  {
   "start": 301.29,
   "end": 303.29,
   "text": "כל מקום בעולם שאין בית כנסת,"
  },
  {
   "start": 303.87,
   "end": 304.79,
   "text": "קיומו אינו קיום."
  },
  {
   "start": 308.34,
   "end": 309.54,
   "text": "את זה אמר יאן מסריק,"
  },
  {
   "start": 310.48,
   "end": 311.56,
   "text": "נשיא צ'ר יגוי."
  },
  {
   "start": 313.6,
   "end": 316.06,
   "text": "הוא אומר עלינו, מה אנחנו צריכים לדעת על עצמנו?"
  },
  {
   "start": 317.02,
   "end": 319.44,
   "text": "שר החוץ הצרפתי ז'יל ברטלמי סנטהלר,"
  },
  {
   "start": 320.58,
   "end": 321.18,
   "text": "שר החוץ לשעבר,"
  },
  {
   "start": 322.34,
   "end": 325.18,
   "text": "הוא עצמו אמר, אין עם שהשפיע על אנושות כעם ישראל."
  },
  {
   "start": 325.84,
   "end": 326.62,
   "text": "התנ״ך שלו,"
  },
  {
   "start": 327.44,
   "end": 328.1,
   "text": "זה התנ״ך שלנו,"
  },
  {
   "start": 328.96,
   "end": 330.6,
   "text": "שלך, שלך, שלי, של כולנו."
  },
  {
   "start": 331.12,
   "end": 334.22,
   "text": "הוא הספר הגדול ביותר בין כל כתבי העמים,"
  },
  {
   "start": 335.06,
   "end": 337.06,
   "text": "והוא עושה את ישראל, עם השם."
  },
  {
   "start": 340.95,
   "end": 342.19,
   "text": "כמה זה מחייב אותנו."
  },
  {
   "start": 342.85,
   "end": 344.05,
   "text": "נחייב אותנו."
  },
  {
   "start": 345.21,
   "end": 345.59,
   "text": "אותנו."
  },
  {
   "start": 346.19,
   "end": 349.65,
   "text": "להדליק את הנר שלנו, את הנשמה, נרשם נשמת אדם."
  },
  {
   "start": 379.45,
   "end": 381.47,
   "text": "ולעולם לא מאוחר לעשות את זה."
  }
 ]
}