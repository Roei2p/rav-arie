{
 "disc": "37ת- פורים שמחת האמונה",
 "track": "Track05",
 "duration": 690.192,
 "segments": [
  {
   "start": 8.92,
   "end": 9.9,
   "text": "אין מקרה בעולם."
  },
  {
   "start": 13.5,
   "end": 16.36,
   "text": "גם הדברים הכי נראים לכאורה מקריים,"
  },
  {
   "start": 18.24,
   "end": 20.14,
   "text": "להתבונן טוב ולהתבונן טוב, אין מקרה."
  },
  {
   "start": 21.08,
   "end": 21.72,
   "text": "כך אז,"
  },
  {
   "start": 22.96,
   "end": 23.66,
   "text": "וגם היום,"
  },
  {
   "start": 25.8,
   "end": 27.46,
   "text": "ישנה אצבע מכוונת"
  },
  {
   "start": 28.46,
   "end": 31.3,
   "text": "שמושכת שם למעלה בחוטים,"
  },
  {
   "start": 32.92,
   "end": 34.4,
   "text": "והכל לרצון השם יתברך."
  },
  {
   "start": 36.18,
   "end": 37.58,
   "text": "שנת 1991,"
  },
  {
   "start": 38.78,
   "end": 39.9,
   "text": "גדוד של מילואים בשמ״פ,"
  },
  {
   "start": 40.74,
   "end": 43.12,
   "text": "בשמ״פ, שירות מילואים פעיל באזור רפיח."
  },
  {
   "start": 47.84,
   "end": 49.96,
   "text": "המגד של הגדוד, סגן אלוף הרב משה הגר,"
  },
  {
   "start": 51.34,
   "end": 52.62,
   "text": "מוציא את הגדוד שלו לאימון."
  },
  {
   "start": 54.02,
   "end": 54.68,
   "text": "הוא יודע שבשמ״פ,"
  },
  {
   "start": 55.52,
   "end": 57.86,
   "text": "באזור רפיח, בשנת 1991,"
  },
  {
   "start": 59.08,
   "end": 64.0,
   "text": "הם יכולים להיתקל אולי במחבלים רצוי שהגדוד ייערך לכך."
  },
  {
   "start": 66.93,
   "end": 68.01,
   "text": "אז הוא מוציא את הגדוד לאימון."
  },
  {
   "start": 68.75,
   "end": 70.41,
   "text": "יש אימון יבש ויש אימון רטוב."
  },
  {
   "start": 71.77,
   "end": 73.99,
   "text": "אימון יבש זה ללא ירי, אימון רטוב זה עם ירי."
  },
  {
   "start": 74.53,
   "end": 75.57,
   "text": "האימון הזה אימון רטוב."
  },
  {
   "start": 76.51,
   "end": 78.23,
   "text": "באזור רפיח"
  },
  {
   "start": 79.61,
   "end": 81.33,
   "text": "אי אפשר לשחק ביבש."
  },
  {
   "start": 84.67,
   "end": 85.33,
   "text": "איזה אימון?"
  },
  {
   "start": 87.74,
   "end": 89.44,
   "text": "סגן אלוף הרב משה הגר מחליט"
  },
  {
   "start": 91.24,
   "end": 98.44,
   "text": "לבצע תרגיל אימון בהיתקלות מול מחבלים שכאילו חתכו את הגדר וכאילו חדרו פנימה."
  },
  {
   "start": 100.7,
   "end": 101.72,
   "text": "ניתנת הוראת תרגיל."
  },
  {
   "start": 103.7,
   "end": 104.3,
   "text": "באמצע הלילה,"
  },
  {
   "start": 105.14,
   "end": 106.28,
   "text": "באמצע הלילה החל התרגיל"
  },
  {
   "start": 107.48,
   "end": 111.12,
   "text": "עם קבלה של כאילו התרעה על חדירת מחבלים."
  },
  {
   "start": 112.04,
   "end": 117.92,
   "text": "בקשר מודיעין התעתרה לחדירת מחבלים והכוחות יוצאים מלשטח."
  },
  {
   "start": 120.33,
   "end": 122.35,
   "text": "מזהים את החדירה."
  },
  {
   "start": 123.89,
   "end": 124.61,
   "text": "מתחילים להיאגף"
  },
  {
   "start": 127.35,
   "end": 128.07,
   "text": "והאימון ממשיך"
  },
  {
   "start": 129.25,
   "end": 129.61,
   "text": "ואז"
  },
  {
   "start": 131.01,
   "end": 133.77,
   "text": "על פי הוראות האימון, על פי הוראות המגד הם מגיעים לאזור"
  },
  {
   "start": 134.77,
   "end": 137.11,
   "text": "שכאילו המחבלים נמצאים שם"
  },
  {
   "start": 137.77,
   "end": 138.73,
   "text": "תנועת מלקחיים"
  },
  {
   "start": 139.55,
   "end": 141.73,
   "text": "והם מתחילים לשטוף את כל האיזור באש."
  },
  {
   "start": 142.39,
   "end": 142.73,
   "text": "אש."
  },
  {
   "start": 143.17,
   "end": 143.91,
   "text": "פצצות תאורה."
  },
  {
   "start": 147.35,
   "end": 152.45,
   "text": "וכל האזור כולו נהיה חגיגת אש ולהבות."
  },
  {
   "start": 154.97,
   "end": 158.65,
   "text": "בתום התרגיל חוזרים כולם עייפים לבסיסם,"
  },
  {
   "start": 159.61,
   "end": 161.15,
   "text": "והתרגיל עבר בהצלחה."
  },
  {
   "start": 172.83,
   "end": 173.25,
   "text": "עד בבוקר,"
  },
  {
   "start": 174.67,
   "end": 175.99,
   "text": "על חוף הים של עזה"
  },
  {
   "start": 178.11,
   "end": 179.61,
   "text": "מתגלות שתי גופות"
  },
  {
   "start": 180.45,
   "end": 181.73,
   "text": "שנפלטו מן הים."
  },
  {
   "start": 183.57,
   "end": 184.83,
   "text": "כשחיילי צה״ל מתקרבים"
  },
  {
   "start": 184.83,
   "end": 192.93,
   "text": "אל אותן גופות ששרועות להן חסרות רוח חיים על חוף הים."
  },
  {
   "start": 193.67,
   "end": 196.89,
   "text": "הן מגלות לצידן אמלח, אמצעי לחימה, נשק,"
  },
  {
   "start": 197.47,
   "end": 199.43,
   "text": "רימונים, מטעני חבלה."
  },
  {
   "start": 203.54,
   "end": 204.32,
   "text": "תעודות זהות"
  },
  {
   "start": 206.92,
   "end": 208.1,
   "text": "של מחבלים מסוריה,"
  },
  {
   "start": 209.04,
   "end": 211.24,
   "text": "שיותר מוחר מתבררות כתעודות זהות מזויפות"
  },
  {
   "start": 211.94,
   "end": 213.14,
   "text": "שרוצות לסבך את סוריה"
  },
  {
   "start": 214.2,
   "end": 215.38,
   "text": "במאבק מול ישראל."
  },
  {
   "start": 216.38,
   "end": 220.16,
   "text": "מתברר שאחד מן המחבלים,"
  },
  {
   "start": 220.92,
   "end": 223.68,
   "text": "משתי המחבלים, הוא קצין בכיר באשף,"
  },
  {
   "start": 224.82,
   "end": 225.8,
   "text": "שיחד עם חברו,"
  },
  {
   "start": 226.76,
   "end": 231.66,
   "text": "בתום חודשים של אימונים יצאו לפעולה כנגד תושבי ישראל."
  },
  {
   "start": 234.76,
   "end": 235.48,
   "text": "הם באו מן הים,"
  },
  {
   "start": 236.64,
   "end": 237.34,
   "text": "ומה שקרה,"
  },
  {
   "start": 238.08,
   "end": 238.88,
   "text": "שבדיוק,"
  },
  {
   "start": 239.7,
   "end": 243.24,
   "text": "בדיוק בזמן בו היו צריכים לצאת מן הים אל החוף."
  },
  {
   "start": 244.8,
   "end": 247.46,
   "text": "אחרי שעות של שחייה בים,"
  },
  {
   "start": 248.4,
   "end": 250.68,
   "text": "היו צריכים לצאת כבר מן הים, להגיע אל החוף."
  },
  {
   "start": 252.0,
   "end": 256.81,
   "text": "לפתע החל התרגיל שהיה בקרבת מקום,"
  },
  {
   "start": 257.65,
   "end": 260.77,
   "text": "והם היו בטוחים שגילו אותם, שזיהו אותם."
  },
  {
   "start": 262.37,
   "end": 263.83,
   "text": "אז לא היה להם רע, הם לא יצאו מהמים,"
  },
  {
   "start": 264.57,
   "end": 266.39,
   "text": "וכך שעות הם לא יוצאים מהמים,"
  },
  {
   "start": 267.07,
   "end": 269.53,
   "text": "והכוחות שלהם עוזבים אותם."
  },
  {
   "start": 270.29,
   "end": 271.15,
   "text": "דש כוח העם,"
  },
  {
   "start": 273.78,
   "end": 275.32,
   "text": "הנשק והכל משך אותם למטה."
  },
  {
   "start": 276.9,
   "end": 278.46,
   "text": "הם עידו את התחושה בגופם וטבעו,"
  },
  {
   "start": 279.34,
   "end": 285.9,
   "text": "וטבעו, ועם ישראל, תושבי ישראל,"
  },
  {
   "start": 286.42,
   "end": 287.62,
   "text": "ישנים בשנתם,"
  },
  {
   "start": 288.02,
   "end": 290.86,
   "text": "ואיש לא יודע שבורא עולם מזיז את החוטים,"
  },
  {
   "start": 291.42,
   "end": 296.94,
   "text": "שבעזרת תרגיל שאף אחד לא יודע נהרגים שתי מחבלים מסוכנים,"
  },
  {
   "start": 297.32,
   "end": 297.98,
   "text": "מאומנים,"
  },
  {
   "start": 298.32,
   "end": 299.8,
   "text": "שהיו בדרך לפיגועי טרור,"
  },
  {
   "start": 300.4,
   "end": 303.58,
   "text": "אולי מהקשים שהייתה צריכה לדעת מדינת ישראל."
  },
  {
   "start": 305.28,
   "end": 311.47,
   "text": "במקרה זה רק מהשם, או תהיות רק מהשם,"
  },
  {
   "start": 312.01,
   "end": 315.55,
   "text": "רק הקדוש ברוך הוא יכול לתפור סיפור נפלא."
  },
  {
   "start": 315.59,
   "end": 351.43,
   "text": "בית פוריק קטן על יד שכם"
  },
  {
   "start": 353.03,
   "end": 355.63,
   "text": "שמסביבו זרועות מערות"
  },
  {
   "start": 356.63,
   "end": 357.47,
   "text": "מערות רבות"
  },
  {
   "start": 358.95,
   "end": 359.67,
   "text": "שחלקן"
  },
  {
   "start": 360.55,
   "end": 366.91,
   "text": "משמשות לעיתים כמסתור לגורמים העוינים את ישראל."
  },
  {
   "start": 371.69,
   "end": 378.49,
   "text": "לא פעם ולא פעמיים יוצאים יחידות מובחרות של צה״ל למארבים אולי ייתקלו במחבלים"
  },
  {
   "start": 380.11,
   "end": 381.87,
   "text": "וכך כוח של אחת הסיירות"
  },
  {
   "start": 382.87,
   "end": 386.77,
   "text": "מקפל מארב של שעות על שעות על שעות"
  },
  {
   "start": 387.35,
   "end": 389.07,
   "text": "של מארב ללא תוצאות"
  },
  {
   "start": 389.77,
   "end": 391.59,
   "text": "וחוזר אט אט לבסיסו."
  },
  {
   "start": 396.94,
   "end": 398.1,
   "text": "הצוותים היו מתוסכלים"
  },
  {
   "start": 404.81,
   "end": 407.25,
   "text": "של רביצה שם במארב"
  },
  {
   "start": 407.89,
   "end": 408.83,
   "text": "וללא תוצאות."
  },
  {
   "start": 410.53,
   "end": 410.95,
   "text": "בדרך,"
  },
  {
   "start": 412.09,
   "end": 414.47,
   "text": "בדרך עלתה בליבו של מפקד הכוח מחשבה"
  },
  {
   "start": 415.29,
   "end": 416.47,
   "text": "לנצל את תוואי השטח,"
  },
  {
   "start": 417.25,
   "end": 418.61,
   "text": "את הגבעות שמסביב,"
  },
  {
   "start": 419.53,
   "end": 421.49,
   "text": "לערוך מטווח ירי על אחת הגבעות."
  },
  {
   "start": 422.67,
   "end": 429.11,
   "text": "כך גם יהיה אפשר לפרוק את ההצטברות של התסכול של שעות המערב חסר התוצאות."
  },
  {
   "start": 430.59,
   "end": 433.11,
   "text": "ככה שהחיילים יתפרקו גם וגם יטבחו."
  },
  {
   "start": 434.57,
   "end": 437.81,
   "text": "ואז הוא מחליט באמצע הדרך לעצור לעשות מטווח על אחת הגבעות."
  },
  {
   "start": 440.18,
   "end": 443.52,
   "text": "וכל אחד מהחיילים ניגש בתורו והחל מתווח"
  },
  {
   "start": 445.04,
   "end": 446.18,
   "text": "אל הגבעה שממול."
  },
  {
   "start": 446.62,
   "end": 450.62,
   "text": "הוא מנסה לפגוע בכל מיני מטרות מאולתרות. פה זה איזה חבית, פה זה איזה פחית, פה אבן."
  },
  {
   "start": 451.28,
   "end": 453.74,
   "text": "מה שהוא תופס, מנסה לראות לכוון לכיוון."
  },
  {
   "start": 454.28,
   "end": 456.8,
   "text": "תראו אותו אומר, אני מנסה לרעות על האבן ואני מנסה לפגוע."
  },
  {
   "start": 462.26,
   "end": 462.64,
   "text": "אז לפתע,"
  },
  {
   "start": 463.62,
   "end": 464.88,
   "text": "לפתע נשמעות צעקות."
  },
  {
   "start": 466.28,
   "end": 466.7,
   "text": "צעקות,"
  },
  {
   "start": 467.34,
   "end": 468.56,
   "text": "מהעבר השני של הגבעה."
  },
  {
   "start": 470.68,
   "end": 472.18,
   "text": "אי אפשר לטעות צעקות של אדם."
  },
  {
   "start": 473.5,
   "end": 476.74,
   "text": "הכוח החל מתארגן בינה אל עבר מקור הצעקות."
  },
  {
   "start": 481.83,
   "end": 483.71,
   "text": "הם מגיעים אל עברה השני של הגבעה."
  },
  {
   "start": 485.11,
   "end": 487.21,
   "text": "ומאברה השני של הגבעה נתגלה להם."
  },
  {
   "start": 488.47,
   "end": 488.87,
   "text": "רועה,"
  },
  {
   "start": 489.49,
   "end": 490.23,
   "text": "רועה הערבי,"
  },
  {
   "start": 491.01,
   "end": 492.19,
   "text": "אחוז בפחד ובהלה."
  },
  {
   "start": 492.77,
   "end": 494.47,
   "text": "כולו רועד, אל תראו."
  },
  {
   "start": 495.15,
   "end": 496.51,
   "text": "אל תראו, בבקשה, אל תראו בי."
  },
  {
   "start": 496.93,
   "end": 501.41,
   "text": "אני אספר לכם הכל, אני אספר לכם הכל. אל תראו בי, בבקשה. לא לראות, לא לראות."
  },
  {
   "start": 502.33,
   "end": 503.71,
   "text": "אני נכנע, אני מספר הכל."
  },
  {
   "start": 508.25,
   "end": 509.03,
   "text": "והוא סיפר,"
  },
  {
   "start": 511.54,
   "end": 513.36,
   "text": "הרואה התמים לכאורה,"
  },
  {
   "start": 514.82,
   "end": 515.7,
   "text": "שהיה משוכנע"
  },
  {
   "start": 516.72,
   "end": 519.0,
   "text": "שגילו אותו, שירו לעברו,"
  },
  {
   "start": 520.32,
   "end": 522.98,
   "text": "היה שליח ומקשר בין חוליות טרור,"
  },
  {
   "start": 523.98,
   "end": 529.08,
   "text": "ובידו נמצא מכתב עם הוראות העברת נשק, רימונים,"
  },
  {
   "start": 530.12,
   "end": 533.1,
   "text": "למחבל שנמצא באזור."
  },
  {
   "start": 534.12,
   "end": 535.52,
   "text": "מחבל שלא ידעו שהוא מחבל,"
  },
  {
   "start": 536.6,
   "end": 539.08,
   "text": "ואותו מחבל נעצר באותו לילה."
  },
  {
   "start": 540.98,
   "end": 542.14,
   "text": "ובחקירת השב״כ,"
  },
  {
   "start": 543.06,
   "end": 546.16,
   "text": "מאותו מחבל נחשפה חוליה שלמה,"
  },
  {
   "start": 546.72,
   "end": 547.68,
   "text": "חוליית בית פוריק."
  },
  {
   "start": 552.6,
   "end": 556.98,
   "text": "ומחוליית בית פוריק זה עוד לא נגמר, גולגל שטיח כלשון השב״כ."
  },
  {
   "start": 557.88,
   "end": 562.42,
   "text": "משם נחשפה עוד חוליה שנקראה חוליית שכם."
  },
  {
   "start": 565.54,
   "end": 568.02,
   "text": "ושנבין, אלה היו חוליות טרור מאומנות,"
  },
  {
   "start": 568.86,
   "end": 571.98,
   "text": "חוליות טרור רצחניות שאומנו בסוריה"
  },
  {
   "start": 573.72,
   "end": 576.0,
   "text": "וחדרו חזרה חזרו חזרה לארץ."
  },
  {
   "start": 577.14,
   "end": 578.0,
   "text": "לא ידעו עליהם,"
  },
  {
   "start": 580.82,
   "end": 582.8,
   "text": "והם היו אמורים בקרוב לצאת לפעילות."
  },
  {
   "start": 583.7,
   "end": 584.86,
   "text": "והלכידה שלהם כך,"
  },
  {
   "start": 587.94,
   "end": 589.5,
   "text": "בצורה כל כך מדהימה,"
  },
  {
   "start": 592.8,
   "end": 594.14,
   "text": "מנעה שפיכת דם רב."
  },
  {
   "start": 595.14,
   "end": 596.22,
   "text": "פשוט כוח שיצא,"
  },
  {
   "start": 597.94,
   "end": 598.86,
   "text": "החל לעשות מטווח."
  },
  {
   "start": 601.0,
   "end": 602.68,
   "text": "ומהמטווח תראו מה יוצא."
  },
  {
   "start": 606.46,
   "end": 608.04,
   "text": "אפשר רק לומר דבר אחד."
  },
  {
   "start": 608.96,
   "end": 611.62,
   "text": "אתם יודעים, אפשר לדעת יותר מזה, אפשר להגיד הכל."
  },
  {
   "start": 612.56,
   "end": 613.48,
   "text": "אבל דבר אחד ברור,"
  },
  {
   "start": 616.23,
   "end": 616.87,
   "text": "אין כאן מקרה."
  },
  {
   "start": 618.17,
   "end": 621.25,
   "text": "יש כאן יד מכוונת ששומרת על עם ישראל."
  },
  {
   "start": 623.39,
   "end": 626.59,
   "text": "לא פלא שראש השב״כ מעל במת הכנסת מכריז"
  },
  {
   "start": 627.59,
   "end": 630.63,
   "text": "עוזר לנו הקדוש ברוך הוא, עוזר לנו אלוקים."
  },
  {
   "start": 631.95,
   "end": 634.31,
   "text": "מה היינו עושים ללא עזרה משמיים?"
  },
  {
   "start": 635.23,
   "end": 635.53,
   "text": "פלא,"
  },
  {
   "start": 642.61,
   "end": 645.37,
   "text": "רק אנחנו צריכים להתחזק באמונה שלנו, בהשגחה."
  },
  {
   "start": 646.03,
   "end": 648.71,
   "text": "לדעת שהכל, אבל הכל ממנו יתברך."
  },
  {
   "start": 649.99,
   "end": 653.99,
   "text": "לדעת שמה שבו העולם רוצה מאיתנו זה אותו עם ישראל"
  },
  {
   "start": 654.67,
   "end": 655.81,
   "text": "שיצא ממצרים."
  },
  {
   "start": 656.47,
   "end": 659.13,
   "text": "זכרתי לך חסד נעורייך, אהבת כלולותייך."
  },
  {
   "start": 659.87,
   "end": 663.37,
   "text": "לכתך אחריי במדבר, גם כשקשה ללכת אחרי הקדוש ברוך הוא."
  },
  {
   "start": 664.05,
   "end": 666.49,
   "text": "זה מה שאני זוכר אתכם, עם ישראל, ככה אני זוכר אתכם."
  },
  {
   "start": 667.95,
   "end": 673.41,
   "text": "זה כמו אבא שמחכה לילד שלו, זוכר את הילד שלו, החייל שלו התנהג טוב, ככה אני מכיר אותך, כילד טוב, אל תעשה את זה."
  },
  {
   "start": 673.75,
   "end": 676.03,
   "text": "ככה הקדוש ברוך הוא זוכר אותנו, נשמות טובות,"
  },
  {
   "start": 676.55,
   "end": 677.65,
   "text": "ילדים נפלאים שלו."
  },
  {
   "start": 678.21,
   "end": 679.03,
   "text": "בואו תחזרו הביתה,"
  },
  {
   "start": 679.69,
   "end": 680.41,
   "text": "בואו תתאחדו,"
  },
  {
   "start": 681.93,
   "end": 683.15,
   "text": "בואו תתקרבו אליי באמת."
  }
 ]
}