{
 "disc": "37ת- פורים שמחת האמונה",
 "track": "Track04",
 "duration": 872.136,
 "segments": [
  {
   "start": 2.46,
   "end": 2.9,
   "text": "פורים,"
  },
  {
   "start": 3.5,
   "end": 4.3,
   "text": "חג מאוד מיוחד."
  },
  {
   "start": 6.14,
   "end": 8.12,
   "text": "חג שכולו אמונה, כולו השגחה."
  },
  {
   "start": 11.92,
   "end": 12.62,
   "text": "זה היה כל המאבק"
  },
  {
   "start": 13.92,
   "end": 16.56,
   "text": "בפורים בין היהודים לזרע עמלק."
  },
  {
   "start": 18.69,
   "end": 19.61,
   "text": "וזה לא אז היה,"
  },
  {
   "start": 20.49,
   "end": 22.01,
   "text": "זה כל שנה גם היום."
  },
  {
   "start": 22.85,
   "end": 24.09,
   "text": "עד היום זה המאבק."
  },
  {
   "start": 25.93,
   "end": 26.75,
   "text": "אתם יודעים, כשאסתר,"
  },
  {
   "start": 27.59,
   "end": 31.05,
   "text": "אסתר שמעה שמרדכי ועם ישראל בצער,"
  },
  {
   "start": 31.75,
   "end": 35.59,
   "text": "היא קראה לשומר שלה, הסריס שהיה אחראי עליה, לשומר ראש שלה ואמרה לו,"
  },
  {
   "start": 35.71,
   "end": 36.21,
   "text": "קראו לו הטח."
  },
  {
   "start": 37.19,
   "end": 37.67,
   "text": "אמרה לו,"
  },
  {
   "start": 38.27,
   "end": 39.11,
   "text": "לך למרדכי."
  },
  {
   "start": 39.91,
   "end": 41.65,
   "text": "לך למרדכי, תברר על מה, מה קרה?"
  },
  {
   "start": 42.41,
   "end": 42.93,
   "text": "על מה הוא עצוב?"
  },
  {
   "start": 43.63,
   "end": 45.23,
   "text": "על מה כל הרעש וכל המהומה?"
  },
  {
   "start": 46.93,
   "end": 47.53,
   "text": "מרדכי,"
  },
  {
   "start": 48.19,
   "end": 49.13,
   "text": "כשהטח מגיע אליו,"
  },
  {
   "start": 51.41,
   "end": 52.45,
   "text": "הוא למעשה שולח"
  },
  {
   "start": 53.95,
   "end": 56.39,
   "text": "יחד עם הטח קוד צופן"
  },
  {
   "start": 56.95,
   "end": 58.77,
   "text": "שרק אסתר אמורה להבין."
  },
  {
   "start": 59.43,
   "end": 61.17,
   "text": "אומרת המגילה, ויאמר מרדכי להטח,"
  },
  {
   "start": 61.79,
   "end": 64.61,
   "text": "ויאמר מרדכי להטח את כל אשר קרה הוא."
  },
  {
   "start": 65.19,
   "end": 65.95,
   "text": "אומר המדרש,"
  },
  {
   "start": 66.73,
   "end": 72.95,
   "text": "אמר מרדכי להתך לך תאמר לאסתר בן בנו של קראו בעלינו."
  },
  {
   "start": 74.25,
   "end": 75.01,
   "text": "ככה תגיד לה."
  },
  {
   "start": 75.91,
   "end": 77.63,
   "text": "אטח אומר, מה? אני לא מבין."
  },
  {
   "start": 78.37,
   "end": 78.83,
   "text": "אל תבין."
  },
  {
   "start": 79.55,
   "end": 80.21,
   "text": "לך תגיד לה"
  },
  {
   "start": 80.93,
   "end": 82.03,
   "text": "את הסיסמה הזאת,"
  },
  {
   "start": 82.89,
   "end": 85.01,
   "text": "בן בנו של קראו בעלינו."
  },
  {
   "start": 89.73,
   "end": 90.81,
   "text": "והוא הולך אומר את זה לאסתר."
  },
  {
   "start": 92.05,
   "end": 93.65,
   "text": "ואסתר, כשהיא שומעת,"
  },
  {
   "start": 94.63,
   "end": 95.29,
   "text": "היא מבינה."
  },
  {
   "start": 95.97,
   "end": 97.23,
   "text": "היא מבינה את עוצמת הדברים."
  },
  {
   "start": 100.22,
   "end": 102.28,
   "text": "ואז היא מתמלאת כולה צער וחרדה."
  },
  {
   "start": 103.52,
   "end": 105.0,
   "text": "מה זה בן בנו של קרהו?"
  },
  {
   "start": 106.22,
   "end": 106.74,
   "text": "מי זה קרהו?"
  },
  {
   "start": 107.74,
   "end": 110.54,
   "text": "זה עמלק, אשר קרחה בדרך."
  },
  {
   "start": 111.62,
   "end": 114.62,
   "text": "עוד פעם הגיעה מלחמה עם העמלק, אשר קרהו."
  },
  {
   "start": 115.62,
   "end": 121.74,
   "text": "עמלק ניסה לומר לכל העולם ולעם ישראל, כל מה שקורה בעולם זה במקרה."
  },
  {
   "start": 122.82,
   "end": 124.44,
   "text": "גם עשרת המכות זה הכל במקרה."
  },
  {
   "start": 124.76,
   "end": 126.6,
   "text": "בקיעת ים סוף הכל הכל במקרה."
  },
  {
   "start": 129.35,
   "end": 131.35,
   "text": "כוח המקרה עמלק בעלינו."
  },
  {
   "start": 133.45,
   "end": 135.17,
   "text": "זה בן בנו של עמלק,"
  },
  {
   "start": 137.81,
   "end": 141.05,
   "text": "ואז אסתר בחרדה כי היא יודעת שאחד מהדברים הקשים ביותר"
  },
  {
   "start": 141.63,
   "end": 143.01,
   "text": "זה למחוק מהאדם"
  },
  {
   "start": 144.37,
   "end": 147.37,
   "text": "את הקליפה הזאת שנקראת"
  },
  {
   "start": 148.25,
   "end": 149.57,
   "text": "מקרה עמלק."
  },
  {
   "start": 151.82,
   "end": 156.0,
   "text": "בואו נראה איך האידיאולוגיה הזאת של עמלק"
  },
  {
   "start": 156.72,
   "end": 158.76,
   "text": "עבדה ועובדת אז והיום גם,"
  },
  {
   "start": 160.92,
   "end": 165.24,
   "text": "וכך הוא שולח למאה עשרים ושבע מדינות איגרת. אני אקריא לכם את האיגרת ששלח אמן."
  },
  {
   "start": 166.5,
   "end": 168.16,
   "text": "הקדמה בהתחלה מיועצי המלך,"
  },
  {
   "start": 168.78,
   "end": 171.9,
   "text": "מיועצי אמן, היועצים שלו, יועצי אמן שעבדו עם אמן."
  },
  {
   "start": 172.76,
   "end": 173.22,
   "text": "ותראו,"
  },
  {
   "start": 174.88,
   "end": 175.76,
   "text": "בואו נקרא ביחד"
  },
  {
   "start": 176.8,
   "end": 179.32,
   "text": "את האיגרת של אמן, ואולי מזה נבין כל כך הרבה."
  },
  {
   "start": 180.12,
   "end": 180.82,
   "text": "בואו, תקשיבו טוב."
  },
  {
   "start": 182.04,
   "end": 184.74,
   "text": "עכשיו ככה כותבים, מתחילת המכתב כותבים יועצי אמלך."
  },
  {
   "start": 186.0,
   "end": 188.62,
   "text": "יוודא לכם שאדם אחד יש בינינו,"
  },
  {
   "start": 189.6,
   "end": 190.74,
   "text": "ולא ממקומנו הוא,"
  },
  {
   "start": 191.34,
   "end": 192.72,
   "text": "אלא מזרע המלוכה"
  },
  {
   "start": 193.58,
   "end": 194.8,
   "text": "ומזרעו של עמלקו."
  },
  {
   "start": 195.5,
   "end": 196.6,
   "text": "אפשר לשאול שעמלקה היא מלך גדול."
  },
  {
   "start": 198.02,
   "end": 199.3,
   "text": "ומגדולי הדור הוא,"
  },
  {
   "start": 200.16,
   "end": 200.92,
   "text": "והמן שמו."
  },
  {
   "start": 202.72,
   "end": 208.32,
   "text": "ושאל ממנו שאלה קטנה וקלה על עם אחד"
  },
  {
   "start": 209.64,
   "end": 210.7,
   "text": "אשר יש בינינו."
  },
  {
   "start": 212.4,
   "end": 213.04,
   "text": "אצל הגויים,"
  },
  {
   "start": 214.72,
   "end": 215.88,
   "text": "לעשות השמדת עם,"
  },
  {
   "start": 216.4,
   "end": 218.9,
   "text": "לרצוח שישה מיליון, מיליונים,"
  },
  {
   "start": 219.62,
   "end": 221.62,
   "text": "זו שאלה קטנה וקלה."
  },
  {
   "start": 225.66,
   "end": 226.54,
   "text": "שאלו פעם את ויזל,"
  },
  {
   "start": 226.92,
   "end": 230.14,
   "text": "זה הלוחם בנאצים שהוא בעצמו היה קורבן שלה בשואה."
  },
  {
   "start": 230.82,
   "end": 231.36,
   "text": "הוא היה בשואה,"
  },
  {
   "start": 232.28,
   "end": 235.84,
   "text": "סבל כל כך הרבה, אמרו לו, תגיד לי, מה במחנות באמצע הסיוט הנורא הזה?"
  },
  {
   "start": 237.3,
   "end": 239.16,
   "text": "מה, מה, מה, מה המחשבה ככה?"
  },
  {
   "start": 239.8,
   "end": 241.48,
   "text": "מה היית רוצה? מה אז רצית כל כך?"
  },
  {
   "start": 242.96,
   "end": 244.3,
   "text": "מה הדמיון שלך היה אומר?"
  },
  {
   "start": 244.96,
   "end": 245.56,
   "text": "אמר ויזל,"
  },
  {
   "start": 246.58,
   "end": 247.52,
   "text": "אני אמרתי לעצמי,"
  },
  {
   "start": 249.62,
   "end": 251.18,
   "text": "רק כשהעולם ידע מה קורה פה,"
  },
  {
   "start": 252.0,
   "end": 254.84,
   "text": "רק אם הייתי יכול להראות לכל העולם היודעים מה קורה פה."
  },
  {
   "start": 256.44,
   "end": 257.02,
   "text": "אמרו לו, נו."
  },
  {
   "start": 258.9,
   "end": 260.34,
   "text": "כמעט בכה ויזל ואמר,"
  },
  {
   "start": 260.88,
   "end": 262.62,
   "text": "וכשהשתחררתי שנלמרה השואה,"
  },
  {
   "start": 263.74,
   "end": 265.0,
   "text": "הבנתי שכולם ידעו."
  },
  {
   "start": 267.06,
   "end": 269.46,
   "text": "אני שנים חי בהרגשיי, רק אם ידעו,"
  },
  {
   "start": 269.92,
   "end": 273.24,
   "text": "הם לא יכלו לשתוק, וכולם ידעו ושתקו."
  },
  {
   "start": 275.63,
   "end": 275.97,
   "text": "אז גם,"
  },
  {
   "start": 277.07,
   "end": 277.49,
   "text": "גם אז,"
  },
  {
   "start": 278.39,
   "end": 279.99,
   "text": "שאל ממנו שאלה קטנה."
  },
  {
   "start": 280.33,
   "end": 281.05,
   "text": "וכלה."
  },
  {
   "start": 282.59,
   "end": 287.27,
   "text": "לרצוח אנשים זה לא צריך לעשות רעש מלרצוח תינוקות ונשים. לא, לא צריך לרצוח."
  },
  {
   "start": 288.37,
   "end": 289.87,
   "text": "קטנה וכלה על עם אחד."
  },
  {
   "start": 291.61,
   "end": 292.31,
   "text": "עכשיו, מי זה העם?"
  },
  {
   "start": 293.15,
   "end": 293.65,
   "text": "בואו נשמע."
  },
  {
   "start": 294.59,
   "end": 296.93,
   "text": "העם הזה נבזה מכל העמים. הם כבר יודעים."
  },
  {
   "start": 297.63,
   "end": 300.05,
   "text": "הם עשו מבחן פסיכומטרי."
  },
  {
   "start": 300.65,
   "end": 301.85,
   "text": "נבזה מכל העמים,"
  },
  {
   "start": 302.41,
   "end": 306.77,
   "text": "ודעתם גסה עליהם. הוא גם נבזה מכל העמים, הכי בזוי, וגם הוא גאוותן."
  },
  {
   "start": 307.19,
   "end": 308.05,
   "text": "קצת סותר,"
  },
  {
   "start": 308.63,
   "end": 309.95,
   "text": "אבל בתקשורת,"
  },
  {
   "start": 310.69,
   "end": 311.71,
   "text": "אז והיום אין בעיה."
  },
  {
   "start": 312.77,
   "end": 314.05,
   "text": "חפצים ברעתנו."
  },
  {
   "start": 314.73,
   "end": 318.31,
   "text": "הם אומרים שעם ישראל נבזה ודעתם גסה והם חפצים ברעתנו."
  },
  {
   "start": 319.19,
   "end": 320.09,
   "text": "ועם ישראל רוצה ל..."
  },
  {
   "start": 320.61,
   "end": 321.05,
   "text": "מסכנים."
  },
  {
   "start": 321.91,
   "end": 324.29,
   "text": "עם ישראל רודף את כל אומות העולם. 127 מדינות."
  },
  {
   "start": 325.55,
   "end": 328.65,
   "text": "וקללת המלך שגורה בפיהם. והם כל יום מקללים את המלך."
  },
  {
   "start": 332.77,
   "end": 334.31,
   "text": "בואו ראו, ואז הנה תראו דוגמאות."
  },
  {
   "start": 335.75,
   "end": 336.43,
   "text": "תראו איזה דוגמאות."
  },
  {
   "start": 338.17,
   "end": 342.47,
   "text": "ככה האמן עכשיו מתחיל לכתוב. בואו תראו מאותו עני, איזה מסכן,"
  },
  {
   "start": 342.55,
   "end": 343.91,
   "text": "עני ואביון פרעה,"
  },
  {
   "start": 344.89,
   "end": 352.29,
   "text": "השליט של האימפריה הפרעונית, פרעה, אותו עני שבאו וקיבלם בסבר פנים יפות,"
  },
  {
   "start": 353.29,
   "end": 355.15,
   "text": "וכיבדם בטוב ארצו,"
  },
  {
   "start": 356.01,
   "end": 357.81,
   "text": "והאכיל אותם בשני הרעב."
  },
  {
   "start": 359.01,
   "end": 365.59,
   "text": "לא יוסף שגשג ועשה מהפך כלכלי בכל מצרים והציל את מצרים והפכת לאימפריה, לא."
  },
  {
   "start": 366.19,
   "end": 368.15,
   "text": "פרעה עשה טובה לכולם,"
  },
  {
   "start": 369.01,
   "end": 370.75,
   "text": "לא עם ישראל הציל את מצרים."
  },
  {
   "start": 373.75,
   "end": 376.83,
   "text": "ואז פלטרין ארמונות היו לו לבנות, והיו בונים שם."
  },
  {
   "start": 377.29,
   "end": 378.61,
   "text": "הבנתם? כלומר, הם..."
  },
  {
   "start": 379.19,
   "end": 381.01,
   "text": "עם ישראל היו מחוסרי עבודה,"
  },
  {
   "start": 381.41,
   "end": 385.05,
   "text": "ובאו המצרים ונתנו להם ריפוי בעיסוק במקצועות נפלאים."
  },
  {
   "start": 387.78,
   "end": 389.56,
   "text": "לא היו עבדים, זה לא עבדות,"
  },
  {
   "start": 392.33,
   "end": 392.95,
   "text": "זה לא רצח,"
  },
  {
   "start": 393.91,
   "end": 394.19,
   "text": "זה..."
  },
  {
   "start": 395.01,
   "end": 396.93,
   "text": "בנו ארמונות, היו קבלנים."
  },
  {
   "start": 398.01,
   "end": 399.43,
   "text": "ובכל זאת לא יכלו לו."
  },
  {
   "start": 399.99,
   "end": 401.29,
   "text": "ועוד באו אליו בטענה."
  },
  {
   "start": 401.87,
   "end": 402.89,
   "text": "ראיתם איזה חצופים?"
  },
  {
   "start": 405.14,
   "end": 407.78,
   "text": "באו אליו בטענה, רצינו ללכת לשלושה ימים."
  },
  {
   "start": 408.8,
   "end": 411.78,
   "text": "אם הם כל כך לא בסדר, תשמחו שהם רוצים ללכת, מה אכפת לכם?"
  },
  {
   "start": 415.06,
   "end": 422.1,
   "text": "אם הוא עם כל כך נבזה ומנצל ועושים לו טובות, אז כשהוא רוצה ללכת, תשלח אותו, תגידו, לך, לך מפה."
  },
  {
   "start": 423.66,
   "end": 426.78,
   "text": "ועוד באו אליו בטענה, רצוננו ללכת לשלושה ימים."
  },
  {
   "start": 427.9,
   "end": 433.4,
   "text": "ורצוננו שתשאיל לנו את כספך וזהבך. ומה עם המשכורות של כל השנים שהיו צריכים לשלם להם? זה לא, מה פתאום."
  },
  {
   "start": 434.42,
   "end": 436.56,
   "text": "וישאילם כספם וזהבם."
  },
  {
   "start": 437.52,
   "end": 439.14,
   "text": "איזה, איזה טוב לב."
  },
  {
   "start": 439.22,
   "end": 442.86,
   "text": "וככה מרצונו החופשי, איזה אמון הדדי, אתם רואים מה זה, זה אני מוסיף."
  },
  {
   "start": 444.28,
   "end": 447.36,
   "text": "וישאילם כספם וזהבם, איזה אמון, איזה טוב לב."
  },
  {
   "start": 448.34,
   "end": 450.58,
   "text": "ונשאו כל אחד מהם מספר חמורים,"
  },
  {
   "start": 451.22,
   "end": 455.58,
   "text": "וינצלו את כל טוב מצרים, וברחו, ברחו משם."
  },
  {
   "start": 457.66,
   "end": 463.14,
   "text": "מה עם פרעה שזעק כל הלילה, משה תוציא אותם, צאו מפה במכת בחור, או צאו, צאו, ומשה אומר לו, לא, אנחנו נחכה עד הבוקר."
  },
  {
   "start": 465.1,
   "end": 465.98,
   "text": "אצלם זה לא נחשב,"
  },
  {
   "start": 467.4,
   "end": 469.1,
   "text": "בתקשורת של אמן אז והיום."
  },
  {
   "start": 471.47,
   "end": 473.85,
   "text": "ראה פרעה שכך, ממשיך אמן לכתוב,"
  },
  {
   "start": 474.41,
   "end": 475.21,
   "text": "ככה אמן כתב להם."
  },
  {
   "start": 476.01,
   "end": 478.03,
   "text": "ראה פרעה שכך, היא יצאה לרדוף אחריהם."
  },
  {
   "start": 478.83,
   "end": 481.07,
   "text": "להשיב את ממונו. איזה חוש צדק מפותח."
  },
  {
   "start": 482.35,
   "end": 484.57,
   "text": "היה ביניהם איש אחד, ושמו משה בן עמרם."
  },
  {
   "start": 485.03,
   "end": 485.81,
   "text": "סתם איזה איש אחד."
  },
  {
   "start": 487.15,
   "end": 487.95,
   "text": "ובכשפיו,"
  },
  {
   "start": 488.89,
   "end": 494.39,
   "text": "לא בצדקות שלו, לא בעזרת השם, מה פתאום? לא להגיד בעזרת השם, למחוק את העזרת השם מכל המסמכים הצבאיים, לא."
  },
  {
   "start": 494.97,
   "end": 497.17,
   "text": "ובכשפיו נטל מקל אחד."
  },
  {
   "start": 498.01,
   "end": 503.05,
   "text": "המן לא רושם ש... מקל אחד, סתם מקל, לא מקל שרשום עליו את שם השם."
  },
  {
   "start": 503.43,
   "end": 505.27,
   "text": "חס וחלילה. לא להזכיר את שם השם חס וחלילה."
  },
  {
   "start": 506.61,
   "end": 507.29,
   "text": "הכל במקרה."
  },
  {
   "start": 509.11,
   "end": 509.99,
   "text": "נטל מקל אחד"
  },
  {
   "start": 511.23,
   "end": 512.17,
   "text": "ולחש עליו"
  },
  {
   "start": 513.77,
   "end": 514.79,
   "text": "והיכה בו את הים."
  },
  {
   "start": 515.31,
   "end": 517.65,
   "text": "נתן מכות לים עד שהים נחרב."
  },
  {
   "start": 519.94,
   "end": 521.64,
   "text": "ונכנסו כולם ביבשה בתוך הים"
  },
  {
   "start": 522.72,
   "end": 524.88,
   "text": "ועברו כולם ואיני יודע במה הם עברו."
  },
  {
   "start": 525.68,
   "end": 527.5,
   "text": "הוא לא יודע. אם אתה לא יודע מה אתה רושם, אתה לא יודע."
  },
  {
   "start": 528.38,
   "end": 528.86,
   "text": "אז מה אתה מספר?"
  },
  {
   "start": 529.78,
   "end": 532.32,
   "text": "לא, אבל זה במקרה, איני יודע. אני לא יודע כלום, אבל הכל במקרה."
  },
  {
   "start": 533.42,
   "end": 535.7,
   "text": "עכשיו, כיוון שממשיך המן, כיוון שראה פרעה,"
  },
  {
   "start": 536.4,
   "end": 538.18,
   "text": "נכנס אחריהם להשיב את ממונו."
  },
  {
   "start": 539.08,
   "end": 541.7,
   "text": "ואיני יודע במה דחפו אותו בתוך הים,"
  },
  {
   "start": 542.14,
   "end": 544.32,
   "text": "וטבעו בכל חילו בתוך הים."
  },
  {
   "start": 545.8,
   "end": 549.64,
   "text": "ולא, זכרו את הטובה שעשה להם, כותב המן."
  },
  {
   "start": 550.66,
   "end": 552.76,
   "text": "ואני לא יודע, אני לא יודע, לא יודע."
  },
  {
   "start": 553.24,
   "end": 556.38,
   "text": "תגיד הקדוש ברוך הוא, תגיד נס, לא, אני לא יודע."
  },
  {
   "start": 557.68,
   "end": 558.16,
   "text": "במקרה."
  },
  {
   "start": 560.24,
   "end": 563.12,
   "text": "ולא זכו את הטובה הגדולה שפרעה עשה. איזה טובה."
  },
  {
   "start": 563.54,
   "end": 564.98,
   "text": "בגלל זה הוא רדף אחריהם רוב הטובה."
  },
  {
   "start": 566.62,
   "end": 566.9,
   "text": "ועוד,"
  },
  {
   "start": 567.72,
   "end": 569.98,
   "text": "מה עשו לעמלק אבי אבא, כך כותב המן,"
  },
  {
   "start": 570.5,
   "end": 572.14,
   "text": "בשעה שבא להילחם עימם?"
  },
  {
   "start": 573.14,
   "end": 575.68,
   "text": "היה לאותו משה תלמיד אחד ויהושע בן נון שמו,"
  },
  {
   "start": 576.2,
   "end": 578.82,
   "text": "והיה אכזרי עד מאוד, ולא היו לו רחמים."
  },
  {
   "start": 579.68,
   "end": 580.12,
   "text": "אתם מבינים?"
  },
  {
   "start": 580.82,
   "end": 587.26,
   "text": "המן רושם, עמלק, הוא רושם, מה עשו לעמלק? שבא להילחם עימם. כלומר, הוא רושם, עמלק בא להילחם עם ישראל,"
  },
  {
   "start": 588.06,
   "end": 588.8,
   "text": "ומי האכזרי?"
  },
  {
   "start": 589.14,
   "end": 589.78,
   "text": "יהושע בן נון."
  },
  {
   "start": 591.6,
   "end": 592.56,
   "text": "וכולם מקבלים את זה."
  },
  {
   "start": 594.62,
   "end": 598.32,
   "text": "אמר לו משה ליהושע, ממשיך המאן וכותב, בחר לנו אנשים וצא להילחם בעמלק."
  },
  {
   "start": 599.7,
   "end": 600.66,
   "text": "ואיני יודע,"
  },
  {
   "start": 601.32,
   "end": 602.36,
   "text": "אותם אנשים שבחר,"
  },
  {
   "start": 603.04,
   "end": 606.94,
   "text": "האם מבעלי כשפים הם או גיבורי מלחמה? עוד פעם, אין הקדוש ברוך הוא, אני לא יודע."
  },
  {
   "start": 607.94,
   "end": 608.88,
   "text": "מה עשה אותו משה?"
  },
  {
   "start": 609.74,
   "end": 610.4,
   "text": "ממשיך המאן,"
  },
  {
   "start": 611.0,
   "end": 611.78,
   "text": "נטל מקל,"
  },
  {
   "start": 612.82,
   "end": 615.74,
   "text": "מקל בידו, ואיני יודע מה עשה בו. תראו כמה הוא לא יודע."
  },
  {
   "start": 618.06,
   "end": 620.8,
   "text": "וכיוון שבא עליהם, איני יודע מה לחש עליהם"
  },
  {
   "start": 622.88,
   "end": 624.34,
   "text": "ורפו ידיהם ונפלו לפניהם."
  },
  {
   "start": 624.74,
   "end": 625.1,
   "text": "הוא לא יודע."
  },
  {
   "start": 627.84,
   "end": 629.6,
   "text": "באו על סיחון ועוגי, בורא ארצנו,"
  },
  {
   "start": 630.66,
   "end": 632.4,
   "text": "שאין כל ברירה יכולה לעמוד בפניהם,"
  },
  {
   "start": 632.92,
   "end": 635.4,
   "text": "ואיני יודע במה הרגו אותם."
  },
  {
   "start": 636.66,
   "end": 639.1,
   "text": "באו עליהם מלכי מדיין, ואיני יודע במה הרגו."
  },
  {
   "start": 640.06,
   "end": 640.48,
   "text": "הבנתם?"
  },
  {
   "start": 640.86,
   "end": 644.44,
   "text": "המן יודע הכל, הוא יודע קריעת ים סוף, יודע מלחמת סיחון, סיחון ועוגי, מלחמת עמלק."
  },
  {
   "start": 645.02,
   "end": 645.58,
   "text": "הכל הוא יודע."
  },
  {
   "start": 646.32,
   "end": 647.66,
   "text": "אבל איך זה קרה? אני לא יודע."
  },
  {
   "start": 648.12,
   "end": 649.4,
   "text": "אני לא יודע, הכל, הכל במקרה."
  },
  {
   "start": 650.18,
   "end": 651.72,
   "text": "אך אז, גם עכשיו."
  },
  {
   "start": 652.58,
   "end": 656.1,
   "text": "אם הייתי שואל את המן של היום, תגיד לי, מה אתה אומר על עם ישראל?"
  },
  {
   "start": 657.12,
   "end": 662.76,
   "text": "הוא אומר לי, תשמע, 3,300 שנה זה עובדה, עם ישראל הקטן, ללא נשק, ללא צבא, ללא כלום, שורד."
  },
  {
   "start": 663.54,
   "end": 666.9,
   "text": "עמים נעלמים, אימפריות נופלות ושוקעות, ועם ישראל ממשיך."
  },
  {
   "start": 667.54,
   "end": 668.46,
   "text": "ואני לא יודע איך זה קורה."
  },
  {
   "start": 669.06,
   "end": 669.8,
   "text": "במקרה כנראה."
  },
  {
   "start": 671.42,
   "end": 673.9,
   "text": "טוב, היה שואה, שלוש שנים אחרי השמדת עם,"
  },
  {
   "start": 674.72,
   "end": 676.5,
   "text": "במקום השמדת עם והתרסקות כללית,"
  },
  {
   "start": 677.1,
   "end": 678.18,
   "text": "חוזרים לארץ ישראל."
  },
  {
   "start": 678.76,
   "end": 680.38,
   "text": "מה אתה אומר? אני לא יודע איך זה יכול להיות."
  },
  {
   "start": 681.1,
   "end": 681.66,
   "text": "במקרה."
  },
  {
   "start": 683.2,
   "end": 686.64,
   "text": "טוב, מלחמת השח פורצת, מלחמת השחרור. צבא של עולים."
  },
  {
   "start": 687.14,
   "end": 688.34,
   "text": "עולים שלא יודעים להחזיק נשק."
  },
  {
   "start": 688.9,
   "end": 693.34,
   "text": "מול צבא מאומן של ירדן. מול ערבים שכל היום עושים מעשה ביזה ושוד."
  },
  {
   "start": 695.16,
   "end": 696.72,
   "text": "והיהודים, אותם עולים,"
  },
  {
   "start": 697.5,
   "end": 698.32,
   "text": "מצליחים."
  },
  {
   "start": 698.68,
   "end": 699.24,
   "text": "איך זה?"
  },
  {
   "start": 699.56,
   "end": 700.58,
   "text": "לא יודע. במקרה."
  },
  {
   "start": 702.96,
   "end": 703.98,
   "text": "שנת 67',"
  },
  {
   "start": 705.42,
   "end": 706.2,
   "text": "צבא קטן."
  },
  {
   "start": 706.2,
   "end": 709.14,
   "text": "מול שישה-שבעה מדינות,"
  },
  {
   "start": 709.7,
   "end": 710.58,
   "text": "ניצחון מדהים,"
  },
  {
   "start": 711.04,
   "end": 712.92,
   "text": "איך? במקרה, קורה, מקרה."
  },
  {
   "start": 714.1,
   "end": 721.02,
   "text": "ואז עם ישראל נותן מתנה לקדוש ברוך הוא. באה אותה תקשורת ונותנת מתנה לברוע עולם אחרי הנס שעשית"
  },
  {
   "start": 722.36,
   "end": 723.48,
   "text": "בששת הימים."
  },
  {
   "start": 724.06,
   "end": 726.9,
   "text": "אז בואו נפתח לך טלוויזיה בשבת, בואו נתחיל קלקול בעם ישראל."
  },
  {
   "start": 728.5,
   "end": 729.72,
   "text": "ובשנת 73,"
  },
  {
   "start": 731.08,
   "end": 733.98,
   "text": "יום הכיפורים, יום הדין. ברוע עולם רומז לנו ביום הדין."
  },
  {
   "start": 736.61,
   "end": 739.73,
   "text": "תוקפים אותנו, והפעם מתרסק לנו כל הצבא הסדיר."
  },
  {
   "start": 741.75,
   "end": 742.25,
   "text": "במקרה."
  },
  {
   "start": 743.55,
   "end": 745.41,
   "text": "ויש הצלה ברגע האחרון."
  },
  {
   "start": 746.55,
   "end": 747.19,
   "text": "במקרה."
  },
  {
   "start": 748.25,
   "end": 749.11,
   "text": "כוח צביקה."
  },
  {
   "start": 750.69,
   "end": 751.99,
   "text": "חייל אחד, טנק אחד."
  },
  {
   "start": 753.33,
   "end": 755.29,
   "text": "עוצר טנקים של סוריה. במקרה."
  },
  {
   "start": 755.77,
   "end": 756.87,
   "text": "אביגדור קהלני."
  },
  {
   "start": 758.75,
   "end": 761.17,
   "text": "שני טנקים וחצי, מול עשרות טנקים."
  },
  {
   "start": 762.23,
   "end": 762.81,
   "text": "במקרה."
  },
  {
   "start": 763.95,
   "end": 765.35,
   "text": "ועם ישראל ממשיך עם המקרה."
  },
  {
   "start": 766.19,
   "end": 766.89,
   "text": "ממשיכים להתרחק."
  },
  {
   "start": 767.77,
   "end": 768.53,
   "text": "אז בא שלום הגליל."
  },
  {
   "start": 769.27,
   "end": 770.39,
   "text": "בלבנון שקיעה."
  },
  {
   "start": 770.87,
   "end": 773.93,
   "text": "צבא יותר מתוחכם, יותר חזק, יותר מאומן."
  },
  {
   "start": 774.25,
   "end": 779.33,
   "text": "שוקע מול מדינה אחת, מול לא מדינה, מול פזורה של טרוריסטים."
  },
  {
   "start": 780.47,
   "end": 780.99,
   "text": "במקרה."
  },
  {
   "start": 783.33,
   "end": 785.41,
   "text": "טוב, אז באים ובונים צבא קטן וחכם."
  },
  {
   "start": 786.07,
   "end": 787.91,
   "text": "ואותו צבא קטן וחכם, במקרה,"
  },
  {
   "start": 788.43,
   "end": 789.37,
   "text": "בורח מלבנון."
  },
  {
   "start": 790.01,
   "end": 791.19,
   "text": "ועוד מתרחקים מהשמע."
  },
  {
   "start": 792.19,
   "end": 793.29,
   "text": "ואז במקרה,"
  },
  {
   "start": 793.87,
   "end": 795.69,
   "text": "מעזה, מאזרחים בורחים."
  },
  {
   "start": 798.23,
   "end": 798.75,
   "text": "עוד ריחוק,"
  },
  {
   "start": 799.61,
   "end": 800.61,
   "text": "ואז כבר באים אלינו"
  },
  {
   "start": 801.19,
   "end": 803.81,
   "text": "ופוגעים בנו ואנחנו חסרי אונים,"
  },
  {
   "start": 804.79,
   "end": 806.53,
   "text": "והכל במקרה."
  },
  {
   "start": 807.51,
   "end": 810.09,
   "text": "אז בא חג פורים לומר לנו, אין מקרה."
  },
  {
   "start": 811.13,
   "end": 812.47,
   "text": "אין מקרה בעולם."
  },
  {
   "start": 813.27,
   "end": 815.91,
   "text": "ישראל תלויים בקרבתם אל אבא שבשמיים."
  },
  {
   "start": 816.35,
   "end": 820.49,
   "text": "כשעם ישראל קרובים אל הקדוש ברוך הוא, אז כל האויבים תלויים."
  },
  {
   "start": 822.54,
   "end": 825.94,
   "text": "כמו שאת המנות על העם ישראל התקרב לשם, זעק אל השם,"
  },
  {
   "start": 826.52,
   "end": 827.28,
   "text": "המן נתלה."
  },
  {
   "start": 828.26,
   "end": 831.96,
   "text": "ככה גם היום, אם נתקרב אל השם, אם נזעק אל השם, אם באמת נהיה."
  },
  {
   "start": 832.82,
   "end": 833.4,
   "text": "באמת נהיה."
  },
  {
   "start": 834.12,
   "end": 836.22,
   "text": "עבדי השם כמו שבאמת השם רוצה."
  },
  {
   "start": 838.42,
   "end": 842.76,
   "text": "נעבוד את השם, נתקרב אל השם, נתברך, נתפלל, נזעק אל השם, נתאחד ביחד."
  },
  {
   "start": 844.0,
   "end": 844.98,
   "text": "הכל תלוי בנו."
  },
  {
   "start": 846.22,
   "end": 847.08,
   "text": "אולי בגלל זה תלו,"
  },
  {
   "start": 847.58,
   "end": 851.72,
   "text": "תלוי אם תוליו את המן, להגיד תרע, המן תלוי, זה תלוי בכם. או שהוא תלוי על עץ,"
  },
  {
   "start": 852.7,
   "end": 853.78,
   "text": "או שרחמנא ליצלן."
  },
  {
   "start": 855.16,
   "end": 856.2,
   "text": "אבל זה תלוי בנו."
  }
 ]
}