{
 "disc": "37ת- פורים שמחת האמונה",
 "track": "Track02",
 "duration": 1450.2,
 "segments": [
  {
   "start": 11.24,
   "end": 11.78,
   "text": "רבי וולף."
  },
  {
   "start": 13.12,
   "end": 15.24,
   "text": "רבי וולף היה תלמיד."
  },
  {
   "start": 16.94,
   "end": 18.6,
   "text": "היה תלמיד חסיד של הבעל שם טוב."
  },
  {
   "start": 20.06,
   "end": 25.6,
   "text": "הבעל שם טוב בירך אותו כשימצא את הזיווג שלו והוא מצא את הזיווג שלו."
  },
  {
   "start": 26.68,
   "end": 32.66,
   "text": "אחר כך הרב בירך אותו כשיזכה לזרע בר קיימא וקרבו כמה זמן נולד לו בן."
  },
  {
   "start": 34.96,
   "end": 35.88,
   "text": "וכשהבן גדל,"
  },
  {
   "start": 37.2,
   "end": 42.38,
   "text": "כשהבן היה כבר בגיל שמונה,"
  },
  {
   "start": 45.44,
   "end": 47.14,
   "text": "הוא לקח אותו אל הבעל השם טוב."
  },
  {
   "start": 47.94,
   "end": 48.88,
   "text": "כדי שהרב יברך אותו."
  },
  {
   "start": 53.01,
   "end": 54.05,
   "text": "זה היה ראש חודש אדר,"
  },
  {
   "start": 56.55,
   "end": 58.03,
   "text": "כשהם הגיעו אל מזיבוש,"
  },
  {
   "start": 59.41,
   "end": 62.29,
   "text": "אל העיירה של רבי ישראל הבעל שם טוב."
  },
  {
   "start": 65.31,
   "end": 66.71,
   "text": "הרב כל כך שמח בילד."
  },
  {
   "start": 71.52,
   "end": 72.54,
   "text": "והוא שאל את רבי וולף,"
  },
  {
   "start": 73.2,
   "end": 75.22,
   "text": "מה הילד יכול לעשות לכבוד השם יתברך?"
  },
  {
   "start": 76.28,
   "end": 77.88,
   "text": "יש לו איזה משהו שהוא יודע לעשות?"
  },
  {
   "start": 82.4,
   "end": 84.94,
   "text": "הסמיק רבי וולף ואמר, הילד יודע,"
  },
  {
   "start": 85.58,
   "end": 86.42,
   "text": "הילד יודע לשיר,"
  },
  {
   "start": 87.12,
   "end": 88.88,
   "text": "אנחנו מאוד מתענגים על השירה שלו."
  },
  {
   "start": 90.48,
   "end": 92.18,
   "text": "אז הרב חייך ואמר לילד, תשיר,"
  },
  {
   "start": 92.18,
   "end": 101.17,
   "text": "תשאיר והילד צבי יחל לשער והקול שלו"
  },
  {
   "start": 102.25,
   "end": 102.43,
   "text": "היה"
  },
  {
   "start": 104.19,
   "end": 105.29,
   "text": "קול כל כך נפלא."
  },
  {
   "start": 106.25,
   "end": 107.25,
   "text": "הבעל שם טוב התענג"
  },
  {
   "start": 108.33,
   "end": 109.27,
   "text": "על הקול של הילד."
  },
  {
   "start": 111.15,
   "end": 113.45,
   "text": "מספר ימים אחר כך, כשהם רצו לחזור חזרה הביתה,"
  },
  {
   "start": 116.64,
   "end": 117.18,
   "text": "הבעל שם טוב"
  },
  {
   "start": 117.96,
   "end": 118.96,
   "text": "ביקש מרבי וולף"
  },
  {
   "start": 120.64,
   "end": 121.66,
   "text": "תישארו לשבת פה,"
  },
  {
   "start": 122.92,
   "end": 123.98,
   "text": "תישארו לשבת איתי."
  },
  {
   "start": 125.14,
   "end": 127.5,
   "text": "והם עושים את השבת במחיצת הרב הקדוש."
  },
  {
   "start": 128.56,
   "end": 132.26,
   "text": "ובשבת מזמין הבעל שם טוב את הילד לשיר,"
  },
  {
   "start": 132.94,
   "end": 133.64,
   "text": "והוא שר,"
  },
  {
   "start": 134.4,
   "end": 136.0,
   "text": "שר בצורה נפלאה, מדהימה."
  },
  {
   "start": 138.58,
   "end": 140.3,
   "text": "כשעברה לשבת, מוצאי שבת הגיעה."
  },
  {
   "start": 141.42,
   "end": 143.38,
   "text": "הבעל שם טוב בא, פונה לרבי וולף ואומר לו,"
  },
  {
   "start": 144.32,
   "end": 145.22,
   "text": "אני מבקש ממך,"
  },
  {
   "start": 145.88,
   "end": 146.44,
   "text": "בלי שאלות."
  },
  {
   "start": 147.7,
   "end": 149.48,
   "text": "אתה תעשה את מה שאני אומר לך בלי שאלות?"
  },
  {
   "start": 150.76,
   "end": 154.04,
   "text": "אמר רבי וולף, בהנהן, כל מה שתאמר, כל מה שעריו יאמר."
  },
  {
   "start": 155.22,
   "end": 156.54,
   "text": "אמר לו הבעל שם טוב, אני מבקש,"
  },
  {
   "start": 157.44,
   "end": 158.14,
   "text": "תיסע הביתה,"
  },
  {
   "start": 158.86,
   "end": 159.76,
   "text": "אבל תשאיר פה את הילד,"
  },
  {
   "start": 160.66,
   "end": 161.46,
   "text": "תשאיר איתי את הילד."
  },
  {
   "start": 163.71,
   "end": 165.95,
   "text": "בעוד מספר ימים אני אחזיר אותו אליך."
  },
  {
   "start": 171.08,
   "end": 173.38,
   "text": "עוד לפני פורים הוא יהיה אצלך בבית."
  },
  {
   "start": 174.96,
   "end": 175.62,
   "text": "ורבי וולף"
  },
  {
   "start": 176.46,
   "end": 177.78,
   "text": "התרגל לא לשאול שאלות,"
  },
  {
   "start": 179.66,
   "end": 185.78,
   "text": "לא לחקור אחר הליכותיו בקודש של רבו הקדוש והטהור,"
  },
  {
   "start": 187.78,
   "end": 188.5,
   "text": "חוזר הביתה."
  },
  {
   "start": 194.88,
   "end": 200.26,
   "text": "שבוע אחר כך הבעל שם טוב לוקח את הילד,"
  },
  {
   "start": 202.52,
   "end": 203.6,
   "text": "לוקח את צבי הילד,"
  },
  {
   "start": 203.6,
   "end": 206.56,
   "text": "והם יוצאים לדרך, הדרך"
  },
  {
   "start": 209.04,
   "end": 210.5,
   "text": "להחזיר את הילד להורים שלו."
  },
  {
   "start": 212.58,
   "end": 213.62,
   "text": "כך הדרך למתפתלת."
  },
  {
   "start": 215.14,
   "end": 215.44,
   "text": "בדרך"
  },
  {
   "start": 217.46,
   "end": 219.64,
   "text": "הם עוברים דרך פונדק, פונדק דרכים."
  },
  {
   "start": 221.26,
   "end": 222.56,
   "text": "לא של יהודים, של גויים."
  },
  {
   "start": 224.36,
   "end": 225.26,
   "text": "פונדק מהסוג,"
  },
  {
   "start": 226.52,
   "end": 228.52,
   "text": "מהסוג אולי הנחות, השפל,"
  },
  {
   "start": 230.52,
   "end": 231.36,
   "text": "שיהודי,"
  },
  {
   "start": 232.08,
   "end": 233.58,
   "text": "ואפילו גוי,"
  },
  {
   "start": 236.62,
   "end": 238.56,
   "text": "גוי שדרכו ישרה בחיים,"
  },
  {
   "start": 239.48,
   "end": 241.5,
   "text": "אינם נכנסים לשם,"
  },
  {
   "start": 244.29,
   "end": 245.07,
   "text": "והפלא ופלא,"
  },
  {
   "start": 245.65,
   "end": 248.59,
   "text": "הבעל שם טוב תופס את הילד ביד אחת,"
  },
  {
   "start": 249.53,
   "end": 251.51,
   "text": "והם נכנסים אל תוך הפונדק."
  },
  {
   "start": 253.79,
   "end": 254.47,
   "text": "ובפונדק"
  },
  {
   "start": 255.91,
   "end": 258.51,
   "text": "היו שם קבוצות חבורות של גויים מתהוללים,"
  },
  {
   "start": 259.03,
   "end": 260.27,
   "text": "טיפוסים קשוחים."
  },
  {
   "start": 261.35,
   "end": 262.41,
   "text": "וכשהדלת נפתחה,"
  },
  {
   "start": 263.77,
   "end": 268.09,
   "text": "ובפתח נרדה דמותו של רב, רב יהודי עם ילד קטן,"
  },
  {
   "start": 269.65,
   "end": 270.73,
   "text": "נסתרה לה דממה."
  },
  {
   "start": 274.56,
   "end": 275.54,
   "text": "הם הביטו ברב,"
  },
  {
   "start": 279.79,
   "end": 280.27,
   "text": "והרב,"
  },
  {
   "start": 281.85,
   "end": 282.85,
   "text": "בשלווה ורוגע,"
  },
  {
   "start": 283.37,
   "end": 284.65,
   "text": "הוא עושה את דרכו אל אחד השולחנות,"
  },
  {
   "start": 287.99,
   "end": 288.97,
   "text": "מתיישב עם הילד,"
  },
  {
   "start": 291.87,
   "end": 293.05,
   "text": "יושב ושותק."
  },
  {
   "start": 298.71,
   "end": 302.83,
   "text": "אותם גויים התמלוא הערכה לאומץ הלב היהודי,"
  },
  {
   "start": 305.93,
   "end": 307.09,
   "text": "ומה שגורם להם להמשיך"
  },
  {
   "start": 308.79,
   "end": 310.23,
   "text": "ולא להתייחס אל אותו רב,"
  },
  {
   "start": 311.13,
   "end": 312.05,
   "text": "אותו ילד שנכנס."
  },
  {
   "start": 314.76,
   "end": 317.42,
   "text": "הם שרים להם שירי גויים, שירי שיכורים,"
  },
  {
   "start": 317.42,
   "end": 323.8,
   "text": "וכך מתהוללים בצעקות דחיפות ומהלומות."
  },
  {
   "start": 325.86,
   "end": 326.12,
   "text": "ואז"
  },
  {
   "start": 330.25,
   "end": 332.25,
   "text": "נשמעו דפיקות על גבי השולחן."
  },
  {
   "start": 333.91,
   "end": 337.19,
   "text": "הבעל שם טוב הרים את ידו והחל לדפוק על השולחן"
  },
  {
   "start": 338.99,
   "end": 340.09,
   "text": "כמעין מבקש שקט,"
  },
  {
   "start": 342.38,
   "end": 343.04,
   "text": "ובפונדק"
  },
  {
   "start": 344.08,
   "end": 345.38,
   "text": "נסתררה הדבמה."
  },
  {
   "start": 347.45,
   "end": 348.63,
   "text": "כולם לא טשים עיניים"
  },
  {
   "start": 349.85,
   "end": 350.81,
   "text": "אל הרב היהודי."
  },
  {
   "start": 353.27,
   "end": 354.05,
   "text": "והבעל שם טוב"
  },
  {
   "start": 354.63,
   "end": 355.47,
   "text": "בקול שקט,"
  },
  {
   "start": 356.69,
   "end": 357.31,
   "text": "פונה אליהם"
  },
  {
   "start": 358.73,
   "end": 360.19,
   "text": "ואומר להם בשפה שלהם,"
  },
  {
   "start": 361.25,
   "end": 362.33,
   "text": "אתם יודעים לשיר?"
  },
  {
   "start": 364.42,
   "end": 365.52,
   "text": "אתם לא יודעים לשיר."
  },
  {
   "start": 366.24,
   "end": 366.38,
   "text": "זה,"
  },
  {
   "start": 367.2,
   "end": 368.46,
   "text": "זה לא נקרא שירה."
  },
  {
   "start": 369.72,
   "end": 374.56,
   "text": "עכשיו תקשיבו ותשמעו מה זו שירה."
  },
  {
   "start": 375.76,
   "end": 377.0,
   "text": "מה זה נקרא לשיר?"
  },
  {
   "start": 379.29,
   "end": 382.49,
   "text": "והבעל שם טוב מסמן אל צבי."
  },
  {
   "start": 383.45,
   "end": 384.11,
   "text": "וצבי קם,"
  },
  {
   "start": 384.89,
   "end": 385.85,
   "text": "ילד בן שמונה."
  },
  {
   "start": 387.09,
   "end": 390.67,
   "text": "לא מבין מה קורס, ולא רק מרגיש את הפחד, מרגיש את הסכנה,"
  },
  {
   "start": 391.15,
   "end": 391.99,
   "text": "חש אותה באוויר."
  },
  {
   "start": 393.89,
   "end": 395.11,
   "text": "אבל הרב מצווה את השיר,"
  },
  {
   "start": 397.59,
   "end": 398.71,
   "text": "והילד החל לשיר."
  },
  {
   "start": 401.77,
   "end": 402.63,
   "text": "אתם יודעים מה הוא שר?"
  },
  {
   "start": 405.64,
   "end": 407.36,
   "text": "הוא שר שושנת יעקב."
  },
  {
   "start": 410.14,
   "end": 411.1,
   "text": "זה היה לפני פורים,"
  },
  {
   "start": 412.06,
   "end": 416.5,
   "text": "וקולו, קולו היה משתפך והולך בצורה נפלאה,"
  },
  {
   "start": 419.44,
   "end": 420.86,
   "text": "והגויים המומים,"
  },
  {
   "start": 424.49,
   "end": 426.23,
   "text": "כאילו ממלא את כל חלל הפונדק,"
  },
  {
   "start": 427.33,
   "end": 430.21,
   "text": "כאילו נלחם בגלי הטומאה,"
  },
  {
   "start": 430.83,
   "end": 443.14,
   "text": "ומטהר לאט-לאט את האווירה שם בפונדק ממאחרי הדלפק שם עזגו את המשקאות."
  },
  {
   "start": 444.02,
   "end": 444.56,
   "text": "מאחרי הדלפק"
  },
  {
   "start": 445.56,
   "end": 446.52,
   "text": "נראתה תנועה."
  },
  {
   "start": 447.76,
   "end": 448.7,
   "text": "מאחרי הדלפק הגיחו"
  },
  {
   "start": 449.38,
   "end": 450.64,
   "text": "שני ילדים קטנים,"
  },
  {
   "start": 451.4,
   "end": 452.44,
   "text": "פורעי ראש."
  },
  {
   "start": 453.6,
   "end": 454.96,
   "text": "בניו של בעל הפונדק"
  },
  {
   "start": 458.69,
   "end": 460.23,
   "text": "הם הביטו בילד ששר,"
  },
  {
   "start": 461.05,
   "end": 470.75,
   "text": "ואט-אט שומעים בענה ובחדווה"
  },
  {
   "start": 471.37,
   "end": 474.45,
   "text": "את הילד היהודי ששר כל כך נפלא."
  },
  {
   "start": 475.25,
   "end": 478.93,
   "text": "מעולם הם לא שור קול טהור כל כך."
  },
  {
   "start": 482.26,
   "end": 482.92,
   "text": "הבעל שם טוב."
  },
  {
   "start": 483.48,
   "end": 486.08,
   "text": "הבעל שם טוב פסע לעבר שני הילדים."
  },
  {
   "start": 487.52,
   "end": 488.96,
   "text": "הוא ניגש אל אחד מהילדים,"
  },
  {
   "start": 490.2,
   "end": 492.48,
   "text": "מלטף את לחיו בידו הקדושה."
  },
  {
   "start": 493.52,
   "end": 494.26,
   "text": "מה שמך?"
  },
  {
   "start": 495.18,
   "end": 496.4,
   "text": "שאל הבעל שם טוב."
  },
  {
   "start": 498.0,
   "end": 498.7,
   "text": "ודים,"
  },
  {
   "start": 499.36,
   "end": 500.32,
   "text": "קוראים לי ודים."
  },
  {
   "start": 502.54,
   "end": 503.1,
   "text": "ודים,"
  },
  {
   "start": 503.82,
   "end": 506.54,
   "text": "אתה רוצה להיות חבר של הילד היהודי הזה?"
  },
  {
   "start": 508.63,
   "end": 509.87,
   "text": "אמר הבעל שם טוב."
  },
  {
   "start": 511.17,
   "end": 515.33,
   "text": "כשהוא מניח את ידו על כתפו של הילד הגוי?"
  },
  {
   "start": 516.57,
   "end": 516.73,
   "text": "כן,"
  },
  {
   "start": 517.65,
   "end": 519.01,
   "text": "אני רוצה להיות חבר שלו."
  },
  {
   "start": 522.74,
   "end": 525.7,
   "text": "אחר כך ניגש הבעל שם טוב אל הילד השני,"
  },
  {
   "start": 526.52,
   "end": 529.96,
   "text": "מלטף בידו הקדושה את לחיו של הילד השני."
  },
  {
   "start": 530.78,
   "end": 531.4,
   "text": "מה שמך?"
  },
  {
   "start": 532.72,
   "end": 533.28,
   "text": "יבגני."
  },
  {
   "start": 534.52,
   "end": 535.08,
   "text": "יבגני,"
  },
  {
   "start": 535.74,
   "end": 536.36,
   "text": "גם אתה,"
  },
  {
   "start": 537.06,
   "end": 542.28,
   "text": "גם אתה רוצה להיות חבר של הילד היהודי הזה ששר כל כך יפה?"
  },
  {
   "start": 545.2,
   "end": 546.86,
   "text": "גם אני רוצה להיות חבר שלו."
  },
  {
   "start": 549.02,
   "end": 551.88,
   "text": "חייך הבעל שם טוב הביט בעיניהם,"
  },
  {
   "start": 553.9,
   "end": 556.06,
   "text": "והם מביטים בעיניו הטהורות והקדושות,"
  },
  {
   "start": 557.54,
   "end": 559.46,
   "text": "ואז הבעל שם טוב חזר למקומו."
  },
  {
   "start": 566.2,
   "end": 569.67,
   "text": "המחזה המרגל, המחזה המיוחד הזה,"
  },
  {
   "start": 571.71,
   "end": 581.7,
   "text": "גרם לכל הפונדק מיוחדת."
  },
  {
   "start": 582.38,
   "end": 585.5,
   "text": "אווירה שמאז הוקם הפונדק לא,"
  },
  {
   "start": 586.08,
   "end": 594.36,
   "text": "לא הייתה בו. וכשהבעל שם טוב חזר אל המקום שלו,"
  },
  {
   "start": 597.51,
   "end": 598.37,
   "text": "הוא שלח את ידו,"
  },
  {
   "start": 599.15,
   "end": 600.61,
   "text": "אחז בידו של הילד,"
  },
  {
   "start": 603.78,
   "end": 607.01,
   "text": "ואז לפתע"
  },
  {
   "start": 607.97,
   "end": 611.25,
   "text": "נשמעו מחיאות כפיים."
  },
  {
   "start": 611.73,
   "end": 614.23,
   "text": "מחיאות כפיים עזות הדהדו להם בפונדק."
  },
  {
   "start": 616.09,
   "end": 618.83,
   "text": "מחיאות כפיים של אותם גויים,"
  },
  {
   "start": 619.69,
   "end": 620.77,
   "text": "מחיאות כפיים רמות."
  },
  {
   "start": 623.8,
   "end": 627.58,
   "text": "חלק מחאו כפיים בגלל השירה הנפלאה,"
  },
  {
   "start": 628.06,
   "end": 632.2,
   "text": "וחלק מחאו בגלל העוז והאומץ של הרב היהודי להיכנס אל"
  },
  {
   "start": 632.2,
   "end": 643.5,
   "text": "הזאבים ולעשות שם ככל העולה על רוחו ולשנות שם ממש את האווירה לעשות שם איזה משהו מיוחד שאיש לא מבין שום היסטורי משהו רוחני משהו מעל ההבנה"
  },
  {
   "start": 645.2,
   "end": 646.78,
   "text": "בעזרת התנהגות פשוטה"
  },
  {
   "start": 648.44,
   "end": 653.62,
   "text": "ומחיאות הכפיים הללו ליוו את הבעל שם טובה ילד שיצאו מהפונדק"
  },
  {
   "start": 655.02,
   "end": 657.8,
   "text": "בדרכם הביתה אל ביתו של רבי וולף"
  },
  {
   "start": 659.08,
   "end": 660.34,
   "text": "להחזיר את צבי הילד"
  },
  {
   "start": 666.56,
   "end": 667.06,
   "text": "ואכן"
  },
  {
   "start": 668.5,
   "end": 672.54,
   "text": "מספר שעות אחר כך כבר נפגש הילד עם אבא שלו,"
  },
  {
   "start": 677.14,
   "end": 680.22,
   "text": "ופור עם אותה שנה היה שמח במיוחד"
  },
  {
   "start": 681.22,
   "end": 682.22,
   "text": "בבית הבעל שם."
  },
  {
   "start": 746.19,
   "end": 747.33,
   "text": "מזג האוויר הסוער"
  },
  {
   "start": 748.35,
   "end": 750.21,
   "text": "הבריח את הכל אל בתיהם."
  },
  {
   "start": 753.8,
   "end": 754.5,
   "text": "המרכבה,"
  },
  {
   "start": 755.58,
   "end": 757.24,
   "text": "המרכבה שדהרה לה במהירות,"
  },
  {
   "start": 758.44,
   "end": 761.34,
   "text": "חוצה את הכפר ואת שביליו."
  },
  {
   "start": 762.26,
   "end": 765.92,
   "text": "מנסה לקצר את הדרך, למצוא דרך קצרה ביותר"
  },
  {
   "start": 766.9,
   "end": 768.22,
   "text": "כדי להגיע במהות הביתה."
  },
  {
   "start": 772.13,
   "end": 776.71,
   "text": "האיש במרכבה קיצר את הדרך גם דרך החורשה הסמוכה."
  },
  {
   "start": 779.85,
   "end": 780.61,
   "text": "האיש במרכבה"
  },
  {
   "start": 781.77,
   "end": 782.83,
   "text": "היה סוחר יהודי,"
  },
  {
   "start": 783.69,
   "end": 785.05,
   "text": "סוחר יהודי במיטב שנותיו."
  },
  {
   "start": 786.65,
   "end": 787.93,
   "text": "כולו לחוץ וטרוד."
  },
  {
   "start": 789.59,
   "end": 791.61,
   "text": "השנה הוא התעכב במסע עסקים שלו"
  },
  {
   "start": 794.14,
   "end": 795.3,
   "text": "זמן רב מדי."
  },
  {
   "start": 796.3,
   "end": 796.7,
   "text": "ואתה,"
  },
  {
   "start": 797.32,
   "end": 799.3,
   "text": "אתה ממהר להספיק להגיע לפני פורים."
  },
  {
   "start": 800.26,
   "end": 802.34,
   "text": "הוא רוצה לשמוע את המגילה, את קריאת המגילה."
  },
  {
   "start": 804.12,
   "end": 806.66,
   "text": "הוא יודע, בבית מחכים, הילדים שלו מחכים לאבא,"
  },
  {
   "start": 807.44,
   "end": 810.12,
   "text": "מחופשים כבר, רוצים שאבא ייקח אותם"
  },
  {
   "start": 811.0,
   "end": 812.12,
   "text": "אל קריאת המגילה,"
  },
  {
   "start": 812.78,
   "end": 814.0,
   "text": "אל אותה חוויה נפלאה,"
  },
  {
   "start": 814.7,
   "end": 817.54,
   "text": "את אותה מצווה קדושה לקיים כמדי שנה."
  },
  {
   "start": 818.04,
   "end": 818.84,
   "text": "כולם מחכים לאבא."
  },
  {
   "start": 827.16,
   "end": 827.4,
   "text": "משהו."
  },
  {
   "start": 829.02,
   "end": 830.16,
   "text": "משהו הביא לתא סוסים."
  },
  {
   "start": 832.27,
   "end": 833.27,
   "text": "הוא ניסה להרגיע אותם."
  },
  {
   "start": 833.91,
   "end": 835.75,
   "text": "הוא ידע כשסוס משנה מההתנהגות שלו."
  },
  {
   "start": 837.15,
   "end": 838.25,
   "text": "זה לא מבשר כל כך טובות."
  },
  {
   "start": 839.91,
   "end": 840.29,
   "text": "אז הוא ניסה"
  },
  {
   "start": 840.29,
   "end": 842.29,
   "text": "ליישר את דרכו,"
  },
  {
   "start": 843.05,
   "end": 844.51,
   "text": "לעבור כמה שיותר את החורשה,"
  },
  {
   "start": 845.13,
   "end": 845.67,
   "text": "בלב קצת."
  },
  {
   "start": 848.01,
   "end": 849.15,
   "text": "התגדרה לה התחושה."
  },
  {
   "start": 851.05,
   "end": 852.51,
   "text": "החל החושך קצת צער, למה?"
  },
  {
   "start": 853.03,
   "end": 854.73,
   "text": "למה קיצרתי? למה רציתי את החורשה?"
  },
  {
   "start": 855.99,
   "end": 857.43,
   "text": "אבל הוא נהר הביתה, לא היה זמן."
  },
  {
   "start": 859.53,
   "end": 860.69,
   "text": "הוא ניסה להרגיע את הסוסים,"
  },
  {
   "start": 862.92,
   "end": 866.54,
   "text": "אבל בטרם, עוד לפני שהוא הספיק להניד עפעף,"
  },
  {
   "start": 869.88,
   "end": 871.14,
   "text": "לפתע הסוסים נעצרו,"
  },
  {
   "start": 872.14,
   "end": 874.32,
   "text": "מאיימים להפיל אותו מהמרכבה."
  },
  {
   "start": 875.58,
   "end": 876.6,
   "text": "הוא ניסה לראות מה קורה,"
  },
  {
   "start": 878.04,
   "end": 880.58,
   "text": "אבל אז הוא מצא את עצמו מול קנה,"
  },
  {
   "start": 881.72,
   "end": 882.98,
   "text": "מול קנה של רובה,"
  },
  {
   "start": 888.58,
   "end": 890.18,
   "text": "רועד כולו מפחד ואימה."
  },
  {
   "start": 891.14,
   "end": 894.88,
   "text": "הורד הסוחר היהודי על ידי צמד רעולי פנים."
  },
  {
   "start": 896.38,
   "end": 899.38,
   "text": "צמד רעולי פנים גברתנים שניצבו למולו."
  },
  {
   "start": 903.26,
   "end": 903.48,
   "text": "שוד."
  },
  {
   "start": 904.7,
   "end": 905.78,
   "text": "הוא נפל קורבן לשוד."
  },
  {
   "start": 906.62,
   "end": 913.33,
   "text": "כמעט מבלי לדבר מילה הוא נכפל בעד, הם חיטטו בבגדיו."
  },
  {
   "start": 914.49,
   "end": 915.91,
   "text": "הם חיטטו, חיפשו במרכבה."
  },
  {
   "start": 917.13,
   "end": 918.41,
   "text": "לוקחים את כל כספו,"
  },
  {
   "start": 920.64,
   "end": 921.64,
   "text": "אבל הגרוע מכל."
  },
  {
   "start": 923.3,
   "end": 925.26,
   "text": "כשהוא שכב שם באדמה, כבול,"
  },
  {
   "start": 925.88,
   "end": 926.7,
   "text": "חסר אונים,"
  },
  {
   "start": 928.06,
   "end": 930.28,
   "text": "הוא שומע את שני השודדים מדברים ביניהם,"
  },
  {
   "start": 931.56,
   "end": 932.88,
   "text": "מתכננים בקור רוח"
  },
  {
   "start": 933.5,
   "end": 935.4,
   "text": "לא להשאיר אחריהם ראיות,"
  },
  {
   "start": 938.06,
   "end": 939.4,
   "text": "לא להשאיר אחריהם עד"
  },
  {
   "start": 940.1,
   "end": 941.64,
   "text": "שיוכל לספר מה שהיה."
  },
  {
   "start": 943.18,
   "end": 948.65,
   "text": "הם מתכוונים לרצוח, להרוג אותו."
  },
  {
   "start": 951.29,
   "end": 952.37,
   "text": "הם מתכוונים להרוג אותו."
  },
  {
   "start": 974.61,
   "end": 976.35,
   "text": "צבי הסוחר היהודי שוכב על האדמה."
  },
  {
   "start": 977.11,
   "end": 977.63,
   "text": "הוא שמע,"
  },
  {
   "start": 978.15,
   "end": 982.73,
   "text": "הוא שמע על אותם שודדים רוצחים אכזריים שהטילו אימתם על הסביבה,"
  },
  {
   "start": 983.51,
   "end": 984.29,
   "text": "ללא רחמים,"
  },
  {
   "start": 985.07,
   "end": 986.27,
   "text": "ללא מעצורים."
  },
  {
   "start": 987.47,
   "end": 988.75,
   "text": "ועתה הוא הקורבן."
  },
  {
   "start": 990.88,
   "end": 991.9,
   "text": "הוא החל נזכר"
  },
  {
   "start": 992.58,
   "end": 994.94,
   "text": "בילדים שלו שממתינים לאבא"
  },
  {
   "start": 994.94,
   "end": 997.56,
   "text": "שכבר כנראה לא יחזור."
  },
  {
   "start": 999.38,
   "end": 1000.18,
   "text": "לרעייתו,"
  },
  {
   "start": 1002.87,
   "end": 1003.99,
   "text": "לקריאת המגילה,"
  },
  {
   "start": 1004.73,
   "end": 1006.31,
   "text": "שכל כך רצה להספיק."
  },
  {
   "start": 1007.75,
   "end": 1008.23,
   "text": "פורים."
  },
  {
   "start": 1009.23,
   "end": 1011.07,
   "text": "דווקא בפורים ריבונו של עולם."
  },
  {
   "start": 1012.31,
   "end": 1014.09,
   "text": "חלפה מחשבה טורדנית במוחו."
  },
  {
   "start": 1019.2,
   "end": 1020.48,
   "text": "הסוחר עצם את עיניו."
  },
  {
   "start": 1021.78,
   "end": 1023.54,
   "text": "לא נשאר לו הרבה זמן לחיות."
  },
  {
   "start": 1027.16,
   "end": 1027.58,
   "text": "אז הוא חשב"
  },
  {
   "start": 1028.56,
   "end": 1030.94,
   "text": "מה הוא רוצה לומר לריבונו של עולם."
  },
  {
   "start": 1032.12,
   "end": 1033.22,
   "text": "ברגעים האחרונים"
  },
  {
   "start": 1034.1,
   "end": 1043.94,
   "text": "לפני שצמד הרוצחים יסיים את חלוקת השלל ויתפנה לסיים גם את מהלך חייו."
  },
  {
   "start": 1045.42,
   "end": 1046.48,
   "text": "אז הוא מתאמץ לחשוב,"
  },
  {
   "start": 1047.46,
   "end": 1048.38,
   "text": "לומר משהו,"
  },
  {
   "start": 1048.98,
   "end": 1049.8,
   "text": "מילים אחרונות,"
  },
  {
   "start": 1051.28,
   "end": 1058.88,
   "text": "וכלום לא יוצא. פורים פורים הוא חשב,"
  },
  {
   "start": 1060.92,
   "end": 1061.34,
   "text": "ואז"
  },
  {
   "start": 1062.4,
   "end": 1063.0,
   "text": "הוא החליט"
  },
  {
   "start": 1064.22,
   "end": 1065.12,
   "text": "שלפורים,"
  },
  {
   "start": 1066.0,
   "end": 1067.36,
   "text": "לכבוד ריבונו של עולם,"
  },
  {
   "start": 1067.36,
   "end": 1071.44,
   "text": "הוא יאמר את הדבר היחיד שעלה במוחו"
  },
  {
   "start": 1072.84,
   "end": 1073.82,
   "text": "ברגעים הללו."
  },
  {
   "start": 1075.8,
   "end": 1078.68,
   "text": "והסוחר היהודי שקראו לו צבי"
  },
  {
   "start": 1079.94,
   "end": 1080.8,
   "text": "פתח בשירה"
  },
  {
   "start": 1082.62,
   "end": 1084.18,
   "text": "שושנת יעקב"
  },
  {
   "start": 1087.14,
   "end": 1088.12,
   "text": "באמצע החורשה"
  },
  {
   "start": 1089.9,
   "end": 1091.3,
   "text": "מפלחת את הדממה"
  },
  {
   "start": 1092.08,
   "end": 1093.84,
   "text": "כל שירתו של היהודי,"
  },
  {
   "start": 1095.46,
   "end": 1096.54,
   "text": "שירת הנצח,"
  },
  {
   "start": 1097.7,
   "end": 1098.7,
   "text": "שירת האמונה,"
  },
  {
   "start": 1100.54,
   "end": 1103.12,
   "text": "בדיוק כמו שהוא היה כילד קטן."
  },
  {
   "start": 1109.11,
   "end": 1109.45,
   "text": "ואז"
  },
  {
   "start": 1110.89,
   "end": 1112.33,
   "text": "לפתע שני השודדים,"
  },
  {
   "start": 1113.51,
   "end": 1114.51,
   "text": "צמד הרוצחים,"
  },
  {
   "start": 1115.39,
   "end": 1120.59,
   "text": "קפאו על מקומם לכל השירה שפרץ מגרונו של צבי."
  },
  {
   "start": 1122.37,
   "end": 1123.35,
   "text": "אל מוחמד גס,"
  },
  {
   "start": 1123.97,
   "end": 1125.03,
   "text": "הבליח זיכרון,"
  },
  {
   "start": 1125.87,
   "end": 1127.29,
   "text": "זיכרון מלפני שנים."
  },
  {
   "start": 1128.31,
   "end": 1130.25,
   "text": "איך הם כילדים קטנים,"
  },
  {
   "start": 1131.23,
   "end": 1132.61,
   "text": "בפונדק של אבא,"
  },
  {
   "start": 1133.61,
   "end": 1137.53,
   "text": "שומעים את הילד היהודי שר את השיר הזה."
  },
  {
   "start": 1139.33,
   "end": 1140.69,
   "text": "זוכרים את הקול הזה."
  },
  {
   "start": 1142.19,
   "end": 1145.83,
   "text": "אולי היום הוא קצת יותר עבה, אולי הוא קצת יותר בוגר."
  },
  {
   "start": 1146.67,
   "end": 1152.25,
   "text": "אבל זהו אותו קול ששר ומטהר את האוויר העכור בפונדק."
  },
  {
   "start": 1153.91,
   "end": 1154.71,
   "text": "והם נזכרים,"
  },
  {
   "start": 1155.65,
   "end": 1157.71,
   "text": "את הרב הקדוש, איך הוא פונה אליהם,"
  },
  {
   "start": 1158.57,
   "end": 1161.05,
   "text": "את ידו הלוהטת בעלי חיים שלהם,"
  },
  {
   "start": 1161.85,
   "end": 1165.87,
   "text": "שכמעין צורבת מעמד זה בזיכרונם,"
  },
  {
   "start": 1168.1,
   "end": 1168.74,
   "text": "ואת קולו"
  },
  {
   "start": 1169.62,
   "end": 1170.52,
   "text": "פונה אליהם."
  },
  {
   "start": 1171.28,
   "end": 1171.74,
   "text": "ואדים,"
  },
  {
   "start": 1172.42,
   "end": 1174.84,
   "text": "ואדים רוצה להיות חבר של הילד היהודי,"
  },
  {
   "start": 1175.88,
   "end": 1177.64,
   "text": "וואדים נזכר איך הוא אומר כן."
  },
  {
   "start": 1178.74,
   "end": 1180.28,
   "text": "יבגני, גם אתה רוצה."
  },
  {
   "start": 1180.86,
   "end": 1182.22,
   "text": "יבגני נזכר כן."
  },
  {
   "start": 1186.56,
   "end": 1187.26,
   "text": "הוא מתחולל"
  },
  {
   "start": 1188.08,
   "end": 1189.36,
   "text": "בנפשם הסוערת"
  },
  {
   "start": 1190.24,
   "end": 1191.56,
   "text": "של צמד הרוצחים."
  },
  {
   "start": 1223.53,
   "end": 1224.71,
   "text": "זוג ידיים חסונות."
  },
  {
   "start": 1227.93,
   "end": 1230.93,
   "text": "זוג ידיים חסונות אחזו בו בצבי."
  },
  {
   "start": 1232.11,
   "end": 1232.51,
   "text": "הקימו אותו."
  },
  {
   "start": 1234.83,
   "end": 1236.59,
   "text": "הוא חש איך משחררים אותו מהאזיקים."
  },
  {
   "start": 1238.55,
   "end": 1240.15,
   "text": "והוא מוצא את עצמו מתבונן"
  },
  {
   "start": 1241.25,
   "end": 1242.93,
   "text": "בשני גויים עזי פנים"
  },
  {
   "start": 1244.33,
   "end": 1245.59,
   "text": "שהביטו בו בפליאה."
  },
  {
   "start": 1249.12,
   "end": 1251.14,
   "text": "אתה זה הילד, הילד היהודי,"
  },
  {
   "start": 1251.78,
   "end": 1252.96,
   "text": "שלפני שנים,"
  },
  {
   "start": 1253.5,
   "end": 1254.92,
   "text": "כשהיינו קטנים,"
  },
  {
   "start": 1255.62,
   "end": 1259.08,
   "text": "בא ושר כל כך נפלא בפונדק של אבא שלנו."
  },
  {
   "start": 1261.4,
   "end": 1263.02,
   "text": "אתה הילד שבאת עם הרב,"
  },
  {
   "start": 1263.84,
   "end": 1264.96,
   "text": "עם הרב הקדוש,"
  },
  {
   "start": 1265.76,
   "end": 1267.78,
   "text": "שליטף את הלחי שלנו."
  },
  {
   "start": 1269.04,
   "end": 1270.82,
   "text": "עד היום אנחנו זוכרים את הליטוף."
  },
  {
   "start": 1271.78,
   "end": 1276.0,
   "text": "עד היום אנחנו זוכרים את ההבטחה שלנו שנהיה חברים."
  },
  {
   "start": 1281.04,
   "end": 1281.44,
   "text": "יהודי,"
  },
  {
   "start": 1282.6,
   "end": 1284.42,
   "text": "אנחנו לא יכולים לעשות לך כלום."
  },
  {
   "start": 1286.22,
   "end": 1287.64,
   "text": "קח חזרה את הכסף."
  },
  {
   "start": 1288.62,
   "end": 1290.78,
   "text": "קח חזרה את הכסף שלקחנו ממך."
  },
  {
   "start": 1291.7,
   "end": 1293.56,
   "text": "וקח גם את חייך במתנה."
  },
  {
   "start": 1294.54,
   "end": 1294.8,
   "text": "לך,"
  },
  {
   "start": 1295.64,
   "end": 1296.28,
   "text": "סע הביתה."
  },
  {
   "start": 1297.7,
   "end": 1299.32,
   "text": "אנחנו לא מסוגלים לפגוע בך לרעה."
  },
  {
   "start": 1300.28,
   "end": 1301.42,
   "text": "הבטחנו להיות חברים."
  },
  {
   "start": 1303.46,
   "end": 1305.46,
   "text": "הבטחנו לרב להיות חברים."
  },
  {
   "start": 1307.18,
   "end": 1308.64,
   "text": "קח לך את חייך במתנה."
  },
  {
   "start": 1313.22,
   "end": 1313.68,
   "text": "וצבי,"
  },
  {
   "start": 1314.98,
   "end": 1315.92,
   "text": "עלה על המרכבה."
  },
  {
   "start": 1317.38,
   "end": 1318.7,
   "text": "נקבל את כספו חזרה,"
  },
  {
   "start": 1319.48,
   "end": 1320.86,
   "text": "והחל דוהר קדימה."
  },
  {
   "start": 1321.82,
   "end": 1322.88,
   "text": "נפעם כולו."
  },
  {
   "start": 1324.68,
   "end": 1325.64,
   "text": "נס פורים."
  },
  {
   "start": 1326.78,
   "end": 1328.24,
   "text": "אין מקרה בעולם."
  },
  {
   "start": 1329.32,
   "end": 1329.96,
   "text": "הכל בהשגחה."
  },
  {
   "start": 1331.72,
   "end": 1333.22,
   "text": "לנו לפעמים אין עיניים לראות."
  },
  {
   "start": 1334.36,
   "end": 1336.3,
   "text": "יש צדיקים שרואים יותר מאיתנו."
  },
  {
   "start": 1337.1,
   "end": 1338.36,
   "text": "הבעל שם טוב היה אחד כזה."
  },
  {
   "start": 1339.34,
   "end": 1341.68,
   "text": "המקרה הזה התרחש כבר שנים אחרי פטירתו."
  },
  {
   "start": 1343.06,
   "end": 1343.94,
   "text": "אבל הוא ידע מה יהיה."
  },
  {
   "start": 1344.64,
   "end": 1345.76,
   "text": "הוא ראה יותר מאיתנו."
  },
  {
   "start": 1348.5,
   "end": 1350.58,
   "text": "הכל בהשגחה. אין מקרה בעולם."
  },
  {
   "start": 1351.22,
   "end": 1352.04,
   "text": "נס פורים."
  },
  {
   "start": 1356.77,
   "end": 1359.05,
   "text": "שנים צבי זכר את המקרה עם הבעל שם טוב."
  },
  {
   "start": 1360.57,
   "end": 1363.35,
   "text": "ואיש לא מבין את פשר התנהגות הרב."
  },
  {
   "start": 1364.11,
   "end": 1364.59,
   "text": "אבל עכשיו,"
  },
  {
   "start": 1365.31,
   "end": 1367.57,
   "text": "עכשיו היה הכל ברור, הכל מובן."
  },
  {
   "start": 1371.02,
   "end": 1372.2,
   "text": "וזה בתמציתיות"
  },
  {
   "start": 1373.3,
   "end": 1376.02,
   "text": "עניין האמונה וההשגחה, עניין של פורים."
  },
  {
   "start": 1376.82,
   "end": 1378.96,
   "text": "פורים, אין מקרה בעולם."
  },
  {
   "start": 1379.84,
   "end": 1380.74,
   "text": "הכל בהשגחה."
  },
  {
   "start": 1381.98,
   "end": 1383.62,
   "text": "זהו סוד שמחת היהודי,"
  },
  {
   "start": 1385.1,
   "end": 1386.76,
   "text": "שגם כשמקבלים מכה,"
  },
  {
   "start": 1387.86,
   "end": 1389.04,
   "text": "יודעים שזה מאבא."
  },
  {
   "start": 1392.65,
   "end": 1395.15,
   "text": "הדברי חיים פעם, כשנפטר לו הבן שלו,"
  },
  {
   "start": 1395.63,
   "end": 1396.33,
   "text": "באו להודיע לו."
  },
  {
   "start": 1396.89,
   "end": 1397.93,
   "text": "כשהודיעו לו הוא נרתע."
  },
  {
   "start": 1400.07,
   "end": 1401.39,
   "text": "אחרי זה הוא שתק והמשיך הלאה."
  },
  {
   "start": 1402.35,
   "end": 1404.13,
   "text": "שאלו אותו, תגיד כבוד הרב, מה קרה? נרתעת."
  },
  {
   "start": 1405.57,
   "end": 1407.03,
   "text": "אמר להם, אתם יודעים, אדם הולך ברחוב."
  },
  {
   "start": 1407.77,
   "end": 1408.91,
   "text": "פתאום הוא מרגיש חבטה."
  },
  {
   "start": 1410.79,
   "end": 1411.45,
   "text": "הוא לא מבין, הוא מסתובב."
  },
  {
   "start": 1412.07,
   "end": 1412.83,
   "text": "מה קרה? מי זה?"
  },
  {
   "start": 1413.69,
   "end": 1414.51,
   "text": "אבל אז הוא רואה מולו את אבא."
  },
  {
   "start": 1415.91,
   "end": 1416.37,
   "text": "אה, זה אבא."
  },
  {
   "start": 1418.33,
   "end": 1421.53,
   "text": "ככה גם אני הרגשתי כאב נורא."
  },
  {
   "start": 1422.35,
   "end": 1424.79,
   "text": "אבל אז נזכרתי בעצם מי לקח אותו,"
  },
  {
   "start": 1425.23,
   "end": 1426.11,
   "text": "את הילד שלי, אבא."
  },
  {
   "start": 1427.25,
   "end": 1428.17,
   "text": "אם זה אבא זה בסדר."
  },
  {
   "start": 1428.99,
   "end": 1429.51,
   "text": "אם זה אבא,"
  },
  {
   "start": 1430.23,
   "end": 1432.29,
   "text": "אז הילד נמצא במקום הכי טוב שהוא יכול להיות."
  },
  {
   "start": 1433.33,
   "end": 1434.75,
   "text": "אז אין סיבה להיות עצוב."
  },
  {
   "start": 1435.57,
   "end": 1437.07,
   "text": "פורים אין מקרה, הכל השגחה."
  },
  {
   "start": 1438.09,
   "end": 1438.49,
   "text": "הכל השגחה."
  },
  {
   "start": 1439.67,
   "end": 1442.31,
   "text": "גם הפור הוא הגורל, גם זה בהשגחה."
  }
 ]
}