{
 "disc": "16יז- החוזה מלובלין",
 "track": "Track03",
 "duration": 945.168,
 "segments": [
  {
   "start": 3.06,
   "end": 5.38,
   "text": "שעת לילה מאוחרת,"
  },
  {
   "start": 7.22,
   "end": 8.94,
   "text": "בני הבית נמים את שנתם."
  },
  {
   "start": 10.44,
   "end": 12.88,
   "text": "האפלה יורדת על העיר קרושניק."
  },
  {
   "start": 21.72,
   "end": 22.9,
   "text": "לילה ללא ירח,"
  },
  {
   "start": 25.14,
   "end": 27.26,
   "text": "והעיר קרושניק נמה את שנתה."
  },
  {
   "start": 28.78,
   "end": 29.68,
   "text": "איש לא שם לב"
  },
  {
   "start": 30.48,
   "end": 31.14,
   "text": "לאיזו דמות,"
  },
  {
   "start": 31.96,
   "end": 36.67,
   "text": "איזו דמות שחומקת לה במעווה החשיכה."
  },
  {
   "start": 47.63,
   "end": 48.61,
   "text": "כל מגירה נפתחת."
  },
  {
   "start": 49.69,
   "end": 49.99,
   "text": "יד,"
  },
  {
   "start": 51.37,
   "end": 52.33,
   "text": "יד נשלחת,"
  },
  {
   "start": 53.31,
   "end": 54.33,
   "text": "יד סוררת,"
  },
  {
   "start": 55.37,
   "end": 56.39,
   "text": "יד בוגדת."
  },
  {
   "start": 60.19,
   "end": 61.45,
   "text": "המגירה נסגרת,"
  },
  {
   "start": 62.33,
   "end": 63.37,
   "text": "והדמות נעלמת,"
  },
  {
   "start": 64.91,
   "end": 66.31,
   "text": "כלאומת שבא."
  },
  {
   "start": 81.44,
   "end": 82.7,
   "text": "למחרת מתברר,"
  },
  {
   "start": 84.12,
   "end": 84.72,
   "text": "נעלם"
  },
  {
   "start": 86.34,
   "end": 90.64,
   "text": "לבעל בית המלון של קרושניק סכום כסף עצום."
  },
  {
   "start": 91.94,
   "end": 93.88,
   "text": "לקח לו שנים לחסוך,"
  },
  {
   "start": 96.15,
   "end": 96.77,
   "text": "ביום אחד"
  },
  {
   "start": 97.85,
   "end": 98.63,
   "text": "נעלם הכל."
  },
  {
   "start": 102.17,
   "end": 103.07,
   "text": "גם כוחות המשטרה,"
  },
  {
   "start": 104.15,
   "end": 118.26,
   "text": "שפרסו וחיפשו ועצרו את כל החשודים האפשריים בגניבה ספגו כפיהם באכזבה."
  },
  {
   "start": 120.75,
   "end": 134.78,
   "text": "זאת תעלומה וכנראה תישאר גם תעלומה."
  },
  {
   "start": 135.16,
   "end": 136.04,
   "text": "שנים אחר כך"
  },
  {
   "start": 137.34,
   "end": 139.54,
   "text": "רבי אברהם מרדכי מפינצ'וב,"
  },
  {
   "start": 140.2,
   "end": 143.24,
   "text": "רבי אברהם מרדכי מפינצ'וב עושה את דרכו אל החוזה מלובלין."
  },
  {
   "start": 144.72,
   "end": 146.22,
   "text": "בדרך כלל הוא היה עושה את הדרך בשמחה."
  },
  {
   "start": 147.2,
   "end": 151.47,
   "text": "הפעם לא כל כך."
  },
  {
   "start": 161.77,
   "end": 163.15,
   "text": "הפעם הוא עוד הולך בצער כבד."
  },
  {
   "start": 164.31,
   "end": 165.29,
   "text": "הוא הולך בגלל אשתו,"
  },
  {
   "start": 166.43,
   "end": 167.37,
   "text": "או אולי בזכות אשתו."
  },
  {
   "start": 168.11,
   "end": 169.01,
   "text": "אשתו כבר לא יכלה."
  },
  {
   "start": 169.95,
   "end": 172.65,
   "text": "אשתו לא יכלה יותר לסבול את זה."
  },
  {
   "start": 173.55,
   "end": 179.17,
   "text": "לא יכלה לסבול את שבעלה ויהיה חיים בעוני כל כך מחריד."
  },
  {
   "start": 180.31,
   "end": 183.29,
   "text": "ועכשיו כשהגיע הזמן לחתן את הילדות שלה,"
  },
  {
   "start": 184.17,
   "end": 185.05,
   "text": "אין לה במה לתת כלום."
  },
  {
   "start": 186.35,
   "end": 187.91,
   "text": "כבר לא הייתה מוכנה להשלים עם זה."
  },
  {
   "start": 188.41,
   "end": 199.61,
   "text": "אני מבקשת מרבי אברהם רדכי מי פינצ'וב בעלה הצדיק שיבקש מהחוזה מלובלין תברך אותי תן איזה משהו ברכה הצלחה ישועה שיהיה לנו קצת פרנסה"
  },
  {
   "start": 201.57,
   "end": 206.55,
   "text": "והרב מי פינצ'וב כשמגיע אל מורו ורבו החוזה מלובלין מדבר איתו על הכל"
  },
  {
   "start": 207.63,
   "end": 208.41,
   "text": "על כל התורה"
  },
  {
   "start": 210.29,
   "end": 217.33,
   "text": "אבל שוכח תמיד להזכיר את מצבו הכלכלי ועכשיו הוא התחייב ללכת אין לו ברירה כי אשתו באה עמו"
  },
  {
   "start": 219.17,
   "end": 220.15,
   "text": "הוא נכנס אל החוזה,"
  },
  {
   "start": 221.41,
   "end": 223.65,
   "text": "ובלב כבד פושט את בעיותיו."
  },
  {
   "start": 225.11,
   "end": 226.43,
   "text": "החוזה מלובליל מסתכל,"
  },
  {
   "start": 227.45,
   "end": 229.01,
   "text": "אומר לו רב אברהם מרדכי,"
  },
  {
   "start": 230.03,
   "end": 231.37,
   "text": "תיסע לקרושניק,"
  },
  {
   "start": 232.15,
   "end": 235.27,
   "text": "שם בעיר קרושניק, שם נמצאת הישועה,"
  },
  {
   "start": 238.77,
   "end": 239.65,
   "text": "אמר החוזה,"
  },
  {
   "start": 241.15,
   "end": 244.48,
   "text": "ולא הוסיף."
  },
  {
   "start": 244.84,
   "end": 246.34,
   "text": "רבי אברהם מרדכי מפינצ'וב,"
  },
  {
   "start": 247.14,
   "end": 248.26,
   "text": "נפרד מבני ביתו,"
  },
  {
   "start": 249.04,
   "end": 253.04,
   "text": "ועשה את כל הדרך אל אותה עיירה מרוחקת, עיר מרוחקת,"
  },
  {
   "start": 254.08,
   "end": 254.76,
   "text": "בשם קרושניק."
  },
  {
   "start": 256.12,
   "end": 256.94,
   "text": "הוא מגיע לשם,"
  },
  {
   "start": 257.96,
   "end": 259.9,
   "text": "לעיר קרושניק, מקץ מספר שבועות."
  },
  {
   "start": 261.42,
   "end": 263.44,
   "text": "הוא הלך לבית מלון, בית המלון של קרושניק,"
  },
  {
   "start": 263.82,
   "end": 265.72,
   "text": "שם הוא ממתין, בינתיים עוסק בתורה."
  },
  {
   "start": 267.5,
   "end": 268.92,
   "text": "בעל בית המלון, יהודי כשר,"
  },
  {
   "start": 269.48,
   "end": 270.44,
   "text": "יהודי יקר מאוד,"
  },
  {
   "start": 271.46,
   "end": 271.88,
   "text": "ראה,"
  },
  {
   "start": 272.46,
   "end": 273.68,
   "text": "ראה אדם הדור פנים,"
  },
  {
   "start": 276.18,
   "end": 277.1,
   "text": "דיבר איתו,"
  },
  {
   "start": 277.66,
   "end": 279.38,
   "text": "וכשהוא שמע שהוא הרב של פינצ'וב,"
  },
  {
   "start": 279.86,
   "end": 281.54,
   "text": "הוא שאל, תגיד לי, למה אתה נמצא כאן?"
  },
  {
   "start": 282.16,
   "end": 284.72,
   "text": "מה אתה יושב ועושה בנירותך כל היום, לומד כל היום?"
  },
  {
   "start": 285.12,
   "end": 286.26,
   "text": "אתה כאילו ממתין למשהו."
  },
  {
   "start": 287.04,
   "end": 293.0,
   "text": "אמר לו, כן, אני ממתין, אני באתי לכאן בהוראת החוזה הקדוש מלובלין ששלח אותי לכאן."
  },
  {
   "start": 294.06,
   "end": 296.16,
   "text": "אני ממתין, אני צריך לתת את הילדות שלי."
  },
  {
   "start": 297.1,
   "end": 300.0,
   "text": "וכשבאתי לרב שלי ואמרתי לו, אין לי במה,"
  },
  {
   "start": 300.38,
   "end": 301.56,
   "text": "הוא אמר לי ללך לקרושניק,"
  },
  {
   "start": 302.36,
   "end": 305.58,
   "text": "שם אתה תמצא כבר במה לחתן את הילדות שלך."
  },
  {
   "start": 306.8,
   "end": 309.48,
   "text": "הוא אמר ולא הוסיף, אז אני פשוט יושב לומד ומחכה."
  },
  {
   "start": 311.72,
   "end": 313.4,
   "text": "מתי יתקיים מה שהוא אמר, אותו צדיק,"
  },
  {
   "start": 316.11,
   "end": 317.17,
   "text": "בעל בית עמון הופתע."
  },
  {
   "start": 318.15,
   "end": 319.97,
   "text": "מעולם הוא לא ראה אמונת חכמים כל כך גדולה,"
  },
  {
   "start": 321.53,
   "end": 327.03,
   "text": "והוא פשוט החליט ללכת ופשוט לעקוב,"
  },
  {
   "start": 328.25,
   "end": 332.08,
   "text": "להמתין לראות מה יהיה,"
  },
  {
   "start": 334.82,
   "end": 335.74,
   "text": "איך יהיו פני הדברים."
  },
  {
   "start": 339.93,
   "end": 341.19,
   "text": "כך עובר לו יום ועוד יום."
  },
  {
   "start": 342.85,
   "end": 343.93,
   "text": "מקץ שבוע,"
  },
  {
   "start": 344.95,
   "end": 346.57,
   "text": "שעת לילה מאוחרת,"
  },
  {
   "start": 347.37,
   "end": 359.02,
   "text": "יושב רבי אברהם מרדכי מפינצ'וב ולומד תורה, והלילה שקט,"
  },
  {
   "start": 360.06,
   "end": 361.24,
   "text": "הלילה חסר ירח,"
  },
  {
   "start": 362.26,
   "end": 362.86,
   "text": "אפלה,"
  },
  {
   "start": 364.96,
   "end": 366.76,
   "text": "אפלה עוטפת את העיר קרושניק,"
  },
  {
   "start": 372.02,
   "end": 374.88,
   "text": "דמות מתגנבת לה בחסות החשיכה,"
  },
  {
   "start": 377.71,
   "end": 379.21,
   "text": "ולפתע נשמעות דפיקות"
  },
  {
   "start": 381.12,
   "end": 382.86,
   "text": "בדלת חדרו של הרב מפינצ'וב."
  },
  {
   "start": 384.78,
   "end": 387.1,
   "text": "כן יבוא, אומר הרב בקול שקט,"
  },
  {
   "start": 388.42,
   "end": 389.64,
   "text": "ואל החדר נכנס יהודי,"
  },
  {
   "start": 392.5,
   "end": 393.26,
   "text": "בעל חזות"
  },
  {
   "start": 394.32,
   "end": 395.52,
   "text": "מעוררת כבוד,"
  },
  {
   "start": 396.26,
   "end": 397.08,
   "text": "יהודי מפוחד,"
  },
  {
   "start": 400.12,
   "end": 400.4,
   "text": "שלום,"
  },
  {
   "start": 401.54,
   "end": 402.24,
   "text": "כבוד הרב."
  },
  {
   "start": 403.16,
   "end": 406.2,
   "text": "יש לי דבר סתר לומר לכבוד הרב,"
  },
  {
   "start": 407.06,
   "end": 409.3,
   "text": "אבל אנא מכבוד הרב,"
  },
  {
   "start": 412.71,
   "end": 417.03,
   "text": "ירחם עליי ויעזור לי."
  },
  {
   "start": 417.65,
   "end": 418.95,
   "text": "והרב מפינצ'וב מסתכל,"
  },
  {
   "start": 419.49,
   "end": 423.77,
   "text": "רואה את הכאב העמוק בעיניים של אותו יהודי אלמוני,"
  },
  {
   "start": 424.57,
   "end": 427.05,
   "text": "ואומר לו, אני אשתדל, אני אשתדל, בני,"
  },
  {
   "start": 427.57,
   "end": 428.07,
   "text": "מה קרה?"
  },
  {
   "start": 429.13,
   "end": 430.93,
   "text": "ואז אותו יהודי מספר,"
  },
  {
   "start": 432.41,
   "end": 433.53,
   "text": "ותוך כדי שהוא מספר,"
  },
  {
   "start": 434.35,
   "end": 440.8,
   "text": "דמעות זולגות לו במורד לחיו והוא כאילו לא יכול להשתלט עליהן."
  },
  {
   "start": 442.54,
   "end": 444.18,
   "text": "ואז הוא מספר לרב מפינצ'וב"
  },
  {
   "start": 444.9,
   "end": 446.28,
   "text": "איך הוא היה המלמד"
  },
  {
   "start": 447.6,
   "end": 449.76,
   "text": "של הילדים של בעל בית המלון,"
  },
  {
   "start": 451.2,
   "end": 453.62,
   "text": "שכל כך הוא רכש את אמונו של בעל בית המלון,"
  },
  {
   "start": 454.5,
   "end": 456.84,
   "text": "עד לכך שבעל בית המלון לא הסתיר ממנו"
  },
  {
   "start": 457.48,
   "end": 458.36,
   "text": "היכן הוא שם"
  },
  {
   "start": 460.24,
   "end": 462.52,
   "text": "את הכסף שלו שהוא חוסך זה שנים"
  },
  {
   "start": 463.48,
   "end": 464.38,
   "text": "באותה מגירה"
  },
  {
   "start": 465.6,
   "end": 467.12,
   "text": "סודית שם מתחת לשולחן,"
  },
  {
   "start": 471.69,
   "end": 472.63,
   "text": "ואותו מלמד"
  },
  {
   "start": 476.45,
   "end": 482.61,
   "text": "שנקלע לבעיות כלכליות קשות לא יכל לגבור על היצר שלו,"
  },
  {
   "start": 484.81,
   "end": 485.87,
   "text": "שלילה-לילה"
  },
  {
   "start": 486.41,
   "end": 487.55,
   "text": "לא נתן לו מנוחה."
  },
  {
   "start": 488.75,
   "end": 489.47,
   "text": "ולילה אחד"
  },
  {
   "start": 490.83,
   "end": 491.69,
   "text": "הוא התגנב,"
  },
  {
   "start": 495.13,
   "end": 496.49,
   "text": "וכאחוז תזזית"
  },
  {
   "start": 497.27,
   "end": 498.17,
   "text": "גנב את הכסף."
  },
  {
   "start": 499.75,
   "end": 501.71,
   "text": "הוא זה שגנב את הכסף לפני שנים."
  },
  {
   "start": 503.23,
   "end": 503.73,
   "text": "הוא הגנב."
  },
  {
   "start": 511.36,
   "end": 513.78,
   "text": "כל הלילה כשהוא חזר הביתה הוא לא ישן."
  },
  {
   "start": 515.12,
   "end": 516.96,
   "text": "בבוקר כבר הוא החליט הוא יחזיר את הכסף,"
  },
  {
   "start": 518.02,
   "end": 520.96,
   "text": "אבל כשהוא בא כבר האזור היה שורץ שוטרים."
  },
  {
   "start": 521.96,
   "end": 530.06,
   "text": "הוא פחד שמבעל משפחה מכובדת הוא יהפך לאסיר בבית סוהר של גויים."
  },
  {
   "start": 531.24,
   "end": 532.66,
   "text": "אז הוא חזר מפוחד הביתה."
  },
  {
   "start": 533.66,
   "end": 534.3,
   "text": "כולו צער."
  },
  {
   "start": 535.22,
   "end": 536.72,
   "text": "כולו חרטה. כולו תשובה."
  },
  {
   "start": 538.04,
   "end": 539.54,
   "text": "ומאז הוא לא נגע בכסף."
  },
  {
   "start": 540.34,
   "end": 542.68,
   "text": "הוא החביא את הכסף וחיכה להזדמנות להחזיר אותו."
  },
  {
   "start": 543.36,
   "end": 545.92,
   "text": "ועוברת לה שנה, עוברת לה שנה ועוד שנה ועוד שנה."
  },
  {
   "start": 550.78,
   "end": 551.84,
   "text": "ואיסורי המצפון"
  },
  {
   "start": 553.96,
   "end": 555.0,
   "text": "לא נותנים לו מנוחה."
  },
  {
   "start": 556.22,
   "end": 563.7,
   "text": "לא עברה שנה בלי שהוא היה בצער הכבד. איך, איך בעל בית המלון נתן בו את אמונו?"
  },
  {
   "start": 564.16,
   "end": 565.88,
   "text": "האחרון שהוא היה מאמין בו,"
  },
  {
   "start": 567.02,
   "end": 568.9,
   "text": "שהוא היה חושד בו, זה הוא."
  },
  {
   "start": 569.68,
   "end": 570.62,
   "text": "ודווקא הוא גנב."
  },
  {
   "start": 572.56,
   "end": 573.86,
   "text": "ניצל את האמון בגד."
  },
  {
   "start": 576.27,
   "end": 577.59,
   "text": "הרב אני מבקש, הנה הכסף."
  },
  {
   "start": 578.97,
   "end": 579.81,
   "text": "סכום הון עתק,"
  },
  {
   "start": 580.41,
   "end": 583.75,
   "text": "לא נגעתי ולו באגורה אחת."
  },
  {
   "start": 584.65,
   "end": 585.73,
   "text": "כבוד הרב אני מבקש,"
  },
  {
   "start": 586.85,
   "end": 589.69,
   "text": "אנא מכבוד הרב, שהרב יעזור לי להחזיר את זה."
  },
  {
   "start": 590.47,
   "end": 593.67,
   "text": "בלי שהילדים שלי ידעו,"
  },
  {
   "start": 594.55,
   "end": 596.37,
   "text": "בלי שהילדים שלימדתי ידעו."
  },
  {
   "start": 598.62,
   "end": 601.36,
   "text": "והרב מפינצ'וב רואה את התשובה,"
  },
  {
   "start": 602.12,
   "end": 604.78,
   "text": "התשובה האמיתית, רואה את מבט הייסורים"
  },
  {
   "start": 605.68,
   "end": 606.54,
   "text": "של המלמד"
  },
  {
   "start": 609.0,
   "end": 610.84,
   "text": "שחטא,"
  },
  {
   "start": 613.39,
   "end": 614.65,
   "text": "מחבק אותו, מחזק אותו,"
  },
  {
   "start": 616.35,
   "end": 617.67,
   "text": "ומבטיח לו שיהיה בסדר."
  },
  {
   "start": 618.73,
   "end": 619.57,
   "text": "למחרת בבוקר"
  },
  {
   "start": 621.19,
   "end": 622.95,
   "text": "בא רבי אברהם מרדכי מפינצ'וב,"
  },
  {
   "start": 624.15,
   "end": 625.75,
   "text": "מבקש לדבר עם בעל בית המלון."
  },
  {
   "start": 627.59,
   "end": 628.11,
   "text": "אתה זוכר,"
  },
  {
   "start": 628.71,
   "end": 629.35,
   "text": "לפני שנים,"
  },
  {
   "start": 630.13,
   "end": 631.59,
   "text": "נכון שהייתה פה איזה גניבה?"
  },
  {
   "start": 632.99,
   "end": 634.37,
   "text": "נעלם לך כסף?"
  },
  {
   "start": 635.27,
   "end": 635.87,
   "text": "הוא אמר לו כן."
  },
  {
   "start": 637.49,
   "end": 639.05,
   "text": "אתה רוצה את הכסף חזרה?"
  },
  {
   "start": 639.71,
   "end": 640.53,
   "text": "אמר לו איזה שאלה."
  },
  {
   "start": 641.97,
   "end": 642.95,
   "text": "אמר לו בתנאי אחד,"
  },
  {
   "start": 644.63,
   "end": 645.85,
   "text": "אתה לא שואל אותי"
  },
  {
   "start": 646.83,
   "end": 649.15,
   "text": "ולא מהרהר מאיפה הכסף הגיע."
  },
  {
   "start": 651.42,
   "end": 653.24,
   "text": "אמר לו בעל בית המלון, בסדר, כבוד הרב,"
  },
  {
   "start": 654.26,
   "end": 657.22,
   "text": "אם אתה באת מהחוזה מלובלין, הכל יכול להיות."
  },
  {
   "start": 659.74,
   "end": 661.46,
   "text": "רבי אברהם מודכי מפינצ'וב הוציא"
  },
  {
   "start": 662.26,
   "end": 664.98,
   "text": "את צרור הכסף והחזיר אותו לבעלים האמונים שלו,"
  },
  {
   "start": 667.3,
   "end": 671.88,
   "text": "ובעל בית המלון פותח וסופר לא חסרה ולו אגורה אחת."
  },
  {
   "start": 672.88,
   "end": 674.66,
   "text": "הוא החל לרעוד כולו מהתרגשות."
  },
  {
   "start": 675.86,
   "end": 678.04,
   "text": "קם בעל בית עמון ואמר, תדע לך,"
  },
  {
   "start": 679.2,
   "end": 679.8,
   "text": "כבוד הרב,"
  },
  {
   "start": 680.56,
   "end": 683.08,
   "text": "החוזה מלובלין שלח אותך לקבל פה ישועה,"
  },
  {
   "start": 683.66,
   "end": 684.66,
   "text": "הנה זו הישועה שלך."
  },
  {
   "start": 685.6,
   "end": 689.16,
   "text": "הוא חפן בידו סכום כסף רציני ואמר לו, קח,"
  },
  {
   "start": 690.26,
   "end": 691.3,
   "text": "זה השכר שלך,"
  },
  {
   "start": 692.5,
   "end": 693.28,
   "text": "קח את זה, זה בשבילך."
  },
  {
   "start": 694.74,
   "end": 696.26,
   "text": "זו הישועה שהחוזה מלובלין"
  },
  {
   "start": 697.62,
   "end": 698.72,
   "text": "שלח אותך עבורה."
  },
  {
   "start": 708.08,
   "end": 709.0,
   "text": "יומיים אחר כך,"
  },
  {
   "start": 710.0,
   "end": 715.52,
   "text": "רבי אברהם מרדכי מפינצ'וב עושה את כל הדרך חזרה ללובלין."
  },
  {
   "start": 719.66,
   "end": 720.86,
   "text": "כשהוא מגיע ללובלין,"
  },
  {
   "start": 721.82,
   "end": 723.86,
   "text": "כשהוא נכנס אל הקודש פנימה,"
  },
  {
   "start": 724.7,
   "end": 727.34,
   "text": "עוד לפני שהוא מצליח לומר מילה,"
  },
  {
   "start": 728.46,
   "end": 729.46,
   "text": "אמר החוזה,"
  },
  {
   "start": 730.22,
   "end": 732.08,
   "text": "בקול רווי כאב,"
  },
  {
   "start": 732.92,
   "end": 734.54,
   "text": "בקול רווי רגש,"
  },
  {
   "start": 735.34,
   "end": 736.34,
   "text": "דע לך, בני,"
  },
  {
   "start": 737.54,
   "end": 741.0,
   "text": "דע לך, בני, שעוצמת התשובה של המלמד הזה"
  },
  {
   "start": 741.0,
   "end": 745.28,
   "text": "לא נותנת לי מנוח כבר זה זמן רב."
  },
  {
   "start": 747.46,
   "end": 750.16,
   "text": "תדע לך שהרצון הכן אש שלו"
  },
  {
   "start": 751.54,
   "end": 754.64,
   "text": "לא נתן לי לישון זלילות רבים."
  },
  {
   "start": 755.54,
   "end": 757.58,
   "text": "הצער של אותו מלמד, אותו יהודי,"
  },
  {
   "start": 758.28,
   "end": 760.16,
   "text": "טורדת את מנוחתי בלילות."
  },
  {
   "start": 760.9,
   "end": 762.84,
   "text": "תדע לך, רב אברהם מרדכי,"
  },
  {
   "start": 763.68,
   "end": 765.76,
   "text": "יותר משהתכוונתי לטובה שלך,"
  },
  {
   "start": 766.58,
   "end": 767.84,
   "text": "ששלחתי אותך לקרושניק,"
  },
  {
   "start": 768.58,
   "end": 769.92,
   "text": "התכוונתי לטובתו,"
  },
  {
   "start": 770.46,
   "end": 774.12,
   "text": "כדי שסוף סוף יזכה להשלים את התשובה שלו."
  },
  {
   "start": 775.68,
   "end": 779.12,
   "text": "שלחתי אותך, לא בשבילך, בשבילו!"
  },
  {
   "start": 779.72,
   "end": 783.08,
   "text": "ועל הדרך זכית גם אתה."
  },
  {
   "start": 787.85,
   "end": 790.21,
   "text": "התשובה שלו לא נתן לי,"
  },
  {
   "start": 790.73,
   "end": 794.99,
   "text": "לא נתן לי שינה זה חודשים."
  },
  {
   "start": 803.67,
   "end": 804.59,
   "text": "החוזה היה אומר,"
  },
  {
   "start": 805.99,
   "end": 810.53,
   "text": "פושעי ישראל מלאים מצוות כרימון."
  },
  {
   "start": 810.53,
   "end": 820.99,
   "text": "אומרת הגמרא מסכת עירובים דף יט פושעי ישראל מלאים מצוות כרימון אמר החוזה מלובלין למה דווקא כרימון? למה?"
  },
  {
   "start": 822.23,
   "end": 823.19,
   "text": "למה כרימון?"
  },
  {
   "start": 824.87,
   "end": 839.51,
   "text": "אמר החוזה מלובלין כי על רימון אומרת הגמרא מסכת חגיגה דף טו עמוד ב תוכו אכל קליפתו זרק כלומר תוכו הפנימיות שלו היא טובה רק הקליפה"
  },
  {
   "start": 839.51,
   "end": 849.67,
   "text": "החיצוניות היא גרועה לכן תוכו האכל חי קליפתו זרק ככה פושעי ישראל החיצוניות שלהם נראית גרועה"
  },
  {
   "start": 850.45,
   "end": 887.5,
   "text": "נראית לא טובה נראית טמאה אבל הפנימיות הפנימיות טובה נפלאה טהורה נשמה שנתת בי טהורה היא רק צריך לקלף את הקליפה החיצונית נשאר לנו אותה הילה אותה דרך"
  },
  {
   "start": 888.16,
   "end": 890.18,
   "text": "אותה הנהגה, אותו חיוך,"
  },
  {
   "start": 891.44,
   "end": 898.6,
   "text": "אותה קדושה של רבי יצחק יעקב הלוי הורוביץ' מלובלין."
  },
  {
   "start": 899.0,
   "end": 900.9,
   "text": "החוזה מלובלין שאומר לנו,"
  },
  {
   "start": 901.32,
   "end": 901.98,
   "text": "לנו היום,"
  },
  {
   "start": 902.34,
   "end": 903.02,
   "text": "לכולנו,"
  },
  {
   "start": 903.36,
   "end": 905.26,
   "text": "בואו נכיר מה זה יהודי,"
  },
  {
   "start": 905.58,
   "end": 911.4,
   "text": "מהי עוצמה של יהודי, אם יהודי קדוש מהחוזה מלובלין אמר עלינו,"
  },
  {
   "start": 911.8,
   "end": 912.6,
   "text": "על עם ישראל,"
  },
  {
   "start": 912.92,
   "end": 913.8,
   "text": "כל יהודי,"
  },
  {
   "start": 914.38,
   "end": 917.0,
   "text": "כל יהודי, אפילו הרחוק ביותר,"
  },
  {
   "start": 917.0,
   "end": 918.88,
   "text": "מלא מצוות כרימון,"
  },
  {
   "start": 919.72,
   "end": 922.64,
   "text": "יקר בעיני השם, אולי קליפה,"
  },
  {
   "start": 923.06,
   "end": 927.58,
   "text": "קליפה מבחוץ, חיצוניות נראית לא טובה, אבל פנימיות טהורה ונפלאה."
  },
  {
   "start": 928.04,
   "end": 931.42,
   "text": "כמה אנחנו צריכים להצדיק את זה,"
  },
  {
   "start": 931.8,
   "end": 938.24,
   "text": "כמה אנחנו צריכים לקלף מעצמנו את החיצוניות ולהראות לכל העולם את עם ישראל הטהור, עם ישראל."
  }
 ]
}