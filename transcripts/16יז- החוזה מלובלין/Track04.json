{
 "disc": "16יז- החוזה מלובלין",
 "track": "Track04",
 "duration": 1084.176,
 "segments": [
  {
   "start": 1.98,
   "end": 2.7,
   "text": "החוזה מלובלין"
  },
  {
   "start": 3.7,
   "end": 5.92,
   "text": "החוזה מלובלין רואה את הגלות החשוכה,"
  },
  {
   "start": 6.82,
   "end": 7.76,
   "text": "את קשיי העם."
  },
  {
   "start": 8.58,
   "end": 9.84,
   "text": "הוא יודע מה עם ישראל צריכים."
  },
  {
   "start": 11.28,
   "end": 13.38,
   "text": "העם ישראל צריכים גאולה."
  },
  {
   "start": 14.8,
   "end": 17.92,
   "text": "והוא מוכן לעשות את כל המאמצים, ואף יותר,"
  },
  {
   "start": 18.6,
   "end": 20.32,
   "text": "לקרב את הגאולה."
  },
  {
   "start": 20.82,
   "end": 21.96,
   "text": "להחיש אותה."
  },
  {
   "start": 22.26,
   "end": 23.48,
   "text": "לדפוק על הפתח,"
  },
  {
   "start": 25.14,
   "end": 26.48,
   "text": "פתח שערי השמיים."
  },
  {
   "start": 27.58,
   "end": 30.68,
   "text": "ולא רק זה, אלא אפילו לנסות לפרוץ אותם."
  },
  {
   "start": 31.7,
   "end": 33.54,
   "text": "וזה מסוכן."
  },
  {
   "start": 34.64,
   "end": 38.38,
   "text": "לדפוק על פתח הדלת של השמיים עוד ניחא,"
  },
  {
   "start": 39.18,
   "end": 40.02,
   "text": "אבל לפרוץ אותה"
  },
  {
   "start": 40.7,
   "end": 41.36,
   "text": "זה מסוכן."
  },
  {
   "start": 42.78,
   "end": 47.26,
   "text": "החוזה יודע שמשמעות הדבר מלחמה כנגד כל המקטרגים,"
  },
  {
   "start": 47.64,
   "end": 48.96,
   "text": "כנגד כל המונעים,"
  },
  {
   "start": 49.62,
   "end": 52.98,
   "text": "אבל הכל כדאי על מנת להחיש את הגאולה."
  },
  {
   "start": 54.26,
   "end": 55.76,
   "text": "ארבע ניסיונות נעשו,"
  },
  {
   "start": 56.6,
   "end": 57.6,
   "text": "וכולם נכשלו."
  },
  {
   "start": 60.42,
   "end": 61.28,
   "text": "ועכשיו החוזה,"
  },
  {
   "start": 62.24,
   "end": 63.26,
   "text": "החוזה שם את פניו,"
  },
  {
   "start": 63.82,
   "end": 65.04,
   "text": "אל הניסיון החמישי,"
  },
  {
   "start": 65.94,
   "end": 66.98,
   "text": "המסוכן מכולם,"
  },
  {
   "start": 68.04,
   "end": 72.48,
   "text": "ומנסה לאחד מספר צדיקים שבעזרת תפילות,"
  },
  {
   "start": 73.72,
   "end": 77.26,
   "text": "בעזרת תחינות אל השם יתברך, בעזרת כוונות"
  },
  {
   "start": 78.62,
   "end": 82.32,
   "text": "מיוחדות יביאו סוף סוף לגאולת מיליוני יהודים,"
  },
  {
   "start": 83.08,
   "end": 87.1,
   "text": "המחכים בכיליון עיניים זה שנים אלפיים."
  },
  {
   "start": 93.4,
   "end": 94.92,
   "text": "שנת תקעד,"
  },
  {
   "start": 95.64,
   "end": 96.54,
   "text": "חול המועד סוכות,"
  },
  {
   "start": 97.28,
   "end": 98.4,
   "text": "מכה הבעל דבר,"
  },
  {
   "start": 98.4,
   "end": 100.9,
   "text": "משיב הבעל דבר מלחמה,"
  },
  {
   "start": 101.46,
   "end": 102.88,
   "text": "היהודי הקדוש מפשיסחא,"
  },
  {
   "start": 103.3,
   "end": 105.48,
   "text": "היהודי הקדוש מפשיסחא, נפטר!"
  },
  {
   "start": 106.68,
   "end": 109.56,
   "text": "והחוזה מאבד את גדול תלמידיו,"
  },
  {
   "start": 110.4,
   "end": 110.94,
   "text": "אבל הוא לא מוותר."
  },
  {
   "start": 112.52,
   "end": 115.72,
   "text": "הוא מכנס סביבו את רבי קלונימוס מניינשטט,"
  },
  {
   "start": 116.38,
   "end": 117.78,
   "text": "בעל המאור ושמש,"
  },
  {
   "start": 118.2,
   "end": 119.9,
   "text": "את רבי מנחם מנדל מקוסוב,"
  },
  {
   "start": 120.54,
   "end": 122.34,
   "text": "את רבי נפתלי הירץ מברזל,"
  },
  {
   "start": 122.68,
   "end": 124.44,
   "text": "את רבי ישראל מקוז'ניץ,"
  },
  {
   "start": 124.72,
   "end": 126.34,
   "text": "רבי מנחם מנדל מרימנוב,"
  },
  {
   "start": 127.18,
   "end": 131.34,
   "text": "וכל אחד פועל בנפרד בביתו."
  },
  {
   "start": 132.8,
   "end": 137.86,
   "text": "כל אחד יש לו תפקיד. זה מתחיל."
  },
  {
   "start": 139.42,
   "end": 140.26,
   "text": "ואז זה מתחיל."
  },
  {
   "start": 141.62,
   "end": 142.6,
   "text": "מקץ זמן אלובלין,"
  },
  {
   "start": 143.1,
   "end": 145.68,
   "text": "אלובלין מגיע בנו של רבי מנחם מדל מקוסוב,"
  },
  {
   "start": 146.08,
   "end": 147.0,
   "text": "רבי חי מקוסוב,"
  },
  {
   "start": 147.52,
   "end": 148.86,
   "text": "שמספר שאבא שלו,"
  },
  {
   "start": 149.66,
   "end": 150.96,
   "text": "שהיה צריך להגיע ללובלין,"
  },
  {
   "start": 151.32,
   "end": 152.34,
   "text": "לעזור לחוזה,"
  },
  {
   "start": 152.76,
   "end": 153.86,
   "text": "אינו יכול להגיע."
  },
  {
   "start": 156.86,
   "end": 160.5,
   "text": "וכך החוזה מלובלין נותר בלי רבי מנחם מדל מקוסוב."
  },
  {
   "start": 162.1,
   "end": 162.68,
   "text": "ראש השנה,"
  },
  {
   "start": 163.88,
   "end": 164.5,
   "text": "לובלין,"
  },
  {
   "start": 165.14,
   "end": 167.28,
   "text": "החוזה מייחד ייחודים נוראים."
  },
  {
   "start": 168.96,
   "end": 172.18,
   "text": "ועתה הוא מסמן, קול השופר צריך להישמע."
  },
  {
   "start": 173.86,
   "end": 174.52,
   "text": "והתוקע,"
  },
  {
   "start": 175.14,
   "end": 176.18,
   "text": "אותו תוקע מנוסה,"
  },
  {
   "start": 176.96,
   "end": 179.16,
   "text": "אותו תוקע ירא שמיים, מומחה."
  },
  {
   "start": 180.7,
   "end": 182.68,
   "text": "שם את השופר בפיו, ו..."
  },
  {
   "start": 183.64,
   "end": 185.24,
   "text": "שום תקיעה לא יוצאת."
  },
  {
   "start": 186.26,
   "end": 186.98,
   "text": "ושוב הוא מנסה."
  },
  {
   "start": 187.6,
   "end": 188.06,
   "text": "ושוב."
  },
  {
   "start": 189.1,
   "end": 189.6,
   "text": "וכלום."
  },
  {
   "start": 189.6,
   "end": 192.62,
   "text": "והחוזה מתקרב, בנחישות."
  },
  {
   "start": 193.56,
   "end": 194.54,
   "text": "הוא יודע שהוא נלחם,"
  },
  {
   "start": 195.28,
   "end": 196.46,
   "text": "אבל הוא לא מתכוון לוותר."
  },
  {
   "start": 197.56,
   "end": 201.9,
   "text": "אמר החוזה מלובלין, הקדוש ברוך הוא אמר לתקוע בשופר בראש השנה."
  },
  {
   "start": 202.84,
   "end": 205.38,
   "text": "התורה הקדושה אמרה לתקוע בראש השנה,"
  },
  {
   "start": 205.98,
   "end": 207.24,
   "text": "ואתה מעכב."
  },
  {
   "start": 208.2,
   "end": 211.44,
   "text": "הקדוש ברוך הוא אומר לתקוע שופר בראש השנה."
  },
  {
   "start": 211.78,
   "end": 214.04,
   "text": "התורה הקדושה אומרת לתקוע בראש השנה,"
  },
  {
   "start": 214.48,
   "end": 215.78,
   "text": "ואתה מעכב."
  },
  {
   "start": 217.32,
   "end": 219.1,
   "text": "ואז התקיעות החלו לצאת,"
  },
  {
   "start": 219.6,
   "end": 220.94,
   "text": "כאילו נפתח השסדום,"
  },
  {
   "start": 228.89,
   "end": 229.21,
   "text": "רחוק משם,"
  },
  {
   "start": 230.27,
   "end": 233.45,
   "text": "בקוז'ניץ, פועל הבעל דבר בכל הכוח."
  },
  {
   "start": 235.15,
   "end": 238.21,
   "text": "המגיד הקדוש נופל למשכב קשה."
  },
  {
   "start": 241.09,
   "end": 243.57,
   "text": "כך עוברים להם עשרת ימי תשובה."
  },
  {
   "start": 244.37,
   "end": 247.77,
   "text": "ליל יום הכיפורים, קוז'ניץ, ביתו של המגיד."
  },
  {
   "start": 248.29,
   "end": 253.97,
   "text": "המגיד שוכב חולה אנוש ולפתע הוא מתנער ובכוחות על-אנושיים זועק"
  },
  {
   "start": 254.65,
   "end": 255.33,
   "text": "בליל יום הכיפורים."
  },
  {
   "start": 256.63,
   "end": 258.33,
   "text": "המגיד הקדוש מקוז'ניץ"
  },
  {
   "start": 259.29,
   "end": 261.13,
   "text": "יודע שהבעל דבר נלחם,"
  },
  {
   "start": 261.85,
   "end": 262.75,
   "text": "אבל הוא לא מתכוון לוותר."
  },
  {
   "start": 264.41,
   "end": 264.93,
   "text": "הוא קם,"
  },
  {
   "start": 265.97,
   "end": 268.21,
   "text": "ובכוחות על-אנושיים זועק,"
  },
  {
   "start": 269.37,
   "end": 271.01,
   "text": "ריבונו של עולם,"
  },
  {
   "start": 271.85,
   "end": 275.17,
   "text": "אולי תאמר כבר סלחתי כדבריך,"
  },
  {
   "start": 276.15,
   "end": 277.57,
   "text": "ותחיש את הגאולה?"
  },
  {
   "start": 278.15,
   "end": 280.01,
   "text": "מה, חסרים צדיקים בעולם?"
  },
  {
   "start": 280.85,
   "end": 283.47,
   "text": "הלו יש לך את רבי מנחם מנדל מרימנוב."
  },
  {
   "start": 285.33,
   "end": 287.99,
   "text": "אולי חסרים רורים ותומים בעולם?"
  },
  {
   "start": 288.61,
   "end": 290.07,
   "text": "רוח הקודש בעולם."
  },
  {
   "start": 290.63,
   "end": 292.35,
   "text": "יש לדעתך את החוזה מלובלין,"
  },
  {
   "start": 292.87,
   "end": 294.83,
   "text": "מעיר כמו האורים ותומים."
  },
  {
   "start": 295.91,
   "end": 298.93,
   "text": "ואולי אין לך בעלי תשובה, ריבונו של עולם?"
  },
  {
   "start": 299.57,
   "end": 302.97,
   "text": "אז הריני ישראל קורניצר מקוז'ניץ, אני,"
  },
  {
   "start": 303.53,
   "end": 304.95,
   "text": "אמר המגיד מקוז'ניץ,"
  },
  {
   "start": 305.35,
   "end": 311.83,
   "text": "הריני ישראל מקוז'ניץ, מוכן ומזומן לעשות תשובה עבור כל עם ישראל."
  },
  {
   "start": 312.43,
   "end": 314.47,
   "text": "בוכה המגיד מקוז'ניץ."
  },
  {
   "start": 316.13,
   "end": 316.85,
   "text": "באותו זמן,"
  },
  {
   "start": 317.51,
   "end": 318.89,
   "text": "ממש באותו רגע בלובלין,"
  },
  {
   "start": 319.23,
   "end": 320.07,
   "text": "החוזה מחייך,"
  },
  {
   "start": 320.89,
   "end": 323.91,
   "text": "מי ייתן ונתבשר בשרות טובות מקוז'ניץ."
  },
  {
   "start": 324.45,
   "end": 327.15,
   "text": "החולה הרעיש את כל העולמות!"
  },
  {
   "start": 327.95,
   "end": 332.15,
   "text": "אומר החוזה מלובלין, החולה, החולה הרעיש את כל העולמות."
  },
  {
   "start": 332.71,
   "end": 346.43,
   "text": "הפסוקות קוז'ניץ"
  },
  {
   "start": 347.27,
   "end": 348.09,
   "text": "הבל כבד"
  },
  {
   "start": 348.93,
   "end": 358.98,
   "text": "הבעל דבר היכה קשות המגיד מי קוז'ניץ נלקח לבית עולמו בלובלין."
  },
  {
   "start": 358.98,
   "end": 365.84,
   "text": "הבעל דבר מצליח להסתיר את מותו של המגיד מעיני החוזה."
  },
  {
   "start": 366.5,
   "end": 373.08,
   "text": "החוזה מלובלין לא יודע מעין מסך אפל לגבי קוז'ניץ. הוא לא יודע שהמגיד מקוז'ניץ נפטר."
  },
  {
   "start": 374.88,
   "end": 377.2,
   "text": "אבל החוזה בכל אופן מרגיש שהמצב מסוכן."
  },
  {
   "start": 377.82,
   "end": 378.9,
   "text": "הוא אומר לתלמידים שלו"
  },
  {
   "start": 379.4,
   "end": 380.8,
   "text": "אורבים לי בכל פינה"
  },
  {
   "start": 384.21,
   "end": 386.57,
   "text": "כי אגור אותי מפני האף והחמאה."
  },
  {
   "start": 388.53,
   "end": 389.09,
   "text": "ואז מגיע"
  },
  {
   "start": 390.57,
   "end": 391.79,
   "text": "לילה שמחה טובה."
  },
  {
   "start": 401.94,
   "end": 402.76,
   "text": "שמחה כזו"
  },
  {
   "start": 403.74,
   "end": 405.04,
   "text": "לא נראתה בלובלין."
  },
  {
   "start": 405.9,
   "end": 406.7,
   "text": "איזו שמחה."
  },
  {
   "start": 407.22,
   "end": 408.36,
   "text": "והחסידים רוקדים,"
  },
  {
   "start": 408.9,
   "end": 409.98,
   "text": "רוקדים ושרים,"
  },
  {
   "start": 410.58,
   "end": 412.1,
   "text": "יחד עם החוזה מלובלין."
  },
  {
   "start": 412.7,
   "end": 414.24,
   "text": "אי אפשר לעצור את השמחה."
  },
  {
   "start": 414.94,
   "end": 419.22,
   "text": "אתה מרגיש שיש איזה משהו מיוחד שצריך לקרות הלילה."
  },
  {
   "start": 420.72,
   "end": 422.16,
   "text": "טוב או רע אתה לא יודע."
  },
  {
   "start": 422.78,
   "end": 425.18,
   "text": "אתה יודע רק שמחר"
  },
  {
   "start": 427.7,
   "end": 435.13,
   "text": "יהיה יום חדש חדש לגמרי, איש מבין החוגגים."
  },
  {
   "start": 436.09,
   "end": 438.91,
   "text": "לוחש בסכנה הקרבה,"
  },
  {
   "start": 440.03,
   "end": 441.37,
   "text": "הקרבה לה ועוטפת"
  },
  {
   "start": 442.21,
   "end": 443.31,
   "text": "את שערי לובלין."
  },
  {
   "start": 446.76,
   "end": 448.2,
   "text": "הבעל דבר לא נח,"
  },
  {
   "start": 449.84,
   "end": 452.48,
   "text": "ובבית המדרש מדרבן החוזה את הרוקדים."
  },
  {
   "start": 453.18,
   "end": 455.24,
   "text": "אם יהיה שמחת תורה שמח,"
  },
  {
   "start": 455.68,
   "end": 458.7,
   "text": "יהיה לנו גם תשעה באב שמח לשנוח, לרקוד."
  },
  {
   "start": 459.16,
   "end": 461.26,
   "text": "אם נצליח שמחת תורה יהיה שמח,"
  },
  {
   "start": 461.96,
   "end": 463.3,
   "text": "גם תשעה באב יהיה שמח."
  },
  {
   "start": 470.2,
   "end": 471.06,
   "text": "בבית המדרש,"
  },
  {
   "start": 472.82,
   "end": 473.68,
   "text": "מקץ שעה קלה,"
  },
  {
   "start": 474.56,
   "end": 477.02,
   "text": "איש לא שם לב, כולם היו שקועים בריקודים ובשמחה,"
  },
  {
   "start": 477.76,
   "end": 481.28,
   "text": "שהחוזה מלובלין עזב את רחבת הריקודים."
  },
  {
   "start": 484.88,
   "end": 488.04,
   "text": "החוזה חש בגלי עייפות שעופפים אותו."
  },
  {
   "start": 488.5,
   "end": 489.3,
   "text": "הוא היה צריך מנוחה,"
  },
  {
   "start": 490.04,
   "end": 491.34,
   "text": "מנוחה קצרה והוא ימשיך."
  },
  {
   "start": 492.6,
   "end": 494.28,
   "text": "הוא עולה לחדר שלו לנוח."
  },
  {
   "start": 506.82,
   "end": 508.6,
   "text": "הוא פונה לרבנית ומבקש ממנה,"
  },
  {
   "start": 509.48,
   "end": 512.44,
   "text": "הייתי בחדר כשאני ישן,"
  },
  {
   "start": 513.2,
   "end": 514.82,
   "text": "בשום פנים ואופן."
  },
  {
   "start": 515.94,
   "end": 517.12,
   "text": "אל תעזבי את החדר."
  },
  {
   "start": 517.82,
   "end": 518.38,
   "text": "את שומעת?"
  },
  {
   "start": 519.54,
   "end": 522.86,
   "text": "את איתי בחדר כל זמן שאני ישן."
  },
  {
   "start": 523.88,
   "end": 525.0,
   "text": "לא משנה מה קורה,"
  },
  {
   "start": 525.68,
   "end": 527.6,
   "text": "את לא עוזבת את החדר."
  },
  {
   "start": 534.44,
   "end": 536.24,
   "text": "יותר מזה הוא לא יכל להסביר לי."
  },
  {
   "start": 537.48,
   "end": 542.28,
   "text": "יותר מזה לא הייתה לו רשות לפרט בפניה."
  },
  {
   "start": 556.44,
   "end": 557.06,
   "text": "ארבנית!"
  },
  {
   "start": 558.92,
   "end": 559.94,
   "text": "עיטתה אוזן."
  },
  {
   "start": 560.68,
   "end": 562.1,
   "text": "קול בכי נשמע מעבר לדלת."
  },
  {
   "start": 563.02,
   "end": 564.64,
   "text": "בכי של ילד קטן שבוכה,"
  },
  {
   "start": 566.06,
   "end": 568.2,
   "text": "זועק ומשווע לעזרה."
  },
  {
   "start": 569.06,
   "end": 572.48,
   "text": "הלב הרחום שלה, לב של אמא לא נתן לה מנוחה."
  },
  {
   "start": 573.22,
   "end": 574.54,
   "text": "טוב, רק לרגע היא תצא,"
  },
  {
   "start": 575.2,
   "end": 579.46,
   "text": "תרגיע אותו ותחזור אל בעלה הישן, רק רגע."
  },
  {
   "start": 580.16,
   "end": 582.06,
   "text": "והרבנית יצאה מהחדר."
  },
  {
   "start": 583.76,
   "end": 584.84,
   "text": "המסדרון היה ריק,"
  },
  {
   "start": 585.68,
   "end": 587.12,
   "text": "היא מחפשת את הילד הבוכה,"
  },
  {
   "start": 589.3,
   "end": 589.94,
   "text": "אין כלום."
  },
  {
   "start": 591.84,
   "end": 592.98,
   "text": "אין נפש חיה,"
  },
  {
   "start": 595.36,
   "end": 604.82,
   "text": "ובינתיים האפלה עטפה את החדר. האפלה עטפה"
  },
  {
   "start": 604.84,
   "end": 605.6,
   "text": "את החדר."
  },
  {
   "start": 606.92,
   "end": 608.2,
   "text": "אותו זמן בעיר קרקע,"
  },
  {
   "start": 609.08,
   "end": 613.2,
   "text": "אבן כבדה מנפצת לפתע את חלונו של בעל המאור ושמש."
  },
  {
   "start": 614.4,
   "end": 619.94,
   "text": "אבן כבדה מנפצת את חלונו של בעל המאור ושמש ונוחתת לידו."
  },
  {
   "start": 621.18,
   "end": 622.24,
   "text": "רבי קלונימוס,"
  },
  {
   "start": 622.86,
   "end": 625.42,
   "text": "בעל המאור ושמש, תלמידו של החוזה,"
  },
  {
   "start": 626.06,
   "end": 626.9,
   "text": "פרץ בבכי."
  },
  {
   "start": 627.54,
   "end": 629.8,
   "text": "מי יודע מה קורה אצל הרבי בלובלין?"
  },
  {
   "start": 630.3,
   "end": 632.46,
   "text": "מי יודע מה קורה אצל החוזה מלובלין?"
  },
  {
   "start": 632.46,
   "end": 660.35,
   "text": "דממה השתררה לה בלובלין"
  },
  {
   "start": 662.65,
   "end": 664.51,
   "text": "צעקות השבר של הרבנית."
  },
  {
   "start": 666.41,
   "end": 667.73,
   "text": "מלובלין נהדהדו,"
  },
  {
   "start": 668.33,
   "end": 670.19,
   "text": "ידהדו להם והחרידו את הרוקדים."
  },
  {
   "start": 671.97,
   "end": 675.65,
   "text": "היא ניצבה עמומה מול המיטה הריקה של החוזה."
  },
  {
   "start": 676.81,
   "end": 678.01,
   "text": "רק לדקה עזבה,"
  },
  {
   "start": 678.99,
   "end": 679.49,
   "text": "חזרה,"
  },
  {
   "start": 680.69,
   "end": 681.39,
   "text": "והוא נעלם,"
  },
  {
   "start": 682.03,
   "end": 682.47,
   "text": "איננו."
  },
  {
   "start": 685.89,
   "end": 697.56,
   "text": "וכל התלמידים יוצאים לחפש את החוזה מלובלין."
  },
  {
   "start": 697.96,
   "end": 699.12,
   "text": "שעות של חיפושים,"
  },
  {
   "start": 700.28,
   "end": 702.78,
   "text": "שם בחוץ, בכל מקום,"
  },
  {
   "start": 703.54,
   "end": 704.62,
   "text": "מעלין חרס."
  },
  {
   "start": 706.5,
   "end": 708.1,
   "text": "רבי אליעזר מחמלניק"
  },
  {
   "start": 714.99,
   "end": 716.39,
   "text": "מסתובב בחושך,"
  },
  {
   "start": 717.01,
   "end": 719.29,
   "text": "מנסה לקרוע בעיניו את העלטה,"
  },
  {
   "start": 719.67,
   "end": 721.23,
   "text": "מחפש את רבו ומורו,"
  },
  {
   "start": 723.47,
   "end": 724.25,
   "text": "ואז הוא ראה אותה."
  },
  {
   "start": 725.47,
   "end": 725.81,
   "text": "דמות"
  },
  {
   "start": 726.89,
   "end": 727.79,
   "text": "מכווצת לה"
  },
  {
   "start": 728.45,
   "end": 730.45,
   "text": "במרחק של כ-25 מטר."
  },
  {
   "start": 731.77,
   "end": 732.31,
   "text": "הוא התקרב,"
  },
  {
   "start": 732.31,
   "end": 735.63,
   "text": "שומע גניחות כאב חלושות"
  },
  {
   "start": 736.81,
   "end": 738.69,
   "text": "ואז הוא פרץ בזעקות"
  },
  {
   "start": 740.41,
   "end": 761.35,
   "text": "וכולם הגיעו הם הרימו את הדמות הם הרימו את החוזה מלובלין ושמעו אותו אומר תיקון חצות זה היה הזמן המדויק של תיקון חצות ואז אמר החוזה למה למה לא הודיעו לי שהמגיד מקוז'ניץ נפטר"
  },
  {
   "start": 762.49,
   "end": 773.93,
   "text": "למה לא הודיעו לי שהמגיד מיקוז'ניץ נפטר עד היום?"
  },
  {
   "start": 777.14,
   "end": 782.9,
   "text": "עד היום איש לא יכול להבין איך מחלון כל כך צר"
  },
  {
   "start": 782.9,
   "end": 788.54,
   "text": "כמו זה שבחדרו של החוזה ניתן להוציא גוף של אדם."
  },
  {
   "start": 789.52,
   "end": 792.16,
   "text": "אי אפשר להוציא משם גוף של אדם."
  },
  {
   "start": 792.94,
   "end": 793.98,
   "text": "איך החוזה?"
  },
  {
   "start": 794.68,
   "end": 795.66,
   "text": "מה קרה שם?"
  },
  {
   "start": 796.2,
   "end": 798.68,
   "text": "איש לא מבין, איש לא יודע."
  },
  {
   "start": 799.62,
   "end": 800.84,
   "text": "פשוט כוח אפל,"
  },
  {
   "start": 801.52,
   "end": 802.86,
   "text": "כוח אפל והרסני,"
  },
  {
   "start": 803.28,
   "end": 812.06,
   "text": "אחז ברב שסיכן את עצמו למען עם ישראל גם במחיר חייו וזרק אותו אל מוות ודאי."
  },
  {
   "start": 828.31,
   "end": 836.07,
   "text": "ימים מספר אחר כך החוזה פקח את עיניו בקול שקט."
  },
  {
   "start": 836.87,
   "end": 839.97,
   "text": "הוא אמר למה לא אמרתם לי?"
  },
  {
   "start": 840.79,
   "end": 844.75,
   "text": "למה לא אמרתם לי שהמגיד מקוז'ניץ נפטר בערב סוכות?"
  },
  {
   "start": 844.97,
   "end": 846.31,
   "text": "לא הייתי מתחיל בכלל,"
  },
  {
   "start": 847.01,
   "end": 849.77,
   "text": "לא הייתי מתחיל בכלל בניסיונות להכחיש את הגאולה."
  },
  {
   "start": 850.59,
   "end": 852.49,
   "text": "צריך הרבה כוחות להכחיש את הגאולה."
  },
  {
   "start": 853.45,
   "end": 854.77,
   "text": "תדעו לכם בניי,"
  },
  {
   "start": 855.07,
   "end": 861.57,
   "text": "לולא בא המגיד מקוז'ניץ מן העולם העליון ופרס את טליתו בפניי כשנפלתי,"
  },
  {
   "start": 862.19,
   "end": 864.99,
   "text": "איני יודע מה היה קורה לי מאותה נפילה."
  },
  {
   "start": 865.95,
   "end": 873.61,
   "text": "אילולא בא המגיד מקוז'ניץ מן העולם העליון ופרס את הטלית שלו לפניי."
  },
  {
   "start": 874.75,
   "end": 878.97,
   "text": "אני לא יודע מה יהיה נשאר לי מאותה נפילה."
  },
  {
   "start": 880.87,
   "end": 882.17,
   "text": "אוי, נאנח החוזה,"
  },
  {
   "start": 882.75,
   "end": 884.43,
   "text": "אם היהודי הקדוש היה בחיים,"
  },
  {
   "start": 885.07,
   "end": 886.47,
   "text": "לא היה קורה את מה שקרה."
  },
  {
   "start": 888.67,
   "end": 889.19,
   "text": "וכך,"
  },
  {
   "start": 889.97,
   "end": 894.6,
   "text": "משמחת תורה ועד תשעה באב,"
  },
  {
   "start": 895.22,
   "end": 896.94,
   "text": "שוכב לו החוזה מלובלין,"
  },
  {
   "start": 897.7,
   "end": 899.86,
   "text": "נאנח ונאנק בייסוריו."
  },
  {
   "start": 900.84,
   "end": 901.76,
   "text": "עד תשעה באב."
  },
  {
   "start": 903.32,
   "end": 905.76,
   "text": "עד תשעה באב, חצות היום."
  },
  {
   "start": 905.76,
   "end": 915.78,
   "text": "אז הוא קרא לכולם והחל לקרוא בקול שמע ישראל אדוני אלוהינו אדוני אחד"
  },
  {
   "start": 916.32,
   "end": 931.67,
   "text": "כך כשפניו בוערות באש של קדושה יצאתה נשמתו הגדולה בטהרה וחושך ירד על העולם"
  },
  {
   "start": 932.51,
   "end": 937.07,
   "text": "רבי שמחה בוני מפשיסחא היה עם החסידים שלו בפשיסחא"
  },
  {
   "start": 937.07,
   "end": 940.89,
   "text": "לפתע הוא זעק, הרבי איננו, הרבי איננו."
  },
  {
   "start": 943.1,
   "end": 945.44,
   "text": "רבי יוסף ברוך, היהודי הטוב מניינשטט,"
  },
  {
   "start": 945.86,
   "end": 947.8,
   "text": "תלמידו של החוזה היה בו גורליץ'."
  },
  {
   "start": 948.54,
   "end": 949.3,
   "text": "שם בגורליץ',"
  },
  {
   "start": 949.72,
   "end": 951.92,
   "text": "לפתע ניגש אליו עיקר גוי ואמר לו בפולנית,"
  },
  {
   "start": 952.58,
   "end": 953.8,
   "text": "תדע לך, יהודי,"
  },
  {
   "start": 954.54,
   "end": 955.64,
   "text": "הרבי נפטר."
  },
  {
   "start": 957.75,
   "end": 961.97,
   "text": "כך הודיעו לתלמידיו של החוזה בכל מקום מן השמיים על פטירתו של הרב."
  },
  {
   "start": 964.81,
   "end": 966.81,
   "text": "אמר רבי נפתלי צבי מרופשיץ,"
  },
  {
   "start": 967.67,
   "end": 971.57,
   "text": "אני לא מבין איך נפטר החוזה מלובלין והעולם לא נכריו."
  },
  {
   "start": 972.75,
   "end": 980.79,
   "text": "רבי שלומי בלז, האדמו״ר מבלז אמר מי שהכיר את הרבי יכול לראות עד היכן בשר ודם יכול להגיע."
  },
  {
   "start": 982.43,
   "end": 983.67,
   "text": "רבי אליעזר מג'יטקוב"
  },
  {
   "start": 984.31,
   "end": 996.73,
   "text": "רבי אליעזר מג'יטקוב אמר משעה שנפטר הרב החוזה מלובלין שוב אין רוח הקודש בעולם ומי שלא ראה את הרב לא ראה רבי יהודי מהעולם."
  },
  {
   "start": 998.15,
   "end": 1000.93,
   "text": "הרבי מגור, האדמו״ר מגור הראשון רבי יצחק מאיר מגור"
  },
  {
   "start": 1000.93,
   "end": 1009.97,
   "text": "אמר כל רב קרוי על שם מקומו ולרבנו החוזה קראו רבי סתם"
  },
  {
   "start": 1009.97,
   "end": 1017.39,
   "text": "כי הוא רבי עד לימות המשיח כי הוא הרבי עד לימות המשיח כי הוא הרבי עד לימות המשיח"
  },
  {
   "start": 1017.73,
   "end": 1028.99,
   "text": "ורבי יצחק אייזיק מקומרנה רבי יצחק אייזיק מקומרנה אמר בעיניי ראיתי אש מתלהטת מעל ראשו ואור מאיר בחלל חדרו"
  },
  {
   "start": 1028.99,
   "end": 1040.16,
   "text": "כך הסתיימה לה מסכת חייו של יהודי קדוש שהשאיר את חותמו בעולם החוזה מלובלין."
  }
 ]
}