{
 "disc": "32ר- כבוד שמים",
 "track": "Track01",
 "duration": 361.176,
 "segments": [
  {
   "start": 1.33,
   "end": 14.37,
   "text": "אנחנו נמצאים היום בדור דור של שמוצף במידע."
  },
  {
   "start": 15.71,
   "end": 16.53,
   "text": "על הכל יודעים,"
  },
  {
   "start": 17.63,
   "end": 18.55,
   "text": "על הכל שומעים."
  },
  {
   "start": 21.22,
   "end": 23.76,
   "text": "תקשורת בעוצמה אדירה בכל רחבי העולם."
  },
  {
   "start": 26.06,
   "end": 28.76,
   "text": "רשת של מידע מציפה את הכל."
  },
  {
   "start": 29.86,
   "end": 30.94,
   "text": "על הכל אנחנו יודעים."
  },
  {
   "start": 32.06,
   "end": 32.74,
   "text": "רק על עצמנו."
  },
  {
   "start": 34.1,
   "end": 35.14,
   "text": "רק על עצמנו לא יודעים."
  },
  {
   "start": 43.41,
   "end": 44.33,
   "text": "בואו בעזרת השם."
  },
  {
   "start": 45.61,
   "end": 46.39,
   "text": "בואו בעזרת השם."
  },
  {
   "start": 47.01,
   "end": 48.29,
   "text": "נניע את מנועי העולם,"
  },
  {
   "start": 49.57,
   "end": 50.75,
   "text": "את אותם מנועים גדולים"
  },
  {
   "start": 52.13,
   "end": 53.39,
   "text": "של כל העולם כולו,"
  },
  {
   "start": 54.41,
   "end": 54.99,
   "text": "ונחזור"
  },
  {
   "start": 56.15,
   "end": 57.29,
   "text": "אל המקור שלנו,"
  },
  {
   "start": 58.61,
   "end": 59.75,
   "text": "אל השורש שלנו,"
  },
  {
   "start": 60.47,
   "end": 61.17,
   "text": "אל ההתחלה,"
  },
  {
   "start": 63.57,
   "end": 65.11,
   "text": "בו נלמד להכיר את עצמנו."
  },
  {
   "start": 66.33,
   "end": 69.31,
   "text": "כשאנחנו אומרים יהודי, כשאומרים יהודייה,"
  },
  {
   "start": 70.27,
   "end": 71.39,
   "text": "מה זה, מי זה?"
  },
  {
   "start": 72.01,
   "end": 72.51,
   "text": "מי זה אתה?"
  },
  {
   "start": 73.37,
   "end": 73.85,
   "text": "מי זו את?"
  },
  {
   "start": 74.39,
   "end": 74.89,
   "text": "מי זה אני?"
  },
  {
   "start": 75.47,
   "end": 76.39,
   "text": "מי זה אנחנו כולנו?"
  },
  {
   "start": 79.16,
   "end": 80.48,
   "text": "אתם יודעים, בבריאת העולם."
  },
  {
   "start": 81.56,
   "end": 86.16,
   "text": "בבריאת העולם מכל הנבראים היה יצור אחד,"
  },
  {
   "start": 86.68,
   "end": 88.58,
   "text": "נברא אחד נעלה מכולם."
  },
  {
   "start": 89.42,
   "end": 90.84,
   "text": "קראו לו אדם, אדם הראשון."
  },
  {
   "start": 93.21,
   "end": 97.05,
   "text": "והוא היה בדרגה עליונה מעל כולם,"
  },
  {
   "start": 98.19,
   "end": 101.11,
   "text": "דרגה שאי אפשר לשער עד שהוא חטא."
  },
  {
   "start": 101.93,
   "end": 102.49,
   "text": "כשהוא חטא,"
  },
  {
   "start": 103.43,
   "end": 106.59,
   "text": "החטא גרם לירידה חדה מבמדרגות האדם."
  },
  {
   "start": 108.03,
   "end": 108.95,
   "text": "ואז צריך לדעת"
  },
  {
   "start": 110.31,
   "end": 113.13,
   "text": "שבורא העולם נתן בחירה חופשית לכולם,"
  },
  {
   "start": 114.29,
   "end": 116.71,
   "text": "לכל העולם, לכל המין האנושי."
  },
  {
   "start": 117.75,
   "end": 120.73,
   "text": "בחירה חופשית כל מי שרוצה יכול לקחת."
  },
  {
   "start": 121.97,
   "end": 126.63,
   "text": "כל מי שרוצה יכול לשאוף ולהתעלות אל המדרגה העליונה."
  },
  {
   "start": 129.38,
   "end": 132.42,
   "text": "וכך מהאדם הראשון עד אור הפלגה."
  },
  {
   "start": 134.08,
   "end": 136.06,
   "text": "ממתין הקדוש ברחו לאדם."
  },
  {
   "start": 137.54,
   "end": 138.88,
   "text": "שולח צדיקים."
  },
  {
   "start": 138.88,
   "end": 142.0,
   "text": "לכוון אותם אל דרך האמת."
  },
  {
   "start": 145.94,
   "end": 147.54,
   "text": "חנוך, מתושה לך."
  },
  {
   "start": 154.24,
   "end": 156.68,
   "text": "כך היה עד הזמן, הזמן שהוקצב."
  },
  {
   "start": 157.82,
   "end": 159.88,
   "text": "עד 1996 לבריאה."
  },
  {
   "start": 161.0,
   "end": 162.4,
   "text": "זה הזמן של דור הפלגה."
  },
  {
   "start": 163.9,
   "end": 164.58,
   "text": "ואז,"
  },
  {
   "start": 165.42,
   "end": 166.64,
   "text": "אז נסתם הגולל."
  },
  {
   "start": 170.38,
   "end": 172.78,
   "text": "בעולם החליט."
  },
  {
   "start": 173.26,
   "end": 174.68,
   "text": "בעולם ראה כל המין האנושי."
  },
  {
   "start": 175.3,
   "end": 177.1,
   "text": "כולם נמצאים במדרגה שפלה."
  },
  {
   "start": 177.48,
   "end": 178.86,
   "text": "לא שאפו ולא התעלו."
  },
  {
   "start": 179.72,
   "end": 181.52,
   "text": "לבד מאדם אחד,"
  },
  {
   "start": 182.18,
   "end": 185.1,
   "text": "לבד מאחד שהתעלם מעל כולם."
  },
  {
   "start": 186.62,
   "end": 188.1,
   "text": "קראו לו אברהם."
  },
  {
   "start": 190.18,
   "end": 195.56,
   "text": "אברהם היה היחידי ששאף ושהצליח."
  },
  {
   "start": 196.7,
   "end": 197.64,
   "text": "אברהם העברי,"
  },
  {
   "start": 198.72,
   "end": 204.22,
   "text": "כי הוא היה מעבר אחד של הנהר וכל העולם מן העבר השני."
  },
  {
   "start": 205.02,
   "end": 206.78,
   "text": "הוא היה מעבר אחד של העולם,"
  },
  {
   "start": 207.32,
   "end": 210.68,
   "text": "וכל העולם מן העבר השני, לכן נקרא עברי."
  },
  {
   "start": 211.38,
   "end": 213.7,
   "text": "הוא היה האדם היחידי"
  },
  {
   "start": 215.5,
   "end": 218.94,
   "text": "שהצליח לעלות במסילה עולה בית כלא."
  },
  {
   "start": 220.06,
   "end": 222.92,
   "text": "ואז העולם נתחלק לראשונה לשבעים אומות."
  },
  {
   "start": 224.16,
   "end": 224.8,
   "text": "שבעים אומות."
  },
  {
   "start": 225.76,
   "end": 226.34,
   "text": "כל אחד,"
  },
  {
   "start": 227.04,
   "end": 229.78,
   "text": "כל אומה, על פי אופייה ומהותה."
  },
  {
   "start": 234.57,
   "end": 235.27,
   "text": "ושם,"
  },
  {
   "start": 235.85,
   "end": 236.69,
   "text": "שם מעל כולם,"
  },
  {
   "start": 237.57,
   "end": 239.77,
   "text": "התנוססה לה האומה העברית."
  },
  {
   "start": 241.41,
   "end": 246.55,
   "text": "כנסת ישראל מעל כולם בדרגה עליונה וגבוהה,"
  },
  {
   "start": 250.79,
   "end": 258.27,
   "text": "ואפילו האדם הרחוק ביותר מישראל ובפוטנציה יכול להגיע לדרגות גבוהות."
  },
  {
   "start": 261.28,
   "end": 266.54,
   "text": "לבני אומות העולם ניתנה הזדמנות להתגייר ולהצטרף לעם קודש."
  },
  {
   "start": 267.58,
   "end": 269.24,
   "text": "העולם נתן הזדמנות שווה לכולם,"
  },
  {
   "start": 269.96,
   "end": 270.9,
   "text": "לכל הנשמות,"
  },
  {
   "start": 271.44,
   "end": 283.7,
   "text": "לכל השורשים להוכיח את עצמם לרצות את השם היחידי היחידי שנשא עיניים אל אבא שבשמיים היחידי שבחר בקדוש ברוך הוא בדרך האמת"
  },
  {
   "start": 284.36,
   "end": 285.42,
   "text": "זה היה אברהם אבינו"
  },
  {
   "start": 287.38,
   "end": 299.18,
   "text": "וממנו נסתלה דרך לעם שלם עכשיו נבין למה אנחנו עם יותר מצוות"
  },
  {
   "start": 301.02,
   "end": 312.89,
   "text": "ועם הרבה יותר עולם הבא והרבה יותר שכר כי הכל מתחיל שם"
  },
  {
   "start": 313.65,
   "end": 315.07,
   "text": "אי שם בשורש נשמתנו,"
  },
  {
   "start": 316.31,
   "end": 319.75,
   "text": "באותה נשמה שממנה נחצבנו כולנו,"
  },
  {
   "start": 323.83,
   "end": 325.73,
   "text": "מאותו אבא גדול אברהם אבינו,"
  },
  {
   "start": 326.35,
   "end": 328.47,
   "text": "שכשהוא בחר בדרך השם,"
  },
  {
   "start": 330.52,
   "end": 332.64,
   "text": "הוא קבע את העתיד של כולנו."
  },
  {
   "start": 334.88,
   "end": 336.18,
   "text": "ולנו מה נשאר יותר רק?"
  },
  {
   "start": 336.84,
   "end": 339.0,
   "text": "לצעוד באותו משעול בו הוא צעד."
  },
  {
   "start": 339.76,
   "end": 342.0,
   "text": "אז בואו, בואו נכיר את השורש שלנו."
  },
  {
   "start": 342.4,
   "end": 343.52,
   "text": "בואו נכיר את אברהם,"
  },
  {
   "start": 343.98,
   "end": 347.72,
   "text": "איך הוא קנה את המקום שלו בעולם הזה ובעולם הבא."
  },
  {
   "start": 347.72,
   "end": 356.94,
   "text": "איך הוא הקנה לנו את הזכות להיות יהודים נעצלים משורש הנשמה הגבוה ביותר שבנינוש מסוגל להגיע?"
  }
 ]
}