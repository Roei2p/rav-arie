{
 "disc": "32ר- כבוד שמים",
 "track": "Track04",
 "duration": 394.2,
 "segments": [
  {
   "start": 9.7,
   "end": 10.42,
   "text": "אברהם אבינו."
  },
  {
   "start": 11.66,
   "end": 13.06,
   "text": "אברהם אבינו עמוד החסד."
  },
  {
   "start": 14.76,
   "end": 16.28,
   "text": "מקרב את אנשי כל העולם."
  },
  {
   "start": 19.86,
   "end": 20.54,
   "text": "לשם כך"
  },
  {
   "start": 21.52,
   "end": 25.44,
   "text": "הוא הוגה במוחו הנפלא רעיון אדיר."
  },
  {
   "start": 26.2,
   "end": 28.72,
   "text": "הוא הקים אוהל, אוהל שכולו חסד,"
  },
  {
   "start": 29.38,
   "end": 30.44,
   "text": "בלב המדבר."
  },
  {
   "start": 31.04,
   "end": 31.38,
   "text": "חם."
  },
  {
   "start": 31.86,
   "end": 33.64,
   "text": "אנשים עוברים ממקום למקום ברגל."
  },
  {
   "start": 34.44,
   "end": 35.38,
   "text": "זה קשה, זה לא קל."
  },
  {
   "start": 36.12,
   "end": 43.23,
   "text": "פתאום הם רואים בלב המדבר נווה מדבר."
  },
  {
   "start": 43.77,
   "end": 44.09,
   "text": "אוהל."
  },
  {
   "start": 44.77,
   "end": 49.11,
   "text": "כשהם מתקרבים, יש להם שם שתייה ואוכל בשפע."
  },
  {
   "start": 51.09,
   "end": 52.51,
   "text": "והכל חינם אין כסף."
  },
  {
   "start": 53.69,
   "end": 56.07,
   "text": "רק בקשה אחת יש לאברהם."
  },
  {
   "start": 56.89,
   "end": 58.97,
   "text": "בואו תגידו תודה למי שנתן את זה."
  },
  {
   "start": 59.67,
   "end": 59.99,
   "text": "לא לי."
  },
  {
   "start": 60.93,
   "end": 61.75,
   "text": "לבורא עולם,"
  },
  {
   "start": 62.27,
   "end": 65.47,
   "text": "שנתן לי את הממון ואת האפשרות הזאת לעשות את זה."
  },
  {
   "start": 66.57,
   "end": 67.35,
   "text": "בואו תברכו."
  },
  {
   "start": 69.25,
   "end": 71.71,
   "text": "ואז מתחילות השאלות, מי זה בורא עולם?"
  },
  {
   "start": 72.25,
   "end": 74.55,
   "text": "ואברהם מסביר, ואברהם מפתח."
  },
  {
   "start": 75.91,
   "end": 77.33,
   "text": "ואנשים מתחילים להבין."
  },
  {
   "start": 78.63,
   "end": 80.55,
   "text": "ואנשים היוצאים מהאוהל הזה,"
  },
  {
   "start": 81.83,
   "end": 83.01,
   "text": "עבדי השם."
  },
  {
   "start": 86.79,
   "end": 91.13,
   "text": "ואברהם שמה לומד כמה הקדוש ברוך הוא אב רחמן."
  },
  {
   "start": 91.61,
   "end": 93.27,
   "text": "יום אחד הגיע אדם זקן,"
  },
  {
   "start": 93.97,
   "end": 95.47,
   "text": "עקשן."
  },
  {
   "start": 96.45,
   "end": 97.05,
   "text": "הוא מגיע,"
  },
  {
   "start": 97.81,
   "end": 100.01,
   "text": "יושב לאכול, אומר לאברהם, תשמע,"
  },
  {
   "start": 100.65,
   "end": 102.31,
   "text": "אל תשפה עליי, אל תשטוף לי את המוח."
  },
  {
   "start": 103.05,
   "end": 105.09,
   "text": "אני לא מוכן לשמוע כלום מבורא עולם."
  },
  {
   "start": 105.93,
   "end": 107.35,
   "text": "אני רוצה לאכול ותו לא."
  },
  {
   "start": 107.69,
   "end": 108.77,
   "text": "אתה רוצה, אני אגיד לך תודה."
  },
  {
   "start": 109.43,
   "end": 110.15,
   "text": "אתה אל תכריח אותי."
  },
  {
   "start": 110.57,
   "end": 113.81,
   "text": "והוא אומר, אברהם מנסה לשכנע אותו. תשמע, אולי בכל אופן."
  },
  {
   "start": 114.15,
   "end": 114.93,
   "text": "הוא אומר, לא מוכן."
  },
  {
   "start": 117.89,
   "end": 122.67,
   "text": "ואברהם מדבר איתו, תראה, אבל מי שנתן לי את האפשרות זה בורא עולם."
  },
  {
   "start": 123.75,
   "end": 125.01,
   "text": "והזקן לא מוכן."
  },
  {
   "start": 125.71,
   "end": 126.95,
   "text": "אז אברהם אומר לו, אתה לא מוכן?"
  },
  {
   "start": 128.35,
   "end": 128.43,
   "text": "אז,"
  },
  {
   "start": 129.13,
   "end": 129.99,
   "text": "להתראות לך."
  },
  {
   "start": 130.83,
   "end": 131.87,
   "text": "והזקן קם והולך,"
  },
  {
   "start": 134.64,
   "end": 135.68,
   "text": "וחצי שעה אחר כך,"
  },
  {
   "start": 136.94,
   "end": 140.14,
   "text": "נגלה הקדוש ברוך הוא לאברהם, ואומר לו, אברהם אברהם,"
  },
  {
   "start": 140.5,
   "end": 141.66,
   "text": "אברהם בני,"
  },
  {
   "start": 142.42,
   "end": 143.5,
   "text": "מה קרה עם אותו זקן?"
  },
  {
   "start": 145.54,
   "end": 150.62,
   "text": "אומר לו אברהם, תראה, אני ניסיתי לדבר איתו וניסיתי לשכנע אותו. הוא לא מוכן לשמוע כזה עקשן,"
  },
  {
   "start": 150.96,
   "end": 152.46,
   "text": "עוד מתחצף, לא מתבייש."
  },
  {
   "start": 152.98,
   "end": 154.2,
   "text": "אז אמרתי לו, לך, לא צריך."
  },
  {
   "start": 155.74,
   "end": 157.58,
   "text": "שהעבודה זרה שלו תספק לו את האוכל."
  },
  {
   "start": 158.78,
   "end": 161.02,
   "text": "אמר הקדוש ברוך הוא לאברהם, אברהם בני,"
  },
  {
   "start": 161.64,
   "end": 164.26,
   "text": "אברהם בני, אתה יודע, האדם הזקן הזה,"
  },
  {
   "start": 164.72,
   "end": 166.22,
   "text": "כבר שמונים שנה"
  },
  {
   "start": 167.42,
   "end": 169.5,
   "text": "הוא צועק כנגדי, מגדף,"
  },
  {
   "start": 170.14,
   "end": 173.32,
   "text": "עושה הכל כנגדי ואני ממשיך לתת לו אוכל,"
  },
  {
   "start": 173.68,
   "end": 178.64,
   "text": "ממשיך לתת לו בריאות יש לי סבלנות שמונים שנה נותן לו כסף,"
  },
  {
   "start": 179.0,
   "end": 194.2,
   "text": "נותן לו בריאות, נותן לו כוח, נותן לו הכל בכוח שאני נותן לו, בחיות שאני נותן לו הוא פועל כנגדי ויש לי סבלנות שמונים שנה ואתה אין לך עשר דקות סבלנות לבן שלי דברים מחלחלים אל אברהם"
  },
  {
   "start": 194.62,
   "end": 197.2,
   "text": "רץ אחרי אותו זקן,"
  },
  {
   "start": 197.6,
   "end": 201.04,
   "text": "מבקש ממנו מחילה ולוקח אותו חזרה אליו לאוהל."
  },
  {
   "start": 202.32,
   "end": 204.52,
   "text": "אברהם לומד ישירות ממורה,"
  },
  {
   "start": 204.9,
   "end": 207.5,
   "text": "המורה הגדול בעולם הקדוש ברוך הוא."
  },
  {
   "start": 208.62,
   "end": 209.8,
   "text": "וככה אנשים באים,"
  },
  {
   "start": 210.34,
   "end": 211.22,
   "text": "מתקרבים,"
  },
  {
   "start": 211.9,
   "end": 215.64,
   "text": "מתארחים באהבה ושמחה ומתקרבים אל השם."
  },
  {
   "start": 218.31,
   "end": 218.91,
   "text": "יום אחד,"
  },
  {
   "start": 220.17,
   "end": 220.91,
   "text": "אל האוהל,"
  },
  {
   "start": 221.65,
   "end": 222.47,
   "text": "אל אש של אברהם,"
  },
  {
   "start": 223.29,
   "end": 225.45,
   "text": "מגיע לא פחות ולא יותר נמרוד."
  },
  {
   "start": 226.37,
   "end": 229.25,
   "text": "נמרוד מגיע, הוא שמע שיש שם אוכל ושתייה בחינם."
  },
  {
   "start": 230.23,
   "end": 230.61,
   "text": "למה לא?"
  },
  {
   "start": 231.25,
   "end": 233.89,
   "text": "למה לא להשתעשע על חשבון אברהם?"
  },
  {
   "start": 236.02,
   "end": 238.4,
   "text": "הוא שולח את כל השומרי ראש שלו,"
  },
  {
   "start": 239.24,
   "end": 242.24,
   "text": "והוא נשאר לבד להינפש על חשבון אברהם."
  },
  {
   "start": 243.26,
   "end": 245.04,
   "text": "יושב והוא ימה כמה שבועות טובים."
  },
  {
   "start": 246.44,
   "end": 247.92,
   "text": "אוכל, שותה, נח."
  },
  {
   "start": 250.38,
   "end": 251.46,
   "text": "בסוף הוא רוצה ללכת הביתה."
  },
  {
   "start": 252.98,
   "end": 254.74,
   "text": "אז הוא מקבל צלחת עם סוכריות,"
  },
  {
   "start": 257.97,
   "end": 259.33,
   "text": "אז צלחת עם סוכריות הוא מקבל,"
  },
  {
   "start": 260.29,
   "end": 262.01,
   "text": "ומקבל גם את החשבון."
  },
  {
   "start": 263.41,
   "end": 265.25,
   "text": "והסוכריות נועדו להמתיק את החשבון."
  },
  {
   "start": 265.75,
   "end": 266.79,
   "text": "הוא מסתכל, איזה חשבון?"
  },
  {
   "start": 267.41,
   "end": 267.79,
   "text": "הרי אני..."
  },
  {
   "start": 268.33,
   "end": 271.01,
   "text": "הרי כולם פה אוכלים חינם, אני באתי כדי לאכול חינם."
  },
  {
   "start": 272.53,
   "end": 273.77,
   "text": "טוב, אבל הוא פותח את החשבון ומסתכל,"
  },
  {
   "start": 274.97,
   "end": 276.79,
   "text": "ועיניו נפערות לרווחה."
  },
  {
   "start": 278.21,
   "end": 281.15,
   "text": "חשבון עצום, של מיליונים."
  },
  {
   "start": 282.25,
   "end": 282.87,
   "text": "והוא לא מבין."
  },
  {
   "start": 283.53,
   "end": 285.43,
   "text": "הוא פונה לאברהם ואומר לו, אברהם, תגיד לי, מה זה?"
  },
  {
   "start": 286.19,
   "end": 286.85,
   "text": "מה קורה פה?"
  },
  {
   "start": 287.69,
   "end": 289.95,
   "text": "אמרו לי שפה חינם."
  },
  {
   "start": 291.05,
   "end": 293.81,
   "text": "זה אש על אברהם ואוכלים כל העולם חינם למה אני משלם."
  },
  {
   "start": 294.51,
   "end": 296.51,
   "text": "ואתה יודע מה? נגיד שאני אשלם."
  },
  {
   "start": 296.85,
   "end": 297.95,
   "text": "הייתי פה כמה שבועות."
  },
  {
   "start": 298.71,
   "end": 299.89,
   "text": "מה פתאום מיליונים?"
  },
  {
   "start": 301.25,
   "end": 303.23,
   "text": "נחייך אברהם בקלילות ואומר לו,"
  },
  {
   "start": 303.79,
   "end": 305.03,
   "text": "נמרוד נמרוד תקשיב."
  },
  {
   "start": 306.55,
   "end": 311.07,
   "text": "כל העולם באים לכאן, אוכלים ושותים וישנים."
  },
  {
   "start": 311.81,
   "end": 313.97,
   "text": "וכשמגיע הזמן התשלום,"
  },
  {
   "start": 315.01,
   "end": 316.23,
   "text": "אני אומר להם, אל תשלמו."
  },
  {
   "start": 317.01,
   "end": 318.89,
   "text": "רק תברכו את הקדוש ברוך הוא,"
  },
  {
   "start": 319.69,
   "end": 323.95,
   "text": "רק תברכו את אלוקים, והוא כבר ישלם לי, אלוקים ישלם לי."
  },
  {
   "start": 325.77,
   "end": 326.45,
   "text": "עכשיו אתה,"
  },
  {
   "start": 327.17,
   "end": 328.93,
   "text": "אתה נמרוד, אתה אומר שאתה אלוקים."
  },
  {
   "start": 329.87,
   "end": 331.89,
   "text": "אז תשלם עבור כווולם עכשיו."
  },
  {
   "start": 333.05,
   "end": 334.49,
   "text": "אתה אלוקים, שלם."
  },
  {
   "start": 335.91,
   "end": 337.47,
   "text": "נתתי לך את החשבון של כולם, בבקשה."
  },
  {
   "start": 338.95,
   "end": 341.27,
   "text": "ונמרוד יודע שהוא הסתבך,"
  },
  {
   "start": 345.06,
   "end": 346.8,
   "text": "ואברהם לא נותן לו לזוז."
  },
  {
   "start": 347.64,
   "end": 351.76,
   "text": "ונמרוד לא מצליח לזוז עד שהוא חותם על פפירוס,"
  },
  {
   "start": 352.58,
   "end": 357.14,
   "text": "שהוא רק בן אנוש רגיל לא אלוקים ולא מתיימר להיות כזה יותר."
  },
  {
   "start": 359.2,
   "end": 361.44,
   "text": "והוא חוזר ככה בראשת פנים אל הארמון שלו."
  },
  {
   "start": 362.18,
   "end": 363.5,
   "text": "אבל עד שהוא מספיק לחזור,"
  },
  {
   "start": 364.22,
   "end": 368.0,
   "text": "בינתיים כבר, למחרת בכל כלי התקשורת המקומיים של אותה תקופה,"
  },
  {
   "start": 368.34,
   "end": 371.36,
   "text": "רצים פפירוסים עם הידיעה על נמרוד."
  },
  {
   "start": 372.38,
   "end": 374.98,
   "text": "שנמרוד חזר בו מכל השטויות"
  },
  {
   "start": 375.64,
   "end": 377.34,
   "text": "שהוא היה מספר שנים לבני עמו."
  },
  {
   "start": 380.04,
   "end": 383.66,
   "text": "ואברהם יודע שנמרוד לא מרוצה מהפעילות שלו,"
  },
  {
   "start": 384.2,
   "end": 385.02,
   "text": "שהוא מסתכן,"
  },
  {
   "start": 385.64,
   "end": 390.06,
   "text": "אבל על אברהם מוכן לסכן את הכל למען כבוד שמיים."
  }
 ]
}