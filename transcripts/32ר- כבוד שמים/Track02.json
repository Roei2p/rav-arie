{
 "disc": "32ר- כבוד שמים",
 "track": "Track02",
 "duration": 430.2,
 "segments": [
  {
   "start": 2.44,
   "end": 15.28,
   "text": "1656, לבריאת העולם, העולם נכחד במבול ששוטף את פני כל העולם."
  },
  {
   "start": 18.01,
   "end": 21.33,
   "text": "נותר רק נוח והאנשים שאיתו בתיבה,"
  },
  {
   "start": 22.05,
   "end": 27.55,
   "text": "וממנו מתפתחים להם דורות חדשים."
  },
  {
   "start": 31.36,
   "end": 34.34,
   "text": "עולם של אז טעה בדרך,"
  },
  {
   "start": 35.5,
   "end": 37.06,
   "text": "התרחק מהשם."
  },
  {
   "start": 37.9,
   "end": 41.2,
   "text": "אם תשאלו את עצמכם איך אפשר להגיע לדבר כזה,"
  },
  {
   "start": 42.08,
   "end": 43.68,
   "text": "הרי זה היה כל כך קרוב לבריאת העולם."
  },
  {
   "start": 44.32,
   "end": 45.34,
   "text": "הרי הם פגשו את נוח,"
  },
  {
   "start": 46.26,
   "end": 46.68,
   "text": "ונוח"
  },
  {
   "start": 47.6,
   "end": 50.58,
   "text": "פגש את הדורות האחר לפניכם, עד אדם הראשון."
  },
  {
   "start": 50.92,
   "end": 52.52,
   "text": "כולם ידעו שיש בורא עולם,"
  },
  {
   "start": 52.92,
   "end": 54.66,
   "text": "כולם ידעו שבורא עולם ברא את העולם,"
  },
  {
   "start": 55.22,
   "end": 58.4,
   "text": "אז איך אפשר להתרחק ממנו? איך אפשר לעבוד עבודה זרה?"
  },
  {
   "start": 59.52,
   "end": 63.32,
   "text": "כי הייתה להם פילוסופיה כזאת, שהקדוש ברוך הוא,"
  },
  {
   "start": 64.46,
   "end": 65.4,
   "text": "הוא כל כך גדול."
  },
  {
   "start": 66.22,
   "end": 70.48,
   "text": "עזב את העולם, הוא לא צריך להתעסק בקטנות כמו העולם."
  },
  {
   "start": 70.82,
   "end": 71.9,
   "text": "השאיר את זה לכוחות הטבע,"
  },
  {
   "start": 72.46,
   "end": 73.24,
   "text": "השאיר את זה למזלות,"
  },
  {
   "start": 74.14,
   "end": 75.32,
   "text": "ואותם צריך לעבוד."
  },
  {
   "start": 75.72,
   "end": 77.32,
   "text": "הם השרים של הקדוש ברוך הוא,"
  },
  {
   "start": 77.72,
   "end": 82.98,
   "text": "ואותם צריכים לעבוד. הם עושים את הכל. והקדוש ברוך הוא גמרנו, פרש, יצא לפנסיה,"
  },
  {
   "start": 84.42,
   "end": 85.3,
   "text": "עפר לפיהם,"
  },
  {
   "start": 87.88,
   "end": 92.78,
   "text": "וככה הם עובדים עבודה זרה"
  },
  {
   "start": 94.32,
   "end": 96.12,
   "text": "למזלות, לקוחות הטבע."
  },
  {
   "start": 97.48,
   "end": 98.74,
   "text": "והעולם טועה והולך."
  },
  {
   "start": 100.18,
   "end": 105.5,
   "text": "עד שב-1948, 1948 לבריאת העולם,"
  },
  {
   "start": 106.52,
   "end": 107.18,
   "text": "נולד,"
  },
  {
   "start": 108.1,
   "end": 110.76,
   "text": "נולד ילד מיוחד, אברהם."
  },
  {
   "start": 111.72,
   "end": 114.44,
   "text": "אברהם בגיל שלוש מתחיל לחקור."
  },
  {
   "start": 114.9,
   "end": 117.08,
   "text": "הוא רוצה לדעת, הוא רוצה לדעת את האמת."
  },
  {
   "start": 118.6,
   "end": 122.04,
   "text": "טוב, יש שמש, יש ירח, אבל הם נעים."
  },
  {
   "start": 122.68,
   "end": 123.36,
   "text": "מי מניע אותם?"
  },
  {
   "start": 124.54,
   "end": 125.44,
   "text": "מי מניע את השמש?"
  },
  {
   "start": 126.18,
   "end": 127.06,
   "text": "מי מניע את הירח?"
  },
  {
   "start": 127.98,
   "end": 130.5,
   "text": "מי ברא את כל אלו?"
  },
  {
   "start": 131.84,
   "end": 133.0,
   "text": "אברהם מחפש אמת."
  },
  {
   "start": 134.3,
   "end": 137.78,
   "text": "אברהם לא מסתפק במה שעיניו רואות."
  },
  {
   "start": 138.28,
   "end": 140.98,
   "text": "הוא יודע שמעבר למה שהעיניים רואות,"
  },
  {
   "start": 141.44,
   "end": 142.24,
   "text": "הוא רוצה את האמת."
  },
  {
   "start": 145.01,
   "end": 148.81,
   "text": "וכשהוא רואה שבבית אצלו כולם שטופים בעבודה זרה,"
  },
  {
   "start": 150.01,
   "end": 151.05,
   "text": "הוא עוזב את הבית שלו,"
  },
  {
   "start": 151.97,
   "end": 153.09,
   "text": "עוזב את ההורים שלו,"
  },
  {
   "start": 154.01,
   "end": 155.71,
   "text": "והולך לחפש אמת."
  },
  {
   "start": 156.59,
   "end": 158.83,
   "text": "הוא מגיע לישיבת נוח ושם."
  },
  {
   "start": 160.05,
   "end": 163.13,
   "text": "ובישיבת נח ושם הוא יושב ולומד."
  },
  {
   "start": 164.45,
   "end": 170.29,
   "text": "39 שנה אברהם אבינו יושב ולומד שם את כל סודות התורה הקדושה."
  },
  {
   "start": 170.85,
   "end": 174.17,
   "text": "הוא לומד שם להכיר את מי שאמר והיה העולם."
  },
  {
   "start": 177.02,
   "end": 179.74,
   "text": "אברהם מתחבר לאבא שבשמיים,"
  },
  {
   "start": 180.98,
   "end": 181.74,
   "text": "ובורא עולם,"
  },
  {
   "start": 182.62,
   "end": 187.08,
   "text": "אבא רחמן רואה את הבן שלו, רוצה אותו, משתוקק אליו."
  },
  {
   "start": 188.16,
   "end": 191.06,
   "text": "בא בורא עולם ומשרה את שכינתו באברהם."
  },
  {
   "start": 196.85,
   "end": 199.99,
   "text": "אבא של אברהם טרחי, מזועזע."
  },
  {
   "start": 201.47,
   "end": 202.01,
   "text": "הבן שלי,"
  },
  {
   "start": 203.39,
   "end": 204.29,
   "text": "מה קורה לבן שלי?"
  },
  {
   "start": 205.11,
   "end": 207.87,
   "text": "אימא שלו, אימא של אברהם, המטלאי בת קרנבו,"
  },
  {
   "start": 210.27,
   "end": 213.89,
   "text": "מתחילה לאט-לאט להשלים עם דרכו של אברהם, אותה דרך מיוחדת,"
  },
  {
   "start": 214.43,
   "end": 215.41,
   "text": "שונה משל כולם."
  },
  {
   "start": 216.79,
   "end": 219.21,
   "text": "בינתיים, לאח של אברהם, היה לו אח,"
  },
  {
   "start": 219.79,
   "end": 220.43,
   "text": "קראו לו הרן."
  },
  {
   "start": 221.47,
   "end": 222.63,
   "text": "נולדה לה בת."
  },
  {
   "start": 223.69,
   "end": 225.41,
   "text": "לבת קוראים שרה."
  },
  {
   "start": 225.65,
   "end": 230.63,
   "text": "ועם השנים מכנים אותה גם עסקה."
  },
  {
   "start": 232.75,
   "end": 235.19,
   "text": "ולהרן, אחיו של אברהם, נולד גם בן, קוראים לו לוט."
  },
  {
   "start": 236.69,
   "end": 237.43,
   "text": "והשנים עוברות,"
  },
  {
   "start": 238.09,
   "end": 238.69,
   "text": "ושרה,"
  },
  {
   "start": 239.37,
   "end": 240.37,
   "text": "בתו של הרן,"
  },
  {
   "start": 241.13,
   "end": 241.65,
   "text": "גודלת לה."
  },
  {
   "start": 243.29,
   "end": 249.32,
   "text": "ואכן, שמה היא עסקה נאה לה, היא ילדה מיוחדת."
  },
  {
   "start": 250.34,
   "end": 252.86,
   "text": "היא עסקה כי היא שוחה ברוח הקודש."
  },
  {
   "start": 253.46,
   "end": 256.06,
   "text": "סחה לה כמו שאדם סח בשמן טובל לו בשמן,"
  },
  {
   "start": 256.18,
   "end": 257.14,
   "text": "בעמבט של שמן,"
  },
  {
   "start": 257.56,
   "end": 259.1,
   "text": "כך היא טובלת לה ברוח הקודש."
  },
  {
   "start": 260.24,
   "end": 262.68,
   "text": "ולא רק זה לה, אותה שרה עסקה"
  },
  {
   "start": 263.82,
   "end": 265.02,
   "text": "כל כך מיוחדת,"
  },
  {
   "start": 265.78,
   "end": 267.44,
   "text": "חן אלוקיה ינסוך על פניה."
  },
  {
   "start": 269.42,
   "end": 273.3,
   "text": "היה זה טבעי שאברהם ייקח את שרה לאישה,"
  },
  {
   "start": 274.06,
   "end": 274.84,
   "text": "והם נישאים לה."
  },
  {
   "start": 286.94,
   "end": 287.84,
   "text": "עוברות השנים,"
  },
  {
   "start": 289.0,
   "end": 289.72,
   "text": "אבל אין ילדים."
  },
  {
   "start": 290.58,
   "end": 291.34,
   "text": "שרה עקרה,"
  },
  {
   "start": 292.02,
   "end": 292.54,
   "text": "אין לה ולד."
  },
  {
   "start": 294.42,
   "end": 295.28,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 296.5,
   "end": 297.32,
   "text": "היא עקרה,"
  },
  {
   "start": 297.9,
   "end": 299.66,
   "text": "וגם אין לה ולד, אומרת התורה."
  },
  {
   "start": 300.74,
   "end": 301.6,
   "text": "שרה, לא היה לה סיכוי"
  },
  {
   "start": 302.82,
   "end": 305.0,
   "text": "ללדת מבחינה טבעית."
  },
  {
   "start": 308.44,
   "end": 309.08,
   "text": "והזוג הזה,"
  },
  {
   "start": 309.7,
   "end": 311.32,
   "text": "הזוג שפועל לכבוד השם יתברך,"
  },
  {
   "start": 311.96,
   "end": 313.46,
   "text": "צריך להתמודד עם זה."
  },
  {
   "start": 314.4,
   "end": 318.0,
   "text": "אבל כל העולם כולו מצביע לאברהם ואומר, הנה אברהם, אתה צדיק."
  },
  {
   "start": 318.54,
   "end": 319.72,
   "text": "אתה אומר, בורא עולם."
  },
  {
   "start": 320.24,
   "end": 322.3,
   "text": "אתה מנופף בדגל של הקדוש ברוך הוא."
  },
  {
   "start": 322.68,
   "end": 325.1,
   "text": "הנה תראה כמה שאתה צדיק ואין לך ילדים."
  },
  {
   "start": 325.42,
   "end": 326.32,
   "text": "ולנו יש בשפע."
  },
  {
   "start": 327.04,
   "end": 328.14,
   "text": "מה אתה אומר על זה, אברהם?"
  },
  {
   "start": 331.45,
   "end": 335.07,
   "text": "ואברהם מחייך, לא מתייאש, ומסביר להם"
  },
  {
   "start": 335.67,
   "end": 338.11,
   "text": "שכל מה שהקדוש ברוך הוא עושה, הקדוש ברוך הוא עושה לטובה."
  },
  {
   "start": 339.19,
   "end": 340.21,
   "text": "אבל תראה אברהם, הנה,"
  },
  {
   "start": 340.55,
   "end": 342.75,
   "text": "אנחנו אומרים לך, בורא עולם עזב את העולם,"
  },
  {
   "start": 343.07,
   "end": 347.71,
   "text": "ועכשיו יש כוח למזלות, הנה הקדוש ברוך הוא לא יכול לשנות אפילו את המזלות המתכתיב שלהם,"
  },
  {
   "start": 348.09,
   "end": 349.57,
   "text": "אם המזל החליט שאין לך."
  },
  {
   "start": 350.03,
   "end": 352.13,
   "text": "במזל כתוב שאין לך ילדים, לא יהיה לך ילדים."
  },
  {
   "start": 352.51,
   "end": 354.01,
   "text": "ואברהם מחייך לא נחדש,"
  },
  {
   "start": 355.67,
   "end": 357.35,
   "text": "ממשיך לחזק אותם,"
  },
  {
   "start": 358.11,
   "end": 371.89,
   "text": "ממשיך להגיד הקדוש ברוך הוא זה שעושה הכל וכל מה שדעביד רחמנא ליטב עביד וצריך להתפלל אליו ישירות לא לשרים לא לאמצעי קשר לא לשום דבר רק לבורא עולם נטו ישירות"
  },
  {
   "start": 372.51,
   "end": 374.85,
   "text": "לפנות אל השם יתברך ישירות"
  },
  {
   "start": 376.87,
   "end": 379.99,
   "text": "וככה בכל מקום אברהם הולך ומקרב נשמות"
  },
  {
   "start": 380.61,
   "end": 385.93,
   "text": "מקרב גברים ושרה מגיירת את הנשים כל מקום"
  },
  {
   "start": 387.35,
   "end": 390.85,
   "text": "סוללים את הדרך אלינו כאן, היום בדור שלנו,"
  },
  {
   "start": 391.33,
   "end": 392.27,
   "text": "שכמה שקשה,"
  },
  {
   "start": 392.65,
   "end": 396.03,
   "text": "כמה שלפעמים אנשים, אדם, אישה, מתקרבים אל השם,"
  },
  {
   "start": 396.35,
   "end": 397.79,
   "text": "ולמרות זה לא הולך כל כך,"
  },
  {
   "start": 398.17,
   "end": 398.75,
   "text": "או אין ילדים,"
  },
  {
   "start": 399.35,
   "end": 401.61,
   "text": "או יש צרות אחרות, או כל מיני דברים."
  },
  {
   "start": 402.53,
   "end": 406.05,
   "text": "למרות זה צריך לפעול לכבוד השם, לעצום עיניים ולהמשיך,"
  },
  {
   "start": 406.39,
   "end": 407.91,
   "text": "כי כל מה שהקדוש ברוך הוא עושה,"
  },
  {
   "start": 408.29,
   "end": 409.51,
   "text": "הקדוש ברוך הוא עושה לטובה,"
  },
  {
   "start": 409.83,
   "end": 413.43,
   "text": "ולא לרוץ לכל מיני דברים, אלא רק לבטוח בהשם יתברך."
  },
  {
   "start": 413.83,
   "end": 415.29,
   "text": "לא צריך שום אמצעי קשר,"
  },
  {
   "start": 415.73,
   "end": 417.21,
   "text": "ישירות אל השם יתברך."
  },
  {
   "start": 417.35,
   "end": 423.21,
   "text": "ישירות אל השם יתברך אנחנו פנים של אברהם אבינו זה שפנה ישירות אל השם יתברך"
  }
 ]
}