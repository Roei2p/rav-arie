{
 "disc": "32ר- כבוד שמים",
 "track": "Track06",
 "duration": 1831.152,
 "segments": [
  {
   "start": 8.94,
   "end": 9.68,
   "text": "אברהם אבינו,"
  },
  {
   "start": 11.1,
   "end": 13.12,
   "text": "בן 137 שנים,"
  },
  {
   "start": 15.55,
   "end": 17.47,
   "text": "מה האדם בגיל שלו רוצה?"
  },
  {
   "start": 18.61,
   "end": 19.33,
   "text": "קצת מנוחה."
  },
  {
   "start": 20.49,
   "end": 22.61,
   "text": "אחרי מסכת החיים הסוערת שהוא עבר,"
  },
  {
   "start": 23.69,
   "end": 27.07,
   "text": "הוא מצפה לסיים את שארית חייו בשלווה ונחת."
  },
  {
   "start": 28.77,
   "end": 30.19,
   "text": "הוא בחר לו בעיר חברון,"
  },
  {
   "start": 32.29,
   "end": 34.89,
   "text": "עכשיו שהוא סוף סוף זכה לבן,"
  },
  {
   "start": 35.55,
   "end": 36.09,
   "text": "ליצחק,"
  },
  {
   "start": 36.97,
   "end": 38.09,
   "text": "שיהיה ממשיך דרכו,"
  },
  {
   "start": 38.93,
   "end": 41.81,
   "text": "יכול לשבת לו ולעבוד את השם ברגיעה,"
  },
  {
   "start": 42.93,
   "end": 44.17,
   "text": "בשלוות הנפש."
  },
  {
   "start": 52.87,
   "end": 55.87,
   "text": "שנת 2085 לבריאת העולם,"
  },
  {
   "start": 57.75,
   "end": 59.39,
   "text": "יום כזן באלול."
  },
  {
   "start": 61.23,
   "end": 66.46,
   "text": "הקדוש ברוך הוא פונה אל אברהם אבינו, קח נא."
  },
  {
   "start": 67.76,
   "end": 68.66,
   "text": "קח נא."
  },
  {
   "start": 69.2,
   "end": 70.46,
   "text": "בבקשה נא."
  },
  {
   "start": 71.3,
   "end": 72.94,
   "text": "לשון בבקשה אני מבקש ממך."
  },
  {
   "start": 73.46,
   "end": 75.44,
   "text": "יש לי ניסיון שאני רוצה לנסות אותך."
  },
  {
   "start": 76.58,
   "end": 77.88,
   "text": "תעמוד בו בבקשה."
  },
  {
   "start": 78.62,
   "end": 80.12,
   "text": "קח נא את בנך."
  },
  {
   "start": 80.86,
   "end": 82.92,
   "text": "אם לא היה כתוב ככה, אי אפשר היה לומר."
  },
  {
   "start": 83.62,
   "end": 86.48,
   "text": "הקדוש ברוך הוא מבקש מהבן שלו, אהובו,"
  },
  {
   "start": 86.82,
   "end": 91.02,
   "text": "תעמוד בניסיון, אולי הניסיון הגדול ביותר"
  },
  {
   "start": 92.9,
   "end": 94.08,
   "text": "שניתן לעמוד בו."
  },
  {
   "start": 95.36,
   "end": 96.6,
   "text": "קח נא את הבן שלך."
  },
  {
   "start": 98.02,
   "end": 101.64,
   "text": "אבל ריבונו של עולם, איזה בן יש לשני בנים?"
  },
  {
   "start": 102.22,
   "end": 105.48,
   "text": "איזה מהם אקח את יחידך?"
  },
  {
   "start": 108.86,
   "end": 109.7,
   "text": "אבל בורא עולם,"
  },
  {
   "start": 111.28,
   "end": 112.28,
   "text": "שניהם יחידים,"
  },
  {
   "start": 113.18,
   "end": 116.94,
   "text": "ישמעאל יחידי להגר, יצחק יחידי לשרה."
  },
  {
   "start": 118.54,
   "end": 119.88,
   "text": "את אשר אהבת,"
  },
  {
   "start": 121.1,
   "end": 123.6,
   "text": "אבל בורא עולם אני אוהב את שניהם, הם הילדים שלי."
  },
  {
   "start": 124.94,
   "end": 130.26,
   "text": "את יצחק, את יצחק הבן הקדוש שלך משרה."
  },
  {
   "start": 131.04,
   "end": 138.74,
   "text": "קח אותו אל ארץ המוריה ותעלה אותו שם לעולה על אחת הערים אשר אראך."
  },
  {
   "start": 144.33,
   "end": 148.31,
   "text": "זה ששנים מקרב כל כך הרבה נשמות,"
  },
  {
   "start": 149.39,
   "end": 153.61,
   "text": "זה שהוא סמל למלחמה נגד קורבנות אדם."
  },
  {
   "start": 154.99,
   "end": 157.07,
   "text": "בתקופה ההיא היו מקריבים קורבנות אדם,"
  },
  {
   "start": 157.77,
   "end": 160.35,
   "text": "ואברהם היה כל כך דיבר נגד,"
  },
  {
   "start": 161.11,
   "end": 163.19,
   "text": "עשה סמינרים, הרצאות,"
  },
  {
   "start": 163.85,
   "end": 166.33,
   "text": "מסע של שכנועים כנגד קורבנות אדם."
  },
  {
   "start": 168.19,
   "end": 171.69,
   "text": "מתפאר כל הזמן, בורא עולם לא צריך קורבנות אדם."
  },
  {
   "start": 172.53,
   "end": 176.81,
   "text": "תפסיקו לעבוד העבודה הזרה שדורשת קורבנות אדם."
  },
  {
   "start": 177.71,
   "end": 178.27,
   "text": "ועכשיו,"
  },
  {
   "start": 179.13,
   "end": 181.65,
   "text": "הכל לכאורה מתנפץ לנגד עיניו."
  },
  {
   "start": 182.13,
   "end": 183.85,
   "text": "לך תקריב לי קורבן אדם."
  },
  {
   "start": 185.37,
   "end": 189.53,
   "text": "אברהם יכול להתנער כמו מתנער משנתו ולהגיד זה סתם חלום."
  },
  {
   "start": 190.87,
   "end": 191.65,
   "text": "זה לא יכול להיות,"
  },
  {
   "start": 192.95,
   "end": 193.87,
   "text": "ולהמשיך הלאה."
  },
  {
   "start": 195.67,
   "end": 200.15,
   "text": "אבל אברהם תמים באמונתו סמל של אמונה."
  },
  {
   "start": 200.99,
   "end": 202.15,
   "text": "אב המון גויים."
  },
  {
   "start": 203.09,
   "end": 204.11,
   "text": "למרות הכל,"
  },
  {
   "start": 204.55,
   "end": 207.79,
   "text": "הוא נענה לניסיון הכל-כך כל-כך רצה."
  },
  {
   "start": 215.11,
   "end": 215.81,
   "text": "ואברהם,"
  },
  {
   "start": 217.01,
   "end": 218.53,
   "text": "אברהם בא לשרה,"
  },
  {
   "start": 219.35,
   "end": 220.35,
   "text": "ורק הוא רואה אותה."
  },
  {
   "start": 221.05,
   "end": 224.67,
   "text": "הוא יודע שהוא לא יכול להסביר לה לאן הוא לוקח את הילד שלהם."
  },
  {
   "start": 226.67,
   "end": 232.85,
   "text": "אז הוא אומר לה, אני לוקח אותו למקום שהוא יתקדש והוא יתגדל מבחינה רוחנית."
  },
  {
   "start": 235.68,
   "end": 236.22,
   "text": "ושרה,"
  },
  {
   "start": 237.32,
   "end": 237.72,
   "text": "שרה,"
  },
  {
   "start": 238.66,
   "end": 240.9,
   "text": "לב של אמא, היא ישר בוכה."
  },
  {
   "start": 242.16,
   "end": 243.2,
   "text": "אתה לוקח את הבן שלי,"
  },
  {
   "start": 243.84,
   "end": 244.68,
   "text": "תשמור עליו."
  },
  {
   "start": 245.62,
   "end": 246.66,
   "text": "אין לי בן אחר."
  },
  {
   "start": 247.26,
   "end": 248.74,
   "text": "אברהם, אין לי בן אחר."
  },
  {
   "start": 249.2,
   "end": 253.18,
   "text": "הוא העיניים שלי, הוא מאור ליבי ומסוס חיי."
  },
  {
   "start": 254.64,
   "end": 255.38,
   "text": "תשמור עליו."
  },
  {
   "start": 256.02,
   "end": 259.14,
   "text": "שיאכל כמו שצריך, שישתה כמו שצריך."
  },
  {
   "start": 259.46,
   "end": 261.28,
   "text": "תדאג לו, תשמור עליו."
  },
  {
   "start": 262.26,
   "end": 264.76,
   "text": "ואברהם אומר לה בסדר ובסדר,"
  },
  {
   "start": 265.62,
   "end": 271.18,
   "text": "וכל אותו לילה שרה בוכה היא מסרבת לישון"
  },
  {
   "start": 271.18,
   "end": 276.2,
   "text": "לב של אמא לא נותן לה מנוח היא נפרדת מהבן שלה"
  },
  {
   "start": 276.62,
   "end": 279.44,
   "text": "כל הזמן כל הלילה היא דואגת לבן שלה"
  },
  {
   "start": 280.28,
   "end": 283.18,
   "text": "תשמע תיתן לו אוכל תדאג שלא יתקרר"
  },
  {
   "start": 283.82,
   "end": 291.54,
   "text": "והיא הכינה לו צידה לדרך והיא באה ממלמלת"
  },
  {
   "start": 291.54,
   "end": 296.66,
   "text": "הלוואי ואני אזכה לראות אותך שוב בני בני אהובי יצחק"
  },
  {
   "start": 297.44,
   "end": 299.46,
   "text": "הלוואי ואזכה לראות אותך שוב."
  },
  {
   "start": 301.1,
   "end": 303.28,
   "text": "וכך היא, בעיניים דומעות,"
  },
  {
   "start": 304.48,
   "end": 306.92,
   "text": "בעיניים דומעות היא מלווה את הבן שלה."
  },
  {
   "start": 307.9,
   "end": 309.82,
   "text": "ואברהם לא יכול שלא לבכות,"
  },
  {
   "start": 310.6,
   "end": 312.76,
   "text": "וכל הבית, כל בני הבית בוכים,"
  },
  {
   "start": 313.16,
   "end": 314.4,
   "text": "כל הבית בוכים."
  },
  {
   "start": 316.72,
   "end": 319.52,
   "text": "כל כך קשה פרידת שרה אמנו,"
  },
  {
   "start": 320.22,
   "end": 321.94,
   "text": "מבנה יקירה יצחק."
  },
  {
   "start": 322.96,
   "end": 323.46,
   "text": "איזו,"
  },
  {
   "start": 324.36,
   "end": 326.82,
   "text": "איזו מסירות נפש של אמא"
  },
  {
   "start": 327.78,
   "end": 331.1,
   "text": "לבן היחיד היא חיכתה לו כל כך הרבה שנים."
  },
  {
   "start": 333.1,
   "end": 334.86,
   "text": "אבל הנה סיכוי שהוא יתקדש,"
  },
  {
   "start": 335.6,
   "end": 339.1,
   "text": "שהוא יתעלה מבחינה רוחנית."
  },
  {
   "start": 344.18,
   "end": 344.7,
   "text": "ואברהם,"
  },
  {
   "start": 346.36,
   "end": 348.08,
   "text": "אברהם וישכמא אברהם בבוקר,"
  },
  {
   "start": 349.52,
   "end": 350.06,
   "text": "מלמד"
  },
  {
   "start": 350.88,
   "end": 351.72,
   "text": "שהוא ישן בלילה."
  },
  {
   "start": 353.54,
   "end": 355.08,
   "text": "אברהם הלך לישון בלילה."
  },
  {
   "start": 356.04,
   "end": 357.14,
   "text": "אברהם, איך אתה ישן?"
  },
  {
   "start": 357.82,
   "end": 360.8,
   "text": "מכר את הבן שכל כך חיכית, אתה הולך להקריב לעולם."
  },
  {
   "start": 361.52,
   "end": 361.9,
   "text": "אברהם,"
  },
  {
   "start": 362.4,
   "end": 371.18,
   "text": "בורא עולם זה שהבטיח לך שזרעך יהיה ככוכבי השמיים ההולך להרוג את הילד שלך. אומר לך, תהרוג במו ידיך את הילד שלך."
  },
  {
   "start": 371.58,
   "end": 374.08,
   "text": "לחסל את הסיכוי שיהיה לך זרע."
  },
  {
   "start": 376.57,
   "end": 378.13,
   "text": "ואתה ישן בלילה,"
  },
  {
   "start": 378.75,
   "end": 380.07,
   "text": "ואתה בטוח בשם,"
  },
  {
   "start": 382.03,
   "end": 382.99,
   "text": "לא מפקפק,"
  },
  {
   "start": 384.33,
   "end": 387.67,
   "text": "לא מנסה לתרץ תירוצים כנגד."
  },
  {
   "start": 388.61,
   "end": 389.47,
   "text": "אברהם תמים."
  },
  {
   "start": 390.25,
   "end": 391.45,
   "text": "אברהם משכים."
  },
  {
   "start": 391.95,
   "end": 394.01,
   "text": "מצטייד כמדרש,"
  },
  {
   "start": 394.47,
   "end": 397.55,
   "text": "לוקח גם את ישמעאל וגם את אליעזר,"
  },
  {
   "start": 398.13,
   "end": 399.35,
   "text": "ויוצאים לדרך."
  },
  {
   "start": 418.24,
   "end": 421.72,
   "text": "כך הם ממשיכים יום ועוד יום."
  },
  {
   "start": 423.22,
   "end": 424.32,
   "text": "וביום השלישי,"
  },
  {
   "start": 425.66,
   "end": 426.68,
   "text": "ביום השלישי,"
  },
  {
   "start": 427.66,
   "end": 428.56,
   "text": "ראש השנה,"
  },
  {
   "start": 429.82,
   "end": 430.74,
   "text": "ראש השנה,"
  },
  {
   "start": 431.48,
   "end": 432.22,
   "text": "יום הדין."
  },
  {
   "start": 435.64,
   "end": 436.32,
   "text": "לפתע רואה"
  },
  {
   "start": 437.8,
   "end": 442.08,
   "text": "רואה אברהם ענן חשוך, ענן שונה,"
  },
  {
   "start": 442.6,
   "end": 447.06,
   "text": "משאר העננים, עופף, מסובב לו את ההר."
  },
  {
   "start": 448.86,
   "end": 449.3,
   "text": "הוא לא יודע,"
  },
  {
   "start": 450.22,
   "end": 451.14,
   "text": "הוא לא יודע אם זה,"
  },
  {
   "start": 451.76,
   "end": 455.34,
   "text": "אם זה המקום שהקדוש ברוך הוא מתכוון."
  },
  {
   "start": 456.66,
   "end": 457.28,
   "text": "אז מה הוא עושה?"
  },
  {
   "start": 458.08,
   "end": 459.42,
   "text": "הוא שואל את יצחק הבן שלו,"
  },
  {
   "start": 459.98,
   "end": 460.32,
   "text": "בני,"
  },
  {
   "start": 460.84,
   "end": 462.38,
   "text": "בני יקירי, תגיד לי, אתה רואה משהו?"
  },
  {
   "start": 463.38,
   "end": 463.96,
   "text": "ויצחק"
  },
  {
   "start": 464.64,
   "end": 465.36,
   "text": "אומר לו כן."
  },
  {
   "start": 467.28,
   "end": 471.7,
   "text": "ועיניו נשואות אל הענן שמסובב לו את ההר."
  },
  {
   "start": 472.8,
   "end": 475.82,
   "text": "ואז אברהם פונה לישמעאל, ישמעאל, אתה רואה משהו?"
  },
  {
   "start": 476.82,
   "end": 477.92,
   "text": "משהו חריג, משהו מיוחד?"
  },
  {
   "start": 478.98,
   "end": 480.26,
   "text": "ישמעאל אומר לו, לא, לא רואה כלום."
  },
  {
   "start": 481.48,
   "end": 482.86,
   "text": "אליעזר, אתה רואה משהו?"
  },
  {
   "start": 483.48,
   "end": 484.42,
   "text": "הוא אומר לו, אני לא רואה כלום."
  },
  {
   "start": 487.52,
   "end": 488.4,
   "text": "ואברהם אומר, טוב,"
  },
  {
   "start": 489.3,
   "end": 490.6,
   "text": "אתם תמתינו כאן, עד כאן,"
  },
  {
   "start": 491.24,
   "end": 491.96,
   "text": "תישארו כאן,"
  },
  {
   "start": 492.9,
   "end": 495.0,
   "text": "אני והבן שלי יצחק נמשיך הלאה."
  },
  {
   "start": 496.84,
   "end": 497.64,
   "text": "והם ממשיכים"
  },
  {
   "start": 499.4,
   "end": 500.3,
   "text": "בדרך העולה"
  },
  {
   "start": 501.34,
   "end": 502.34,
   "text": "אל הר המוריה."
  },
  {
   "start": 502.34,
   "end": 506.36,
   "text": "ויצחק שם בדרך,"
  },
  {
   "start": 508.92,
   "end": 509.98,
   "text": "יצחק הגדול."
  },
  {
   "start": 511.48,
   "end": 514.88,
   "text": "כל הדרך שלושה ימים הם הולכים, הוא לא שואל שאלות את אבא."
  },
  {
   "start": 516.14,
   "end": 516.56,
   "text": "למה?"
  },
  {
   "start": 517.08,
   "end": 522.04,
   "text": "אולי אבא לא רוצה לענות תשובה, אולי זה לא יבייש את אבא לפני האנשים."
  },
  {
   "start": 522.5,
   "end": 523.66,
   "text": "הוא לא שואל לאן הולכים."
  },
  {
   "start": 524.9,
   "end": 527.38,
   "text": "אולי התשובה תבייש את אבא."
  },
  {
   "start": 528.08,
   "end": 530.76,
   "text": "אז שהוא היה ליד אליעזר וליד ישמעאל הוא שותק,"
  },
  {
   "start": 531.48,
   "end": 533.1,
   "text": "ורק עתה כשהוא לבד."
  },
  {
   "start": 533.76,
   "end": 536.96,
   "text": "תראו איזה כיבוד הורים, תראו איזה שליטה על המידות שלו."
  },
  {
   "start": 537.74,
   "end": 543.24,
   "text": "הוא פונה לאבא שלו ואומר, אבי ואברהם נרקן, הנני בני."
  },
  {
   "start": 544.72,
   "end": 546.1,
   "text": "אמר לו, יצחק,"
  },
  {
   "start": 546.9,
   "end": 548.24,
   "text": "הנה האש, עצים."
  },
  {
   "start": 549.32,
   "end": 549.44,
   "text": "אתה,"
  },
  {
   "start": 550.42,
   "end": 556.06,
   "text": "אתה העמסת עליי אש ועצים ואני סוחב כל הדרך, אני לוקחים כל הדרך את זה."
  },
  {
   "start": 557.26,
   "end": 558.16,
   "text": "כאילו הולכים להקריב קורבן."
  },
  {
   "start": 560.36,
   "end": 562.42,
   "text": "אבל אבא, איפה עשה?"
  },
  {
   "start": 563.0,
   "end": 565.86,
   "text": "את מה אנחנו מקריבים קורבן? את מה אנחנו מקריבים לעולה?"
  },
  {
   "start": 566.52,
   "end": 567.44,
   "text": "איפה הקורבן?"
  },
  {
   "start": 570.32,
   "end": 571.3,
   "text": "ואברהם עונה לו,"
  },
  {
   "start": 572.18,
   "end": 572.78,
   "text": "אלוקים,"
  },
  {
   "start": 573.78,
   "end": 576.42,
   "text": "יראה לי עשה לעולה,"
  },
  {
   "start": 577.72,
   "end": 578.24,
   "text": "בני."
  },
  {
   "start": 579.98,
   "end": 581.58,
   "text": "ויצחק מתחיל להבין,"
  },
  {
   "start": 584.98,
   "end": 586.9,
   "text": "אם לא נראה ש,"
  },
  {
   "start": 588.14,
   "end": 589.06,
   "text": "אתה הבן שלי,"
  },
  {
   "start": 590.18,
   "end": 598.62,
   "text": "תעלה לעולה. יצחק לא ילד, יצחק כבר בן 37. הוא יכול להתנגד."
  },
  {
   "start": 599.16,
   "end": 600.9,
   "text": "אברהם זקן בב הימים,"
  },
  {
   "start": 602.56,
   "end": 605.82,
   "text": "אבל למרות הכול, וילכו שניהם יחדיו,"
  },
  {
   "start": 606.84,
   "end": 609.8,
   "text": "יצחק הולך ביחד עם אבא שלו,"
  },
  {
   "start": 612.58,
   "end": 624.2,
   "text": "בן בעקבות אבא, במסע אל האמונה בדרך,"
  },
  {
   "start": 626.12,
   "end": 627.84,
   "text": "בדרך אל ניסיון כל כך עצום."
  },
  {
   "start": 628.72,
   "end": 636.2,
   "text": "מה אנחנו מבינים שצריכים להיתקל בכל מיני סימנים שיעזרו להם, יחזקו אותם?"
  },
  {
   "start": 636.86,
   "end": 641.5,
   "text": "כמו שאנחנו מצפים כשאנחנו מתקרבים אל השם שיהיו לנו דברים שיעזרו ויחזקו אותנו."
  },
  {
   "start": 642.34,
   "end": 644.1,
   "text": "אבל זו לא הדרך אל השם."
  },
  {
   "start": 645.76,
   "end": 648.38,
   "text": "בדרך אל הניסיון העצום,"
  },
  {
   "start": 650.52,
   "end": 652.52,
   "text": "במקום סייעתא דשמיא,"
  },
  {
   "start": 653.78,
   "end": 655.7,
   "text": "טמונים להם קשיים."
  },
  {
   "start": 656.24,
   "end": 659.52,
   "text": "טמונים להם כל הסיבות בעולם לחזור אחורה, לוותר."
  },
  {
   "start": 662.08,
   "end": 663.18,
   "text": "עכשיו אולי נבין"
  },
  {
   "start": 664.14,
   "end": 665.48,
   "text": "מהי דרך השם,"
  },
  {
   "start": 666.06,
   "end": 668.76,
   "text": "שגם כשאתה הולך לקדש שם שמיים,"
  },
  {
   "start": 669.7,
   "end": 671.16,
   "text": "יראו לך את כל האפשרויות שתתייאש,"
  },
  {
   "start": 672.86,
   "end": 676.88,
   "text": "שתחזור אחורה. היצר יילחם ולא ייתן לך לקדש שם שמיים."
  },
  {
   "start": 677.42,
   "end": 678.96,
   "text": "זו האמת, זה דרך השם."
  },
  {
   "start": 679.42,
   "end": 686.26,
   "text": "זה המפתח לכל הקושיות שלנו והקשיים שלנו, והאי-ההבנות שלנו. למה זה קורה לי? הרי אני רוצה כל כך טוב."
  },
  {
   "start": 687.44,
   "end": 688.38,
   "text": "זה הדרך."
  },
  {
   "start": 689.14,
   "end": 692.82,
   "text": "זה התחיל עוד מאברהם, אבי נחשם."
  },
  {
   "start": 694.24,
   "end": 696.2,
   "text": "נגלה לפתע לאברהם איש זקן."
  },
  {
   "start": 697.66,
   "end": 698.46,
   "text": "אומר לו, תגיד לי,"
  },
  {
   "start": 701.58,
   "end": 702.9,
   "text": "עד שהילד הזה נולד לך,"
  },
  {
   "start": 703.72,
   "end": 704.8,
   "text": "בגיל מאה שנה,"
  },
  {
   "start": 705.3,
   "end": 706.8,
   "text": "אתה עכשיו הולך לשחוט אותו?"
  },
  {
   "start": 707.18,
   "end": 708.62,
   "text": "הולך לשחוט את התקווה שלך?"
  },
  {
   "start": 709.28,
   "end": 711.3,
   "text": "תגיד לי, אתה מאמין לחלומות? מה קרה לך?"
  },
  {
   "start": 711.78,
   "end": 714.52,
   "text": "זה חלומות תעתועים, מה אתה עושה, אברהם?"
  },
  {
   "start": 715.38,
   "end": 718.3,
   "text": "אברהם, איבדת את שפיות דעתך? תגיד לי, מה אתה עושה?"
  },
  {
   "start": 721.31,
   "end": 725.33,
   "text": "ברא העולם באמת, אתה חושב, ישלח אותך ככה לעשות? להקריב קורבן אדם?"
  },
  {
   "start": 726.33,
   "end": 728.11,
   "text": "ואברהם נחוש בהחלטתו."
  },
  {
   "start": 728.73,
   "end": 730.45,
   "text": "ברא העולם אמר לי, ואני הולך אחריו."
  },
  {
   "start": 731.39,
   "end": 739.83,
   "text": "ואז אותו זקן משתמש באותו טיעון שמבלבל הרבה הרבה הרבה הרבה מהאנשים שרוצים לשמור תורה ומצוות."
  },
  {
   "start": 741.31,
   "end": 746.73,
   "text": "בא אותו זקן ואומר, תדע לך אברהם, אם אתה תעשה ככה, יתבעו אותך עוד בשמיים."
  },
  {
   "start": 747.15,
   "end": 748.83,
   "text": "יתבעו אותך על זה בשמיים!"
  },
  {
   "start": 753.17,
   "end": 754.69,
   "text": "ואברהם לא מתבלבל."
  },
  {
   "start": 756.09,
   "end": 757.53,
   "text": "אני עם הקדוש ברוך הוא נטו."
  },
  {
   "start": 758.39,
   "end": 759.85,
   "text": "הוא פשוט דוחה את אותו זקן."
  },
  {
   "start": 762.13,
   "end": 764.11,
   "text": "והזקן נעלם לו."
  },
  {
   "start": 764.11,
   "end": 773.98,
   "text": "זמן קצר אחר כך, נגדל לפתע בחור ליצחק."
  },
  {
   "start": 775.52,
   "end": 776.84,
   "text": "במקום לחזק את יצחק,"
  },
  {
   "start": 777.9,
   "end": 779.64,
   "text": "אותו בחור פונה ליצחק ואומר, תגיד לי,"
  },
  {
   "start": 780.6,
   "end": 783.7,
   "text": "מה אתה עכשיו אתה מבין שאתה, אבא שלך הזקן,"
  },
  {
   "start": 784.56,
   "end": 787.9,
   "text": "לוקח אותך ועצים ואש,"
  },
  {
   "start": 789.84,
   "end": 792.54,
   "text": "כנראה רוצה להעלות אותך, אתה הולך לשחיטה,"
  },
  {
   "start": 792.96,
   "end": 796.42,
   "text": "לא חבל לך לחיים שלך, אתה בחור צעיר, לא הקמת משפחה,"
  },
  {
   "start": 797.26,
   "end": 798.98,
   "text": "לא אכפת לך למות ככה סתם?"
  },
  {
   "start": 801.68,
   "end": 804.12,
   "text": "בגלל חלומות של אבא שלך, תראה מה אתה עושה."
  },
  {
   "start": 806.54,
   "end": 807.92,
   "text": "ויצחק ממשיך נחוש בדעתו."
  },
  {
   "start": 809.3,
   "end": 811.22,
   "text": "אבל אותו בחור לא מרפא ואומר לו, תראה יצחק,"
  },
  {
   "start": 811.66,
   "end": 814.54,
   "text": "לכל הפחות אם אתה לא מרחם על עצמך, חכמים על אימא שלך."
  },
  {
   "start": 815.58,
   "end": 820.88,
   "text": "אימא שלך מסכנה, איך היא תקבל את זה? למה אתה הורס לה את החיים? זה מצווה?"
  },
  {
   "start": 821.92,
   "end": 825.08,
   "text": "תגיד לי, מי יגיד אחרי הקדיש? מי?"
  },
  {
   "start": 825.42,
   "end": 827.5,
   "text": "מי יגיד אחרי אבא שלך קדיש? מצוות קדיש?"
  },
  {
   "start": 827.82,
   "end": 829.16,
   "text": "תחזור חזרה, זה מצווה."
  },
  {
   "start": 829.44,
   "end": 830.9,
   "text": "יתבעו אותך בשמיים על זה!"
  },
  {
   "start": 832.86,
   "end": 833.74,
   "text": "ולמרות כל זאת,"
  },
  {
   "start": 834.98,
   "end": 835.26,
   "text": "האבא"
  },
  {
   "start": 836.0,
   "end": 837.96,
   "text": "והבן שלו ממשיכים בדרכם."
  },
  {
   "start": 847.23,
   "end": 850.59,
   "text": "שגם כשאנחנו רוצים את השם ועושים את הטוב,"
  },
  {
   "start": 851.57,
   "end": 853.77,
   "text": "זה לא נפתח למניעת שערי השמיים."
  },
  {
   "start": 854.21,
   "end": 860.47,
   "text": "יש הרבה ניסיונות בדרך. היצר המנסה למנוע מאיתנו את השכר הצפון בעולם הבא, עולם הנצר."
  },
  {
   "start": 862.89,
   "end": 866.29,
   "text": "וזה מה שקורה לאברהם, האבא הגדול שלנו."
  },
  {
   "start": 866.69,
   "end": 867.61,
   "text": "זה מה שקורה לנו."
  },
  {
   "start": 868.51,
   "end": 875.23,
   "text": "ושם אברהם ויצחק ממשיכים בדרכם ובדרך בין שני הרים לפתע הם"
  },
  {
   "start": 875.85,
   "end": 878.83,
   "text": "נתקלים בנהר זורם ושוצף וקוצף,"
  },
  {
   "start": 879.39,
   "end": 880.93,
   "text": "לא נותן להם אפשרות להתקדם."
  },
  {
   "start": 882.25,
   "end": 885.95,
   "text": "הנה סיבה מספיק טובה לחזור, תהיית בדרך, תחזור חזרה, אי אפשר."
  },
  {
   "start": 887.07,
   "end": 887.67,
   "text": "אבל אברהם,"
  },
  {
   "start": 888.33,
   "end": 889.29,
   "text": "אברהם בנוי"
  },
  {
   "start": 890.67,
   "end": 891.57,
   "text": "בצורה אחרת."
  },
  {
   "start": 892.65,
   "end": 894.63,
   "text": "הוא אומר לבן שלו, ליצחק, הייתי פה."
  },
  {
   "start": 894.97,
   "end": 897.67,
   "text": "אני עברתי כאן כמה פעמים, לא היה מעולם נהר."
  },
  {
   "start": 898.93,
   "end": 902.99,
   "text": "אין זה אלא היצר הרע שמנסה למנוע מאיתנו את המצווה הגדולה הזאת."
  },
  {
   "start": 903.81,
   "end": 905.43,
   "text": "והוא מושיט יד ליצחק הבן שלו,"
  },
  {
   "start": 906.33,
   "end": 908.01,
   "text": "ויצחק לוקח את היד המושטת,"
  },
  {
   "start": 908.87,
   "end": 913.83,
   "text": "ויחד הם נכנסים אל תוך הנהר, בסכנת טביעה."
  },
  {
   "start": 914.43,
   "end": 918.83,
   "text": "צעד ועוד צעד ועוד צעד ועוד צעד, והם בתוך הנהר."
  },
  {
   "start": 919.29,
   "end": 920.97,
   "text": "והמים מגיעים להם אל החזה,"
  },
  {
   "start": 921.77,
   "end": 924.07,
   "text": "ואחרי זה אל הגרון, והם ממשיכים."
  },
  {
   "start": 924.65,
   "end": 925.95,
   "text": "והמים כבר בפה."
  },
  {
   "start": 926.77,
   "end": 931.89,
   "text": "ואז אברהם מרים את העיניים למעלה, בורא עולם, אני עשיתי את כל יכולתי."
  },
  {
   "start": 932.25,
   "end": 933.35,
   "text": "עשיתי את ההשתנות."
  },
  {
   "start": 933.73,
   "end": 934.33,
   "text": "עכשיו אתה."
  },
  {
   "start": 934.91,
   "end": 935.87,
   "text": "עכשיו אתה תעשה."
  },
  {
   "start": 938.38,
   "end": 944.72,
   "text": "והנהר מתייבש, נעלם לו בתוך שניות,"
  },
  {
   "start": 952.11,
   "end": 955.23,
   "text": "והם סוף סוף מעפילים אל ההר."
  },
  {
   "start": 972.14,
   "end": 974.3,
   "text": "ויבן שם אברהם את המזבח."
  },
  {
   "start": 975.82,
   "end": 978.1,
   "text": "אברהם משפץ מזבח שם,"
  },
  {
   "start": 978.58,
   "end": 979.44,
   "text": "בהר המוריה."
  },
  {
   "start": 980.26,
   "end": 983.0,
   "text": "זה המזבח שם הקריבו, אותו מזבח הקריב"
  },
  {
   "start": 983.72,
   "end": 984.92,
   "text": "לפני שנים קין,"
  },
  {
   "start": 986.1,
   "end": 986.9,
   "text": "הבל,"
  },
  {
   "start": 988.8,
   "end": 989.82,
   "text": "מנחה אל השם."
  },
  {
   "start": 990.42,
   "end": 991.22,
   "text": "זה אותו מזבח,"
  },
  {
   "start": 992.02,
   "end": 993.88,
   "text": "וביהי ונוח מזבח,"
  },
  {
   "start": 994.9,
   "end": 995.82,
   "text": "באותו מקום."
  },
  {
   "start": 996.94,
   "end": 1000.54,
   "text": "זה אותו מזבח שעכשיו אברהם משפץ אותו."
  },
  {
   "start": 1000.86,
   "end": 1005.96,
   "text": "זה אותו מזבח שמופנה אל מול כיסא הכבוד."
  },
  {
   "start": 1006.58,
   "end": 1009.36,
   "text": "המזבח בנוי מול כיסא הכבוד שם בשמיים."
  },
  {
   "start": 1010.9,
   "end": 1012.24,
   "text": "וכשהמזבח מוכן,"
  },
  {
   "start": 1013.48,
   "end": 1014.44,
   "text": "יצחק מתקרב."
  },
  {
   "start": 1016.14,
   "end": 1016.74,
   "text": "שעת המלאכה,"
  },
  {
   "start": 1022.6,
   "end": 1024.54,
   "text": "ויצחק נשכב על גבי המזבח."
  },
  {
   "start": 1026.66,
   "end": 1029.86,
   "text": "וישלח אברהם את ידו, ויקח את המאכלת."
  },
  {
   "start": 1030.9,
   "end": 1033.02,
   "text": "אתם יודעים למה הסכין נקראת מאכלת?"
  },
  {
   "start": 1034.52,
   "end": 1040.7,
   "text": "כי עד היום אנחנו אוכלים ונהנים מן הטובה הזאת."
  },
  {
   "start": 1040.7,
   "end": 1044.9,
   "text": "של אברהם ויצחק, מן העקדה הקדושה הזו."
  },
  {
   "start": 1046.6,
   "end": 1054.98,
   "text": "לכן היא נקראת מאחלת שכל עם ישראל לאורך כל הדורות אוכלים מהטובה שאותו סכין צופנת בעבורנו."
  },
  {
   "start": 1055.5,
   "end": 1056.7,
   "text": "זה לא סכין של שחיטה,"
  },
  {
   "start": 1057.08,
   "end": 1058.3,
   "text": "זה סכין של אהבה,"
  },
  {
   "start": 1058.64,
   "end": 1061.32,
   "text": "סכין של נתינה של קשר אל השם יתברך."
  },
  {
   "start": 1063.14,
   "end": 1063.44,
   "text": "ואז"
  },
  {
   "start": 1064.0,
   "end": 1065.56,
   "text": "פונה יצחק אל אבא שלו."
  },
  {
   "start": 1066.18,
   "end": 1068.36,
   "text": "אבא, אתה יודע,"
  },
  {
   "start": 1069.3,
   "end": 1070.3,
   "text": "אני חושש,"
  },
  {
   "start": 1070.88,
   "end": 1071.8,
   "text": "תראו ממה הוא חושש,"
  },
  {
   "start": 1072.64,
   "end": 1078.44,
   "text": "אני חושש שברגע האחרון כשתבוא להקריב אותי אל השם יתברך,"
  },
  {
   "start": 1079.34,
   "end": 1081.74,
   "text": "אל מלך מלכי המלאכים הקדוש ברוך הוא,"
  },
  {
   "start": 1082.36,
   "end": 1085.0,
   "text": "אני מפחד שאני אפחד ואתחרט."
  },
  {
   "start": 1085.84,
   "end": 1089.52,
   "text": "לכן אני מבקש ממך, אני פונה אליך מבקש,"
  },
  {
   "start": 1090.22,
   "end": 1090.94,
   "text": "תעקוד אותי,"
  },
  {
   "start": 1091.74,
   "end": 1093.7,
   "text": "תקשור אותי שאני לא אוכל לזוז,"
  },
  {
   "start": 1094.0,
   "end": 1096.86,
   "text": "שאני אמסור נפש בשלמות."
  },
  {
   "start": 1097.46,
   "end": 1098.3,
   "text": "אל השם יתברך."
  },
  {
   "start": 1098.76,
   "end": 1102.08,
   "text": "ואברהם עוקד את יצחק."
  },
  {
   "start": 1103.44,
   "end": 1107.2,
   "text": "אתם יודעים למה הניסיון הזה, למה זה נקרא עקדת יצחק?"
  },
  {
   "start": 1108.12,
   "end": 1108.76,
   "text": "היה צריך להיות הקרבה."
  },
  {
   "start": 1111.36,
   "end": 1112.26,
   "text": "ההקרבה,"
  },
  {
   "start": 1112.94,
   "end": 1115.04,
   "text": "הקרבת אברהם, הקרבת יצחק."
  },
  {
   "start": 1115.58,
   "end": 1116.94,
   "text": "למה עקדת יצחק?"
  },
  {
   "start": 1118.06,
   "end": 1120.2,
   "text": "זה היה הדבר הגדול של יצחק,"
  },
  {
   "start": 1120.88,
   "end": 1124.84,
   "text": "שיכול להתנגד, יכל להשאיר לעצמו רגע של מפלט,"
  },
  {
   "start": 1125.5,
   "end": 1127.82,
   "text": "אבל כולו מקריב את עצמו."
  },
  {
   "start": 1128.36,
   "end": 1130.32,
   "text": "ותקשור אותי שאני לא יזוז,"
  },
  {
   "start": 1130.78,
   "end": 1132.9,
   "text": "שאני אעקוד אל השם יתברך."
  },
  {
   "start": 1133.8,
   "end": 1136.68,
   "text": "לדורות זה נקרא עקידת יצחק,"
  },
  {
   "start": 1139.71,
   "end": 1144.95,
   "text": "ויצחק בן השלושים ושבע נותן לאבא שלו הזקן לעקוד אותו ממש כמו זה."
  },
  {
   "start": 1145.89,
   "end": 1147.65,
   "text": "ואברהם קושר את בנו האהוב,"
  },
  {
   "start": 1148.61,
   "end": 1152.07,
   "text": "ועיני אברהם נתמלאות דמעות,"
  },
  {
   "start": 1153.11,
   "end": 1157.81,
   "text": "והדמעות נופלות לתוך עיני יצחק."
  },
  {
   "start": 1161.05,
   "end": 1170.21,
   "text": "עיניים עם עיניים נפגשות ודמעות נושרות מאבא זקן שעוקד את הבן שלו,"
  },
  {
   "start": 1171.39,
   "end": 1172.41,
   "text": "את בנו האהובו."
  },
  {
   "start": 1175.09,
   "end": 1176.51,
   "text": "ושם למעלה בשמים,"
  },
  {
   "start": 1177.53,
   "end": 1182.97,
   "text": "מלאכי שמים הולכים וצועקים לפני הקדוש ברוך הוא,"
  },
  {
   "start": 1183.75,
   "end": 1186.55,
   "text": "ובוכים רחם עליהם."
  },
  {
   "start": 1187.09,
   "end": 1193.35,
   "text": "ריבונו של עולם תרחם על האבא הזקן ועל הבן שלו הצדיק."
  },
  {
   "start": 1201.05,
   "end": 1203.03,
   "text": "פונה הקדוש ברוך הוא אל מלאכי שמיים,"
  },
  {
   "start": 1204.49,
   "end": 1205.29,
   "text": "אתם זוכרים?"
  },
  {
   "start": 1207.27,
   "end": 1208.43,
   "text": "כשבראתי את העולם,"
  },
  {
   "start": 1210.01,
   "end": 1210.59,
   "text": "אמרתם"
  },
  {
   "start": 1211.19,
   "end": 1213.87,
   "text": "מה אנוש כי תזכרנו?"
  },
  {
   "start": 1215.51,
   "end": 1217.15,
   "text": "מה אנוש כי תזכרנו?"
  },
  {
   "start": 1217.81,
   "end": 1221.59,
   "text": "מה פתאום אתה בכלל פורע יצור כמו האדם?"
  },
  {
   "start": 1221.99,
   "end": 1228.27,
   "text": "הרי האדם הוא חוטא, הוא עושה הרע בעיני השם, מקלקל."
  },
  {
   "start": 1228.69,
   "end": 1231.55,
   "text": "מה הוא ראוי לעולם שאתה בורא?"
  },
  {
   "start": 1231.89,
   "end": 1234.35,
   "text": "מה האנוש כי תזכרנו? לא צריך להסתכל עליו בכלל,"
  },
  {
   "start": 1234.89,
   "end": 1237.05,
   "text": "לא צריך להביא אותו לאוויר העולם בכלל."
  },
  {
   "start": 1237.87,
   "end": 1240.69,
   "text": "ככה אתם אמרתם, ככה טענתם."
  },
  {
   "start": 1241.97,
   "end": 1242.51,
   "text": "תגידו לי,"
  },
  {
   "start": 1244.61,
   "end": 1249.73,
   "text": "אם הייתם יודעים שיהיה אדם גדול כמו אברהם,"
  },
  {
   "start": 1249.73,
   "end": 1254.47,
   "text": "שהאדם מסוגל להגיע לדרגות כאלה כמו אברהם,"
  },
  {
   "start": 1255.03,
   "end": 1256.11,
   "text": "כמו יצחק."
  },
  {
   "start": 1256.65,
   "end": 1258.31,
   "text": "האם הייתם מדפרים ככה?"
  },
  {
   "start": 1261.49,
   "end": 1267.43,
   "text": "וכל מלאכי קודש מודים כולם."
  },
  {
   "start": 1269.13,
   "end": 1271.43,
   "text": "הרכינו ראש ומודים כולם."
  },
  {
   "start": 1272.45,
   "end": 1280.15,
   "text": "לא היינו אומרים כך אם היינו יודעים שיהיה אדם שיגיע לדרגות של אברהם, של יצחק."
  },
  {
   "start": 1280.83,
   "end": 1297.68,
   "text": "לא היינו אומרים כך כשכולכם מלאכי קודש מודים בדרגתו של האדם כמו אברהם וכמו יצחק."
  },
  {
   "start": 1298.26,
   "end": 1298.68,
   "text": "תבינו,"
  },
  {
   "start": 1299.32,
   "end": 1309.52,
   "text": "תבינו למה היהודי חשוב ויהיה חשוב גם יותר מכם המלאכים לדורי דורות."
  },
  {
   "start": 1310.2,
   "end": 1316.55,
   "text": "יהודי הוא מעל המלאכים כי אנחנו הבנים של אברהם אבינו"
  },
  {
   "start": 1317.41,
   "end": 1319.59,
   "text": "שכל מלאכי שרת ירקימו ראש."
  },
  {
   "start": 1320.55,
   "end": 1322.79,
   "text": "ועכשיו פנה בורא העולם אל המלאכים,"
  },
  {
   "start": 1323.35,
   "end": 1326.91,
   "text": "בואו תראו מה באמת אני רוצה מאברהם."
  },
  {
   "start": 1328.27,
   "end": 1328.75,
   "text": "ואברהם,"
  },
  {
   "start": 1329.55,
   "end": 1331.49,
   "text": "שם למטה לוקח את המאכלת,"
  },
  {
   "start": 1332.15,
   "end": 1335.59,
   "text": "ובא במלוא הרצינות, בחרדת קודש,"
  },
  {
   "start": 1336.17,
   "end": 1336.77,
   "text": "בנחישות,"
  },
  {
   "start": 1337.73,
   "end": 1340.15,
   "text": "להקריב את הבן שלו ההוא ואת יצחק."
  },
  {
   "start": 1341.89,
   "end": 1342.39,
   "text": "והוא מקרב"
  },
  {
   "start": 1343.13,
   "end": 1343.77,
   "text": "את השקית,"
  },
  {
   "start": 1344.57,
   "end": 1346.11,
   "text": "וכבר הנה הוא מתחיל לשחוט."
  },
  {
   "start": 1347.11,
   "end": 1349.59,
   "text": "ויקרא אליו מלאך השם מן השמיים,"
  },
  {
   "start": 1350.33,
   "end": 1351.65,
   "text": "ויאמר אברהם,"
  },
  {
   "start": 1352.41,
   "end": 1353.81,
   "text": "אבל זה לא מספיק, אברהם,"
  },
  {
   "start": 1355.21,
   "end": 1359.03,
   "text": "אל תשלח ידך אל הנער ואל תעש לו מהומה."
  },
  {
   "start": 1360.11,
   "end": 1361.87,
   "text": "ומלאך ה' עוצר את אברהם."
  },
  {
   "start": 1362.69,
   "end": 1363.91,
   "text": "ברגע האחרון"
  },
  {
   "start": 1364.65,
   "end": 1367.89,
   "text": "אברהם בורא עולם לא רוצה בקורבן אדם."
  },
  {
   "start": 1369.01,
   "end": 1374.29,
   "text": "אברהם רוצה בלב של האדם, שהלב של האדם יהיה קורבן,"
  },
  {
   "start": 1374.61,
   "end": 1376.17,
   "text": "קורבן מלשון קרוב."
  },
  {
   "start": 1376.75,
   "end": 1378.81,
   "text": "שהלב של האדם, הלב של היהודי,"
  },
  {
   "start": 1378.81,
   "end": 1418.01,
   "text": "הלב של היהודייה יהיו קרובים אל השם זה הקורבן אל תשלח ידך אל הנער ואברהם נעצר אחרי שמלאך השם צבקות עוצר אותו ברגע האחרון אם חשבתם שאברהם"
  },
  {
   "start": 1419.35,
   "end": 1424.91,
   "text": "זז משם נגמר הכל עדיין לא אברהם מסרב לזוז משם"
  },
  {
   "start": 1426.03,
   "end": 1426.91,
   "text": "אתם יודעים למה?"
  },
  {
   "start": 1428.09,
   "end": 1431.01,
   "text": "אברהם בא ואת הרגע הקדוש והנעלה הזה"
  },
  {
   "start": 1432.35,
   "end": 1435.53,
   "text": "מנצל אברהם קם ואומר, ריבונו של עולם,"
  },
  {
   "start": 1436.19,
   "end": 1442.51,
   "text": "אני נשבעתי בשבועה חמורה שלא אזוז מכאן עד שתמלא את אשר ביקשתי."
  },
  {
   "start": 1445.18,
   "end": 1448.02,
   "text": "אני רוצה בורא עולם שתחשיב את זה"
  },
  {
   "start": 1448.66,
   "end": 1450.74,
   "text": "כאילו הקרבתי את הבן שלי."
  },
  {
   "start": 1451.98,
   "end": 1456.16,
   "text": "בורא עולם אני לא זז מכאן עד שתחשיב את זה כאילו באמת הקרבתי את הבן שלי."
  },
  {
   "start": 1456.88,
   "end": 1461.5,
   "text": "וזכותו והזכות הזאת תעמוד לעם ישראל לילדים שלי."
  },
  {
   "start": 1462.38,
   "end": 1464.54,
   "text": "לעם ישראל, לכל הדורות."
  },
  {
   "start": 1467.28,
   "end": 1468.62,
   "text": "זה מה שאני מבקש ממך."
  },
  {
   "start": 1474.65,
   "end": 1475.65,
   "text": "תבורא עולם,"
  },
  {
   "start": 1476.35,
   "end": 1478.37,
   "text": "העולם פונה אל אברהם ואומר לו,"
  },
  {
   "start": 1478.81,
   "end": 1480.05,
   "text": "אברהם, אברהם,"
  },
  {
   "start": 1480.67,
   "end": 1481.99,
   "text": "אתה יודע איזה יום היום?"
  },
  {
   "start": 1482.71,
   "end": 1484.33,
   "text": "היום זה יום ראש השנה."
  },
  {
   "start": 1485.39,
   "end": 1490.95,
   "text": "בראש השנה אני שופט את כל העולם, את כל יצורי העולם."
  },
  {
   "start": 1492.05,
   "end": 1493.57,
   "text": "כשאני דן את העולם,"
  },
  {
   "start": 1494.69,
   "end": 1495.57,
   "text": "הילדים שלך"
  },
  {
   "start": 1496.51,
   "end": 1501.35,
   "text": "ייקחו שופר וידקעו בו,"
  },
  {
   "start": 1502.01,
   "end": 1506.11,
   "text": "ואני אזכור את העקדה כל שנה,"
  },
  {
   "start": 1506.83,
   "end": 1509.03,
   "text": "כל שנה עד תום העולם הזה."
  },
  {
   "start": 1509.89,
   "end": 1512.13,
   "text": "כל פעם שידקעו בשופר,"
  },
  {
   "start": 1512.63,
   "end": 1520.75,
   "text": "אני אזכור את העקדה וארחם עליהם ואברהם שמח כל כך."
  },
  {
   "start": 1522.57,
   "end": 1529.73,
   "text": "הוא פונה לאחוריו וראה אייל, אייל נאחז בסבך בקרניו ומעלה אותו"
  },
  {
   "start": 1530.89,
   "end": 1532.49,
   "text": "תחת יצחק היא העולם."
  },
  {
   "start": 1540.83,
   "end": 1542.71,
   "text": "בכל אומות העולם היה רעש גדול."
  },
  {
   "start": 1543.39,
   "end": 1544.09,
   "text": "רעש גדול."
  },
  {
   "start": 1544.97,
   "end": 1548.11,
   "text": "כי מקום העקדה היה נמוך מאוד, המקום בו היה העקדה."
  },
  {
   "start": 1548.99,
   "end": 1550.25,
   "text": "אבל משעת העקדה,"
  },
  {
   "start": 1551.15,
   "end": 1552.85,
   "text": "משהשכינה הופיעה שם,"
  },
  {
   "start": 1553.85,
   "end": 1557.91,
   "text": "לפתע נתכנסו ההרים, ונעשה מקום גבוה מאוד."
  },
  {
   "start": 1559.07,
   "end": 1563.67,
   "text": "וכך התפרסמה עקדת יצחק בכל אומות העולם."
  },
  {
   "start": 1564.65,
   "end": 1565.63,
   "text": "כולם ידעו מזה,"
  },
  {
   "start": 1566.45,
   "end": 1569.71,
   "text": "כולם התפעלו, כולם קרעו ברך"
  },
  {
   "start": 1570.53,
   "end": 1575.23,
   "text": "לאדם שהגיע למדרגה כל כך נשגבה בעבודת השם."
  },
  {
   "start": 1575.89,
   "end": 1577.67,
   "text": "לכן קרא אברהם למקום ההוא,"
  },
  {
   "start": 1585.44,
   "end": 1589.78,
   "text": "אשר ייאמר היום בהר השם ייראה,"
  },
  {
   "start": 1590.5,
   "end": 1591.82,
   "text": "ייראה לעיני כולם."
  },
  {
   "start": 1595.26,
   "end": 1596.86,
   "text": "אשר ייאמר היום כאן,"
  },
  {
   "start": 1597.66,
   "end": 1598.26,
   "text": "בעקטה,"
  },
  {
   "start": 1598.88,
   "end": 1601.08,
   "text": "בהר השם ייראה לעיני כולם."
  },
  {
   "start": 1604.4,
   "end": 1606.96,
   "text": "זכות העקדה לא נגמרה עד היום הזה."
  },
  {
   "start": 1608.14,
   "end": 1611.94,
   "text": "וכשאנחנו, עם ישראל, שוהים בצער וזקוקים לרחמים,"
  },
  {
   "start": 1612.6,
   "end": 1615.16,
   "text": "מבקשים מהקדוש ברוך הוא, תזכור לנו את עקידת יצחק,"
  },
  {
   "start": 1615.94,
   "end": 1617.08,
   "text": "והקדוש ברוך הוא מרחם עלינו."
  },
  {
   "start": 1619.55,
   "end": 1621.17,
   "text": "ותראו לכם, שום דבר לא נפסד."
  },
  {
   "start": 1622.03,
   "end": 1624.33,
   "text": "אותו עיל שהוקרב לבסוף,"
  },
  {
   "start": 1624.99,
   "end": 1625.85,
   "text": "האפר שלו"
  },
  {
   "start": 1627.75,
   "end": 1631.15,
   "text": "ישמש ליסוד המזבח של בית המקדש."
  },
  {
   "start": 1632.67,
   "end": 1639.3,
   "text": "מעשרת הגידים שלו נעשו עשרה מטרים לכינורו של דוד."
  },
  {
   "start": 1640.3,
   "end": 1644.1,
   "text": "מהעור שלו נעשה אזור לאליהו הנביא."
  },
  {
   "start": 1645.42,
   "end": 1652.8,
   "text": "מקרן אחת של העיל עשו את השופר שתקעו בו בסיני בשעת מתן תורה."
  },
  {
   "start": 1653.9,
   "end": 1655.4,
   "text": "ואת הקרן השנייה?"
  },
  {
   "start": 1656.16,
   "end": 1661.66,
   "text": "מהקרן השנייה יעשו שופר לעתיד לבוא בגאולה השלמה."
  },
  {
   "start": 1662.84,
   "end": 1665.34,
   "text": "אז ייתקע בשופר גדול,"
  },
  {
   "start": 1665.92,
   "end": 1669.3,
   "text": "הקרן השנייה של העיל ממתילה לנו."
  },
  {
   "start": 1669.7,
   "end": 1673.12,
   "text": "עוד נשמע את הקריאה הזאת, התקיעה הזאת,"
  },
  {
   "start": 1673.58,
   "end": 1675.76,
   "text": "ונבוא לקבל את מלך המשיח."
  },
  {
   "start": 1678.34,
   "end": 1680.06,
   "text": "זה השורש שעליו גדלנו."
  },
  {
   "start": 1680.54,
   "end": 1682.18,
   "text": "שורש של מסירות נפש."
  },
  {
   "start": 1682.54,
   "end": 1684.08,
   "text": "שורש של קרבה אל השם."
  },
  {
   "start": 1684.44,
   "end": 1686.92,
   "text": "שורש של דפקות בשם יברך."
  },
  {
   "start": 1687.36,
   "end": 1689.3,
   "text": "ואת זה אנחנו חייבים להמשיך."
  },
  {
   "start": 1689.82,
   "end": 1691.24,
   "text": "בדרך הזאת חייבים ללכת."
  },
  {
   "start": 1692.4,
   "end": 1694.34,
   "text": "במיוחד בדור כמו שלנו."
  },
  {
   "start": 1694.98,
   "end": 1696.96,
   "text": "צריכים ללכת בדרכי אבותינו."
  },
  {
   "start": 1698.08,
   "end": 1699.14,
   "text": "כי רק ככה ננצח."
  },
  {
   "start": 1702.8,
   "end": 1705.6,
   "text": "אברהם, זקן ושבע ימיני,"
  },
  {
   "start": 1706.32,
   "end": 1710.99,
   "text": "זכה לראות את יצחק מוליד ילדים,"
  },
  {
   "start": 1711.79,
   "end": 1713.41,
   "text": "זוכה לדרגות נשגבות,"
  },
  {
   "start": 1713.73,
   "end": 1715.61,
   "text": "זכה לראות אפילו את הנכד שלו,"
  },
  {
   "start": 1716.09,
   "end": 1718.43,
   "text": "את יעקב, עמוד התורה הקדושה."
  },
  {
   "start": 1719.17,
   "end": 1725.55,
   "text": "אברהם זכה לחבר את ספר היצירה הקדוש וזיכה את עצמו ואותנו,"
  },
  {
   "start": 1726.23,
   "end": 1727.31,
   "text": "לעולם הזה,"
  },
  {
   "start": 1727.89,
   "end": 1729.13,
   "text": "לעולם הבא,"
  },
  {
   "start": 1730.03,
   "end": 1731.31,
   "text": "לעולם שכולו טוב."
  },
  {
   "start": 1731.31,
   "end": 1734.03,
   "text": "כמה זה מחייב אותנו,"
  },
  {
   "start": 1734.83,
   "end": 1739.59,
   "text": "כמה זה משמח אותנו שזכינו לאבא כל כך קדוש ונעלה."
  },
  {
   "start": 1740.69,
   "end": 1742.07,
   "text": "אז מה שנשאר לנו היום,"
  },
  {
   "start": 1742.69,
   "end": 1745.83,
   "text": "לך, לך ולי, לכולנו,"
  },
  {
   "start": 1747.31,
   "end": 1750.91,
   "text": "להתאחד סביב הדגל של הקדוש ברוך הוא,"
  },
  {
   "start": 1752.63,
   "end": 1756.55,
   "text": "ולדעת שכל מה שאנחנו עושים הם כל הדברים הקטנים שעושים היום,"
  },
  {
   "start": 1757.83,
   "end": 1759.41,
   "text": "זה הקורבנות שלנו,"
  },
  {
   "start": 1759.93,
   "end": 1761.69,
   "text": "לעקוד את היצרים שלנו,"
  },
  {
   "start": 1762.29,
   "end": 1768.39,
   "text": "לעקוד את הנפילות שלנו, להגיד אני הולך לכבוד השם יתברך."
  },
  {
   "start": 1769.45,
   "end": 1770.23,
   "text": "צריך לדעת,"
  },
  {
   "start": 1771.09,
   "end": 1774.43,
   "text": "אברהם היה מוכן, הוא והבן שלו, למות על קידוש השם."
  },
  {
   "start": 1774.93,
   "end": 1785.23,
   "text": "רוצים מאיתנו שנחיה על קידוש השם, שנמסור נפש, נמסור את התאוות שלנו, את הקשיים שלנו, את הניסיונות שלנו לכבוד השם יתברך,"
  },
  {
   "start": 1785.53,
   "end": 1788.53,
   "text": "וגם אם נפלנו לקום ולהמשיך הלאה,"
  },
  {
   "start": 1788.53,
   "end": 1793.43,
   "text": "להמשיך הלאה, לא לתת ליצירה לנצח אותנו, כי אנחנו הפנים של אבא הקדוש,"
  },
  {
   "start": 1793.75,
   "end": 1797.01,
   "text": "פנים של אברהם אבינו, פנים של שרה אימנו,"
  },
  {
   "start": 1797.65,
   "end": 1800.01,
   "text": "פנים של יצחק הנאגד,"
  },
  {
   "start": 1805.07,
   "end": 1806.35,
   "text": "שזכינו להיות יהודים."
  }
 ]
}