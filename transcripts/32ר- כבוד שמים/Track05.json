{
 "disc": "32ר- כבוד שמים",
 "track": "Track05",
 "duration": 607.152,
 "segments": [
  {
   "start": 6.28,
   "end": 6.96,
   "text": "באותה תקופה"
  },
  {
   "start": 7.58,
   "end": 9.72,
   "text": "פורצת לה מלחמת"
  },
  {
   "start": 10.34,
   "end": 11.5,
   "text": "העולם הראשונה."
  },
  {
   "start": 13.0,
   "end": 13.96,
   "text": "ארבעה מלכים"
  },
  {
   "start": 14.92,
   "end": 16.0,
   "text": "כנגד החמישה."
  },
  {
   "start": 19.78,
   "end": 20.72,
   "text": "ארבעה מלכים,"
  },
  {
   "start": 23.22,
   "end": 24.26,
   "text": "גדר לעומר,"
  },
  {
   "start": 24.94,
   "end": 25.54,
   "text": "נמרוד,"
  },
  {
   "start": 26.18,
   "end": 29.24,
   "text": "דדעל ואריוך כנגד"
  },
  {
   "start": 30.02,
   "end": 32.26,
   "text": "מלכי סדום, עמורה, אדמה,"
  },
  {
   "start": 32.84,
   "end": 33.8,
   "text": "זרועים וצוער."
  },
  {
   "start": 34.34,
   "end": 37.92,
   "text": "מלחמת הארבעה כנגד החמישה."
  },
  {
   "start": 38.56,
   "end": 40.28,
   "text": "מלחמת עולם של ממש."
  },
  {
   "start": 43.79,
   "end": 45.27,
   "text": "והמלחמה פורצת לה במלוא עוזה."
  },
  {
   "start": 48.92,
   "end": 51.56,
   "text": "ומה שקורה בשדה הקרב, אחרי קרבות קשים,"
  },
  {
   "start": 52.8,
   "end": 53.9,
   "text": "ארבעת המלכים,"
  },
  {
   "start": 54.48,
   "end": 58.16,
   "text": "קדר לעומר, נמרוד, תדעל ואריוך מנצחים."
  },
  {
   "start": 62.11,
   "end": 65.89,
   "text": "על אברהם זה לא צריך להשפיע לבד מעובדה אחת קטנה,"
  },
  {
   "start": 66.71,
   "end": 67.85,
   "text": "אבל משמעותית."
  },
  {
   "start": 70.03,
   "end": 71.03,
   "text": "שם בסדום,"
  },
  {
   "start": 72.81,
   "end": 72.97,
   "text": "לוט,"
  },
  {
   "start": 74.05,
   "end": 76.77,
   "text": "לוט בין אחיו של אברהם בשבי אצל נמרוד."
  },
  {
   "start": 78.47,
   "end": 79.45,
   "text": "ואברהם שומע על כך."
  },
  {
   "start": 80.57,
   "end": 81.77,
   "text": "שלוט שבוי אצל נמרוד."
  },
  {
   "start": 84.23,
   "end": 86.29,
   "text": "ואברהם יודע שיש בעיה גדולה."
  },
  {
   "start": 87.45,
   "end": 88.01,
   "text": "מה הבעיה?"
  },
  {
   "start": 89.79,
   "end": 91.59,
   "text": "לוט דומה לאברהם."
  },
  {
   "start": 93.43,
   "end": 95.17,
   "text": "לוט דומה מאוד היה לאברהם."
  },
  {
   "start": 95.75,
   "end": 97.57,
   "text": "עכשיו יכול לקחת נמרוד את לוט"
  },
  {
   "start": 98.41,
   "end": 101.17,
   "text": "ולנופף בכל מיני דברים ולומר שזה אברהם."
  },
  {
   "start": 103.72,
   "end": 106.62,
   "text": "לוט יאמר כל מיני דברים ויגידו זה אברהם."
  },
  {
   "start": 108.04,
   "end": 110.84,
   "text": "ואברהם יודע שיש פה עניין של כבוד שמיים,"
  },
  {
   "start": 111.94,
   "end": 113.62,
   "text": "שהוא יכול להכריח את לוט,"
  },
  {
   "start": 114.14,
   "end": 114.68,
   "text": "אותו נמרוד,"
  },
  {
   "start": 115.1,
   "end": 117.32,
   "text": "להוציא דברי כפירה, רחמנא ליצלן,"
  },
  {
   "start": 118.02,
   "end": 120.1,
   "text": "ויהיה פה בעיה של חילול שם שמיים."
  },
  {
   "start": 120.76,
   "end": 121.8,
   "text": "יגידו שזה אברהם."
  },
  {
   "start": 122.94,
   "end": 124.58,
   "text": "כל אותם אנשים שאברהם קירב"
  },
  {
   "start": 125.48,
   "end": 126.78,
   "text": "יחשבו שזה אברהם."
  },
  {
   "start": 128.1,
   "end": 129.34,
   "text": "ואברהם כבוד שמיים?"
  },
  {
   "start": 129.9,
   "end": 132.18,
   "text": "אין ברירה, הוא יוצא להציל את לוט."
  },
  {
   "start": 133.4,
   "end": 134.1,
   "text": "אבל אברהם,"
  },
  {
   "start": 134.88,
   "end": 136.12,
   "text": "אתה אדם מבוגר."
  },
  {
   "start": 136.98,
   "end": 137.86,
   "text": "אין לך צבא."
  },
  {
   "start": 138.9,
   "end": 141.4,
   "text": "מה אתה יוצא כנגד ארבעה מלכים?"
  },
  {
   "start": 142.26,
   "end": 145.08,
   "text": "אברהם אבל יודע כבוד שמיים אני יוצא."
  },
  {
   "start": 145.9,
   "end": 149.14,
   "text": "אבל אין לך סיכוי מול עשרות אלפי לוחמים, אברהם."
  },
  {
   "start": 149.8,
   "end": 152.18,
   "text": "אתה יוצא אתה ואליעזר העבד שלך."
  },
  {
   "start": 153.86,
   "end": 157.7,
   "text": "כשכבוד שמיים מונח על המאזניים,"
  },
  {
   "start": 158.22,
   "end": 159.8,
   "text": "לא עושים חשבונות."
  },
  {
   "start": 160.44,
   "end": 162.46,
   "text": "אברהם יוצא למלחמה."
  },
  {
   "start": 174.64,
   "end": 175.46,
   "text": "ואברהם,"
  },
  {
   "start": 176.18,
   "end": 177.76,
   "text": "אברהם, תאמינו או לא,"
  },
  {
   "start": 178.32,
   "end": 179.64,
   "text": "אברהם נלחם."
  },
  {
   "start": 180.3,
   "end": 181.2,
   "text": "ללא פחד,"
  },
  {
   "start": 181.86,
   "end": 182.58,
   "text": "ללא מורא."
  },
  {
   "start": 183.52,
   "end": 187.26,
   "text": "כבוד שמיים, זה מה שמעניין את אברהם אבינו."
  },
  {
   "start": 188.58,
   "end": 189.48,
   "text": "ואתם יודעים מה קורה?"
  },
  {
   "start": 190.6,
   "end": 191.9,
   "text": "כשאברהם נלחם,"
  },
  {
   "start": 193.66,
   "end": 194.58,
   "text": "יותר נכון,"
  },
  {
   "start": 195.22,
   "end": 196.24,
   "text": "לא אברהם נלחם,"
  },
  {
   "start": 197.0,
   "end": 198.04,
   "text": "מהשמיים,"
  },
  {
   "start": 198.72,
   "end": 200.64,
   "text": "מהשמיים נלחמים עבורו."
  },
  {
   "start": 201.94,
   "end": 205.48,
   "text": "צריך לדעת מכל מצווה שעושה האדם נוצר מלאך."
  },
  {
   "start": 206.78,
   "end": 209.4,
   "text": "מכל החסד והצדקות שאברהם עשה,"
  },
  {
   "start": 210.02,
   "end": 214.9,
   "text": "קמה לה הצדקה והחלה צווחת לפני הקדוש ברוך הוא."
  },
  {
   "start": 215.32,
   "end": 220.06,
   "text": "אילולא אברהם בעולם מי היה מקיים מצוות צדקה?"
  },
  {
   "start": 220.46,
   "end": 223.46,
   "text": "עכשיו אברהם הולך למות במלחמה הרי אין לו סיכוי."
  },
  {
   "start": 223.78,
   "end": 227.0,
   "text": "אילולא אברהם בעולם מי היה מקיים מצוות צדקה?"
  },
  {
   "start": 229.62,
   "end": 231.88,
   "text": "ומהשמיים נלחמים עבור אברהם."
  },
  {
   "start": 232.74,
   "end": 233.56,
   "text": "אברהם לוקח עפר,"
  },
  {
   "start": 236.27,
   "end": 236.65,
   "text": "חול,"
  },
  {
   "start": 237.49,
   "end": 239.03,
   "text": "וזורק אותו. זה הכל."
  },
  {
   "start": 239.89,
   "end": 242.43,
   "text": "קצת השתדלות, מזיז את היד וקצת זורק."
  },
  {
   "start": 245.2,
   "end": 246.28,
   "text": "ופלאי פלאות,"
  },
  {
   "start": 247.58,
   "end": 250.64,
   "text": "החול הזה נהפך לכלי נשק קטנטי."
  },
  {
   "start": 253.34,
   "end": 255.82,
   "text": "למעין נשורת רדיואקטיבית"
  },
  {
   "start": 256.92,
   "end": 259.56,
   "text": "שפוגעת והורסת כל חלקה טובה."
  },
  {
   "start": 262.72,
   "end": 266.54,
   "text": "לגשם שחור שיוצר מוות וכיליון."
  },
  {
   "start": 268.58,
   "end": 269.26,
   "text": "ואברהם,"
  },
  {
   "start": 269.98,
   "end": 271.04,
   "text": "אברהם העברי,"
  },
  {
   "start": 271.7,
   "end": 274.48,
   "text": "כל העולם מצד אחד והוא יחידי בצד השני."
  },
  {
   "start": 275.84,
   "end": 278.32,
   "text": "אבל הוא לא יחידי, כי הקדוש ברוך הוא איתו."
  },
  {
   "start": 278.92,
   "end": 282.48,
   "text": "וכשהקדוש ברוך הוא איתך, גם אם נראה שאתה יחידי,"
  },
  {
   "start": 283.12,
   "end": 283.92,
   "text": "הכל איתך."
  },
  {
   "start": 285.14,
   "end": 285.98,
   "text": "והוא מנצח"
  },
  {
   "start": 287.26,
   "end": 289.66,
   "text": "את כל ארבעת המלכים האדירים האלה,"
  },
  {
   "start": 292.76,
   "end": 293.8,
   "text": "ואברהם חוזר עם לוט."
  },
  {
   "start": 300.48,
   "end": 302.08,
   "text": "כשאברהם חזר מהמלחמה,"
  },
  {
   "start": 304.81,
   "end": 307.55,
   "text": "הוא עובר דרך מקום שנקרא בארות חמר."
  },
  {
   "start": 309.23,
   "end": 309.97,
   "text": "ושם הוא עומד,"
  },
  {
   "start": 312.78,
   "end": 314.1,
   "text": "רואה מראה מזעזע."
  },
  {
   "start": 324.71,
   "end": 325.97,
   "text": "המקום בארות חמר"
  },
  {
   "start": 326.39,
   "end": 336.58,
   "text": "היה אזור מלא בארותית ואנשים רבים כשהם ברחו בזמן מלחמת הארבעה כנגד החמישה"
  },
  {
   "start": 337.46,
   "end": 340.94,
   "text": "אז אותם הניצולים מהחמישה מלכים שהפסידו"
  },
  {
   "start": 341.46,
   "end": 349.14,
   "text": "או כל מיני אנשים שברחו הגיעו לאזור הזה ושקעו ונבלעו למוות"
  },
  {
   "start": 352.02,
   "end": 356.64,
   "text": "וכשאברהם מגיע הוא שומע לפתע"
  },
  {
   "start": 357.98,
   "end": 359.04,
   "text": "זעקות רמות"
  },
  {
   "start": 359.92,
   "end": 362.08,
   "text": "הוא שומע זעקות רמות,"
  },
  {
   "start": 363.64,
   "end": 364.92,
   "text": "ולא פחות ולא יותר."
  },
  {
   "start": 366.24,
   "end": 367.16,
   "text": "מלך סדום."
  },
  {
   "start": 368.22,
   "end": 368.86,
   "text": "מלך סדום"
  },
  {
   "start": 370.42,
   "end": 371.36,
   "text": "נלכד בתוך"
  },
  {
   "start": 373.0,
   "end": 373.86,
   "text": "בורטית כזה,"
  },
  {
   "start": 374.82,
   "end": 375.86,
   "text": "בורטית קטלני,"
  },
  {
   "start": 376.62,
   "end": 378.06,
   "text": "מעין חולות טוב עניים,"
  },
  {
   "start": 380.21,
   "end": 382.21,
   "text": "והוא שוקע באיטיות אכזרית."
  },
  {
   "start": 384.45,
   "end": 387.95,
   "text": "ועשרות מהאנשים שלו מנסים להוציא אותו, אבל אי אפשר."
  },
  {
   "start": 388.53,
   "end": 390.51,
   "text": "יש איזה כוח שמושך אותו למטה,"
  },
  {
   "start": 391.45,
   "end": 394.39,
   "text": "ומבט של ייאוש תהומי בעיניו,"
  },
  {
   "start": 394.97,
   "end": 396.49,
   "text": "והם מנסים ולא מצליחים."
  },
  {
   "start": 398.31,
   "end": 400.97,
   "text": "שרירים מאומצים, זיעה נוטפת,"
  },
  {
   "start": 401.87,
   "end": 409.06,
   "text": "ושום דבר לא עוצר את השאיבה של מלך סדום פנימה,"
  },
  {
   "start": 409.74,
   "end": 410.32,
   "text": "אל המוות,"
  },
  {
   "start": 411.48,
   "end": 412.2,
   "text": "אל סופו."
  },
  {
   "start": 414.08,
   "end": 414.58,
   "text": "אבל אז,"
  },
  {
   "start": 416.3,
   "end": 417.86,
   "text": "אל המקום מגיע אברהם."
  },
  {
   "start": 417.86,
   "end": 422.66,
   "text": "אברהם זה שכבות שמיים לנגד עיניו"
  },
  {
   "start": 423.74,
   "end": 424.98,
   "text": "ובהוא רואה את המצוקה"
  },
  {
   "start": 426.28,
   "end": 427.36,
   "text": "והוא אומר דבר אחד"
  },
  {
   "start": 428.96,
   "end": 434.08,
   "text": "מסתכל על המלך סדום ואומר צא, צא,"
  },
  {
   "start": 435.98,
   "end": 440.46,
   "text": "אומר את התורה הקדושה ויצא מלך סדום לקראתו"
  },
  {
   "start": 441.92,
   "end": 443.74,
   "text": "פשוט ברגע שאברהם אמר צא,"
  },
  {
   "start": 444.52,
   "end": 445.12,
   "text": "מלך סדום"
  },
  {
   "start": 445.12,
   "end": 448.62,
   "text": "כאילו משהו מושך אותו החוצה,"
  },
  {
   "start": 449.26,
   "end": 451.58,
   "text": "פשוט יוצא בקלילות מהבור,"
  },
  {
   "start": 451.92,
   "end": 452.82,
   "text": "מבור המוות,"
  },
  {
   "start": 453.14,
   "end": 455.38,
   "text": "מהמלכודת האימתנית הזאת החוצה."
  },
  {
   "start": 456.26,
   "end": 457.88,
   "text": "וכולם נרעשים מסביב,"
  },
  {
   "start": 458.9,
   "end": 459.56,
   "text": "לא מבינים."
  },
  {
   "start": 460.24,
   "end": 461.52,
   "text": "כבשן האש."
  },
  {
   "start": 462.6,
   "end": 463.8,
   "text": "הוא ניצל אברהם."
  },
  {
   "start": 464.74,
   "end": 466.82,
   "text": "במלחמה מול ארבע מלכים,"
  },
  {
   "start": 467.14,
   "end": 470.8,
   "text": "מול עשרות אלפי לוחמים, הוא והעבד שלו מנצחים."
  },
  {
   "start": 472.1,
   "end": 472.68,
   "text": "ועכשיו,"
  },
  {
   "start": 473.64,
   "end": 476.5,
   "text": "את מלך סדום במילה אחת הוא מוציא החוצה."
  },
  {
   "start": 478.58,
   "end": 479.4,
   "text": "מבור מוות"
  },
  {
   "start": 480.04,
   "end": 491.66,
   "text": "חסר סיכוי הצלה מיד כולם מרכינים את ראשם ובפה אחד כולם אומרים נשיא אלוקים אתה בתוכנו."
  },
  {
   "start": 492.24,
   "end": 494.02,
   "text": "אתה הוא הנציג של השם יתברך."
  },
  {
   "start": 494.84,
   "end": 500.66,
   "text": "אתה האמונה שלך אמת ובורא עולם אמת. נשיא אלוקים אתה בתוכנו."
  },
  {
   "start": 501.96,
   "end": 503.96,
   "text": "שם שמיים מתקדש סוף סוף."
  },
  {
   "start": 504.48,
   "end": 513.4,
   "text": "בקרב רוב גויים המון גויים העולם נוכח לדעת השם הוא האלוקים השם האלוקים כבוד שמאי מושג."
  },
  {
   "start": 514.46,
   "end": 525.32,
   "text": "ואברהם שמח כל כך כנגד הסיכויים כנגד הכל הוא בסוף מנצח לוקח זמן אבל בסוף כולם יודעים"
  },
  {
   "start": 526.68,
   "end": 533.2,
   "text": "כולם מבינים השם הוא האלוקים כמה זה חשוב לנו לדעת בכל החושך"
  },
  {
   "start": 533.82,
   "end": 537.84,
   "text": "כמה שיהיה לנו בעיות בעבודה, בבית, במשפחה,"
  },
  {
   "start": 538.46,
   "end": 540.58,
   "text": "בכל מקום שיהיה."
  },
  {
   "start": 541.56,
   "end": 543.86,
   "text": "לא לוותר על כבוד שמיים."
  },
  {
   "start": 545.62,
   "end": 546.92,
   "text": "ללכת, לא לפחד."
  },
  {
   "start": 547.38,
   "end": 548.96,
   "text": "אנחנו עם הקדוש ברוך הוא."
  },
  {
   "start": 549.94,
   "end": 551.24,
   "text": "לא צריך לריב עם אף אחד."
  },
  {
   "start": 551.68,
   "end": 552.86,
   "text": "צריך להיות עם השם יתברך."
  },
  {
   "start": 553.24,
   "end": 554.58,
   "text": "צריך להמשיך באמונה."
  },
  {
   "start": 555.1,
   "end": 556.9,
   "text": "לא להתפשר עם עצמנו."
  },
  {
   "start": 557.68,
   "end": 561.64,
   "text": "לא לתת לנפילות להפיל אותנו לגמרי. לקום להמשיך הלאה."
  },
  {
   "start": 561.64,
   "end": 568.22,
   "text": "כי בסוף כבוד שמיים יעלה הלאה וכולם יגידו, השם הוא אלוקים, השם הוא אלוקים."
  }
 ]
}