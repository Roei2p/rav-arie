{
 "disc": "32ר- כבוד שמים",
 "track": "Track03",
 "duration": 568.176,
 "segments": [
  {
   "start": 5.58,
   "end": 8.44,
   "text": "באותה תקופה היה מלך מושל בעולם."
  },
  {
   "start": 9.22,
   "end": 9.9,
   "text": "קראו לו נמרוד."
  },
  {
   "start": 10.96,
   "end": 13.54,
   "text": "אותו נמרוד ממש מרד בקדוש ברוך הוא."
  },
  {
   "start": 14.48,
   "end": 16.38,
   "text": "הוא היה עושה את עצמו אלוקה."
  },
  {
   "start": 18.62,
   "end": 22.3,
   "text": "כאילו הוא הבן של הקדוש ברוך הוא מיוחד שנולד בצורה מיוחדת,"
  },
  {
   "start": 22.94,
   "end": 24.4,
   "text": "והוא ממש, יש לו כוח עליון."
  },
  {
   "start": 25.36,
   "end": 30.9,
   "text": "ואנשים שרצו להאמין בכול כדי לאפשר למעשות מה שהם רוצים, האמינו בזה."
  },
  {
   "start": 32.36,
   "end": 33.58,
   "text": "והוא שומע לו על אברהם,"
  },
  {
   "start": 33.58,
   "end": 38.0,
   "text": "שמקרב נשמות לאבא שבשמיים."
  },
  {
   "start": 39.7,
   "end": 45.14,
   "text": "אז הוא מזמין את אברהם ואת אחיו הרן למפגש ראשון מסוגו,"
  },
  {
   "start": 46.38,
   "end": 50.4,
   "text": "למאבק על האמת בפומבה לפני כולם."
  },
  {
   "start": 53.34,
   "end": 56.94,
   "text": "מאבק ראשון בעולם על האמת,"
  },
  {
   "start": 57.58,
   "end": 58.78,
   "text": "על כבוד שמיים."
  },
  {
   "start": 60.08,
   "end": 60.84,
   "text": "ואברהם,"
  },
  {
   "start": 61.5,
   "end": 64.12,
   "text": "הוא מתחזק באמונה, בדבקות בשם יתברך,"
  },
  {
   "start": 64.96,
   "end": 68.82,
   "text": "והוא עושה את הצעדים הראשונים שלו אל מול נמרוד."
  },
  {
   "start": 70.5,
   "end": 71.34,
   "text": "הרם קצת מאחורה."
  },
  {
   "start": 72.96,
   "end": 74.62,
   "text": "קם נמרוד ואומר לאברהם,"
  },
  {
   "start": 75.58,
   "end": 78.84,
   "text": "אתה רואה פה את כבשן האש הגדול הזה?"
  },
  {
   "start": 79.72,
   "end": 80.88,
   "text": "האש זה כוח עליון."
  },
  {
   "start": 81.5,
   "end": 82.7,
   "text": "תשתחווה לאש."
  },
  {
   "start": 83.36,
   "end": 84.66,
   "text": "תראה שאתה עובד את האש."
  },
  {
   "start": 86.68,
   "end": 89.88,
   "text": "אברהם פונה לנמרוד ואומר לו, אומרים עליך שאתה מלך חכם,"
  },
  {
   "start": 90.38,
   "end": 93.64,
   "text": "אז למה לא תגיד נשתחווה למים? הרי המים מכבים את האש!"
  },
  {
   "start": 94.04,
   "end": 97.42,
   "text": "המים מכבים את האש, אולי אשתחווה למים?"
  },
  {
   "start": 99.34,
   "end": 106.16,
   "text": "ונמרוד רוצה ניצחון פסיכולוגי. הוא יודע, ברגע שהוא ישכנע את אברהם להשתחוות למשהו, להיכנע למשהו,"
  },
  {
   "start": 107.14,
   "end": 108.42,
   "text": "הוא ירחיק אותו מהשם יתברך,"
  },
  {
   "start": 109.12,
   "end": 110.6,
   "text": "הוא יהפוך אותו לעובד אלידים כמוהו."
  },
  {
   "start": 112.93,
   "end": 116.17,
   "text": "אז הוא אומר לו, טוב, אתה צודק, למים."
  },
  {
   "start": 116.57,
   "end": 117.51,
   "text": "תנו את אשתחווה למים."
  },
  {
   "start": 119.87,
   "end": 122.61,
   "text": "ואברהם ממשיך ואומרים לו, נמרוד, נמרוד,"
  },
  {
   "start": 123.47,
   "end": 124.47,
   "text": "אם כבר למים,"
  },
  {
   "start": 124.47,
   "end": 127.91,
   "text": "הרי מי מוריד את המים? העננים."
  },
  {
   "start": 128.37,
   "end": 129.77,
   "text": "מי מוריד גשם? העננים."
  },
  {
   "start": 130.37,
   "end": 131.83,
   "text": "אז אני צריך להשתחוות לעננים."
  },
  {
   "start": 134.5,
   "end": 136.24,
   "text": "ונמרוד מתחיל לנוע באי נוחות בכיסאו."
  },
  {
   "start": 139.9,
   "end": 139.98,
   "text": "טוב,"
  },
  {
   "start": 141.0,
   "end": 142.1,
   "text": "אז לעננים."
  },
  {
   "start": 142.64,
   "end": 143.66,
   "text": "תשתחווה לעננים."
  },
  {
   "start": 144.84,
   "end": 147.26,
   "text": "אז אם לעננים אז לרוח שמפזר את העננים."
  },
  {
   "start": 148.66,
   "end": 149.72,
   "text": "נמרוד כבר סוען."
  },
  {
   "start": 151.56,
   "end": 152.12,
   "text": "אומר לו, תראה,"
  },
  {
   "start": 155.92,
   "end": 157.72,
   "text": "אם כל הזמן אתה טוען את הטענות האלה,"
  },
  {
   "start": 158.3,
   "end": 159.5,
   "text": "בוא נבדוק את האמונה שלך."
  },
  {
   "start": 160.38,
   "end": 162.0,
   "text": "בוא נבדוק את האלוקים שלך."
  },
  {
   "start": 162.58,
   "end": 164.12,
   "text": "אני אזרוק אותך לאש,"
  },
  {
   "start": 164.98,
   "end": 167.76,
   "text": "ונראה אם הקדוש ברוך הוא שלך יציל אותך."
  },
  {
   "start": 170.12,
   "end": 172.8,
   "text": "ואברהם עומד מול המוות."
  },
  {
   "start": 174.76,
   "end": 177.16,
   "text": "מאחור שם ניצב הרן, אחיו,"
  },
  {
   "start": 178.0,
   "end": 179.3,
   "text": "והרן עושה חשבון."
  },
  {
   "start": 179.98,
   "end": 182.36,
   "text": "אם אברהם מנצח, אני איתו,"
  },
  {
   "start": 183.12,
   "end": 185.2,
   "text": "ואם נמרוד מנצח, אני איתו."
  },
  {
   "start": 185.62,
   "end": 186.14,
   "text": "אני אשתוק."
  },
  {
   "start": 188.02,
   "end": 188.48,
   "text": "אני אהיה פרווה."
  },
  {
   "start": 189.38,
   "end": 189.86,
   "text": "אני אהיה באמצע."
  },
  {
   "start": 191.36,
   "end": 194.26,
   "text": "לא זה ולא זה. עם מי שינצח אני אהיה איתו."
  },
  {
   "start": 194.82,
   "end": 196.4,
   "text": "אני רוצה לבדוק עם מי האמת."
  },
  {
   "start": 198.28,
   "end": 199.34,
   "text": "למה להסתבך סתם?"
  },
  {
   "start": 200.98,
   "end": 203.14,
   "text": "והרן יושב בשקט מאחורה."
  },
  {
   "start": 204.34,
   "end": 206.66,
   "text": "אברהם עומד מול כבשן האש."
  },
  {
   "start": 208.66,
   "end": 212.1,
   "text": "מבין שאם אני רוצה לעשות משהו לכבוד השם,"
  },
  {
   "start": 212.56,
   "end": 214.92,
   "text": "בור העולם רוצה ממני ללכת איתו עד הסוף."
  },
  {
   "start": 215.62,
   "end": 216.36,
   "text": "לכבוד השם."
  },
  {
   "start": 216.9,
   "end": 217.76,
   "text": "בלי חשבונות."
  },
  {
   "start": 218.56,
   "end": 219.66,
   "text": "בלי בלבולים."
  },
  {
   "start": 219.94,
   "end": 220.66,
   "text": "בלי כלום."
  },
  {
   "start": 225.32,
   "end": 227.12,
   "text": "והוא מובל אל כבשן האש."
  },
  {
   "start": 230.52,
   "end": 231.2,
   "text": "ועוד צעד,"
  },
  {
   "start": 233.49,
   "end": 235.37,
   "text": "מוטב סבל עם הקדוש ברוך הוא,"
  },
  {
   "start": 235.85,
   "end": 237.69,
   "text": "מאשר חיים ללא הקדוש ברוך הוא."
  },
  {
   "start": 242.87,
   "end": 250.54,
   "text": "ואז הוא מושלך אל כבשן האש,"
  },
  {
   "start": 253.26,
   "end": 254.9,
   "text": "וכולם מצפים שתוך שניות"
  },
  {
   "start": 255.86,
   "end": 256.5,
   "text": "הוא יהפך"
  },
  {
   "start": 257.76,
   "end": 259.26,
   "text": "למעכונת של אש."
  },
  {
   "start": 260.86,
   "end": 269.37,
   "text": "גוש בשר חרוך, אבל אז קורא הבלתי יאמן."
  },
  {
   "start": 274.36,
   "end": 275.92,
   "text": "מבעד ללהבות,"
  },
  {
   "start": 276.56,
   "end": 277.06,
   "text": "אתם רואים,"
  },
  {
   "start": 277.06,
   "end": 279.52,
   "text": "גוף נע,"
  },
  {
   "start": 280.44,
   "end": 281.28,
   "text": "גוף זז,"
  },
  {
   "start": 288.1,
   "end": 291.92,
   "text": "נס מתרחש לעיניהם."
  },
  {
   "start": 301.07,
   "end": 308.21,
   "text": "האש לא נוקעת באברהם כאילו כוח אדיר,"
  },
  {
   "start": 309.19,
   "end": 312.49,
   "text": "בלתי נראה, עוצר בעדה,"
  },
  {
   "start": 313.29,
   "end": 315.11,
   "text": "מונע ממנה להזיק."
  },
  {
   "start": 316.57,
   "end": 320.01,
   "text": "ואברהם מסתובב בתוך כבשן האש,"
  },
  {
   "start": 320.79,
   "end": 327.53,
   "text": "קולו האחוז בדבקות מופלאה ממי שאמר והיה עולם באבא שבשמיים."
  },
  {
   "start": 328.81,
   "end": 336.8,
   "text": "מסתובב בתוך כבשן האש כאילו זה חצר ביתו מסביב."
  },
  {
   "start": 338.02,
   "end": 338.96,
   "text": "הלם."
  },
  {
   "start": 339.7,
   "end": 340.26,
   "text": "הם לא מאמינים."
  },
  {
   "start": 350.54,
   "end": 351.58,
   "text": "הם לוקחים את הרן,"
  },
  {
   "start": 352.24,
   "end": 353.0,
   "text": "את אח של אברהם."
  },
  {
   "start": 353.96,
   "end": 354.7,
   "text": "הם החליטו לבדוק."
  },
  {
   "start": 356.42,
   "end": 356.62,
   "text": "האם"
  },
  {
   "start": 357.7,
   "end": 359.98,
   "text": "יש משהו באש שלא פוגע בשום דבר?"
  },
  {
   "start": 360.96,
   "end": 362.0,
   "text": "הם לוקחים את ארן לבדוק,"
  },
  {
   "start": 363.08,
   "end": 365.64,
   "text": "הם תופסים אותו, ולפני שהוא מצליח לדבר משהו,"
  },
  {
   "start": 366.04,
   "end": 367.56,
   "text": "הוא רוצה להגיד עם מי הוא."
  },
  {
   "start": 367.98,
   "end": 371.38,
   "text": "הרי אם אברהם מנצח אני איתו, ואם נמרוד מנצח אני איתו רגע."
  },
  {
   "start": 372.8,
   "end": 374.46,
   "text": "הם לוקחים אותו אל כבשן האש,"
  },
  {
   "start": 375.28,
   "end": 376.44,
   "text": "והארן הולך רגוע,"
  },
  {
   "start": 378.0,
   "end": 378.56,
   "text": "כי הוא יודע,"
  },
  {
   "start": 379.08,
   "end": 383.3,
   "text": "כמו שהאחי ניצל, כמו שהאחי מנצח, גם אני."
  },
  {
   "start": 384.16,
   "end": 385.02,
   "text": "אני הרי לא כפרתי,"
  },
  {
   "start": 385.94,
   "end": 388.12,
   "text": "אני אמרתי, אני רוצה לדעת האמת."
  },
  {
   "start": 388.34,
   "end": 390.92,
   "text": "אם אברהם צודק, אני איתו, אני עם האמת."
  },
  {
   "start": 391.48,
   "end": 393.38,
   "text": "ואם אברהם טועה ונמרוד מנצח,"
  },
  {
   "start": 395.22,
   "end": 396.78,
   "text": "אני עם נמרוד, אני רוצה את האמת."
  },
  {
   "start": 397.64,
   "end": 398.18,
   "text": "אז הוא הולך בכזה,"
  },
  {
   "start": 400.54,
   "end": 401.4,
   "text": "מורה מגאווה,"
  },
  {
   "start": 404.08,
   "end": 404.8,
   "text": "ונכנס,"
  },
  {
   "start": 405.58,
   "end": 406.96,
   "text": "נזרק לו אל תוך האש."
  },
  {
   "start": 410.3,
   "end": 410.84,
   "text": "שניות,"
  },
  {
   "start": 411.92,
   "end": 413.48,
   "text": "הוא נשרף כליל למוות."
  },
  {
   "start": 419.7,
   "end": 419.98,
   "text": "למה?"
  },
  {
   "start": 421.04,
   "end": 422.52,
   "text": "למה אברהם ניצל?"
  },
  {
   "start": 424.0,
   "end": 424.82,
   "text": "זה מובן,"
  },
  {
   "start": 425.44,
   "end": 427.36,
   "text": "אבל למה הרן נשרף?"
  },
  {
   "start": 431.08,
   "end": 433.24,
   "text": "באה התורה הקדושה ללמד אותנו."
  },
  {
   "start": 433.78,
   "end": 436.5,
   "text": "בא בורא העולם ללמד אותנו יסוד גדול."
  },
  {
   "start": 437.18,
   "end": 439.44,
   "text": "יהדות זה לא ספורט."
  },
  {
   "start": 440.22,
   "end": 442.96,
   "text": "אמונה זה לא ספורט."
  },
  {
   "start": 443.48,
   "end": 444.54,
   "text": "הערכו לא יכול לעשות."
  },
  {
   "start": 444.84,
   "end": 448.52,
   "text": "אם זה מנצח אני איתו, ואם זה מנצח אני איתו."
  },
  {
   "start": 449.02,
   "end": 450.22,
   "text": "אין משחקים."
  },
  {
   "start": 450.82,
   "end": 452.76,
   "text": "יהדות, הולכים איתה עד הסוף."
  },
  {
   "start": 453.36,
   "end": 455.44,
   "text": "עם בורא עולם, הולכים עד הסוף."
  },
  {
   "start": 457.02,
   "end": 459.02,
   "text": "נראה לך, לא נראה לך."
  },
  {
   "start": 459.36,
   "end": 460.6,
   "text": "אתה, נראה לך שאתה מפסיד."
  },
  {
   "start": 461.08,
   "end": 464.98,
   "text": "כנראה שאתה מנצח, אתה עם הקדוש ברוך הוא בלי חוכמות,"
  },
  {
   "start": 465.5,
   "end": 466.0,
   "text": "בתמימות,"
  },
  {
   "start": 466.48,
   "end": 467.32,
   "text": "בפשיטות."
  },
  {
   "start": 467.76,
   "end": 470.94,
   "text": "ככה אברהם נכנס לכבשן האש ויוצא מכבשן האש."
  },
  {
   "start": 471.4,
   "end": 475.24,
   "text": "והרן, שמנסה להיות משהו, משהו באמצע, לרקוד על שתי החתונות,"
  },
  {
   "start": 476.44,
   "end": 479.96,
   "text": "רוקד לו למוות בכבשן האש."
  },
  {
   "start": 480.96,
   "end": 484.62,
   "text": "אבל מהקדוש ברוך הוא לא נעלם שכר שום ברייה וברייה."
  },
  {
   "start": 485.26,
   "end": 486.6,
   "text": "בכל אופן, הרן, אתה נכנסת"
  },
  {
   "start": 487.2,
   "end": 489.7,
   "text": "עם הבנה שאתה קצת מוסר נפש לכבוד השם,"
  },
  {
   "start": 490.28,
   "end": 491.64,
   "text": "אז תקבל שכר על זה."
  },
  {
   "start": 492.02,
   "end": 495.16,
   "text": "להרן הרי היו שלושה ילדים."
  },
  {
   "start": 496.16,
   "end": 497.0,
   "text": "אחת זו שרה,"
  },
  {
   "start": 497.66,
   "end": 498.32,
   "text": "שרה אימנו."
  },
  {
   "start": 499.78,
   "end": 501.14,
   "text": "השנייה זאת מילכה."
  },
  {
   "start": 501.88,
   "end": 504.02,
   "text": "מילכה הייתה סבתא של רבקה אימנו."
  },
  {
   "start": 505.16,
   "end": 506.3,
   "text": "והיה לו בן שקראו לו לוט."
  },
  {
   "start": 507.12,
   "end": 507.46,
   "text": "מלוט."
  },
  {
   "start": 508.58,
   "end": 512.02,
   "text": "הוא זכה לשתי ילדות."
  },
  {
   "start": 513.24,
   "end": 517.4,
   "text": "אחת נעמה העמונית ואחת רות המואביה."
  },
  {
   "start": 518.98,
   "end": 520.24,
   "text": "הסבתא הגדולה של דוד."
  },
  {
   "start": 521.64,
   "end": 522.56,
   "text": "של מלך המשיח."
  },
  {
   "start": 530.46,
   "end": 532.2,
   "text": "בא אברהם אבינו וזועק לנו."
  },
  {
   "start": 532.88,
   "end": 537.56,
   "text": "בניי האיכרים, אם הקדוש ברוך הוא צריך ללכת עד הסוף,"
  },
  {
   "start": 538.66,
   "end": 540.08,
   "text": "באש ובמים,"
  },
  {
   "start": 540.72,
   "end": 541.26,
   "text": "לא לוותר."
  },
  {
   "start": 541.72,
   "end": 544.22,
   "text": "במיוחד בדור חשוך כמו שלנו."
  },
  {
   "start": 544.8,
   "end": 546.54,
   "text": "ללכת, לא לוותר."
  },
  {
   "start": 547.58,
   "end": 551.04,
   "text": "באה שרה אימנו ואומרת, תראו כמה אני הולכת עם אברהם אבינו."
  },
  {
   "start": 551.56,
   "end": 559.14,
   "text": "מה אנחנו מקבלים ממקום זה? להיות בכבשן האש, ניסיונות, אין ילדים, קשיים. אני הולכת עם הקדוש ברוך הוא,"
  },
  {
   "start": 559.48,
   "end": 563.2,
   "text": "שכל העולם יהיה מצד אחד, כאילו יצליח, ואני בצד השני,"
  },
  {
   "start": 563.62,
   "end": 565.94,
   "text": "אבל אם הקדוש ברוך הוא, אז יש לי את הכול."
  }
 ]
}