{
 "disc": "31ר- בת של מלך",
 "track": "Track05",
 "duration": 453.168,
 "segments": [
  {
   "start": 9.79,
   "end": 10.93,
   "text": "אומר ספר הספרים,"
  },
  {
   "start": 12.41,
   "end": 13.81,
   "text": "הגיד לך אדם מה טוב,"
  },
  {
   "start": 15.29,
   "end": 16.69,
   "text": "מה השם דורש ממך,"
  },
  {
   "start": 18.07,
   "end": 19.39,
   "text": "כי אם עשות משפט"
  },
  {
   "start": 20.19,
   "end": 21.31,
   "text": "ואהבת חסד,"
  },
  {
   "start": 22.45,
   "end": 23.51,
   "text": "והצנע לכת"
  },
  {
   "start": 24.43,
   "end": 25.09,
   "text": "עם אלוקיך."
  },
  {
   "start": 28.63,
   "end": 29.47,
   "text": "בספר מיכה,"
  },
  {
   "start": 30.79,
   "end": 31.71,
   "text": "בא הנביא מיכה,"
  },
  {
   "start": 32.39,
   "end": 35.65,
   "text": "ומלמד לנו מה הקדוש ברוך הוא דורש מאיתנו."
  },
  {
   "start": 37.47,
   "end": 38.27,
   "text": "עשות משפט,"
  },
  {
   "start": 39.13,
   "end": 42.39,
   "text": "אהבת חסד והצניע ולכת."
  },
  {
   "start": 44.19,
   "end": 45.41,
   "text": "אומר הגאון מווילנה"
  },
  {
   "start": 46.57,
   "end": 51.01,
   "text": "אומר הגאון מווילנה, צריך לדעת, מה שלגברים זו תורה,"
  },
  {
   "start": 52.61,
   "end": 53.93,
   "text": "לנשים זו צניעות."
  },
  {
   "start": 56.93,
   "end": 59.15,
   "text": "צריך לדעת חובה על הגברים,"
  },
  {
   "start": 59.45,
   "end": 61.71,
   "text": "זכות שהיא חובה וחובה שהיא זכות ללמוד תורה."
  },
  {
   "start": 64.84,
   "end": 67.04,
   "text": "כל גבר יישאל בבית דין של מעלה."
  },
  {
   "start": 68.2,
   "end": 70.26,
   "text": "האם קבעת עיתים לתורה?"
  },
  {
   "start": 70.76,
   "end": 73.64,
   "text": "האם אין לך זמן קבוע שלמדת בו תורה?"
  },
  {
   "start": 77.68,
   "end": 78.3,
   "text": "לא רק זה,"
  },
  {
   "start": 79.26,
   "end": 83.0,
   "text": "אלא שכל מי שלומד תורה מתקדש."
  },
  {
   "start": 83.76,
   "end": 87.04,
   "text": "משפיע עליו הקדוש ברוך הוא שפע רוחני מיוחד, אור מיוחד."
  },
  {
   "start": 89.37,
   "end": 91.69,
   "text": "ומה שפועל את התורה לגברים,"
  },
  {
   "start": 92.17,
   "end": 95.15,
   "text": "את כל השפע שמעניקה התורה לגברים,"
  },
  {
   "start": 96.49,
   "end": 98.61,
   "text": "את זו עושה הצניעות לנשים."
  },
  {
   "start": 100.27,
   "end": 102.65,
   "text": "את כל העולמות שהגברים מקבלים על התורה,"
  },
  {
   "start": 102.65,
   "end": 107.13,
   "text": "שגם בזה יש חלק לנשים שותפות, זה ודאי."
  },
  {
   "start": 107.95,
   "end": 109.09,
   "text": "אבל בלי קשר לזה,"
  },
  {
   "start": 112.46,
   "end": 116.56,
   "text": "הנשים מקבלות עולמות שלמים, נפלאים, נחלות."
  },
  {
   "start": 117.7,
   "end": 122.58,
   "text": "וככה צריך להבין שיצר רע כמו שהוא נלחם עם הגבר על לימוד התורה,"
  },
  {
   "start": 123.12,
   "end": 125.28,
   "text": "ככה הוא נלחם עם האישה על הצניעות."
  },
  {
   "start": 126.38,
   "end": 128.38,
   "text": "ותראו כמה מלחמות יש על זה."
  },
  {
   "start": 128.68,
   "end": 133.92,
   "text": "למה? כי היצר רע נלחם כמו שהוא מנסה למנוע מהגבר לימוד תורה,"
  },
  {
   "start": 134.4,
   "end": 138.02,
   "text": "כך הוא מנסה למנוע מהאישה לשמור צניעות."
  },
  {
   "start": 142.48,
   "end": 145.34,
   "text": "צריך לדעת שהצניעות מולידה ילדים טהוריים."
  },
  {
   "start": 148.22,
   "end": 153.0,
   "text": "מדברים על שלום בית, כמה הרצאות, כמה שיחות השלום בית, כמה טיפולי שלום בית."
  },
  {
   "start": 153.32,
   "end": 155.84,
   "text": "אתם יודעים כמה צניעות יכולה לחסוך את זה?"
  },
  {
   "start": 157.42,
   "end": 160.74,
   "text": "אתם יודעים כמה צניעות יכולה להכניס שלווה וארוגה לבית?"
  },
  {
   "start": 161.48,
   "end": 162.6,
   "text": "אווירה אחרת לבית?"
  },
  {
   "start": 167.12,
   "end": 170.88,
   "text": "היה יהודי אחד קדוש, אחד מגדולי ישראל, החתם סופר."
  },
  {
   "start": 171.96,
   "end": 172.58,
   "text": "הייתה לו בת,"
  },
  {
   "start": 173.62,
   "end": 175.56,
   "text": "לבת שלה חתם סופר קראו גיטל."
  },
  {
   "start": 176.84,
   "end": 177.9,
   "text": "והיא הייתה יפה,"
  },
  {
   "start": 179.04,
   "end": 180.24,
   "text": "היה לה יופי מיוחד."
  },
  {
   "start": 183.54,
   "end": 185.54,
   "text": "וכשהיא הייתה יוצאת לרחוב,"
  },
  {
   "start": 186.56,
   "end": 187.34,
   "text": "היא שמה לב"
  },
  {
   "start": 188.14,
   "end": 191.74,
   "text": "שהיו גברים שלא מסוגלים שלא להסתכל עליה."
  },
  {
   "start": 193.14,
   "end": 197.7,
   "text": "אז היא עשתה את כל המאמצים, אותו בת סדקת, אותה בת סדקת, ניסתה להצניע את עצמה."
  },
  {
   "start": 200.2,
   "end": 202.88,
   "text": "כדי שלא יסתכלו, יבינה מה זה עושה לא טוב."
  },
  {
   "start": 202.88,
   "end": 209.2,
   "text": "וכמה שהיא הייתה צנועה, בכל אופן היופי שלה גרם לאנשים להסתכל."
  },
  {
   "start": 211.48,
   "end": 214.08,
   "text": "יום אחד היא פרצה בבכי לשם מתברך בורא עולם."
  },
  {
   "start": 215.18,
   "end": 216.98,
   "text": "למה עשית אותי כל כך יפה?"
  },
  {
   "start": 217.84,
   "end": 220.48,
   "text": "וכל כך הרבה אנשים מסתכלים למה, למה?"
  },
  {
   "start": 221.56,
   "end": 222.8,
   "text": "תראו פלאי פלאות."
  },
  {
   "start": 224.06,
   "end": 224.78,
   "text": "על מה היא בוכה?"
  },
  {
   "start": 226.14,
   "end": 229.26,
   "text": "כמה נשים רוצות להיות יפות, היא לא, אני רוצה למה?"
  },
  {
   "start": 230.68,
   "end": 233.8,
   "text": "אני רוצה שאני אהיה יפה בעיני בעלי, לא בעיני כל העולם."
  },
  {
   "start": 235.08,
   "end": 237.78,
   "text": "כל כבודה של בת מלך פנימה, אני משתדלת."
  },
  {
   "start": 238.44,
   "end": 239.66,
   "text": "למה אני כל כך יפה?"
  },
  {
   "start": 240.96,
   "end": 242.04,
   "text": "עבר החתן סופר,"
  },
  {
   "start": 242.88,
   "end": 243.84,
   "text": "האבא הגדול שלה."
  },
  {
   "start": 244.62,
   "end": 248.1,
   "text": "ראה את בתו בוכה, אמר לה, בתי, למה את בוכה? הוא מכיר את הבת שלו."
  },
  {
   "start": 248.56,
   "end": 249.74,
   "text": "הוא ידע שהיא לא בוכה סתם."
  },
  {
   "start": 250.4,
   "end": 252.0,
   "text": "אומר לה, למה את בוכה? מה קרה?"
  },
  {
   "start": 253.34,
   "end": 254.92,
   "text": "מה הכאב? היא הסבירה לו."
  },
  {
   "start": 255.74,
   "end": 257.46,
   "text": "היא אמרה לו, תראה, אבא,"
  },
  {
   "start": 257.84,
   "end": 262.94,
   "text": "אני לא מרוצה מזה שאני יוצאת ומסתכלים בגלל היופי שלי, כל כך כואב, ואני פונה לשם, למה?"
  },
  {
   "start": 265.02,
   "end": 266.38,
   "text": "אמר לה החתם סופר."
  },
  {
   "start": 267.08,
   "end": 272.8,
   "text": "אמר לה האבא הגדול, תגידי לי, בתי, אם תבכי, יפסיקו להסתכל? מה הדרוכה, אם תבכי, יפסיקו להסתכל?"
  },
  {
   "start": 274.94,
   "end": 277.76,
   "text": "אמרה, לא, אבל אולי בורא עולם ישמע את התפילות שלי,"
  },
  {
   "start": 278.42,
   "end": 279.48,
   "text": "ויקח קצת מה היופי שלי."
  },
  {
   "start": 280.24,
   "end": 281.32,
   "text": "אמר החתם סופר,"
  },
  {
   "start": 282.94,
   "end": 283.44,
   "text": "אם זה ככה,"
  },
  {
   "start": 284.82,
   "end": 285.14,
   "text": "בתי,"
  },
  {
   "start": 285.82,
   "end": 288.38,
   "text": "יהי רצון שהקדוש ברוך הוא ייקח לך את היופי החיצוני הזה,"
  },
  {
   "start": 289.32,
   "end": 290.92,
   "text": "אבל יעניק לך יופי פנימי,"
  },
  {
   "start": 291.96,
   "end": 294.0,
   "text": "ותזכי לבן כזה גדול,"
  },
  {
   "start": 294.5,
   "end": 296.14,
   "text": "שיאיר את כל העולם היהודי."
  },
  {
   "start": 298.65,
   "end": 299.33,
   "text": "אתם יודעים מה שקרה?"
  },
  {
   "start": 300.69,
   "end": 302.97,
   "text": "זמן מה אחרי זה היא חלתה במחלה קשה,"
  },
  {
   "start": 303.43,
   "end": 305.25,
   "text": "וכשהיא התאוששה מהמחלה,"
  },
  {
   "start": 305.79,
   "end": 307.29,
   "text": "כבר היופי שלה נעלם."
  },
  {
   "start": 308.91,
   "end": 310.17,
   "text": "אבל היא זכתה ליופי רוחני."
  },
  {
   "start": 311.11,
   "end": 312.61,
   "text": "היא הקימה בית יהודי נפלא,"
  },
  {
   "start": 313.17,
   "end": 314.09,
   "text": "בית של שלום בית,"
  },
  {
   "start": 314.61,
   "end": 315.39,
   "text": "בית של אהבה,"
  },
  {
   "start": 315.85,
   "end": 316.51,
   "text": "בית של טהרה,"
  },
  {
   "start": 317.11,
   "end": 317.83,
   "text": "בית של קדושה."
  },
  {
   "start": 318.95,
   "end": 320.99,
   "text": "ונולד להם בן קדוש וטהור,"
  },
  {
   "start": 322.05,
   "end": 323.05,
   "text": "שלימים גדל,"
  },
  {
   "start": 323.71,
   "end": 325.43,
   "text": "ונהיה רבי עקיבא קורניצר,"
  },
  {
   "start": 325.97,
   "end": 329.99,
   "text": "זכר צדיק לברכה, אחד מצדיקי וגדולי ישראל."
  },
  {
   "start": 331.25,
   "end": 332.61,
   "text": "איך היא זכתה לזה?"
  },
  {
   "start": 334.58,
   "end": 336.8,
   "text": "זו הקדושה שאישה מכניסה הביתה."
  },
  {
   "start": 339.97,
   "end": 341.73,
   "text": "אישה חייבת לדעת את המעלה שלה."
  },
  {
   "start": 342.47,
   "end": 349.15,
   "text": "אתם יודעים, לפני איזה כמה זמן הייתה איזה בחורה פה בארץ,"
  },
  {
   "start": 349.93,
   "end": 350.55,
   "text": "הכירה גוי,"
  },
  {
   "start": 351.17,
   "end": 352.01,
   "text": "והם רצו להתחתן."
  },
  {
   "start": 353.53,
   "end": 355.79,
   "text": "אבל היה בעיה, כי ההורים שלה אמרו לה, אל תגזימי,"
  },
  {
   "start": 356.81,
   "end": 357.51,
   "text": "לפחות שיתגייר."
  },
  {
   "start": 357.97,
   "end": 360.99,
   "text": "אז היא פנתה אליו ואמרה לו, תשמע, ההורים שלי עושים בעיות, בוא תתגייר."
  },
  {
   "start": 362.63,
   "end": 364.77,
   "text": "אותו גוי אמר, טוב, לא אכפת לי, בוא נעשה, מה אני אעשה?"
  },
  {
   "start": 365.09,
   "end": 365.79,
   "text": "הוא רצה להתחתן איתה."
  },
  {
   "start": 366.67,
   "end": 368.41,
   "text": "הלך והתחיל, פתח בהליכי גיור."
  },
  {
   "start": 369.97,
   "end": 373.19,
   "text": "והוא שמע בגיור, בתהליכי הגיור, הוא למד יהדות."
  },
  {
   "start": 374.01,
   "end": 375.69,
   "text": "הוא נחשף לעולם היהדות."
  },
  {
   "start": 377.11,
   "end": 379.87,
   "text": "הוא בא ורצה בסוף באמת להיות יהודי כמו שצריך."
  },
  {
   "start": 380.65,
   "end": 381.61,
   "text": "למד גיור כהלכה."
  },
  {
   "start": 382.63,
   "end": 385.25,
   "text": "וגמר את כל תהליכי הגיור ונהיה גר צדק."
  },
  {
   "start": 386.61,
   "end": 388.45,
   "text": "ונהיה שומר תורה ומצוות."
  },
  {
   "start": 389.61,
   "end": 390.25,
   "text": "כמו שצריך."
  },
  {
   "start": 392.58,
   "end": 394.1,
   "text": "ואז היא באה ואומרת, בוא נתחתן."
  },
  {
   "start": 395.12,
   "end": 396.32,
   "text": "אמר לה אותו גר,"
  },
  {
   "start": 397.14,
   "end": 398.6,
   "text": "אותו חבר של הגוי לשעבר,"
  },
  {
   "start": 400.1,
   "end": 402.36,
   "text": "אמר לה, אני מסרב להתחתן איתך, לא רוצה אותך."
  },
  {
   "start": 403.58,
   "end": 406.3,
   "text": "אומרת לו, למה? מה קרה? הרי בשבילי הלכת והתגיירת, מה קרה?"
  },
  {
   "start": 407.5,
   "end": 408.24,
   "text": "אמר לה, את לא מבינה."
  },
  {
   "start": 410.0,
   "end": 410.5,
   "text": "עכשיו,"
  },
  {
   "start": 411.18,
   "end": 413.04,
   "text": "עכשיו שאני יודע מה זו יהדות,"
  },
  {
   "start": 413.86,
   "end": 415.64,
   "text": "עכשיו שאני יודע מה זה יהודי,"
  },
  {
   "start": 416.1,
   "end": 419.76,
   "text": "עכשיו שאני יודע מה זו יהודייה, מה זו בת ישראל,"
  },
  {
   "start": 419.76,
   "end": 425.08,
   "text": "אני לא מבין איך את יכלת ללכת עם גוי."
  },
  {
   "start": 426.26,
   "end": 432.04,
   "text": "אם את יכלת ללכת עם גוי ולממש את הפוטנציאל של בת ישראל הקדושה שבך,"
  },
  {
   "start": 432.46,
   "end": 432.98,
   "text": "לא רוצה אותך,"
  },
  {
   "start": 433.4,
   "end": 435.04,
   "text": "אני רוצה בת ישראל כמו שצריך."
  },
  {
   "start": 436.34,
   "end": 438.92,
   "text": "והוא עזב אותה, הוא עזב אותה, מקרה שהיה פה בארץ."
  },
  {
   "start": 439.76,
   "end": 440.38,
   "text": "והתחתן"
  },
  {
   "start": 441.52,
   "end": 443.22,
   "text": "עם אישה שומרת תורה ומצוות."
  },
  {
   "start": 445.88,
   "end": 450.18,
   "text": "אפילו הגוי מבין מה זו בת ישראל."
  }
 ]
}