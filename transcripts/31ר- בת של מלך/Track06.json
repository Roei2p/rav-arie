{
 "disc": "31ר- בת של מלך",
 "track": "Track06",
 "duration": 1319.16,
 "segments": [
  {
   "start": 4.77,
   "end": 5.47,
   "text": "בעזרת השם,"
  },
  {
   "start": 6.61,
   "end": 8.39,
   "text": "אנחנו נחשוף בפניכם סוד נפלא."
  },
  {
   "start": 10.17,
   "end": 10.87,
   "text": "סוד שקשור אליך,"
  },
  {
   "start": 12.45,
   "end": 13.31,
   "text": "אלייך, אל כולנו."
  },
  {
   "start": 14.55,
   "end": 16.39,
   "text": "אל כל עם ישראל הנפלא שלנו,"
  },
  {
   "start": 17.01,
   "end": 18.55,
   "text": "ללא יוצא מן הכלל."
  },
  {
   "start": 20.59,
   "end": 21.97,
   "text": "אבל לשם כך בואו נניע,"
  },
  {
   "start": 22.65,
   "end": 24.55,
   "text": "בואו נסובב את גלגלי הזמן אחורה,"
  },
  {
   "start": 25.23,
   "end": 26.53,
   "text": "בואו נצא למסע יהודי,"
  },
  {
   "start": 28.11,
   "end": 29.29,
   "text": "או יותר נכון, מסע"
  },
  {
   "start": 30.55,
   "end": 31.59,
   "text": "אל הלב היהודי,"
  },
  {
   "start": 32.35,
   "end": 34.97,
   "text": "שלעולם לא הפסיק לפעום."
  },
  {
   "start": 38.18,
   "end": 39.94,
   "text": "שנת 1939, בלגיה,"
  },
  {
   "start": 45.25,
   "end": 57.22,
   "text": "אנטוורפן, תדהמה אוחזת בכל רחבי הקמפוסים באוניברסיטה בבלגיה."
  },
  {
   "start": 61.13,
   "end": 64.33,
   "text": "שנערה תוותר על לימודי רפואה,"
  },
  {
   "start": 65.15,
   "end": 66.43,
   "text": "היא כבר עברה את המסלול,"
  },
  {
   "start": 67.13,
   "end": 68.41,
   "text": "היא כבר עברה את המבחנים,"
  },
  {
   "start": 68.97,
   "end": 73.21,
   "text": "היא כבר התקבלה לפקולטה לרפואה, והיא תוותר על הלימודים?"
  },
  {
   "start": 74.43,
   "end": 74.99,
   "text": "ולמה?"
  },
  {
   "start": 75.73,
   "end": 76.55,
   "text": "כי הלימודים"
  },
  {
   "start": 77.49,
   "end": 78.63,
   "text": "באוניברסיטה בבלגיה,"
  },
  {
   "start": 80.29,
   "end": 81.55,
   "text": "התבצעו גם בשבת."
  },
  {
   "start": 84.17,
   "end": 89.31,
   "text": "אז נערה בשם מלה פשוט בוחרת לה ברצון השם,"
  },
  {
   "start": 90.01,
   "end": 91.21,
   "text": "ומוותרת על קידום,"
  },
  {
   "start": 91.75,
   "end": 92.45,
   "text": "על קריירה,"
  },
  {
   "start": 93.95,
   "end": 98.15,
   "text": "על מקצוע שכל נערה בלגית"
  },
  {
   "start": 100.6,
   "end": 101.16,
   "text": "הייתה רוצה."
  },
  {
   "start": 104.7,
   "end": 105.48,
   "text": "מלה ויתרה על הכל."
  },
  {
   "start": 109.84,
   "end": 110.92,
   "text": "שלוש שנים אחר כך"
  },
  {
   "start": 111.9,
   "end": 113.66,
   "text": "החלה הפלישה הנאצית לבלגיה."
  },
  {
   "start": 116.82,
   "end": 117.76,
   "text": "המשפחה של מלה"
  },
  {
   "start": 119.36,
   "end": 119.96,
   "text": "הם מיועדים"
  },
  {
   "start": 121.72,
   "end": 123.0,
   "text": "להילקח על ידי הנאצים."
  },
  {
   "start": 125.0,
   "end": 126.44,
   "text": "ומלה רוצה להצטרף אליהם,"
  },
  {
   "start": 127.0,
   "end": 127.5,
   "text": "אבל אבא שלה,"
  },
  {
   "start": 128.3,
   "end": 129.84,
   "text": "בטון סמכותי, אומר לה לא, מלה."
  },
  {
   "start": 130.72,
   "end": 131.44,
   "text": "את יכולה להינצל."
  },
  {
   "start": 132.92,
   "end": 133.92,
   "text": "את יכולה להינצל."
  },
  {
   "start": 135.22,
   "end": 136.86,
   "text": "אותך לא ייזהו, לא ייזהו שאת יהודייה."
  },
  {
   "start": 138.24,
   "end": 138.66,
   "text": "מצאנו לך פתרון."
  },
  {
   "start": 140.0,
   "end": 140.16,
   "text": "את,"
  },
  {
   "start": 140.7,
   "end": 142.18,
   "text": "את, יש לך חוש למוזיקה."
  },
  {
   "start": 143.12,
   "end": 146.26,
   "text": "את תהיי מורה לזמרה אצל משפחה נוצרית בפרברי אנדוורפן."
  },
  {
   "start": 147.34,
   "end": 148.22,
   "text": "תהיי שמה בשקט."
  },
  {
   "start": 149.04,
   "end": 149.9,
   "text": "עד תום המלחמה."
  },
  {
   "start": 151.44,
   "end": 152.9,
   "text": "אנחנו לא יודעים מה יהיה איתנו, אבל את תנצלי."
  },
  {
   "start": 153.54,
   "end": 155.88,
   "text": "ומלה מאומרת, לא, אני רוצה להצטרף אליכם."
  },
  {
   "start": 156.4,
   "end": 157.58,
   "text": "אני לא מוכנה לנטוש אתכם."
  },
  {
   "start": 158.32,
   "end": 158.8,
   "text": "לא, מלה,"
  },
  {
   "start": 159.44,
   "end": 160.5,
   "text": "את חייבת להישאר."
  },
  {
   "start": 161.3,
   "end": 162.56,
   "text": "אני פוקד עלייך, אומר אבא."
  },
  {
   "start": 164.58,
   "end": 165.08,
   "text": "ומלה,"
  },
  {
   "start": 166.52,
   "end": 167.5,
   "text": "מלה שומעת לקול אבא,"
  },
  {
   "start": 169.9,
   "end": 170.48,
   "text": "ונשארת"
  },
  {
   "start": 171.28,
   "end": 174.1,
   "text": "מורה לזמרה בפרברי אנטוורפן."
  },
  {
   "start": 175.74,
   "end": 177.2,
   "text": "אבל הנשמה של מלה זועקת."
  },
  {
   "start": 177.76,
   "end": 179.64,
   "text": "היא רוצה יהדות."
  },
  {
   "start": 180.6,
   "end": 182.2,
   "text": "כל כך היה קשה לה שמה לשהות"
  },
  {
   "start": 182.78,
   "end": 184.1,
   "text": "בחיק המשפחה הנוצרית,"
  },
  {
   "start": 186.42,
   "end": 189.34,
   "text": "אז ככה מדי פעם היא הייתה נסגרת בחדר שנתנו לה."
  },
  {
   "start": 190.86,
   "end": 191.16,
   "text": "ושמה"
  },
  {
   "start": 192.26,
   "end": 193.18,
   "text": "היא הייתה מתפללת,"
  },
  {
   "start": 193.82,
   "end": 197.02,
   "text": "תהילים, לומדת קצת בספרים שהיא החביאה."
  },
  {
   "start": 199.15,
   "end": 200.33,
   "text": "ערב יום כיפור הגיעה,"
  },
  {
   "start": 201.05,
   "end": 202.11,
   "text": "ומלה לא יכלה להתאפק."
  },
  {
   "start": 202.69,
   "end": 203.57,
   "text": "היא נסגרה בחדר"
  },
  {
   "start": 204.49,
   "end": 206.19,
   "text": "והתחילה שמה בקול עצוב,"
  },
  {
   "start": 207.67,
   "end": 208.39,
   "text": "בקול כאוב."
  },
  {
   "start": 209.95,
   "end": 214.59,
   "text": "את ניגון כל נדרי שפותח את תפילות יום כיפורים."
  },
  {
   "start": 216.43,
   "end": 217.09,
   "text": "היא לא שמה לב"
  },
  {
   "start": 217.93,
   "end": 219.85,
   "text": "שמבעד לתריסי החלון"
  },
  {
   "start": 221.77,
   "end": 222.69,
   "text": "עמדה לה שם דמות,"
  },
  {
   "start": 224.96,
   "end": 226.0,
   "text": "דמות מבשרת רעות,"
  },
  {
   "start": 227.0,
   "end": 227.54,
   "text": "מלה נחשפה."
  },
  {
   "start": 229.12,
   "end": 231.86,
   "text": "זה היה מלשין שרץ ישר"
  },
  {
   "start": 232.88,
   "end": 234.1,
   "text": "אל מרתפי הגסטפו"
  },
  {
   "start": 234.74,
   "end": 237.2,
   "text": "לבשר על אותה יהודייה שמתחבאת לה"
  },
  {
   "start": 238.26,
   "end": 240.58,
   "text": "בפרברי אנדוורפן ומלה נתפסת."
  },
  {
   "start": 241.42,
   "end": 242.06,
   "text": "והיא מועברת,"
  },
  {
   "start": 242.9,
   "end": 243.92,
   "text": "לא פחות ולא יותר,"
  },
  {
   "start": 244.58,
   "end": 246.1,
   "text": "למחנה האיום והנורא,"
  },
  {
   "start": 247.08,
   "end": 247.82,
   "text": "אושוויץ."
  },
  {
   "start": 258.48,
   "end": 259.46,
   "text": "המסע לאושוויץ"
  },
  {
   "start": 260.18,
   "end": 261.38,
   "text": "היה ארוך ומייגע."
  },
  {
   "start": 262.78,
   "end": 264.4,
   "text": "לכל האנשים שם, לכל היהודים,"
  },
  {
   "start": 264.98,
   "end": 267.02,
   "text": "נמסר שזה מחנה עבודה בסך הכל."
  },
  {
   "start": 268.0,
   "end": 268.5,
   "text": "אבל מלה,"
  },
  {
   "start": 269.32,
   "end": 270.38,
   "text": "מלה הבינה."
  },
  {
   "start": 271.78,
   "end": 272.96,
   "text": "מלה תמיד ראתה קדימה."
  },
  {
   "start": 273.58,
   "end": 274.38,
   "text": "היא הבינה מה קורה."
  },
  {
   "start": 274.92,
   "end": 275.82,
   "text": "היא הבינה העניין."
  },
  {
   "start": 276.6,
   "end": 278.66,
   "text": "היא הבינה שפה מדובר בהשמדה."
  },
  {
   "start": 284.7,
   "end": 285.36,
   "text": "והיא החליטה,"
  },
  {
   "start": 286.68,
   "end": 287.9,
   "text": "את אשר החליטה."
  },
  {
   "start": 289.26,
   "end": 289.62,
   "text": "וככה"
  },
  {
   "start": 291.56,
   "end": 292.44,
   "text": "הגיעו לאושוויץ."
  },
  {
   "start": 293.44,
   "end": 296.34,
   "text": "בפתח היה פריקה של כל האנשים, כל הנשים,"
  },
  {
   "start": 296.84,
   "end": 297.64,
   "text": "והייתה שם קאפו."
  },
  {
   "start": 298.22,
   "end": 298.62,
   "text": "קאפו,"
  },
  {
   "start": 299.18,
   "end": 299.76,
   "text": "יהודייה אכזרית,"
  },
  {
   "start": 302.25,
   "end": 303.49,
   "text": "ששיתפה פעולה עם הנאצים,"
  },
  {
   "start": 305.19,
   "end": 309.91,
   "text": "והיא התנהגה באכזריות כלפי היהודים,"
  },
  {
   "start": 310.35,
   "end": 311.71,
   "text": "האומללים שלא הבינו מה קורה איתם."
  },
  {
   "start": 314.6,
   "end": 315.04,
   "text": "אבל אז,"
  },
  {
   "start": 315.6,
   "end": 315.96,
   "text": "מבין"
  },
  {
   "start": 317.16,
   "end": 318.34,
   "text": "לשורת העומדים,"
  },
  {
   "start": 319.6,
   "end": 323.36,
   "text": "פסעה למלע בתקיפות קדימה,"
  },
  {
   "start": 324.46,
   "end": 325.9,
   "text": "ובפעם הראשונה בחייה"
  },
  {
   "start": 326.48,
   "end": 327.64,
   "text": "היא הרימה את היד שלה"
  },
  {
   "start": 328.82,
   "end": 330.78,
   "text": "וסטרה לאותו קאפו"
  },
  {
   "start": 331.54,
   "end": 332.16,
   "text": "על פניה."
  },
  {
   "start": 333.36,
   "end": 334.74,
   "text": "שקט השתרר לו,"
  },
  {
   "start": 335.48,
   "end": 336.26,
   "text": "שקט אמין,"
  },
  {
   "start": 337.86,
   "end": 338.94,
   "text": "שקט מבשר האות."
  },
  {
   "start": 340.96,
   "end": 341.92,
   "text": "הקאפו הייתה עמומה,"
  },
  {
   "start": 343.26,
   "end": 343.78,
   "text": "היא לא האמינה,"
  },
  {
   "start": 346.86,
   "end": 347.66,
   "text": "אבל אז נשמע"
  },
  {
   "start": 348.5,
   "end": 351.94,
   "text": "קול, קול מתכתי מהצד השני."
  },
  {
   "start": 352.92,
   "end": 353.54,
   "text": "יש לה אופי."
  },
  {
   "start": 354.8,
   "end": 356.64,
   "text": "יש לנערה הזאת אופי."
  },
  {
   "start": 357.68,
   "end": 358.82,
   "text": "היה זה דוקטור קליין,"
  },
  {
   "start": 359.94,
   "end": 360.82,
   "text": "הרופא הנאצי"
  },
  {
   "start": 363.72,
   "end": 365.62,
   "text": "של מפקדת המחנה של אושוויץ."
  },
  {
   "start": 368.93,
   "end": 369.83,
   "text": "תביאי אותה אליי,"
  },
  {
   "start": 370.71,
   "end": 371.13,
   "text": "כך הוא אמר."
  },
  {
   "start": 373.17,
   "end": 375.13,
   "text": "את עם אופי את, את משהו מיוחד."
  },
  {
   "start": 376.59,
   "end": 378.95,
   "text": "את היא המתרגמת הראשית של מפקדת המחנה."
  },
  {
   "start": 380.81,
   "end": 381.97,
   "text": "את יודעת שפות, נכון?"
  },
  {
   "start": 382.13,
   "end": 383.07,
   "text": "את נראית לי די אינטליגנטית."
  },
  {
   "start": 384.29,
   "end": 384.57,
   "text": "ומלה"
  },
  {
   "start": 386.45,
   "end": 387.03,
   "text": "אמרה לו כן."
  },
  {
   "start": 389.55,
   "end": 390.53,
   "text": "זמן קצר אחר כך,"
  },
  {
   "start": 391.47,
   "end": 393.99,
   "text": "מלה, זאת שהעיזה להרים ראש,"
  },
  {
   "start": 394.51,
   "end": 394.69,
   "text": "זאת"
  },
  {
   "start": 395.39,
   "end": 396.59,
   "text": "שהייתה גאה ביהדות שלה,"
  },
  {
   "start": 397.23,
   "end": 400.19,
   "text": "נהפכה למתרגמת הראשית של מפקדת המחנה של אושוויץ."
  },
  {
   "start": 400.71,
   "end": 402.21,
   "text": "זה היה למעשה חלום של כל יהודייה."
  },
  {
   "start": 404.45,
   "end": 405.71,
   "text": "כל יהודייה רצתה להגיע לזה."
  },
  {
   "start": 406.33,
   "end": 407.87,
   "text": "הפירוש של זה אולי להינצל,"
  },
  {
   "start": 408.23,
   "end": 409.19,
   "text": "אולי להישאר בחיים,"
  },
  {
   "start": 409.57,
   "end": 411.81,
   "text": "לקבל אוכל קצת יותר נזין."
  },
  {
   "start": 412.73,
   "end": 413.35,
   "text": "מזין."
  },
  {
   "start": 414.31,
   "end": 416.13,
   "text": "אבל מלה זה לא עניין אותה."
  },
  {
   "start": 417.31,
   "end": 419.07,
   "text": "מלה בטחה בריבונו של עולם."
  },
  {
   "start": 419.69,
   "end": 421.73,
   "text": "מלה ראתה את הקדוש ברוך הוא מול העיניים."
  },
  {
   "start": 423.27,
   "end": 426.01,
   "text": "אז במקום להיות עסוקה כל הזמן, בעצמה"
  },
  {
   "start": 428.21,
   "end": 430.99,
   "text": "היא הפכה, היא עצמה, למוסד של גמילות חסדים."
  },
  {
   "start": 431.41,
   "end": 433.87,
   "text": "היא הייתה מסייעת לכל הנערות כמה שיכלה,"
  },
  {
   "start": 434.27,
   "end": 436.09,
   "text": "לחברות שלה, ליהודיות,"
  },
  {
   "start": 436.57,
   "end": 437.35,
   "text": "כמה שאפשר."
  },
  {
   "start": 438.39,
   "end": 438.83,
   "text": "ולא רק זה,"
  },
  {
   "start": 440.35,
   "end": 441.71,
   "text": "אלא בשעות הלילה המאוחרות,"
  },
  {
   "start": 442.37,
   "end": 443.71,
   "text": "כשכולם נמו את שנתם."
  },
  {
   "start": 444.53,
   "end": 445.39,
   "text": "היא הייתה עסוקה"
  },
  {
   "start": 447.27,
   "end": 450.77,
   "text": "בלא פחות ולא יותר מאשר סיוע למחתרת."
  },
  {
   "start": 451.95,
   "end": 454.91,
   "text": "היא הייתה מעבירה פצצות ממחנה אושוויץ"
  },
  {
   "start": 457.53,
   "end": 459.41,
   "text": "אל זרועות אנשי המחתרת."
  },
  {
   "start": 463.24,
   "end": 464.24,
   "text": "אף אחד לא האמין"
  },
  {
   "start": 465.68,
   "end": 467.28,
   "text": "שהיא הודיעה עם כזאת אמונה,"
  },
  {
   "start": 467.72,
   "end": 468.56,
   "text": "לא רק שהיא לא נשברת,"
  },
  {
   "start": 469.2,
   "end": 471.68,
   "text": "אלא היא בוטחת בריבונו של עולם ועושה את כל המאמצים"
  },
  {
   "start": 472.54,
   "end": 474.88,
   "text": "לעזור לבני עמה, לבנות עמה."
  },
  {
   "start": 479.33,
   "end": 480.59,
   "text": "כך עברו להם כמה חודשים,"
  },
  {
   "start": 481.75,
   "end": 484.69,
   "text": "אבל אז מלה כבר לא יכלה, מלה רצתה,"
  },
  {
   "start": 485.73,
   "end": 486.29,
   "text": "רצה לברוח משם."
  },
  {
   "start": 488.19,
   "end": 489.35,
   "text": "ואנשי המחתרת עזרו לה"
  },
  {
   "start": 490.39,
   "end": 490.83,
   "text": "שעת לילה."
  },
  {
   "start": 493.21,
   "end": 494.09,
   "text": "הסכנה בחוץ,"
  },
  {
   "start": 494.57,
   "end": 497.29,
   "text": "אבל מלה רואה רק את הקדוש ברוך הוא מול העיניים,"
  },
  {
   "start": 497.87,
   "end": 498.21,
   "text": "מלה ברחה."
  },
  {
   "start": 502.49,
   "end": 506.33,
   "text": "ספירות האזעקה שנשמעו בכל המחנה העידו"
  },
  {
   "start": 507.29,
   "end": 508.03,
   "text": "על הנעדרת,"
  },
  {
   "start": 508.91,
   "end": 509.71,
   "text": "והנאצים היו בלחץ."
  },
  {
   "start": 509.93,
   "end": 512.03,
   "text": "היא יודעת יותר מדי,"
  },
  {
   "start": 512.67,
   "end": 513.33,
   "text": "חייבים לתפוס אותה."
  },
  {
   "start": 514.69,
   "end": 515.33,
   "text": "חייבים לתפוס אותה."
  },
  {
   "start": 516.93,
   "end": 517.93,
   "text": "היא נהפכה פה לסמל."
  },
  {
   "start": 519.39,
   "end": 520.33,
   "text": "מחר כולם יברחו לנו."
  },
  {
   "start": 521.65,
   "end": 522.89,
   "text": "כל האסירות באושוויץ"
  },
  {
   "start": 525.33,
   "end": 526.01,
   "text": "שמחות"
  },
  {
   "start": 526.67,
   "end": 527.49,
   "text": "באותה נערה,"
  },
  {
   "start": 530.17,
   "end": 531.07,
   "text": "והן עשו את כל המאמצים."
  },
  {
   "start": 533.05,
   "end": 536.89,
   "text": "כל גרמניה הנאצית השקיעה את כל המשאבים שלה"
  },
  {
   "start": 537.41,
   "end": 544.65,
   "text": "כדי למצוא את אותה נערה יהודייה שבזכות האמונה שלה,"
  },
  {
   "start": 547.04,
   "end": 548.18,
   "text": "בזכות הדבקות שלה,"
  },
  {
   "start": 549.42,
   "end": 553.18,
   "text": "שמה ללעג את מכונת האימים הנאצית."
  },
  {
   "start": 593.62,
   "end": 600.9,
   "text": "כל האזעקה החריד את הלילה במחנה אושוויץ."
  },
  {
   "start": 602.28,
   "end": 604.24,
   "text": "כל הנשים הוצאו החוצה מבלוק הנשים."
  },
  {
   "start": 606.25,
   "end": 607.93,
   "text": "אף אחד לא הבין למה."
  },
  {
   "start": 610.07,
   "end": 610.71,
   "text": "למה מוצאים אותם?"
  },
  {
   "start": 613.01,
   "end": 614.01,
   "text": "כולם נעמדו בפחד."
  },
  {
   "start": 615.19,
   "end": 615.65,
   "text": "מה קורה?"
  },
  {
   "start": 617.61,
   "end": 618.15,
   "text": "חרדות"
  },
  {
   "start": 618.73,
   "end": 619.23,
   "text": "על הבאות,"
  },
  {
   "start": 621.39,
   "end": 625.47,
   "text": "אבל אז לפתע השמועה נשאה לכנפיים."
  },
  {
   "start": 627.55,
   "end": 628.25,
   "text": "מלע חזרה,"
  },
  {
   "start": 633.19,
   "end": 634.55,
   "text": "ואז כמו המייה"
  },
  {
   "start": 636.51,
   "end": 641.29,
   "text": "נשמעה מבין הנשים העומדות, מלע, מלע."
  },
  {
   "start": 642.49,
   "end": 643.29,
   "text": "השער נפתח,"
  },
  {
   "start": 644.75,
   "end": 645.85,
   "text": "כולם הביטו שמאלה,"
  },
  {
   "start": 646.69,
   "end": 647.29,
   "text": "השער נפתח."
  },
  {
   "start": 648.95,
   "end": 649.31,
   "text": "חבורה"
  },
  {
   "start": 651.15,
   "end": 653.43,
   "text": "של חיילים נאצים התקדמו."
  },
  {
   "start": 654.05,
   "end": 656.99,
   "text": "כשבמרכז פוסעת לה דמות שברירית,"
  },
  {
   "start": 658.27,
   "end": 659.59,
   "text": "אבל בוטחת בעצמה."
  },
  {
   "start": 661.43,
   "end": 664.91,
   "text": "דמות שברירית, אבל כולה מחוברת לה' יתברך."
  },
  {
   "start": 666.41,
   "end": 676.77,
   "text": "כשכל הפיתחון שלה נובע מהאמונה שה' יתברך מוליך את דרכה בחיים."
  },
  {
   "start": 678.67,
   "end": 681.85,
   "text": "והיא ככה פוסעת לה במרכז מלע,"
  },
  {
   "start": 683.07,
   "end": 686.13,
   "text": "הנערה היהודייה האמיצה הזאת."
  },
  {
   "start": 687.39,
   "end": 688.03,
   "text": "והם מקיפים אותה."
  },
  {
   "start": 695.44,
   "end": 697.06,
   "text": "הם נעמדו במרכז המחנה."
  },
  {
   "start": 700.65,
   "end": 701.37,
   "text": "דוקטור קליין"
  },
  {
   "start": 702.13,
   "end": 703.35,
   "text": "נעמד מול מלה."
  },
  {
   "start": 705.68,
   "end": 708.18,
   "text": "היה לך את כל מה שיהודייה יכולה לחלום עליו,"
  },
  {
   "start": 709.08,
   "end": 710.02,
   "text": "ואת בגדת בנו."
  },
  {
   "start": 712.34,
   "end": 714.58,
   "text": "מלה, בפעם השנייה בחיים שלה,"
  },
  {
   "start": 715.42,
   "end": 716.36,
   "text": "הרימה את היד,"
  },
  {
   "start": 717.04,
   "end": 720.04,
   "text": "וללא בושה סדרה לדוקטור קליין."
  },
  {
   "start": 721.6,
   "end": 724.28,
   "text": "מוטב למות ולא לסייע לכם."
  },
  {
   "start": 725.22,
   "end": 727.78,
   "text": "ואיך אתם חושבים שזו מה שיהודייה חולמת?"
  },
  {
   "start": 728.7,
   "end": 731.06,
   "text": "זה מה שהיא הודיעה חולמת עליו."
  },
  {
   "start": 736.94,
   "end": 739.38,
   "text": "תדעו לכם שאני לא ארשה לכם להתעלל בי."
  },
  {
   "start": 740.38,
   "end": 743.4,
   "text": "תדעו לכם שבת ישראל לא תרשה לכם להתעלל בה,"
  },
  {
   "start": 744.34,
   "end": 745.24,
   "text": "אמרה מלה נחרצות,"
  },
  {
   "start": 748.41,
   "end": 749.77,
   "text": "ולפתע מלמלה בכאב,"
  },
  {
   "start": 753.75,
   "end": 755.17,
   "text": "השם יתברך יסלח לי."
  },
  {
   "start": 771.56,
   "end": 772.84,
   "text": "ולפני שכולם הבינו,"
  },
  {
   "start": 773.74,
   "end": 777.15,
   "text": "היא עשתה צעד קטן,"
  },
  {
   "start": 778.69,
   "end": 780.83,
   "text": "ולפתע כולם שמו לב שמלה,"
  },
  {
   "start": 783.63,
   "end": 783.89,
   "text": "מלה"
  },
  {
   "start": 784.83,
   "end": 788.67,
   "text": "מאבדת ליד את שיווי המשקל וצונחת לה ארצה."
  },
  {
   "start": 793.75,
   "end": 794.37,
   "text": "מלה ידעה"
  },
  {
   "start": 796.74,
   "end": 799.12,
   "text": "שהם ירצו שהיא תשלם ביוקר,"
  },
  {
   "start": 803.54,
   "end": 808.36,
   "text": "אז מלה לא רצתה לתת להם את הסיכוי הזה."
  },
  {
   "start": 809.88,
   "end": 810.86,
   "text": "והיא צנחה ארצה,"
  },
  {
   "start": 813.4,
   "end": 815.22,
   "text": "ולנגד העיניים הנדהמות שבאו בה"
  },
  {
   "start": 816.5,
   "end": 817.0,
   "text": "ראו אותה"
  },
  {
   "start": 820.83,
   "end": 821.69,
   "text": "מלאה בדם,"
  },
  {
   "start": 822.95,
   "end": 823.45,
   "text": "והם הבינו,"
  },
  {
   "start": 824.31,
   "end": 826.37,
   "text": "חייבים לתלות אותה, צרך דוקטור קליין,"
  },
  {
   "start": 828.87,
   "end": 829.81,
   "text": "כדי למנוע ממנה."
  },
  {
   "start": 831.01,
   "end": 834.65,
   "text": "אולי לספוג משהו שהיא לא ידעה אם היא תוכל לעמוד."
  },
  {
   "start": 835.61,
   "end": 836.53,
   "text": "היא פשוט החליטה,"
  },
  {
   "start": 838.79,
   "end": 839.91,
   "text": "בתקווה שהשם יסלח לה,"
  },
  {
   "start": 840.63,
   "end": 841.87,
   "text": "לא לתת להם להתעלל בה."
  },
  {
   "start": 844.05,
   "end": 846.21,
   "text": "וכך היא מועברת גוססת למשרפות."
  },
  {
   "start": 848.31,
   "end": 850.23,
   "text": "הם לקחו אותה למשרפה מספר שתיים."
  },
  {
   "start": 854.7,
   "end": 855.84,
   "text": "בכוחות אחרונים,"
  },
  {
   "start": 856.36,
   "end": 857.42,
   "text": "כשהיא הגיעה למשרפה,"
  },
  {
   "start": 857.88,
   "end": 859.64,
   "text": "היא פתחה את העיניים הטהורות שלה."
  },
  {
   "start": 860.46,
   "end": 863.18,
   "text": "היא ראתה בחורים יהודים, סימנה להם להתקרב אליה."
  },
  {
   "start": 864.66,
   "end": 866.16,
   "text": "וכך היא מלמלה ואמרה להם,"
  },
  {
   "start": 866.96,
   "end": 867.68,
   "text": "אני מבקשת מכם,"
  },
  {
   "start": 868.78,
   "end": 870.58,
   "text": "אני מבקשת מכם, תקברו אותי."
  },
  {
   "start": 871.44,
   "end": 873.1,
   "text": "בבקשה מכם, תקברו אותי."
  },
  {
   "start": 873.92,
   "end": 875.92,
   "text": "אל תיתנו להם לא לקבור אותי."
  },
  {
   "start": 876.46,
   "end": 879.16,
   "text": "ואחרי שתקברו אותי, תגידו עליי קדיש."
  },
  {
   "start": 879.98,
   "end": 881.34,
   "text": "תגידו עליי קדיש."
  },
  {
   "start": 883.34,
   "end": 884.3,
   "text": "זה מה שעניין אותה."
  },
  {
   "start": 885.34,
   "end": 886.56,
   "text": "היא הייתה עם השם מתברך,"
  },
  {
   "start": 887.58,
   "end": 888.76,
   "text": "והנאצים לא יכלו לה."
  },
  {
   "start": 890.62,
   "end": 891.9,
   "text": "וכך היא לחשה עוד שנייה,"
  },
  {
   "start": 892.92,
   "end": 893.92,
   "text": "ועיניה נעצמו,"
  },
  {
   "start": 895.18,
   "end": 896.8,
   "text": "ונשמתה יצתה בטהרה."
  },
  {
   "start": 901.62,
   "end": 902.08,
   "text": "בלילה"
  },
  {
   "start": 902.76,
   "end": 903.76,
   "text": "התגנבו בחורים,"
  },
  {
   "start": 905.02,
   "end": 907.7,
   "text": "והביאו את האפר הקדוש שלה לקבורה."
  },
  {
   "start": 913.12,
   "end": 915.02,
   "text": "מלה לימדה אותן אולי סוד,"
  },
  {
   "start": 916.0,
   "end": 916.68,
   "text": "סוד מיוחד."
  },
  {
   "start": 918.26,
   "end": 921.56,
   "text": "אתם יודעים שנרות שבת שבנות ישראל מדליקות,"
  },
  {
   "start": 923.02,
   "end": 924.88,
   "text": "רצוי כשהן יהיו משמן."
  },
  {
   "start": 925.82,
   "end": 927.44,
   "text": "אתם יודעים מה השמן מבטא?"
  },
  {
   "start": 928.66,
   "end": 929.7,
   "text": "השמן המהות שלו."
  },
  {
   "start": 931.64,
   "end": 933.5,
   "text": "אני אתן מעצמי,"
  },
  {
   "start": 934.12,
   "end": 935.4,
   "text": "אני אפחית מעצמי,"
  },
  {
   "start": 935.88,
   "end": 940.34,
   "text": "אני יוריד מעצמי, אני אקריב את עצמי כדי שיהיה אור."
  },
  {
   "start": 941.4,
   "end": 947.72,
   "text": "מילא הלכה והקריבה את עצמה כדי שיהיה אור לאותן מאות אסירות"
  },
  {
   "start": 948.5,
   "end": 950.2,
   "text": "יהודיות באושוויץ,"
  },
  {
   "start": 950.78,
   "end": 952.26,
   "text": "לתת להן את אור האמונה."
  },
  {
   "start": 954.3,
   "end": 955.82,
   "text": "ואתם יודעים, רוח חדשה"
  },
  {
   "start": 955.82,
   "end": 965.2,
   "text": "היא נסחה במחנה עד דכך שפרצה לה תוכנית התקוממות שנקראה בשם מלע."
  },
  {
   "start": 965.8,
   "end": 966.9,
   "text": "פתאום האסירות הבינו"
  },
  {
   "start": 967.98,
   "end": 969.04,
   "text": "אנחנו לא חייבות לשתוק."
  },
  {
   "start": 970.44,
   "end": 972.08,
   "text": "יש לנו בורא עולם להתפלל השם יתברך."
  },
  {
   "start": 972.64,
   "end": 973.76,
   "text": "נשמור על הצניעות שלנו."
  },
  {
   "start": 974.14,
   "end": 975.34,
   "text": "נשמור על הכבוד שלנו."
  },
  {
   "start": 975.76,
   "end": 977.5,
   "text": "אנחנו בנות של השם יתברך."
  },
  {
   "start": 979.68,
   "end": 984.52,
   "text": "בלב התופת הזו היא הרימה לכולם את המורל הרוחני."
  },
  {
   "start": 985.28,
   "end": 986.28,
   "text": "איזו עוצמה זאת."
  },
  {
   "start": 988.2,
   "end": 989.74,
   "text": "נערה קטנה מבלגיה,"
  },
  {
   "start": 992.06,
   "end": 993.12,
   "text": "נערה קטנה מבלגיה,"
  },
  {
   "start": 993.84,
   "end": 995.26,
   "text": "מקדשת שם שמיים,"
  },
  {
   "start": 996.24,
   "end": 1001.0,
   "text": "כמו השמן שהמהות שלו להקריב את עצמו למען האור."
  },
  {
   "start": 1001.62,
   "end": 1002.7,
   "text": "זו מה שעשתה מלה,"
  },
  {
   "start": 1003.4,
   "end": 1005.34,
   "text": "וזו מה שעושות בנות ישראל."
  },
  {
   "start": 1006.3,
   "end": 1010.22,
   "text": "מקריבות מעצמן כדי שהאור, הילדים שלהם,"
  },
  {
   "start": 1010.66,
   "end": 1011.96,
   "text": "יאירו את עם ישראל."
  },
  {
   "start": 1012.82,
   "end": 1017.62,
   "text": "מקריבות מעצמן כדי שהבעלים שלהם יאירו באור התורה"
  },
  {
   "start": 1018.46,
   "end": 1019.16,
   "text": "את עם ישראל."
  },
  {
   "start": 1027.17,
   "end": 1030.05,
   "text": "וזוהי מנורת הזהב של עם ישראל."
  },
  {
   "start": 1030.57,
   "end": 1033.97,
   "text": "השמן מקריב את עצמו, נותן מעצמו,"
  },
  {
   "start": 1034.35,
   "end": 1036.89,
   "text": "כדי שהפתילה תבער לה יפה מאוד."
  },
  {
   "start": 1037.27,
   "end": 1039.15,
   "text": "בלי השמן אין פתילה."
  },
  {
   "start": 1042.61,
   "end": 1045.73,
   "text": "זה הסוד של בנות ישראל הקדושות."
  },
  {
   "start": 1047.41,
   "end": 1047.99,
   "text": "בצניעות,"
  },
  {
   "start": 1048.65,
   "end": 1049.91,
   "text": "בחוכמה, בתבונה."
  },
  {
   "start": 1050.83,
   "end": 1051.77,
   "text": "ללכת ולבנות,"
  },
  {
   "start": 1052.71,
   "end": 1055.21,
   "text": "ללכת ולהקים, ללכת ולהאיר,"
  },
  {
   "start": 1056.19,
   "end": 1056.75,
   "text": "להאיר."
  },
  {
   "start": 1099.78,
   "end": 1100.6,
   "text": "זו הירושה."
  },
  {
   "start": 1101.52,
   "end": 1104.48,
   "text": "זו הירושה ששרה הורישה לרבקה."
  },
  {
   "start": 1105.7,
   "end": 1107.14,
   "text": "שרה מסרה נפש."
  },
  {
   "start": 1108.18,
   "end": 1111.18,
   "text": "אפילו את עצמה מתה מתוך"
  },
  {
   "start": 1112.5,
   "end": 1114.1,
   "text": "מסירות נפש על הילד שלה,"
  },
  {
   "start": 1115.14,
   "end": 1115.6,
   "text": "על יצחק."
  },
  {
   "start": 1116.22,
   "end": 1116.98,
   "text": "היא רבקה."
  },
  {
   "start": 1118.62,
   "end": 1121.16,
   "text": "רבקה סיכנה את עצמה כדי להציל את יעקב שלה."
  },
  {
   "start": 1122.28,
   "end": 1128.42,
   "text": "רחל נפטרה באמצע הדרך כדי להגן על עם ישראל, כדי לבכות על עם ישראל."
  },
  {
   "start": 1130.08,
   "end": 1130.94,
   "text": "רחל,"
  },
  {
   "start": 1131.62,
   "end": 1138.1,
   "text": "לאה הייתה בוכה שנים כדי לא להינשא לעשו, כדי להינשא ליעקב, לבנות לנו את שושלת עם ישראל,"
  },
  {
   "start": 1138.4,
   "end": 1139.66,
   "text": "את השבטים הקדושים."
  },
  {
   "start": 1141.06,
   "end": 1142.32,
   "text": "חנה הנביאה,"
  },
  {
   "start": 1143.12,
   "end": 1148.22,
   "text": "בנתה לנו את שמואל מהמסירות נפש שלה, מהבכי לה כדי שיצא לבן,"
  },
  {
   "start": 1148.92,
   "end": 1150.52,
   "text": "בן כמו שמואל הנביא."
  },
  {
   "start": 1150.94,
   "end": 1155.7,
   "text": "אומר המדרש בכל יום בת-קול היא הייתה יוצאת ומפוצצת בכל העולם ואומרת,"
  },
  {
   "start": 1156.1,
   "end": 1157.06,
   "text": "עתיד לקום"
  },
  {
   "start": 1157.72,
   "end": 1159.52,
   "text": "נביא ושמו שמואל."
  },
  {
   "start": 1160.56,
   "end": 1165.34,
   "text": "חנה הנביאה הביאה אותו לעולם. חנה הנביאה מסרה אותו לשם יתברך."
  },
  {
   "start": 1166.06,
   "end": 1170.2,
   "text": "לאליה הכהן כדי לצאת ממנו את אחד מהנביאים הגדולים ביותר,"
  },
  {
   "start": 1170.68,
   "end": 1172.8,
   "text": "ששקול כנגד משה ואהרון."
  },
  {
   "start": 1178.64,
   "end": 1180.06,
   "text": "ככה לכל אורך הדורות."
  },
  {
   "start": 1180.92,
   "end": 1182.34,
   "text": "את רבי עקיבא איגר!"
  },
  {
   "start": 1182.94,
   "end": 1185.54,
   "text": "מי שעזרה לו להיות רבי עקיבא איגר זו הייתה אשתו."
  },
  {
   "start": 1187.02,
   "end": 1188.36,
   "text": "את הגאון מווילנה!"
  },
  {
   "start": 1188.82,
   "end": 1190.98,
   "text": "מי שתמכה בו ועזרה זו הייתה אשתו."
  },
  {
   "start": 1191.3,
   "end": 1193.74,
   "text": "של הגאון מווילנה, לא הפסיק ללמוד תורה."
  },
  {
   "start": 1195.14,
   "end": 1196.3,
   "text": "איך אישה יכולה להחזיק?"
  },
  {
   "start": 1197.62,
   "end": 1200.38,
   "text": "החזיקה כי ידעה מה זה התורה של הגאון מווילנה."
  },
  {
   "start": 1201.14,
   "end": 1203.46,
   "text": "איפה היה התורה שלנו היום בלי הגאון מווילנה?"
  },
  {
   "start": 1209.58,
   "end": 1211.22,
   "text": "רבי ברוך ממזיבוז'."
  },
  {
   "start": 1212.76,
   "end": 1214.3,
   "text": "רבי אפרים מסדלקוב."
  },
  {
   "start": 1215.4,
   "end": 1217.1,
   "text": "בעל הדגל ממחנה אפרים."
  },
  {
   "start": 1217.4,
   "end": 1222.72,
   "text": "מה היה בלי אמא שלהם? עדל, הבת שלה בעל שם טוב. עדל, הקדושה, אשדת למו."
  },
  {
   "start": 1231.53,
   "end": 1232.49,
   "text": "החזון איש."
  },
  {
   "start": 1234.64,
   "end": 1236.22,
   "text": "מי הייתה מאחוריו אם לא אשתו?"
  },
  {
   "start": 1237.12,
   "end": 1238.32,
   "text": "הרבנית בתיה, מי?"
  },
  {
   "start": 1238.68,
   "end": 1244.1,
   "text": "ישראל."
  },
  {
   "start": 1245.8,
   "end": 1251.74,
   "text": "היו המנוע שמטיס את הבעלים שלהם לבנות עולמות,"
  },
  {
   "start": 1252.26,
   "end": 1253.22,
   "text": "פה בעולם הזה,"
  },
  {
   "start": 1253.76,
   "end": 1254.54,
   "text": "בעולם הבא."
  },
  {
   "start": 1255.04,
   "end": 1257.5,
   "text": "לבנות לנו עם שלם, עם שלם הם בנו,"
  },
  {
   "start": 1258.24,
   "end": 1260.78,
   "text": "בקשה."
  },
  {
   "start": 1261.36,
   "end": 1265.12,
   "text": "זה עוד יום ועוד יום ועוד יום, אבל לאישה יש כוח, יש לה סבלנות."
  },
  {
   "start": 1266.58,
   "end": 1270.38,
   "text": "בוא תן לגבר לסרוג סוודר, תראו איך הוא כבר כמה זמן לוקח את הכול, זורק את זה,"
  },
  {
   "start": 1270.4,
   "end": 1270.78,
   "text": "זה לא יכול!"
  },
  {
   "start": 1271.68,
   "end": 1273.04,
   "text": "אישה יכולה לאט-לאט."
  },
  {
   "start": 1274.2,
   "end": 1274.62,
   "text": "בונה עוד,"
  },
  {
   "start": 1275.16,
   "end": 1278.54,
   "text": "עוד סריגה, עוד תנועה ועוד תנועה, בסוף יוצא סוודר."
  },
  {
   "start": 1279.38,
   "end": 1281.22,
   "text": "ככה אישה עוד יום, ועוד יום,"
  },
  {
   "start": 1281.84,
   "end": 1284.96,
   "text": "עוד יום, ועוד בנייה, ועוד בנייה, בסוף יוצא"
  },
  {
   "start": 1285.66,
   "end": 1286.08,
   "text": "בעל לתפארת."
  },
  {
   "start": 1287.68,
   "end": 1289.16,
   "text": "בין תורה לתפארת."
  },
  {
   "start": 1297.3,
   "end": 1298.94,
   "text": "כל אישה ששומעת אותנו."
  },
  {
   "start": 1300.16,
   "end": 1305.74,
   "text": "לא משנה באיזה גיל, לא, לא. כי בת ישראל זאת בת ישראל בכל גיל!"
  },
  {
   "start": 1306.2,
   "end": 1308.1,
   "text": "בעם ישראל,"
  },
  {
   "start": 1308.78,
   "end": 1310.66,
   "text": "בת ישראל קדושה זה כל החיים."
  },
  {
   "start": 1311.14,
   "end": 1313.4,
   "text": "זה כל החיים, זו עוצמה מוכנית לכל החיים."
  }
 ]
}