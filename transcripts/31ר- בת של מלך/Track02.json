{
 "disc": "31ר- בת של מלך",
 "track": "Track02",
 "duration": 526.128,
 "segments": [
  {
   "start": 27.09,
   "end": 31.19,
   "text": "אומרת התורה הקדושה, כה תאמר לבית יעקב ותגד לבני ישראל."
  },
  {
   "start": 32.87,
   "end": 34.71,
   "text": "בית יעקב אלו הנשים."
  },
  {
   "start": 35.79,
   "end": 38.53,
   "text": "למה נקרא בית יעקב ולא בנות יעקב?"
  },
  {
   "start": 39.43,
   "end": 42.11,
   "text": "היה צריך להגיד, כה תאמר לבנות יעקב"
  },
  {
   "start": 42.95,
   "end": 43.95,
   "text": "ותגד לבני ישראל."
  },
  {
   "start": 45.15,
   "end": 47.11,
   "text": "למה הבנות נקראות בית יעקב?"
  },
  {
   "start": 48.13,
   "end": 49.27,
   "text": "אומרים לך, זלה קדושים,"
  },
  {
   "start": 50.05,
   "end": 54.95,
   "text": "האישה נקראת, הנשים נקראות בית יעקב, כי האישה היא זו שקובעת את האווירה בבית."
  },
  {
   "start": 57.34,
   "end": 58.76,
   "text": "אתם יודעים, סיפר איזה יהודי אחד."
  },
  {
   "start": 59.88,
   "end": 61.22,
   "text": "הוא אמר, כשהילד קטן,"
  },
  {
   "start": 61.92,
   "end": 62.94,
   "text": "הוא למד אצל מלמד,"
  },
  {
   "start": 65.12,
   "end": 66.58,
   "text": "והיו עוד ילדים איתו בכיתה."
  },
  {
   "start": 67.68,
   "end": 68.9,
   "text": "וזו הייתה תקופה,"
  },
  {
   "start": 70.2,
   "end": 70.96,
   "text": "תקופה קשה."
  },
  {
   "start": 72.04,
   "end": 74.42,
   "text": "תקופה שהמון המון ילדים התקלקלו."
  },
  {
   "start": 76.81,
   "end": 78.07,
   "text": "היה נדיר שילד"
  },
  {
   "start": 78.83,
   "end": 79.47,
   "text": "ישרוד"
  },
  {
   "start": 80.83,
   "end": 81.93,
   "text": "בעולם היהודי."
  },
  {
   "start": 82.71,
   "end": 83.81,
   "text": "הרחוב משך,"
  },
  {
   "start": 84.77,
   "end": 86.39,
   "text": "והיה מושך כמו במגנט."
  },
  {
   "start": 86.39,
   "end": 95.71,
   "text": "והמלמד היה מלמד ואותו ילד כמו כל התלמידים או רובם הראש לו היה בחוץ ברחוב."
  },
  {
   "start": 96.97,
   "end": 100.99,
   "text": "המלמד מדבר והוא בכלל מהחלון שם מסתכל משקיף על הרחוב"
  },
  {
   "start": 101.73,
   "end": 102.85,
   "text": "מתכנן תוכניות."
  },
  {
   "start": 104.59,
   "end": 107.55,
   "text": "הוא והכיתה ההוא והלימודים היו מרחק"
  },
  {
   "start": 108.23,
   "end": 109.09,
   "text": "שמיים וארץ."
  },
  {
   "start": 112.67,
   "end": 113.23,
   "text": "בינתיים"
  },
  {
   "start": 114.31,
   "end": 115.81,
   "text": "הצטבר חוב למלמד"
  },
  {
   "start": 118.04,
   "end": 119.18,
   "text": "רצה שלם שכר לימוד"
  },
  {
   "start": 120.02,
   "end": 123.64,
   "text": "ולאימא ואבא שהיו קשי יום, לא היה כסף."
  },
  {
   "start": 124.4,
   "end": 125.3,
   "text": "לא היה כסף לשלם."
  },
  {
   "start": 126.44,
   "end": 128.04,
   "text": "והילד סיפר, אתם יודעים,"
  },
  {
   "start": 129.06,
   "end": 130.0,
   "text": "כשאז הייתי ילד קטן,"
  },
  {
   "start": 130.86,
   "end": 132.56,
   "text": "לא הבנתי, הבנתי שיש חוב ל.ל."
  },
  {
   "start": 133.88,
   "end": 137.26,
   "text": "וצריך לשלם את זה כדי שאני אמשיך ללמוד, למרות שהלימודים לא עניינו אותי."
  },
  {
   "start": 138.68,
   "end": 140.06,
   "text": "אבל אז נכנסתי הביתה"
  },
  {
   "start": 140.7,
   "end": 141.16,
   "text": "יום אחד,"
  },
  {
   "start": 142.0,
   "end": 142.42,
   "text": "ואני לא אשכח,"
  },
  {
   "start": 143.26,
   "end": 144.02,
   "text": "ראיתי את אימא שלי."
  },
  {
   "start": 144.88,
   "end": 147.02,
   "text": "את אימא שלי זו שסבלה מהקור."
  },
  {
   "start": 147.86,
   "end": 149.58,
   "text": "זו שסבלה מהפרקים שלה."
  },
  {
   "start": 150.8,
   "end": 152.9,
   "text": "ובאירופה הקור הוא קור,"
  },
  {
   "start": 153.72,
   "end": 154.3,
   "text": "שלג."
  },
  {
   "start": 156.22,
   "end": 159.26,
   "text": "והיא הייתה, אני זוכר, שהייתה מצטנפת לה כל ערב"
  },
  {
   "start": 159.92,
   "end": 164.08,
   "text": "אל המקום היחיד שנתן לה שביב של תקווה מהכאבים,"
  },
  {
   "start": 164.74,
   "end": 165.34,
   "text": "אל התנור."
  },
  {
   "start": 166.46,
   "end": 167.26,
   "text": "סביב התנור,"
  },
  {
   "start": 167.9,
   "end": 169.0,
   "text": "זה היה מרכז הבית."
  },
  {
   "start": 171.99,
   "end": 173.63,
   "text": "ואני נכנס ואני רואה אותה."
  },
  {
   "start": 174.29,
   "end": 175.39,
   "text": "היא עסקה במרץ,"
  },
  {
   "start": 176.29,
   "end": 177.65,
   "text": "בלפרק את התנור."
  },
  {
   "start": 178.63,
   "end": 182.15,
   "text": "את התנור, זה שעזר לה לעבור את ימי החורף הקשים,"
  },
  {
   "start": 182.81,
   "end": 184.61,
   "text": "זה שהקל קצת על הכאבים שלה,"
  },
  {
   "start": 185.23,
   "end": 186.85,
   "text": "זה שסיפק חום לכל הבית."
  },
  {
   "start": 187.87,
   "end": 189.33,
   "text": "ואני לא הבנתי, אמא, מה את מפרקת?"
  },
  {
   "start": 192.29,
   "end": 193.97,
   "text": "אבל אז ראיתי גם את אבא בצד השני."
  },
  {
   "start": 194.63,
   "end": 195.45,
   "text": "ראיתי אותם מפרקים,"
  },
  {
   "start": 197.03,
   "end": 198.01,
   "text": "ובוכים."
  },
  {
   "start": 199.05,
   "end": 199.75,
   "text": "דמעות."
  },
  {
   "start": 201.35,
   "end": 202.29,
   "text": "אז לא אמרתי כלום."
  },
  {
   "start": 203.17,
   "end": 205.49,
   "text": "הבנתי שהם מפרקים בכאב."
  },
  {
   "start": 207.05,
   "end": 208.81,
   "text": "אז פשוט שאלתי אחרי זה, אמא, למה?"
  },
  {
   "start": 209.67,
   "end": 210.85,
   "text": "למה את מפרקת את התנור?"
  },
  {
   "start": 212.75,
   "end": 213.33,
   "text": "אמא ענתה"
  },
  {
   "start": 214.07,
   "end": 215.01,
   "text": "בקול החלטי,"
  },
  {
   "start": 215.77,
   "end": 216.65,
   "text": "בני היקר אני,"
  },
  {
   "start": 217.65,
   "end": 220.51,
   "text": "אני מפרק את התנור כדי שיהיה לנו כסף,"
  },
  {
   "start": 220.93,
   "end": 223.85,
   "text": "נמכור אותו ואין לנו כסף לשלם שתלמד תורה."
  },
  {
   "start": 227.88,
   "end": 228.94,
   "text": "וזה דקר לי את הלב."
  },
  {
   "start": 230.72,
   "end": 231.78,
   "text": "ואחר כך אני זוכר"
  },
  {
   "start": 232.92,
   "end": 234.28,
   "text": "איך הבדתי מהחלון,"
  },
  {
   "start": 235.02,
   "end": 236.1,
   "text": "ראיתי את אמא ואבא"
  },
  {
   "start": 236.76,
   "end": 238.24,
   "text": "עומדים ברחוב הקפוא"
  },
  {
   "start": 239.8,
   "end": 241.4,
   "text": "ומנסים למכור את התנור."
  },
  {
   "start": 242.78,
   "end": 243.5,
   "text": "אמא רועדת מקור,"
  },
  {
   "start": 244.84,
   "end": 245.42,
   "text": "אבל היא עומדת,"
  },
  {
   "start": 246.16,
   "end": 247.24,
   "text": "בכזו החלטיות,"
  },
  {
   "start": 248.0,
   "end": 252.68,
   "text": "ומוכרת את התנור כדי שאני הבן שלה ילמד תורה."
  },
  {
   "start": 254.02,
   "end": 259.98,
   "text": "אף פעם לא הבנתי כמה חשוב ללמוד תורה כשראיתי את אמא!"
  },
  {
   "start": 260.66,
   "end": 262.36,
   "text": "אמא עומדת בשלג,"
  },
  {
   "start": 263.06,
   "end": 264.46,
   "text": "בסוף עוד בקור,"
  },
  {
   "start": 265.6,
   "end": 266.9,
   "text": "רועדת מקור,"
  },
  {
   "start": 267.62,
   "end": 270.62,
   "text": "ומוכרת את התנור כדי שאני אלמד תורה."
  },
  {
   "start": 272.32,
   "end": 278.78,
   "text": "זה היה שיעור באהבת התורה שחדר לי לכל העצמות."
  },
  {
   "start": 281.48,
   "end": 283.34,
   "text": "הרגשתי כזו שרפה בלב."
  },
  {
   "start": 285.42,
   "end": 287.24,
   "text": "מקץ מספר שעות הם חזרו,"
  },
  {
   "start": 290.19,
   "end": 293.17,
   "text": "ואני נשארתי מביט בחלון,"
  },
  {
   "start": 294.45,
   "end": 296.69,
   "text": "רואה את האנשים לוקחים את התנור ומתרחקים."
  },
  {
   "start": 298.23,
   "end": 299.23,
   "text": "הלילה היקר,"
  },
  {
   "start": 300.19,
   "end": 301.03,
   "text": "היקר בבית,"
  },
  {
   "start": 301.85,
   "end": 302.55,
   "text": "אמא רעדה,"
  },
  {
   "start": 304.84,
   "end": 306.26,
   "text": "אבל כבר לא היה מה שיחמם אותה."
  },
  {
   "start": 307.56,
   "end": 308.46,
   "text": "כבר לא היה התנור."
  },
  {
   "start": 310.81,
   "end": 311.35,
   "text": "למחרת"
  },
  {
   "start": 312.33,
   "end": 314.83,
   "text": "הם ניגשו בפנים שמחות וצועלות,"
  },
  {
   "start": 315.53,
   "end": 316.57,
   "text": "כאילו לא קרה כלום."
  },
  {
   "start": 317.69,
   "end": 318.65,
   "text": "ניגשו אל המלמד"
  },
  {
   "start": 319.25,
   "end": 320.11,
   "text": "ושילמו לו את החוב."
  },
  {
   "start": 321.33,
   "end": 323.83,
   "text": "עכשיו הבן שלנו יוכל להמשיך וללמוד תורה."
  },
  {
   "start": 325.87,
   "end": 328.47,
   "text": "אמר הילד, מאז אני השתנתי,"
  },
  {
   "start": 329.19,
   "end": 330.29,
   "text": "פשוט לא יכולתי."
  },
  {
   "start": 331.81,
   "end": 332.37,
   "text": "לא יכולתי."
  },
  {
   "start": 333.97,
   "end": 336.79,
   "text": "כי כל פעם שהייתי מרים את העיניים אל החלון,"
  },
  {
   "start": 337.77,
   "end": 340.31,
   "text": "לראות את החברים שלי, החברים הכי טובים,"
  },
  {
   "start": 340.61,
   "end": 343.59,
   "text": "שעזבו שם את התלמוד תורה והלכו לרחוב."
  },
  {
   "start": 343.99,
   "end": 346.03,
   "text": "ראיתי עוד רציתי לראות אותם משחקים ברחוב,"
  },
  {
   "start": 346.47,
   "end": 348.39,
   "text": "לקנות בהם, להיות כמוהם."
  },
  {
   "start": 348.75,
   "end": 351.17,
   "text": "כל פעם שהרמתי את העיניים אל החלון,"
  },
  {
   "start": 351.85,
   "end": 354.53,
   "text": "ראיתי למול עיניי את תמונה של אמא."
  },
  {
   "start": 355.39,
   "end": 358.15,
   "text": "אמא בדמעות מפרקת את התנור,"
  },
  {
   "start": 359.23,
   "end": 361.77,
   "text": "כדי שיחזקאל שלה ילמד תורה."
  },
  {
   "start": 362.39,
   "end": 365.13,
   "text": "ראיתי את התמונה של אמא עומדת בשלג,"
  },
  {
   "start": 365.59,
   "end": 367.31,
   "text": "כדי שיחזקאל שלה ילמד תורה."
  },
  {
   "start": 368.23,
   "end": 370.45,
   "text": "ראיתי את התמונה של אמא ישנה,"
  },
  {
   "start": 371.03,
   "end": 373.77,
   "text": "רועדת מקור, סובלת מהפרקים."
  },
  {
   "start": 374.89,
   "end": 376.27,
   "text": "בלי תנור,"
  },
  {
   "start": 376.91,
   "end": 378.21,
   "text": "בלי דבר מינימלי."
  },
  {
   "start": 379.29,
   "end": 381.01,
   "text": "כדי שיחזקאל שלה ילמד תורה."
  },
  {
   "start": 382.65,
   "end": 385.63,
   "text": "כבר לא יכלתי להסתכל מעבר לחלום."
  },
  {
   "start": 386.85,
   "end": 387.31,
   "text": "לא יכלתי."
  },
  {
   "start": 388.43,
   "end": 389.31,
   "text": "אם הייתה איתי,"
  },
  {
   "start": 389.93,
   "end": 390.41,
   "text": "בלימוד,"
  },
  {
   "start": 391.39,
   "end": 392.17,
   "text": "בגמרא,"
  },
  {
   "start": 392.85,
   "end": 393.55,
   "text": "במשנה,"
  },
  {
   "start": 394.03,
   "end": 395.01,
   "text": "בכל השיעורים."
  },
  {
   "start": 396.01,
   "end": 398.23,
   "text": "והילד הזה גדל,"
  },
  {
   "start": 399.47,
   "end": 400.43,
   "text": "הילד הזה גדל."
  },
  {
   "start": 402.45,
   "end": 406.17,
   "text": "לימים הוא נהיה הרב יחזקאל אברמסקי, זכר צדיק לברכה,"
  },
  {
   "start": 406.75,
   "end": 410.45,
   "text": "הרב של העיר לונדון, נשיא ועד הישיבות העולמי,"
  },
  {
   "start": 411.07,
   "end": 412.61,
   "text": "אחד מגדולי ישראל."
  },
  {
   "start": 414.53,
   "end": 417.53,
   "text": "והרב יחזקאל אברמסקי, הרב אברמסקי, סיפר"
  },
  {
   "start": 418.61,
   "end": 420.13,
   "text": "זמן רב אחר כך,"
  },
  {
   "start": 420.79,
   "end": 422.95,
   "text": "כשהוא כבר בשנות חייו האחרונות,"
  },
  {
   "start": 423.71,
   "end": 427.65,
   "text": "הוא אומר, למעלה מ-70 שנה עברו מאז אותו מקרה."
  },
  {
   "start": 429.63,
   "end": 432.79,
   "text": "אבל בכל ספר שכתבתי, והוא כתב ספרים,"
  },
  {
   "start": 435.01,
   "end": 436.91,
   "text": "החברים, אני לא יודע מה הם עשו, הוא כתב ספרים."
  },
  {
   "start": 438.05,
   "end": 440.55,
   "text": "בכל ספר שכתבתי,"
  },
  {
   "start": 441.25,
   "end": 442.49,
   "text": "יש פה גם דף מיוחד."
  },
  {
   "start": 443.55,
   "end": 447.33,
   "text": "דף שבו טבוע הכוח הרוחני שהשרישו בי."
  },
  {
   "start": 448.01,
   "end": 448.47,
   "text": "אמא!"
  },
  {
   "start": 449.97,
   "end": 452.75,
   "text": "ואבא, שמסרו נפש!"
  },
  {
   "start": 453.31,
   "end": 456.79,
   "text": "בגמעות שיחזקאל שלהם יגדל כמו שצריך."
  },
  {
   "start": 462.08,
   "end": 462.84,
   "text": "על ידי תפילות,"
  },
  {
   "start": 463.6,
   "end": 466.66,
   "text": "על ידי מסירות נפש, בנו נשים."
  },
  {
   "start": 468.14,
   "end": 469.66,
   "text": "את דור העתיד של עם ישראל."
  },
  {
   "start": 470.56,
   "end": 473.22,
   "text": "מאחורי כל גדולי הדור עמדה לה איזה אמא,"
  },
  {
   "start": 473.68,
   "end": 478.06,
   "text": "איזו אמא קטנה גדולה עם ספר תהילים ושפכה דמעות."
  },
  {
   "start": 479.84,
   "end": 482.22,
   "text": "ושהבן שלה ושבעלה"
  },
  {
   "start": 484.0,
   "end": 485.08,
   "text": "יהיה יהודי טוב,"
  },
  {
   "start": 485.76,
   "end": 486.72,
   "text": "יהיה יהודי כשר,"
  },
  {
   "start": 497.67,
   "end": 499.07,
   "text": "מאחורי כל יהודי,"
  },
  {
   "start": 499.97,
   "end": 501.39,
   "text": "מאחורי כל ילד, מאחורי כל פעל."
  },
  {
   "start": 502.19,
   "end": 506.19,
   "text": "יושבת לה שם אישה עם ספר התהילים העתיק של דוד המלך,"
  },
  {
   "start": 507.25,
   "end": 508.63,
   "text": "עם שיר המעלות!"
  },
  {
   "start": 509.87,
   "end": 513.47,
   "text": "אשא עיני אל ההרים, עם שיר המעלות ממעמקים."
  },
  {
   "start": 514.69,
   "end": 515.65,
   "text": "והתפילות האלה,"
  },
  {
   "start": 516.23,
   "end": 517.31,
   "text": "והקריאות האלה,"
  },
  {
   "start": 518.59,
   "end": 520.91,
   "text": "עלו אל על השמיים, אל כיסא הכבוד,"
  },
  {
   "start": 522.03,
   "end": 523.33,
   "text": "ולא שבו ריקם."
  }
 ]
}