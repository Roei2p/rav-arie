{
 "disc": "31ר- בת של מלך",
 "track": "Track04",
 "duration": 711.216,
 "segments": [
  {
   "start": 0.0,
   "end": 29.15,
   "text": "הם תפסו אותה."
  },
  {
   "start": 30.67,
   "end": 33.11,
   "text": "נערה צעירה, נערה יהודייה,"
  },
  {
   "start": 35.42,
   "end": 36.18,
   "text": "האינקוויזיציה."
  },
  {
   "start": 37.9,
   "end": 38.5,
   "text": "רק השם הזה"
  },
  {
   "start": 40.71,
   "end": 44.21,
   "text": "עורר אימה וחלחלה במשך שנים רבות."
  },
  {
   "start": 45.39,
   "end": 45.89,
   "text": "זה היה בספרד,"
  },
  {
   "start": 47.87,
   "end": 49.89,
   "text": "רצח ועינויים של המוני יהודים"
  },
  {
   "start": 50.91,
   "end": 51.57,
   "text": "בשם הנצרות."
  },
  {
   "start": 53.85,
   "end": 55.11,
   "text": "הם תפסו אותה, נערה יהודייה,"
  },
  {
   "start": 57.71,
   "end": 58.41,
   "text": "והיא נשפטה"
  },
  {
   "start": 59.17,
   "end": 60.65,
   "text": "על ידי כמרי האינקוויזיציה"
  },
  {
   "start": 61.71,
   "end": 62.55,
   "text": "להמרת דת."
  },
  {
   "start": 63.53,
   "end": 64.83,
   "text": "את תהיי חייבת להמיר את הדת שלך."
  },
  {
   "start": 66.85,
   "end": 67.55,
   "text": "את תהיי גויה כמונו."
  },
  {
   "start": 74.41,
   "end": 75.35,
   "text": "והיא ידעה מה זה גויה."
  },
  {
   "start": 76.67,
   "end": 78.17,
   "text": "גויה זה מלשון גוויה."
  },
  {
   "start": 80.15,
   "end": 80.39,
   "text": "גוף."
  },
  {
   "start": 82.76,
   "end": 86.36,
   "text": "ואישה יהודיה זה לא גוף וזה נשמה."
  },
  {
   "start": 87.94,
   "end": 89.36,
   "text": "אז היא אמרה, נולדתי יהודיה."
  },
  {
   "start": 89.94,
   "end": 91.96,
   "text": "נולדתי יהודיה ואני אמות יהודיה."
  },
  {
   "start": 92.58,
   "end": 93.66,
   "text": "כך היא קראה באומץ."
  },
  {
   "start": 95.44,
   "end": 98.56,
   "text": "הכמרים הרשעים והאכזריים ניסו להסביר לה"
  },
  {
   "start": 99.54,
   "end": 100.98,
   "text": "בהתחלה בנועם, בעדינות,"
  },
  {
   "start": 102.7,
   "end": 103.8,
   "text": "בעדינות מעושה."
  },
  {
   "start": 104.68,
   "end": 105.6,
   "text": "כמה כדאי לה,"
  },
  {
   "start": 106.42,
   "end": 107.04,
   "text": "כדאי לך."
  },
  {
   "start": 108.96,
   "end": 110.0,
   "text": "החיים לפנייך."
  },
  {
   "start": 111.44,
   "end": 114.48,
   "text": "תראה איזה יופי צפון לך, חבל לך."
  },
  {
   "start": 114.9,
   "end": 116.04,
   "text": "אנחנו רוצים את הטובה שלך."
  },
  {
   "start": 117.98,
   "end": 120.14,
   "text": "אבל משנוכחו שאותה נערה צעירה,"
  },
  {
   "start": 120.72,
   "end": 121.98,
   "text": "היא הייתה איתנה בדעתה."
  },
  {
   "start": 122.84,
   "end": 124.44,
   "text": "זה לא עניין אותה, היא לא ראתה כלום."
  },
  {
   "start": 124.98,
   "end": 126.9,
   "text": "היא ראתה רק את הקדוש ברוך הוא מול העיניים."
  },
  {
   "start": 127.44,
   "end": 129.38,
   "text": "אמרה להם, אני יהודייה ולא יעזור לכם כלום."
  },
  {
   "start": 133.3,
   "end": 136.06,
   "text": "ואז זעם התחיל להיראות בעיניהם."
  },
  {
   "start": 137.98,
   "end": 139.24,
   "text": "הם אמרו לה, תשלמי ביוקר."
  },
  {
   "start": 140.76,
   "end": 143.14,
   "text": "את תשלמי ביוקר, את שומעת את זה? כדאי לך להתחרט."
  },
  {
   "start": 144.92,
   "end": 146.48,
   "text": "אבל היא, היא הייתה נחושה בדעתה."
  },
  {
   "start": 148.14,
   "end": 148.94,
   "text": "היא נשאה עימה"
  },
  {
   "start": 149.62,
   "end": 150.78,
   "text": "כוח של שנים."
  },
  {
   "start": 152.12,
   "end": 152.84,
   "text": "את הכוח של שרה,"
  },
  {
   "start": 155.56,
   "end": 157.88,
   "text": "רבקה, רחל, לאה,"
  },
  {
   "start": 160.15,
   "end": 161.47,
   "text": "כוח שאי אפשר לשבור אותו."
  },
  {
   "start": 164.67,
   "end": 167.51,
   "text": "הם נותרו חסרי אונים, הם הרגישו שהם חייבים לעשות משהו."
  },
  {
   "start": 170.01,
   "end": 170.47,
   "text": "אז הם החליטו,"
  },
  {
   "start": 171.37,
   "end": 174.97,
   "text": "אנחנו נשפוט אותך, נדאג לך למשפט ראווה לפני כולם."
  },
  {
   "start": 175.83,
   "end": 177.57,
   "text": "והם אמרו והם עשו."
  },
  {
   "start": 178.85,
   "end": 181.21,
   "text": "אותה נערה נשפטה בבית דין של האינקוויזיציה."
  },
  {
   "start": 183.41,
   "end": 185.01,
   "text": "פסק דינה היה זוועתי,"
  },
  {
   "start": 187.27,
   "end": 187.95,
   "text": "לא אנושי."
  },
  {
   "start": 189.41,
   "end": 191.37,
   "text": "שופטי האינקוויזיציה קמו על רגליהם ואמרו,"
  },
  {
   "start": 192.03,
   "end": 193.99,
   "text": "אם הנאשמת הזו לא תמיר את דתה,"
  },
  {
   "start": 195.33,
   "end": 195.93,
   "text": "היא תמות"
  },
  {
   "start": 196.73,
   "end": 199.03,
   "text": "תוך כדי שהיא נקשרת בשערותיה לזנב סוס."
  },
  {
   "start": 201.63,
   "end": 205.05,
   "text": "והסוס ידהר לו בכל רחבי ספרד,"
  },
  {
   "start": 205.83,
   "end": 212.25,
   "text": "וכולם יראו מה קורה לנערה שלא מוכנה להיכנע לאינקוויזיציה."
  },
  {
   "start": 216.82,
   "end": 217.68,
   "text": "היא לא הנידה עפעף,"
  },
  {
   "start": 219.54,
   "end": 220.16,
   "text": "אבל האמת,"
  },
  {
   "start": 222.71,
   "end": 224.01,
   "text": "היא רעדה מבפנים,"
  },
  {
   "start": 224.85,
   "end": 226.35,
   "text": "רעדה כמו עלה נידב ברוח."
  },
  {
   "start": 227.69,
   "end": 228.61,
   "text": "היא כל כך רצתה לבכות,"
  },
  {
   "start": 231.77,
   "end": 233.85,
   "text": "כל כך פחדה,"
  },
  {
   "start": 234.65,
   "end": 236.95,
   "text": "אבל היא לא רצתה להראות לאף אחד,"
  },
  {
   "start": 237.65,
   "end": 238.31,
   "text": "בטח לא להם,"
  },
  {
   "start": 244.31,
   "end": 245.17,
   "text": "וכך לקחו אותה"
  },
  {
   "start": 246.27,
   "end": 247.05,
   "text": "מבית המשפט,"
  },
  {
   "start": 248.07,
   "end": 249.05,
   "text": "אל תא נידונים למוות."
  },
  {
   "start": 251.56,
   "end": 252.14,
   "text": "אל התא שלה."
  },
  {
   "start": 253.94,
   "end": 255.02,
   "text": "שעות מספר אחר כך"
  },
  {
   "start": 256.0,
   "end": 257.18,
   "text": "הכניסו ידידה,"
  },
  {
   "start": 258.2,
   "end": 259.42,
   "text": "נערה צעירה בגיל שלה,"
  },
  {
   "start": 260.8,
   "end": 262.16,
   "text": "שהתחילה לדבר על הלב שלה,"
  },
  {
   "start": 263.0,
   "end": 264.44,
   "text": "לנסות לשכנע אותה, תשמעי,"
  },
  {
   "start": 265.02,
   "end": 265.62,
   "text": "חבל לך,"
  },
  {
   "start": 266.36,
   "end": 266.88,
   "text": "גם אני,"
  },
  {
   "start": 268.28,
   "end": 272.18,
   "text": "גם אני, אם הייתי עומד במקומך, אולי היה קצת קשה לי, אבל אין ברירה."
  },
  {
   "start": 274.73,
   "end": 275.43,
   "text": "צריכים לחיות."
  },
  {
   "start": 276.23,
   "end": 276.81,
   "text": "זה לא נורא."
  },
  {
   "start": 278.13,
   "end": 279.59,
   "text": "בסך הכל, מה מבקשים ממך?"
  },
  {
   "start": 282.71,
   "end": 284.67,
   "text": "בסך הכל, אם תבדקי, בואי, תבדקי, תראי."
  },
  {
   "start": 286.27,
   "end": 288.67,
   "text": "להיות נוצרייה אולי זה לא רע. תראי איך לנו חיות טוב."
  },
  {
   "start": 290.01,
   "end": 290.83,
   "text": "תראי איך טוב לנו."
  },
  {
   "start": 292.41,
   "end": 293.95,
   "text": "אבל הנערה נשארת איתנה בדעתה."
  },
  {
   "start": 295.43,
   "end": 296.65,
   "text": "תראי, עוד לא הקמת בית."
  },
  {
   "start": 297.45,
   "end": 298.95,
   "text": "עוד כל החיים לפנייך."
  },
  {
   "start": 298.95,
   "end": 302.8,
   "text": "אבל היא לא מוכנה לשמוע."
  },
  {
   "start": 308.43,
   "end": 309.65,
   "text": "זמן קצר אחר כך"
  },
  {
   "start": 311.51,
   "end": 312.51,
   "text": "נכנס לתא שלה"
  },
  {
   "start": 319.92,
   "end": 321.52,
   "text": "אחד משופטי האינקוויזיציה,"
  },
  {
   "start": 322.46,
   "end": 323.5,
   "text": "שכמה שהוא היה אכזרי,"
  },
  {
   "start": 325.24,
   "end": 326.86,
   "text": "כמה שהלב שלו היה עטום,"
  },
  {
   "start": 327.56,
   "end": 332.02,
   "text": "הוא התפעל כשהוא ראה את העמידה האיתנה הזאת של בת ישראל קדושה."
  },
  {
   "start": 332.98,
   "end": 335.76,
   "text": "אז הוא נכנס גם הוא, לתת לה צ'אנס אחרון."
  },
  {
   "start": 337.76,
   "end": 338.9,
   "text": "אבל היא סובבה את הפנים,"
  },
  {
   "start": 339.52,
   "end": 343.6,
   "text": "לא הייתה מוכנה להסתכל עליו בפנים של אותו רשע, לא הייתה מוכנה להעיף מבט אפילו."
  },
  {
   "start": 346.14,
   "end": 347.4,
   "text": "והוא יצא כלעומת שבה."
  },
  {
   "start": 349.0,
   "end": 349.3,
   "text": "ואז,"
  },
  {
   "start": 349.96,
   "end": 350.9,
   "text": "כשהיא נותרה לבדה,"
  },
  {
   "start": 353.05,
   "end": 354.99,
   "text": "היא הרשתה לעצמה סוף סוף לבכות."
  },
  {
   "start": 356.61,
   "end": 357.01,
   "text": "לבכות."
  },
  {
   "start": 358.47,
   "end": 359.89,
   "text": "להתקפל בפינת התא."
  },
  {
   "start": 361.29,
   "end": 362.43,
   "text": "לרעוד מפחד."
  },
  {
   "start": 363.33,
   "end": 363.95,
   "text": "ולבכות."
  },
  {
   "start": 365.29,
   "end": 366.17,
   "text": "ולמלמל."
  },
  {
   "start": 367.13,
   "end": 368.95,
   "text": "תפילה להשם יתברך שייתן לה כוח."
  },
  {
   "start": 370.19,
   "end": 370.91,
   "text": "ולבכות."
  },
  {
   "start": 372.71,
   "end": 375.97,
   "text": "נערה יהודייה צעירה ומפוחדת,"
  },
  {
   "start": 377.27,
   "end": 386.85,
   "text": "לוחמת אמיצה שמרשה לעצמה לפחד ככה לחלחל במורד גבה."
  },
  {
   "start": 387.55,
   "end": 388.39,
   "text": "כך היא נשכבה עד"
  },
  {
   "start": 389.17,
   "end": 391.37,
   "text": "שבשעות הקטנות של הלילה היא נרדמה,"
  },
  {
   "start": 392.23,
   "end": 392.77,
   "text": "מותשת כולה."
  },
  {
   "start": 410.69,
   "end": 412.43,
   "text": "מועד ביצוע גזר הדין הגיע."
  },
  {
   "start": 421.66,
   "end": 424.52,
   "text": "המוציא לפועל, התליין של האינפוזיציה, פונה אליה."
  },
  {
   "start": 425.38,
   "end": 426.04,
   "text": "לפני כולם."
  },
  {
   "start": 426.04,
   "end": 432.0,
   "text": "לפני מאות אנשים שהתאספו להם בכיכר המרכזי בקורדובה"
  },
  {
   "start": 435.78,
   "end": 437.38,
   "text": "האם את מוכנה להמיר את דתך?"
  },
  {
   "start": 441.19,
   "end": 442.59,
   "text": "והיא ענתה בשלילה מוחלטת"
  },
  {
   "start": 444.49,
   "end": 446.41,
   "text": "ואז היא נקשרה אל זנב הסוס"
  },
  {
   "start": 447.47,
   "end": 449.17,
   "text": "אבל רגע, היא אמרה, עצרו,"
  },
  {
   "start": 449.87,
   "end": 450.81,
   "text": "יש לי בקשה אחרונה"
  },
  {
   "start": 455.9,
   "end": 456.8,
   "text": "אמרו לה, מה הבקשה האחרונה?"
  },
  {
   "start": 458.1,
   "end": 459.08,
   "text": "מה את רוצה, אוכל?"
  },
  {
   "start": 459.64,
   "end": 460.54,
   "text": "אמרה להם, לא,"
  },
  {
   "start": 461.36,
   "end": 465.6,
   "text": "אני מבקשת שיקשרו את השמלה שלי שלא תיקרע"
  },
  {
   "start": 466.7,
   "end": 470.66,
   "text": "אני רוצה לשמור על הצניעות שלי, כל כפודה של בת מלך פנימה."
  },
  {
   "start": 471.9,
   "end": 475.82,
   "text": "ואותם רשעים אכזריים לא יכלו לסרב לבקשה האחרונה,"
  },
  {
   "start": 476.86,
   "end": 479.3,
   "text": "אבל הם לא יכלו להימנע מאכזריות."
  },
  {
   "start": 480.1,
   "end": 481.2,
   "text": "הם לקחו את המחטים"
  },
  {
   "start": 481.76,
   "end": 483.7,
   "text": "וחיברו את השמלה שלה"
  },
  {
   "start": 484.32,
   "end": 487.46,
   "text": "באמצעות סיכות חדות אל הבשר."
  },
  {
   "start": 489.2,
   "end": 491.6,
   "text": "והסיכות החדות פצעו לה את הבשר."
  },
  {
   "start": 492.78,
   "end": 494.12,
   "text": "היא חרקה שיניים,"
  },
  {
   "start": 496.26,
   "end": 497.14,
   "text": "היא בכתה,"
  },
  {
   "start": 498.34,
   "end": 502.16,
   "text": "אבל לא עצרה אותם."
  },
  {
   "start": 507.69,
   "end": 507.95,
   "text": "וככה,"
  },
  {
   "start": 508.93,
   "end": 510.91,
   "text": "בשמלה ספוגה מדם,"
  },
  {
   "start": 512.31,
   "end": 513.65,
   "text": "מדם של צניעות,"
  },
  {
   "start": 514.49,
   "end": 516.45,
   "text": "מדם קדוש של בת ישראל."
  },
  {
   "start": 517.65,
   "end": 518.41,
   "text": "כל הציבור,"
  },
  {
   "start": 519.03,
   "end": 520.99,
   "text": "כל הגויים, כל הגויות שהיו שם,"
  },
  {
   "start": 523.34,
   "end": 524.42,
   "text": "היו המומים,"
  },
  {
   "start": 525.14,
   "end": 526.06,
   "text": "נדהמים,"
  },
  {
   "start": 529.76,
   "end": 532.84,
   "text": "ואז היא נקשרה לה בשערות שלה לסוס."
  },
  {
   "start": 535.18,
   "end": 540.76,
   "text": "והסוס החל לדהור,"
  },
  {
   "start": 540.76,
   "end": 544.84,
   "text": "וזעקה של שמע ישראל,"
  },
  {
   "start": 545.54,
   "end": 547.34,
   "text": "אדוני אלוהינו,"
  },
  {
   "start": 547.96,
   "end": 549.46,
   "text": "אדוני אחד,"
  },
  {
   "start": 550.32,
   "end": 552.6,
   "text": "נשמעה בכיכר של קורדובה,"
  },
  {
   "start": 553.28,
   "end": 554.84,
   "text": "מרטיטה את הלבבות,"
  },
  {
   "start": 555.48,
   "end": 557.4,
   "text": "פותחת את שערי השמיים,"
  },
  {
   "start": 558.48,
   "end": 561.56,
   "text": "גורמת לפמליה של מעלה להוריד דמעות."
  },
  {
   "start": 566.0,
   "end": 568.52,
   "text": "לא עברו כמה מטרים ולפתע הרים היד."
  },
  {
   "start": 569.1,
   "end": 569.9,
   "text": "עצור!"
  },
  {
   "start": 570.8,
   "end": 573.1,
   "text": "נשמעה צעקה שלה בקול רווי כאב."
  },
  {
   "start": 574.36,
   "end": 575.76,
   "text": "כולם היו בטוחים שהיא נשברה,"
  },
  {
   "start": 576.78,
   "end": 577.86,
   "text": "סימנו והסוס עצר,"
  },
  {
   "start": 578.8,
   "end": 579.72,
   "text": "עצרו את הסוס."
  },
  {
   "start": 581.12,
   "end": 581.54,
   "text": "אבל אז,"
  },
  {
   "start": 583.32,
   "end": 584.84,
   "text": "כולם חשבו שהיא נשברה,"
  },
  {
   "start": 586.6,
   "end": 590.72,
   "text": "שאומנם היא פצועה, אבל היא הבינה די, היא מוכנה להמיר את הדת שלה."
  },
  {
   "start": 592.08,
   "end": 593.14,
   "text": "אבל אז, למרבה,"
  },
  {
   "start": 593.98,
   "end": 595.26,
   "text": "למרבה התדהמה,"
  },
  {
   "start": 596.78,
   "end": 597.3,
   "text": "התברר"
  },
  {
   "start": 598.0,
   "end": 602.62,
   "text": "פשוט שהסמלה שלה בחלק מהגוף יצאה."
  },
  {
   "start": 603.62,
   "end": 606.48,
   "text": "ראו אותה איך היא לוקחת מרימת היד שלה, יד רועדת,"
  },
  {
   "start": 607.14,
   "end": 611.92,
   "text": "וביד רועדת היא מחברת את הסיכה לגוף החבול ולשמלה שלה."
  },
  {
   "start": 613.72,
   "end": 614.82,
   "text": "האות ניתן,"
  },
  {
   "start": 616.2,
   "end": 617.14,
   "text": "הסוס דהר,"
  },
  {
   "start": 618.54,
   "end": 619.32,
   "text": "אבל כולם ידעו."
  },
  {
   "start": 621.4,
   "end": 624.36,
   "text": "הנשמה עלתה בטיסה"
  },
  {
   "start": 626.53,
   "end": 627.73,
   "text": "אל מרומי שמיים."
  },
  {
   "start": 629.91,
   "end": 631.65,
   "text": "בת ישראל מסרה נפש,"
  },
  {
   "start": 632.25,
   "end": 634.29,
   "text": "ומזבח בשמיים הוריד מעות."
  },
  {
   "start": 635.25,
   "end": 638.79,
   "text": "יש מזבח בשמיים לכל אלה שמקדשי שם שמיים."
  },
  {
   "start": 639.63,
   "end": 643.21,
   "text": "ועל המזבח הזה עומד מיכאל, שרו של ישראל."
  },
  {
   "start": 644.35,
   "end": 645.21,
   "text": "ואת כל הנשמות,"
  },
  {
   "start": 645.61,
   "end": 650.55,
   "text": "את כל קידוש השם שבין ישראל, בת ישראל, עושים מעלה קירח ניחוח לפני כיסא הכבוד."
  },
  {
   "start": 652.65,
   "end": 655.07,
   "text": "אותה בת ישראל קידשה שם שמיים,"
  },
  {
   "start": 655.95,
   "end": 657.23,
   "text": "ניצחה את האינקוויזיציה,"
  },
  {
   "start": 658.45,
   "end": 659.55,
   "text": "ניצחה את הגויים."
  },
  {
   "start": 663.93,
   "end": 667.95,
   "text": "אותה בת ישראל במותה מצווה לנו איך לחיות,"
  },
  {
   "start": 668.85,
   "end": 671.87,
   "text": "מצווה לבנות ישראל על מה לתת את הדגש."
  },
  {
   "start": 673.41,
   "end": 674.93,
   "text": "נותנת לבנות ישראל,"
  },
  {
   "start": 675.67,
   "end": 678.99,
   "text": "נותנת לנו, לכולנו, לכל עם ישראל, הסתכלות חדשה."
  },
  {
   "start": 681.82,
   "end": 684.98,
   "text": "איזה דרגות שפלות יכול אדם להגיע כמו אינקוויזיציה,"
  },
  {
   "start": 685.7,
   "end": 687.24,
   "text": "ואיזה דרגות גבוהות"
  },
  {
   "start": 688.32,
   "end": 689.4,
   "text": "של רוחניות,"
  },
  {
   "start": 691.28,
   "end": 692.38,
   "text": "של איכות,"
  },
  {
   "start": 695.05,
   "end": 699.61,
   "text": "יכולה להגיע בת ישראל."
  }
 ]
}