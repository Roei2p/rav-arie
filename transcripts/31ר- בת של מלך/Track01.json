{
 "disc": "31ר- בת של מלך",
 "track": "Track01",
 "duration": 837.168,
 "segments": [
  {
   "start": 14.94,
   "end": 15.82,
   "text": "אמר רבי יוסה."
  },
  {
   "start": 17.8,
   "end": 20.68,
   "text": "אמר רבי יוסה, מעולם לא קראתי לאשתי אשתי,"
  },
  {
   "start": 23.78,
   "end": 25.62,
   "text": "אלא קראתי לאשתי ביתי."
  },
  {
   "start": 26.66,
   "end": 28.54,
   "text": "כך אומרת הגמרא במסכת שבת."
  },
  {
   "start": 30.2,
   "end": 32.36,
   "text": "הגמרא רוצה ללמד אותנו."
  },
  {
   "start": 32.84,
   "end": 38.16,
   "text": "רבי יוסה רצה לומר לנו מהו שם המהות של אשתו,"
  },
  {
   "start": 38.72,
   "end": 40.48,
   "text": "מהו שם המהות של האישה."
  },
  {
   "start": 40.94,
   "end": 42.28,
   "text": "האישה כולה זה הבית."
  },
  {
   "start": 43.68,
   "end": 44.82,
   "text": "זה הלב של הבית."
  },
  {
   "start": 45.78,
   "end": 47.04,
   "text": "זו האווירה של הבית."
  },
  {
   "start": 48.48,
   "end": 50.28,
   "text": "זה האור של הבית, זו האישה."
  },
  {
   "start": 53.52,
   "end": 55.54,
   "text": "הרב זילברשטיין, פעם שאל את הרב אליושיב."
  },
  {
   "start": 56.56,
   "end": 58.32,
   "text": "אמר, כבוד הרב, תגידי, למה אישה"
  },
  {
   "start": 60.1,
   "end": 61.32,
   "text": "נמשלה לדבש?"
  },
  {
   "start": 62.0,
   "end": 63.56,
   "text": "אישה בגמטריה זה דבש,"
  },
  {
   "start": 64.34,
   "end": 65.02,
   "text": "מניין דבש."
  },
  {
   "start": 65.76,
   "end": 66.06,
   "text": "למה?"
  },
  {
   "start": 68.31,
   "end": 69.55,
   "text": "אמר הרב אליושיב,"
  },
  {
   "start": 72.0,
   "end": 72.68,
   "text": "שכידוע,"
  },
  {
   "start": 73.22,
   "end": 75.04,
   "text": "דבורה כשהיא מפרישה דבש,"
  },
  {
   "start": 76.4,
   "end": 79.92,
   "text": "אז למעשה יש דבורות שהרגליים שלהן נשארות בתוך הדבש."
  },
  {
   "start": 83.72,
   "end": 85.72,
   "text": "והרי הדבורה היא חיה,"
  },
  {
   "start": 88.13,
   "end": 90.11,
   "text": "היא שרץ טמא למעשה, היא טמאה."
  },
  {
   "start": 92.23,
   "end": 93.41,
   "text": "והדבש הוא טהור,"
  },
  {
   "start": 94.19,
   "end": 95.11,
   "text": "אפשר לאכול אותו."
  },
  {
   "start": 96.39,
   "end": 98.91,
   "text": "אז אם הרגליים של הדבורה בתוך הדבש,"
  },
  {
   "start": 99.79,
   "end": 101.75,
   "text": "אז לדבש היה צריך להיות טמא איך הוא טהור."
  },
  {
   "start": 105.38,
   "end": 106.44,
   "text": "אלא אומר הראש,"
  },
  {
   "start": 108.67,
   "end": 109.71,
   "text": "יש תכונה מיוחדת לדבש."
  },
  {
   "start": 110.95,
   "end": 111.41,
   "text": "הדבש,"
  },
  {
   "start": 112.03,
   "end": 114.25,
   "text": "כשהוא מקבל אליו את הרגליים של הדבורה,"
  },
  {
   "start": 115.71,
   "end": 116.87,
   "text": "את החלק הטמא הזה,"
  },
  {
   "start": 117.57,
   "end": 118.25,
   "text": "הוא מעכל אותו,"
  },
  {
   "start": 118.95,
   "end": 122.73,
   "text": "הוא הופך אותו לדבש, לחלק מהדבש."
  },
  {
   "start": 123.81,
   "end": 126.67,
   "text": "זה כבר לא נהיה רגליים, הם נהפכים לדבש."
  },
  {
   "start": 127.95,
   "end": 130.47,
   "text": "הדבש יש לו תכונה כזאת שהוא מספח,"
  },
  {
   "start": 130.97,
   "end": 134.91,
   "text": "הוא גורם לחומר הטמא שנכנס אליו להפך לדבש, לטהור."
  },
  {
   "start": 136.27,
   "end": 138.69,
   "text": "אמר הרב אלישיב, ככה גם אישה."
  },
  {
   "start": 139.77,
   "end": 141.07,
   "text": "אישה יש לה את הכוח"
  },
  {
   "start": 141.99,
   "end": 143.09,
   "text": "לקחת דבר"
  },
  {
   "start": 143.97,
   "end": 146.21,
   "text": "לא טוב ולהפוך אותו לטוב."
  },
  {
   "start": 146.41,
   "end": 146.91,
   "text": "טוב."
  },
  {
   "start": 147.61,
   "end": 150.01,
   "text": "אם יש אווירה בבית שלילית לא טובה,"
  },
  {
   "start": 150.93,
   "end": 151.71,
   "text": "דווקא האישה"
  },
  {
   "start": 152.33,
   "end": 156.79,
   "text": "בידיך הכוח להפוך את האווירה הזאת לאווירה חיובית."
  },
  {
   "start": 159.72,
   "end": 163.78,
   "text": "דווקא האישה יש לה את הכוח לקחת יצור אנושי, ילד,"
  },
  {
   "start": 164.24,
   "end": 164.94,
   "text": "ילדה,"
  },
  {
   "start": 165.68,
   "end": 171.3,
   "text": "ולעצב אותם, ולהפוך אותם לחלק אלוקה ממעל,"
  },
  {
   "start": 172.82,
   "end": 174.54,
   "text": "לאדם נפלא."
  },
  {
   "start": 180.08,
   "end": 183.22,
   "text": "לכן עכשיו נבין שהגמרא, כשהגמרא סיפרה,"
  },
  {
   "start": 183.56,
   "end": 187.04,
   "text": "הגמרא אמרה לנו על איש ואישה זוג שהיו נשואים,"
  },
  {
   "start": 187.48,
   "end": 189.1,
   "text": "שניהם ירא שמיים בתכלית."
  },
  {
   "start": 190.34,
   "end": 192.22,
   "text": "ואחרי עשר שנים לא נולדו להם ילדים,"
  },
  {
   "start": 193.46,
   "end": 196.18,
   "text": "והבעל החליט שהוא רוצה להתגרש, הוא רוצה ילדים."
  },
  {
   "start": 198.97,
   "end": 201.51,
   "text": "אז אומנם בצער, אבל בלית ברירה מבחינתו התגרשו."
  },
  {
   "start": 203.98,
   "end": 207.26,
   "text": "והוא נשא, אומרת הגמרא, אישה לא כל כך טובה,"
  },
  {
   "start": 207.88,
   "end": 208.88,
   "text": "לא כל כך הגונה."
  },
  {
   "start": 211.44,
   "end": 212.52,
   "text": "שנה ועוד שנה"
  },
  {
   "start": 213.5,
   "end": 215.42,
   "text": "עברו להם השנים, אבל לבסוף"
  },
  {
   "start": 216.22,
   "end": 218.48,
   "text": "הוא הלך בעקבות אשתו והתקלקל,"
  },
  {
   "start": 219.16,
   "end": 220.42,
   "text": "ונהיה אדם לא הגון."
  },
  {
   "start": 222.34,
   "end": 223.22,
   "text": "ואותה אישה,"
  },
  {
   "start": 224.02,
   "end": 225.22,
   "text": "זאת שהוא התגרש ממנה,"
  },
  {
   "start": 227.02,
   "end": 229.7,
   "text": "היא התחתנה עם אדם לא הגון."
  },
  {
   "start": 231.12,
   "end": 232.62,
   "text": "אדם מידות רעות,"
  },
  {
   "start": 234.48,
   "end": 235.14,
   "text": "רע לב,"
  },
  {
   "start": 237.44,
   "end": 238.2,
   "text": "אבל היא ידעה איך"
  },
  {
   "start": 239.02,
   "end": 241.72,
   "text": "זה הכוח של האישה להפוך אותו לטוב."
  },
  {
   "start": 242.58,
   "end": 243.56,
   "text": "שנה ועוד שנה,"
  },
  {
   "start": 244.2,
   "end": 246.84,
   "text": "ולבסוף אותו גבר נהפך"
  },
  {
   "start": 247.94,
   "end": 249.16,
   "text": "לנופת סופים,"
  },
  {
   "start": 250.02,
   "end": 252.36,
   "text": "לאדם טוב, לירא שמיים."
  },
  {
   "start": 253.76,
   "end": 255.18,
   "text": "אמרו חזל הקדושים,"
  },
  {
   "start": 255.74,
   "end": 260.86,
   "text": "מכאן תלמד שהכל מהאישה. איזה כוח עצום יש לאישה."
  },
  {
   "start": 265.09,
   "end": 268.89,
   "text": "איזה כוח עצום יש לאישה, במיוחד בעולם שלנו."
  },
  {
   "start": 269.53,
   "end": 273.23,
   "text": "במיוחד בעולם הכאוב שלנו היום,"
  },
  {
   "start": 273.67,
   "end": 276.35,
   "text": "עולם שמאופיין בהרבה הרבה בדידות,"
  },
  {
   "start": 276.99,
   "end": 278.25,
   "text": "בהרבה הרבה משברים."
  },
  {
   "start": 278.95,
   "end": 280.63,
   "text": "על זה עוד נאמר בתורה הקדושה,"
  },
  {
   "start": 281.43,
   "end": 285.99,
   "text": "עוד יש ברכה שניתנה לעם ישראל הקדושים."
  },
  {
   "start": 287.09,
   "end": 288.37,
   "text": "יפת אלוקים ליפת"
  },
  {
   "start": 288.93,
   "end": 290.19,
   "text": "וישכון באוהלי שם."
  },
  {
   "start": 290.73,
   "end": 296.51,
   "text": "לנוח אחרי המבול נולדו שלושה בנים ומהם התחיל העולם החדש."
  },
  {
   "start": 298.15,
   "end": 301.03,
   "text": "בן אחד נידון לעבדות, להיות בקשיים,"
  },
  {
   "start": 302.51,
   "end": 303.55,
   "text": "בן שני יפת."
  },
  {
   "start": 304.25,
   "end": 305.69,
   "text": "יפת מלשון יופי."
  },
  {
   "start": 306.69,
   "end": 308.29,
   "text": "כל העמים, סקנדינביה, אירופה,"
  },
  {
   "start": 309.09,
   "end": 310.07,
   "text": "ארצות הברית, יופי,"
  },
  {
   "start": 310.83,
   "end": 313.41,
   "text": "נוצץ, כסף, אפשרויות נראה."
  },
  {
   "start": 314.71,
   "end": 318.01,
   "text": "בורא העולם אומר, יפתא אלוקים ליפת, אני אתן לו להיות יפה."
  },
  {
   "start": 318.57,
   "end": 321.01,
   "text": "לבנים שלו הם יהיו יפה, ייראה הכל טוב זוהר."
  },
  {
   "start": 322.11,
   "end": 325.99,
   "text": "אבל אם אתה רוצה להיות פנים, אם אתה רוצה למצוא רוחניות,"
  },
  {
   "start": 326.63,
   "end": 328.37,
   "text": "וישכון באוהלי שם."
  },
  {
   "start": 329.01,
   "end": 331.97,
   "text": "אצל שם, אצל בני שם, אצל עם ישראל,"
  },
  {
   "start": 332.43,
   "end": 334.23,
   "text": "אולי יש אוהלים, אולי יש פשטות."
  },
  {
   "start": 334.73,
   "end": 337.53,
   "text": "אבל בפשטות הזאת יש חום."
  },
  {
   "start": 338.41,
   "end": 341.47,
   "text": "בפשטות הזה בורא העולם אומר, אני נמצא, אני, אני נמצא."
  },
  {
   "start": 343.79,
   "end": 344.29,
   "text": "אני נמצא."
  },
  {
   "start": 347.5,
   "end": 349.08,
   "text": "היה אחד אבא, אחד שלו, שתי בנות."
  },
  {
   "start": 350.2,
   "end": 352.2,
   "text": "אחת נישאה לעשיר, אחד נישאה לעני."
  },
  {
   "start": 354.0,
   "end": 357.1,
   "text": "זאת שנישאה לעשיר, שהרחוק מתורה ומצוות,"
  },
  {
   "start": 357.76,
   "end": 361.76,
   "text": "לא היה אכפת לה, לא בנתה בית, היא ישבה וחיה את החיים שלה, נהנתה כמה שיותר."
  },
  {
   "start": 365.0,
   "end": 367.1,
   "text": "שעבה כמה שיכולה יותר מהעולם הזה."
  },
  {
   "start": 368.04,
   "end": 374.24,
   "text": "והצעירה שהתחתנה עם אברך עני אולי חיה בתנאי דוחק, אבל היא בנתה בית."
  },
  {
   "start": 375.4,
   "end": 376.6,
   "text": "ילדים, שמחה,"
  },
  {
   "start": 377.42,
   "end": 383.29,
   "text": "אחדות, אז אין הרבה מה לאכול בפה,"
  },
  {
   "start": 383.97,
   "end": 385.31,
   "text": "אבל יש הרבה מה בלב."
  },
  {
   "start": 388.92,
   "end": 391.3,
   "text": "אז אין איזו דירה מפוארת עם כמה מפלסים,"
  },
  {
   "start": 392.58,
   "end": 394.76,
   "text": "אבל בחדרים בלב יש הרבה מקום."
  },
  {
   "start": 397.39,
   "end": 398.19,
   "text": "עברו שנים,"
  },
  {
   "start": 399.17,
   "end": 399.87,
   "text": "ואותו אבא,"
  },
  {
   "start": 400.33,
   "end": 404.19,
   "text": "שכל השנים התפעל והתפאר בבת שלו הבכירה,"
  },
  {
   "start": 404.87,
   "end": 406.09,
   "text": "בבת זאת עם העשיר,"
  },
  {
   "start": 407.33,
   "end": 410.35,
   "text": "כל כך היה שמח וגאה ומתבייש באותה בת"
  },
  {
   "start": 410.97,
   "end": 411.51,
   "text": "ענייה"
  },
  {
   "start": 413.93,
   "end": 415.41,
   "text": "עם משפחה ברוכת ילדים."
  },
  {
   "start": 416.25,
   "end": 418.09,
   "text": "עברו שנים ואותו אבא הזדקן"
  },
  {
   "start": 419.03,
   "end": 420.13,
   "text": "והיה זקוק לסיוע."
  },
  {
   "start": 421.53,
   "end": 424.65,
   "text": "אז הוא עבר לאותו בת אהובה שכל כך היה גאה בה,"
  },
  {
   "start": 426.59,
   "end": 427.99,
   "text": "לביתו הבכירה העשירה,"
  },
  {
   "start": 432.08,
   "end": 432.78,
   "text": "אבל אותו אבא"
  },
  {
   "start": 434.04,
   "end": 435.54,
   "text": "למד על הבשר שלו."
  },
  {
   "start": 436.86,
   "end": 439.5,
   "text": "על הבשר שלו הוא חווה מה זה קרירות,"
  },
  {
   "start": 441.16,
   "end": 441.66,
   "text": "מה זה השפלות,"
  },
  {
   "start": 444.3,
   "end": 445.14,
   "text": "מה זו בדידות,"
  },
  {
   "start": 446.32,
   "end": 449.8,
   "text": "מה זה כשכל אחד דואג לעסקים שלו, רק אני, אני, אני, הכל אני,"
  },
  {
   "start": 450.22,
   "end": 451.34,
   "text": "כל העולם זה אני,"
  },
  {
   "start": 451.76,
   "end": 453.46,
   "text": "אני מרכז העולם, וזהו,"
  },
  {
   "start": 453.96,
   "end": 455.22,
   "text": "לא אכפת לי מכלום."
  },
  {
   "start": 455.96,
   "end": 456.74,
   "text": "כי אתה צריך לדעת,"
  },
  {
   "start": 457.52,
   "end": 458.22,
   "text": "כשאדם,"
  },
  {
   "start": 458.82,
   "end": 463.76,
   "text": "כשאדם יוצא מהמעגל של השם יתברך, מלהיות עבד השם,"
  },
  {
   "start": 464.1,
   "end": 466.52,
   "text": "הוא מפתח, אז הוא נהיה, זה האני."
  },
  {
   "start": 467.5,
   "end": 469.38,
   "text": "וכשאני, אני לא מסתכל על השני."
  },
  {
   "start": 471.32,
   "end": 476.41,
   "text": "ואז למעשה יש בית, אבל בבית הזה יש אנשים,"
  },
  {
   "start": 476.91,
   "end": 478.43,
   "text": "וכל אחד אבל לא חי בנפרד."
  },
  {
   "start": 479.27,
   "end": 482.41,
   "text": "מעין בית מלון, שכל אחד חי שם, זה הכל."
  },
  {
   "start": 484.59,
   "end": 485.53,
   "text": "אחרי כמה זמן,"
  },
  {
   "start": 486.39,
   "end": 490.33,
   "text": "כבר האבא הבין מעצמו שאם הוא לא יעזוב פה את הדירה הזאת,"
  },
  {
   "start": 490.85,
   "end": 491.37,
   "text": "יזרקו אותו."
  },
  {
   "start": 493.09,
   "end": 494.23,
   "text": "בלית ברירה הוא עזב."
  },
  {
   "start": 495.15,
   "end": 501.51,
   "text": "ואז הוא פנה בדחילו ורחימו בבושה לאותו בת ענייה שתמיד הוא התבייש בה."
  },
  {
   "start": 503.11,
   "end": 503.49,
   "text": "והוא בא,"
  },
  {
   "start": 503.95,
   "end": 506.09,
   "text": "הוא בא קודם כל לבקר ככה, לא היה נעים לו."
  },
  {
   "start": 506.77,
   "end": 511.35,
   "text": "ואיך שהוא בא שם, איך קיבלו אותו, כל הילדים קפצו, הנה סבא, זה סבא."
  },
  {
   "start": 512.73,
   "end": 516.25,
   "text": "בוא, והוא בא והתפעל, מה זה קיבלו אותו בחום ואהבה."
  },
  {
   "start": 517.33,
   "end": 518.63,
   "text": "אז היה לו מיטה ככה רעועה."
  },
  {
   "start": 519.25,
   "end": 524.47,
   "text": "אז לא היה מי יודע מה, מה, אוכל בשפע כמו אצל הבת הבכורה."
  },
  {
   "start": 525.83,
   "end": 529.19,
   "text": "אבל היה שם תמיד חיות, אנרגיה, שמחה, פעילות."
  },
  {
   "start": 530.83,
   "end": 532.53,
   "text": "רעש של ילדים, חיות!"
  },
  {
   "start": 538.75,
   "end": 541.55,
   "text": "באחד השבתות שהמשפחה יושבת בשולחן רואים אותו בוכה."
  },
  {
   "start": 542.79,
   "end": 546.51,
   "text": "באה הבת, שואלת, אבא, מה קרה? מה כואב? למה אתה בוכה? אבא, למה אתה בוכה?"
  },
  {
   "start": 548.01,
   "end": 549.51,
   "text": "אמר לה, אני בוכה על החיים שלי."
  },
  {
   "start": 550.71,
   "end": 552.21,
   "text": "אני בוכה על שנים."
  },
  {
   "start": 553.21,
   "end": 553.65,
   "text": "שנים."
  },
  {
   "start": 554.39,
   "end": 555.89,
   "text": "שבהם חייתי בטעות,"
  },
  {
   "start": 556.83,
   "end": 558.45,
   "text": "הערכתי את הדברים הלא נכונים."
  },
  {
   "start": 559.93,
   "end": 560.81,
   "text": "לא הבנתי,"
  },
  {
   "start": 561.83,
   "end": 563.11,
   "text": "לא הבנתי מה את,"
  },
  {
   "start": 563.65,
   "end": 564.81,
   "text": "ביתי החשובה,"
  },
  {
   "start": 565.57,
   "end": 568.05,
   "text": "כמה את נפלאה, מה בנית."
  },
  {
   "start": 568.67,
   "end": 572.79,
   "text": "זלזלתי, זלזלתי בדבר, במפעל העצום הזה."
  },
  {
   "start": 578.82,
   "end": 581.22,
   "text": "יפת אלוקים ליפת,"
  },
  {
   "start": 582.18,
   "end": 583.7,
   "text": "אבל ישכון בו עלי שם,"
  },
  {
   "start": 584.62,
   "end": 588.88,
   "text": "ובאוהל שמה נמצאת שרה עמנו,"
  },
  {
   "start": 589.9,
   "end": 590.54,
   "text": "רבקה,"
  },
  {
   "start": 591.48,
   "end": 592.5,
   "text": "רחל הקדושה,"
  },
  {
   "start": 593.64,
   "end": 596.98,
   "text": "וכל בת ישראל מוזמנת להצטרף לאוהל הזה,"
  },
  {
   "start": 597.68,
   "end": 598.56,
   "text": "להיות עיקר הבית,"
  },
  {
   "start": 599.2,
   "end": 602.0,
   "text": "להיות הנר של הבית, אור."
  },
  {
   "start": 603.42,
   "end": 607.2,
   "text": "אישה זו שמדליקה את הנרות שבת ושיהיה אור בבית, זה תלוי בך,"
  },
  {
   "start": 608.06,
   "end": 609.28,
   "text": "תלוי בכם בנות ישראל,"
  },
  {
   "start": 609.86,
   "end": 610.58,
   "text": "ויש לכם את הכוח."
  },
  {
   "start": 611.26,
   "end": 614.82,
   "text": "מי שיכול להציל את עם ישראל צריך לדעת את התקופה הזאת"
  },
  {
   "start": 615.46,
   "end": 616.36,
   "text": "זה בנות ישראל."
  },
  {
   "start": 617.04,
   "end": 617.88,
   "text": "אם אתם תהיו חזקות,"
  },
  {
   "start": 618.5,
   "end": 621.36,
   "text": "אם אתם תהיו עם הקדוש ברוך הוא. אתם יודעים מה זו בת?"
  },
  {
   "start": 622.02,
   "end": 624.44,
   "text": "מה ההבדל בין גבר לאישה? אישה יותר רוחנית."
  },
  {
   "start": 625.24,
   "end": 626.32,
   "text": "גבר בבריאה,"
  },
  {
   "start": 626.9,
   "end": 632.98,
   "text": "כשבורא עולם ברא את האדם הראשון, הוא ברא אותו 50% מעפר ו-50%"
  },
  {
   "start": 634.0,
   "end": 635.06,
   "text": "חלק אלוקה ממעל."
  },
  {
   "start": 637.51,
   "end": 642.39,
   "text": "כשהאישה נבראה, היא נבראה מהאדם ומבורא עולם."
  },
  {
   "start": 642.83,
   "end": 644.39,
   "text": "כלומר, היא פחות עפר,"
  },
  {
   "start": 646.21,
   "end": 647.39,
   "text": "היא יותר רוחנית,"
  },
  {
   "start": 648.23,
   "end": 651.89,
   "text": "יותר רוחנית מהגבר,"
  },
  {
   "start": 652.97,
   "end": 654.91,
   "text": "כדי לתת לה יותר כוחות"
  },
  {
   "start": 655.99,
   "end": 657.17,
   "text": "להחזיק מעמד,"
  },
  {
   "start": 657.83,
   "end": 658.79,
   "text": "לחזק את הבית."
  },
  {
   "start": 664.12,
   "end": 668.34,
   "text": "ואתם רואים מכל אורך הדורות איך בנות ישראל הקדושות בנו גדולי ישראל."
  },
  {
   "start": 670.0,
   "end": 671.18,
   "text": "בנו גדולי ישראל."
  },
  {
   "start": 672.98,
   "end": 675.32,
   "text": "הרבנית אלישיב, זכרה יגן עלינו אמן,"
  },
  {
   "start": 677.2,
   "end": 681.14,
   "text": "הרבנית אלישיב, יום אחרי החתונה, באה לרב"
  },
  {
   "start": 682.1,
   "end": 684.08,
   "text": "חבל על הזמן, לך תלמד. שלחה אותו ללמוד."
  },
  {
   "start": 685.14,
   "end": 685.58,
   "text": "תהיה איתו."
  },
  {
   "start": 686.14,
   "end": 686.72,
   "text": "לא, לא, לא."
  },
  {
   "start": 687.06,
   "end": 687.64,
   "text": "אולי תלמד."
  },
  {
   "start": 689.48,
   "end": 694.0,
   "text": "בזה היא קבעה איך הבית שלהם ייראו. אתה תלמד, ואני אנהל את הכול."
  },
  {
   "start": 695.08,
   "end": 696.96,
   "text": "ותדעו לכם, לפני מותי היא באה ואמרה,"
  },
  {
   "start": 697.68,
   "end": 702.2,
   "text": "אני מסרתי נפש, אני יודעת את זה. היה לי אולי קשה, נראה."
  },
  {
   "start": 703.0,
   "end": 705.3,
   "text": "אבל בורא העולם לא נשאר לי חייו."
  },
  {
   "start": 705.78,
   "end": 707.58,
   "text": "החזיר לי על כל מה שנתתי,"
  },
  {
   "start": 708.24,
   "end": 708.74,
   "text": "ויותר."
  },
  {
   "start": 709.36,
   "end": 710.76,
   "text": "בורא העולם לא נשאר לי חייו,"
  },
  {
   "start": 710.84,
   "end": 714.6,
   "text": "והחזיר לי כל מה שנתתי, החזיר לי ויותר."
  },
  {
   "start": 716.73,
   "end": 717.33,
   "text": "ולפני מותה,"
  },
  {
   "start": 718.71,
   "end": 722.91,
   "text": "ברגעים שלפני מותה היא שכבה מחוסרת למעשה עם עיניים עצומות,"
  },
  {
   "start": 723.93,
   "end": 725.17,
   "text": "כנראה מחוסרת הכרה,"
  },
  {
   "start": 725.97,
   "end": 728.43,
   "text": "ולפתע היא פותחת את העיניים ורואה אנשים סביבה,"
  },
  {
   "start": 730.62,
   "end": 731.58,
   "text": "את המשפחה סביבה."
  },
  {
   "start": 732.24,
   "end": 734.32,
   "text": "אמרה להם, מה אתם עושים פה? לכו ללמוד."
  },
  {
   "start": 735.08,
   "end": 737.34,
   "text": "חבל על הזמן, תלכו ללמוד."
  },
  {
   "start": 738.12,
   "end": 738.94,
   "text": "אבל את לפני המוות."
  },
  {
   "start": 740.36,
   "end": 741.66,
   "text": "תלכו ללמוד."
  },
  {
   "start": 742.0,
   "end": 742.54,
   "text": "מה זה יעזור?"
  },
  {
   "start": 742.86,
   "end": 743.72,
   "text": "תלכו ללמוד."
  },
  {
   "start": 745.26,
   "end": 746.96,
   "text": "גם במותה היא טביעה,"
  },
  {
   "start": 748.28,
   "end": 749.12,
   "text": "דחפה."
  },
  {
   "start": 751.71,
   "end": 753.61,
   "text": "פלא שיצא לנו גדול כמו הרב אלישיב,"
  },
  {
   "start": 754.83,
   "end": 755.79,
   "text": "גדול ישראל,"
  },
  {
   "start": 756.75,
   "end": 765.01,
   "text": "פאר הדור לכל אורך שנות דור."
  },
  {
   "start": 766.39,
   "end": 770.89,
   "text": "מאחורי כל גדול הייתה אישה שדוחפת,"
  },
  {
   "start": 771.47,
   "end": 772.87,
   "text": "לך תלמד, אני אעשה,"
  },
  {
   "start": 773.41,
   "end": 774.97,
   "text": "אני אסדר, אני אבנה."
  },
  {
   "start": 778.07,
   "end": 780.69,
   "text": "וככה ביחד בנו להם עולמות,"
  },
  {
   "start": 780.97,
   "end": 783.47,
   "text": "בנו את עם ישראל, עם ישראל קדוש."
  },
  {
   "start": 786.54,
   "end": 788.26,
   "text": "כדי להשרות שכינה בבית,"
  },
  {
   "start": 789.12,
   "end": 794.06,
   "text": "יש רק בריאה אחת ביקום שמסוגלת להשרות את השכינה בבית."
  },
  {
   "start": 794.7,
   "end": 795.04,
   "text": "יש רק"
  },
  {
   "start": 796.86,
   "end": 799.8,
   "text": "בריאה אחת שיכולה לקחת בית מאבנים,"
  },
  {
   "start": 800.34,
   "end": 801.22,
   "text": "בית ממלט,"
  },
  {
   "start": 801.66,
   "end": 803.22,
   "text": "ולהפוך אותו לבית מקדש."
  },
  {
   "start": 804.3,
   "end": 805.28,
   "text": "את זה היא יכולה לעשות"
  },
  {
   "start": 806.12,
   "end": 807.32,
   "text": "רק בריאה אחת ביקום,"
  },
  {
   "start": 808.28,
   "end": 808.62,
   "text": "האישה."
  },
  {
   "start": 811.31,
   "end": 811.71,
   "text": "לקחת"
  },
  {
   "start": 812.33,
   "end": 812.83,
   "text": "בית"
  },
  {
   "start": 813.39,
   "end": 814.63,
   "text": "מאבנים ומלט,"
  },
  {
   "start": 815.11,
   "end": 816.83,
   "text": "ולהפוך אותו לבית מקדש?"
  },
  {
   "start": 817.15,
   "end": 817.73,
   "text": "זה רק האישה."
  },
  {
   "start": 818.35,
   "end": 819.23,
   "text": "אמר רבי יוסה,"
  },
  {
   "start": 819.75,
   "end": 821.77,
   "text": "מעולם לא קראתי לאשתי אשתי,"
  },
  {
   "start": 822.19,
   "end": 824.01,
   "text": "אלא לאשתי ביתי,"
  },
  {
   "start": 824.63,
   "end": 827.51,
   "text": "אלא לאשתי ביתי."
  }
 ]
}